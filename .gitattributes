# Language statistics honesty (GitHub Linguist).
# These files are NOT hand-written code; exclude them from language %.

# Compiler output: the self-hosted fixed-point root of trust.
compiler/selfhost/*.exe.c linguist-generated=true

# Third-party vendored code (SQLite amalgamation header + prebuilt libs).
runtime/vendor/** linguist-vendored=true

# Release artifacts (if ever force-added).
dist/** linguist-generated=true

# Legacy seed lineage internals (generated C stages, if present locally).
last_generated.c linguist-generated=true

# Fixed-point canonical and parity goldens: byte-exact contracts, never EOL-converted.
compiler/selfhost/*.exe.c -text
tests/parity/golden/*.txt -text

# Orbit sources: canonical form is LF (`orbit fmt` emits LF only). Checking
# out with LF everywhere keeps `fmt --check` quiet on Windows, where
# core.autocrlf would otherwise materialize every .orb file as CRLF.
*.orb text eol=lf
