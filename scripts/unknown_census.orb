// Unknown-type census probe: counts what the front end could not type.
//
// This is a CENSUS, not a gate. It reports how much of the corpus the front end
// types as `unknown` so that "make `unknown` detectable" can be scoped against
// a number instead of a guess. It never fails anything; the driver
// `scripts/unknown_census.py` aggregates the lines printed here.
//
// A value is `unknown` when the front end has no type for it. Every type rule
// downstream of that point is skipped, which is why `unknown` is contagious
// and why a large share of emitted bytes are `(void*)(uintptr_t)` casts. The
// counts below are per file:
//
//     FILE <path>
//     FN <functions> RETUNK <n> PARAMUNK <n> INSTR <n> INSTRUNK <n> DIAG <n>
//     OP <opcode> <count>        -- only opcodes whose result is `unknown`
//     CODE <diagnostic code> <count>
//     NAME <count> <message>     -- one E2001 message, whose last word is the
//                                   identifier the file loads untyped
//     LOAD <count> <kind>        -- unknown loads split by whether the same
//                                   function binds that name
//
// The two imports below are load-bearing and neither is obvious.
//
// `compiler/host/extern.orb` declares the runtime functions the lexer and the
// parser call. Neither file imports it, so without this import the front end
// cannot resolve `orbit_os_write_stderr_selfhost`, the emitter gives that call
// an `unknown` result, and gcc rejects the generated C with "invalid use of
// void expression". That is FINDINGS F-0004, and it is also the argument for
// this census: the probe is itself a program the compiler cannot fully type.
//
// `parseIntSelfhost` is declared in `compiler/ir/builder.orb` and called from
// `parseRouteDecl` in `compiler/front/parser.orb`, again with no import between
// them. The emitted C references an undefined symbol, so the definition below
// is a link-time stub for a function this probe never calls.
//
// Every `.get()` out of a list of models below carries an explicit type
// annotation, and it has to: an unannotated `list.get` of a model leaves the
// value `unknown`, and a member read on an `unknown` receiver resolves the
// wrong field. `instruction.typeName` read that way returns the opcode, which
// would have reported zero `unknown` types for the whole corpus.

import "../compiler/host/extern.orb"
import "../compiler/tir/entry.orb"

// The first word of an operand string. A `bind` instruction binds the name it
// puts first, and a `load` reads the name it puts first, so this is how the
// probe tells a name the function binds from one it does not.
fn firstWord(text: string) -> string {
    val space = orbit_string_indexOf(text, " ")
    if space < 0 { return text }
    return orbit_string_slice(text, 0, space)
}

// parseIntSelfhost used to be stubbed here because the front end could not
// reach the real one: parser.orb called a function that lived in builder.orb,
// which this probe does not import, and an unresolved call is not a
// diagnostic. That is fixed (F-0004) -- parseIntSelfhost now lives in
// compiler/front/literal.orb, which the parser imports -- so the stub below collided
// with the real one and this probe stopped building. A report-only tool with
// no gate behind it rotted without a single signal.

fn findOpcodes(opcodes: list, opcode: string) -> int {
    var i = 0
    while i < opcodes.len() {
        if opcodes.get(i) == opcode { return i }
        i = i + 1
    }
    return - 1
}

fn bump(counts: list, index: int) -> list {
    var out = []
    var i = 0
    while i < counts.len() {
        if i == index { out.push(counts.get(i) + 1) }
        else { out.push(counts.get(i)) }
        i = i + 1
    }
    return out
}

fn censusOf(path: string) {
    val source = orbit_file_read_selfhost(path)
    if source == "" {
        print("FILE " + path)
        print("UNREADABLE")
        return
    }
    val parser = initParser(source)
    val root = parseProgram(parser)
    // The same path `orbit frontend` takes, imports and all. This call used to
    // be `lowerProgramToTir`, which reads only the text it is handed, so the
    // census measured a program the command line never compiles: a file that
    // calls into an imported function counted as unknown here and typed there.
    val importNotes = []
    val imported = importsOf(path, importNotes)
    val module: TirModule = lowerProgramWithImportsToTir(path, root, imported, importNotes)
    appendParserDiagnostics(module, parser.diagnostics)

    var functions = 0
    var returnUnknown = 0
    var paramUnknown = 0
    var instrs = 0
    var instrUnknown = 0
    var opcodes = []
    var counts = []
    // An unknown load is either the echo of a value this pass could not type
    // (the name IS bound here, with `unknown` in it) or a name the function
    // never binds at all. The two need different fixes, and only the second is
    // a resolution gap.
    var loadBound = 0
    var loadUnbound = 0

    var f = 0
    while f < module.functions.len() {
        val function: TirFunction = module.functions.get(f)
        functions = functions + 1
        if function.returnType == "unknown" { returnUnknown = returnUnknown + 1 }
        val boundNames = []
        var bp = 0
        while bp < function.parameters.len() {
            val parameter: TirParameter = function.parameters.get(bp)
            boundNames.push(parameter.name)
            bp = bp + 1
        }
        var bi = 0
        while bi < function.instructions.len() {
            val bound: TirInstruction = function.instructions.get(bi)
            if bound.opcode == "bind" {
                boundNames.push(firstWord(bound.operands))
            }
            bi = bi + 1
        }
        var p = 0
        while p < function.parameters.len() {
            val parameter: TirParameter = function.parameters.get(p)
            if parameter.typeName == "unknown" { paramUnknown = paramUnknown + 1 }
            p = p + 1
        }
        var n = 0
        while n < function.instructions.len() {
            val instruction: TirInstruction = function.instructions.get(n)
            instrs = instrs + 1
            if instruction.typeName == "unknown" {
                instrUnknown = instrUnknown + 1
                if instruction.opcode == "load" {
                    if findOpcodes(boundNames, firstWord(instruction.operands)) >= 0 {
                        loadBound = loadBound + 1
                    } else {
                        loadUnbound = loadUnbound + 1
                    }
                }
                val at = findOpcodes(opcodes, instruction.opcode)
                if at < 0 {
                    opcodes.push(instruction.opcode)
                    counts = bump(counts, at)
                    counts.push(1)
                } else { counts = bump(counts, at) }
            }
            n = n + 1
        }
        f = f + 1
    }

    var diagnostics = 0
    var diagCodes = []
    var diagCounts = []
    // The two give-up codes say WHICH node the front end walked away from, so a
    // message is one class and the count is the size of that class. Every
    // distinct message of E3000 or E3001 is therefore a row of the table the
    // type work needs; no other code is tallied this way.
    var giveupMessages = []
    var giveupCounts = []
    // E2001 is the load of a name the front end cannot type, and its message
    // ends with that name, so a distinct message is one identifier. The count
    // per identifier is what says whether the 7,663 of them are the boundary of
    // one module's declarations or something else; the driver sorts them.
    var nameMessages = []
    var nameCounts = []
    var d = 0
    while d < module.diagnostics.len() {
        val diagnostic: TirDiagnostic = module.diagnostics.get(d)
        diagnostics = diagnostics + 1
        if diagnostic.code == "E3000" || diagnostic.code == "E3001" {
            val g = findOpcodes(giveupMessages, diagnostic.message)
            if g < 0 {
                giveupMessages.push(diagnostic.message)
                giveupCounts = bump(giveupCounts, g)
                giveupCounts.push(1)
            } else { giveupCounts = bump(giveupCounts, g) }
        }
        if diagnostic.code == "E2001" {
            val nm = findOpcodes(nameMessages, diagnostic.message)
            if nm < 0 {
                nameMessages.push(diagnostic.message)
                nameCounts = bump(nameCounts, nm)
                nameCounts.push(1)
            } else { nameCounts = bump(nameCounts, nm) }
        }
        val at = findOpcodes(diagCodes, diagnostic.code)
        if at < 0 {
            diagCodes.push(diagnostic.code)
            diagCounts = bump(diagCounts, at)
            diagCounts.push(1)
        } else { diagCounts = bump(diagCounts, at) }
        d = d + 1
    }

    print("FILE " + path)
    print("FN " + orbit_int_to_string_selfhost(functions)
    + " RETUNK " + orbit_int_to_string_selfhost(returnUnknown)
    + " PARAMUNK " + orbit_int_to_string_selfhost(paramUnknown)
    + " INSTR " + orbit_int_to_string_selfhost(instrs)
    + " INSTRUNK " + orbit_int_to_string_selfhost(instrUnknown)
    + " DIAG " + orbit_int_to_string_selfhost(diagnostics))
    print("LOAD " + orbit_int_to_string_selfhost(loadBound) + " bound-in-this-function")
    print("LOAD " + orbit_int_to_string_selfhost(loadUnbound) + " not-bound-in-this-function")
    var k = 0
    while k < opcodes.len() {
        print("OP " + opcodes.get(k) + " " + orbit_int_to_string_selfhost(counts.get(k)))
        k = k + 1
    }
    var e = 0
    while e < diagCodes.len() {
        print("CODE " + diagCodes.get(e) + " " + orbit_int_to_string_selfhost(diagCounts.get(e)))
        e = e + 1
    }
    var g2 = 0
    while g2 < giveupMessages.len() {
        print("GIVEUP " + orbit_int_to_string_selfhost(giveupCounts.get(g2)) + " " + giveupMessages.get(g2))
        g2 = g2 + 1
    }
    var n2 = 0
    while n2 < nameMessages.len() {
        print("NAME " + orbit_int_to_string_selfhost(nameCounts.get(n2)) + " " + nameMessages.get(n2))
        n2 = n2 + 1
    }
}

fn main() -> int {
    val argc = orbit_os_argc_selfhost()
    var i = 1
    while i < argc {
        censusOf(orbit_os_argv_selfhost(i))
        i = i + 1
    }
    return 0
}
