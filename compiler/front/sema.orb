// Orbit Self-Hosted Compiler - Semantic analyzer (sema = semantic analysis)
// compiler/front/sema.orb
//
// Phase: typechecking and name resolution; runs on the AST after parsing,
// before IR building. Input: AST plus extern/literal tables; output: scopes,
// type/variant registries, and SemaError diagnostics. Scale note: largest
// compiler module (~3000 lines); checkNode is the single entry for typing.
import "./ast.orb"
import "../host/extern.orb"
import "./literal.orb"

model Symbol {
    name: string
    typeName: string
    isMutable: bool
    isFunction: bool
    // A function's declared parameter types, in order. Carried on the symbol
    // because that is the only place a call site can reach: the call has a
    // name and a list of arguments, the declaration is a different node in a
    // different pass, and nothing joined them. Arity and argument type are
    // both decided by the two together, and both used to be inferred and
    // thrown away.
    paramTypes: list
}

model Scope {
    symbols: list
    parentId: int
}

model TypeInfo {
    name: string
    kind: string
    variants: list
}

// One variant name and the enum or union that declares it. A variant is
// constructed by a bare call (`Circle(7)`) or a field read (`ASTNode.Empty`),
// and neither form mentions the type it belongs to, so the only way sema can
// learn "this call produces a Shape" is an index from the variant name.
model VariantInfo {
    variant: string
    owner: string
    // The variant's payload types, tab-joined in order ("" for a unit
    // variant). Joined, not nested, for the reason modelFieldTypeName is
    // parallel: a nested list would need re-typing at every read, and type
    // spellings never contain tabs.
    payloads: string
}

// A name the checker was asked to resolve and could not.
//
// `unknown` on its own cannot carry this. It is also the honest answer for a
// name that WAS found and whose value the type rules do not cover, and
// checkCompatibility accepts it on either side of a comparison, so the two
// cases were indistinguishable and neither one said anything. Recording the
// miss where it happens is what makes the difference observable: the caller
// that meant the name as a reference records one, the caller probing whether a
// name happens to be a model does not, and the count below is the honest size
// of the gap rather than the size of `unknown`.
model NameMiss {
    name: string
    kind: string
}

// The element type a push into a named list adopted, for a list that nothing
// declared an element type for.
//
// `var xs = []` has no element type: the literal is empty. The first push is
// where the program says what the slot holds, and remembering it there is what
// lets the read after it be checked instead of merely emitted. The name is the
// whole key because a push is spelled `xs.push(v)` and that is the only handle
// the checker has on the list it is writing into.
model ListElem {
    name: string
    elem: string
}

// A semantic diagnostic. line is 0 when the checker could not say where the
// problem is -- most checks run over a node that carries no position -- and
// the printer falls back to the one-line form for those. Only a diagnostic
// that knows its position gets an error card.
model SemaError {
    message: string
    line: int
    col: int
    code: string
    hint: string
}

model Sema {
    scopes: list
    currentScope: int
    errors: list
    // Bare `list`: the element type is not declared, so the C backend cannot
    // infer it and picks a model to cast each element to when the list is READ.
    // That pick happened to be DoctorDecl, whose `kind` sits at the same offset
    // as TypeInfo's, so every read was correct by accident -- and a segfault the
    // moment either model changed shape. Every read of these two is annotated
    // (`val t: TypeInfo = ...`) to pin the cast. Do not drop those annotations:
    // they are what makes the emitted C correct, and nothing else is.
    typeRegistry: list
    variantRegistry: list
    currentReturnType: string
    currentFunction: string
    seenRoutes: list
    misses: list
    // Lengths the checker can prove for a `val` bound to a literal, as
    // "name\tstring\tlen" or "name\tlist\tlen". Only literal bindings, only
    // immutable ones, and only a string literal with no escapes in it -- a
    // bound that can be reassigned, or whose length this cannot count, is not
    // a bound. See checkConstantIndex.
    constBounds: list
    // The fields of every model seen, as three parallel lists: the owning
    // model, the field name, the declared type. Parallel rather than joined
    // because a joined row would have to be split apart again, and splitting
    // costs a helper that returns a list of strings -- which the C backend
    // then mis-typess when the row came out of one of these very lists. See
    // the note on modelFieldType.
    //
    // A model declaration is the one piece of the language the checker had and
    // never read: it knew `model Point` exists, and nothing about x or y. So
    // `Point(1)` with one argument, `Point("a", true)` with two strings, and
    // `p.nonexistent` were all accepted, and the first two compiled to C
    // reading arguments that were never passed.
    modelFieldOwner: list
    modelFieldName: list
    modelFieldTypeName: list
    // The type parameter names of every generic model seen, as two parallel
    // lists: the model, and its parameters as one comma-separated string in
    // declaration order. Parallel, for the reason the three above are: a joined
    // row would have to be split apart again, and the C backend mis-typess a
    // row that came out of one of these very lists.
    //
    // A generic model's fields are registered under the model's OWN name with
    // their UNSUBSTITUTED types, so the declaration is still the thing that
    // answers `Box { ... }` has field `v`. What these two add is the knowledge
    // that `v`'s type is a parameter, which is what lets the literal fix it and
    // the checker then hold the value against it.
    modelGenericOwner: list
    modelGenericParams: list
    // Positions checkConstantIndex has already reported, as "line:col".
    // inferType reaches a node from more than one direction -- a call infers
    // its receiver, an expression statement infers its expression -- so
    // without this one bad index would be printed twice.
    indexChecks: list
    // Element types the checker adopted from a push, and the length of that
    // table at each open scope. Scoped per scope for the same reason the
    // builder's own list-kind registry is: two functions with a parameter
    // named `l` would otherwise collide, and a name declared in an inner block
    // is a different list from the outer one of the same name.
    listElems: list
    listElemMarks: list
    // Where the value under check was written, as a fallback position for
    // literals the parser records no position for. ObjectLiteralNode,
    // FieldInitNode, TypedLiteralNode and ReturnNode carry no line/col, so a
    // diagnostic about a generic literal's fields cannot point at the literal
    // itself. The nearest enclosing declaration can: checkVarDecl and
    // checkConstDecl stamp it before descending, and the unpositioned arms
    // (checkReturn, the ExpressionStmt dispatch) reset it to 0,0 so a stale
    // line never misleads. checkGenericModelFields reads it; 0,0 keeps the
    // honest one-line form, which printSemaErrors chooses on line == 0.
    valueSiteLine: int
    valueSiteCol: int
    // Which model each bound variable was built from, as four parallel
    // lists: the variable name, the model's OWN name (never the
    // monomorphised instance: "Bagged_float" would need fragile splitting
    // to answer "Bagged"), and the scope that bound it. Recorded where the
    // literal is in hand (checkVarDecl and checkConstDecl on TypedLiteral
    // values) so a later `floats.items` read can answer the declared field
    // type instead of unknown. Lookups only match entries whose scope is on
    // the current chain, so a shadowing inner binding never reads the outer
    // variable's model.
    instanceNames: list
    instanceModels: list
    instanceScopes: list
    instanceBindings: list
    // Names of the loops enclosing the node under check, innermost last.
    // `break outer` is only meaningful when `outer` is on this stack; a
    // named break to anything else is a typo pointing at the wrong loop, so
    // it is refused where a plain stray `break` stays silent (existing
    // behavior, separate work). Push/pop in checkForLoop only: `fn` cannot
    // nest in a block, so no boundary needs saving.
    loopLabels: list
    // Generic function declarations by name, as parallel lists (the name and
    // the FunctionDecl node). A call resolves its callee here before the
    // ordinary function table, because a generic has no one C function to
    // point at: each call site monomorphises its own instance.
    genericFnNames: list
    genericFnDecls: list
    // Names of the `extern fn` declarations the program makes. A `fn` value is
    // called through a C cast whose first argument is the request arena, which
    // is true of every function this compiler emits and false of an extern:
    // `val f = orbit_file_exists` reassigned to `orbit_file_delete` emitted
    // `((orbit_bool (*)(OrbitArena* arena, orbit_string))(f))(arena, path)`
    // against `bool orbit_file_exists(const char* filename)`, so the callee
    // read the arena pointer as its path and the real argument was never read.
    // The symbol table carries no extern flag, so the name is recorded here
    // where the declaration is in hand.
    externFnNames: list
}

fn initSema() -> Sema {
    val initialScopes = []
    initialScopes.push(Scope([], -1))
    return Sema(initialScopes, 0, [], [], [], "", "", [], [], [], [], [], [], [], [], [], [], [], 0, 0, [], [], [], [], [], [], [], [])
}

// The model a bound variable was built from, or "" when it was not built
// from a model literal. Scope-pinned like resolveSymbol: only entries bound
// in a scope on the current chain answer, so shadowing stays sound. Scopes
// ride as strings because list elements compare by value at runtime.
fn instanceModelOf(sema: Sema, name: string) -> string {
    var scopeId = sema.currentScope
    while scopeId >= 0 {
        val scope = sema.scopes.get(scopeId)
        var i = 0
        while i < sema.instanceNames.len() {
            if sema.instanceNames.get(i) == name {
                if sema.instanceScopes.get(i) == orbit_int_to_string_selfhost(scopeId) {
                    return sema.instanceModels.get(i)
                }
            }
            i = i + 1
        }
        scopeId = scope.parentId
    }
    return ""
}

fn recordInstanceModel(sema: Sema, name: string, modelName: string, bindings: list) {
    sema.instanceNames.push(name)
    sema.instanceModels.push(modelName)
    sema.instanceScopes.push(orbit_int_to_string_selfhost(sema.currentScope))
    sema.instanceBindings.push(joinBindingRows(bindings))
}

// Bindings ride as one tab-joined string because a nested list would need
// its elements re-typed at every read; type spellings never contain tabs.
fn joinBindingRows(rows: list) -> string {
    var out = ""
    var i = 0
    while i < rows.len() {
        if i > 0 { out = out + "	" }
        out = out + rows.get(i)
        i = i + 1
    }
    return out
}

// The bindings a bound variable's model was built with, split back into
// "param arg" rows, or an empty list when it was not built from a generic
// model literal. Same scope-pinned walk as instanceModelOf; the two stay in
// lockstep because only recordInstanceModel pushes to either.
fn instanceBindingsOf(sema: Sema, name: string) -> list {
    var scopeId = sema.currentScope
    while scopeId >= 0 {
        val scope = sema.scopes.get(scopeId)
        var i = 0
        while i < sema.instanceNames.len() {
            if sema.instanceNames.get(i) == name {
                if sema.instanceScopes.get(i) == orbit_int_to_string_selfhost(scopeId) {
                    return splitBindingRows(sema.instanceBindings.get(i))
                }
            }
            i = i + 1
        }
        scopeId = scope.parentId
    }
    return []
}

fn splitBindingRows(joined: string) -> list < string > {
    val rows = []
    var start = 0
    var i = 0
    while i <= orbit_string_len(joined) {
        var end = false
        if i == orbit_string_len(joined) { end = true }
        var isTab = false
        if end == false {
            if joined.at(i) == 9 { isTab = true }
        }
        if end || isTab {
            rows.push(orbit_string_slice(joined, start, i))
            start = i + 1
        }
        i = i + 1
    }
    return rows
}

fn listContainsValue(items: list, value: string) -> bool {
    if items == NULL { return false }
    var i = 0
    while i < items.len() {
        if items.get(i) == value { return true }
        i = i + 1
    }
    return false
}

fn reportError(sema: Sema, message: string) {
    // Diagnostics raised outside a function body (a bad signature, for
    // instance) have no enclosing name. An empty "[in ]" reads like a bug in
    // the message, so omit the context instead of printing nothing.
    if sema.currentFunction == "" {
        sema.errors.push(SemaError(message, 0, 0, "", ""))
        return
    }
    sema.errors.push(SemaError(message + " [in " + sema.currentFunction + "]", 0, 0, "", ""))
}

// The same diagnostic when the checker knows where the offending node is.
// Everything reachable from a MatchNode, a Call or a MemberAccess is a
// position the parser recorded, so a diagnostic about one of those can point at
// it; the plain reportError cannot and says nothing about location.
fn reportErrorAt(sema: Sema, code: string, hint: string, line: int, col: int, message: string) {
    sema.errors.push(SemaError(message, line, col, code, hint))
}

// Whether the checker can name this type. `unknown` is the absence of an
// answer, and `""`/`void` are the shapes a node with no type rule comes back
// as; a rule about operand types can only act on a name.
fn semaKnownType(t: string) -> bool {
    if t == "" { return false }
    if t == "unknown" { return false }
    if t == "void" { return false }
    return true
}

// Function names the C backend cannot emit safely. A generated translation
// unit has <stdio.h>, <stdlib.h>, <string.h>, <stdint.h> in scope, plus
// <unistd.h>/<sys/socket.h> and friends on POSIX or <winsock2.h> on Windows,
// and user functions are emitted under their own name (`static orbit_int
// read(...)`). Naming a function after a C library symbol therefore produces
// "conflicting types" from the C compiler, or a link error, and nothing in the
// Orbit-level output explains why.
//
// The list is deliberately narrow: only symbols that are (a) plausible names
// for a small user helper and (b) genuinely declared in that header set. A
// user wanting a `read` helper should get one diagnostic naming the collision
// and suggesting a rename, not a C toolchain message. The better long-term
// answer is to mangle emitted user symbols so no name can ever collide; that
// touches every call site in every program and is tracked as c-name-collisions.
fn reservedCFunctionName(name: string) -> bool {
    if name == "read" { return true }
    if name == "write" { return true }
    if name == "open" { return true }
    if name == "close" { return true }
    if name == "link" { return true }
    if name == "unlink" { return true }
    if name == "stat" { return true }
    if name == "fstat" { return true }
    if name == "access" { return true }
    if name == "sleep" { return true }
    if name == "usleep" { return true }
    if name == "getpid" { return true }
    if name == "getenv" { return true }
    if name == "setenv" { return true }
    if name == "system" { return true }
    if name == "exit" { return true }
    if name == "atexit" { return true }
    if name == "abort" { return true }
    if name == "malloc" { return true }
    if name == "calloc" { return true }
    if name == "realloc" { return true }
    if name == "free" { return true }
    if name == "strlen" { return true }
    if name == "strcmp" { return true }
    if name == "strncmp" { return true }
    if name == "strcpy" { return true }
    if name == "strncpy" { return true }
    if name == "strcat" { return true }
    if name == "memcpy" { return true }
    if name == "memmove" { return true }
    if name == "memset" { return true }
    if name == "index" { return true }
    if name == "abs" { return true }
    if name == "labs" { return true }
    if name == "div" { return true }
    if name == "remove" { return true }
    if name == "rename" { return true }
    if name == "tmpnam" { return true }
    if name == "printf" { return true }
    if name == "fprintf" { return true }
    if name == "sprintf" { return true }
    if name == "puts" { return true }
    if name == "fgets" { return true }
    if name == "fopen" { return true }
    if name == "fclose" { return true }
    if name == "signal" { return true }
    if name == "raise" { return true }
    if name == "socket" { return true }
    if name == "bind" { return true }
    if name == "listen" { return true }
    if name == "accept" { return true }
    if name == "connect" { return true }
    if name == "select" { return true }
    if name == "htons" { return true }
    if name == "htonl" { return true }
    if name == "ntohs" { return true }
    if name == "ntohl" { return true }
    if name == "inet_addr" { return true }
    return false
}

// The `orbit_` prefix belongs to the runtime, and reusing it fails in the most
// confusing way available: `orbit check` passes, then the C compiler reports a
// signature conflict against a runtime function the user never mentioned.
// `fn orbit_string_concat(a: string, b: string)` is emitted as a definition of
// `orbit_string_concat`, which the runtime already defines with an extra arena
// parameter, so the error is "too many arguments to function" against a symbol
// the program did not appear to call. `extern fn` is how the compiler itself
// reaches the runtime, so declarations are exempt; only definitions collide.
fn reservedRuntimePrefix(name: string) -> bool {
    if name.len() < 6 { return false }
    return name.slice(0, 6) == "orbit_"
}

// A `model` becomes a C struct under the user's own name, so a model named
// after a C type or typedef collides with a declaration the program never
// wrote. `model FILE` fails at C compile time with "conflicting types for
// 'FILE'; have 'struct FILE'", which says nothing about the model. The runtime
// prefix is excluded here too, because a model named `orbit_Foo` would
// collide with a runtime type of that name just as a function would.
fn reservedCTypeName(name: string) -> bool {
    if reservedRuntimePrefix(name) { return true }
    if name == "FILE" { return true }
    if name == "size_t" { return true }
    if name == "ssize_t" { return true }
    if name == "ptrdiff_t" { return true }
    if name == "intptr_t" { return true }
    if name == "uintptr_t" { return true }
    if name == "wchar_t" { return true }
    if name == "time_t" { return true }
    if name == "clock_t" { return true }
    if name == "va_list" { return true }
    if name == "fpos_t" { return true }
    if name == "div_t" { return true }
    if name == "ldiv_t" { return true }
    if name == "sig_atomic_t" { return true }
    if name == "jmp_buf" { return true }
    return false
}

fn hasErrors(sema: Sema) -> bool {
    return sema.errors.len() > 0
}

fn registerType(sema: Sema, name: string, kind: string, variants: list, payloads: list) {
    var i = 0
    while i < sema.typeRegistry.len() {
        val t: TypeInfo = sema.typeRegistry.get(i)
        if t.name == name {
            return
        }
        i = i + 1
    }
    sema.typeRegistry.push(TypeInfo(name, kind, variants))
    // Index the variants alongside the type. Without this, a union value
    // whose type was never written down -- `val s = Circle(7)` -- is
    // indistinguishable from any other unknown-typed expression, and the
    // exhaustiveness check below has nothing to check against.
    var vi = 0
    while vi < variants.len() {
        val variantNode = variants.get(vi)
        var joined = ""
        if vi < payloads.len() {
            val p: string = payloads.get(vi)
            joined = p
        }
        match variantNode {
            ASTNode.Literal(vl) => { sema.variantRegistry.push(VariantInfo(vl.text, name, joined)) }
            _ => {}
        }
        vi = vi + 1
    }
    // A type name is a name like any other: a function parameter, a val, a
    // field. Declaring it is what makes `fn area(s: Shape)` and the
    // uppercase-identifier fallback agree, and what lets a later `Shape`
    // expression be recognised as a type rather than an unknown identifier.
    declareSymbol(sema, name, name, false, false)
}

// The joined payload types declared for `variantName`, or "" for a unit
// variant or an undeclared name. One row of the variant registry, split the
// same way it was joined in the parser.
fn variantPayloadsOf(sema: Sema, variantName: string) -> string {
    var i = 0
    while i < sema.variantRegistry.len() {
        val v: VariantInfo = sema.variantRegistry.get(i)
        if v.variant == variantName {
            return v.payloads
        }
        i = i + 1
    }
    return ""
}

// How many payloads `Variant(A, B)` declares: the tab-separated count, with
// "" (unit) counting zero rather than one.
fn variantArityOf(sema: Sema, variantName: string) -> int {
    val joined = variantPayloadsOf(sema, variantName)
    if joined == "" { return 0 }
    return splitBindingRows(joined).len()
}

// The i-th payload type of a multi-payload variant, or "" past the end.
fn variantPayloadAt(sema: Sema, variantName: string, idx: int) -> string {
    val joined = variantPayloadsOf(sema, variantName)
    if joined == "" { return "" }
    val parts = splitBindingRows(joined)
    if idx < 0 || idx >= parts.len() { return "" }
    val part: string = parts.get(idx)
    return part
}

// A variant construction against its declaration: `Circle(7)` and
// `Shape.Circle(7)` used to take any argument count of any type and answer
// the union, so a second payload reached the C backend as a C comma
// expression evaluating to the last argument. Arity is E1003 (spelled as
// declared, like model arity); each payload against its declared type is
// E1005 (like call arguments, int widening included). Types ride in
// precomputed, because checking an argument twice prints its diagnostics
// twice.
fn checkVariantCall(sema: Sema, variantName: string, args: list, argTypes: list, line: int, col: int) {
    val want = variantArityOf(sema, variantName)
    if args.len() != want {
        reportErrorAt(sema, "E1003", "Construct the variant with one argument per payload, in order.", line, col, "Variant '" + variantName + "' declares " + orbit_int_to_string_selfhost(want) + " payloads, but the construction passes " + orbit_int_to_string_selfhost(args.len()) + ".")
        return
    }
    var i = 0
    while i < args.len() {
        val got: string = argTypes.get(i)
        val declared = variantPayloadAt(sema, variantName, i)
        if declared != "" && checkCompatibility(declared, got) == false {
            reportErrorAt(sema, "E1005", "Change the argument, or change the variant's declared payload type.", line, col, "Payload " + orbit_int_to_string_selfhost(i + 1) + " of '" + variantName + "' is declared " + declared + " but the value is " + got + ".")
        }
        i = i + 1
    }
}
// Whether `name` declares generic type parameters, and the declaration when
// it does. Separate from the function symbol so Symbols stay closed.
fn isGenericFn(sema: Sema, name: string) -> bool {
    var i = 0
    while i < sema.genericFnNames.len() {
        if sema.genericFnNames.get(i) == name { return true }
        i = i + 1
    }
    return false
}

// Whether the name was declared `extern fn`. A value cannot name one: see the
// note on `externFnNames`.
fn isExternFnName(sema: Sema, name: string) -> bool {
    var i = 0
    while i < sema.externFnNames.len() {
        if sema.externFnNames.get(i) == name { return true }
        i = i + 1
    }
    return false
}

fn genericFnDecl(sema: Sema, name: string) -> ASTNode {
    var i = 0
    while i < sema.genericFnNames.len() {
        if sema.genericFnNames.get(i) == name {
            return sema.genericFnDecls.get(i)
        }
        i = i + 1
    }
    return ASTNode.Empty
}

// The names a generic declaration binds, in order.
fn genericParamNames(decl: FunctionDeclNode) -> list {
    val out = []
    var i = 0
    while i < decl.genericParams.len() {
        match decl.genericParams.get(i) {
            ASTNode.GenericParam(g) => { out.push(g.name) }
            _ => {}
        }
        i = i + 1
    }
    return out
}

// Comma-split of a `Name<...>` argument list starting after the `<` at
// openIdx, depth-aware so `map<string, list<int>>` splits in two, not three.
// Builder.orb carries splitTypeArgs for the same job in its own closure.
fn splitTypeArgsOf(declared: string, openIdx: int) -> list {
    val out = []
    var cur = ""
    var depth = 0
    var i = openIdx + 1
    while i < orbit_string_len(declared) {
        val ch = declared.at(i)
        if ch == 60 { depth = depth + 1 }
        if ch == 62 {
            if depth == 0 { break }
            depth = depth - 1
        }
        if ch == 44 && depth == 0 {
            out.push(trimTypeArgForSema(cur))
            cur = ""
        } else {
            cur = cur + declared.slice(i, i + 1)
        }
        i = i + 1
    }
    if orbit_string_len(trimTypeArgForSema(cur)) > 0 { out.push(trimTypeArgForSema(cur)) }
    return out
}

// Whether a type spelling mentions a parameter as a whole word: `T` is
// mentioned in `list<T>` but not in `Target`, which a substring test would
// claim. Same word walk modelSubstitutedType uses.
fn paramMentioned(declared: string, param: string) -> bool {
    var i = 0
    while i < orbit_string_len(declared) {
        if isTypeWordChar(declared.at(i)) {
            var j = i
            while j < orbit_string_len(declared) {
                if isTypeWordChar(declared.at(j)) == false { break }
                j = j + 1
            }
            if declared.slice(i, j) == param { return true }
            i = j
        } else {
            i = i + 1
        }
    }
    return false
}

// Bind one parameter occurrence: same container base on both sides peels one
// level (`list<T>` against `list<int>` binds T to int, at any depth by
// recursion), a bare parameter name binds the whole actual, anything else
// binds nothing. "" means no bind, never a failed check: mismatch of
// concrete positions is E1005's job beside this.
fn inferParamBinding(declared: string, actual: string, param: string) -> string {
    if declared == param { return actual }
    val dOpen = orbit_string_indexOf(declared, "<")
    val aOpen = orbit_string_indexOf(actual, "<")
    if dOpen <= 0 || aOpen <= 0 { return "" }
    val dBase = orbit_string_slice(declared, 0, dOpen)
    val aBase = orbit_string_slice(actual, 0, aOpen)
    if dBase != aBase { return "" }
    if orbit_string_slice(declared, orbit_string_len(declared) - 1, orbit_string_len(declared)) != ">" { return "" }
    if orbit_string_slice(actual, orbit_string_len(actual) - 1, orbit_string_len(actual)) != ">" { return "" }
    val dArgs = splitTypeArgsOf(declared, dOpen)
    val aArgs = splitTypeArgsOf(actual, aOpen)
    if dArgs.len() != aArgs.len() { return "" }
    var i = 0
    while i < dArgs.len() {
        val dPart: string = dArgs.get(i)
        val aPart: string = aArgs.get(i)
        val found = inferParamBinding(dPart, aPart, param)
        if found != "" { return found }
        i = i + 1
    }
    return ""
}

// The instance rows behind one argument: recorded declaration-site rows
// for a variable (`b` bound to `Box { v: 1 }` answers "T int"), recomputed
// bindings for a literal in hand, nothing otherwise. A model-typed position
// cannot peel -- `Box_int` is an instance name, not an application -- so
// this history is what binds it.
fn instanceBindingRows(sema: Sema, modelName: string, node: ASTNode) -> list {
    match node {
        ASTNode.Literal(l) => {
            if l.valType == "identifier" { return instanceBindingsOf(sema, l.text) }
        }
        ASTNode.ObjectLiteral(ol) => { return modelGenericBindings(sema, modelName, node) }
        ASTNode.TypedLiteral(tl) => { return modelGenericBindings(sema, modelName, tl.value) }
        _ => {}
    }
    return []
}

// Fix one parameter from one argument position, or refuse the disagreement:
// two positions fixing a variable to different concrete types is E1005
// naming the variable and both types. "unknown" (and "void", which a missing
// field reads as) bind nothing and stay lenient downstream. A value naming
// a parameter itself (another variable, typically from a nested generic
// body) also binds nothing: it fixes nothing, and treating it as concrete
// refuses programs whose only sin is passing a variable through.
fn cohereBinding(sema: Sema, name: string, params: list, bindings: list, boundAt: list, pname: string, value: string, argPos: int, line: int, col: int) {
    if value == "" || value == "unknown" || value == "void" { return }
    var selfRef = false
    var q = 0
    while q < params.len() {
        val other: string = params.get(q)
        if other == value { selfRef = true }
        q = q + 1
    }
    if selfRef { return }
    var p2 = 0
    while p2 < params.len() {
        val cur: string = bindings.get(p2)
        val want: string = params.get(p2)
        if want == pname {
            if cur == "unknown" {
                bindings.set(p2, value)
                boundAt.set(p2, "" + argPos)
            } else if cur != value {
                val first: string = boundAt.get(p2)
                reportErrorAt(sema, "E1005", "Change one of the arguments so both fix the same type.", line, col, "Type parameter '" + pname + "' of '" + name + "' is fixed to " + cur + " by argument " + first + " but to " + value + " by argument " + orbit_int_to_string_selfhost(argPos) + ".")
            }
        }
        p2 = p2 + 1
    }
}

// A call against a generic declaration: every parameter occurrence fixes its
// type variable from the argument in that position, two positions fixing one
// variable to different concrete types is E1005 (naming the variable and
// both types), and concrete positions check exactly like call arguments. An
// "unknown" argument binds nothing and stays lenient downstream, the way an
// undetermined model parameter becomes Box_unknown. Returns the substituted
// return type.
fn checkGenericCall(sema: Sema, name: string, decl: FunctionDeclNode, args: list, argTypes: list, line: int, col: int) -> string {
    val params = genericParamNames(decl)
    val bindings = []
    val boundAt = []
    var p = 0
    while p < params.len() {
        bindings.push("unknown")
        boundAt.push("")
        p = p + 1
    }
    var i = 0
    while i < decl.paramTypes.len() && i < args.len() {
        val dt: string = decl.paramTypes.get(i)
        val at: string = argTypes.get(i)
        // A position mentioning a parameter is governed by coherence, not by
        // compatibility: `T` against `int` would fail the check below, but
        // fixing T to int is exactly the job. Concrete positions check like
        // call arguments, with the same diagnostic shape.
        var mentionsParam = false
        var p2 = 0
        while p2 < params.len() {
            val pname: string = params.get(p2)
            if paramMentioned(dt, pname) { mentionsParam = true }
            cohereBinding(sema, name, params, bindings, boundAt, pname, inferParamBinding(dt, at, pname), i + 1, line, col)
            p2 = p2 + 1
        }
        // A model-typed position binds from the value's history, not its
        // spelling: `b: Box<T>` against a `Box_int` cannot peel, so the
        // model's own parameters are read off the declaration site instead.
        if mentionsParam {
            val modelBase = compatTypeBase(dt)
            if modelGenericParamsOf(sema, modelBase).len() > 0 {
                val rows = instanceBindingRows(sema, modelBase, args.get(i))
                var r = 0
                while r < rows.len() {
                    val row: string = rows.get(r)
                    val rp = bindingHead(row)
                    cohereBinding(sema, name, params, bindings, boundAt, rp, bindingTail(row), i + 1, line, col)
                    r = r + 1
                }
            }
        }
        if mentionsParam == false && checkCompatibility(dt, at) == false {
            reportErrorAt(sema, "E1005", "Change the argument, or change the parameter's declared type.", line, col, "Parameter " + orbit_int_to_string_selfhost(i + 1) + " of " + name + " is declared " + dt + " but the argument is " + at + ".")
        }
        i = i + 1
    }
    var u = 0
    while u < params.len() {
        val pname: string = params.get(u)
        var mentioned = false
        var d = 0
        while d < decl.paramTypes.len() {
            val dt: string = decl.paramTypes.get(d)
            if paramMentioned(dt, pname) {
                mentioned = true
            }
            d = d + 1
        }
        val cur: string = bindings.get(u)
        if cur == "unknown" && mentioned == false {
            reportErrorAt(sema, "E1006", "Use the type parameter in a parameter's declared type, or declare one function per type.", line, col, "Function '" + name + "' cannot infer type parameter '" + pname + "': no parameter's declared type mentions it, so there is no argument to take it from.")
        }
        u = u + 1
    }
    val rows = []
    var b = 0
    while b < params.len() {
        val pname: string = params.get(b)
        val bval: string = bindings.get(b)
        rows.push(pname + " " + bval)
        b = b + 1
    }
    return modelSubstitutedType(decl.returnType, rows)
}

// The enum or union that declares `variantName`, or "" if no declared type
// does. This is the only evidence available for the type of a constructed
// variant, so it is deliberately keyed on the variant name alone.
fn findVariantOwner(sema: Sema, variantName: string) -> string {
    var i = 0
    while i < sema.variantRegistry.len() {
        val v: VariantInfo = sema.variantRegistry.get(i)
        if v.variant == variantName {
            return v.owner
        }
        i = i + 1
    }
    return ""
}

// Whether this pass has seen a model by this name. Needed separately from
// modelFieldCount because a field count of zero is also what a model that
// declares no fields answers, and "no such model" must not read as one.
fn isModelName(sema: Sema, name: string) -> bool {
    var i = 0
    while i < sema.modelFieldOwner.len() {
        if sema.modelFieldOwner.get(i) == name { return true }
        i = i + 1
    }
    return false
}

// How many fields a model declares. Zero when the name is not a model this
// pass has seen, which is also the honest answer for a model declared after
// its use.
fn modelFieldCount(sema: Sema, modelName: string) -> int {
    var n = 0
    var i = 0
    while i < sema.modelFieldOwner.len() {
        if sema.modelFieldOwner.get(i) == modelName { n = n + 1 }
        i = i + 1
    }
    return n
}

// The name of the index'th field a model declares, in declaration order, or ""
// when it declares fewer than that many.
fn modelFieldNameAt(sema: Sema, modelName: string, index: int) -> string {
    var seen = 0
    var i = 0
    while i < sema.modelFieldOwner.len() {
        if sema.modelFieldOwner.get(i) == modelName {
            if seen == index { return sema.modelFieldName.get(i) }
            seen = seen + 1
        }
        i = i + 1
    }
    return ""
}

// The declared type of one field, or "" when the model has no such field.
fn modelFieldType(sema: Sema, modelName: string, fieldName: string) -> string {
    var i = 0
    while i < sema.modelFieldOwner.len() {
        if sema.modelFieldOwner.get(i) == modelName && sema.modelFieldName.get(i) == fieldName {
            return sema.modelFieldTypeName.get(i)
        }
        i = i + 1
    }
    return ""
}

// Is an argument of type `got` acceptable where `want` is declared?
//
// Deliberately one-sided. "unknown" is accepted everywhere, because that is
// what a type this pass could not infer means, and refusing it would turn
// every inference gap into an error at every use. An int is accepted where a
// float is declared, because that is a widening the C backend performs anyway;
// a list is accepted for a list, because the element type is not part of the
// spelling.
fn argTypeFits(got: string, want: string) -> bool {
    if want == "" { return true }
    if got == "unknown" { return true }
    // The AST spells every single-node payload `list` -- UnaryOpNode.operand,
    // ReturnNode.expr, CallNode.callee and a dozen more -- because the node
    // payload was untyped long before the models were. An ASTNode where one of
    // those is expected is that placeholder being filled in, not a mistake a
    // program can make, and a user cannot construct an ASTNode at all. So this
    // one direction is let through, and the rest of the model types are still
    // checked. The alternative is to re-type the whole AST, which is a much
    // larger change than the problem deserves.
    if got == "ASTNode" { return true }
    // FmtState.prevTag is declared int and handed a TokType on purpose: the
    // formatter's own comment says why -- a value of unknown type cannot be
    // stored into an enum-typed model field, because void* has no enum
    // conversion. That is a C backend gap, not a mistake in the program, and a
    // user cannot name TokType either, so letting this one direction through
    // costs nothing and leaves the gap documented where it already was.
    if want == "int" && got == "TokType" { return true }
    if got == want { return true }
    if want == "float" && got == "int" { return true }
    if orbit_string_slice(want, 0, 4) == "list" && orbit_string_slice(got, 0, 4) == "list" {
        return compatibleListElement(want, got)
    }
    return false
}

// A model construction: the declared field count, and the declared field
// types, checked against the arguments actually written.
//
// Neither was checked. `Point(1)` compiled to a C call reading a second
// argument that was never passed, and `Point("a", true)` passed a string
// pointer where the C struct member is an int. The C compiler cannot catch
// either: the struct is a typedef, and `p.x` is a member read whose type is
// simply wrong. Both are decisions the model declaration already made.
fn checkModelCtor(sema: Sema, args: list, line: int, col: int, modelName: string) {
    if lookupSymbol(sema, modelName) != "model" { return }
    val declared = modelFieldCount(sema, modelName)
    if declared == 0 { return }
    // The positional spelling cannot reach a generic model's type parameters.
    // There is no grammar for a type argument at an expression site -- `Box<int>`
    // lexes as a comparison -- so `Box(1)` has one argument and no way to say
    // that it is an int, and the emitter would resolve the call against a `Box`
    // struct that does not exist. Refusing it here is the whole of the answer,
    // and it says what to write instead.
    if modelGenericParamsOf(sema, modelName).len() > 0 {
        reportErrorAt(sema, "E1003", "Write it as a literal: `Model { field: value }`. The type arguments are inferred from the values written for the fields that use them.", line, col, "Model '" + modelName + "' takes a type parameter, so it is constructed with a literal.")
        return
    }
    if args.len() != declared {
        reportErrorAt(sema, "E1003", "A model is constructed with one argument per declared field, in order.", line, col, "Model '" + modelName + "' has " + orbit_int_to_string_selfhost(declared) + " field(s) but " + orbit_int_to_string_selfhost(args.len()) + " argument(s) were given.")
        return
    }
    var i = 0
    while i < declared {
        val fieldName = modelFieldNameAt(sema, modelName, i)
        val want = modelFieldType(sema, modelName, fieldName)
        val got = checkNode(sema, args.get(i))
        if !argTypeFits(got, want) {
            reportErrorAt(sema, "E1003", "Change the argument, or change the field's declared type.", line, col, "Field '" + modelName + "." + fieldName + "' is declared " + want + " but the argument is " + got + ".")
        }
        i = i + 1
    }
}

// Reading a member of a value whose member set is closed.
//
// This used to be about models only, and it opened with
// `if modelFieldCount(sema, objType) == 0 { return }` -- which is a silent
// pass for every receiver that is not a model with declared fields. An int
// has no fields, so the count was 0 and the function said nothing. So did a
// union, which has variants rather than fields. Both went on to the C backend
// as a struct member read on a type that has no struct, and gcc rejected the
// output with "unknown type name" or a bad member, which the user saw as
// "orbit build: couldn't finish the C step - this one is on me, not your
// code". A member that cannot exist is a decision the type declaration
// already made, and it is checkable before the emitter is involved.
//
// The rule is deliberately narrow, because being wrong here breaks working
// code instead of catching broken code. A member set is only closed when the
// declaration that made it is one we can read:
//
//   - a model declares its fields, and nothing else. (Models have no methods:
//     `fn` inside a `model` is a parse error, so a method call on a model is
//     as wrong as a field read on an int.)
//   - an enum or a union declares its variants, and a member that is not one
//     of them is not a member. A payload is read by matching, not by naming
//     a field, so `s.radius` on a `Shape` is this error even though `Shape`
//     has an int inside it.
//   - int, bool and float have no members at all.
//
// Everything else stays silent on purpose: string, list, map, object, result
// and response all answer to a method surface that the emitter owns and this
// function cannot see, and "unknown" is the documented escape hatch that lets
// a module-qualified name like `json.encode` through. Reporting against a set
// we cannot enumerate would be a gate that cries wolf.
fn checkMemberResolution(sema: Sema, objType: string, member: string, line: int, col: int) {
    if objType == "int" || objType == "bool" || objType == "float" {
        reportErrorAt(sema, "E1003", "A value of type " + objType + " has no members. If this was meant to be a model or a variant, it is spelled elsewhere in the program.", line, col, "'" + objType + "' has no member '" + member + "'.")
        return
    }
    // A model is not in typeRegistry: checkModelDecl fills modelFieldOwner
    // instead, and TypeDecl -- the arm that calls registerType -- never sees
    // one. Asking findType about a model answers -1, which is how the first
    // version of this function sat silently on n05 while loudly on n06. The
    // question "is this a model with declared fields" is therefore asked of
    // modelFieldCount, which is the table that can answer it.
    if modelFieldCount(sema, objType) > 0 {
        if modelFieldType(sema, objType, member) != "" { return }
        reportErrorAt(sema, "E1003", "The field is spelled as declared; a model has no other members.", line, col, "Model '" + objType + "' has no field '" + member + "'.")
        return
    }
    val typeIndex = findType(sema, objType)
    if typeIndex < 0 { return }
    if isTaggedTypeIndex(sema, typeIndex) {
        if typeHasVariant(sema, objType, member) { return }
        reportErrorAt(sema, "E1003", "A variant is spelled as declared, and a payload is read by matching on it rather than by naming a field.", line, col, "'" + objType + "' has no variant '" + member + "'.")
        return
    }
}

fn findType(sema: Sema, name: string) -> int {
    var i = 0
    while i < sema.typeRegistry.len() {
        val t: TypeInfo = sema.typeRegistry.get(i)
        if t.name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// An enum or a union: the two kinds whose value is one of a fixed set of
// variants, and therefore the two kinds a `match` has to be exhaustive over.
// An alias has no variants of its own and is never checked.
fn isTaggedTypeIndex(sema: Sema, index: int) -> bool {
    if index < 0 { return false }
    val t: TypeInfo = sema.typeRegistry.get(index)
    if t.kind == "enum" { return true }
    if t.kind == "union" { return true }
    return false
}

fn isEnumTypeName(sema: Sema, name: string) -> bool {
    val idx = findType(sema, name)
    if idx < 0 { return false }
    val t: TypeInfo = sema.typeRegistry.get(idx)
    return t.kind == "enum"
}

fn typeHasVariant(sema: Sema, typeName: string, variantName: string) -> bool {
    val idx = findType(sema, typeName)
    if idx < 0 { return false }
    val t: TypeInfo = sema.typeRegistry.get(idx)
    var i = 0
    while i < t.variants.len() {
        val variantNode = t.variants.get(i)
        match variantNode {
            ASTNode.Literal(vl) => {
                if vl.text == variantName { return true }
            }
            _ => {}
        }
        i = i + 1
    }
    return false
}

fn declareSymbol(sema: Sema, name: string, typeName: string, isMutable: bool, isFunction: bool) {
    declareSymbolWithParams(sema, name, typeName, isMutable, isFunction, [])
}

fn declareSymbolWithParams(sema: Sema, name: string, typeName: string, isMutable: bool, isFunction: bool, paramTypes: list) {
    // The C backend opens every function it emits with an `OrbitArena* arena`
    // parameter, so this name is already taken in the generated C: `fn f(arena:
    // int)` emitted `orbit_int f(OrbitArena* arena, orbit_int arena)` and the C
    // compiler refused it (`conflicting types`), while `val arena = 7` emitted
    // `arena = (orbit_int)(uintptr_t)(7)`, an assignment to the injected
    // parameter, so every later allocation in that function ran through a
    // clobbered pointer. `orbit check` accepted both, because the arena is not
    // part of an Orbit signature and the name exists only after emission. The
    // other fix is to mangle the backend's own parameter, which is a
    // scope-aware rename of every identifier the backend emits; reserving the
    // name is the one the language can make honestly today.
    if name == "arena" {
        reportError(sema, "Cannot declare 'arena': every function this compiler emits already takes an OrbitArena* arena, so the generated C would declare it twice. Rename it - 'region' and 'pool' read the same.")
        return
    }
    val scope = sema.scopes.get(sema.currentScope)
    var i = 0
    while i < scope.symbols.len() {
        val sym = scope.symbols.get(i)
        if sym.name == name {
            reportError(sema, "Duplicate symbol: " + name)
            return
        }
        i = i + 1
    }
    scope.symbols.push(Symbol(name, typeName, isMutable, isFunction, paramTypes))
}

// The function symbol a name refers to, or NULL when no scope in the chain
// declares it as a function. A call site needs the declaration, not just the
// return type, and NULL is the only honest answer for "not there": a function
// that takes no parameters has an empty parameter list, which is not the same
// thing as no declaration at all.
fn resolveFunctionSymbol(sema: Sema, name: string) -> Symbol {
    var scopeId = sema.currentScope
    while scopeId >= 0 {
        val scope = sema.scopes.get(scopeId)
        var i = 0
        while i < scope.symbols.len() {
            val sym: Symbol = scope.symbols.get(i)
            if sym.name == name && sym.isFunction {
                return sym
            }
            i = i + 1
        }
        scopeId = scope.parentId
    }
    return NULL
}

// The type a name was declared with, or "" when no scope in the chain
// declares it.
//
// "" and "unknown" are different answers, and the difference is the whole
// point. "unknown" is a symbol the checker FOUND and has no type rule for -- a
// match binding, a `for` item, a `val` bound to a value nothing types -- and it
// is the honest answer, so it is not a miss. "" is a name nothing declares, and
// that is a bug in the program. checkCompatibility accepted "unknown" on either
// side of a comparison, so the two were indistinguishable from the first
// inference to codegen: `print(undeclaredThing)` checked clean and printed a
// live stack address, and nothing downstream could tell it apart from a `val`
// bound to a list element.
fn resolveSymbol(sema: Sema, name: string) -> string {
    var scopeId = sema.currentScope
    while scopeId >= 0 {
        val scope = sema.scopes.get(scopeId)
        var i = 0
        while i < scope.symbols.len() {
            val sym = scope.symbols.get(i)
            if sym.name == name {
                return sym.typeName
            }
            i = i + 1
        }
        scopeId = scope.parentId
    }
    return ""
}

// The nearest declaration of a name in the scope chain, function or not, or
// NULL when nothing declares it. resolveSymbol answers with the TYPE and
// resolveFunctionSymbol with the FUNCTION, so neither can say which one a
// scope means when both exist: a local `val check` beside the `check`
// parser helper must read as the local, not as the function as a value.
fn nearestSymbol(sema: Sema, name: string) -> Symbol {
    var scopeId = sema.currentScope
    while scopeId >= 0 {
        val scope = sema.scopes.get(scopeId)
        var i = 0
        while i < scope.symbols.len() {
            val sym: Symbol = scope.symbols.get(i)
            if sym.name == name {
                return sym
            }
            i = i + 1
        }
        scopeId = scope.parentId
    }
    return NULL
}

fn resolveFunction(sema: Sema, name: string) -> string {
    val sym = resolveFunctionSymbol(sema, name)
    if sym == NULL { return "" }
    return sym.typeName
}

// The sentinel every type rule already expects. Kept so the callers that are
// probing -- is this name a model? -- are not disturbed: a probe answers a
// question and a reference resolves a type, and only the second one is allowed
// to say the name does not exist.
fn lookupSymbol(sema: Sema, name: string) -> string {
    val found = resolveSymbol(sema, name)
    if found == "" { return "unknown" }
    return found
}

fn lookupFunction(sema: Sema, name: string) -> string {
    val sym = resolveFunctionSymbol(sema, name)
    if sym == NULL { return "unknown" }
    return sym.typeName
}

fn recordMiss(sema: Sema, kind: string, name: string) {
    sema.misses.push(NameMiss(name, kind))
}

// The number the gate reads: resolution misses the language provides for
// itself, which is the part of the gap that cannot be reported as an error
// because the corpus depends on it. Everything else is rejected.
fn missCount(sema: Sema, kind: string) -> int {
    var n = 0
    var i = 0
    while i < sema.misses.len() {
        val m: NameMiss = sema.misses.get(i)
        if m.kind == kind { n = n + 1 }
        i = i + 1
    }
    return n
}

// Names the language provides without a `fn` declaration, so a resolver that
// only knows declared symbols calls every one of them unresolved.
//
// Two groups, and they are not the same kind of debt. The first is the
// builtins: the emitter recognises them by name (compiler/ir/builder.orb,
// compiler/emit/c_backend.orb), so a program uses them and nothing declares them.
// The second is the runtime entry points the compiler itself calls: the
// emitted C resolves them through <orbit/runtime.h>, which the front end never
// reads, so `orbit_string_len` is a real Orbit name with no Orbit
// declaration. Both are counted, and both are the honest size of what is left;
// neither is a reason to reject a program.
fn isProvidedName(name: string) -> bool {
    if name == "NULL" { return true }
    if name == "system" { return true }
    if name == "self" { return true }
    if name == "len" { return true }
    if name == "at" { return true }
    if name == "slice" { return true }
    if name == "indexOf" { return true }
    if name == "contains" { return true }
    if name == "toInt" { return true }
    if name == "toFloat" { return true }
    if name == "toString" { return true }
    if name == "abs" { return true }
    if name == "min" { return true }
    if name == "max" { return true }
    if name == "floor" { return true }
    if name == "ceil" { return true }
    if name == "round" { return true }
    if name == "sqrt" { return true }
    if name == "pow" { return true }
    if name == "push" { return true }
    if name == "get" { return true }
    if name == "set" { return true }
    if name == "has" { return true }
    if name == "keys" { return true }
    if name == "values" { return true }
    if name == "delete" { return true }
    if name == "join" { return true }
    if name == "split" { return true }
    if name == "replace" { return true }
    if name == "trim" { return true }
    if name == "upper" { return true }
    if name == "lower" { return true }
    if name == "startsWith" { return true }
    if name == "endsWith" { return true }
    if name == "sort" { return true }
    if name == "map" { return true }
    if name == "filter" { return true }
    if name == "reduce" { return true }
    if name == "sum" { return true }
    if name == "env" { return true }
    if name == "print" { return true }
    if name == "ok" { return true }
    if name == "err" { return true }
    if name == "orbit_string_len" { return true }
    if name == "orbit_string_slice" { return true }
    if name == "orbit_string_indexOf" { return true }
    if name == "orbit_http_client_fetch" { return true }
    if name == "orbit_cache_get" { return true }
    if name == "orbit_file_upload_save" { return true }
    return false
}

// Resolve a callee that is a bare name, and say so when nothing declares it.
//
// The name is checked against every form a callee can legitimately take before
// it is called unresolved, and in this order: a declared function (the real
// case), a model name (a construction, not a call), a variant name (also a
// construction), and finally a name the language provides without declaring.
// Only what is left over is a program that calls something which is not there,
// and that used to reach the C output as a call to a symbol nothing declares.
fn resolveCalleeName(sema: Sema, name: string) -> string {
    val fnType = resolveFunction(sema, name)
    if fnType != "" { return fnType }
    val declared = resolveSymbol(sema, name)
    if declared == "model" { return name }
    // A variable holding a function value is callable: its spelling carries
    // the signature, so the call answers the return type the same way a
    // direct call does. A declared function wins above, so a shadowing local
    // still calls the function -- the value needs its own name to be called.
    if isFnType(declared) { return fnTypeReturn(declared) }
    if declared != "" {
        // The name is declared, just not as something callable. "Undeclared"
        // would be the wrong word for that, and the wrong word sends the
        // reader looking for a missing `fn` that is right there on the page.
        reportError(sema, "Cannot call '" + name + "': it is a " + declared + ", not a function")
        return "unknown"
    }
    if findVariantOwner(sema, name) != "" { return "unknown" }
    if isProvidedName(name) { return "unknown" }
    recordMiss(sema, "function", name)
    reportError(sema, "Undeclared function: " + name + "; nothing in scope declares it")
    return "unknown"
}

// Arity, decided from the declaration and the arguments together.
//
// The other half of this check -- the argument's TYPE against the parameter's
// declared type -- is written and switched off, and the reason is a finding
// rather than a doubt. Turning it on rejected 100% of what it should have
// rejected on the whole corpus and nothing else, and the first thing it found
// was std/sys/crypto/jwt.orb:17:
//
//     extern fn orbit_string_len(s: string) -> string
//
// The C function returns orbit_int, so every `totalLen` in that file is typed
// string and is then passed to orbit_string_slice's `end: int`. Three programs
// that import it stop building until that one word is corrected, and std/ is
// another zone's. The check is one line away and the evidence is on the board.
fn checkCallArity(sema: Sema, name: string, argCount: int) {
    val sym = resolveFunctionSymbol(sema, name)
    if sym == NULL { return }
    val params = sym.paramTypes
    if params.len() == argCount { return }
    if params.len() == 1 {
        reportError(sema, "Wrong number of arguments to " + name + ": it takes 1, got " + orbit_int_to_string_selfhost(argCount))
    } else {
        reportError(sema, "Wrong number of arguments to " + name + ": it takes " + orbit_int_to_string_selfhost(params.len()) + ", got " + orbit_int_to_string_selfhost(argCount))
    }
}

// The types of the arguments a call actually passed, against the parameter
// types its declaration records.
//
// The arity check next door reads the same symbol.paramTypes and stops at the
// count. The types were recorded and never compared, which is why F-0015
// shipped: `fn takesInt(x: int)` called with a string is accepted, the
// string's address arrives in an int register, and the program prints a heap
// address. Not a crash -- a wrong number, which propagates.
//
// It is also the check that makes the union payload honest. A model-typed
// parameter is emitted in C as a bare OrbitList* (see checkDivision's comment),
// so passing a node payload where a `list` is declared reads struct fields out
// of a list header. That is silent and it is what cost three hours on the
// division check. Catching the mismatch here is the difference between a
// compile error and a line number of 25515 for a four-line file.
//
// checkCompatibility decides what counts as a mismatch, so this stays
// one-sided: an argument the checker could not type is not a mismatch.
fn checkCallArgTypes(sema: Sema, name: string, args: list, line: int, col: int) {
    val sym = resolveFunctionSymbol(sema, name)
    if sym == NULL { return }
    val params = sym.paramTypes
    val n = params.len()
    if n != args.len() { return }
    var i = 0
    while i < n {
        val want = params.get(i)
        val got = checkNode(sema, args.get(i))
        if checkCompatibility(want, got) == false {
            reportErrorAt(sema, "E1005", "Change the argument, or change the parameter's declared type.", line, col, "Parameter " + orbit_int_to_string_selfhost(i + 1) + " of " + name + " is declared " + want + " but the argument is " + got + ".")
        }
        i = i + 1
    }
}

// Arity and argument types for a call through a function value. The direct
// checks above read the declaration's symbol, which a variable has none of,
// so they silently pass everything; the signature rides the value's spelling
// instead. Same diagnostics shape: a wrong count is the plain arity message,
// a wrong type is E1005 against the parameter the value's declaration gave.
fn checkFnVarCall(sema: Sema, name: string, fnType: string, args: list, argTypes: list, line: int, col: int) {
    val want = fnTypeArity(fnType)
    if want != args.len() {
        if want == 1 {
            reportError(sema, "Wrong number of arguments to " + name + ": it takes 1, got " + orbit_int_to_string_selfhost(args.len()))
        } else {
            reportError(sema, "Wrong number of arguments to " + name + ": it takes " + orbit_int_to_string_selfhost(want) + ", got " + orbit_int_to_string_selfhost(args.len()))
        }
        return
    }
    var i = 0
    while i < want {
        val p = fnTypeParamAt(fnType, i)
        val got: string = argTypes.get(i)
        if checkCompatibility(p, got) == false {
            reportErrorAt(sema, "E1005", "Change the argument, or change the function value's signature.", line, col, "Parameter " + orbit_int_to_string_selfhost(i + 1) + " of " + name + " is declared " + p + " but the argument is " + got + ".")
        }
        i = i + 1
    }
}

// One type has two spellings and the emitter accepts both, so a comparison
// that took them literally called `val a: List = []` a type mismatch between
// List and list. Normalising here rather than at the annotation means every
// caller of checkCompatibility agrees, which is the point: the four pairs
// name one type each, not four types and four near-misses.
fn canonicalTypeSpelling(t: string) -> string {
    if t == "List" { return "list" }
    if t == "Map" { return "map" }
    if t == "Result" { return "result" }
    if t == "Response" { return "response" }
    return t
}

// The base type of an annotation, without parameters: "list<string>" -> "list".
//
// Canonicalised, because "List<string>" is the same annotation spelled the other
// way and the two container spellings have to answer to one type here exactly as
// they do in checkCompatibility. Splitting off the head is also what makes the
// payload-carrying form work at all: the bare prefix test this replaced asked
// whether the string STARTED with "list", so "List<int>" was neither a list nor
// anything else, and neither was a `list` compared against a `List`.
fn compatTypeBase(t: string) -> string {
    val lt = t.indexOf("<")
    if lt < 0 { return canonicalTypeSpelling(t) }
    return canonicalTypeSpelling(orbit_string_slice(t, 0, lt))
}

// The element type a `list<T>` annotation carries, or "" when there is none:
// a bare `list` never told the checker anything about its payload.
fn compatTypeListElement(t: string) -> string {
    if compatTypeBase(t) != "list" { return "" }
    val lt = t.indexOf("<")
    if lt < 0 { return "" }
    // list<" + inner + ">" -> inner. orbit_string_slice is (s, start, end),
    // not (s, start, length) -- the day this shipped the string-length form was
    // presumed and every slice came back one character of the payload, which
    // made compatibleListElement compare "s" with "b" and report... nothing.
    return orbit_string_slice(t, lt + 1, t.len() - 1)
}

// Two list types agree on their element when either side has none to
// contradict: a bare `list` carries no information, so the runtime's adopted
// element kind -- checked at each read -- is the only account, and the static
// check has nothing to add. When both say, they must say the same.
fn compatibleListElement(want: string, got: string) -> bool {
    val we = compatTypeListElement(want)
    val ge = compatTypeListElement(got)
    if we == "" || ge == "" { return true }
    return we == ge
}

// A first-class function value spells `fn(p1;p2)->ret`: the parameters in
// order joined with ";", which no other type spelling contains ("," would
// collide with `map<string, int>` and "<" would be stripped as a generic
// argument). Only inferred, never annotated: there is no `fn` annotation
// syntax, so a bare function name in value position is the one way to get
// one, and it carries the declaration's signature with it.
fn isFnType(t: string) -> bool {
    if t.len() < 5 { return false }
    return t.slice(0, 3) == "fn("
}

fn fnTypeSpelling(ret: string, params: list) -> string {
    var out = "fn("
    var i = 0
    while i < params.len() {
        if i > 0 { out = out + ";" }
        out = out + params.get(i)
        i = i + 1
    }
    out = out + ")->" + ret
    return out
}

// The return type after `)->`, or "unknown" when the spelling is not one.
fn fnTypeReturn(t: string) -> string {
    val arrow = t.indexOf(")->")
    if arrow < 0 { return "unknown" }
    return t.slice(arrow + 3, t.len())
}

// The parameter list between `fn(` and `)->`, split on the ";" above.
fn fnTypeParams(t: string) -> list {
    val out = []
    if isFnType(t) == false { return out }
    val arrow = t.indexOf(")->")
    if arrow < 0 { return out }
    val inner = t.slice(3, arrow)
    if inner == "" { return out }
    var start = 0
    var i = 0
    while i <= inner.len() {
        var end = false
        if i == inner.len() { end = true }
        var isSep = false
        if end == false {
            if inner.at(i) == 59 { isSep = true }
        }
        if end || isSep {
            out.push(inner.slice(start, i))
            start = i + 1
        }
        i = i + 1
    }
    return out
}

fn fnTypeArity(t: string) -> int {
    return fnTypeParams(t).len()
}

fn fnTypeParamAt(t: string, idx: int) -> string {
    val params = fnTypeParams(t)
    if idx < 0 || idx >= params.len() { return "unknown" }
    return params.get(idx)
}

/** @brief The bare name an expression is, or "" when it is not one.
 *
 *  A push is spelled `xs.push(v)` and the check needs to know which list is
 *  being written into, so the name is read off the receiver rather than off the
 *  type: a list reached through a field is described by its declaration, and a
 *  list built by a call is described by nothing this pass can see. */
fn bareNameOf(node: ASTNode) -> string {
    match node {
        ASTNode.Literal(lit) => {
            if lit.valType == "identifier" { return lit.text }
            return ""
        }
        _ => { return "" }
    }
}

/** @brief The element type of a list-typed expression, "unknown" when undecided. */
fn listElementOf(sema: Sema, objType: string, recvName: string) -> string {
    // What the program declared outranks what a push happened to say: an
    // annotation is a decision the source made before it ran, and honouring a
    // push over it would let the first push into an empty list redefine the
    // element type the binding just declared.
    val declared = compatTypeListElement(objType)
    if declared != "" { return declared }
    val adopted = lookupListElem(sema, recvName)
    if adopted == "" { return "unknown" }
    return adopted
}

/** @brief The adopted element type for @p name, or "" when there is none. */
fn lookupListElem(sema: Sema, name: string) -> string {
    if name == "" { return "" }
    var i = sema.listElems.len()
    while i > 0 {
        i = i - 1
        val entry: ListElem = sema.listElems.get(i)
        if entry.name == name { return entry.elem }
    }
    return ""
}

/** @brief Remember that the first push into @p name decided the element type.
 *
 *  First push wins, which is the rule the builder's own list-kind registry uses
 *  and for the same reason: the checker approves a slot and the emitter reads it
 *  back, so the two have to name the same type or the check passes for bytes the
 *  program then reads as something else. */
fn adoptListElem(sema: Sema, name: string, elem: string) {
    if name == "" { return }
    if !isSlotElementType(elem) { return }
    if lookupListElem(sema, name) != "" { return }
    sema.listElems.push(ListElem(name, elem))
}

/** @brief Forget an adopted element type: the name now holds something else.
 *
 *  `var tmp = []` then `tmp.push(1)` then `tmp = []` then `tmp.push("s")` is a
 *  program that reuses one name for two lists. The adopted type described the
 *  first list and says nothing about the second, so it is dropped the way a
 *  recorded length is dropped by a push: the answer to "how long is it" stops
 *  being the answer once the value behind the name has changed. */
fn forgetListElem(sema: Sema, name: string) {
    if name == "" { return }
    var i = sema.listElems.len()
    while i > 0 {
        i = i - 1
        val entry: ListElem = sema.listElems.get(i)
        if entry.name == name {
            sema.listElems.set(i, ListElem(name, ""))
        }
    }
}

/** @brief Can this type name what a list slot holds?
 *
 *  "unknown" is the absence of a type rather than a type, and "void" says there
 *  is no value to store, so neither is adopted: an element type invented out of
 *  a gap would be enforced against every later push, and the gap says nothing
 *  about any of them. */
fn isSlotElementType(t: string) -> bool {
    if t == "" || t == "unknown" || t == "void" { return false }
    if t == "int" || t == "float" || t == "string" || t == "bool" { return true }
    if t == "map" || t == "object" { return true }
    if compatTypeBase(t) == "list" { return true }
    // A capitalised name is a model or a union, and either way the slot holds a
    // pointer to it. That is a real element type even though this pass cannot
    // say which fields the value must have.
    if isCapitalised(t) { return true }
    return false
}

/** @brief Is a value of type @p got something a slot holding @p want accepts?
 *
 *  Narrower than argTypeFits on purpose. A parameter is a promise about the
 *  caller, and an unknown argument is let through because refusing it would turn
 *  every inference gap into an error at every use. An element slot is a promise
 *  about the bytes in it, and the read that comes back has to decode as `want`,
 *  so the ways in are agreement, an int widening to a float because the C
 *  backend performs that conversion anyway, and a type this pass does not know
 *  -- which is not a licence to contradict what it does know. */
fn listElementFits(got: string, want: string) -> bool {
    if got == want { return true }
    if want == "float" && got == "int" { return true }
    if got == "" || got == "void" || got == "unknown" { return true }
    if want == "" || want == "void" || want == "unknown" { return true }
    return false
}

/** @brief A push into a list: what the slot claims against what goes into it.
 *
 *  This is the check that was missing. The emitter has carried an element kind
 *  for a list since F-0002 and the runtime refuses a mismatched push, so a
 *  wrong-typed push into a `list<int>` compiled and then died on the way in --
 *  or, where the emitter could not tell the slot's kind either, went in
 *  unexamined and was read back as whatever the reader assumed. A push is also
 *  the one place an unannotated list learns what it holds, so this is where an
 *  empty `[]` acquires the element type its later reads are checked against. */
fn checkListPush(sema: Sema, objType: string, recvName: string, argTypes: list, line: int, col: int) {
    if argTypes.len() != 1 { return }
    val got: string = argTypes.get(0)
    val want = listElementOf(sema, objType, recvName)
    if want == "unknown" {
        adoptListElem(sema, recvName, got)
        return
    }
    if listElementFits(got, want) { return }
    reportErrorAt(sema, "E1006", "A list has one element type: change the value being pushed, or the element type of the list.", line, col, "This list holds " + want + ", so what is pushed into it must be " + want + " -- this value is " + got + ".")
}

/** @brief The type to record for a binding, which is not always the value's type.
 *
 *  An annotation that names an element type says more than the value's own type
 *  can: `val xs: list<int> = []` has a list literal with nothing in it, so the
 *  value types as a bare `list` and the element type the program declared would
 *  be discarded along with it. Every push into xs is unchecked for that reason
 *  alone, and so is every read. The annotation wins only when it carries a
 *  payload the value could not supply; where the value already says `list<int>`
 *  its own answer is the same one. */
fn bindingTypeName(annotation: string, valueType: string) -> string {
    if annotation == "" { return valueType }
    // The C slot is the annotation, so the checker has to agree with it: an int
    // value under a float annotation is the one widening this checker allows,
    // and recording the int would refuse a later float store.
    if annotation == "float" && valueType == "int" { return annotation }
    if compatTypeListElement(annotation) == "" { return valueType }
    if compatTypeListElement(valueType) != "" { return valueType }
    return annotation
}

fn checkCompatibility(expected: string, actual: string) -> bool {
    // Two locals rather than two assignments to the parameters. A string
    // parameter is a `const char *`, and the only way the emitter can write
    // back into one is `(uintptr_t)`, which gcc reports as a pointer built
    // from an integer without a cast. The werror gate caught it, which is the
    // gate doing the one thing it is for.
    val want = canonicalTypeSpelling(expected)
    val got = canonicalTypeSpelling(actual)
    if want == "unknown" || got == "unknown" { return true }
    if want == got { return true }
    if want == "result" { return true }
    if want == "response" { return true }
    if compatTypeBase(want) == "list" && compatTypeBase(got) == "list" {
        return compatibleListElement(want, got)
    }
    // An int where a float is declared widens, and the C backend performs the
    // conversion, so rejecting it would be a check with no bug behind it. The
    // other direction does not: a float in an int register is a truncated
    // number, and F-0015 is about exactly that class.
    if want == "float" && got == "int" { return true }
    return false
}

fn pushScope(sema: Sema) {
    val newScopeId = sema.scopes.len()
    sema.scopes.push(Scope([], sema.currentScope))
    sema.currentScope = newScopeId
    sema.listElemMarks.push(sema.listElems.len())
}

fn popScope(sema: Sema) {
    val parentScope = sema.scopes.get(sema.currentScope)
    sema.currentScope = parentScope.parentId
    // Leaving a scope drops the element types adopted inside it: a list declared
    // in a block is not visible after it, and neither is what was pushed into it.
    if sema.listElemMarks.len() > 0 {
        val mark = sema.listElemMarks.pop()
        while sema.listElems.len() > mark {
            sema.listElems.pop()
        }
    }
}

fn checkModelName(sema: Sema, name: string) {
    if reservedCTypeName(name) {
        sema.currentFunction = name
        reportError(sema, "'" + name + "' is a C type name and cannot be used as an Orbit model name; rename it (for example Orbit" + name + ")")
        sema.currentFunction = ""
    }
}

fn checkModelDecl(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.ModelDecl(m) => {
            checkModelName(sema, m.name)
            declareSymbol(sema, m.name, "model", false, false)
            if m.genericParams.len() > 0 {
                var params = ""
                var gi = 0
                while gi < m.genericParams.len() {
                    match m.genericParams.get(gi) {
                        ASTNode.GenericParam(gparam) => {
                            if gi > 0 { params = params + "," }
                            params = params + gparam.name
                        }
                        _ => {}
                    }
                    gi = gi + 1
                }
                sema.modelGenericOwner.push(m.name)
                sema.modelGenericParams.push(params)
            }
            var i = 0
            while i < m.fields.len() {
                val field: ASTNode = m.fields.get(i)
                match field {
                    ASTNode.FieldDecl(fd) => {
                        sema.modelFieldOwner.push(m.name)
                        sema.modelFieldName.push(fd.name)
                        sema.modelFieldTypeName.push(fd.fieldType)
                    }
                    _ => {}
                }
                checkNode(sema, field)
                i = i + 1
            }
        }
        _ => {}
    }
}

// The declared type of a binding, checked against the type of its value.
//
// `typeAnnotation` was parsed, carried through the AST, and then never read by
// anything. `val x: int = 1e2` bound a float to a name the program had just
// called an int, and the only thing that showed it was what the program
// printed afterwards: 100.0, from a variable declared int. The differential
// fuzzer found it as `unsupported-form-is-silently-wrong-in-a-binding`.
//
// An annotation also names something, and a name nothing declares was equally
// unchecked: `val n: Int = 1` is accepted and emits C that says `Int*`.
fn checkAnnotation(sema: Sema, name: string, declared: string, actual: string, line: int, col: int) {
    if declared == "" { return }
    if checkGenericModelTypeName(sema, declared, line, col) { return }
    // A capitalised name is a type only if something declares it. Not
    // registered as a model, a type or a generic? Then it is a typo or a type
    // from another module, and the C backend will say so in a way that names
    // generated code rather than the annotation.
    if isCapitalised(declared) && !isDeclaredTypeName(sema, declared) {
        reportErrorAt(sema, "E1006", "Types are written in lower case, or declared with `model` or `union`.", line, col, "Nothing declares a type named '" + declared + "'.")
        return
    }
    if checkCompatibility(declared, actual) == false {
        reportErrorAt(sema, "E1006", "Change the annotation, or change the value.", line, col, "'" + name + "' is declared " + declared + " but the value is " + actual + ".")
    }
}

// The assignment target, which no pass visited: `val x = 1; x = 2`,
// `var x = 1; x = "s"` and `missing = 1` all checked clean and the emitter
// stored into the C variable anyway.
//
// A member or index target is a different opcode with a receiver, not a
// binding, so the binding rules do not apply to it. What does apply is the
// declaration that owns the slot: a model names its fields and a `list<T>`
// names what its slots hold, so `p.x = "s"`, `xs[0] = "s"` and `p.y = 2` are
// decided before the emitter hands the C step an int member assigned a
// pointer, or a member the struct never declared. A receiver that is neither a
// known model nor a `list<T>` -- `unknown`, a bare `list`, a string -- stays
// unchecked on purpose: unknown is the documented escape hatch, and reading it
// as an error would reject a program at every store for a gap the store did
// not create.
fn checkAssignmentTarget(sema: Sema, target: ASTNode, valueType: string) {
    val name = bareNameOf(target)
    if name == "" {
        match target {
            ASTNode.MemberAccess(ma) => { checkMemberStore(sema, ma, valueType) }
            ASTNode.IndexAccess(ia) => { checkIndexStore(sema, ia, valueType) }
            _ => {}
        }
        return
    }
    val sym = nearestSymbol(sema, name)
    if sym == NULL {
        recordMiss(sema, "name", name)
        reportError(sema, "Undeclared identifier: " + name + "; nothing in scope declares it")
        return
    }
    if sym.isFunction {
        reportError(sema, "Cannot assign to '" + name + "': it is a function, not a binding.")
        return
    }
    if sym.isMutable == false {
        reportError(sema, "Cannot assign to '" + name + "': it is a val, so it keeps the value it was declared with. Declare it with var if it must change.")
        return
    }
    // An enum's C slot is an int, and the formatter stores its token tags
    // through int fields (fmt.orb). A store is the one place that round-trip
    // is visible; a declaration still has to name a variant.
    if valueType == "int" && isEnumTypeName(sema, sym.typeName) { return }
    if checkCompatibility(sym.typeName, valueType) == false {
        reportError(sema, "Cannot store " + valueType + " in '" + name + "': it is declared " + sym.typeName + ". Change the value, or the binding's type.")
    }
}

// A store into a model's field. The field set is closed because the model
// declaration wrote it down, so both halves are decidable here: the field has
// to exist, and the value has to fit the type the field was declared with.
// The read path asks the same question through checkMemberResolution and
// answers a missing field with the same message, so a store and a read agree
// about what the model declares.
fn checkMemberStore(sema: Sema, ma: MemberAccessNode, valueType: string) {
    val member = ma.field
    val objType = checkNode(sema, ma.object)
    val objName = bareNameOf(ma.object)
    var instModel = ""
    // An instance binds its model's parameters (`Box_float`), so the declared
    // field type has to be substituted before it is compared. A receiver with
    // no instance behind it still names a model when its annotation did, and
    // that model's field types are compared as declared.
    var instBindings = []
    if objName != "" {
        instModel = instanceModelOf(sema, objName)
        if instModel != "" {
            instBindings = instanceBindingsOf(sema, objName)
        } else if isModelName(sema, objType) {
            instModel = objType
        }
    } else if isModelName(sema, objType) {
        instModel = objType
    }
    if instModel == "" { return }
    val fieldType = modelSubstitutedType(modelFieldType(sema, instModel, member), instBindings)
    if fieldType == "" {
        reportErrorAt(sema, "E1009", "The field is spelled as declared; a model has no other members.", ma.line, ma.col, "Model '" + instModel + "' has no field '" + member + "'.")
        return
    }
    // The two directions an enum and an int substitute for each other, the
    // same pair argTypeFits already lets through at a construction: an enum's
    // C slot is an int, and `FmtState.prevTag` is declared int to keep a
    // TokType store out of an enum-typed struct member.
    if fieldType == "int" && isEnumTypeName(sema, valueType) { return }
    if valueType == "int" && isEnumTypeName(sema, fieldType) { return }
    if checkCompatibility(fieldType, valueType) == false {
        reportErrorAt(sema, "E1009", "Change the value, or the field's declared type.", ma.line, ma.col, "Cannot store " + valueType + " in field '" + instModel + "." + member + "': it is declared " + fieldType + ".")
    }
}

// A store into `xs[i]`, which is a store into the element type the list
// declares. A bare `list` carries no element type -- the runtime adopts one on
// the first push -- and a string or a map has members this pass does not
// enumerate, so all three stay unchecked rather than guessed at.
fn checkIndexStore(sema: Sema, ia: IndexAccessNode, valueType: string) {
    val objType = checkNode(sema, ia.object)
    if compatTypeBase(objType) != "list" { return }
    val elem = listElementOf(sema, objType, bareNameOf(ia.object))
    if semaKnownType(elem) == false { return }
    if checkCompatibility(elem, valueType) == false {
        reportErrorAt(sema, "E1009", "Change the value, or the list's element type.", ia.line, ia.col, "Cannot store " + valueType + " in " + objType + ": the element is " + elem + ".")
    }
}

// A generic model named as a DECLARED TYPE. `Box<int>` is expressible: the
// written argument IS the declaration, and it names the same instance the
// literal `Box { v: 1 }` infers, so a signature can talk about what a value
// will be. A BARE `Box` is refused, because a signature is written before any
// value exists and there is nothing there to infer from -- the C step would
// then be handed a struct name that only ever exists under the name its
// arguments make (`Box_int`).
//
// This is not applied to `Box { v: 1 }`. That is an expression, and the
// literal beside the name is exactly what fixes the arguments.
fn isGenericModelTypeName(sema: Sema, name: string) -> bool {
    var bare = name
    val lt = orbit_string_indexOf(name, "<")
    if lt > 0 { bare = orbit_string_slice(name, 0, lt) }
    return modelGenericParamsOf(sema, bare).len() > 0
}

// Whether the annotation carries its arguments. `Box<int>` does; `Box` and
// `Box<>` do not.
fn genericArgsOf(sema: Sema, name: string) -> list {
    var bare = name
    val lt = orbit_string_indexOf(name, "<")
    if lt <= 0 { return [] }
    bare = orbit_string_slice(name, 0, lt)
    val params = modelGenericParamsOf(sema, bare)
    if params.len() == 0 { return [] }
    val n = orbit_string_len(name)
    if n < 2 { return [] }
    if orbit_string_slice(name, n - 1, n) != ">" { return [] }
    val inner = orbit_string_slice(name, lt + 1, n - 1)
    val args = splitOnComma(inner)
    if args.len() != params.len() { return [] }
    return args
}

// The type a symbol declared `Box<int>` carries. It is the instance name, the
// same string the builder builds for the literal, because a checker that
// disagreed with the emitter about which struct a value is would accept the
// program and then read the wrong member.
fn resolvedGenericTypeName(sema: Sema, declared: string) -> string {
    val args = genericArgsOf(sema, declared)
    if args.len() == 0 { return declared }
    val lt = orbit_string_indexOf(declared, "<")
    val bare = orbit_string_slice(declared, 0, lt)
    var out = bare
    var i = 0
    while i < args.len() {
        out = out + "_" + mangleTypeArg(args.get(i))
        i = i + 1
    }
    return out
}

fn checkGenericModelTypeName(sema: Sema, declared: string, line: int, col: int) -> bool {
    if isGenericModelTypeName(sema, declared) == false { return false }
    // Written arguments are a declaration, and the one thing that can stand in
    // for a value before the value exists.
    if genericArgsOf(sema, declared).len() > 0 { return false }
    reportErrorAt(sema, "E1006", "Write the arguments -- `Box<int>` -- or build the value with a literal. A bare generic model has no one type until a value fixes it.", line, col, "'" + declared + "' names a generic model, and a generic model has no one type: a signature written before any value cannot say which one.")
    return true
}

fn checkableParamTypes(sema: Sema, declared: list) -> list {
    var out = []
    var i = 0
    while i < declared.len() {
        val t = declared.get(i)
        if isGenericModelTypeName(sema, t) {
            out.push("unknown")
        } else {
            out.push(t)
        }
        i = i + 1
    }
    return out
}

fn isCapitalised(s: string) -> bool {
    if s.len() == 0 { return false }
    val c = s.at(0)
    return c >= 65 && c <= 90
}

// Something that declares a type: a model, or an entry in the type registry
// (enums, unions and aliases). A generic parameter is not a type yet, so a
// binding to one is left alone.
//
// Plus the four capitalised container spellings, which are real. `mapTypeToC`
// answers to list/List, map/Map, result/Result and response/Response, and the
// reference has always said so. The first version of the capitalised rule
// asked only the two registries above, so it rejected all four -- a check
// added to catch `val n: Int = 1` also refused `val a: List = []`, and
// nothing in the suite used that spelling, so 43 green tests did not notice.
// A rule about which names are types has to be read off the thing that
// decides what a name means, which is the emitter's type table, not off the
// two tables the checker happens to keep.
fn isDeclaredTypeName(sema: Sema, name: string) -> bool {
    if lookupSymbol(sema, name) == "model" { return true }
    if lookupSymbol(sema, name) == "typeparam" { return true }
    if findType(sema, name) >= 0 { return true }
    if name == "List" || name == "Map" || name == "Result" || name == "Response" { return true }
    return false
}

fn checkVarDecl(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.VarDecl(v) => {
            sema.valueSiteLine = v.line
            sema.valueSiteCol = v.col
            val valueType = checkNode(sema, v.value)
            match v.value {
                ASTNode.TypedLiteral(tl) => {
                    if isModelName(sema, tl.declaredType) {
                        recordInstanceModel(sema, v.name, tl.declaredType, modelGenericBindings(sema, tl.declaredType, tl.value))
                    }
                }
                _ => {}
            }
            checkAnnotation(sema, v.name, v.typeAnnotation, valueType, v.line, v.col)
            declareSymbol(sema, v.name, bindingTypeName(v.typeAnnotation, valueType), v.isMutable, false)
            if v.isMutable == false {
                recordConstBound(sema, v.name, v.value)
            }
        }
        _ => {}
    }
}

// A top-level declaration used to become a decl_var in the module's
// pseudo-main function: an uninitialised local, invisible from every other
// function. This compiler only compiled because its lexer constants were
// pasted into the emitter's prelude as text, making the declarations in
// lexer.orb decoration. What a top-level declaration can be is now fixed and
// small -- a name for an integer or boolean literal, which the backend emits
// as a #define -- and everything else is a loud error rather than a silent
// local. Use a function for state.
fn checkTopLevelConstantDecl(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.VarDecl(v) => {
            if v.isMutable {
                reportErrorAt(sema, "E1007", "State lives inside functions; at file scope, only `val NAME = <int or bool literal>` is a declaration.", v.line, v.col, "'" + v.name + "' is a `var` at file scope.")
            } else if isTopLevelConstantExpr(v.value) == false {
                reportErrorAt(sema, "E1007", "Put the value inside a function, or give it an int/bool literal -- only literals become a `#define`.", v.line, v.col, "'" + v.name + "' is a top-level `val`, but its value is not an int or bool literal.")
            }
        }
        ASTNode.ConstDecl(c) => {
            if isTopLevelConstantExpr(c.value) == false {
                reportErrorAt(sema, "E1007", "Put the value inside a function, or give it an int/bool literal -- only literals become a `#define`.", c.line, c.col, "'" + c.name + "' is a constant of file scope, but its value is not an int or bool literal.")
            }
        }
        _ => {}
    }
}

// The initializer shape that may appear at file scope: an integer or boolean
// literal, possibly negated. Anything computed belongs in a function.
fn isTopLevelConstantExpr(node: ASTNode) -> bool {
    match node {
        ASTNode.Literal(l) => {
            return l.valType == "int" || l.valType == "bool"
        }
        ASTNode.UnaryOp(u) => {
            if u.op != "-" { return false }
            match u.operand {
                ASTNode.Literal(l) => { return l.valType == "int" }
                _ => { return false }
            }
        }
        _ => { return false }
    }
}

fn checkConstDecl(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.ConstDecl(c) => {
            sema.valueSiteLine = c.line
            sema.valueSiteCol = c.col
            val valueType = checkNode(sema, c.value)
            match c.value {
                ASTNode.TypedLiteral(tl) => {
                    if isModelName(sema, tl.declaredType) {
                        recordInstanceModel(sema, c.name, tl.declaredType, modelGenericBindings(sema, tl.declaredType, tl.value))
                    }
                }
                _ => {}
            }
            declareSymbol(sema, c.name, valueType, false, false)
            recordConstBound(sema, c.name, c.value)
        }
        _ => {}
    }
}

/* ── Constant index bounds ───────────────────────────────────────────────────
 *
 * `xs.get(99)` on a two-element list used to answer 0, and 0 is also what a
 * slot that really holds 0 answers, so a caller had no way to tell a bug from
 * a value. The runtime now stops the process on an out-of-range read (see
 * orbit_list_index_error), which is the fix for the case the checker cannot
 * see. This is the other half: when the checker CAN see it -- a `val` bound to
 * a literal, indexed by a literal -- there is no reason to compile the program
 * at all.
 *
 * Narrow on purpose. Only:
 *   - an immutable binding, because a `var` can be reassigned and then the
 *     recorded length is a lie;
 *   - a string literal with no backslash in it, because "\t" is two characters
 *     in the source and one in the value and counting the source would make
 *     the check wrong in the direction that rejects good code;
 *   - a list literal, whose length is its element count.
 * Everything else is left to the runtime.
 */
model ConstBound {
    name: string
    kind: string
    len: int
}

fn recordConstBound(sema: Sema, name: string, value: list) {
    if name == "" { return }
    match value {
        ASTNode.Literal(lit) => {
            if lit.valType == "string" {
                if lit.text.indexOf("\\") == -1 {
                    sema.constBounds.push(ConstBound(name, "string", lit.text.len() - 2))
                }
            }
        }
        ASTNode.ListLiteral(ll) => {
            sema.constBounds.push(ConstBound(name, "list", ll.elements.len()))
        }
        _ => {}
    }
}

/** @brief The recorded length for @p name, or -1. */
// Forget a recorded length, because the value it described is no longer the
// value the name holds.
//
// `val xs = []` then `xs.push(10)` then `xs.get(0)` was rejected as "index 0 is
// out of range for xs, which holds 0 elements" -- the checker had recorded the
// empty literal's length and never heard about the push, so a list that
// provably holds an element was reported as provably empty. The check is
// right to be careful about a length that can change, and the answer is to
// stop claiming to know it, not to keep asserting a length that is no longer
// true.
fn forgetConstBound(sema: Sema, name: string) {
    var i = sema.constBounds.len()
    while i > 0 {
        i = i - 1
        val entry: ConstBound = sema.constBounds.get(i)
        if entry.name == name {
            sema.constBounds.set(i, ConstBound(name, "unknown", 0))
        }
    }
}

fn constBoundLen(sema: Sema, name: string, wantKind: string) -> int {
    var i = sema.constBounds.len()
    while i > 0 {
        i = i - 1
        val entry: ConstBound = sema.constBounds.get(i)
        if entry.name == name && entry.kind == wantKind {
            return entry.len
        }
    }
    return -1
}

/** @brief The index of a literal integer index expression, or -1.
 *
 *  Spelled out digit by digit rather than handed to orbit_string_to_int,
 *  because the front end does not know that name: it is a runtime entry point
 *  and nothing in an Orbit program declares it (the same gap as F-0004). A
 *  local loop is the smaller change than teaching the resolver about another
 *  runtime symbol, and it only has to read the one shape a literal index can
 *  take. Anything else -- a computed index, a negative one, a hex literal --
 *  answers -1 and is left to the runtime, which stops the process. */
// orbit-walk: none -- asks the value behind an index literal
fn literalIndexValue(node: list) -> int {
    match node {
        // A negative literal is a unary minus over a positive one -- the lexer
        // makes `-1` two tokens -- so it reads as -1 here rather than as "not
        // a literal", which is what made `x / -1` unreachable.
        ASTNode.UnaryOp(u) => {
            if u.op != "-" { return -1 }
            val inner = literalIndexValue(u.operand)
            if inner < 0 { return -1 }
            return 0 - inner
        }
        ASTNode.Literal(lit) => {
            if lit.valType != "int" { return -1 }
            val text = lit.text
            val n = orbit_string_len(text)
            if n == 0 { return -1 }
            var v = 0
            var i = 0
            while i < n {
                val c = text.at(i)
                if c < 48 || c > 57 { return -1 }
                v = v * 10 + (c - 48)
                i = i + 1
            }
            return v
        }
        _ => { return -1 }
    }
}

fn identifierName(node: list) -> string {
    match node {
        ASTNode.Literal(lit) => {
            if lit.valType == "identifier" { return lit.text }
            return ""
        }
        _ => { return "" }
    }
}

/** @brief Reject a literal index that is past the end of a literal receiver.
 *
 *  Which collection it is comes out of the recorded bound, so the message can
 *  say so: `s.at(99)` over "hello" is a bad character index and `xs.get(99)` is
 *  a bad element index, and both used to answer 0 -- the same 0 a slot holding
 *  0 answers, which is why neither was a bug anybody could see. */
// `-2147483648`, spelled as a negation of the literal 2147483648. The only
// spelling of the integer minimum there is: the value itself does not fit an
// orbit_int, and the range check says so if it is written directly.
fn isIntMinSpelling(node: list) -> bool {
    match node {
        ASTNode.UnaryOp(u) => {
            if u.op != "-" { return false }
            match u.operand {
                ASTNode.Literal(l) => { return l.valType == "int" && l.text == "2147483648" }
                _ => { return false }
            }
        }
        _ => { return false }
    }
}

// Can this operand be evaluated at compile time to an int?
//
// A predicate rather than a sentinel. The first version of this folded to an
// int and used a magic value to mean "no answer", which cannot work: the
// sentinel has to be spelled as arithmetic, because a literal outside orbit_int
// is an error in its own right, and arithmetic is exactly what this function
// evaluates. So the sentinel folded to the same thing a real operand folds to,
// an identifier compared equal to it, and every operand looked foldable. There
// is no value that means "not a number" here -- only the question itself.
//
// Literal, negation of a literal, and sums and differences of those. That is
// the whole set that can reach INT_MIN in a program, since the value itself
// cannot be written down.
// orbit-walk: none -- asks whether a literal folds to an int
fn canFoldInt(node: list) -> bool {
    // `-2147483648` is INT_MIN: a negation of a literal one past INT_MAX. The
    // Literal arm in checkNode returns "int" for exactly that spelling, so the
    // two places have to agree on it or the range check and this disagree about
    // whether the same tree is an integer. literalIndexValue cannot say -- the
    // magnitude does not fit -- so it is named here.
    if isIntMinSpelling(node) { return true }
    val lit = literalIndexValue(node)
    if lit >= 0 { return true }
    match node {
        ASTNode.UnaryOp(u) => {
            if u.op == "-" { return canFoldInt(u.operand) }
            return false
        }
        ASTNode.BinaryOp(b) => {
            if b.op != "+" && b.op != "-" { return false }
            return canFoldInt(b.lhs) && canFoldInt(b.rhs)
        }
        _ => { return false }
    }
}

// The value of an operand already known to satisfy canFoldInt.
// orbit-walk: none -- asks the folded value of a literal
fn foldedIntValue(node: list) -> int {
    if isIntMinSpelling(node) { return 0 - 2147483647 - 1 }
    val lit = literalIndexValue(node)
    if lit >= 0 { return lit }
    match node {
        ASTNode.UnaryOp(u) => { return 0 - foldedIntValue(u.operand) }
        ASTNode.BinaryOp(b) => {
            if b.op == "+" { return foldedIntValue(b.lhs) + foldedIntValue(b.rhs) }
            return foldedIntValue(b.lhs) - foldedIntValue(b.rhs)
        }
        _ => { return 0 }
    }
}

// A `/` or `%` whose divisor is a literal zero, and the one integer division
// that overflows.
//
// Both are constant expressions, and the front end already folds constants, so
// there is nothing to check at run time: `7 / 0` in the emitted C is a
// division the hardware performs and the process dies on. Measured today,
// SIGFPE, exit 136, nothing on either stream. Not a wrong answer and not a
// message -- a crash, which is why the frontend fuzzer never sees it: a crash
// is an event, and that fuzzer only checks programs that exit.
//
// INT_MIN / -1 is the same shape for a different reason. It is the one
// division that overflows at any int width, because the quotient is not
// representable, so it faults the same way a zero divisor does. It cannot be
// caught as "the divisor is zero"; it has to be named.
//
// The rest of the space -- a zero held in a variable, a zero computed at run
// time -- needs a guard in the emitted C, and the emitter has both operand
// types in hand. That is the remaining half of this defect and it is not
// here.
// The operand is passed field by field, not as the node.
//
// A model-typed parameter is emitted as a bare OrbitList* in the C backend, so
// `b.line` inside the callee reads whatever the list header holds rather than
// the field -- and reads it silently, which is worse than a build failure. A
// struct field cannot survive the trip through a union payload that way, so
// the values come in as plain arguments, the way checkConstantIndex already
// takes its line and col.
fn checkDivision(sema: Sema, op: string, rhs: list, lhs: list, line: int, col: int) {
    if op != "/" && op != "%" { return }
    val divisor = literalIndexValue(rhs)
    if divisor == 0 {
        reportErrorAt(sema, "E1004", "A divisor of zero is an error, not a value; guard the case with if d != 0.", line, col, "This " + op + " has a literal 0 divisor, which has no answer.")
        return
    }
    if divisor == -1 {
        // The dividend that overflows is -2147483648, and that value does not
        // fit an orbit_int, so it cannot be spelled directly: written in a
        // program it is already an error, and the range check says so in
        // clearer words than this would. Every spelling that can reach here is
        // therefore arithmetic -- `0 - 2147483647 - 1`, or a negation -- and
        // those arrive as a folded constant rather than as literal text. So
        // this asks what the operand came to, which is the only place the real
        // value exists by the time sema sees it.
        if canFoldInt(lhs) && foldedIntValue(lhs) == 0 - 2147483647 - 1 {
            reportErrorAt(sema, "E1004", "This quotient is not representable as an int; divide as floats, or guard the case.", line, col, "Dividing the most negative int by -1 overflows, and an overflowing division faults the same way a zero divisor does.")
        }
    }
}

fn checkConstantIndex(sema: Sema, recv: list, indexNode: list, line: int, col: int) {
    val idx = literalIndexValue(indexNode)
    if idx < 0 { return }
    val name = identifierName(recv)
    if name == "" { return }
    val slen = constBoundLen(sema, name, "string")
    var llen = -1
    if slen < 0 {
        llen = constBoundLen(sema, name, "list")
        if llen < 0 { return }
    }
    if slen >= 0 && idx < slen { return }
    if slen < 0 && idx < llen { return }
    val at = orbit_int_to_string_selfhost(line) + ":" + orbit_int_to_string_selfhost(col)
    var seen = 0
    while seen < sema.indexChecks.len() {
        if sema.indexChecks.get(seen) == at { return }
        seen = seen + 1
    }
    sema.indexChecks.push(at)
    if slen >= 0 {
        reportErrorAt(sema, "E1002", "indices run from 0 to " + orbit_int_to_string_selfhost(slen - 1) + " here, so a literal one can be checked while compiling", line, col, "String index " + orbit_int_to_string_selfhost(idx) + " is out of range for \"" + name + "\", which holds " + orbit_int_to_string_selfhost(slen) + " characters")
        return
    }
    reportErrorAt(sema, "E1002", "a literal index into a literal list can be checked while compiling; guard a computed one with if i < xs.len()", line, col, "List index " + orbit_int_to_string_selfhost(idx) + " is out of range for \"" + name + "\", which holds " + orbit_int_to_string_selfhost(llen) + " elements")
}

fn checkFunctionSignature(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.FunctionDecl(f) => {
            var returnType = f.returnType
            if returnType == "" {
                returnType = "void"
            }
            // A `-> Box` on a generic model is the same refusal as a `Box`
            // parameter, and it is reported here rather than in the body pass
            // because this is the pass that decides what the function's type IS.
            // "unknown" then keeps the body from disagreeing with it as well.
            if checkGenericModelTypeName(sema, returnType, 0, 0) { returnType = "unknown" }

            if reservedCFunctionName(f.name) {
                sema.currentFunction = f.name
                reportError(sema, "'" + f.name + "' is a C library function name and cannot be used as an Orbit function name; rename it (for example user_" + f.name + ")")
                sema.currentFunction = ""
            } else if f.isExtern == false && reservedRuntimePrefix(f.name) {
                sema.currentFunction = f.name
                reportError(sema, "'" + f.name + "' starts with orbit_, which is reserved for the runtime; rename it (drop the prefix, or use a different one)")
                sema.currentFunction = ""
            }
            // The entry point is one concrete function: nothing calls it with
            // arguments to infer from, so its parameters cannot be generic.
            // An extern has no body to monomorphise. Both are refused here,
            // where the function's type is decided, not in the body pass.
            if f.genericParams.len() > 0 {
                if f.name == "main" {
                    reportError(sema, "The entry point cannot be generic: 'main' has no call site to infer type parameters from; declare one main per type.")
                }
                if f.isExtern {
                    reportError(sema, "An extern function cannot be generic: there is no body to monomorphise per call site; declare one extern per type.")
                }
                sema.genericFnNames.push(f.name)
                sema.genericFnDecls.push(node)
            }
            if f.isExtern {
                sema.externFnNames.push(f.name)
            }
            declareSymbolWithParams(sema, f.name, returnType, false, true, checkableParamTypes(sema, f.paramTypes))
        }
        _ => {}
    }
}

fn checkFunctionBody(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.FunctionDecl(f) => {
            var returnType = f.returnType
            if returnType == "" {
                returnType = "void"
            }
            // `-> Box<int>` names the instance, so the return check compares a
            // `Box { v: 1 }` against `Box_int` and not against the model.
            if genericArgsOf(sema, returnType).len() > 0 { returnType = resolvedGenericTypeName(sema, returnType) }
            val prevReturn = sema.currentReturnType
            sema.currentReturnType = returnType
            sema.currentFunction = f.name

            pushScope(sema)
            // A generic parameter is a type only inside its own body: `T`
            // answers "typeparam" here so annotations can name it, and
            // nowhere else, so a stray `T` outside stays undeclared. The
            // scope pops with the body, so nothing leaks to the next
            // function -- two generics can both call their parameter `T`.
            var gi = 0
            while gi < f.genericParams.len() {
                match f.genericParams.get(gi) {
                    ASTNode.GenericParam(gp) => {
                        declareSymbol(sema, gp.name, "typeparam", false, false)
                    }
                    _ => {}
                }
                gi = gi + 1
            }
            var i = 0
            while i < f.params.len() {
                val pName = f.params.get(i)
                var pType = "unknown"
                if i < f.paramTypes.len() {
                    pType = f.paramTypes.get(i)
                    // "unknown" after the refusal, so the parameter does not
                    // go on to disagree with every argument passed to it and
                    // bury the one diagnostic that says what is actually wrong.
                    if checkGenericModelTypeName(sema, pType, 0, 0) { pType = "unknown" }
                }
                declareSymbol(sema, pName, pType, false, false)
                i = i + 1
            }
            checkNode(sema, f.body)
            popScope(sema)

            sema.currentReturnType = prevReturn
        }
        _ => {}
    }
}

// A `:name...` segment captures the rest of the path, so it is only
// meaningful as the final non-empty segment with a non-empty name. Anything
// else is a route that can never match what it says, diagnosed here next to
// the duplicate-route and limit checks rather than failing silently at
// runtime (the matcher also refuses non-final multis defensively).
fn checkRouteMultiCapture(sema: Sema, routeKey: string, path: string) {
    var nonEmpty = 0
    var i = 0
    var start = 0
    while i <= path.len() {
        var end = false
        if i == path.len() { end = true }
        var isSlash = false
        if end == false {
            if path.at(i) == 47 { isSlash = true }
        }
        if end || isSlash {
            if i > start { nonEmpty = nonEmpty + 1 }
            start = i + 1
        }
        i = i + 1
    }
    i = 0
    start = 0
    var seg = 0
    while i <= path.len() {
        var end = false
        if i == path.len() { end = true }
        var isSlash = false
        if end == false {
            if path.at(i) == 47 { isSlash = true }
        }
        if end || isSlash {
            if i > start {
                seg = seg + 1
                val segLen = i - start
                if segLen >= 4 && path.at(start) == 58 && path.at(i - 1) == 46 && path.at(i - 2) == 46 && path.at(i - 3) == 46 {
                    val nameLen = segLen - 4
                    if nameLen == 0 {
                        reportError(sema, "Route " + routeKey + " has an empty multi-capture name ('...'): write ':name...' with a name.")
                    } else if seg != nonEmpty {
                        val name = path.slice(start + 1, i - 3)
                        reportError(sema, "Route " + routeKey + " captures ':" + name + "...' before the final segment: a multi-capture must end the path.")
                    }
                }
            }
            start = i + 1
        }
        i = i + 1
    }
}

fn checkRouteBody(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.RouteDecl(r) => {
            val routeKey = r.http_method + " " + r.path
            if listContainsValue(sema.seenRoutes, routeKey) {
                reportError(sema, "Duplicate route: " + routeKey)
            } else {
                sema.seenRoutes.push(routeKey)
            }
            if r.has_limit {
                if r.limit_rate <= 0 {
                    reportError(sema, "Route limit rate must be > 0: " + routeKey)
                }
                if r.limit_window_ms <= 0 {
                    reportError(sema, "Route limit window must be > 0: " + routeKey)
                }
                if r.limit_burst < 0 {
                    reportError(sema, "Route limit burst must be >= 0: " + routeKey)
                }
            }
            checkRouteMultiCapture(sema, routeKey, r.path)
            val prevReturn = sema.currentReturnType
            sema.currentReturnType = "response"
            pushScope(sema)
            declareSymbol(sema, "req", "request", false, false)
            declareSymbol(sema, "res", "response", false, false)
            checkNode(sema, r.body)
            popScope(sema)
            sema.currentReturnType = prevReturn
        }
        _ => {}
    }
}

// The callee of a statement that is a call, for the diagnostic that names it.
// "" for a statement of any other shape.
fn discardedCallName(node: ASTNode) -> string {
    match node {
        ASTNode.Call(c) => {
            match c.callee {
                ASTNode.Literal(l) => {
                    if l.valType == "identifier" { return l.text }
                }
                _ => {}
            }
        }
        _ => {}
    }
    return ""
}

// A `result` is the one value in the language that reports a failure by being
// a value: nothing in the runtime logs it, so a statement whose type is
// `result` is a call whose answer was dropped, and the process exits 0 while
// the write, fetch or parse it stood for did not happen. `try` with a `catch`,
// `match`, a binding that is read afterwards, and `return` from a `-> result`
// function are how one is consumed.
//
// A statement of some other shape (a bare name, an `if` used as a statement)
// has no callee to name and carries no position, so it gets the one-line form.
fn checkDiscardedResult(sema: Sema, node: ASTNode, typeName: string) {
    if typeName != "result" { return }
    val hint = "Consume it: bind it with `val r = ...` and read it with `try r catch`, match on it, or return it from a `-> result` function."
    val callee = discardedCallName(node)
    if callee == "" {
        reportError(sema, "A result is discarded here, so a failure it reports is lost and the program carries on as if it had succeeded. " + hint)
        return
    }
    match node {
        ASTNode.Call(c) => {
            reportErrorAt(sema, "E1010", hint, c.line, c.col, "The result of '" + callee + "' is discarded, so a failure it reports is lost and the program carries on as if it had succeeded.")
        }
        _ => {}
    }
}

// Returns the type of the last statement, which is what a block used as an
// expression is worth.
//
// It has to be computed here, inside the scope the block pushed. Asking from
// the caller would mean a second walk of the last statement after popScope,
// and every name that statement declared would then be undeclared -- a real
// diagnostic, and a false one.
//
// `keepLast` says whether the last statement is that value. A branch of an `if`
// and a `match` case can be one, so a result there is handed to whatever reads
// the branch. A function body, a loop body and a nested `{ ... }` have no
// reader, so `checkBlock` keeps nothing.
fn checkBlock(sema: Sema, block: ASTNode) -> string {
    return checkBlockReading(sema, block, false)
}

// A branch or case body, whose last statement may be the value of the `if` or
// `match` it belongs to.
fn checkValueBlock(sema: Sema, branch: ASTNode) -> string {
    match branch {
        ASTNode.Block(b) => { return checkBlockReading(sema, branch, true) }
        _ => { return checkNode(sema, branch) }
    }
}

fn checkBlockReading(sema: Sema, block: ASTNode, keepLast: bool) -> string {
    match block {
        ASTNode.Block(b) => {
            pushScope(sema)
            var i = 0
            var lastType = "void"
            while i < b.statements.len() {
                val stmt = b.statements.get(i)
                lastType = checkNode(sema, stmt)
                if keepLast == false || i + 1 < b.statements.len() {
                    checkDiscardedResult(sema, stmt, lastType)
                }
                i = i + 1
            }
            popScope(sema)
            return lastType
        }
        _ => { return "void" }
    }
}

// The type of an `if` is the type of its then branch, and checking it walks
// each part exactly once: the old shape called this from checkNode and then
// asked for the then branch's type with a second checkNode, so every diagnostic
// inside a branch was reported twice (`print(nope)` under an `if` printed
// "Undeclared identifier" twice).
//
// The value of an `if` is the value of the branch that ran, so the then branch
// is the one that decides the type. The other branch is a different shape and
// the language has no union to join them into, so it is checked but not asked
// for a type; the `else if` chain answers with the innermost then branch, which
// is the only one guaranteed to be there.
fn checkIf(sema: Sema, node: ASTNode) -> string {
    match node {
        ASTNode.If(stmt) => {
            checkNode(sema, stmt.condition)
            val thenType = checkValueBlock(sema, stmt.thenBody)
            match stmt.elseBody {
                ASTNode.Empty => {}
                _ => { checkValueBlock(sema, stmt.elseBody) }
            }
            return thenType
        }
        _ => { return "void" }
    }
}

fn checkWhileLoop(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.While(w) => {
            checkNode(sema, w.condition)
            checkNode(sema, w.body)
        }
        _ => {}
    }
}

fn checkForLoop(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.For(f) => {
            // A `for x in lo..hi` counts ints from lo while the counter is
            // below hi: both bounds are checked here and the item is an int,
            // while the tail below (scope, bindings, body) is shared with
            // the list path. Anything but two ints is refused with both
            // types named, the way a non-list iterable is.
            match f.iterable {
                ASTNode.Range(r) => {
                    val loType = checkNode(sema, r.lo)
                    val hiType = checkNode(sema, r.hi)
                    if loType != "int" || hiType != "int" {
                        reportError(sema, "for ranges count ints, not " + loType + ".." + hiType + ".")
                    }
                    checkForBody(sema, f, "int")
                }
                _ => {
                    // The loop variable is the element the iterable holds, so it is
                    // declared as one. It was declared "unknown", and an unknown is
                    // compatible with every annotation, which is how `for x in [1,2,3]`
                    // gave a loop body an x that read back as nothing at all.
                    val iterType = checkNode(sema, f.iterable)
                    // A `for` lowers to list_len/list_get with no runtime kind check,
                    // so anything but a proven list miscompiles: a string iterates
                    // its bytes as pointers (strings are not iterable), and an
                    // unknown dynamic read segfaults on the first element. Model
                    // field reads answer their declared type above, so declared
                    // lists pass; only the unprovable is refused, with its type named.
                    if compatTypeBase(iterType) != "list" {
                        reportError(sema, "for loops iterate lists, not " + iterType + ".")
                    }
                    checkForBody(sema, f, listElementOf(sema, iterType, bareNameOf(f.iterable)))
                }
            }
        }
        _ => {}
    }
}

// The tail every `for` ends with, whatever it iterates: a scope for the
// bindings, the item, the optional index, the optional label, then the body.
// One function so the list and range paths cannot drift apart on scoping.
fn checkForBody(sema: Sema, f: ForNode, itemType: string) {
    pushScope(sema)
    declareSymbol(sema, f.item, itemType, false, false)
    // The index is a plain int the emitter keeps in sync with its
    // hidden counter. Binding the item twice (`for x, x in xs`) is a
    // duplicate, refused by the same rule as any redeclaration.
    if f.indexVar != "" {
        declareSymbol(sema, f.indexVar, "int", false, false)
    }
    // A label is only visible to the loop's own body: push before the
    // body, pop after, so a label never leaks to a later loop and two
    // nested loops can share nothing by accident.
    if f.label != "" {
        sema.loopLabels.push(f.label)
    }
    checkNode(sema, f.body)
    if f.label != "" {
        sema.loopLabels.pop()
    }
    popScope(sema)
}

fn sameString(left: string, right: string) -> bool {
    return left == right
}

// A named `break`/`continue` must name an enclosing loop: without this a
// typo'd label silently hits the innermost loop instead of failing. The
// search runs innermost-first so nested loops sharing a label resolve the
// way shadowing does everywhere else, and the emitter resolves the same
// way. Plain (unnamed) jumps keep their existing behavior.
fn checkLoopLabel(sema: Sema, label: string, keyword: string) {
    if label == "" { return }
    var i = sema.loopLabels.len()
    while i > 0 {
        i = i - 1
        if sema.loopLabels.get(i) == label { return }
    }
    reportError(sema, keyword + " names unknown loop '" + label + "'.")
}

// The variant a case pattern names, or "" when the pattern is not a variant of
// `matchType`. A pattern is `Type.Variant`, `Type.Variant(binding)`, the bare
// `Variant` form for a payload-less variant, or `_`.
//
// The owner matters. `Other.Circle(r)` is a real case and it is not a case for
// `Shape`, so counting its field name as coverage is how a match that reads
// exhaustive turns out not to be. An unqualified pattern is taken at face
// value: the parser records no type for it and the builder compares the
// variant's own tag.
fn patternVariantName(sema: Sema, matchType: string, pattern: ASTNode) -> string {
    match pattern {
        ASTNode.Literal(l) => {
            if l.valType != "identifier" { return "" }
            return l.text
        }
        ASTNode.MemberAccess(ma) => {
            return qualifiedVariantName(sema, matchType, ma.object, ma.field)
        }
        ASTNode.Call(innerCall) => {
            match innerCall.callee {
                ASTNode.Literal(l) => {
                    if l.valType == "identifier" { return l.text }
                    return ""
                }
                ASTNode.MemberAccess(ma2) => {
                    return qualifiedVariantName(sema, matchType, ma2.object, ma2.field)
                }
                _ => { return "" }
            }
        }
        _ => { return "" }
    }
}

fn qualifiedVariantName(sema: Sema, matchType: string, owner: ASTNode, field: string) -> string {
    var ownerName = ""
    match owner {
        ASTNode.Literal(l) => {
            if l.valType == "identifier" { ownerName = l.text }
        }
        _ => {}
    }
    // A qualifier that names a different declared type is naming a different
    // type's variant, whatever the field is called.
    if ownerName != "" && findType(sema, ownerName) >= 0 && ownerName != matchType { return "" }
    return field
}

fn checkMatchExhaustive(sema: Sema, m: MatchNode, matchType: string) {
    val typeIdx = findType(sema, matchType)
    if isTaggedTypeIndex(sema, typeIdx) == false { return }
    val t: TypeInfo = sema.typeRegistry.get(typeIdx)

    val covered = []
    var hasWildcard = false
    var i = 0
    while i < m.cases.len() {
        val cnode = m.cases.get(i)
        match cnode {
            ASTNode.MatchCase(c) => {
                // `_` is the one opt-out, and it is explicit: it says "the
                // fall-through is intended". That is the whole reason a
                // missing arm can be an error at all. The test is the
                // builder's own, so the two agree on what a wildcard is.
                match c.pattern {
                    ASTNode.Literal(wl) => {
                        if wl.text == "_" { hasWildcard = true }
                    }
                    _ => {}
                }
                val variant = patternVariantName(sema, matchType, c.pattern)
                if variant != "" { covered.push(variant) }
            }
            _ => {}
        }
        i = i + 1
    }
    if hasWildcard { return }

    // One diagnostic per match, not per missing variant: a `match` on a large
    // type can be missing thirty cases, and thirty near-identical lines bury
    // the one fact the reader needs.
    val missing = []
    var v = 0
    while v < t.variants.len() {
        val variantNode = t.variants.get(v)
        var variant = ""
        match variantNode {
            ASTNode.Literal(l) => { variant = l.text }
            _ => {}
        }
        var found = false
        var ck = 0
        while ck < covered.len() {
            if sameString(covered.get(ck), variant) { found = true }
            ck = ck + 1
        }
        if found == false && variant != "" { missing.push(variant) }
        v = v + 1
    }
    if missing.len() == 0 { return }

    var list = ""
    var mi = 0
    while mi < missing.len() {
        if mi > 0 { list = list + ", " }
        list = list + matchType + "." + missing.get(mi)
        mi = mi + 1
    }
    // A match with no case for a variant is not a runtime error the author
    // sees: the builder emits one tag test per case and no test after the
    // last, so the value falls out of the end of the match and the
    // surrounding code carries on as if the match had handled it.
    reportErrorAt(sema, "E1001", "Add a case for every variant, or a `_` arm if the fall-through is intended.", m.line, m.col, "Non-exhaustive match on " + matchType + ": no case for " + list)
}

// The names a match case binds, in order: every identifier argument of a
// `V(a, b)` or `T.V(a, b)` pattern. Non-identifier arguments bind nothing,
// the way a single one does today.
fn patternBindings(pattern: ASTNode) -> list {
    val out = []
    match pattern {
        ASTNode.Call(c) => {
            var i = 0
            while i < c.args.len() {
                match c.args.get(i) {
                    ASTNode.Literal(l) => {
                        if l.valType == "identifier" { out.push(l.text) }
                    }
                    _ => {}
                }
                i = i + 1
            }
        }
        _ => {}
    }
    return out
}

// A case pattern against its variant's declaration: `V(a)` where V declares
// two payloads binds one name and silently drops the other, so the count is
// refused with both numbers. Only what the registry declares is checked, so
// an ordinary call in pattern position keeps today's behavior, and a bare
// `T.V` with no parens still matches on the tag alone.
fn checkPatternArity(sema: Sema, pattern: ASTNode) {
    match pattern {
        ASTNode.Call(c) => {
            var variant = ""
            match c.callee {
                ASTNode.Literal(l) => {
                    if l.valType == "identifier" { variant = l.text }
                }
                ASTNode.MemberAccess(ma) => { variant = ma.field }
                _ => {}
            }
            if variant == "" { return }
            if findVariantOwner(sema, variant) == "" { return }
            val want = variantArityOf(sema, variant)
            if c.args.len() != want {
                reportErrorAt(sema, "E1003", "Bind one name per payload, in order.", c.line, c.col, "Pattern binds " + orbit_int_to_string_selfhost(c.args.len()) + " names but variant '" + variant + "' declares " + orbit_int_to_string_selfhost(want) + " payloads.")
            }
        }
        _ => {}
    }
}

// The first name a match case binds, or "" when the pattern binds nothing.
// Kept because two sites read one binding; it answers what the list form's
// head would.
fn patternBinding(pattern: ASTNode) -> string {
    val bound = patternBindings(pattern)
    if bound.len() == 0 { return "" }
    val first: string = bound.get(0)
    return first
}

// Check a case body with the case's binding in scope.
//
// A binding is a name like any other and no scope contained it, so every
// `match` arm in the compiler -- 241 of them -- read a symbol the checker had
// never seen, and the resolution count below was dominated by the compiler's
// own match arms instead of by anything actually unresolved. The payload's
// type is not known here (a variant declares a payload, not a type for it), so
// the symbol is declared `unknown`, which is now distinguishable from not
// being declared at all rather than being confused with it.
fn checkMatchCase(sema: Sema, c: MatchCaseNode) {
    pushScope(sema)
    checkPatternArity(sema, c.pattern)
    val bound = patternBindings(c.pattern)
    var bi = 0
    while bi < bound.len() {
        val name: string = bound.get(bi)
        declareSymbol(sema, name, "unknown", false, false)
        bi = bi + 1
    }
    checkValueBlock(sema, c.body)
    popScope(sema)
}

fn checkMatch(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.Match(m) => {
            val matchType = checkNode(sema, m.expr)
            var i = 0
            while i < m.cases.len() {
                val caseNode = m.cases.get(i)
                match caseNode {
                    ASTNode.MatchCase(c) => {
                        checkMatchCase(sema, c)
                    }
                    _ => {}
                }
                i = i + 1
            }
            checkMatchExhaustive(sema, m, matchType)
        }
        _ => {}
    }
}

// The value a literal writes under one key, or Empty when the key is absent.
// Looked up by name because the literal is keyed while the model it can be
// checked against is ordered.
fn objectLiteralFieldValue(node: ASTNode, name: string) -> ASTNode {
    match node {
        ASTNode.ObjectLiteral(ol) => {
            var i = 0
            while i < ol.fields.len() {
                val field: ASTNode = ol.fields.get(i)
                match field {
                    ASTNode.FieldInit(fi) => {
                        if fi.name == name { return fi.value }
                    }
                    _ => {}
                }
                i = i + 1
            }
        }
        _ => {}
    }
    return ASTNode.Empty
}

// An object literal written where a model is declared. The literal is keyed and
// the model is ordered, so every key must be a declared field and every declared
// field must be present -- the same closed shape a model construction gets,
// checked by name instead of by argument position.
fn checkObjectLiteralModel(sema: Sema, modelName: string, node: ASTNode) {
    match node {
        ASTNode.ObjectLiteral(ol) => {
            var i = 0
            while i < ol.fields.len() {
                val field: ASTNode = ol.fields.get(i)
                match field {
                    ASTNode.FieldInit(fi) => {
                        if modelFieldType(sema, modelName, fi.name) == "" {
                            reportError(sema, "Model '" + modelName + "' has no field '" + fi.name + "'")
                        }
                    }
                    _ => {}
                }
                i = i + 1
            }
            val declared = modelFieldCount(sema, modelName)
            var d = 0
            while d < declared {
                val fieldName = modelFieldNameAt(sema, modelName, d)
                val want = modelFieldType(sema, modelName, fieldName)
                val valueNode = objectLiteralFieldValue(node, fieldName)
                match valueNode {
                    ASTNode.Empty => {
                        reportError(sema, "Model '" + modelName + "' requires field '" + fieldName + "'")
                    }
                    _ => {
                        val got = checkNode(sema, valueNode)
                        // A generic model's declared types are in terms of its
                        // parameters, which the literal is what fixes, so this
                        // comparison has nothing to compare yet.
                        // checkGenericModelFields below does it against the
                        // substituted type instead.
                        if modelGenericParamsOf(sema, modelName).len() == 0 {
                            if !argTypeFits(got, want) {
                                reportError(sema, "Field '" + modelName + "." + fieldName + "' is declared " + want + " but the value is " + got)
                            }
                        }
                    }
                }
                d = d + 1
            }
            checkGenericModelFields(sema, modelName, node)
        }
        _ => {}
    }
}

// The type parameter names of `modelName` as a list, in declaration order, or
// [] when it declares none. The registry stores one comma-separated string
// because a model with two parameters is one row, and a row has to be a
// string; splitting it back out is this function's whole job.
fn modelGenericParamsOf(sema: Sema, modelName: string) -> list {
    var i = 0
    while i < sema.modelGenericOwner.len() {
        if sema.modelGenericOwner.get(i) == modelName {
            return splitOnComma(sema.modelGenericParams.get(i))
        }
        i = i + 1
    }
    return []
}

fn splitOnComma(s: string) -> list < string > {
    var out = []
    var cur = ""
    var i = 0
    while i < orbit_string_len(s) {
        // 44 is ','. A char is an int here, and every other comparison against
        // one in this compiler is against its code.
        if s.at(i) == 44 {
            val trimmed = trimTypeArgForSema(cur)
            if trimmed != "" { out.push(trimmed) }
            cur = ""
        } else {
            cur = cur + s.slice(i, i + 1)
        }
        i = i + 1
    }
    val tail = trimTypeArgForSema(cur)
    if tail != "" { out.push(tail) }
    return out
}

// parseTypeName writes arguments as ", ", so `Pair<string, float>` is stored
// with a space before `float`. An untrimmed argument would be compared and
// substituted with the space still attached, and no type rule matches " float".
fn trimTypeArgForSema(s: string) -> string {
    var start = 0
    var end = orbit_string_len(s)
    while start < end {
        val c = s.at(start)
        if c != 32 && c != 9 && c != 10 && c != 13 { break }
        start = start + 1
    }
    while end > start {
        val c2 = s.at(end - 1)
        if c2 != 32 && c2 != 9 && c2 != 10 && c2 != 13 { break }
        end = end - 1
    }
    if end <= start { return "" }
    return orbit_string_slice(s, start, end)
}

// What a generic model's literal fixed each type parameter to, as "T int" rows
// in declaration order. A parameter a field's declared type does not MENTION is
// left out, and one nothing determines keeps "unknown" -- see the builder's
// modelLiteralArgTypes, which walks the same fields in the same order and must
// reach the same answer, because the checker deciding that `Box { v: "hi" }` is
// fine and the emitter writing `Box_int` are two halves of one decision.
//
// This is the same inference the builder performs, reached through the
// checker's own expression typer. The two are not the same code and the
// builder's is deliberately the narrow one, so there is a case where they
// disagree: the builder cannot type a method call and says "unknown", while
// checkNode knows the callee's return type. That disagreement fails CLOSED.
// "unknown" is the one type argTypeFits accepts on either side of every rule,
// so a value the checker types and the builder cannot is still checked here
// and still emits `Box_unknown` -- never a `Box_string` the checker did not
// clear.
fn modelGenericBindings(sema: Sema, modelName: string, node: ASTNode) -> list {
    val params = modelGenericParamsOf(sema, modelName)
    var bindings = []
    var p = 0
    while p < params.len() {
        bindings.push(params.get(p) + " unknown")
        p = p + 1
    }
    var d = 0
    while d < modelFieldCount(sema, modelName) {
        val fieldName = modelFieldNameAt(sema, modelName, d)
        val want = modelFieldType(sema, modelName, fieldName)
        val valueNode = objectLiteralFieldValue(node, fieldName)
        // `&&` does not short-circuit in this language, so each guard is a
        // statement. Indexing bindings at -1 is what they keep out of reach.
        val direct = indexInList(params, want)
        if direct >= 0 {
            if bindingTail(bindings.get(direct)) == "unknown" {
                bindings.set(direct, params.get(direct) + " " + checkNode(sema, valueNode))
            }
        }
        val elem = listElementParamIndexOf(params, want)
        if elem >= 0 {
            if bindingTail(bindings.get(elem)) == "unknown" {
                // Descend to the level the parameter sits at, then read the
                // element types of THAT list. Reading the outermost elements of
                // a `list<list<float>>` would bind T to the inner LIST rather
                // than to float, and the field would be checked against itself.
                // Peel count minus one: the last peel produced the parameter
                // name itself, not a list, so the LIST holding that parameter's
                // values is the level before it. `list<list<T>>` peels twice and
                // its values live in the list one level down.
                val depth = listPeelDepthOf(want) - 1
                if depth < 0 {
                    d = d + 1
                } else {
                    match listValueAtDepth(valueNode, depth) {
                        ASTNode.ListLiteral(ll) => {
                            var et = ""
                            var ei = 0
                            var mixed = false
                            while ei < ll.elements.len() {
                                val t = checkNode(sema, ll.elements.get(ei))
                                if t == "" || t == "unknown" || t == "void" {
                                    mixed = true
                                } else {
                                    if et == "" {
                                        et = t
                                    } else {
                                        if et != t { mixed = true }
                                    }
                                }
                                ei = ei + 1
                            }
                            if mixed == false {
                                if et != "" { bindings.set(elem, params.get(elem) + " " + et) }
                            }
                        }
                        _ => {}
                    }
                }
            }
        }
        d = d + 1
    }
    return bindings
}

fn indexInList(items: list, want: string) -> int {
    var i = 0
    while i < items.len() {
        if items.get(i) == want { return i }
        i = i + 1
    }
    return -1
}

fn bindingTail(row: string) -> string {
    val sp = orbit_string_indexOf(row, " ")
    if sp < 0 { return row }
    return orbit_string_slice(row, sp + 1, orbit_string_len(row))
}

fn bindingHead(row: string) -> string {
    val sp = orbit_string_indexOf(row, " ")
    if sp < 0 { return row }
    return orbit_string_slice(row, 0, sp)
}

// `list<...>` peeled as far as it goes: the index of the parameter in the
// innermost element slot, or -1. The DEPTH matters: a `list<list<T>>` field has
// a parameter one level down, and the value has to be descended the same number
// of levels to reach the thing that decides it. Reading one level and giving up
// is what made `model Nested[T] { grid: list<list<T>> }` refuse a value it could
// see the type of, and an inference that only works one level deep is an
// inference whose depth is a rule nobody wrote down.
fn listElementParamIndexOf(params: list, declared: string) -> int {
    return indexInList(params, listPeeledInner(declared))
}

// How many `list<` wrappers the declared type has. The peel is in literal.orb
// and the builder peels with it: the two copies did not agree once, and the
// disagreement read as a checker that accepted a value the emitter could not
// build.
// The element of a list literal `depth` levels down, or Empty. The counterpart
// to the peel: the declared type says how deep to go, and this walks the same
// distance into the value so the two ends of the inference agree.
fn listValueAtDepth(node: ASTNode, depth: int) -> ASTNode {
    var current = node
    var d = 0
    while d < depth {
        match current {
            ASTNode.ListLiteral(ll) => {
                if ll.elements.len() == 0 { return ASTNode.Empty }
                current = ll.elements.get(0)
            }
            _ => { return ASTNode.Empty }
        }
        d = d + 1
    }
    return current
}

fn listPeelDepthOf(declared: string) -> int {
    return listPeelDepth(declared)
}

// The type `declared` becomes once every parameter is bound: the parameter's
// own name where it stands alone, and every other character kept. Word at a
// time on purpose -- the `T` in `string` is not the parameter `T`.
fn modelSubstitutedType(declared: string, bindings: list) -> string {
    var out = ""
    var i = 0
    while i < orbit_string_len(declared) {
        if isTypeWordChar(declared.at(i)) {
            var j = i
            while j < orbit_string_len(declared) {
                if isTypeWordChar(declared.at(j)) == false { break }
                j = j + 1
            }
            out = out + substitutedWord(declared.slice(i, j), bindings)
            i = j
        } else {
            out = out + declared.slice(i, i + 1)
            i = i + 1
        }
    }
    return out
}

fn isTypeWordChar(c: int) -> bool {
    if c >= 48 && c <= 57 { return true }
    if c >= 65 && c <= 90 { return true }
    if c >= 97 && c <= 122 { return true }
    if c == 95 { return true }
    return false
}

fn substitutedWord(word: string, bindings: list) -> string {
    var i = 0
    while i < bindings.len() {
        if bindingHead(bindings.get(i)) == word {
            val arg = bindingTail(bindings.get(i))
            if arg == "unknown" { return word }
            return arg
        }
        i = i + 1
    }
    return word
}

// A generic model's literal, after the type arguments are fixed. Two things
// are checked that are not checked for a model written out longhand.
//
// A parameter nothing determines is a refusal rather than a guess. The builder
// would substitute "unknown" and emit `Box_unknown` with a `void*` field, which
// compiles and computes: `Box { v: 1 + 1 }` would build a `Box_unknown` for a
// value that is plainly an int. Naming the parameter and saying how to fix it
// costs one program the shape it wanted and saves every reader of the struct
// a lie.
//
// And a value that disagrees with what the literal already decided is an error
// naming the model, the field and both types -- `Pair { first: 1, second: true
// }` is a `Pair_int_bool`, which is a different model from `Pair_int_int`, and
// the program did not say which one it meant.
fn checkGenericModelFields(sema: Sema, modelName: string, node: ASTNode) {
    val bindings = modelGenericBindings(sema, modelName, node)
    var i = 0
    while i < bindings.len() {
        if bindingTail(bindings.get(i)) == "unknown" {
            reportErrorAt(sema, "E1006", "Use the type parameter in a field's declared type, or declare one model per type.", sema.valueSiteLine, sema.valueSiteCol, "Model '" + modelName + "' cannot infer type parameter '" + bindingHead(bindings.get(i)) + "': no field's declared type mentions it, so there is no value to take the argument from. Declare one model per type, or use the parameter in a field.")
        }
        i = i + 1
    }
    var d = 0
    while d < modelFieldCount(sema, modelName) {
        val fieldName = modelFieldNameAt(sema, modelName, d)
        val declared = modelFieldType(sema, modelName, fieldName)
        val param = indexInList(modelGenericParamsOf(sema, modelName), declared)
        val substituted = modelSubstitutedType(declared, bindings)
        val valueNode = objectLiteralFieldValue(node, fieldName)
        match valueNode {
            ASTNode.Empty => {}
            _ => {
                val got = checkNode(sema, valueNode)
                if !argTypeFits(got, substituted) {
                    if param >= 0 {
                        reportErrorAt(sema, "E1006", "Change the value, or change the field's declared type.", sema.valueSiteLine, sema.valueSiteCol, "Model '" + modelName + "': field '" + fieldName + "' is declared " + declared + ", which this literal fixes as " + bindingTail(bindings.get(param)) + ", but the value is " + got)
                    } else {
                        reportError(sema, "Field '" + modelName + "." + fieldName + "' is declared " + substituted + " but the value is " + got)
                    }
                }
            }
        }
        d = d + 1
    }
}

// One returned value against the declared return type.
//
// `result` is compatible with every other type in checkCompatibility, which is
// what let `fn f() -> result { return 42 }` pass: the signature promised a value
// a caller can propagate and the body produced an int no `try` can read. A
// `-> result` function builds one with `return ok ...` or `return err ...`
// (different nodes, checked beside this), or returns a value already typed
// result. `unknown` stays accepted, the way every other comparison here does.
fn checkReturnValue(sema: Sema, expectedType: string, actualType: string) {
    if expectedType == "result" {
        if actualType == "result" { return }
        if semaKnownType(actualType) == false { return }
        reportError(sema, "Return type mismatch: expected result, got " + actualType + ": build one with ok(value) or err(message), or return a result bound with `val`")
        return
    }
    if checkCompatibility(expectedType, actualType) == false {
        reportError(sema, "Return type mismatch: expected " + expectedType + ", got " + actualType)
    }
}

fn checkReturn(sema: Sema, node: ASTNode) {
    // ReturnNode carries no position, so a stale valueSite would point at an
    // unrelated line. Reset: a generic literal returned directly keeps the
    // honest one-line form until the parser records literal positions.
    sema.valueSiteLine = 0
    sema.valueSiteCol = 0
    match node {
        ASTNode.Return(r) => {
            var expectedType = sema.currentReturnType
            if expectedType == "" {
                expectedType = "void"
            }
            match r.expr {
                ASTNode.Empty => {
                    if expectedType != "void" {
                        reportError(sema, "Non-void function must return a value")
                    }
                }
                ASTNode.ObjectLiteral(ol) => {
                    if lookupSymbol(sema, expectedType) == "model" {
                        checkObjectLiteralModel(sema, expectedType, r.expr)
                    } else {
                        val actualType = checkNode(sema, r.expr)
                        checkReturnValue(sema, expectedType, actualType)
                    }
                }
                _ => {
                    val actualType = checkNode(sema, r.expr)
                    checkReturnValue(sema, expectedType, actualType)
                }
            }
        }
        ASTNode.ReturnOk(r) => {
            // An ok response carries success. A 4xx/5xx status through ok
            // compiles and serves the wrong semantics: clients and the ledger
            // read the status, not the keyword. Say so at check time.
            if r.status != "" {
                val klass = orbit_string_slice(r.status, 0, 1)
                if klass == "4" || klass == "5" {
                    reportError(sema, "ok response with error status " + r.status + ": use err " + r.status + " instead of return ok " + r.status)
                }
            }
            match r.expr {
                ASTNode.Empty => {
                    reportError(sema, "ok response must include a value")
                }
                _ => {
                    val bodyType = checkNode(sema, r.expr)
                    // A `-> result` function returns a result value, not an
                    // HTTP response, so its body may be any typed value.
                    if sema.currentReturnType == "result" {
                        // body built and type-checked; result fn acceptance
                    } else {
                        // orbit_response_json takes a C string body: a known
                        // non-string body (e.g. an int register) would compile
                        // to an int-to-pointer conversion. Reject it here with
                        // a proper diagnostic instead of broken C downstream.
                        // An object is the other thing a body can legitimately
                        // be: the runtime serializes it to JSON on the way out.
                        if bodyType != "object" && checkCompatibility("string", bodyType) == false {
                            reportError(sema, "ok response body must be a string or an object, got " + bodyType)
                        }
                    }
                }
            }
        }
        ASTNode.ReturnErr(r) => {
            // Mirror of the ok rule: err carries failure, so a 2xx/3xx code
            // through err is the same wrong-semantics program spelled backwards.
            if r.code != "" {
                val klass = orbit_string_slice(r.code, 0, 1)
                if klass == "2" || klass == "3" {
                    reportError(sema, "err response with success status " + r.code + ": use return ok " + r.code + " instead of err " + r.code)
                }
            }
            match r.expr {
                ASTNode.Empty => {
                    reportError(sema, "err response must include a message")
                }
                _ => {
                    val bodyType = checkNode(sema, r.expr)
                    if sema.currentReturnType != "result" {
                        if checkCompatibility("string", bodyType) == false {
                            reportError(sema, "err response body must be a string, got " + bodyType)
                        }
                    }
                }
            }
        }
        _ => {}
    }
}

// Only these can be interpolated. A model, list, map or result has no obvious
// textual form, and guessing one is how a body ends up serving "[object]" or
// garbage: better to refuse and let the author say what they mean.
//
// "unknown" is allowed through on purpose. Sema does not track the type of a
// local bound to a literal, so `val n = 42` reads back as unknown, and
// refusing it would make interpolation useless. It is not a hole: the backend
// refines register types as it emits, and converts each value with the runtime
// helper that matches the type it settled on.
fn isInterpolatable(typeName: string) -> bool {
    if typeName == "string" { return true }
    if typeName == "int" { return true }
    if typeName == "float" { return true }
    if typeName == "bool" { return true }
    if typeName == "unknown" { return true }
    return false
}

fn isStringChunk(node: ASTNode) -> bool {
    match node {
        ASTNode.Literal(l) => {
            if l.valType == "string_chunk" { return true }
            return false
        }
        _ => { return false }
    }
}

// Checking is separate from lowering on purpose. Sema runs first and knows the
// types, so it is the only place that can say "cannot interpolate a model"; the
// builder runs later, knows each value's register type, and picks the
// conversion. Neither needs to wait for the other, and no AST rewriting is
// needed to carry a type from one to the other.
fn checkInterpolation(sema: Sema, node: ASTNode) -> bool {
    match node {
        ASTNode.Interp(ip) => {
            var i = 0
            var bad = 0
            while i < ip.parts.len() {
                val part = ip.parts.get(i)
                if !isStringChunk(part) {
                    val partType = checkNode(sema, part)
                    if !isInterpolatable(partType) {
                        reportError(sema, "cannot interpolate a value of type '" + partType + "' in a string; only string, int, float and bool convert")
                        bad = bad + 1
                    }
                }
                i = i + 1
            }
            return bad == 0
        }
        _ => { return true }
    }
}

// Does this string literal's source contain anything that decodes to byte 0?
//
// `\x00` is the only way: the other escapes are \n \t \r \" \\ and \xHH,
// there is no `\0`, and an unknown escape is kept literally. A raw NUL typed
// into the source is checked too, because the lexer has no reason to stop at it.
fn stringLiteralHasNul(literalText: string) -> bool {
    val body = literalText
    var i = 0
    while i < body.len() {
        val c = orbit_string_char_at_selfhost(body, i)
        if c == 0 { return true }
        if c == 92 { // '\\'
            if i + 3 < body.len() {
                if orbit_string_char_at_selfhost(body, i + 1) == 120 {
                    val a = orbit_string_char_at_selfhost(body, i + 2)
                    val b = orbit_string_char_at_selfhost(body, i + 3)
                    if a == 48 && b == 48 { return true }
                }
            }
            i = i + 4
        } else {
            i = i + 1
        }
    }
    return false
}

// The number a `port` declaration was written with, or -1 when its value is
// not an integer literal. The value node is parsed by the one parser
// `literal.orb` owns, so hex and `_` separators work as they do everywhere
// else.
fn configPortLiteralValue(value: ASTNode) -> int {
    match value {
        ASTNode.Literal(lit) => {
            if lit.valType == "int" { return parseIntSelfhost(lit.text) }
        }
        _ => {}
    }
    return -1
}

// `port` is the one config declaration with a runtime meaning, so it is the
// one with a rule: an integer literal in 1..65535. Before this ran nothing
// dispatched a ConfigDecl at all, and `port "8080"`, `port 0` and
// `port nonexistent_fn()` all passed `orbit check` while the emitted server
// ignored the declaration and bound 3000. The other keys parse as before and
// are still discarded; their values are checked as expressions for the same
// reason a route body is.
fn checkConfigDecl(sema: Sema, cfg: ConfigDeclNode) {
    if cfg.key != "port" {
        checkNode(sema, cfg.value)
        return
    }
    val port = configPortLiteralValue(cfg.value)
    if port < 0 {
        reportErrorAt(sema, "E1008", "Write the number directly, e.g. `port 8080`; the port is fixed when the program is compiled, so an expression is not read.", cfg.line, cfg.col, "The `port` declaration takes an integer literal, and this value is not one.")
        return
    }
    if port < 1 || port > 65535 {
        reportErrorAt(sema, "E1008", "Pick a port between 1 and 65535, e.g. `port 8080`.", cfg.line, cfg.col, "Port " + orbit_int_to_string_selfhost(port) + " is out of range: a TCP port is 1 to 65535.")
    }
}

// orbit-walk-misses: none
fn checkNode(sema: Sema, node: ASTNode) -> string {
    match node {
        ASTNode.Program(prog) => {
            // Pass 1: Register types and models
            var i = 0
            while i < prog.decls.len() {
                val decl = prog.decls.get(i)
                match decl {
                    ASTNode.ModelDecl(m) => { checkModelDecl(sema, decl) }
                    ASTNode.TypeDecl(t) => { registerType(sema, t.name, t.kind, t.variants, t.variantPayloads) }
                    _ => {}
                }
                i = i + 1
            }
            // Pass 2: Register function signatures
            i = 0
            while i < prog.decls.len() {
                val decl = prog.decls.get(i)
                match decl {
                    ASTNode.FunctionDecl(f) => { checkFunctionSignature(sema, decl) }
                    ASTNode.TraitDecl(t) => { declareSymbol(sema, t.name, "type", false, false) }
                    _ => {}
                }
                i = i + 1
            }
            // Pass 3: Constants and top-level vals
            i = 0
            while i < prog.decls.len() {
                val decl = prog.decls.get(i)
                match decl {
                    ASTNode.ConstDecl(c) => {
                        checkTopLevelConstantDecl(sema, decl)
                        checkConstDecl(sema, decl)
                    }
                    ASTNode.VarDecl(v) => {
                        checkTopLevelConstantDecl(sema, decl)
                        checkVarDecl(sema, decl)
                    }
                    _ => {}
                }
                i = i + 1
            }
            // Pass 4: Function bodies, routes, impls
            i = 0
            while i < prog.decls.len() {
                val decl = prog.decls.get(i)
                match decl {
                    ASTNode.FunctionDecl(f) => { checkFunctionBody(sema, decl) }
                    ASTNode.ConfigDecl(c) => { checkConfigDecl(sema, c) }
                    ASTNode.RouteDecl(r) => { checkRouteBody(sema, decl) }
                    ASTNode.ImplDecl(im) => {
                        var j = 0
                        while j < im.methods.len() {
                            checkFunctionBody(sema, im.methods.get(j))
                            j = j + 1
                        }
                    }
                    // The one declaration shape that is not a declaration. The
                    // three passes above match the kinds they know and drop the
                    // rest, so a bare expression at file scope used to be
                    // checked by nobody and built by nobody: `marker()` at file
                    // scope emitted a definition for `marker`, no call to it,
                    // and an `orbit_main` that returns 0, with `orbit check` at
                    // rc 0 (measured 2026-10-19). `parseDeclaration` is the only
                    // builder of this node and `parseProgram` its only caller
                    // (parser.orb:1578, :1586), so being here means file scope,
                    // and the honest answer is to refuse the shape rather than
                    // to check the expression the output does not contain.
                    ASTNode.ExpressionStmt(e) => {
                        // The pass above leaves the last function it checked in
                        // currentFunction; this refusal is not inside it, and
                        // "[in marker]" for a file-scope statement reads as a
                        // lie about where the expression is.
                        sema.currentFunction = ""
                        reportError(sema, "Cannot execute an expression at file scope: nothing here runs it, so it is discarded and the program computes something else. Move it into a function, or bind it with `val`.")
                    }
                    _ => {}
                }
                i = i + 1
            }
            return ""
        }
        ASTNode.FunctionDecl(f) => { checkFunctionBody(sema, node)
            return ""
        }
        ASTNode.VarDecl(v) => { checkVarDecl(sema, node)
            return ""
        }
        ASTNode.ConstDecl(c) => { checkConstDecl(sema, node)
            return ""
        }
        ASTNode.BinaryOp(b) => {
            checkDivision(sema, b.op, b.rhs, b.lhs, b.line, b.col)
            val lhsType = checkNode(sema, b.lhs)
            val rhsType = checkNode(sema, b.rhs)
            if b.op == "==" || b.op == "!=" || b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" {
                return "bool"
            }
            if b.op == "&&" || b.op == "||" { return "bool" }
            // Bitwise and shift operators are int-only, and the refusal is
            // here rather than in the C verifier so `orbit check` is enough to
            // see it. A known non-int operand is a contradiction the checker
            // can name; `unknown` operands stay silent the way `unknown`
            // everywhere else does.
            if b.op == "&" || b.op == "|" || b.op == "^" || b.op == "<<" || b.op == ">>" {
                if lhsType == "int" && rhsType == "int" { return "int" }
                if semaKnownType(lhsType) || semaKnownType(rhsType) {
                    reportError(sema, "bitwise '" + b.op + "' takes two ints, not '" + lhsType + "' and '" + rhsType + "'")
                }
                return "unknown"
            }
            if b.op == "+" && (lhsType == "string" || rhsType == "string") { return "string" }
            if lhsType == "float" || rhsType == "float" { return "float" }
            if lhsType == "int" && rhsType == "int" { return "int" }
            return "unknown"
        }
        ASTNode.UnaryOp(u) => {
            // `-2147483648` is INT_MIN spelled as a negation of a literal that
            // is itself one past INT_MAX. The literal does not fit on its own,
            // but the expression it appears in denotes a representable value
            // and is the only spelling of the integer minimum there is, so the
            // range check below is skipped here and nowhere else.
            if u.op == "-" {
                match u.operand {
                    ASTNode.Literal(l) => {
                        if l.valType == "int" && l.text == "2147483648" { return "int" }
                    }
                    _ => {}
                }
            }
            val operandType = checkNode(sema, u.operand)
            if u.op == "!" { return "bool" }
            if u.op == "~" {
                if operandType == "int" { return "int" }
                if semaKnownType(operandType) {
                    reportError(sema, "bitwise '~' takes one int, not '" + operandType + "'")
                }
                return "unknown"
            }
            return operandType
        }
        ASTNode.Literal(l) => {
            if l.valType == "identifier" {
                // A bare function name in value position is the function as a
                // value: `val f = foo` binds f to foo's signature, not to what
                // foo returns. Answering the return type instead is what made
                // every later `f(x)` read "it is a int, not a function" for a
                // name the program had just bound from a function. A live
                // variable shadows the function of the same name -- the
                // nearest scope decides -- so only a name no variable
                // declares reads as a function.
                val foundSym = nearestSymbol(sema, l.text)
                // Nested, not &&: both sides of && evaluate, so a NULL
                // guard joined that way still dereferences NULL (every bare
                // NULL or provided name in the program crashed here).
                if foundSym != NULL {
                    if foundSym.isFunction {
                        // The entry point is not a value: its C name is orbit_main
                        // and its address is the process entry, so binding it
                        // would call back into startup, not into the body.
                        if l.text == "main" {
                            reportError(sema, "Cannot use 'main' as a value: it is the entry point, not a callable value; move the body into a named function and use that.")
                            return "unknown"
                        }
                        // A generic has no one signature until a call fixes its
                        // parameters, so a bare reference has nothing to infer
                        // from. Calling it is the only honest use; binding it
                        // would monomorphise nothing.
                        if isGenericFn(sema, l.text) {
                            reportError(sema, "Cannot use generic function '" + l.text + "' as a value: call it so the arguments fix its type parameters; a bare reference has nothing to infer them from.")
                            return "unknown"
                        }
                        // A value is called through a C cast that passes the
                        // request arena first, which is correct for every
                        // function this module emits and wrong for an extern:
                        // `val f = orbit_file_exists` reassigned emitted
                        // `(... (OrbitArena* arena, orbit_string))(f))(arena,
                        // path)` against `bool orbit_file_exists(const char*
                        // filename)`, so the callee read the arena as its path.
                        // An unreassigned binding is devirtualised into a direct
                        // call and works, but nothing in the spelling tells the
                        // two apart, and a rule the checker cannot make visible
                        // is worse than a refusal.
                        if isExternFnName(sema, l.text) {
                            reportError(sema, "Cannot use extern function '" + l.text + "' as a value: a value is called through a C cast that passes the request arena first, and an extern does not take one, so its arguments would shift; call the extern directly instead.")
                            return "unknown"
                        }
                        return fnTypeSpelling(foundSym.typeName, foundSym.paramTypes)
                    }
                }
                val typeName = resolveSymbol(sema, l.text)
                if typeName == "" {
                    // Nothing declares this name. That is not the same as not
                    // knowing the type of a name that IS declared, and the two
                    // used to be the same string.
                    if l.text.len() > 0 {
                        val first = l.text.slice(0, 1)
                        if first >= "A" && first <= "Z" { return l.text }
                    }
                    // `ok` and `err` are statements, not values, and they are
                    // the pair `isProvidedName` must not silence: a bare one
                    // resolves to nothing, so the backend hoisted an
                    // uninitialized slot for it and `return err 500 "boom"`
                    // returned that slot, leaving the code and the message
                    // unreachable -- the route answered nothing and the router
                    // logged 200 for it. The rest of the provided names are
                    // method and builtin names, which are called; these two are
                    // the only ones the grammar gives a statement form to.
                    if l.text == "ok" {
                        reportError(sema, "'ok' is not a value: it starts a response. Write 'return ok <status> <body>' in a route, or 'ok(value)' inside a '-> result' function.")
                        return "unknown"
                    }
                    if l.text == "err" {
                        reportError(sema, "'err' is not a value: it starts an error response. Write 'err <code> <message>' as a statement, or 'err(\"message\", code)' inside a '-> result' function.")
                        return "unknown"
                    }
                    if !isProvidedName(l.text) {
                        recordMiss(sema, "name", l.text)
                        reportError(sema, "Undeclared identifier: " + l.text + "; nothing in scope declares it")
                    }
                    return "unknown"
                }
                // A list the program has pushed into is a `list<T>` from here
                // on, not a bare `list`. The symbol was declared as a bare
                // `list` because the value it was bound to was an empty
                // literal, and the element type arrived afterwards with the
                // first push; leaving the answer as `list` would throw that
                // away at every use that is not the push itself, so a list of
                // lists pushed into a `list<list<int>>` read back as a bare
                // `list` and contradicted the slot it was written into.
                if compatTypeBase(typeName) == "list" && compatTypeListElement(typeName) == "" {
                    val adopted = lookupListElem(sema, l.text)
                    if adopted != "" { return "list<" + adopted + ">" }
                }
                return typeName
            }
            // A raw string is a string as far as the type system is concerned;
            // string_raw only exists to tell the lowering not to unescape it.
            if l.valType == "string_raw" { return "string" }
            if l.valType == "string" && stringLiteralHasNul(l.text) {
                // An orbit_string is a NUL-terminated `const char*`, so a
                // string that contains a zero byte is truncated at that byte
                // on the way into C. `\x00` used to be kept as the four
                // characters `\x00` instead, which contradicts the documented
                // meaning of the byte escape and is the one escape this
                // language cannot honour. Saying so is the honest answer;
                // emitting the byte would silently lose everything after it.
                reportError(sema, "a string cannot contain a NUL byte: an orbit_string is a C string, so \"\\x00\" would truncate the value at that point")
            }
            // Literal chunks of an interpolation are already their own ASTNode
            // and are not reachable as a value, but keep them harmless.
            if l.valType == "string_chunk" { return "string" }
            if l.valType == "int" {
                // Recorded, not rejected. Rejecting an out-of-range literal is
                // one line away and it is the right end state -- gcc refuses
                // the same literal for the same reason -- but the corpus
                // contains tests that assert the wrap on purpose
                // (tests/std/test_time_ns.orb:93-94 call sinceNsBetween with
                // INT_MAX+1 to prove the clamp fires), and tests/std belongs to
                // another zone. So the case is detected, counted and ratcheted
                // here, and the diagnostic waits for those two lines to be
                // rewritten as 2147483647 + 1. FINDINGS F-0014.
                if !intLiteralFitsSelfhost(l.text) {
                    // An error, not a resolution gap. It was recorded rather
                    // than rejected only because two lines of a std test
                    // spelled the overflow as a literal; they are now written
                    // as the sum it is, so the reason is gone.
                    //
                    // Counting it as a miss also meant every program with a
                    // large integer printed `UNRESOLVED int-literal 1` to
                    // stderr -- a quiet program is supposed to say nothing.
                    reportError(sema, "integer literal " + l.text + " does not fit an orbit_int, which is 32 bits; write the value as a sum if you mean it")
                }
            }
            return l.valType
        }
        ASTNode.Interp(ip) => { checkInterpolation(sema, node)
            return "string"
        }
        ASTNode.ObjectLiteral(ol) => {
            var i = 0
            while i < ol.fields.len() {
                val field: ASTNode = ol.fields.get(i)
                match field {
                    ASTNode.FieldInit(fi) => {
                        val fieldType = checkNode(sema, fi.value)
                        // Lists are JSON arrays: scalars and objects serialize
                        // through orbit_object_set_list, so they are allowed.
                        // Maps have no JSON form in the runtime and nested
                        // lists would mis-serialize (a ref slot holds one
                        // pointer with no tag for object-vs-list), so both
                        // stay rejected with a diagnostic, not silent bytes.
                        if compatTypeBase(fieldType) == "map" {
                            reportError(sema, "an object field cannot hold a " + fieldType + " yet: { " + fi.name + ": ... }")
                        } else if compatTypeBase(fieldType) == "list" {
                            val inner = compatTypeListElement(fieldType)
                            if compatTypeBase(inner) == "list" || compatTypeBase(inner) == "map" {
                                reportError(sema, "an object field cannot hold a nested " + inner + " yet: { " + fi.name + ": ... }")
                            }
                        }
                    }
                    _ => {}
                }
                i = i + 1
            }
            return "object"
        }
        ASTNode.Match(m) => { checkMatch(sema, node)

            // The first case's body gives the type of the whole expression.
            // Its binding has to be in scope to read it, or a match used as a
            // value reads a name no scope declares while the same match in
            // statement position does not.
            if m.cases.len() > 0 {
                match m.cases.get(0) {
                    ASTNode.MatchCase(mc) => {
                        pushScope(sema)
                        // No arity check here: checkMatch already ran
                        // checkMatchCase over every case, which checks it.
                        val bound = patternBindings(mc.pattern)
                        var bi = 0
                        while bi < bound.len() {
                            val name: string = bound.get(bi)
                            declareSymbol(sema, name, "unknown", false, false)
                            bi = bi + 1
                        }
                        val caseType = checkValueBlock(sema, mc.body)
                        popScope(sema)
                        return caseType
                    }
                    _ => { return "void" }
                }
            }
            return "void"
        }
        ASTNode.Call(c) => {
            // The callee is resolved by the match below, not by the generic
            // identifier rule: a callee that is a builtin, a model
            // construction, a variant construction or a declared function is
            // not an unresolved name, and only what is left over is one.
            var calleeName = ""
            match c.callee {
                ASTNode.Literal(calleeLit) => {
                    if calleeLit.valType == "identifier" {
                        calleeName = calleeLit.text
                        resolveCalleeName(sema, calleeName)
                        checkModelCtor(sema, c.args, c.line, c.col, calleeName)
                    }
                }
                ASTNode.MemberAccess(ma) => {
                    // res.header / res.cookie take exactly the name and the
                    // value. Checked here, where the diagnostic can name the
                    // call site, rather than as broken C downstream; the
                    // response receiver only exists in route bodies.
                    match ma.object {
                        ASTNode.Literal(ol) => {
                            if ol.valType == "identifier" && ol.text == "res" && sema.currentReturnType == "response" {
                                if ma.field == "header" || ma.field == "cookie" {
                                    if c.args.len() != 2 {
                                        reportErrorAt(sema, "E1003", "Give the header name and value.", c.line, c.col, "res." + ma.field + " takes exactly 2 arguments, got " + orbit_int_to_string_selfhost(c.args.len()) + ".")
                                    }
                                }
                            }
                        }
                        _ => {}
                    }
                    checkNode(sema, c.callee)
                }
                _ => { checkNode(sema, c.callee) }
            }
            // The argument types are kept as they are walked, not asked for a
            // second time. A check that wanted them from a fresh checkNode would
            // print every diagnostic inside an argument twice, which is the same
            // reason checkIf checks each branch exactly once.
            val argTypes: list = []
            var i = 0
            while i < c.args.len() {
                argTypes.push(checkNode(sema, c.args.get(i)))
                i = i + 1
            }
            if calleeName != "" {
                checkCallArity(sema, calleeName, c.args.len())
                // A generic callee's declared types name type variables, so
                // the ordinary argument check would refuse every call: names
                // that fix a variable are governed by coherence below, in the
                // callee arms, instead.
                if isGenericFn(sema, calleeName) == false {
                    checkCallArgTypes(sema, calleeName, c.args, c.line, c.col)
                }
                // A call through a function value has no declaration symbol,
                // so both checks above pass it silently. The value's spelling
                // is the signature; check the call against it here instead.
                if resolveFunction(sema, calleeName) == "" {
                    val vtype = resolveSymbol(sema, calleeName)
                    if isFnType(vtype) {
                        checkFnVarCall(sema, calleeName, vtype, c.args, argTypes, c.line, c.col)
                    }
                }
            }
            // Check for builtins
            match c.callee {
                ASTNode.Literal(l) => {
                    if l.valType == "identifier" {
                        // `ok` carries the value a `try` yields and `err`
                        // carries a message and an optional code; one built
                        // with the wrong number of positions has nothing to
                        // hand the consumer, and the builder emitted whichever
                        // argument it found. The reference grammar is
                        // `ok(expr)` and `err(expr[, expr])`.
                        if l.text == "ok" {
                            if c.args.len() != 1 {
                                reportErrorAt(sema, "E1003", "Give ok exactly one value: the value a later `try` yields.", c.line, c.col, "ok takes exactly 1 argument, got " + orbit_int_to_string_selfhost(c.args.len()) + ".")
                            }
                            return "result"
                        }
                        if l.text == "err" {
                            if c.args.len() < 1 || c.args.len() > 2 {
                                reportErrorAt(sema, "E1003", "Give err a message, and a code only if you mean one: err(message) or err(message, code).", c.line, c.col, "err takes 1 or 2 arguments, got " + orbit_int_to_string_selfhost(c.args.len()) + ".")
                            }
                            return "result"
                        }
                        if l.text == "print" {
                            // Multi-argument print emits nothing at all: the
                            // backend lowers `print(a, b)` to a comment, so a
                            // program that looks like it prints two values
                            // runs silent. One argument is the whole contract.
                            if c.args.len() != 1 {
                                reportErrorAt(sema, "E1003", "Print one value: concatenate or interpolate the rest into a single string.", c.line, c.col, "print takes exactly 1 argument, got " + orbit_int_to_string_selfhost(c.args.len()) + ".")
                            }
                            return "void"
                        }
                        // A call whose callee names a model is that model's
                        // construction, not a function call, so it has that
                        // model's type. Reporting it as unknown is how a model
                        // reached a string hole and printed as nothing at all.
                        if lookupSymbol(sema, l.text) == "model" { return l.text }
                        // A generic call monomorphises per call site: the
                        // arguments fix the type variables, coherence across
                        // positions is checked, and the call answers the
                        // substituted return type. A declared function wins
                        // over a variant of the same name, generic or not.
                        if isGenericFn(sema, l.text) {
                            match genericFnDecl(sema, l.text) {
                                ASTNode.FunctionDecl(fd) => {
                                    return checkGenericCall(sema, l.text, fd, c.args, argTypes, c.line, c.col)
                                }
                                _ => {}
                            }
                        }
                        val fnType = lookupFunction(sema, l.text)
                        if fnType != "unknown" { return fnType }
                        // A call through a variable holding a function value
                        // answers the signature's return type. A declared
                        // function wins above, so this is only the value case.
                        val vtype = lookupSymbol(sema, l.text)
                        if isFnType(vtype) { return fnTypeReturn(vtype) }
                        // `Circle(7)` is the construction of a variant, and it
                        // has the union's type, not the "unknown" a bare
                        // callee otherwise gets. A declared function of the
                        // same name wins, because then the call really is a
                        // call and only the payload is ambiguous.
                        val variantOwner = findVariantOwner(sema, l.text)
                        if variantOwner != "" {
                            checkVariantCall(sema, l.text, c.args, argTypes, c.line, c.col)
                            return variantOwner
                        }
                        return "unknown"
                    }
                }
                ASTNode.MemberAccess(ma) => {
                    val objType = checkNode(sema, ma.object)
                    val member = ma.field
                    // A literal index into a literal receiver is decidable now
                    // and never at run time, so it is decided now. `at` is the
                    // string spelling and `get` the list one, and both used to
                    // answer 0 for an index past the end.
                    if member == "at" || member == "get" || member == "charAt" {
                        if c.args.len() >= 1 {
                            checkConstantIndex(sema, ma.object, c.args.get(0), c.line, c.col)
                        }
                    }
                    // `ASTNode.MatchCase(x)` and `Shape.Circle(7)`: a variant
                    // reached through its type name is that type's value, the
                    // same way the bare-name form above is.
                    if typeHasVariant(sema, objType, member) {
                        checkVariantCall(sema, member, c.args, argTypes, c.line, c.col)
                        return objType
                    }
                    // The receiver's own name, when it is a bare identifier.
                    // A `push` on it is what makes a recorded length stale, so
                    // it is needed before the builtin table, not after.
                    var callObjName = ""
                    match ma.object {
                        ASTNode.Literal(ol) => {
                            if ol.valType == "identifier" { callObjName = ol.text }
                        }
                        _ => {}
                    }
                    if objType == "string" {
                        if member == "len" { return "int" }
                        if member == "contains" { return "bool" }
                        if member == "slice" { return "string" }
                        if member == "to_int" { return "int" }
                    }
                    // `compatTypeBase` and not the literal "list": a list whose
                    // element type is known types as `list<int>`, and a test
                    // for the bare spelling matched none of them, so `xs.len()`
                    // on an annotated list answered "unknown" and `xs.push(...)`
                    // never reached the check below.
                    if compatTypeBase(objType) == "list" {
                        if member == "len" { return "int" }
                        if member == "push" {
                            forgetConstBound(sema, callObjName)
                            checkListPush(sema, objType, callObjName, argTypes, c.line, c.col)
                            return "void"
                        }
                        // A read hands back the slot's element, which is the
                        // whole of `list<T>`: without this the annotation said
                        // what a list could hold and nothing said what reading
                        // one gives you.
                        if member == "get" || member == "at" || member == "pop" {
                            return listElementOf(sema, objType, callObjName)
                        }
                    }
                    if objType == "map" || objType == "Map" {
                        if member == "has" { return "bool" }
                        if member == "keys" { return "list<string>" }
                        if member == "delete" { return "void" }
                    }
                    if callObjName == "system" {
                        if member == "env" { return "string" }
                        if member == "uptime" { return "int" }
                        if member == "pid" { return "int" }
                        if member == "active_workers" { return "int" }
                        if member == "http_requests_total" { return "int" }
                        if member == "latency_avg_us" { return "int" }
                        if member == "latency_p50_us" || member == "latency_p95_us" || member == "latency_p99_us" { return "int" }
                    }
                }
                _ => {}
            }
            return "unknown"
        }
        ASTNode.MemberAccess(ma) => {
            val objType = checkNode(sema, ma.object)
            val member = ma.field
            checkMemberResolution(sema, objType, member, ma.line, ma.col)
            if objType == "string" && member == "length" { return "int" }
            // `ASTNode.Empty` used as a value is an ASTNode, and reading it as
            // a field of some model of the same name is not: only a declared
            // variant of the receiver's own type is a union value.
            if typeHasVariant(sema, objType, member) { return objType }
            var objName = ""
            match ma.object {
                ASTNode.Literal(l) => { if l.valType == "identifier" { objName = l.text } }
                _ => {}
            }
            // The system.* builtins, so their type is known rather than
            // unknown. An unknown type is compatible with everything, which is
            // how `ok 200 system.uptime()` reached the C backend and passed an
            // int where a string pointer belongs.
            if objName == "system" {
                if member == "env" { return "string" }
                if member == "uptime" { return "int" }
                if member == "pid" { return "int" }
                if member == "active_workers" { return "int" }
                if member == "http_requests_total" { return "int" }
                if member == "latency_avg_us" { return "int" }
                if member == "latency_p50_us" || member == "latency_p95_us" || member == "latency_p99_us" { return "int" }
            }
            // A read of a model instance's field is worth the declared type:
            // `post.tags` where Post declares `tags: list<string>` answers
            // list<string> instead of unknown, so a `for` over it (and any
            // other use) checks against something real. The declaration-site
            // bindings substitute parameters (`floats.items` on a
            // Bagged_float answers list<float>). Dynamic objects keep
            // unknown: nothing declares their fields.
            if objName != "" {
                var instModel = instanceModelOf(sema, objName)
                var instBindings = []
                if instModel == "" {
                    val symType = resolveSymbol(sema, objName)
                    if isModelName(sema, symType) {
                        instModel = symType
                    }
                } else {
                    instBindings = instanceBindingsOf(sema, objName)
                }
                if instModel != "" {
                    val fieldType = modelSubstitutedType(modelFieldType(sema, instModel, member), instBindings)
                    if fieldType != "" { return fieldType }
                }
            }
            return "unknown"
        }
        ASTNode.IndexAccess(ia) => {
            // `xs[i]` is `xs.get(i)`, so it is worth the slot's element too.
            val objType = checkNode(sema, ia.object)
            checkNode(sema, ia.index)
            checkConstantIndex(sema, ia.object, ia.index, ia.line, ia.col)
            if compatTypeBase(objType) == "list" { return listElementOf(sema, objType, bareNameOf(ia.object)) }
            return "unknown"
        }
        ASTNode.ModelDecl(m) => { checkModelDecl(sema, node)
            return ""
        }
        ASTNode.FieldDecl(fd) => { return "" }
        ASTNode.Block(block) => { return checkBlock(sema, node)
        }
        ASTNode.Return(r) => { checkReturn(sema, node)
            return ""
        }
        ASTNode.ReturnOk(r) => { checkReturn(sema, node)
            return ""
        }
        ASTNode.ReturnErr(r) => { checkReturn(sema, node)
            return ""
        }
        ASTNode.If(stmt) => { return checkIf(sema, node) }
        ASTNode.While(w) => { checkWhileLoop(sema, node)
            return ""
        }
        ASTNode.For(f) => { checkForLoop(sema, node)
            return ""
        }
        ASTNode.Range(r) => {
            // Unreachable through the parser: only the `for` header builds
            // a range, and checkForLoop consumes it by matching, never
            // through here. The arm exists so the dispatch gate sees the
            // variant handled; it checks the bounds rather than dropping
            // them, and answers what the wildcard would.
            checkNode(sema, r.lo)
            checkNode(sema, r.hi)
            return "unknown"
        }
        ASTNode.TypeDecl(td) => { registerType(sema, td.name, td.kind, td.variants, td.variantPayloads)
            return ""
        }
        ASTNode.RouteDecl(r) => { checkRouteBody(sema, node)
            return ""
        }
        ASTNode.Try(tr) => {
            checkNode(sema, tr.expr)
            match tr.catchBody {
                ASTNode.Empty => {}
                _ => {
                    // The name the catch binds has to be in scope before the
                    // body is walked, or every use of it inside the body is an
                    // undeclared identifier.
                    if tr.errName != "" {
                        declareSymbol(sema, tr.errName, "string", false, false)
                    }
                    checkNode(sema, tr.catchBody)
                }
            }
            return "unknown"
        }
        ASTNode.MatchCase(mc) => { return "" }
        ASTNode.GenericParam(gp) => { return "" }
        ASTNode.TraitDecl(trd) => { declareSymbol(sema, trd.name, "type", false, false)
            return ""
        }
        ASTNode.ImplDecl(im) => {
            var j = 0
            while j < im.methods.len() {
                checkFunctionBody(sema, im.methods.get(j))
                j = j + 1
            }
            return ""
        }
        ASTNode.ScheduleDecl(s) => { checkNode(sema, s.handler)
            return ""
        }
        ASTNode.ConfigDecl(cfg) => { checkConfigDecl(sema, cfg)
            return ""
        }
        ASTNode.MigrationDecl(m) => { return "" }
        ASTNode.Break(b) => { checkLoopLabel(sema, b.label, "break")
            return ""
        }
        ASTNode.Continue(c) => { checkLoopLabel(sema, c.label, "continue")
            return ""
        }
        ASTNode.ImportStmt(i) => { return "" }
        ASTNode.UseStmt(u) => { return "" }
        ASTNode.Decorator(d) => { return "" }
        ASTNode.TypeAnnotation(ta) => { return "" }
        // A model literal is checked as that model: keys against declared
        // fields, so `Post { titel: "x" }` is a typo the checker can see, and a
        // bare `{...}` stays a dynamic object with no declared type to hold it
        // against.
        ASTNode.TypedLiteral(tl) => {
            if isModelName(sema, tl.declaredType) {
                checkObjectLiteralModel(sema, tl.declaredType, tl.value)
                // A generic literal is worth its INSTANCE, which is what both
                // the emitter builds and a `-> Box<int>` names. Answering with
                // the bare model name would make every return and every
                // annotation on a generic value a mismatch against itself.
                val params = modelGenericParamsOf(sema, tl.declaredType)
                if params.len() == 0 { return tl.declaredType }
                val bindings = modelGenericBindings(sema, tl.declaredType, tl.value)
                var name = tl.declaredType
                var bi = 0
                while bi < bindings.len() {
                    name = name + "_" + mangleTypeArg(bindingTail(bindings.get(bi)))
                    bi = bi + 1
                }
                return name
            }
            checkNode(sema, tl.value)
            return ""
        }
        ASTNode.FieldInit(fi) => { checkNode(sema, fi.value)
            return ""
        }
        // checkNode, not inferType: an expression statement reaches the
        // checker only through here, so a check that lives in checkNode is
        // not run for `print(7 / 0)` unless this dispatches to it.
        //
        // Measured 2026-10-19: nothing dispatches to it. A bare call inside a
        // body comes back from `parseStatementInner` unwrapped (parser.orb:1476)
        // and is checked as a Call, and the file-scope shape -- the only one
        // `parseDeclaration` builds (parser.orb:1578) -- is not routed through
        // here either, because the Program pass matches the declaration kinds
        // itself. That shape is refused in that pass now; this arm still checks
        // an expression statement if a walk ever hands it one.
        ASTNode.ExpressionStmt(e) => {
            // Unpositioned dispatch like checkReturn: reset valueSite so a
            // literal standing alone as a statement never inherits a line.
            sema.valueSiteLine = 0
            sema.valueSiteCol = 0
            // The dispatch exists so a check that lives in checkNode runs for
            // a statement; the statement's type has to be looked at too, or a
            // `result` is computed and dropped here.
            val exprType = checkNode(sema, e.expr)
            checkDiscardedResult(sema, e.expr, exprType)
            return ""
        }
        ASTNode.Assignment(a) => {
            val valueType = checkNode(sema, a.value)
            checkAssignmentTarget(sema, a.target, valueType)
            forgetListElem(sema, bareNameOf(a.target))
            return ""
        }
        ASTNode.ListLiteral(ll) => {
            var ei = 0
            var uniform = ""
            var mixed = false
            while ei < ll.elements.len() {
                val elemType = checkNode(sema, ll.elements.get(ei))
                if elemType == "" || elemType == "unknown" {
                    mixed = true
                } else if uniform == "" {
                    uniform = elemType
                } else if elemType != uniform {
                    mixed = true
                }
                ei = ei + 1
            }
            // A uniform payload is what `list<T>` means; a literal whose
            // elements all agree is that, statically. Mixed and empty only
            // support the opaque `list`.
            if uniform != "" && mixed == false {
                return "list<" + uniform + ">"
            }
            return "list"
        }
        ASTNode.Empty => {
            // The absence of a node. Nothing to check, and no type to answer:
            // "void" says there is no value here without claiming a type.
            return "void"
        }
        // Reached only by a variant this function has no arm for, which
        // dispatch-coverage.py fails the build over. The answer is "unknown"
        // rather than "void" on purpose: void claims a type this pass knows,
        // and for a node it does not recognise it does not.
        _ => { return "unknown" }
    }
}

fn analyze(sema: Sema, node: ASTNode) {
    checkNode(sema, node)
}
