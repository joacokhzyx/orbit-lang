// Lower the frontend AST into frontend-owned Canonical Typed IR.
// No backend data structure is imported here.

import "../front/ast.orb"
import "./format.orb"

model TirBinding {
    name: string
    typeName: string
}

fn tirValue(valueId: int) -> string {
    return "v" + tirIntText(valueId)
}

// The type a literal carries. A chunk of an interpolated string is text with
// its backslash escapes still in it, and the value it builds is a string, so
// the reader of types and the lowerer answer `string` for it rather than the
// parser's own tag.
fn tirLiteralType(node: LiteralNode) -> string {
    if node.valType == "identifier" { return "unknown" }
    if node.valType == "string_chunk" { return "string" }
    return node.valType
}

fn tirBinaryType(op: string, leftType: string, rightType: string) -> string {
    if op == "==" { return "bool" }
    if op == "!=" { return "bool" }
    if op == "<" { return "bool" }
    if op == "<=" { return "bool" }
    if op == ">" { return "bool" }
    if op == ">=" { return "bool" }
    if op == "&&" { return "bool" }
    if op == "||" { return "bool" }
    // Int-only operators: an int and an int, or an answer this reader does
    // not have. The `leftType == rightType` rule below would answer "string"
    // for two strings, which is right for `+` and wrong for `&`.
    if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
        if leftType == "int" && rightType == "int" { return "int" }
        return "unknown"
    }
    if leftType == rightType { return leftType }
    return "unknown"
}

fn bindingType(bindings: list < TirBinding >, name: string) -> string {
    var i = bindings.len()
    while i > 0 {
        i = i - 1
        val binding: TirBinding = bindings.get(i)
        if binding.name == name { return binding.typeName }
    }
    return "unknown"
}

fn copyBindings(bindings: list < TirBinding >) -> list < TirBinding > {
    val copied = []
    var i = 0
    while i < bindings.len() {
        copied.push(bindings.get(i))
        i = i + 1
    }
    return copied
}

// The return type the program declares for this function name, or "" when it
// declares none. Every answer below used to be a name written into this file:
// `tirIntText` and `isVisited` and `hasErrors` each needed their own line, and a
// function the reader did not think of answering stayed `unknown`. The lowering
// registers each function before it lowers its body, so a call to one already
// declared is typed from the declaration itself.
fn declaredReturnType(module: TirModule, name: string) -> string {
    var i = module.functions.len()
    while i > 0 {
        i = i - 1
        val declared: TirFunction = module.functions.get(i)
        if declared.name == name { return declared.returnType }
    }
    return ""
}

// orbit-walk: none -- asks what type an expression is
fn typeOfExpression(module: TirModule, bindings: list < TirBinding >, node: ASTNode) -> string {
    match node {
        ASTNode.Literal(literal) => {
            if literal.valType == "identifier" {
                val bound = bindingType(bindings, literal.text)
                if bound != "unknown" { return bound }
                val fromDeclaration = declaredReturnType(module, literal.text)
                if fromDeclaration != "" { return fromDeclaration }
                return "unknown"
            }
            return tirLiteralType(literal)
        }
        ASTNode.BinaryOp(binary) => {
            return tirBinaryType(binary.op, typeOfExpression(module, bindings, binary.lhs), typeOfExpression(module, bindings, binary.rhs))
        }
        ASTNode.UnaryOp(unary) => {
            val operandType = typeOfExpression(module, bindings, unary.operand)
            if unary.op == "!" {
                if operandType == "bool" { return "bool" }
                return "unknown"
            }
            if unary.op == "-" {
                if operandType == "int" { return "int" }
                if operandType == "float" { return "float" }
            }
            if unary.op == "~" {
                if operandType == "int" { return "int" }
            }
            return "unknown"
        }
        ASTNode.MemberAccess(member) => {
            if member.field == "len" || member.field == "length" { return "int" }
            return "unknown"
        }
        // The type a list literal carries. `lowerExpression` emits the same
        // answer, and the two must agree: a binding seeded with a type the
        // reader does not know is an `unknown` load at every later use of the
        // name. The element kind is not here -- the pass keeps no table for it.
        ASTNode.ListLiteral(listNode) => {
            return "list"
        }
        // An interpolated string is one value the source wrote in pieces, and the
        // piece that is text is always text. The element kind of a list is not
        // known here; nothing about an interpolation is.
        ASTNode.Interp(interpNode) => {
            return "string"
        }
        ASTNode.Call(call) => {
            match call.callee {
                ASTNode.Literal(l) => {
                    val declared = declaredReturnType(module, l.text)
                    if declared != "" { return declared }
                    if l.text == "len" || l.text == "indexOf" || l.text == "orbit_os_argc_selfhost" || l.text == "orbit_string_char_at_selfhost" { return "int" }
                    if l.text == "orbit_int_to_string_selfhost" || l.text == "orbit_float_to_string_selfhost" || l.text == "orbit_os_argv_selfhost" || l.text == "orbit_os_exec_selfhost" || l.text == "orbit_os_env_selfhost" || l.text == "orbit_file_read_selfhost" || l.text == "slice" || l.text == "at" || l.text == "tirEscape" || l.text == "tirIntText" { return "string" }
                    if l.text == "orbit_file_write_selfhost" || l.text == "hasErrors" || l.text == "tirHasErrors" || l.text == "isVisited" { return "bool" }
                    if l.text == "print" { return "void" }
                    return bindingType(bindings, l.text)
                }
                ASTNode.MemberAccess(ma) => {
                    if ma.field == "len" || ma.field == "length" || ma.field == "indexOf" { return "int" }
                    if ma.field == "slice" || ma.field == "at" { return "string" }
                }
                _ => {}
            }
            return "unknown"
        }
        _ => return "unknown"
    }
}

// Which node the frontend gave up on. E3001 printed one sentence for every
// unsupported expression and E3000 one sentence for every unsupported
// declaration, so the census could report 9,233 give-ups and nobody could say
// what they were. The name is the variant the source writes, because that is the
// string a reader meets in `compiler/front/ast.orb` and in the walk-coverage
// declarations. A position is not here: the nodes that carry one disagree about
// which field holds it, and `typeOfExpression` has no line to pass either.
// orbit-walk: none -- names a node; it visits no children
fn astNodeKind(node: ASTNode) -> string {
    match node {
        ASTNode.Program(n) => { return "Program" }
        ASTNode.FunctionDecl(n) => { return "FunctionDecl" }
        ASTNode.RouteDecl(n) => { return "RouteDecl" }
        ASTNode.ModelDecl(n) => { return "ModelDecl" }
        ASTNode.TypeDecl(n) => { return "TypeDecl" }
        ASTNode.FieldDecl(n) => { return "FieldDecl" }
        ASTNode.TraitDecl(n) => { return "TraitDecl" }
        ASTNode.ImplDecl(n) => { return "ImplDecl" }
        ASTNode.VarDecl(n) => { return "VarDecl" }
        ASTNode.ConstDecl(n) => { return "ConstDecl" }
        ASTNode.ScheduleDecl(n) => { return "ScheduleDecl" }
        ASTNode.ConfigDecl(n) => { return "ConfigDecl" }
        ASTNode.MigrationDecl(n) => { return "MigrationDecl" }
        ASTNode.ImportStmt(n) => { return "ImportStmt" }
        ASTNode.UseStmt(n) => { return "UseStmt" }
        ASTNode.ExpressionStmt(n) => { return "ExpressionStmt" }
        ASTNode.If(n) => { return "If" }
        ASTNode.While(n) => { return "While" }
        ASTNode.For(n) => { return "For" }
        ASTNode.Return(n) => { return "Return" }
        ASTNode.ReturnOk(n) => { return "ReturnOk" }
        ASTNode.ReturnErr(n) => { return "ReturnErr" }
        ASTNode.Match(n) => { return "Match" }
        ASTNode.MatchCase(n) => { return "MatchCase" }
        ASTNode.Try(n) => { return "Try" }
        ASTNode.Literal(n) => { return "Literal" }
        ASTNode.Interp(n) => { return "Interp" }
        ASTNode.ObjectLiteral(n) => { return "ObjectLiteral" }
        ASTNode.BinaryOp(n) => { return "BinaryOp" }
        ASTNode.UnaryOp(n) => { return "UnaryOp" }
        ASTNode.Call(n) => { return "Call" }
        ASTNode.MemberAccess(n) => { return "MemberAccess" }
        ASTNode.IndexAccess(n) => { return "IndexAccess" }
        ASTNode.ListLiteral(n) => { return "ListLiteral" }
        ASTNode.Assignment(n) => { return "Assignment" }
        ASTNode.TypeAnnotation(n) => { return "TypeAnnotation" }
        ASTNode.GenericParam(n) => { return "GenericParam" }
        ASTNode.Decorator(n) => { return "Decorator" }
        ASTNode.Block(n) => { return "Block" }
        ASTNode.Break(n) => { return "Break" }
        ASTNode.Continue(n) => { return "Continue" }
        ASTNode.FieldInit(n) => { return "FieldInit" }
        ASTNode.TypedLiteral(n) => { return "TypedLiteral" }
        ASTNode.Empty => { return "Empty" }
        ASTNode.Range(n) => { return "Range" }
    }
    return "unknown node"
}

// orbit-walk-misses: AssignmentNode, ConfigDeclNode, ConstDeclNode, ExpressionStmtNode, FieldInitNode, ForNode, FunctionDeclNode, IfNode, IndexAccessNode, MatchCaseNode, MatchNode, RangeNode, ReturnErrNode, ReturnNode, ReturnOkNode, RouteDeclNode, ScheduleDeclNode, TryNode, TypedLiteralNode, VarDeclNode, WhileNode
fn lowerExpression(module: TirModule, function: TirFunction, blockId: int, bindings: list < TirBinding >, node: ASTNode) -> int {
    match node {
        ASTNode.Literal(literal) => {
            if literal.valType == "identifier" {
                var typeName = bindingType(bindings, literal.text)
                if typeName == "unknown" {
                    // A name the program declares as a function is known. The
                    // callee of `take(x)` is a load of `take`, and the load had
                    // nothing to read, so the pass raised E2001 and
                    // `tirCanonical` answers nothing at all when a diagnostic of
                    // severity error exists: a file that called its own
                    // functions printed no TIR. Only a non-empty answer counts
                    // -- an undeclared name must keep its E2001, which is what
                    // tests/frontend/unresolved_type.orb pins.
                    val fromDeclaration = declaredReturnType(module, literal.text)
                    if fromDeclaration != "" { typeName = fromDeclaration }
                }
                if typeName == "unknown" {
                    tirError(module, "E2001", "unknown identifier " + literal.text, 0, 0)
                }
                return tirEmit(function, blockId, "load", typeName, literal.text)
            }
            return tirEmit(function, blockId, "const", tirLiteralType(literal), literal.text)
        }
        ASTNode.BinaryOp(binary) => {
            val leftType = typeOfExpression(module, bindings, binary.lhs)
            val rightType = typeOfExpression(module, bindings, binary.rhs)
            val left = lowerExpression(module, function, blockId, bindings, binary.lhs)
            val right = lowerExpression(module, function, blockId, bindings, binary.rhs)
            val resultType = tirBinaryType(binary.op, leftType, rightType)
            if resultType == "unknown" {
                tirError(module, "E2002", "incompatible operands for " + binary.op, 0, 0)
            }
            return tirEmit(function, blockId, binary.op, resultType, tirValue(left) + " " + tirValue(right))
        }
        ASTNode.UnaryOp(unary) => {
            val operand = lowerExpression(module, function, blockId, bindings, unary.operand)
            val resultType = typeOfExpression(module, bindings, node)
            if resultType == "unknown" {
                tirError(module, "E2003", "invalid operand for unary " + unary.op, 0, 0)
            }
            return tirEmit(function, blockId, "unary." + unary.op, resultType, tirValue(operand))
        }
        ASTNode.MemberAccess(member) => {
            val objVal = lowerExpression(module, function, blockId, bindings, member.object)
            val resType = typeOfExpression(module, bindings, node)
            // A member read is the second-largest source of `unknown` in the
            // corpus and the largest one that said nothing: the lowering had a
            // diagnostic for a load, a binary op and a unary op, and none for
            // this, so a member on a receiver it cannot type reached codegen
            // with no code and no message. FINDINGS F-0018.
            if resType == "unknown" {
                tirError(module, "E2004", "cannot type the member read ." + member.field, 0, 0)
            }
            return tirEmit(function, blockId, "member", resType, tirValue(objVal) + " " + member.field)
        }
        ASTNode.Call(call) => {
            // `print` is a builtin the builder lowers to the runtime's print;
            // there is no binding to resolve, and its result is no value.
            var calleeIsPrint = false
            match call.callee {
                ASTNode.Literal(pl) => { if pl.text == "print" { calleeIsPrint = true } }
                _ => {}
            }
            if calleeIsPrint {
                var printOperands = "print"
                var pi = 0
                while pi < call.args.len() {
                    val argument: ASTNode = call.args.get(pi)
                    val value = lowerExpression(module, function, blockId, bindings, argument)
                    printOperands = printOperands + " " + tirValue(value)
                    pi = pi + 1
                }
                return tirEmit(function, blockId, "call", "void", printOperands)
            }
            val callee = lowerExpression(module, function, blockId, bindings, call.callee)
            var operands = tirValue(callee)
            var i = 0
            while i < call.args.len() {
                val argument: ASTNode = call.args.get(i)
                val value = lowerExpression(module, function, blockId, bindings, argument)
                operands = operands + " " + tirValue(value)
                i = i + 1
            }
            val returnType = typeOfExpression(module, bindings, node)
            // Same reasoning as E2004, and the larger of the two: a call whose
            // result cannot be typed is a call the front end does not know the
            // signature of, and it used to be indistinguishable from one it did
            // -- which is how an unchecked argument type reached codegen.
            if returnType == "unknown" {
                tirError(module, "E2005", "cannot type the result of this call", 0, 0)
            }
            return tirEmit(function, blockId, "call", returnType, operands)
        }
        // `[1, 2]` is a value, and the pass had no rule for it: the elements
        // were never lowered and the whole expression was a give-up, 412 of them
        // over the corpus. The container is typed `list` and not `list<int>`:
        // the frontend keeps no element-kind table, and a type it cannot justify
        // is the lie the `unknown` count exists to make visible. An empty list is
        // the same shape with zero elements.
        ASTNode.Interp(interp) => {
            // `s"..."` is the parts concatenated, and the parts are either text
            // the parser cut out of the literal or an expression written in
            // `${...}`. The flag travels because whether the chunk is taken
            // verbatim or unescaped is decided at the build, not here: the
            // frontend records which reading its text carries rather than
            // copying the unescape rule into this module.
            var interpOperands = tirIntText(interp.parts.len())
            if interp.isRaw {
                interpOperands = interpOperands + " raw"
            } else {
                interpOperands = interpOperands + " unescaped"
            }
            var pi = 0
            while pi < interp.parts.len() {
                val part: ASTNode = interp.parts.get(pi)
                val partValue = lowerExpression(module, function, blockId, bindings, part)
                interpOperands = interpOperands + " " + tirValue(partValue)
                pi = pi + 1
            }
            return tirEmit(function, blockId, "interp", "string", interpOperands)
        }
        ASTNode.ListLiteral(listNode) => {
            var elements = ""
            var li = 0
            while li < listNode.elements.len() {
                val item = lowerExpression(module, function, blockId, bindings, listNode.elements.get(li))
                if item < 0 { return -1 }
                elements = elements + " " + tirValue(item)
                li = li + 1
            }
            return tirEmit(function, blockId, "list", "list", tirIntText(li) + elements)
        }
        _ => {
            tirError(module, "E3001", "expression cannot be lowered to TIR: " + astNodeKind(node), 0, 0)
            return -1
        }
    }
}

// `breakTarget` and `continueTarget` are the blocks the enclosing loop jumps to,
// or -1 outside a loop. A `break` used to fall to the expression reader and come
// back as "expression cannot be lowered to TIR: Break" -- 91 over the corpus, 26
// more for `continue` -- and the error suppressed the file's canonical TIR.
// Returns the block into which the following statement must be emitted.
// A terminator returns -1, which makes later source statements unreachable.
// orbit-walk-misses: BinaryOpNode, CallNode, ConfigDeclNode, ConstDeclNode, ExpressionStmtNode, FieldInitNode, FunctionDeclNode, IndexAccessNode, MatchCaseNode, MatchNode, ReturnErrNode, ReturnOkNode, RouteDeclNode, ScheduleDeclNode, TryNode, TypedLiteralNode, UnaryOpNode
fn lowerStatement(module: TirModule, function: TirFunction, blockId: int, bindings: list < TirBinding >, node: ASTNode, breakTarget: int, continueTarget: int) -> int {
    if blockId < 0 { return blockId }
    match node {
        ASTNode.VarDecl(declaration) => {
            val value = lowerExpression(module, function, blockId, bindings, declaration.value)
            tirEmit(function, blockId, "bind", "unit", declaration.name + " " + tirValue(value))
            bindings.push(TirBinding(declaration.name, typeOfExpression(module, bindings, declaration.value)))
            return blockId
        }
        // `x = 5` in statement position rebinds a name the block already
        // bound, which is the `bind` shape a `val` emits. Until now it fell to
        // the fallback below, reached the expression reader and came back as
        // "expression cannot be lowered to TIR: Assignment" -- 3,137 times over
        // the corpus, the largest class the census counts. Writing through a
        // place is not this: the frontend has no place model, so `a.b = e` and
        // `xs[i] = e` still give up, now naming the place.
        ASTNode.Assignment(assignment) => {
            val value = lowerExpression(module, function, blockId, bindings, assignment.value)
            var storeName = ""
            match assignment.target {
                ASTNode.Literal(target) => {
                    if target.valType == "identifier" { storeName = target.text }
                }
                ASTNode.MemberAccess(place) => {
                    // `d.x = 2` writes through a place, and the write answers no
                    // type. It is lowered when the place's own value is one the
                    // pass can type -- `d` here, a parameter whose declared type
                    // the binding carries. A chained place (`tok.line = 5` under a
                    // receiver it cannot type) stays a give-up, because reading
                    // the place needs a member instruction the frontend has no
                    // type for: the frontend keeps no model table, so emitting it
                    // would add an `unknown` where the give-up adds nothing.
                    // The check of the value against the field's declaration is
                    // the checker's job in the build path, not this pass's.
                    if typeOfExpression(module, bindings, place.object) != "unknown" {
                        val receiver = lowerExpression(module, function, blockId, bindings, place.object)
                        if receiver >= 0 {
                            tirEmit(function, blockId, "store_field", "unit", tirValue(receiver) + " " + place.field + " " + tirValue(value))
                            return blockId
                        }
                    }
                }
                _ => {}
            }
            if storeName != "" {
                tirEmit(function, blockId, "bind", "unit", storeName + " " + tirValue(value))
                bindings.push(TirBinding(storeName, typeOfExpression(module, bindings, assignment.value)))
                return blockId
            }
            tirError(module, "E3001", "cannot lower this assignment to TIR: " + astNodeKind(assignment.target), 0, 0)
            return blockId
        }
        ASTNode.Return(ret) => {
            // A bare `return` in a function that answers nothing has no value to
            // lower. It reached the expression reader and came back as
            // "expression cannot be lowered to TIR: Empty" -- 279 over the
            // corpus, and the error suppressed the file's canonical text. The
            // operand is written `void` rather than left empty, so every
            // `instr` line keeps the same number of fields.
            if astNodeKind(ret.expr) == "Empty" {
                tirEmit(function, blockId, "return", "unit", "void")
                return -1
            }
            val value = lowerExpression(module, function, blockId, bindings, ret.expr)
            tirEmit(function, blockId, "return", "unit", tirValue(value))
            return -1
        }
        ASTNode.Block(block) => {
            var i = 0
            var currentBlock = blockId
            while i < block.statements.len() {
                val statement: ASTNode = block.statements.get(i)
                currentBlock = lowerStatement(module, function, currentBlock, bindings, statement, breakTarget, continueTarget)
                i = i + 1
            }
            return currentBlock
        }
        ASTNode.If(branch) => {
            val condition = lowerExpression(module, function, blockId, bindings, branch.condition)
            if typeOfExpression(module, bindings, branch.condition) != "bool" {
                tirError(module, "E2100", "if condition must have type bool", 0, 0)
            }
            val thenBlock = tirCreateBlock(function)
            val elseBlock = tirCreateBlock(function)
            val mergeBlock = tirCreateBlock(function)
            tirEmit(function, blockId, "branch", "unit", tirValue(condition) + " b" + tirIntText(thenBlock) + " b" + tirIntText(elseBlock))

            val thenBindings = copyBindings(bindings)
            val thenEnd = lowerStatement(module, function, thenBlock, thenBindings, branch.thenBody, breakTarget, continueTarget)
            if thenEnd >= 0 {
                tirEmit(function, thenEnd, "jump", "unit", "b" + tirIntText(mergeBlock))
            }

            val elseBindings = copyBindings(bindings)
            val elseEnd = lowerStatement(module, function, elseBlock, elseBindings, branch.elseBody, breakTarget, continueTarget)
            if elseEnd >= 0 {
                tirEmit(function, elseEnd, "jump", "unit", "b" + tirIntText(mergeBlock))
            }
            return mergeBlock
        }
        ASTNode.While(loopNode) => {
            val conditionBlock = tirCreateBlock(function)
            val bodyBlock = tirCreateBlock(function)
            val exitBlock = tirCreateBlock(function)
            tirEmit(function, blockId, "jump", "unit", "b" + tirIntText(conditionBlock))

            val condition = lowerExpression(module, function, conditionBlock, bindings, loopNode.condition)
            if typeOfExpression(module, bindings, loopNode.condition) != "bool" {
                tirError(module, "E2101", "while condition must have type bool", 0, 0)
            }
            tirEmit(function, conditionBlock, "branch", "unit", tirValue(condition) + " b" + tirIntText(bodyBlock) + " b" + tirIntText(exitBlock))

            val bodyBindings = copyBindings(bindings)
            val bodyEnd = lowerStatement(module, function, bodyBlock, bodyBindings, loopNode.body, exitBlock, conditionBlock)
            if bodyEnd >= 0 {
                tirEmit(function, bodyEnd, "jump", "unit", "b" + tirIntText(conditionBlock))
            }
            return exitBlock
        }
        // `for x in lo..hi` counts an int between the bounds, so every value the
        // loop reads has a type this pass can answer: the bounds once, the hidden
        // counter as int, and the item as a copy of it. Over anything else the
        // item's type is the element kind, and the pass keeps no element table --
        // the same reason a chained field write stays a give-up -- so that path
        // names what it is missing rather than emitting `unknown`. A label names a
        // loop other than the innermost one, which one pair of targets cannot
        // carry, so a labelled loop is a give-up too.
        ASTNode.For(loopNode) => {
            if loopNode.label != "" {
                tirError(module, "E3001", "for with a label has no target for a named break", 0, 0)
                return blockId
            }
            match loopNode.iterable {
                ASTNode.Range(bounds) => {
                    if typeOfExpression(module, bindings, bounds.lo) != "int" {
                        tirError(module, "E2102", "for range lower bound must have type int", 0, 0)
                        return blockId
                    }
                    if typeOfExpression(module, bindings, bounds.hi) != "int" {
                        tirError(module, "E2102", "for range upper bound must have type int", 0, 0)
                        return blockId
                    }
                    val loValue = lowerExpression(module, function, blockId, bindings, bounds.lo)
                    val hiValue = lowerExpression(module, function, blockId, bindings, bounds.hi)
                    // The counter carries the item's name plus a suffix, the same
                    // hidden name the builder gives it, so the two passes describe
                    // one loop alike. The item is rebound every iteration, and the
                    // user's index alongside it: over a range the 0-based position
                    // is the counter minus the lower bound, exactly as over a list.
                    val counterName = loopNode.item + "_range"
                    tirEmit(function, blockId, "bind", "unit", counterName + " " + tirValue(loValue))

                    val conditionBlock = tirCreateBlock(function)
                    val bodyBlock = tirCreateBlock(function)
                    val incrementBlock = tirCreateBlock(function)
                    val exitBlock = tirCreateBlock(function)
                    tirEmit(function, blockId, "jump", "unit", "b" + tirIntText(conditionBlock))

                    val tested = tirEmit(function, conditionBlock, "load", "int", counterName)
                    val stillGoing = tirEmit(function, conditionBlock, "<", "bool", tirValue(tested) + " " + tirValue(hiValue))
                    tirEmit(function, conditionBlock, "branch", "unit", tirValue(stillGoing) + " b" + tirIntText(bodyBlock) + " b" + tirIntText(exitBlock))

                    val bodyBindings = copyBindings(bindings)
                    val itemValue = tirEmit(function, bodyBlock, "load", "int", counterName)
                    tirEmit(function, bodyBlock, "bind", "unit", loopNode.item + " " + tirValue(itemValue))
                    bodyBindings.push(TirBinding(loopNode.item, "int"))
                    if loopNode.indexVar != "" {
                        val positionValue = tirEmit(function, bodyBlock, "load", "int", counterName)
                        val position = tirEmit(function, bodyBlock, "-", "int", tirValue(positionValue) + " " + tirValue(loValue))
                        tirEmit(function, bodyBlock, "bind", "unit", loopNode.indexVar + " " + tirValue(position))
                        bodyBindings.push(TirBinding(loopNode.indexVar, "int"))
                    }
                    val bodyEnd = lowerStatement(module, function, bodyBlock, bodyBindings, loopNode.body, exitBlock, incrementBlock)
                    if bodyEnd >= 0 {
                        tirEmit(function, bodyEnd, "jump", "unit", "b" + tirIntText(incrementBlock))
                    }

                    // The increment is the block a `continue` reaches: jumping to
                    // the condition with the counter unchanged repeats the same
                    // item forever.
                    val iterated = tirEmit(function, incrementBlock, "load", "int", counterName)
                    val step = tirEmit(function, incrementBlock, "const", "int", "1")
                    val nextValue = tirEmit(function, incrementBlock, "+", "int", tirValue(iterated) + " " + tirValue(step))
                    tirEmit(function, incrementBlock, "bind", "unit", counterName + " " + tirValue(nextValue))
                    tirEmit(function, incrementBlock, "jump", "unit", "b" + tirIntText(conditionBlock))
                    return exitBlock
                }
                _ => {
                    tirError(module, "E3001", "for over a non-range needs an element type this pass does not keep", 0, 0)
                    return blockId
                }
            }
        }
        // A statement with no instruction to emit lowers to nothing, so it is not
        // a give-up. It reached the expression reader through the fallback below
        // and came back as "expression cannot be lowered to TIR: Empty" -- 5,045
        // times over the corpus, the largest class the census reported. The class
        // naming is what showed it: a statement with no instruction to emit is not
        // an expression the front end cannot type.
        ASTNode.Empty => { return blockId }
        // Out of a loop the construct is not a control transfer the pass can
        // name: it jumps to nothing. It stays a give-up, with the reason. A named
        // `break outer` wants a block other than the innermost loop's, and the
        // targets only carry the innermost.
        ASTNode.Break(loopBreak) => {
            if breakTarget >= 0 && loopBreak.label == "" {
                tirEmit(function, blockId, "jump", "unit", "b" + tirIntText(breakTarget))
                return -1
            }
            tirError(module, "E3001", "break with no enclosing loop to leave", 0, 0)
            return blockId
        }
        ASTNode.Continue(loopContinue) => {
            if continueTarget >= 0 && loopContinue.label == "" {
                tirEmit(function, blockId, "jump", "unit", "b" + tirIntText(continueTarget))
                return -1
            }
            tirError(module, "E3001", "continue with no enclosing loop to iterate", 0, 0)
            return blockId
        }
        _ => {
            lowerExpression(module, function, blockId, bindings, node)
            return blockId
        }
    }
}

fn lowerFunction(module: TirModule, declaration: FunctionDeclNode) {
    val returnType = declaration.returnType
    val function = tirAddFunction(module, declaration.name, returnType)

    var paramIndex = 0
    while paramIndex < declaration.params.len() {
        val name: string = declaration.params.get(paramIndex)
        val typeName: string = declaration.paramTypes.get(paramIndex)
        tirAddParameter(function, name, typeName)
        paramIndex = paramIndex + 1
    }

    val entry = tirCreateBlock(function)
    val bindings = []
    paramIndex = 0
    while paramIndex < declaration.params.len() {
        val name: string = declaration.params.get(paramIndex)
        val typeName: string = declaration.paramTypes.get(paramIndex)
        bindings.push(TirBinding(name, typeName))
        paramIndex = paramIndex + 1
    }
    lowerStatement(module, function, entry, bindings, declaration.body, -1, -1)
}

fn lowerProgramToTir(moduleName: string, root: ASTNode) -> TirModule {
    val module = initTirModule(moduleName)
    match root {
        ASTNode.Program(program) => {
            var i = 0
            while i < program.decls.len() {
                val declaration: ASTNode = program.decls.get(i)
                match declaration {
                    ASTNode.FunctionDecl(function) => lowerFunction(module, function)
                    ASTNode.TypeDecl(typeDecl) => {}
                    ASTNode.ModelDecl(modelDecl) => {}
                    ASTNode.ConstDecl(constDecl) => {}
                    ASTNode.VarDecl(varDecl) => {}
                    ASTNode.ImportStmt(imp) => {}
                    ASTNode.UseStmt(useStmt) => {}
                    ASTNode.RouteDecl(rt) => {}
                    // A directive that declares data, not code, has no
                    // instruction to emit -- the reason a file-scope `const` or
                    // `var` already lowers to nothing. `config` carries a literal
                    // value and `migrations` a SQL string; the builder and the
                    // runtime read both, and neither is a function body. A
                    // `schedule` is not on this list: its handler is code, and
                    // skipping it would hide a body from the pass that claims to
                    // describe the file.
                    ASTNode.ConfigDecl(configDecl) => {}
                    ASTNode.MigrationDecl(migrationDecl) => {}
                    ASTNode.TraitDecl(traitDecl) => {}
                    ASTNode.ImplDecl(implDecl) => {}
                    ASTNode.Empty => {}
                    _ => tirError(module, "E3000", "top-level declaration cannot be lowered to TIR: " + astNodeKind(declaration), 0, 0)
                }
                i = i + 1
            }
        }
        _ => tirError(module, "E3002", "frontend expected a program root", 0, 0)
    }
    return module
}
