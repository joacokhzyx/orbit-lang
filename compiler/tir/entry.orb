// Public frontend entry point.
//
// Backends receive the text returned by `compileFrontendSource`; they never
// call parser or semantic helpers directly.

import "../front/parser.orb"
import "./lower.orb"
import "./format.orb"

fn appendParserDiagnostics(module: TirModule, diagnostics: list < ParserDiagnostic >) {
    var i = 0
    while i < diagnostics.len() {
        val diagnostic: ParserDiagnostic = diagnostics.get(i)
        tirError(module, "E1000", diagnostic.message, diagnostic.line, diagnostic.column)
        i = i + 1
    }
}

fn compileFrontendModule(moduleName: string, source: string) -> TirModule {
    val parser = initParser(source)
    val root = parseProgram(parser)
    val module = lowerProgramToTir(moduleName, root)
    appendParserDiagnostics(module, parser.diagnostics)
    return module
}

fn compileFrontendSource(moduleName: string, source: string) -> string {
    val module = compileFrontendModule(moduleName, source)
    return tirCanonical(module)
}

// Why compileFrontendSource answered "". An error the user has to fix and a
// type this pass could not infer are different answers, and `orbit frontend`
// reported neither: it said the diagnostics contained errors and printed none.
fn frontendRefusal(moduleName: string, source: string) -> string {
    val module = compileFrontendModule(moduleName, source)
    val firstError = tirFirstError(module)
    if firstError != "" {
        return "the frontend reported an error: " + firstError
    }
    val firstUnknown = tirFirstUnknown(module)
    if firstUnknown != "" {
        return "no TIR emitted: " + firstUnknown + "; an unknown type is never part of the TIR contract"
    }
    return "the frontend produced no TIR and named no reason"
}
