            val v2 = generateValue(instr.operand2)
            if isStringOperand(backend, instr.operand1) && isStringOperand(backend, instr.operand2) {
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = strcmp(" + v1 + ", " + v2 + ") != 0;\n")
                return
            }
