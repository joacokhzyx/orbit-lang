            var expCount = 0
            if calleeName == "orbit_string_at" || calleeName == "orbit_string_indexOf" || calleeName == "strcmp" {
                expCount = 2
            } else if calleeName == "orbit_string_slice" {
                expCount = 3
            } else if calleeName == "orbit_string_concat" {
                expCount = 2
            } else if calleeName == "tirError" || calleeName == "tirEmit" || calleeName == "lowerStatement" || calleeName == "lowerExpression" {
