            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = -" + generateValue(instr.operand1) + ";\n")
            return
        }
        IROpcode.begin_block => {
            orbit_cbuf_append_selfhost(cb, "    {\n")
            return
        }
        IROpcode.end_block => {
            orbit_cbuf_append_selfhost(cb, "    }\n")
            return
        }
        IROpcode.label => {
            val lval = generateValue(instr.operand1)
            if listContainsStr(backend.refLabels, lval) == false { return }
            orbit_cbuf_append_selfhost(cb, "label_" + lval + ":;\n")
            return
        }
        IROpcode.jump => {
            orbit_cbuf_append_selfhost(cb, "    goto label_" + generateValue(instr.operand1) + ";\n")
            return
        }
        IROpcode.jump_if_false => {
            orbit_cbuf_append_selfhost(cb, "    if (!(" + generateValue(instr.operand1) + ")) goto label_" + generateValue(instr.operand2) + ";\n")
            return
        }
        IROpcode.copy => {
            val valStr = generateValue(instr.operand1)
            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, valStr))
            return
        }
        IROpcode.arg => {
            if instr.dest != -1 {
                var pIdx = 0
                match instr.operand1 {
                    IRValue.Int(pi) => { pIdx = pi.value }
                    _ => {}
                }
                if pIdx < backend.currentFunction.params.len() {
                    val pName = backend.currentFunction.params.get(pIdx)
                    orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, pName))
                    return
                }
                orbit_cbuf_append_selfhost(cb, "")
                return
            }
            backend.callArgs.push(generateValue(instr.operand1))
            orbit_cbuf_append_selfhost(cb, "")
            return
        }
        IROpcode.call => {
            var calleeName = ""
            match instr.operand1 {
                IRValue.String(s) => { calleeName = s.value }
                IRValue.Sym(s) => { calleeName = s.value }
                _ => {}
            }
            if calleeName == "slice" {
                calleeName = "orbit_string_slice"
            }
            if calleeName == "at" {
                calleeName = "orbit_string_at"
            }
            if calleeName == "find" || calleeName == "indexOf" || calleeName == "orbit_string_find" {
                calleeName = "orbit_string_indexOf"
            }
            var destNeeded = instr.dest != -1
            if destNeeded && (functionReturnsVoid(backend, calleeName) || calleeName == "orbit_list_set") {
                destNeeded = false
            }
            if calleeName == "print" {
                if backend.callArgs.len() == 1 {
                    val argStr = backend.callArgs.get(0)
                    backend.callArgs.pop()
                    if isStringArg(backend, argStr) {
                        orbit_cbuf_append_selfhost(cb, "    print(\"%s\", " + argStr + ");\n")
                        return
                    }
                    // A float goes through the runtime's own formatter rather
                    // than through %lld, which truncated 1.5 to 1. Without
                    // this a list element read back as a float is correct and
