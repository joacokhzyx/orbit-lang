                orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "((orbit_float)(" + generateValue(instr.operand1) + ") < (orbit_float)(" + generateValue(instr.operand2) + "))"))
                return
            }
            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "((intptr_t)(" + generateValue(instr.operand1) + ") < (intptr_t)(" + generateValue(instr.operand2) + "))"))
            return
        }
        IROpcode.le => {
