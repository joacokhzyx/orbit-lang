import "./ir.orb"

model CBackend {
    module: IRModule
    output: string
    currentFunction: IRFunction
    callArgs: list
}

fn initCBackend(module: IRModule) -> CBackend {
    return CBackend(module, "", initIRFunction(""), [])
}

fn generateC(backend: CBackend) -> string {
    backend.output = backend.output + "#include \"runtime.h\"\n\n"
    var i = 0
    while i < backend.module.functions.len() {
        val func = backend.module.functions.get(i)
        generateFunction(backend, func)
        i = i + 1
    }
    return backend.output
}

fn mapTypeToC(orbitType: string) -> string {
    if orbitType == "int" { return "orbit_int" }
    if orbitType == "float" { return "orbit_float" }
    if orbitType == "string" { return "orbit_string" }
    if orbitType == "bool" { return "orbit_bool" }
    if orbitType == "void" { return "void" }
    if orbitType == "list" || orbitType == "List" { return "OrbitList*" }
    if orbitType == "map" || orbitType == "Map" { return "OrbitMap*" }
    return "void*"
}

fn orbit_itoa(n: int) -> string {
    if n == 0 { return "0" }
    val digits = "0123456789"
    var str = ""
    var temp = n
    while temp > 0 {
        val rem = temp - ((temp / 10) * 10)
        str = digits.slice(rem, rem + 1) + str
        temp = temp / 10
    }
    return str
}

fn generateFunction(backend: CBackend, func: IRFunction) {
    backend.currentFunction = func
    backend.callArgs = []
    val retType = mapTypeToC(func.returnType)
    backend.output = backend.output + retType + " " + func.name + "("
    var i = 0
    if func.params.len() == 0 {
        backend.output = backend.output + "void"
    } else {
        while i < func.params.len() {
            val pName = func.params.get(i)
            val pType = mapTypeToC(func.paramTypes.get(i))
            backend.output = backend.output + pType + " " + pName
            if i < func.params.len() - 1 {
                backend.output = backend.output + ", "
            }
            i = i + 1
        }
    }
    backend.output = backend.output + ") {\n"
        // Declare registers
        i = 0
        while i < func.registerCount {
            val rType = mapTypeToC(func.registerTypes.get(i))
            if rType != "void" {
                backend.output = backend.output + "    " + rType + " r_" + orbit_itoa(i) + ";\n"
            }
            i = i + 1
        }
        // Generate instructions
        i = 0
        while i < func.instructions.len() {
            val instr = func.instructions.get(i)
            generateInstruction(backend, instr)
            i = i + 1
        }
        if func.returnType != "void" {
            if retType == "orbit_int" {
                backend.output = backend.output + "    return 0;\n"
            } else if retType == "orbit_bool" {
                backend.output = backend.output + "    return false;\n"
            } else {
                backend.output = backend.output + "    return NULL;\n"
            }
        }
        backend.output = backend.output + "}\n\n"
}

fn generateValue(backend: CBackend, value: IRValue) -> string {
    match value {
        IRValue.Int(v) => { return orbit_itoa(v.value) }
        IRValue.Float(v) => { return orbit_itoa(v.value) }
        IRValue.String(v) => { return "\"" + v.value + "\"" }
        IRValue.Sym(v) => { return v.value }
        IRValue.Bool(v) => {
            if v.value { return "true" }
            return "false"
        }
        IRValue.Register(v) => { return "r_" + orbit_itoa(v.value) }
        IRValue.Label(v) => { return "label_" + orbit_itoa(v.value) }
        _ => { return "" }
    }
}

fn generateInstruction(backend: CBackend, instr: IRInstruction) {
    match instr.opcode {
        IROpcode.nop => {
            backend.output = backend.output + "    /* nop */\n"
        }
        IROpcode.load_const => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + ";\n"
        }
        IROpcode.load_var => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + ";\n"
        }
        IROpcode.store_var => {
            backend.output = backend.output + "    " + generateValue(backend, instr.operand1) + " = " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.decl_var => {
            backend.output = backend.output + "    void* " + generateValue(backend, instr.operand1) + " = " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.add => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + " + " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.sub => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + " - " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.mul => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + " * " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.div => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + " / " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.mod => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + " % " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.eq => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " == " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.ne => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " != " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.lt => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " < " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.le => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " <= " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.gt => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " > " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.ge => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " >= " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.and_op => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " && " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.or_op => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " || " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.not_op => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = !" + generateValue(backend, instr.operand1) + ";\n"
        }
        IROpcode.neg => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = -" + generateValue(backend, instr.operand1) + ";\n"
        }
        IROpcode.begin_block => {
            backend.output = backend.output + "    {\n"
            }
            IROpcode.end_block => {
                backend.output = backend.output + "    }\n"
        }
        IROpcode.label => {
            backend.output = backend.output + "label_" + generateValue(backend, instr.operand1) + ":;\n"
        }
        IROpcode.jump => {
            backend.output = backend.output + "    goto label_" + generateValue(backend, instr.operand1) + ";\n"
        }
        IROpcode.jump_if_false => {
            backend.output = backend.output + "    if (!" + generateValue(backend, instr.operand1) + ") goto label_" + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.copy => {
            val valStr = generateValue(backend, instr.operand1)
            val rType = mapTypeToC(backend.currentFunction.registerTypes.get(instr.dest))
            if (rType == "void*" && (valStr == "true" || valStr == "false")) || (valStr.indexOf("TAG_") != -1 && rType.indexOf("*") != -1) {
                backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = (void*)(uintptr_t)(" + valStr + ");\n"
            } else {
                backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + valStr + ";\n"
            }
        }
        IROpcode.arg => {
            backend.callArgs.push(generateValue(backend, instr.operand1))
        }
        IROpcode.call => {
            if instr.dest != -1 {
                backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = "
            } else {
                backend.output = backend.output + "    "
            }
            backend.output = backend.output + generateValue(backend, instr.operand1) + "("
            var i = 0
            while i < backend.callArgs.len() {
                backend.output = backend.output + backend.callArgs.get(i)
                if i < backend.callArgs.len() - 1 {
                    backend.output = backend.output + ", "
                }
                i = i + 1
            }
            backend.output = backend.output + ");\n"
            backend.callArgs = []
        }
        IROpcode.ret => {
            match instr.operand1 {
                IRValue.None => {
                    backend.output = backend.output + "    return;\n"
                }
                IRValue.Register(v) => {
                    val rType = mapTypeToC(backend.currentFunction.registerTypes.get(v.value))
                    val retType = mapTypeToC(backend.currentFunction.returnType)
                    if retType != "orbit_int" && retType != "orbit_float" && retType != "orbit_bool" && retType != "void" {
                        if rType == "orbit_int" || rType == "orbit_bool" || (rType != "" && rType != "void" && rType.indexOf("*") == -1 && rType != "orbit_float") {
                            backend.output = backend.output + "    return NULL;\n"
                        } else {
                            backend.output = backend.output + "    return r_" + orbit_itoa(v.value) + ";\n"
                        }
                    } else {
                        backend.output = backend.output + "    return r_" + orbit_itoa(v.value) + ";\n"
                    }
                }
                _ => {
                    val valStr = generateValue(backend, instr.operand1)
                    val retType = mapTypeToC(backend.currentFunction.returnType)
                    if retType != "orbit_int" && retType != "orbit_float" && retType != "orbit_bool" && retType != "void" {
                        if valStr.indexOf("TAG_") != -1 || valStr == "true" || valStr == "false" {
                            backend.output = backend.output + "    return NULL;\n"
                        } else {
                            backend.output = backend.output + "    return " + valStr + ";\n"
                        }
                    } else {
                        backend.output = backend.output + "    return " + valStr + ";\n"
                    }
                }
            }
        }
        IROpcode.alloc => {
            var sizeVal = generateValue(backend, instr.operand1)
            if sizeVal == "" {
                sizeVal = "sizeof(void*)"
            }
            if instr.dest != -1 {
                backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_arena_alloc(arena, " + sizeVal + ");\n"
            } else {
                backend.output = backend.output + "    orbit_arena_alloc(arena, " + sizeVal + ");\n"
            }
        }
        IROpcode.free => {
            backend.output = backend.output + "    /* free - arena managed */\n"
        }
        IROpcode.load_field => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + "->" + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.store_field => {
            backend.output = backend.output + "    " + generateValue(backend, instr.operand1) + "->" + generateValue(backend, instr.operand2) + " = " + generateValue(backend, instr.operand3) + ";\n"
        }
        IROpcode.list_create => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_list_create(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.list_push => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_list_push(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.list_get => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_list_get(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.list_set => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_list_set(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ", " + generateValue(backend, instr.operand3) + ");\n"
        }
        IROpcode.list_len => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_list_len(" + generateValue(backend, instr.operand1) + ");\n"
        }
        IROpcode.list_pop => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_list_pop(" + generateValue(backend, instr.operand1) + ");\n"
        }
        IROpcode.map_create => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_map_create(" + generateValue(backend, instr.operand1) + ");\n"
        }
        IROpcode.map_set => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_map_set(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ", " + generateValue(backend, instr.operand3) + ");\n"
        }
        IROpcode.map_get => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_map_get(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.map_has => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_map_has(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.map_delete => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_map_delete(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.map_keys => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_map_keys(" + generateValue(backend, instr.operand1) + ");\n"
        }
        IROpcode.result_ok => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_result_ok(" + generateValue(backend, instr.operand1) + ");\n"
        }
        IROpcode.result_err => {
            match instr.operand2 {
                IRValue.None => {
                    backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_result_err(" + generateValue(backend, instr.operand1) + ");\n"
                }
                _ => {
                    backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_result_err(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ");\n"
                }
            }
        }
        IROpcode.result_unwrap => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + ".value;\n"
        }
        IROpcode.result_is_ok => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + ".ok;\n"
        }
        IROpcode.union_create => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_union_create(" + generateValue(backend, instr.operand2) + ", " + generateValue(backend, instr.operand1) + ");\n"
        }
        IROpcode.union_get_tag => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + "->tag;\n"
        }
        IROpcode.union_get_data => {
            backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + "->data;\n"
        }
        IROpcode.switch_op => {
            val exprVal = generateValue(backend, instr.operand1)
            if exprVal != "" {
                backend.output = backend.output + "    switch (" + exprVal + ") {\n"
            } else {
                backend.output = backend.output + "    /* switch_op */\n"
            }
        }
            IROpcode.type_info => {
                backend.output = backend.output + "    /* type_info */\n"
            }
            IROpcode.db_get => {
                val arg1 = generateValue(backend, instr.operand1)
                val arg2 = generateValue(backend, instr.operand2)
                var argsStr = arg1
                if arg2 != "" {
                    argsStr = argsStr + ", " + arg2
                }
                if instr.dest != -1 {
                    backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_db_get(" + argsStr + ");\n"
                } else {
                    backend.output = backend.output + "    orbit_db_get(" + argsStr + ");\n"
                }
            }
            IROpcode.db_set => {
                val arg1 = generateValue(backend, instr.operand1)
                val arg2 = generateValue(backend, instr.operand2)
                val arg3 = generateValue(backend, instr.operand3)
                var argsStr = arg1
                if arg2 != "" {
                    argsStr = argsStr + ", " + arg2
                }
                if arg3 != "" {
                    argsStr = argsStr + ", " + arg3
                }
                if instr.dest != -1 {
                    backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_db_set(" + argsStr + ");\n"
                } else {
                    backend.output = backend.output + "    orbit_db_set(" + argsStr + ");\n"
                }
            }
            IROpcode.db_all => {
                val arg1 = generateValue(backend, instr.operand1)
                if instr.dest != -1 {
                    backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_db_all(" + arg1 + ");\n"
                } else {
                    backend.output = backend.output + "    orbit_db_all(" + arg1 + ");\n"
                }
            }
            IROpcode.db_where => {
                val arg1 = generateValue(backend, instr.operand1)
                val arg2 = generateValue(backend, instr.operand2)
                var argsStr = arg1
                if arg2 != "" {
                    argsStr = argsStr + ", " + arg2
                }
                if instr.dest != -1 {
                    backend.output = backend.output + "    r_" + orbit_itoa(instr.dest) + " = orbit_db_where(" + argsStr + ");\n"
                } else {
                    backend.output = backend.output + "    orbit_db_where(" + argsStr + ");\n"
                }
            }
            IROpcode.http_response => {
                backend.output = backend.output + "    ORBIT_API_RESPONSE(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ", " + generateValue(backend, instr.operand3) + ");\n"
            }
            _ => {
                backend.output = backend.output + "    /* Unknown opcode */\n"
            }
        }
    }

