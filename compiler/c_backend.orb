                    } else if argIdx == 2 {
                        callExpr = callExpr + "(orbit_string)(" + aStr + ")"
                    } else {
                        callExpr = callExpr + "(void*)(uintptr_t)(" + aStr + ")"
                    }
                } else if calleeName == "generateRegAssign" {
                    if argIdx == 1 {
                        callExpr = callExpr + "(orbit_int)(uintptr_t)(" + aStr + ")"
                    } else if argIdx == 2 {
                        callExpr = callExpr + "(orbit_string)(" + aStr + ")"
                    } else {
                        callExpr = callExpr + "(void*)(uintptr_t)(" + aStr + ")"
                    }
                } else if calleeName == "tirError" {
                    if argIdx == 1 || argIdx == 2 {
                        callExpr = callExpr + "(orbit_string)(" + aStr + ")"
