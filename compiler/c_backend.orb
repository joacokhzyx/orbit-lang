                return "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_db_where(" + argsStr + ");\n"
            } else {
                return "    orbit_db_where(" + argsStr + ");\n"
            }
        }
        IROpcode.http_response => {
            return "    ORBIT_API_RESPONSE(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ", " + generateValue(backend, instr.operand3) + ");\n"
        }
        _ => {
            return "    /* Unknown opcode */\n"
        }
    }
}

fn isStringVar(backend: CBackend, varName: string) -> bool {
    var vi = 0
    while vi < backend.strVars.len() {
        if backend.strVars.get(vi) == varName {
            return true
        }
        vi = vi + 1
    }
    return false
}

fn isStringReg(backend: CBackend, regId: int) -> bool {
    if backend != NULL && backend.currentFunction != NULL {
        val f: IRFunction = backend.currentFunction
        if regId >= 0 && regId < f.registerTypes.len() {
            if f.registerTypes.get(regId) == "string" {
                return true
            }
        }
    }
    var ri = 0
    while ri < backend.strRegs.len() {
        if backend.strRegs.get(ri) == regId {
            return true
        }
        ri = ri + 1
    }
    return false
}

fn isStringArg(backend: CBackend, argStr: string) -> bool {
    if argStr.len() > 0 && argStr.at(0) == 34 { return true }
    if argStr.len() > 2 && argStr.slice(0, 2) == "r_" {
        var n = 0
        var i = 2
        while i < argStr.len() {
            val c = argStr.at(i)
            n = n * 10 + (c - 48)
            i = i + 1
        }
        return isStringReg(backend, n)
    }
    return isStringVar(backend, argStr)
}

fn isStringOperand(backend: CBackend, operand: IRValue) -> bool {
    if operand == NULL { return false }
    match operand {
        IRValue.String(s) => { return true }
        IRValue.Register(v) => {
            if backend != NULL && backend.currentFunction != NULL {
                val f: IRFunction = backend.currentFunction
                if v.value >= 0 && v.value < f.registerTypes.len() {
                    if f.registerTypes.get(v.value) == "string" {
                        return true
                    }
                }
            }
            var ri = 0
            while ri < backend.strRegs.len() {
                if backend.strRegs.get(ri) == v.value {
                    return true
                }
                ri = ri + 1
            }
            return false
        }
        IRValue.Sym(s) => {
            return isStringVar(backend, s.value)
        }
        _ => { return false }
    }
}

fn variableDefType(backend: CBackend, func: IRFunction, vn: string) -> string {
    var di = 0
    while di < func.instructions.len() {
        val inst: IRInstruction = func.instructions.get(di)
        if inst != NULL {
            var cname = ""
            match inst.operand1 {
                IRValue.Sym(s) => { cname = s.value }
                IRValue.String(s) => { cname = s.value }
                _ => {}
            }
            if cname == vn {
                match inst.opcode {
                    IROpcode.decl_var => { return operandDefType(backend, func, inst.operand2) }
                    IROpcode.store_var => { return operandDefType(backend, func, inst.operand2) }
                    _ => {}
                }
            }
        }
        di = di + 1
    }
    return "unknown"
}

fn storeCastFor(backend: CBackend, vn: string) -> string {
    val vType = variableDefType(backend, backend.currentFunction, vn)
    if vType == "float" { return "(orbit_float)" }
    if vType == "bool" { return "(orbit_int)(uintptr_t)" }
    if vType == "string" { return "(orbit_string)" }
    return "(uintptr_t)"
}

fn operandDefType(backend: CBackend, func: IRFunction, op2: IRValue) -> string {
    match op2 {
        IRValue.Int(v) => { return "int" }
        IRValue.Float(v) => { return "float" }
        IRValue.Bool(v) => { return "bool" }
        IRValue.String(s) => {
            if s.value.indexOf("TAG_") != -1 { return "int" }
            return "string"
        }
        IRValue.Sym(s) => {
            if s.value == "true" || s.value == "false" { return "bool" }
            if s.value.indexOf("TAG_") != -1 { return "int" }
            return "unknown"
        }
        IRValue.Register(reg) => {
            if reg.value >= 0 && reg.value < func.registerTypes.len() {
                val t = func.registerTypes.get(reg.value)
                if t != "unknown" && t != "" && t != "void" {
                    return t
                }
            }
            return "unknown"
        }
        _ => { return "unknown" }
    }
}

fn registerVarDefType(backend: CBackend, func: IRFunction, regId: int) -> string {
    var di = 0
    while di < func.instructions.len() {
        val inst: IRInstruction = func.instructions.get(di)
        if inst != NULL && inst.dest == regId {
            match inst.opcode {
                IROpcode.load_var => {
                    var vn = ""
                    match inst.operand1 {
                        IRValue.Sym(s) => { vn = s.value }
                        IRValue.String(s) => { vn = s.value }
                        _ => {}
                    }
                    if vn != "" {
                        val t = variableDefType(backend, func, vn)
                        if t != "unknown" { return t }
                        if isStringVar(backend, vn) { return "string" }
                    }
                }
                _ => {}
            }
            return "unknown"
        }
        di = di + 1
    }
    return "unknown"
}

fn stringifyConcatOperand(backend: CBackend, operand: IRValue) -> string {
    val raw = generateValue(backend, operand)
    if isStringOperand(backend, operand) {
        return "(orbit_string)(" + raw + ")"
    }
    var t = "int"
    match operand {
        IRValue.Register(reg) => {
            if backend != NULL && backend.currentFunction != NULL {
                val f: IRFunction = backend.currentFunction
                if reg.value >= 0 && reg.value < f.registerTypes.len() {
                    t = f.registerTypes.get(reg.value)
                }
            }
        }
        IRValue.Bool(v) => { t = "bool" }
        IRValue.Float(v) => { t = "float" }
        IRValue.Int(v) => { t = "int" }
        IRValue.String(s) => {
            if s.value.indexOf("TAG_") != -1 { t = "int" }
        }
        IRValue.Sym(s) => {
            if s.value == "true" || s.value == "false" { t = "bool" }
            else if s.value.indexOf("TAG_") != -1 { t = "int" }
        }
        _ => {}
    }
    if t == "bool" {
        return "orbit_bool_to_string(arena, (orbit_bool)(uintptr_t)(" + raw + "))"
    }
    if t == "float" {
        return "orbit_float_to_string(arena, (orbit_float)(" + raw + "))"
    }
    if t == "string" {
        return "(orbit_string)(" + raw + ")"
    }
    return "orbit_int_to_string_selfhost((orbit_int)(uintptr_t)(" + raw + "))"
}

fn functionReturnsVoid(backend: CBackend, name: string) -> bool {
    if name == "orbit_list_set" { return true }
    var fi = 0
    while fi < backend.module.functions.len() {
        val f: IRFunction = backend.module.functions.get(fi)
        if f.name == name && f.returnType == "void" {
            return true
        }
        fi = fi + 1
    }
    if name == "orbit_main" || name == "main_main" {
        var fi2 = 0
        while fi2 < backend.module.functions.len() {
            val f2: IRFunction = backend.module.functions.get(fi2)
            if f2.name == "main" && f2.returnType == "void" {
                return true
            }
            fi2 = fi2 + 1
        }
    }
    return false
}

fn isStringReturningFunction(name: string) -> bool {
    if name == "slice" { return true }
    if name == "generateValue" { return true }
    if name == "escapeString" { return true }
    if name == "unescapeString" { return true }
    if name == "stripQuotes" { return true }
    if name == "getDir" { return true }
    if name == "resolveFilePath" { return true }
    if name == "normalizePath" { return true }
    if name == "fieldRefOwner" { return true }
    if name == "fieldRefName" { return true }
    if name == "extractMemberAccessName" { return true }
    if name == "getEnumNameFromTag" { return true }
    if name == "frontendOutputPath" { return true }
    if name == "mapTypeToC" { return true }
    if name == "tokTypeToString" { return true }
    if name == "orbit_string_slice" { return true }
    if name == "orbit_string_concat" { return true }
    if name == "orbit_string_split" { return true }
    if name == "orbit_string_replace" { return true }
    if name == "orbit_int_to_string_selfhost" { return true }
    if name == "orbit_os_argv_selfhost" { return true }
    if name == "orbit_os_env_selfhost" { return true }
    if name == "orbit_file_read_selfhost" { return true }
    if name == "orbit_int_to_string" { return true }
    if name == "orbit_float_to_string" { return true }
    if name == "orbit_bool_to_string" { return true }
    return false
}

fn findFieldOwner(backend: CBackend, fieldName: string) -> string {
    var i = backend.fieldNames.len()
    while i > 0 {
        i = i - 1
        if backend.fieldNames.get(i) == fieldName {
            return backend.fieldOwners.get(i)
        }
    }
    return ""
}

fn fieldRefDotPos(fieldRef: string) -> int {
    var i = 0
    while i < orbit_string_len(fieldRef) {
        if fieldRef.at(i) == 46 {
            return i
        }
        i = i + 1
    }
    return -1
}

fn fieldRefOwner(fieldRef: string) -> string {
    val dot = fieldRefDotPos(fieldRef)
    if dot <= 0 {
        return ""
    }
    return orbit_string_slice(fieldRef, 0, dot)
}

fn fieldRefName(fieldRef: string) -> string {
    val dot = fieldRefDotPos(fieldRef)
    if dot <= 0 {
        return fieldRef
    }
    return orbit_string_slice(fieldRef, dot + 1, orbit_string_len(fieldRef))
}

fn moduleHasFunction(backend: CBackend, name: string) -> bool {
    var i = 0
    while i < backend.module.functions.len() {
        val f: IRFunction = backend.module.functions.get(i)
        if f.name == name {
            return true
        }
        i = i + 1
    }
    return false
}

fn isStringFieldName(backend: CBackend, fieldName: string) -> bool {
    if fieldName == "source" || fieldName == "message" || fieldName == "name" || fieldName == "value" || fieldName == "text" || fieldName == "inputPath" || fieldName == "outputPath" || fieldName == "path" {
        return true
    }
    var allString = true
    var found = false
    var mi = 0
    while mi < backend.module.models.len() {
        val m: IRModelDecl = backend.module.models.get(mi)
        var fi = 0
        while fi < m.fields.len() {
            val f: IRModelField = m.fields.get(fi)
            if f.name == fieldName {
                found = true
                if f.typeName != "string" {
                    allString = false
                }
            }
            fi = fi + 1
        }
        mi = mi + 1
    }
    if found == false { return false }
    return allString
}

fn isIntFieldName(fname: string) -> bool {
    if fname == "pos" || fname == "line" || fname == "col" || fname == "column" || fname == "index" || fname == "len" || fname == "length" || fname == "id" || fname == "tag" || fname == "count" || fname == "start" || fname == "end" || fname == "isMutable" || fname == "isAsync" || fname == "isPrivate" || fname == "isExtern" || fname == "isNullable" || fname == "isSumType" || fname == "isPointer" || fname == "isPointerReturn" || fname == "instr_count" || fname == "dest" || fname == "nextBlockId" || fname == "nextValueId" || fname == "registerCount" || fname == "labelCounter" || fname == "currentScope" || fname == "parentId" {
        return true
    }
    return false
}

