fn findFieldOwner(backend: CBackend, fieldName: string) -> string {
    var i = backend.fieldNames.len()
    while i > 0 {
        i = i - 1
        if backend.fieldNames.get(i) == fieldName {
            return backend.fieldOwners.get(i)
        }
    }
    return ""
}

fn fieldRefDotPos(fieldRef: string) -> int {
    var i = 0
    while i < orbit_string_len(fieldRef) {
        if fieldRef.at(i) == 46 {
            return i
        }
        i = i + 1
    }
    return - 1
}

fn fieldRefOwner(fieldRef: string) -> string {
    val dot = fieldRefDotPos(fieldRef)
    if dot <= 0 {
        return ""
    }
    return sanitizeIdentifier(orbit_string_slice(fieldRef, 0, dot))
}

fn fieldRefName(fieldRef: string) -> string {
    val dot = fieldRefDotPos(fieldRef)
    if dot <= 0 {
        return sanitizeIdentifier(fieldRef)
    }
    return sanitizeIdentifier(orbit_string_slice(fieldRef, dot + 1, orbit_string_len(fieldRef)))
}

fn moduleHasFunction(backend: CBackend, name: string) -> bool {
    var i = 0
    while i < backend.module.functions.len() {
        val f: IRFunction = backend.module.functions.get(i)
        if f.name == name {
            return true
        }
        i = i + 1
    }
    return false
}

fn isDbBuiltin(name: string) -> bool {
    if name == "orbit_db_query_all" || name == "orbit_db_query_where" || name == "orbit_db_query_where_p" || name == "orbit_db_query_get" || name == "orbit_db_insert" || name == "orbit_db_delete" {
        return true
    }
    return false
}

fn isAuthBuiltin(name: string) -> bool {
    if name == "orbit_auth_bearer_token" || name == "orbit_auth_current_role" || name == "orbit_auth_has_role" { return true }
    return false
}

fn moduleUsesAuth(module: IRModule) -> bool {
    var fi = 0
    while fi < module.functions.len() {
        val f: IRFunction = module.functions.get(fi)
        var ii = 0
        while ii < f.instructions.len() {
            val inst: IRInstruction = f.instructions.get(ii)
            match inst.opcode {
                IROpcode.call => {
                    var cn = ""
                    match inst.operand1 {
                        IRValue.String(s) => { cn = s.value }
                        IRValue.Sym(s) => { cn = s.value }
                        _ => {}
                    }
                    if isAuthBuiltin(cn) { return true }
                }
                _ => {}
            }
            ii = ii + 1
        }
        fi = fi + 1
    }
    return false
}

fn moduleUsesDatabase(module: IRModule) -> bool {
    var fi = 0
    while fi < module.functions.len() {
        val f: IRFunction = module.functions.get(fi)
        var ii = 0
        while ii < f.instructions.len() {
            val inst: IRInstruction = f.instructions.get(ii)
            match inst.opcode {
                IROpcode.call => {
                    var cn = ""
                    match inst.operand1 {
                        IRValue.String(s) => { cn = s.value }
                        IRValue.Sym(s) => { cn = s.value }
                        _ => {}
                    }
                    // Auth needs the sessions database, so it implies DB linkage.
                    if isDbBuiltin(cn) || isAuthBuiltin(cn) { return true }
                }
                _ => {}
            }
            ii = ii + 1
        }
        fi = fi + 1
    }
    return false
}

fn declaredScalarField(backend: CBackend, fieldName: string) -> bool {
    var found = false
    var allScalar = true
    var mi = 0
    while mi < backend.module.models.len() {
        val m: IRModelDecl = backend.module.models.get(mi)
        var fi = 0
        while fi < m.fields.len() {
            val f: IRModelField = m.fields.get(fi)
            if f.name == fieldName {
                found = true
                if f.typeName != "int" && f.typeName != "bool" && f.typeName != "float" {
                    allScalar = false
                }
            }
            fi = fi + 1
        }
        mi = mi + 1
    }
    return found && allScalar
}

fn isStringFieldName(backend: CBackend, fieldName: string) -> bool {
    var allString = true
    var found = false
    var mi = 0
    while mi < backend.module.models.len() {
        val m: IRModelDecl = backend.module.models.get(mi)
        var fi = 0
        while fi < m.fields.len() {
            val f: IRModelField = m.fields.get(fi)
            if f.name == fieldName {
                found = true
                if f.typeName != "string" {
                    allString = false
                }
            }
            fi = fi + 1
        }
        mi = mi + 1
    }
    if found == false { return false }
    return allString
}

fn calleeEnumParamName(backend: CBackend, calleeName: string, argIdx: int) -> string {
    var pT = ""
    var pi = 0
    while pi < backend.module.functions.len() {
        val f: IRFunction = backend.module.functions.get(pi)
        if f.name == calleeName {
            var off = 0
            if functionNeedsArena(calleeName) { off = 1 }
            val idx = argIdx + off
            if idx < f.paramTypes.len() { pT = f.paramTypes.get(idx) }
            pi = backend.module.functions.len()
        }
        pi = pi + 1
    }
    if pT == "" { return "" }
    var ti = 0
    while ti < backend.module.types.len() {
        val t: IRTypeDecl = backend.module.types.get(ti)
        if t.name == pT && t.kind == "enumeration" { return pT }
        ti = ti + 1
    }
    return ""
}

fn dualPathQualifies(f: IRFunction) -> bool {
    if f == NULL { return false }
    val n = f.instructions.len()
    if n < 4 { return false }
    if n > 200 { return false }
    var qi = 0
    while qi < n {
        val inst: IRInstruction = f.instructions.get(qi)
        match inst.opcode {
            IROpcode.load_field => { return true }
            IROpcode.store_field => { return true }
            _ => {}
        }
        qi = qi + 1
    }
    return false
}
