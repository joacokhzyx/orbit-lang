                    callExpr = callExpr + "(orbit_int)(uintptr_t)(" + aStr + ")"
                } else if calleeName == "tirEscape" {
                    callExpr = callExpr + "(orbit_string)(" + aStr + ")"
                } else if isModelCtorName(backend, calleeName) {
                    val mft = modelCtorFieldType(backend, calleeName, argIdx)
                    if mft == "int" || mft == "bool" {
                        callExpr = callExpr + "(orbit_int)(uintptr_t)(" + aStr + ")"
                    } else if mft == "string" {
                        callExpr = callExpr + "(orbit_string)(" + aStr + ")"
                    } else if mft == "float" {
                        // No uintptr_t hop. The int and bool arms above carry
                        // one because an int survives it, and this one was
                        // written to match its neighbours: `(orbit_float)
                        // (uintptr_t)(2.5)` is `(orbit_float)(2)`, so a float
                        // model field silently lost its fraction at every
                        // construction. A float is a value, not a machine
                        // word; the cast the destination needs is the only one.
                        callExpr = callExpr + "(orbit_float)(" + aStr + ")"
                    } else if mft != "" {
                        callExpr = callExpr + "(" + mapTypeToC(backend, mft) + ")(" + aStr + ")"
                    } else {
                        callExpr = callExpr + aStr
                    }
                } else if calleeEnumParamName(backend, calleeName, argIdx) != "" {
                    // Declared enum parameter: standard cast-to-enum. Stock GCC
                    // hard-rejects the void* default here (int-conversion).
                    callExpr = callExpr + "(" + calleeEnumParamName(backend, calleeName, argIdx) + ")(uintptr_t)(" + aStr + ")"
                } else {
                    // Declared scalar parameter types drive the cast: routing
                    // every unknown call through void* hid int-conversion
                    // warnings (and real truncations) behind -w. Pointers,
                    // models, lists and unknown callees keep the void* form.
                    var argCast = "(void*)(uintptr_t)(" + aStr + ")"
                    if backend != NULL {
                        // A result is the one value that is neither a scalar
                        // nor a pointer, so it cannot travel through the
                        // integer slot the cast above is: (void*)(uintptr_t)
                        // of an OrbitResult is the C error "incompatible type
                        // for argument". The register type identifies those
                        // arguments even where the callee is unknown.
                        if isResultRegisterType(backend.currentFunction, argRegId(aStr)) {
                            argCast = aStr
                        }
                        var ci = 0
                        while ci < backend.module.functions.len() {
                            val cf: IRFunction = backend.module.functions.get(ci)
                            if cf.name == calleeName {
                                if argIdx >= 0 && argIdx < cf.paramTypes.len() {
                                    val pt = cf.paramTypes.get(argIdx)
                                    if pt == "int" || pt == "bool" {
                                        argCast = "(orbit_int)(uintptr_t)(" + aStr + ")"
                                    } else if pt == "string" {
                                        argCast = "(orbit_string)(" + aStr + ")"
                                    } else if pt == "float" {
                                        // A direct cast, never through
                                        // uintptr_t. The register holds a
                                        // double, and routing it through an
                                        // integer slot first is the truncation
                                        // that made 1.5 arrive as 1: the low
                                        // 32 bits of the mantissa are nothing
                                        // like the value. `(orbit_float)(x)`
                                        // reinterprets the double; the extra
                                        // hop through uintptr_t threw the
                                        // fraction away before the cast ever
                                        // ran.
                                        argCast = "(orbit_float)(" + aStr + ")"
                                    } else if pt == "result" {
                                        argCast = aStr
                                    } else if isEnumType(backend, pt) {
                                        argCast = "(orbit_int)(uintptr_t)(" + aStr + ")"
                                    }
                                }
                                break
                            }
                            ci = ci + 1
                        }
                    }
                    callExpr = callExpr + argCast
                }
                i = i + 1
                argIdx = argIdx + 1
            }
            if calleeName == "IRInstruction" {
                while argIdx < 5 {
                    if anyArg { callExpr = callExpr + ", " }
                    anyArg = true
                    callExpr = callExpr + "(void*)0"
                    argIdx = argIdx + 1
                }
            }
            callExpr = callExpr + ")"
            while backend.callArgs.len() > startIdx {
                backend.callArgs.pop()
            }
            if destNeeded {
                if isRouteRuntimeBuiltin(calleeName) {
                    orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = " + callExpr + ";\n")
                    return
                }
                orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, callExpr))
                return
            }
            orbit_cbuf_append_selfhost(cb, "    " + callExpr + ";\n")
            return
        }
        IROpcode.ret => {
            match instr.operand1 {
                IRValue.None => {
                    val rtype = backend.currentFunction.returnType
                    if rtype == "int" || rtype == "bool" {
                        orbit_cbuf_append_selfhost(cb, "    return 0;\n")
                        return
                    } else if isMainFuncName(backend.currentFunction.name) {
                        orbit_cbuf_append_selfhost(cb, "    return 0;\n")
                        return
                    } else if rtype == "float" {
                        orbit_cbuf_append_selfhost(cb, "    return 0.0;\n")
                        return
                    } else if rtype == "void" {
                        orbit_cbuf_append_selfhost(cb, "    return;\n")
                        return
                    } else if isEnumType(backend, rtype) {
                        orbit_cbuf_append_selfhost(cb, "    return (" + mapTypeToC(backend, rtype) + ")0;\n")
                        return
                    } else {
                        orbit_cbuf_append_selfhost(cb, "    return NULL;\n")
                        return
                    }
                }
                IRValue.Register(v) => {
                    val rtype = backend.currentFunction.returnType
                    if rtype == "result" || rtype == "Result" || rtype == "OrbitResult" {
                        orbit_cbuf_append_selfhost(cb, "    return r_" + orbit_int_to_string_selfhost(v.value) + ";\n")
                        return
                    } else if rtype == "int" || rtype == "bool" || rtype == "orbit_int" || rtype == "orbit_bool" || isEnumType(backend, rtype) || isMainFuncName(backend.currentFunction.name) {
                        orbit_cbuf_append_selfhost(cb, "    return (orbit_int)(uintptr_t)(r_" + orbit_int_to_string_selfhost(v.value) + ");\n")
                        return
                    } else if rtype == "string" || rtype == "orbit_string" {
                        orbit_cbuf_append_selfhost(cb, "    return (orbit_string)(r_" + orbit_int_to_string_selfhost(v.value) + ");\n")
                        return
                    } else if rtype == "float" || rtype == "orbit_float" {
                        orbit_cbuf_append_selfhost(cb, "    return (orbit_float)(r_" + orbit_int_to_string_selfhost(v.value) + ");\n")
                        return
                    } else if rtype == "void" {
                        // A void function returns nothing, and the value this
                        // register names does not exist: the call that produced
                        // it was emitted as its own statement already. Reading
                        // the register here emits C that does not compile --
                        // `return (void*)(r_0);` with r_0 undeclared -- for the
                        // five-line program `fn beta() {} fn alpha() { return
                        // beta() }`. The fallback below assumed a pointer return
                        // and nothing ever said otherwise.
                        orbit_cbuf_append_selfhost(cb, "    return;\n")
                        return
                    } else {
                        orbit_cbuf_append_selfhost(cb, "    return (void*)(r_" + orbit_int_to_string_selfhost(v.value) + ");\n")
                        return
                    }
                }
                _ => {
                    val rtype = backend.currentFunction.returnType
                    val valStr = generateValue(instr.operand1)
                    if rtype == "result" || rtype == "Result" || rtype == "OrbitResult" {
                        orbit_cbuf_append_selfhost(cb, "    return " + valStr + ";\n")
                        return
                    } else if rtype == "int" || rtype == "bool" || rtype == "orbit_int" || rtype == "orbit_bool" || isEnumType(backend, rtype) || isMainFuncName(backend.currentFunction.name) {
                        orbit_cbuf_append_selfhost(cb, "    return (orbit_int)(uintptr_t)(" + valStr + ");\n")
                        return
                    } else if rtype == "string" || rtype == "orbit_string" {
                        orbit_cbuf_append_selfhost(cb, "    return (orbit_string)(" + valStr + ");\n")
                        return
                    } else if rtype == "float" || rtype == "orbit_float" {
                        orbit_cbuf_append_selfhost(cb, "    return (orbit_float)(" + valStr + ");\n")
                        return
                    } else if rtype == "void" {
                        // Same defect as the register arm above: the call has
                        // already been emitted as a statement, so there is no
                        // value to return.
                        orbit_cbuf_append_selfhost(cb, "    return;\n")
                        return
                    } else {
                        orbit_cbuf_append_selfhost(cb, "    return (void*)(" + valStr + ");\n")
                        return
                    }
                }
            }
        }
        IROpcode.alloc => {
            var sizeVal = generateValue(instr.operand1)
            if sizeVal == "" {
                sizeVal = "sizeof(void*)"
            }
            if instr.dest != -1 {
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_arena_alloc(arena, " + sizeVal + ");\n")
                return
            } else {
                orbit_cbuf_append_selfhost(cb, "    orbit_arena_alloc(arena, " + sizeVal + ");\n")
                return
            }
        }
        IROpcode.free => {
            orbit_cbuf_append_selfhost(cb, "    /* free - arena managed */\n")
            return
        }
        IROpcode.load_field => {
            var fname = ""
            match instr.operand2 {
                IRValue.String(s) => { fname = s.value }
                IRValue.Sym(s) => { fname = s.value }
                _ => {}
            }
            var owner = fieldRefOwner(fname)
            fname = fieldRefName(fname)
            if isStringFieldName(backend, fname) && backend != NULL && instr.dest >= 0 {
                backend.strRegs.push(instr.dest)
            }
            // `.length` and `.len` on a STRING are the string length. They are
            // not on anything else: this used to be decided by the field's
            // name alone, so `entry.len` where entry is a model read the
            // model's first bytes as a C string -- `orbit_string_len` on a
            // `ConstBound*` is a length computed from whatever the pointer
            // happens to point at, which is how a list of recorded lengths
            // came to report 6 for every one of them. A name says what a
            // field is called; the receiver's type says what it means.
            //
            // The `operandDefType` half is for a receiver that carries a
            // string type without being a string *operand* -- a load of a
            // string field into a register, where the register is the one that
            // lost its type.
            if fname == "length" || fname == "len" {
                if isStringOperand(backend, instr.operand1) || operandDefType(backend.currentFunction, instr.operand1) == "string" {
                    orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "orbit_string_len((orbit_string)(" + generateValue(instr.operand1) + "))"))
                    return
                }
            }
            // An object's field is a lookup, not a struct member. This has to
            // come first: left to the model path, `o.n` emitted
            // `((OrbitModel*)o)->n`, which is a compile error at best and the
            // wrong bytes at worst, since findFieldOwner answers from a
            // module-wide name table that any model can populate.
            if operandDefType(backend.currentFunction, instr.operand1) == "object" {
                val getter = objectFieldGetter(backend.currentFunction, fname)
                // Reading a nested object has to leave the result known to be
                // an object, or `a.b.c` stops at `a.b` and the next `.` is
                // looked up on a register nothing has a type for.
                // The getter name was chosen by objectFieldGetter and the
                // destination's type was recorded by the pass that runs before
                // the declarations; here it is only the call itself.
                orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, getter + "(" + generateValue(instr.operand1) + ", \"" + fname + "\")"))
                return
            }
            if isStringOperand(backend, instr.operand1) {
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_json_field(arena, " + generateValue(instr.operand1) + ", \"" + fname + "\");\n")
                return
            }
            if owner == "" {
                owner = findFieldOwner(backend, fname)
            }
            if owner != "" {
                orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "((" + owner + "*)" + generateValue(instr.operand1) + ")->" + fname))
                return
            }
            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "((OrbitModel*)" + generateValue(instr.operand1) + ")->" + fname))
            return
        }
        IROpcode.store_field => {
            var fname2 = ""
            match instr.operand2 {
                IRValue.String(s) => { fname2 = s.value }
                IRValue.Sym(s) => { fname2 = s.value }
                _ => {}
            }
            var owner2 = fieldRefOwner(fname2)
            fname2 = fieldRefName(fname2)
            if owner2 == "" {
                owner2 = findFieldOwner(backend, fname2)
            }
            var valCast = "(void*)(uintptr_t)(" + generateValue(instr.operand3) + ")"
            if declaredScalarField(backend, fname2) {
                valCast = "(orbit_int)(uintptr_t)(" + generateValue(instr.operand3) + ")"
            }
            if backend != NULL && backend.currentFunction != NULL {
                val o3t = operandDefType(backend.currentFunction, instr.operand3)
                if o3t == "float" || o3t == "orbit_float" {
                    valCast = "(orbit_float)(" + generateValue(instr.operand3) + ")"
                }
            }
            if owner2 != "" {
                orbit_cbuf_append_selfhost(cb, "    ((" + owner2 + "*)" + generateValue(instr.operand1) + ")->" + fname2 + " = " + valCast + ";\n")
                return
            }
            orbit_cbuf_append_selfhost(cb, "    ((OrbitModel*)" + generateValue(instr.operand1) + ")->" + fname2 + " = " + valCast + ";\n")
            return
        }
        IROpcode.list_create => {
            // The element type rides along in elemKind and lands in the list's
            // header, so a read of this list knows how to decode its slots
            // even where the read itself could not be typed.
            orbit_cbuf_append_selfhost(cb, "    { OrbitResult _lr = orbit_list_create_typed(arena, sizeof(void*), " + generateValue(instr.operand2) + ", " + orbit_int_to_string_selfhost(instr.elemKind) + "); r_" + orbit_int_to_string_selfhost(instr.dest) + " = _lr.ok ? (OrbitList*)_lr.value : NULL; }\n")
            return
        }
        IROpcode.list_push => {
            // Orbit lists use pointer-sized slots. Never pass the address of a
            // 32-bit register directly: the push copies one full slot, which
            // otherwise reads past the stack variable for int/bool values.
            //
            // With a known element type the typed push is not a convenience:
            // a float cannot go into a slot as a number, because the slot is a
            // word and a double does not survive being cast to one. The typed
            // push stores the bit pattern, and it is also what records the
            // list's element type for the reads that follow.
            val stored = generateValue(instr.operand2)
            orbit_cbuf_append_selfhost(cb, "    " + listWriteCall(instr.elemKind, generateValue(instr.operand1), stored, "") + ";\n")
            return
        }
        IROpcode.list_get => {
            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, listReadCall(instr.elemKind, generateValue(instr.operand1), generateValue(instr.operand2))))
            return
        }
        IROpcode.list_set => {
            orbit_cbuf_append_selfhost(cb, "    " + listWriteCall(instr.elemKind, generateValue(instr.operand1), generateValue(instr.operand3), generateValue(instr.operand2)) + ";\n")
            return
        }
        IROpcode.list_len => {
            if isStringOperand(backend, instr.operand1) {
                orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "orbit_string_len((orbit_string)(" + generateValue(instr.operand1) + "))"))
                return
            }
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = (orbit_int)orbit_list_len((const OrbitList*)(" + generateValue(instr.operand1) + "));\n")
            return
        }
        IROpcode.list_pop => {
            // pop reads the last element and then shortens, so it is a read
            // first: shrinking before the read would read one past the end.
            // The empty case has no index to report, so it reports length 0.
            val listStr = "(const OrbitList*)(" + generateValue(instr.operand1) + ")"
            orbit_cbuf_append_selfhost(cb, "    { orbit_int _pl = (orbit_int)orbit_list_len(" + listStr + "); if (_pl <= 0) { orbit_list_index_error(__func__, 0, 0, 0, __FILE__, __LINE__); }\n")
            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, listReadCall(instr.elemKind, generateValue(instr.operand1), "((size_t)(_pl - 1))")))
            orbit_cbuf_append_selfhost(cb, "      orbit_list_pop((OrbitList*)(" + generateValue(instr.operand1) + ")); }\n")
            return
        }
        IROpcode.map_create => {
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_map_create(" + generateValue(instr.operand1) + ");\n")
            return
        }
        IROpcode.map_set => {
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_map_set(" + generateValue(instr.operand1) + ", " + generateValue(instr.operand2) + ", " + generateValue(instr.operand3) + ");\n")
            return
        }
        IROpcode.map_get => {
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_map_get(" + generateValue(instr.operand1) + ", " + generateValue(instr.operand2) + ");\n")
            return
        }
        IROpcode.map_has => {
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_map_has(" + generateValue(instr.operand1) + ", " + generateValue(instr.operand2) + ");\n")
            return
        }
        IROpcode.map_delete => {
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_map_delete(" + generateValue(instr.operand1) + ", " + generateValue(instr.operand2) + ");\n")
            return
        }
        IROpcode.map_keys => {
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_map_keys(" + generateValue(instr.operand1) + ");\n")
            return
        }
        IROpcode.result_ok => {
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_result_ok((void*)(uintptr_t)(" + generateValue(instr.operand1) + "));\n")
            return
        }
        IROpcode.result_err => {
            // Builder order is (code, msg) matching the runtime ABI; the
            // enum cast keeps -Wint-conversion quiet without hiding values.
            match instr.operand2 {
                IRValue.None => {
                    orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_result_err((OrbitErrorCode)(uintptr_t)(" + generateValue(instr.operand1) + "));\n")
                    return
                }
                _ => {
                    orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_result_err((OrbitErrorCode)(uintptr_t)(" + generateValue(instr.operand2) + "), (orbit_string)(" + generateValue(instr.operand1) + "));\n")
                    return
                }
            }
        }
        IROpcode.result_unwrap => {
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = " + generateValue(instr.operand1) + ".value;\n")
            return
        }
        IROpcode.result_unwrap_err => {
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = (" + generateValue(instr.operand1) + ").error_msg ? (" + generateValue(instr.operand1) + ").error_msg : \"\";\n")
            return
        }
        IROpcode.result_is_ok => {
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = " + generateValue(instr.operand1) + ".ok;\n")
            return
        }
        IROpcode.union_create => {
            orbit_cbuf_append_selfhost(cb, "    { struct { int tag; void* data; }* _u = (struct { int tag; void* data; }*)orbit_alloc(arena, 16); _u->tag = (int)(uintptr_t)(" + generateValue(instr.operand1) + "); _u->data = (void*)(uintptr_t)(" + generateValue(instr.operand2) + "); r_" + orbit_int_to_string_selfhost(instr.dest) + " = _u; }\n")
            return
        }
        IROpcode.union_get_tag => {
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = ((struct { int tag; void* data; }*)(" + generateValue(instr.operand1) + "))->tag;\n")
            return
        }
        IROpcode.union_get_data => {
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = ((struct { int tag; void* data; }*)(" + generateValue(instr.operand1) + "))->data;\n")
            return
        }
        IROpcode.switch_op => {
            val exprVal = generateValue(instr.operand1)
            if exprVal != "" {
                orbit_cbuf_append_selfhost(cb, "    switch (" + exprVal + ") {\n")
                return
            } else {
                orbit_cbuf_append_selfhost(cb, "    /* switch_op */\n")
                return
            }
        }
        IROpcode.type_info => {
            orbit_cbuf_append_selfhost(cb, "    /* type_info */\n")
            return
        }
        IROpcode.db_get => {
            val arg1 = generateValue(instr.operand1)
            val arg2 = generateValue(instr.operand2)
            var argsStr = arg1
            if arg2 != "" {
                argsStr = argsStr + ", " + arg2
            }
            if instr.dest != -1 {
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_db_get(" + argsStr + ");\n")
                return
            } else {
                orbit_cbuf_append_selfhost(cb, "    orbit_db_get(" + argsStr + ");\n")
                return
            }
        }
        IROpcode.db_set => {
            val arg1 = generateValue(instr.operand1)
            val arg2 = generateValue(instr.operand2)
            val arg3 = generateValue(instr.operand3)
            var argsStr = arg1
            if arg2 != "" {
                argsStr = argsStr + ", " + arg2
            }
            if arg3 != "" {
                argsStr = argsStr + ", " + arg3
            }
            if instr.dest != -1 {
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_db_set(" + argsStr + ");\n")
                return
            } else {
                orbit_cbuf_append_selfhost(cb, "    orbit_db_set(" + argsStr + ");\n")
                return
            }
        }
        IROpcode.db_all => {
            val arg1 = generateValue(instr.operand1)
            if instr.dest != -1 {
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_db_all(" + arg1 + ");\n")
                return
            } else {
                orbit_cbuf_append_selfhost(cb, "    orbit_db_all(" + arg1 + ");\n")
                return
            }
        }
        IROpcode.db_where => {
            val arg1 = generateValue(instr.operand1)
            val arg2 = generateValue(instr.operand2)
            var argsStr = arg1
            if arg2 != "" {
                argsStr = argsStr + ", " + arg2
            }
            if instr.dest != -1 {
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_db_where(" + argsStr + ");\n")
                return
            } else {
                orbit_cbuf_append_selfhost(cb, "    orbit_db_where(" + argsStr + ");\n")
                return
            }
        }
        IROpcode.http_response => {
            orbit_cbuf_append_selfhost(cb, "    ORBIT_API_RESPONSE(" + generateValue(instr.operand1) + ", " + generateValue(instr.operand2) + ", " + generateValue(instr.operand3) + ");\n")
            return
        }
        _ => {
            orbit_cbuf_append_selfhost(cb, "    /* Unknown opcode */\n")
            return
        }
    }
}

fn isStringVar(backend: CBackend, varName: string) -> bool {
    return listContainsStr(backend.strVars, varName)
}

fn isStringReg(backend: CBackend, regId: int) -> bool {
    if backend != NULL && backend.currentFunction != NULL {
        val f: IRFunction = backend.currentFunction
        if regId >= 0 && regId < f.registerTypes.len() {
            if f.registerTypes.get(regId) == "string" {
                return true
            }
        }
    }
    // Not listContainsStr: strRegs holds register *indices*, not names, so
    // this list is ints and the comparison has to be against an int. E1005
    // caught the wrong version of this line before it ever reached the
    // bootstrap, which is the check earning its keep on the compiler's own
    // source rather than only on a user's.
    var ri = 0
    while ri < backend.strRegs.len() {
        if backend.strRegs.get(ri) == regId {
            return true
        }
        ri = ri + 1
    }
    return false
}

fn isStringArg(backend: CBackend, argStr: string) -> bool {
    if argStr.len() > 0 && argStr.at(0) == 34 { return true }
    if argStr.len() > 2 && argStr.slice(0, 2) == "r_" {
        var n = 0
        var i = 2
        while i < argStr.len() {
            val c = argStr.at(i)
            n = n * 10 + (c - 48)
            i = i + 1
        }
        return isStringReg(backend, n)
    }
    return isStringVar(backend, argStr)
}

// One side of a comparison is a string, so the other side is too. Used by
// both eq and ne, which is why it is a function and not an arm: see the note
// at the call site.
fn markStringComparedWith(backend: CBackend, func: IRFunction, inst: IRInstruction) {
    var other = inst.operand2
    if isStringOperand(backend, inst.operand1) {
        other = inst.operand2
    } else if isStringOperand(backend, inst.operand2) {
        other = inst.operand1
    } else {
        return
    }
    match other {
        IRValue.Register(reg) => {
            if regKnownScalar(func, reg.value) == false && reg.value >= 0 && reg.value < func.registerTypes.len() {
                func.registerTypes = setStrAt(func.registerTypes, reg.value, "string")
            }
        }
        _ => {}
    }
}

// A local bound to a string expression joins strVars, which is what makes the
// emitter give it a `const char *` instead of a machine word. decl_var and
// store_var both did this, identically.
fn markStringLocal(backend: CBackend, inst: IRInstruction) {
    match inst.operand1 {
        IRValue.Sym(s) => {
            if isStringOperand(backend, inst.operand2) {
                backend.strVars.push(s.value)
            }
        }
        _ => {}
    }
}

fn isStringOperand(backend: CBackend, operand: IRValue) -> bool {
    if operand == NULL { return false }
    match operand {
        IRValue.String(s) => { return true }
        IRValue.Register(v) => {
            if backend != NULL && backend.currentFunction != NULL {
                val f: IRFunction = backend.currentFunction
                if v.value >= 0 && v.value < f.registerTypes.len() {
                    if f.registerTypes.get(v.value) == "string" {
                        return true
                    }
                }
            }
            var ri = 0
            while ri < backend.strRegs.len() {
                if backend.strRegs.get(ri) == v.value {
                    return true
                }
                ri = ri + 1
            }
            return false
        }
        IRValue.Sym(s) => {
            return isStringVar(backend, s.value)
        }
        _ => { return false }
    }
}

fn feBuildTimeCallType(name: string) -> string {
    if name == "print" || name == "orbit_os_exit_selfhost" || name == "orbit_os_exit" || name == "orbit_os_destroy" || name == "orbit_os_reset" || name == "orbit_list_push" || name == "orbit_list_clear" || name == "orbit_map_set" || name == "orbit_cbuf_append_selfhost" { return "void" }
    if name == "orbit_object_create" { return "object" }
    if name == "orbit_object_set" || name == "orbit_object_set_int" || name == "orbit_object_set_float" || name == "orbit_object_set_bool" || name == "orbit_object_set_string" || name == "orbit_object_set_object" { return "void" }
    if name == "ok" || name == "err" { return "result" }
    if name == "orbit_object_to_json" || name == "orbit_os_argv" || name == "orbit_os_exec_selfhost" || name == "orbit_int_to_string" || name == "orbit_http_query_get" || name == "orbit_db_query_where" || name == "orbit_db_query_where_p" || name == "orbit_db_query_all" || name == "orbit_http_param_get" || name == "orbit_http_body_get" || name == "orbit_http_header_get" || name == "orbit_file_upload_save" || name == "orbit_auth_bearer_token" || name == "orbit_auth_current_role" || name == "orbit_db_query_get" || name == "orbit_file_read" || name == "orbit_os_cwd" || name == "orbit_os_exec" || name == "orbit_os_env" || name == "orbit_os_strdup" || name == "orbit_string_slice" || name == "orbit_cache_get" || name == "orbit_cbuf_create_selfhost" || name == "orbit_cbuf_build_selfhost" || name == "orbit_mem_report_selfhost" || name == "orbit_os_cwd_selfhost" || name == "orbit_string_from_char_selfhost" { return "string" }
    if name == "bit_op" || name == "orbit_os_spawn_selfhost" || name == "orbit_os_spawn_bg_selfhost" || name == "orbit_os_kill_selfhost" || name == "orbit_string_to_int" || name == "orbit_clock_ns" || name == "orbit_clock_ms" || name == "orbit_string_at" || name == "orbit_list_len" || name == "orbit_os_checkpoint" || name == "system_uptime" || name == "system_pid" || name == "system_active_workers" || name == "system_http_requests_total" || name == "system_latency_avg_us" || name == "system_latency_p50_us" || name == "system_latency_p95_us" || name == "system_latency_p99_us" { return "int" }
    if name == "orbit_os_mkdir_selfhost" { return "bool" }
    if name == "orbit_string_hash_selfhost" { return "string" }
    if name == "orbit_auth_has_role" || name == "orbit_db_insert" || name == "orbit_db_delete" || name == "orbit_file_write" || name == "orbit_file_exists" || name == "orbit_file_delete" || name == "orbit_os_chdir" || name == "orbit_os_rewind" || name == "orbit_cache_set" { return "bool" }
    if name == "orbit_file_list_dir" || name == "orbit_file_list_dir_selfhost" { return "list" }
    if name == "orbit_os_alloc" || name == "orbit_os_create_arena" { return "ptr" }
    if name == "orbit_response_json" { return "response" }
    // The frontend's own table, for the names this one did not copy over.
    // Consulted before giving up, because "unknown" here is not a shrug: it
    // means "do not guess a type for the local this register feeds", and for a
    // result or a response the local is an aggregate that cannot be hoisted as
    // an integer. The C compiler then rejects the store with a type error that
    // names the generated code and not the call that produced it.
    val fromFrontend = builtinReturnType(name)
    if fromFrontend != "" { return fromFrontend }
    return "unknown"
}

// Is this register holding an OrbitResult? A hoisted local is declared
// uintptr_t -- the integer slot every pointer-typed value is cast through --
// and that slot holds every other lowered type, because they are all scalars
// or all pointers. `result` is the one exception: OrbitResult is a struct, so
// a result local has to be declared with its own type or the store is the C
// error "aggregate value used where an integer was expected".
//
// The answer comes from func.registerTypes, which inferRegisterTypes has
// already finished filling in by the time anything asks. The builder put the
// callee's return type there, so a `-> result` function's result is known even
// when the callee is a user function feBuildTimeCallType has never heard of.
fn isResultRegisterType(func: IRFunction, regId: int) -> bool {
    if func == NULL || regId < 0 { return false }
    if regId >= func.registerTypes.len() { return false }
    val t = func.registerTypes.get(regId)
    return t == "result" || t == "Result" || t == "OrbitResult"
}

// Per-function instruction index behind variableDefType,
// operandFeFirstPrescanType and registerVarDefType.
//
// All three used to rescan the whole instruction list of the function on
// every call, and variableDefType nested the second scan inside the first
// (one self-build: 61440 variableDefType calls, ~530 instructions walked
// each). The index records the only two instruction-derived facts those
// walks were looking for, once per emitted function:
//   * defIdxNames/defIdxInsts: the FIRST decl_var/store_var instruction per
//     variable name. Those walks returned on the first such instruction and
//     skipped every other opcode, so "first instruction with this name whose
//     opcode is decl_var/store_var" is exactly what the scan found.
//   * defIdxRegInst/defIdxRegVerdict: the FIRST instruction defining each
//     register, plus the answer operandFeFirstPrescanType produced for it:
//     "unknown" when that instruction is a call the frontend cannot type
//     (feBuildTimeCallType answers "unknown"/"void"), "" in every other case
//     and for a register nothing defines.
//
// Invalidation: every entry is a pure function of func.instructions, which
// codegen only reads (the optimizer passes run to completion before
// generateC is entered and nothing mutates the IR afterwards), and the index
// is rebuilt whenever the function it describes is not the one the caller
// asked about. What is deliberately NOT cached is the type those queries
// return: operandDefType still reads func.registerTypes on every call, and
// inferRegisterTypes/emitInstruction rewrite registerTypes as they walk the
// function, so a memoized type string would answer with a pre-mutation type
// and change the emitted C.
fn ensureDefIndex(backend: CBackend, func: IRFunction) {
    if backend == NULL { return }
    if backend.defIdxFunc == func { return }
    backend.defIdxFunc = func
    backend.defIdxNames = []
    backend.defIdxInsts = []
    backend.defIdxRegInst = []
    backend.defIdxRegVerdict = []
    if func == NULL { return }
    var i = 0
    while i < func.instructions.len() {
        val inst: IRInstruction = func.instructions.get(i)
        if inst != NULL {
            var isDef = false
            match inst.opcode {
                IROpcode.decl_var => { isDef = true }
                IROpcode.store_var => { isDef = true }
                _ => {}
            }
            if isDef {
                var cname = ""
                match inst.operand1 {
                    IRValue.Sym(s) => { cname = s.value }
                    IRValue.String(s) => { cname = s.value }
                    _ => {}
                }
                if listContainsStr(backend.defIdxNames, cname) == false {
                    backend.defIdxNames.push(cname)
                    backend.defIdxInsts.push(inst)
                }
            }
            val rd = inst.dest
            if rd >= 0 {
                while backend.defIdxRegInst.len() <= rd {
                    backend.defIdxRegInst.push(NULL)
                    backend.defIdxRegVerdict.push("")
                }
                val firstDef: IRInstruction = backend.defIdxRegInst.get(rd)
                if firstDef == NULL {
                    backend.defIdxRegInst[rd] = inst
                    var verdict = ""
                    match inst.opcode {
                        IROpcode.call => {
                            var cn = ""
                            match inst.operand1 {
                                IRValue.String(s) => { cn = s.value }
                                IRValue.Sym(s) => { cn = s.value }
                                _ => {}
                            }
                            if cn != "" {
                                val bt = feBuildTimeCallType(cn)
                                // "unknown" here means "the FE table has no
                                // answer, so do not guess a type for the local
                                // this register feeds". A result is the case
                                // where refusing to guess is what breaks: the
                                // table lists `ok`/`err` but not the user's own
                                // `-> result` function, so binding one to a val
                                // hoisted it as uintptr_t and the store became an
                                // aggregate-to-integer C error. The register
                                // type the builder already assigned answers it
                                // properly, so let that stand.
                                if (bt == "unknown" || bt == "void") && isResultRegisterType(func, rd) == false {
                                    verdict = "unknown"
                                }
                            }
                        }
                        _ => {}
                    }
                    backend.defIdxRegVerdict[rd] = verdict
                }
            }
        }
        i = i + 1
    }
}

// Position of the first decl_var/store_var for `vn` in the index, or -1.
// A NULL backend cannot own an index and is answered "not found"; every
// caller reaches this with a live backend (storeCastFor dereferences
// backend.currentFunction to get there, and the two call sites that guard
// against NULL do so before calling).
fn defIndexForName(backend: CBackend, func: IRFunction, vn: string) -> int {
    if backend == NULL { return -1 }
    ensureDefIndex(backend, func)
    var j = 0
    while j < backend.defIdxNames.len() {
        if backend.defIdxNames.get(j) == vn { return j }
        j = j + 1
    }
    return -1
}

// First instruction defining `regId`, or NULL when the register has none.
fn firstDefInstForReg(backend: CBackend, func: IRFunction, regId: int) -> IRInstruction {
    if backend == NULL || regId < 0 { return NULL }
    ensureDefIndex(backend, func)
    if regId < backend.defIdxRegInst.len() {
        return backend.defIdxRegInst.get(regId)
    }
    return NULL
}

fn operandFeFirstPrescanType(backend: CBackend, func: IRFunction, op2: IRValue) -> string {
    match op2 {
        IRValue.Register(reg) => {
            val rv = reg.value
            if rv >= 0 {
                ensureDefIndex(backend, func)
                if backend != NULL && rv < backend.defIdxRegVerdict.len() {
                    return backend.defIdxRegVerdict.get(rv)
                }
            }
        }
        _ => {}
    }
    return ""
}

// The register an emitted argument names, or -1 when it is not a bare
// register reference. The backend only ever writes a register as `r_<n>`, so
// the text is enough -- the same shape test isFloatArgReg was already doing.
fn argRegId(argStr: string) -> int {
    if argStr.len() < 3 { return -1 }
    if argStr.slice(0, 2) != "r_" { return -1 }
    var regNum = 0
    var ai = 2
    while ai < argStr.len() {
        val ach = argStr.at(ai)
        if ach < 48 || ach > 57 { return -1 }
        regNum = regNum * 10 + (ach - 48)
        ai = ai + 1
    }
    return regNum
}

fn isFloatArgReg(backend: CBackend, argStr: string) -> bool {
    val regNum = argRegId(argStr)
    if regNum < 0 { return false }
    if backend != NULL && backend.currentFunction != NULL {
        val af: IRFunction = backend.currentFunction
        if regNum < af.registerTypes.len() {
            val at = af.registerTypes.get(regNum)
            if at == "float" || at == "orbit_float" { return true }
        }
    }
    return false
}

// A response body is a `const char*` in C, and sema already refuses a body
// whose type it can prove is an int, a float or a bool. It cannot refuse what
// it cannot type: an expression that infers as `unknown` -- mismatched
// arithmetic operands, an index, a call it has no signature for -- satisfies
// checkCompatibility("string", "unknown") and arrives here as a bare register.
// Handing that to a pointer parameter is the int-to-pointer conversion the C
// compiler diagnoses, and if it slips through it segfaults serving the first
// request.
//
// The conversion belongs here, where the type is known: inferRegisterTypes has
// filled func.registerTypes in before any instruction is emitted, and only a
// value it says is a scalar can be wrapped. A string, a pointer, and anything
// still unknown go through untouched, exactly as before -- assuming the
// opposite for those would corrupt the bodies that are already correct.
fn responseBodyArg(backend: CBackend, argStr: string) -> string {
    if backend == NULL || backend.currentFunction == NULL { return argStr }
    val f: IRFunction = backend.currentFunction
    val regNum = argRegId(argStr)
    if regNum < 0 || regNum >= f.registerTypes.len() { return argStr }
    val t = f.registerTypes.get(regNum)
    if t == "int" { return "orbit_int_to_string(arena, (orbit_int)(uintptr_t)(" + argStr + "))" }
    if t == "float" || t == "orbit_float" { return "orbit_float_to_string(arena, (orbit_float)(" + argStr + "))" }
    if t == "bool" || t == "orbit_bool" { return "orbit_bool_to_string(arena, (orbit_bool)(uintptr_t)(" + argStr + "))" }
    return argStr
}

fn variableDefType(backend: CBackend, func: IRFunction, vn: string) -> string {
    val di = defIndexForName(backend, func, vn)
    if di >= 0 {
        val inst: IRInstruction = backend.defIdxInsts.get(di)
        val fb = operandFeFirstPrescanType(backend, func, inst.operand2)
        if fb == "unknown" {
            if vn == "test_name" || vn == "msg" || vn == "message" || vn == "name" || vn == "path" || vn == "url" || vn == "cmd" { return "string" }
            return "usize"
        }
        return operandDefType(func, inst.operand2)
    }
    return "unknown"
}

// The C type a hoisted local is declared with. Pointer-typed locals are
// deliberately declared `uintptr_t` and cast back at each use, so a
// declaration that could not be resolved falls back to the integer type
// rather than to `void*`: the emitter still needs the field owner's type
// to lower `result.line` and friends.
//
// storeCastFor must consult this too. A store cast that disagrees with the
// declaration is an implicit int/pointer conversion, which is exactly what
// -Wint-conversion rejects.
fn hoistedCType(backend: CBackend, func: IRFunction, vn: string) -> string {
    val vType = variableDefType(backend, func, vn)
    var cType = "uintptr_t"
    if vType == "int" { cType = "orbit_int" }
    else if vType == "string" { cType = "orbit_string" }
    else if vType == "float" { cType = "orbit_float" }
    else if vType == "bool" { cType = "orbit_bool" }
    else if vType == "result" || vType == "Result" || vType == "OrbitResult" { cType = "OrbitResult" }
    return cType
}

// The cast a store of a pointer-shaped value into `vn` needs. It has to
// agree with the local's declared C type: a local hoisted as `uintptr_t`
// (the representation for every pointer-typed local) needs the explicit
// pointer-to-integer conversion, while a local declared as a real pointer
// type takes `(void*)`. Handing a bare `(void*)` to a `uintptr_t` local is an
// implicit int-from-pointer, which is what -Wint-conversion rejects.
fn pointerStoreCast(backend: CBackend, vn: string) -> string {
    if hoistedCType(backend, backend.currentFunction, vn) == "uintptr_t" { return "(uintptr_t)" }
    return "(void*)"
}

fn storeCastFor(backend: CBackend, vn: string) -> string {
    val vType = variableDefType(backend, backend.currentFunction, vn)
    if vType == "float" { return "(orbit_float)" }
    if vType == "int" || vType == "bool" || isEnumType(backend, vType) { return "(orbit_int)(uintptr_t)" }
    if vType == "result" || vType == "Result" || vType == "OrbitResult" { return "" }
    if vType == "string" || vType == "list" || vType == "map" || vType == "response" || vType == "tagged_union" || vType == "pointer" || vType == "mut_pointer" {
        return pointerStoreCast(backend, vn)
    }
    // Name heuristic last: vars ending in Id/id read as integers ONLY when
    // nothing is known about them. A known string (e.g. `val id =
    // req.param("id")`) must keep its pointer intact; the old order
    // truncated it through orbit_int and crashed string use downstream.
    if vType == "unknown" || vType == "usize" || vType == "" {
        val vlen = orbit_string_len(vn)
        if vlen >= 2 {
            val tail2 = orbit_string_slice(vn, vlen - 2, vlen)
            if tail2 == "Id" || tail2 == "id" { return "(orbit_int)(uintptr_t)" }
        }
        if vn == "scopeId" { return "(orbit_int)(uintptr_t)" }
        return "(uintptr_t)"
    }
    val cType = mapTypeToC(backend, vType)
    val clen = orbit_string_len(cType)
    if clen > 0 {
        val last = orbit_string_slice(cType, clen - 1, clen)
        if last == "*" { return pointerStoreCast(backend, vn) }
    }
    return "(uintptr_t)"
}

// A float is contagious through arithmetic, but not through concatenation.
// `add` doubles as string concatenation: the backend converts the non-string
// side with stringifyConcatOperand and the result is a string. So an operand
// that is a string, or a destination already known to be one, must not be
// turned into a float here.
//
// Without this guard `"text: " + 1.5` declared its result orbit_float and then
// assigned it a string, which the C compiler rejected; the fix makes both that
// and string interpolation come out right.
// add, sub, mul, div and neg all spread a float, and each of the five arms said
// so in full. Five copies of the same four lines is five places to forget when
// floatSpreads gains a case.
fn markFloatIfSpreads(func: IRFunction, inst: IRInstruction) {
    if floatSpreads(func, inst) {
        func.registerTypes = setStrAt(func.registerTypes, inst.dest, "float")
    }
}

fn floatSpreads(func: IRFunction, inst: IRInstruction) -> bool {
    if inst == NULL { return false }
    if operandIsStringForFunc(func, inst.operand1) { return false }
    if operandIsStringForFunc(func, inst.operand2) { return false }
    if inst.dest >= 0 && inst.dest < func.registerTypes.len() {
        if func.registerTypes.get(inst.dest) == "string" { return false }
    }
    return operandDefType(func, inst.operand1) == "float" || operandDefType(func, inst.operand2) == "float"
}

fn operandIsStringForFunc(func: IRFunction, op2: IRValue) -> bool {
    match op2 {
        IRValue.String(s) => {
            if s.value.indexOf("TAG_") != -1 { return false }
            return true
        }
        IRValue.Register(reg) => {
            if reg.value >= 0 && reg.value < func.registerTypes.len() {
                return func.registerTypes.get(reg.value) == "string"
            }
        }
        _ => {}
    }
    return false
}

fn operandDefType(func: IRFunction, op2: IRValue) -> string {
    match op2 {
        IRValue.Int(v) => { return "int" }
        IRValue.Float(v) => { return "float" }
        IRValue.Bool(v) => { return "bool" }
        IRValue.String(s) => {
            if s.value.indexOf("TAG_") != -1 { return "int" }
            return "string"
        }
        IRValue.Sym(s) => {
            if s.value == "true" || s.value == "false" { return "bool" }
            if s.value.indexOf("TAG_") != -1 { return "int" }
            return "unknown"
        }
        IRValue.Register(reg) => {
            if reg.value >= 0 && reg.value < func.registerTypes.len() {
                val t = func.registerTypes.get(reg.value)
                if t != "unknown" && t != "" && t != "void" {
                    return t
                }
            }
            return "unknown"
        }
        _ => { return "unknown" }
    }
}

fn registerVarDefType(backend: CBackend, func: IRFunction, regId: int) -> string {
    val inst = firstDefInstForReg(backend, func, regId)
    if inst != NULL {
        match inst.opcode {
            IROpcode.load_var => {
                var vn = ""
                match inst.operand1 {
                    IRValue.Sym(s) => { vn = s.value }
                    IRValue.String(s) => { vn = s.value }
                    _ => {}
                }
                if vn != "" {
                    val t = variableDefType(backend, func, vn)
                    if t != "unknown" { return t }
                    if isStringVar(backend, vn) { return "string" }
                }
            }
            _ => {}
        }
    }
    return "unknown"
}

// Wave 0 STAB: the string-propagation tattoos below consult
// registerVarDefType, which answers "unknown" for constants defined by
// load_const. A register the inference already proved int/float/bool
// must never be re-tattooed "string" (it produced `(orbit_string)(0)`
// nulls in mixed concat and strcmp crashes on tattooed int regs).
fn regKnownScalar(func: IRFunction, regId: int) -> bool {
    if regId >= 0 && regId < func.registerTypes.len() {
        val t = func.registerTypes.get(regId)
        if t == "int" || t == "float" || t == "bool" { return true }
    }
    return false
}

fn stringifyConcatOperand(backend: CBackend, operand: IRValue) -> string {
    val raw = generateValue(operand)
    if isStringOperand(backend, operand) {
        return raw
    }
    var t = "int"
    match operand {
        IRValue.Register(reg) => {
            if backend != NULL && backend.currentFunction != NULL {
                val f: IRFunction = backend.currentFunction
                if reg.value >= 0 && reg.value < f.registerTypes.len() {
                    t = f.registerTypes.get(reg.value)
                }
            }
        }
        IRValue.Bool(v) => { t = "bool" }
        IRValue.Float(v) => { t = "float" }
        IRValue.Int(v) => { t = "int" }
        IRValue.String(s) => {
            if s.value.indexOf("TAG_") != -1 { t = "int" }
        }
        IRValue.Sym(s) => {
            if s.value == "true" || s.value == "false" { t = "bool" }
            else if s.value.indexOf("TAG_") != -1 { t = "int" }
        }
        _ => {}
    }
    if t == "bool" {
        return "orbit_bool_to_string(arena, (orbit_bool)(uintptr_t)(" + raw + "))"
    }
    if t == "float" {
        return "orbit_float_to_string(arena, (orbit_float)(" + raw + "))"
    }
    if t == "string" {
        return raw
    }
    return "orbit_int_to_string_selfhost((orbit_int)(uintptr_t)(" + raw + "))"
}

fn functionReturnsVoid(backend: CBackend, name: string) -> bool {
    if name == "orbit_list_set" { return true }
    // orbit_list_clear is a void function the emitter did not know about, so
    // a call to it was assigned to a register -- `invalid use of void
    // expression` from the C step, with `orbit check` clean. Same shape as
    // F-0004, and the same fix: the return type belongs where the call is
    // emitted, and this is that place.
    if name == "orbit_list_clear" { return true }
    if name == "orbit_object_set" || name == "orbit_object_set_int" || name == "orbit_object_set_float" || name == "orbit_object_set_bool" || name == "orbit_object_set_string" || name == "orbit_object_set_object" { return true }
    var fi = 0
    while fi < backend.module.functions.len() {
        val f: IRFunction = backend.module.functions.get(fi)
        if f.name == name && f.returnType == "void" {
            return true
        }
        fi = fi + 1
    }
    if name == "orbit_main" || name == "main_main" {
        var fi2 = 0
        while fi2 < backend.module.functions.len() {
            val f2: IRFunction = backend.module.functions.get(fi2)
            if f2.name == "main" && f2.returnType == "void" {
                return true
            }
            fi2 = fi2 + 1
        }
    }
    return false
}

fn functionNeedsArena(name: string) -> bool {
    if name == "orbit_file_read" || name == "orbit_file_list_dir" { return true }
    if name == "orbit_list_create" || name == "orbit_map_create" { return true }
    if name == "orbit_object_create" { return true }
    if name == "orbit_object_to_json" { return true }
    // Deliberately not here: the orbit_object_set* family takes the object as
    // its first parameter, not an arena. It reaches the arena through the
    // object, so prepending one gave every field write four arguments.
    if name == "orbit_response_create" || name == "orbit_response_json" || name == "orbit_response_error" { return true }
    if name == "orbit_string_slice" || name == "orbit_string_split" || name == "orbit_string_replace" || name == "orbit_string_concat" { return true }
    if name == "orbit_os_exec" || name == "orbit_os_env" || name == "orbit_os_argv" { return true }
    if name == "orbit_int_to_string" || name == "orbit_float_to_string" { return true }
    if name == "orbit_http_query_get" || name == "orbit_http_header_get" || name == "orbit_http_param_get" || name == "orbit_http_body_get" { return true }
    if name == "orbit_db_get" || name == "orbit_db_all" || name == "orbit_db_where" || name == "orbit_db_first" { return true }
    if name == "orbit_auth_bearer_token" || name == "orbit_auth_role" || name == "orbit_auth_current_role" || name == "orbit_auth_has_role" { return true }
    if name == "orbit_db_query_all" || name == "orbit_db_query_where" || name == "orbit_db_query_where_p" || name == "orbit_db_query_get" { return true }
    if name == "orbit_http_client_fetch" || name == "orbit_cache_get" || name == "orbit_file_upload_save" { return true }
    if name == "orbit_base64url_encode_str" || name == "orbit_sha256_hex" || name == "orbit_hmac_sha256_base64url" { return true }
    return false
}

// Which getter a field read needs depends on what was stored under that key,
// and the write is usually in the same function: an object literal builds
// itself in place, so `{ a: 1 }` above the read is right there in the
// instruction list.
//
// The register cannot be used to identify the object. Every read of a variable
// loads it into a fresh register, so `o.ratio` reads through a different
// register than the literal was built in, and comparing register ids matches
// nothing. The field name is what identifies the write.
//
// A key stored with two different kinds in one function -- `{a: 1}` and
// `{a: "x"}` -- has no single answer, so it falls back to the raw getter
// rather than picking the first one seen.
fn objectFieldGetter(func: IRFunction, fieldName: string) -> string {
    var kind = ""
    var conflict = false
    var i = 0
    while i < func.instructions.len() {
        val inst: IRInstruction = func.instructions.get(i)
        var isCall = false
        if inst != NULL {
            match inst.opcode {
                IROpcode.call => { isCall = true }
                _ => {}
            }
        }
        if isCall {
            var callee = ""
            match inst.operand1 {
                IRValue.String(cs) => { callee = cs.value }
                _ => {}
            }
            if isObjectFieldSetter(callee) && setterKeyIs(func, i, fieldName) {
                val found = ""
                if callee == "orbit_object_set_int" { found = "int" }
                if callee == "orbit_object_set_float" { found = "float" }
                if callee == "orbit_object_set_bool" { found = "bool" }
                if callee == "orbit_object_set_object" { found = "object" }
                if callee == "orbit_object_set_string" { found = "string" }
                if kind == "" { kind = found }
                if kind != found { conflict = true }
            }
        }
        i = i + 1
    }
    if conflict { return "orbit_object_get_raw" }
    if kind == "int" { return "orbit_object_get_int" }
    if kind == "float" { return "orbit_object_get_float" }
    if kind == "bool" { return "orbit_object_get_bool" }
    if kind == "object" { return "orbit_object_get_object" }
    if kind == "string" { return "orbit_object_get_string" }
    return "orbit_object_get_raw"
}

// Does the call at callIdx store fieldName? A setter is emitted as three arg
// instructions immediately before the call: the object, the key, the value.
// Walking back over them is more reliable than tracking a stack, which the
// backend does not keep per call site.
fn setterKeyIs(func: IRFunction, callIdx: int, fieldName: string) -> bool {
    var key = ""
    var found = 0
    var i = callIdx - 1
    // Backwards from the call the args arrive value first, then the key, then
    // the object, which is the reverse of the order they were pushed.
    while i >= 0 && found < 3 {
        val prev: IRInstruction = func.instructions.get(i)
        var isArg = false
        if prev != NULL {
            match prev.opcode {
                IROpcode.arg => { isArg = true }
                _ => {}
            }
        }
        if isArg {
            if found == 1 {
                match prev.operand1 {
                    IRValue.String(ks) => { key = ks.value }
                    IRValue.Sym(ks) => { key = ks.value }
                    _ => {}
                }
            }
            found = found + 1
        }
        i = i - 1
    }
    return key == fieldName
}

fn objectGetterReturnType(getter: string) -> string {
    if getter == "orbit_object_get_int" { return "int" }
    if getter == "orbit_object_get_float" { return "float" }
    if getter == "orbit_object_get_bool" { return "bool" }
    if getter == "orbit_object_get_string" { return "string" }
    if getter == "orbit_object_get_object" { return "object" }
    return ""
}

fn isObjectFieldSetter(name: string) -> bool {
    if name == "orbit_object_set_int" { return true }
    if name == "orbit_object_set_float" { return true }
    if name == "orbit_object_set_bool" { return true }
    if name == "orbit_object_set_string" { return true }
    if name == "orbit_object_set_object" { return true }
    return false
}

fn isRouteRuntimeBuiltin(name: string) -> bool {
    if name == "orbit_http_client_fetch" { return true }
    if name == "orbit_http_query_get" || name == "orbit_http_body_get" || name == "orbit_http_param_get" || name == "orbit_http_header_get" { return true }
    if name == "orbit_db_query_all" || name == "orbit_db_query_where" || name == "orbit_db_query_where_p" || name == "orbit_db_query_get" { return true }
    if name == "orbit_db_insert" || name == "orbit_db_delete" { return true }
    if name == "orbit_auth_bearer_token" || name == "orbit_auth_current_role" || name == "orbit_auth_has_role" { return true }
    if name == "orbit_response_json" || name == "orbit_response_error" { return true }
    if name == "orbit_file_upload_save" { return true }
    return false
}

