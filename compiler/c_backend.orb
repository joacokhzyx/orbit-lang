            if calleeName == "orbit_list_len" {
                if backend.callArgs.len() >= startIdx + 1 {
                    val receiverStr = backend.callArgs.get(startIdx)
                    while backend.callArgs.len() > startIdx { backend.callArgs.pop() }
                    if isStringArg(backend, receiverStr) || isStringVar(backend, receiverStr) || isStringReg(backend, receiverStr) {
                        val safeLen = "orbit_string_len((orbit_string)(" + receiverStr + "))"
                        if destNeeded {
                            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, safeLen))
                            return
                        }
                        orbit_cbuf_append_selfhost(cb, "    " + safeLen + ";\n")
                        return
                    } else {
                        val safeLen2 = "(orbit_int)orbit_list_len((const OrbitList*)(" + receiverStr + "))"
                        if destNeeded {
                            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, safeLen2))
