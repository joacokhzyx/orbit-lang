                    } else {
                        callExpr = callExpr + "(void*)(uintptr_t)(" + aStr + ")"
                    }
                } else if calleeName == "orbit_float_to_string_selfhost" {
                    if isFloatArgReg(backend, aStr) {
                        callExpr = callExpr + "(orbit_float)(" + aStr + ")"
                    } else if backend != NULL && backend.currentFunction != NULL && variableDefType(backend, backend.currentFunction, aStr) == "float" {
                        callExpr = callExpr + "(orbit_float)(" + aStr + ")"
                    } else {
                        callExpr = callExpr + "(orbit_float)(uintptr_t)(" + aStr + ")"
                    }
                } else if calleeName == "isDigit" || calleeName == "isAlpha" || calleeName == "isAlphaNumeric" || calleeName == "orbit_int_to_string_selfhost" || calleeName == "orbit_int_to_string" || calleeName == "orbit_os_argv_selfhost" || calleeName == "orbit_os_exit_selfhost" || calleeName == "orbit_string_from_char_selfhost" {
