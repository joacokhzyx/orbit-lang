                    // only one construct reaches the object setter at all --
                    // a literal whose field value is itself a literal -- so a
                    // single missing arm reads as a whole platform being
                    // broken.
                    if argIdx == 0 {
                        callExpr = callExpr + "(OrbitObject*)(" + aStr + ")"
                    } else if argIdx == 1 {
                        callExpr = callExpr + "(const char*)(" + aStr + ")"
                    } else if calleeName == "orbit_object_set_float" {
                        callExpr = callExpr + "(orbit_float)(" + aStr + ")"
                    } else if calleeName == "orbit_object_set_int" {
                        callExpr = callExpr + "(orbit_int)(" + aStr + ")"
                    } else if calleeName == "orbit_object_set_bool" {
                        callExpr = callExpr + "(orbit_bool)(" + aStr + ")"
                    } else if calleeName == "orbit_object_set_object" {
                        callExpr = callExpr + "(OrbitObject*)(" + aStr + ")"
                    } else {
                        callExpr = callExpr + "(const char*)(" + aStr + ")"
                    }
