    if name == "slice" { return true }
    if name == "generateValue" { return true }
    if name == "escapeString" { return true }
    if name == "unescapeString" { return true }
    if name == "stripQuotes" { return true }
    if name == "getDir" { return true }
    if name == "resolveFilePath" { return true }
    if name == "normalizePath" { return true }
    if name == "fieldRefOwner" { return true }
    if name == "fieldRefName" { return true }
    if name == "extractMemberAccessName" { return true }
    if name == "getEnumNameFromTag" { return true }
    if name == "frontendOutputPath" { return true }
    if name == "mapTypeToC" { return true }
    if name == "tokTypeToString" { return true }
    if name == "orbit_string_slice" { return true }
    if name == "orbit_string_concat" { return true }
    if name == "orbit_string_split" { return true }
    if name == "orbit_string_replace" { return true }
    if name == "orbit_int_to_string_selfhost" { return true }
    if name == "orbit_cbuf_create_selfhost" { return true }
    if name == "orbit_cbuf_build_selfhost" { return true }
    if name == "orbit_mem_report_selfhost" { return true }
    if name == "orbit_os_cwd_selfhost" { return true }
    if name == "orbit_string_from_char_selfhost" { return true }
    if name == "orbit_os_argv_selfhost" { return true }
    if name == "orbit_os_env_selfhost" { return true }
    if name == "orbit_file_read_selfhost" { return true }
    if name == "orbit_int_to_string" { return true }
    if name == "orbit_float_to_string" { return true }
    if name == "orbit_bool_to_string" { return true }
    if name == "orbit_http_client_fetch" { return true }
    if name == "orbit_cache_get" { return true }
    if name == "orbit_file_upload_save" { return true }
    if name == "orbit_http_param_get" || name == "orbit_http_body_get" || name == "orbit_http_query_get" || name == "orbit_http_header_get" { return true }
    if name == "orbit_base64url_encode_str" || name == "orbit_sha256_hex" || name == "orbit_hmac_sha256_base64url" { return true }
    if name == "orbit_auth_bearer_token" || name == "orbit_auth_role" || name == "orbit_auth_current_role" { return true }
    if name == "orbit_db_query_all" || name == "orbit_db_query_where" || name == "orbit_db_query_where_p" || name == "orbit_db_query_get" { return true }
    return false
}

fn findFieldOwner(backend: CBackend, fieldName: string) -> string {
    var i = backend.fieldNames.len()
    while i > 0 {
        i = i - 1
        if backend.fieldNames.get(i) == fieldName {
            return backend.fieldOwners.get(i)
        }
    }
    return ""
}

fn fieldRefOwner(fieldRef: string) -> string {
    val dot = dotPosOf(fieldRef)
    if dot <= 0 {
        return ""
    }
    return sanitizeIdentifier(orbit_string_slice(fieldRef, 0, dot))
}

fn fieldRefName(fieldRef: string) -> string {
    val dot = dotPosOf(fieldRef)
    if dot <= 0 {
        return sanitizeIdentifier(fieldRef)
    }
    return sanitizeIdentifier(orbit_string_slice(fieldRef, dot + 1, orbit_string_len(fieldRef)))
}

fn moduleHasFunction(backend: CBackend, name: string) -> bool {
    var i = 0
    while i < backend.module.functions.len() {
        val f: IRFunction = backend.module.functions.get(i)
        if f.name == name {
            return true
        }
        i = i + 1
    }
    return false
}

fn isDbBuiltin(name: string) -> bool {
    if name == "orbit_db_query_all" || name == "orbit_db_query_where" || name == "orbit_db_query_where_p" || name == "orbit_db_query_get" || name == "orbit_db_insert" || name == "orbit_db_delete" {
        return true
    }
    return false
}

fn isAuthBuiltin(name: string) -> bool {
    if name == "orbit_auth_bearer_token" || name == "orbit_auth_current_role" || name == "orbit_auth_has_role" { return true }
    return false
}

// Does this module call anything that needs auth linkage, or anything that
// needs the SQLite library linked in? These were twenty-six lines twice, and
// the two copies had drifted by exactly the clause that matters: database
// linkage has to be satisfied for auth too, because auth reads the sessions
// table. Written twice, that clause was one forgotten edit away from an
// undefined reference at link time rather than a compile error.
fn moduleUsesAuth(module: IRModule) -> bool {
    return moduleCallsBuiltin(module, "auth")
}

fn moduleUsesDatabase(module: IRModule) -> bool {
    if module.migrations.len() > 0 { return true }
    return moduleCallsBuiltin(module, "db")
}

// `kind` is "auth" or "db". The auth check is made for both, deliberately:
// auth implies db.
fn moduleCallsBuiltin(module: IRModule, kind: string) -> bool {
    var fi = 0
    while fi < module.functions.len() {
        val f: IRFunction = module.functions.get(fi)
        var ii = 0
        while ii < f.instructions.len() {
            val inst: IRInstruction = f.instructions.get(ii)
            match inst.opcode {
                IROpcode.call => {
                    var cn = ""
                    match inst.operand1 {
                        IRValue.String(s) => { cn = s.value }
                        IRValue.Sym(s) => { cn = s.value }
                        _ => {}
                    }
                    if isAuthBuiltin(cn) { return true }
                    if kind == "db" && isDbBuiltin(cn) { return true }
                }
                _ => {}
            }
            ii = ii + 1
        }
        fi = fi + 1
    }
    return false
}

fn declaredScalarField(backend: CBackend, fieldName: string) -> bool {
    var found = false
    var allScalar = true
    var mi = 0
    while mi < backend.module.models.len() {
        val m: IRModelDecl = backend.module.models.get(mi)
        var fi = 0
        while fi < m.fields.len() {
            val f: IRModelField = m.fields.get(fi)
            if f.name == fieldName {
                found = true
                if f.typeName != "int" && f.typeName != "bool" && f.typeName != "float" {
                    allScalar = false
                }
            }
            fi = fi + 1
        }
        mi = mi + 1
    }
    return found && allScalar
}

fn isStringFieldName(backend: CBackend, fieldName: string) -> bool {
    var allString = true
    var found = false
    var mi = 0
    while mi < backend.module.models.len() {
        val m: IRModelDecl = backend.module.models.get(mi)
        var fi = 0
        while fi < m.fields.len() {
            val f: IRModelField = m.fields.get(fi)
            if f.name == fieldName {
                found = true
                if f.typeName != "string" {
                    allString = false
                }
            }
            fi = fi + 1
        }
        mi = mi + 1
    }
    if found == false { return false }
    return allString
}

fn calleeEnumParamName(backend: CBackend, calleeName: string, argIdx: int) -> string {
    var pT = ""
    var pi = 0
    while pi < backend.module.functions.len() {
        val f: IRFunction = backend.module.functions.get(pi)
        if f.name == calleeName {
            var off = 0
            if functionNeedsArena(calleeName) { off = 1 }
            val idx = argIdx + off
            if idx < f.paramTypes.len() { pT = f.paramTypes.get(idx) }
            pi = backend.module.functions.len()
        }
        pi = pi + 1
    }
    if pT == "" { return "" }
    var ti = 0
    while ti < backend.module.types.len() {
        val t: IRTypeDecl = backend.module.types.get(ti)
        if t.name == pT && t.kind == "enumeration" { return pT }
        ti = ti + 1
    }
    return ""
}
