            // answered a byte of the OrbitList header. A name says which
            // function it is; a receiver's spelling cannot.
            if calleeName == "orbit_list_get" {
                if backend.callArgs.len() >= startIdx + 2 {
                    val receiverStr = backend.callArgs.get(startIdx)
                    val idxStr = backend.callArgs.get(startIdx + 1)
                    while backend.callArgs.len() > startIdx { backend.callArgs.pop() }
                    if destNeeded {
                        orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, listReadCall(0, receiverStr, idxStr)))
