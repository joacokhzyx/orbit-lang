import "./ir.orb"

model CBackend {
    module: IRModule
    output: string
    currentFunction: IRFunction
    callArgs: list
}

fn initCBackend(module: IRModule) -> CBackend {
    return CBackend(module, "", initIRFunction(""), [])
}

fn generateC(backend: CBackend) -> string {
    var out = "#include \"runtime.h\"\n\n"
    out = out + "OrbitArena* arena = NULL;\n\n"
    out = out + "void orbit_main(void);\n\n"
    var i = 0
    while i < backend.module.functions.len() {
        val func = backend.module.functions.get(i)
        out = out + generateFunction(backend, func)
        i = i + 1
    }
    out = out + "\nint main(int argc, char** argv) {\n"
    out = out + "    arena = orbit_arena_create(64 * 1024 * 1024);\n"
    out = out + "    orbit_main();\n"
    out = out + "    return 0;\n"
    out = out + "}\n"
    return out
}

fn mapTypeToC(orbitType: string) -> string {
    if orbitType == "int" { return "orbit_int" }
    if orbitType == "float" { return "orbit_float" }
    if orbitType == "string" { return "orbit_string" }
    if orbitType == "bool" { return "orbit_bool" }
    if orbitType == "void" { return "void" }
    if orbitType == "list" || orbitType == "List" { return "OrbitList*" }
    if orbitType == "map" || orbitType == "Map" { return "OrbitMap*" }
    if orbitType == "TokType" { return orbitType }
    return "void*"
}

fn orbit_itoa(n: int) -> string {
    if n == 0 { return "0" }
    val digits = "0123456789"
    var str = ""
    var temp = n
    while temp > 0 {
        val rem = temp - ((temp / 10) * 10)
        str = digits.slice(rem, rem + 1) + str
        temp = temp / 10
    }
    return str
}

fn generateFunction(backend: CBackend, func: IRFunction) -> string {
    backend.currentFunction = func
    backend.callArgs = []
    var retType = mapTypeToC(func.returnType)
    var fName = func.name
    var isMain = false
    if fName == "main" || fName == "orbit_main" || fName == "main_main" {
        isMain = true
    } else {
        val fLen = orbit_string_len(fName)
        if fLen > 5 {
            val tail = orbit_string_slice(fName, fLen - 5, fLen)
            if tail == "_main" { isMain = true }
        }
    }
    if isMain {
        fName = "orbit_main"
        retType = "void"
    }
    var out = retType + " " + fName + "("
    var i = 0
    if func.params.len() == 0 {
        out = out + "void"
    } else {
        while i < func.params.len() {
            val pName = func.params.get(i)
            val pType = mapTypeToC(func.paramTypes.get(i))
            out = out + pType + " " + pName
            if i < func.params.len() - 1 {
                out = out + ", "
            }
            i = i + 1
        }
    }
    out = out + ") {\n"
    i = 0
    while i < func.registerCount {
        val rType = mapTypeToC(func.registerTypes.get(i))
        if rType != "void" {
            out = out + "    " + rType + " r_" + orbit_itoa(i) + ";\n"
        }
        i = i + 1
    }
    i = 0
    while i < func.instructions.len() {
        val instr = func.instructions.get(i)
        out = out + generateInstruction(backend, instr)
        i = i + 1
    }
    if func.returnType != "void" {
        if retType == "orbit_int" {
            out = out + "    return 0;\n"
        } else if retType == "orbit_bool" {
            out = out + "    return false;\n"
        } else {
            out = out + "    return NULL;\n"
        }
    }
    out = out + "}\n\n"
    return out
}

fn generateValue(backend: CBackend, value: IRValue) -> string {
    match value {
        IRValue.Int(v) => { return orbit_itoa(v.value) }
        IRValue.Float(v) => { return orbit_itoa(v.value) }
        IRValue.String(v) => { return "\"" + v.value + "\"" }
        IRValue.Sym(v) => { return v.value }
        IRValue.Bool(v) => {
            if v.value { return "true" }
            return "false"
        }
        IRValue.Register(v) => { return "r_" + orbit_itoa(v.value) }
        IRValue.Label(v) => { return "label_" + orbit_itoa(v.value) }
        _ => { return "" }
    }
}

fn generateInstruction(backend: CBackend, instr: IRInstruction) -> string {
    match instr.opcode {
        IROpcode.nop => {
            return "    /* nop */\n"
        }
        IROpcode.load_const => {
            return "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + ";\n"
        }
        IROpcode.load_var => {
            return "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + ";\n"
        }
        IROpcode.store_var => {
            return "    " + generateValue(backend, instr.operand1) + " = " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.decl_var => {
            return "    void* " + generateValue(backend, instr.operand1) + " = " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.add => {
            return "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + " + " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.sub => {
            return "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + " - " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.mul => {
            return "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + " * " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.div => {
            return "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + " / " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.mod => {
            return "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + " % " + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.eq => {
            return "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " == " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.ne => {
            return "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " != " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.lt => {
            return "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " < " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.le => {
            return "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " <= " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.gt => {
            return "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " > " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.ge => {
            return "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " >= " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.and_op => {
            return "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " && " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.or_op => {
            return "    r_" + orbit_itoa(instr.dest) + " = (" + generateValue(backend, instr.operand1) + " || " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.not_op => {
            return "    r_" + orbit_itoa(instr.dest) + " = !" + generateValue(backend, instr.operand1) + ";\n"
        }
        IROpcode.neg => {
            return "    r_" + orbit_itoa(instr.dest) + " = -" + generateValue(backend, instr.operand1) + ";\n"
        }
        IROpcode.begin_block => {
            return "    {\n"
        }
        IROpcode.end_block => {
            return "    }\n"
        }
        IROpcode.label => {
            return "label_" + generateValue(backend, instr.operand1) + ":;\n"
        }
        IROpcode.jump => {
            return "    goto label_" + generateValue(backend, instr.operand1) + ";\n"
        }
        IROpcode.jump_if_false => {
            return "    if (!" + generateValue(backend, instr.operand1) + ") goto label_" + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.copy => {
            val valStr = generateValue(backend, instr.operand1)
            val rType = mapTypeToC(backend.currentFunction.registerTypes.get(instr.dest))
            if rType == "void*" && (valStr == "true" || valStr == "false") {
                return "    r_" + orbit_itoa(instr.dest) + " = (void*)(uintptr_t)(" + valStr + ");\n"
            } else if valStr.indexOf("TAG_") != -1 {
                return "    r_" + orbit_itoa(instr.dest) + " = (orbit_int)(" + valStr + ");\n"
            } else {
                return "    r_" + orbit_itoa(instr.dest) + " = " + valStr + ";\n"
            }
        }
        IROpcode.arg => {
            backend.callArgs.push(generateValue(backend, instr.operand1))
            return ""
        }
        IROpcode.call => {
            var line = ""
            if instr.dest != -1 {
                line = "    r_" + orbit_itoa(instr.dest) + " = "
            } else {
                line = "    "
            }
            line = line + generateValue(backend, instr.operand1) + "("
            var i = 0
            while i < backend.callArgs.len() {
                line = line + backend.callArgs.get(i)
                if i < backend.callArgs.len() - 1 {
                    line = line + ", "
                }
                i = i + 1
            }
            line = line + ");\n"
            backend.callArgs = []
            return line
        }
        IROpcode.ret => {
            match instr.operand1 {
                IRValue.None => {
                    return "    return;\n"
                }
                IRValue.Register(v) => {
                    val rType = mapTypeToC(backend.currentFunction.registerTypes.get(v.value))
                    val retType = mapTypeToC(backend.currentFunction.returnType)
                    if retType != "orbit_int" && retType != "orbit_float" && retType != "orbit_bool" && retType != "void" {
                        if rType == "orbit_int" || rType == "orbit_bool" || (rType != "" && rType != "void" && rType.indexOf("*") == -1 && rType != "orbit_float") {
                            return "    return NULL;\n"
                        } else {
                            return "    return r_" + orbit_itoa(v.value) + ";\n"
                        }
                    } else {
                        return "    return r_" + orbit_itoa(v.value) + ";\n"
                    }
                }
                _ => {
                    val valStr = generateValue(backend, instr.operand1)
                    val retType = mapTypeToC(backend.currentFunction.returnType)
                    if retType != "orbit_int" && retType != "orbit_float" && retType != "orbit_bool" && retType != "void" {
                        if valStr.indexOf("TAG_") != -1 || valStr == "true" || valStr == "false" {
                            return "    return NULL;\n"
                        } else {
                            return "    return " + valStr + ";\n"
                        }
                    } else {
                        return "    return " + valStr + ";\n"
                    }
                }
            }
        }
        IROpcode.alloc => {
            var sizeVal = generateValue(backend, instr.operand1)
            if sizeVal == "" {
                sizeVal = "sizeof(void*)"
            }
            if instr.dest != -1 {
                return "    r_" + orbit_itoa(instr.dest) + " = orbit_arena_alloc(arena, " + sizeVal + ");\n"
            } else {
                return "    orbit_arena_alloc(arena, " + sizeVal + ");\n"
            }
        }
        IROpcode.free => {
            return "    /* free - arena managed */\n"
        }
        IROpcode.load_field => {
            return "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + "->" + generateValue(backend, instr.operand2) + ";\n"
        }
        IROpcode.store_field => {
            return "    " + generateValue(backend, instr.operand1) + "->" + generateValue(backend, instr.operand2) + " = " + generateValue(backend, instr.operand3) + ";\n"
        }
        IROpcode.list_create => {
            return "    { OrbitResult _lr = orbit_list_create(arena, sizeof(void*), " + generateValue(backend, instr.operand2) + "); r_" + orbit_itoa(instr.dest) + " = _lr.ok ? (OrbitList*)_lr.value : NULL; }\n"
        }
        IROpcode.list_push => {
            return "    orbit_list_push(" + generateValue(backend, instr.operand1) + ", &" + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.list_get => {
            return "    { OrbitResult _lr = orbit_list_get(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + "); r_" + orbit_itoa(instr.dest) + " = _lr.ok ? *(void**)_lr.value : NULL; }\n"
        }
        IROpcode.list_set => {
            return "    orbit_list_set(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ", " + generateValue(backend, instr.operand3) + ");\n"
        }
        IROpcode.list_len => {
            return "    r_" + orbit_itoa(instr.dest) + " = (orbit_int)orbit_list_len(" + generateValue(backend, instr.operand1) + ");\n"
        }
        IROpcode.list_pop => {
            return "    { OrbitResult _pr = orbit_list_pop(" + generateValue(backend, instr.operand1) + "); r_" + orbit_itoa(instr.dest) + " = _pr.ok ? *(void**)_pr.value : NULL; }\n"
        }
        IROpcode.map_create => {
            return "    r_" + orbit_itoa(instr.dest) + " = orbit_map_create(" + generateValue(backend, instr.operand1) + ");\n"
        }
        IROpcode.map_set => {
            return "    r_" + orbit_itoa(instr.dest) + " = orbit_map_set(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ", " + generateValue(backend, instr.operand3) + ");\n"
        }
        IROpcode.map_get => {
            return "    r_" + orbit_itoa(instr.dest) + " = orbit_map_get(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.map_has => {
            return "    r_" + orbit_itoa(instr.dest) + " = orbit_map_has(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.map_delete => {
            return "    r_" + orbit_itoa(instr.dest) + " = orbit_map_delete(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ");\n"
        }
        IROpcode.map_keys => {
            return "    r_" + orbit_itoa(instr.dest) + " = orbit_map_keys(" + generateValue(backend, instr.operand1) + ");\n"
        }
        IROpcode.result_ok => {
            return "    r_" + orbit_itoa(instr.dest) + " = orbit_result_ok(" + generateValue(backend, instr.operand1) + ");\n"
        }
        IROpcode.result_err => {
            match instr.operand2 {
                IRValue.None => {
                    return "    r_" + orbit_itoa(instr.dest) + " = orbit_result_err(" + generateValue(backend, instr.operand1) + ");\n"
                }
                _ => {
                    return "    r_" + orbit_itoa(instr.dest) + " = orbit_result_err(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ");\n"
                }
            }
        }
        IROpcode.result_unwrap => {
            return "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + ".value;\n"
        }
        IROpcode.result_is_ok => {
            return "    r_" + orbit_itoa(instr.dest) + " = " + generateValue(backend, instr.operand1) + ".ok;\n"
        }
        IROpcode.union_create => {
            return "    { struct { int tag; void* data; }* _u = (struct { int tag; void* data; }*)orbit_alloc(arena, 16); _u->tag = (int)(uintptr_t)(" + generateValue(backend, instr.operand1) + "); _u->data = (void*)(uintptr_t)(" + generateValue(backend, instr.operand2) + "); r_" + orbit_itoa(instr.dest) + " = _u; }\n"
        }
        IROpcode.union_get_tag => {
            return "    r_" + orbit_itoa(instr.dest) + " = ((struct { int tag; void* data; }*)(" + generateValue(backend, instr.operand1) + "))->tag;\n"
        }
        IROpcode.union_get_data => {
            return "    r_" + orbit_itoa(instr.dest) + " = ((struct { int tag; void* data; }*)(" + generateValue(backend, instr.operand1) + "))->data;\n"
        }
        IROpcode.switch_op => {
            val exprVal = generateValue(backend, instr.operand1)
            if exprVal != "" {
                return "    switch (" + exprVal + ") {\n"
            } else {
                return "    /* switch_op */\n"
            }
        }
        IROpcode.type_info => {
            return "    /* type_info */\n"
        }
        IROpcode.db_get => {
            val arg1 = generateValue(backend, instr.operand1)
            val arg2 = generateValue(backend, instr.operand2)
            var argsStr = arg1
            if arg2 != "" {
                argsStr = argsStr + ", " + arg2
            }
            if instr.dest != -1 {
                return "    r_" + orbit_itoa(instr.dest) + " = orbit_db_get(" + argsStr + ");\n"
            } else {
                return "    orbit_db_get(" + argsStr + ");\n"
            }
        }
        IROpcode.db_set => {
            val arg1 = generateValue(backend, instr.operand1)
            val arg2 = generateValue(backend, instr.operand2)
            val arg3 = generateValue(backend, instr.operand3)
            var argsStr = arg1
            if arg2 != "" {
                argsStr = argsStr + ", " + arg2
            }
            if arg3 != "" {
                argsStr = argsStr + ", " + arg3
            }
            if instr.dest != -1 {
                return "    r_" + orbit_itoa(instr.dest) + " = orbit_db_set(" + argsStr + ");\n"
            } else {
                return "    orbit_db_set(" + argsStr + ");\n"
            }
        }
        IROpcode.db_all => {
            val arg1 = generateValue(backend, instr.operand1)
            if instr.dest != -1 {
                return "    r_" + orbit_itoa(instr.dest) + " = orbit_db_all(" + arg1 + ");\n"
            } else {
                return "    orbit_db_all(" + arg1 + ");\n"
            }
        }
        IROpcode.db_where => {
            val arg1 = generateValue(backend, instr.operand1)
            val arg2 = generateValue(backend, instr.operand2)
            var argsStr = arg1
            if arg2 != "" {
                argsStr = argsStr + ", " + arg2
            }
            if instr.dest != -1 {
                return "    r_" + orbit_itoa(instr.dest) + " = orbit_db_where(" + argsStr + ");\n"
            } else {
                return "    orbit_db_where(" + argsStr + ");\n"
            }
        }
        IROpcode.http_response => {
            return "    ORBIT_API_RESPONSE(" + generateValue(backend, instr.operand1) + ", " + generateValue(backend, instr.operand2) + ", " + generateValue(backend, instr.operand3) + ");\n"
        }
        _ => {
            return "    /* Unknown opcode */\n"
        }
    }
}
