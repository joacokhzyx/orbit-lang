import "./ir.orb"
import "./route_runtime.orb"

model CBackend {
    module: IRModule
    output: string
    currentFunction: IRFunction
    callArgs: list
    strRegs: list
    strVars: list
    fieldNames: list
    fieldOwners: list
    declVars: list
    usedRegs: list
    refLabels: list
    defIdxFunc: IRFunction
    defIdxNames: list
    defIdxInsts: list
    defIdxRegInst: list
    defIdxRegVerdict: list
}

fn initCBackend(module: IRModule) -> CBackend {
    return CBackend(module, "", initIRFunction(""), [], [], [], [], [], [], [], [], initIRFunction(""), [], [], [], [])
}

fn listContainsStr(items: list, value: string) -> bool {
    if items == NULL { return false }
    var i = 0
    while i < items.len() {
        if items.get(i) == value { return true }
        i = i + 1
    }
    return false
}

fn generateC(backend: CBackend) -> string {
    var hasRoutes = moduleHasRoute(backend)
    var routeLimits = ""
    if hasRoutes {
        var rli = 0
        var hasAnyLimit = false
        while rli < backend.module.functions.len() {
            val rf: IRFunction = backend.module.functions.get(rli)
            if rf.routeMethod != "" && rf.routeHasLimit && rf.routeLimitRate > 0 {
                hasAnyLimit = true
            }
            rli = rli + 1
        }
        if hasAnyLimit {
            routeLimits = routeLimits + "#if ORBIT_KYNX_ACTIVE\n"
            routeLimits = routeLimits + "static void orbit_kynx_register_limits(void) {\n"
            rli = 0
            while rli < backend.module.functions.len() {
                val rf2: IRFunction = backend.module.functions.get(rli)
                if rf2.routeMethod != "" && rf2.routeHasLimit && rf2.routeLimitRate > 0 {
                    routeLimits = routeLimits + "    orbit_kynx_register_route_limit(\"" + rf2.routeMethod + "\", \"" + rf2.routePath + "\", " + orbit_int_to_string_selfhost(rf2.routeLimitRate) + ", " + orbit_int_to_string_selfhost(rf2.routeLimitWindowMs) + ", " + orbit_int_to_string_selfhost(rf2.routeLimitBurst) + ");\n"
                }
                rli = rli + 1
            }
            routeLimits = routeLimits + "}\n"
            routeLimits = routeLimits + "#endif\n"
        }
    }
    var i = 0
    val cbTop = orbit_cbuf_create_selfhost()
    orbit_cbuf_append_selfhost(cbTop, generateRoutePreamble(hasRoutes))
    orbit_cbuf_append_selfhost(cbTop, generateRouteTypeDecls(backend))
    if hasRoutes == false && moduleConstructsVariants(backend) {
        orbit_cbuf_append_selfhost(cbTop, "#ifndef AST_VARIANTS_DEFINED\n")
        orbit_cbuf_append_selfhost(cbTop, "#define AST_VARIANTS_DEFINED\n")
        orbit_cbuf_append_selfhost(cbTop, "typedef struct OrbitASTVariantNode { int tag; void* data; } OrbitASTVariantNode;\n")
        orbit_cbuf_append_selfhost(cbTop, "static inline OrbitASTVariantNode* orbit_create_variant(OrbitArena* a, int tag, void* data) {\n")
        orbit_cbuf_append_selfhost(cbTop, "    OrbitASTVariantNode* n = (OrbitASTVariantNode*)orbit_alloc(a, sizeof(OrbitASTVariantNode));\n")
        orbit_cbuf_append_selfhost(cbTop, "    n->tag = tag; n->data = data; return n;\n")
        orbit_cbuf_append_selfhost(cbTop, "}\n")
        // Variant constructor macros are generated from the module's union types.
        // They must use the very same <Type>_TAG_<Variant> constants that pattern
        // matching compares against (see the tag enum emitted further below and
        // builder.orb's Type.Variant lowering). These macros used to be hardcoded
        // for ASTNode only, with a 1-based numbering that skipped the payload-less
        // variants, so constructors and matches disagreed and no other union type
        // (IRValue, ...) got a constructor at all.
        // The `__VA_ARGS__ + 0` form accepts both payload variants, e.g. Literal(n),
        // and payload-less ones, e.g. Break(), which expands to a null payload.
        var mvi = 0
        while mvi < backend.module.types.len() {
            val mvType: IRTypeDecl = backend.module.types.get(mvi)
            if mvType.kind == "union_type" {
                var mvv = 0
                while mvv < mvType.variants.len() {
                    val mvName: string = mvType.variants.get(mvv)
                    orbit_cbuf_append_selfhost(cbTop, "#define " + mvName + "(...) orbit_create_variant(arena, " + mvType.name + "_TAG_" + mvName + ", (void*)(uintptr_t)(__VA_ARGS__ + 0))\n")
                    mvv = mvv + 1
                }
            }
            mvi = mvi + 1
        }
        orbit_cbuf_append_selfhost(cbTop, "#endif\n\n")
        orbit_cbuf_append_selfhost(cbTop, "static inline orbit_bool orbit_val_eq(void* a, void* b) {\n")
        orbit_cbuf_append_selfhost(cbTop, "    if (a == b) return true;\n")
        orbit_cbuf_append_selfhost(cbTop, "    if (!a || !b) return false;\n")
        orbit_cbuf_append_selfhost(cbTop, "    if ((uintptr_t)a < 65536 || (uintptr_t)b < 65536) return false;\n")
        orbit_cbuf_append_selfhost(cbTop, "    return strcmp((const char*)a, (const char*)b) == 0;\n")
        orbit_cbuf_append_selfhost(cbTop, "}\n\n")
    }
    var fo = 0
    while fo < backend.module.models.len() {
        val mDecl: IRModelDecl = backend.module.models.get(fo)
        var ffi = 0
        while ffi < mDecl.fields.len() {
            val fld: IRModelField = mDecl.fields.get(ffi)
            backend.fieldNames.push(fld.name)
            backend.fieldOwners.push(mDecl.name)
            ffi = ffi + 1
        }
        fo = fo + 1
    }
    // Forward declare function signatures
    i = 0
    while i < backend.module.functions.len() {
        val func: IRFunction = backend.module.functions.get(i)
        if func.isExtern == false {
            var fName2 = func.name
            var isMain2 = isMainFuncName(fName2)
            var isRoute2 = func.routeMethod != ""
            if isMain2 {
                fName2 = "orbit_main"
            }
            var isSkipped2 = false
            if fName2 == "orbit_main" && func.name != "main" && (moduleHasFunction(backend, "main") || hasRoutes) {
                isSkipped2 = true
            }
            if isSkipped2 == false {
                var retType2 = mapTypeToC(backend, func.returnType)
                if isMain2 {
                    retType2 = "int"
                }
                if isRoute2 {
                    retType2 = "OrbitResponse*"
                }
                fName2 = sanitizeIdentifier(fName2)
                var proto = ""
                var protoAttr = ""
                if isDualPathFunction(func) {
                    protoAttr = "__attribute__((hot)) "
                }
                if isRoute2 {
                    proto = proto + protoAttr + retType2 + " " + fName2 + "(OrbitArena* arena, OrbitRequest* req"
                } else if isMain2 {
                    proto = protoAttr + retType2 + " " + fName2 + "(OrbitArena* _init_arena"
                } else {
                    proto = protoAttr + "static " + retType2 + " " + fName2 + "("
                    if func.params.len() == 0 {
                        proto = proto + "void"
                    } else {
                        var pi2 = 0
                        while pi2 < func.params.len() {
                            proto = proto + mapTypeToC(backend, func.paramTypes.get(pi2)) + " " + func.params.get(pi2)
                            if pi2 < func.params.len() - 1 {
                                proto = proto + ", "
                            }
                            pi2 = pi2 + 1
                        }
                    }
                }
                orbit_cbuf_append_selfhost(cbTop, proto + ");\n")
            }
        }
        i = i + 1
    }
    if backend.module.functions.len() > 0 {
        orbit_cbuf_append_selfhost(cbTop, "\n")
    }
    i = 0
    while i < backend.module.functions.len() {
        val func: IRFunction = backend.module.functions.get(i)
        if func.isExtern == false {
            var fName3 = func.name
            var isMain3 = false
            if fName3 == "main" || fName3 == "orbit_main" || fName3 == "main_main" {
                isMain3 = true
            } else {
                val fLen3 = orbit_string_len(fName3)
                if fLen3 > 5 {
                    val tail3 = orbit_string_slice(fName3, fLen3 - 5, fLen3)
                    if tail3 == "_main" { isMain3 = true }
                }
            }
            if isMain3 {
                fName3 = "orbit_main"
            }
            var isSkipped3 = false
            if fName3 == "orbit_main" && func.name != "main" && (moduleHasFunction(backend, "main") || hasRoutes) {
                isSkipped3 = true
            }
            if isSkipped3 == false {
                orbit_cbuf_append_selfhost(cbTop, generateFunction(backend, func))
            }
        }
        i = i + 1
    }
    orbit_cbuf_append_selfhost(cbTop, generateRouterBlock(backend))
    if routeLimits != "" {
        orbit_cbuf_append_selfhost(cbTop, routeLimits)
    }
    if moduleHasFunction(backend, "main") == false {
        orbit_cbuf_append_selfhost(cbTop, "int orbit_main(OrbitArena* _init_arena) {\n")
        orbit_cbuf_append_selfhost(cbTop, "    (void)_init_arena;\n")
        orbit_cbuf_append_selfhost(cbTop, "    return 0;\n")
        orbit_cbuf_append_selfhost(cbTop, "}\n")
    }
    if hasRoutes {
        orbit_cbuf_append_selfhost(cbTop, generateServerMain(backend))
    } else {
        orbit_cbuf_append_selfhost(cbTop, "extern char** _orbit_argv;\n")
        orbit_cbuf_append_selfhost(cbTop, "extern int _orbit_argc;\n\n")
        orbit_cbuf_append_selfhost(cbTop, "int main(int argc, char* argv[]) {\n")
        orbit_cbuf_append_selfhost(cbTop, "    _orbit_argv = argv;\n")
        orbit_cbuf_append_selfhost(cbTop, "    _orbit_argc = argc;\n")
        orbit_cbuf_append_selfhost(cbTop, "    \n")
        orbit_cbuf_append_selfhost(cbTop, "    orbit_string_pool_init(2048);\n")
        orbit_cbuf_append_selfhost(cbTop, "    OrbitArena* arena = orbit_arena_create(131072);\n")
        orbit_cbuf_append_selfhost(cbTop, "\n")
        orbit_cbuf_append_selfhost(cbTop, "    int _orbit_exit_code = orbit_main(arena);\n")
        orbit_cbuf_append_selfhost(cbTop, "\n")
        orbit_cbuf_append_selfhost(cbTop, "    orbit_arena_destroy(arena);\n")
        orbit_cbuf_append_selfhost(cbTop, "    orbit_string_pool_cleanup();\n")
        orbit_cbuf_append_selfhost(cbTop, "    \n")
        orbit_cbuf_append_selfhost(cbTop, "    return _orbit_exit_code;\n")
        orbit_cbuf_append_selfhost(cbTop, "}\n")
    }
    return orbit_cbuf_build_selfhost(cbTop)
}

fn isEnumType(backend: CBackend, typeName: string) -> bool {
    if typeName == "TokType" || typeName == "TokTypeTag" { return true }
    if backend == NULL { return false }
    if backend.module == NULL { return false }
    if backend.module.types == NULL { return false }
    var ti = 0
    while ti < backend.module.types.len() {
        val tDecl: IRTypeDecl = backend.module.types.get(ti)
        if tDecl.name == typeName && (tDecl.kind == "enumeration" || tDecl.kind == "sum" || tDecl.kind == "union") {
            return true
        }
        ti = ti + 1
    }
    return false
}

fn getEnumNameFromTag(s: string) -> string {
    val idx = s.indexOf("_TAG_")
    if idx != -1 && idx > 0 {
        return s.slice(0, idx)
    }
    val idx2 = s.indexOf("TAG_")
    if idx2 != -1 && idx2 > 0 {
        return s.slice(0, idx2 - 1)
    }
    return "orbit_int"
}

fn mapTypeToC(backend: CBackend, orbitType: string) -> string {
    if orbitType == "NULL" || orbitType == "null" { return "void*" }
    if orbitType == "int" || orbitType == "orbit_int" { return "orbit_int" }
    if orbitType == "float" || orbitType == "orbit_float" { return "orbit_float" }
    if orbitType == "string" || orbitType == "orbit_string" { return "orbit_string" }
    if orbitType == "bool" || orbitType == "orbit_bool" { return "orbit_bool" }
    if orbitType == "void" { return "void" }
    if orbitType == "list" || orbitType == "List" || orbitType == "OrbitList*" { return "OrbitList*" }
    if orbitType == "map" || orbitType == "Map" || orbitType == "OrbitMap*" { return "OrbitMap*" }
    if orbitType == "result" || orbitType == "Result" || orbitType == "OrbitResult" { return "OrbitResult" }
    if orbitType == "response" || orbitType == "Response" || orbitType == "OrbitResponse*" { return "OrbitResponse*" }
    if isEnumType(backend, orbitType) { return orbitType }
    if orbitType.indexOf("_TAG_") != -1 || orbitType.indexOf("TAG_") != -1 {
        val en = getEnumNameFromTag(orbitType)
        if en != "orbit_int" { return en }
        return "orbit_int"
    }
    val otLen = orbit_string_len(orbitType)
    if otLen > 0 && orbit_string_slice(orbitType, otLen - 1, otLen) == "*" {
        val base = orbit_string_slice(orbitType, 0, otLen - 1)
        val blen = orbit_string_len(base)
        if blen > 0 {
            val bfc = base.at(0)
            if bfc >= 65 && bfc <= 90 {
                return sanitizeIdentifier(base) + "*"
            }
        }
        return orbitType
    }
    if otLen > 0 {
        val fc = orbitType.at(0)
        if fc >= 65 && fc <= 90 {
            return sanitizeIdentifier(orbitType) + "*"
        }
    }
    return "void*"
}

fn setStrAt(items: list, idx: int, value: string) -> list {
    if items == NULL || idx < 0 { return items }
    while items.len() <= idx {
        items.push("unknown")
    }
    items[idx] = value
    return items
}

fn inferRegisterTypes(backend: CBackend, func: IRFunction) {
    if backend == NULL || func == NULL { return }
    var maxReg = func.registerCount
    var rpi = 0
    while rpi < func.instructions.len() {
        val rinst: IRInstruction = func.instructions.get(rpi)
        if rinst != NULL {
            if rinst.dest >= maxReg {
                maxReg = rinst.dest + 1
            }
        }
        rpi = rpi + 1
    }
    while func.registerTypes.len() < maxReg {
        func.registerTypes.push("unknown")
    }
    var pass = 0
    while pass < 3 {
        var pi = 0
        while pi < func.instructions.len() {
            val inst: IRInstruction = func.instructions.get(pi)
            if inst != NULL {
                match inst.opcode {
                    IROpcode.decl_var => {
                        var vn = ""
                        match inst.operand1 {
                            IRValue.Sym(s) => { vn = s.value }
                            IRValue.String(s) => { vn = s.value }
                            _ => {}
                        }
                        if vn != "" {
                            if isStringOperand(backend, inst.operand2) {
                                backend.strVars.push(vn)
                            }
                            var isStrVar = isStringVar(backend, vn)
                            if isStrVar == false {
                                var pIdx = 0
                                while pIdx < func.params.len() {
                                    if func.params.get(pIdx) == vn && func.paramTypes.get(pIdx) == "string" {
                                        isStrVar = true
                                    }
                                    pIdx = pIdx + 1
                                }
                            }
                            if isStrVar {
                                match inst.operand2 {
                                    IRValue.Register(reg) => {
                                        if reg.value >= 0 && reg.value < func.registerTypes.len() {
                                            func.registerTypes = setStrAt(func.registerTypes, reg.value, "string")
                                        }
                                    }
                                    _ => {}
                                }
                            }
                        }
                    }
                    IROpcode.store_var => {
                        var vn = ""
                        match inst.operand1 {
                            IRValue.Sym(s) => { vn = s.value }
                            IRValue.String(s) => { vn = s.value }
                            _ => {}
                        }
                        if vn != "" {
                            if isStringOperand(backend, inst.operand2) {
                                backend.strVars.push(vn)
                            }
                            if isStringVar(backend, vn) {
                                match inst.operand2 {
                                    IRValue.Register(reg) => {
                                        if reg.value >= 0 && reg.value < func.registerTypes.len() {
                                            func.registerTypes = setStrAt(func.registerTypes, reg.value, "string")
                                        }
                                    }
                                    _ => {}
                                }
                            }
                        }
                    }
                    _ => {}
                }
            }
            if inst != NULL && inst.dest >= 0 && inst.dest < func.registerTypes.len() {
                val cur = func.registerTypes.get(inst.dest)
                if cur == "unknown" || cur == "void" || cur == "" || cur == "void*" {
                    var inf = ""
                    match inst.opcode {
                        IROpcode.load_const => {
                            match inst.operand1 {
                                IRValue.Int(v) => { inf = "int" }
                                IRValue.Float(v) => { inf = "float" }
                                IRValue.String(v) => {
                                    if v.value.indexOf("TAG_") != -1 { inf = getEnumNameFromTag(v.value) }
                                    else { inf = "string" }
                                }
                                IRValue.Bool(v) => { inf = "bool" }
                                IRValue.Sym(s) => {
                                    if s.value.indexOf("TAG_") != -1 { inf = getEnumNameFromTag(s.value) }
                                    else if s.value == "true" || s.value == "false" { inf = "bool" }
                                }
                                _ => {}
                            }
                        }
                        IROpcode.load_var => {
                            var vn = ""
                            match inst.operand1 {
                                IRValue.Sym(s) => { vn = s.value }
                                IRValue.String(s) => { vn = s.value }
                                _ => {}
                            }
                            if vn != "" {
                                if vn.indexOf("TAG_") != -1 {
                                    inf = getEnumNameFromTag(vn)
                                } else {
                                    var p = 0
                                    while p < func.params.len() {
                                        if func.params.get(p) == vn {
                                            inf = func.paramTypes.get(p)
                                        }
                                        p = p + 1
                                    }
                                    if inf == "" {
                                        inf = variableDefType(backend, func, vn)
                                    }
                                    if inf == "" && isStringVar(backend, vn) {
                                        inf = "string"
                                    }
                                }
                            }
                        }
                        IROpcode.add => {
                            if isStringOperand(backend, inst.operand1) || isStringOperand(backend, inst.operand2) {
                                inf = "string"
                            } else {
                                inf = "int"
                            }
                        }
                        IROpcode.sub => { inf = "int" }
                        IROpcode.mul => { inf = "int" }
                        IROpcode.div => { inf = "int" }
                        IROpcode.mod => { inf = "int" }
                        IROpcode.neg => { inf = "int" }
                        IROpcode.eq => { inf = "bool" }
                        IROpcode.ne => { inf = "bool" }
                        IROpcode.lt => { inf = "bool" }
                        IROpcode.le => { inf = "bool" }
                        IROpcode.gt => { inf = "bool" }
                        IROpcode.ge => { inf = "bool" }
                        IROpcode.and_op => { inf = "bool" }
                        IROpcode.or_op => { inf = "bool" }
                        IROpcode.not_op => { inf = "bool" }
                        IROpcode.result_is_ok => { inf = "bool" }
                        IROpcode.result_unwrap_err => { inf = "string" }
                        IROpcode.map_has => { inf = "bool" }
                        IROpcode.copy => {
                            match inst.operand1 {
                                IRValue.Register(v) => {
                                    if v.value >= 0 && v.value < func.registerTypes.len() {
                                        val srcT = func.registerTypes.get(v.value)
                                        if srcT != "unknown" && srcT != "void" && srcT != "" {
                                            inf = srcT
                                        }
                                    }
                                }
                                IRValue.Sym(s) => {
                                    if s.value.indexOf("TAG_") != -1 { inf = getEnumNameFromTag(s.value) }
                                    else if s.value == "true" || s.value == "false" { inf = "bool" }
                                    else {
                                        var p = 0
                                        while p < func.params.len() {
                                            if func.params.get(p) == s.value {
                                                inf = func.paramTypes.get(p)
                                            }
                                            p = p + 1
                                        }
                                    }
                                }
                                IRValue.String(s) => {
                                    if s.value.indexOf("TAG_") != -1 { inf = getEnumNameFromTag(s.value) }
                                    else { inf = "string" }
                                }
                                IRValue.Int(v) => { inf = "int" }
                                IRValue.Bool(v) => { inf = "bool" }
                                _ => {}
                            }
                        }
                        IROpcode.arg => {
                            match inst.operand1 {
                                IRValue.Int(m) => {
                                    if m.value < func.params.len() {
                                        inf = func.paramTypes.get(m.value)
                                    }
                                }
                                _ => {}
                            }
                        }
                        IROpcode.call => {
                            var cn = ""
                            match inst.operand1 {
                                IRValue.String(s) => { cn = s.value }
                                IRValue.Sym(s) => { cn = s.value }
                                _ => {}
                            }
                            if isStringReturningFunction(cn) {
                                inf = "string"
                            } else if cn == "orbit_string_at" || cn == "orbit_string_len" || cn == "orbit_list_len" {
                                inf = "int"
                            } else if cn == "orbit_val_eq" {
                                inf = "bool"
                            } else if cn == "orbit_list_create" || cn == "orbit_string_split" || cn == "orbit_map_keys" {
                                inf = "list"
                            } else if cn == "orbit_map_create" {
                                inf = "map"
                            } else {
                                if backend != NULL && backend.module != NULL && backend.module.functions != NULL {
                                    var fi = 0
                                    while fi < backend.module.functions.len() {
                                        val f: IRFunction = backend.module.functions.get(fi)
                                        if f.name == cn {
                                            inf = f.returnType
                                        }
                                        fi = fi + 1
                                    }
                                }
                            }
                        }
                        IROpcode.load_field => {
                            var fnm = ""
                            match inst.operand2 {
                                IRValue.String(s) => { fnm = s.value }
                                IRValue.Sym(s) => { fnm = s.value }
                                _ => {}
                            }
                            fnm = fieldRefName(fnm)
                            if backend != NULL && backend.module != NULL && backend.module.models != NULL {
                                var mi = 0
                                while mi < backend.module.models.len() {
                                    val m: IRModelDecl = backend.module.models.get(mi)
                                    var fi = 0
                                    while fi < m.fields.len() {
                                        val fld: IRModelField = m.fields.get(fi)
                                        if fld.name == fnm {
                                            inf = fld.typeName
                                        }
                                        fi = fi + 1
                                    }
                                    mi = mi + 1
                                }
                            }
                        }
                        IROpcode.list_create => { inf = "list" }
                        IROpcode.list_get => {
                            match inst.operand1 {
                                IRValue.Register(reg) => {
                                    if reg.value >= 0 && reg.value < func.registerTypes.len() {
                                        val lstT = func.registerTypes.get(reg.value)
                                        if lstT == "string" || lstT == "string_list" {
                                            inf = "string"
                                        }
                                    }
                                }
                                IRValue.Sym(s) => {
                                    if isStringVar(backend, s.value) { inf = "string" }
                                }
                                _ => {}
                            }
                        }
                        IROpcode.list_push => {
                            if isStringOperand(backend, inst.operand2) {
                                match inst.operand1 {
                                    IRValue.Register(reg) => {
                                        if reg.value >= 0 && reg.value < func.registerTypes.len() {
                                            func.registerTypes = setStrAt(func.registerTypes, reg.value, "string_list")
                                        }
                                    }
                                    IRValue.Sym(s) => {
                                        backend.strVars.push(s.value)
                                    }
                                    _ => {}
                                }
                            }
                        }
                        IROpcode.list_len => { inf = "int" }
                        IROpcode.map_create => { inf = "map" }
                        IROpcode.map_keys => { inf = "list" }
                        IROpcode.union_get_tag => {
                            match inst.operand2 {
                                IRValue.Sym(s) => { inf = getEnumNameFromTag(s.value) }
                                IRValue.String(s) => { inf = getEnumNameFromTag(s.value) }
                                _ => {
                                    match inst.operand1 {
                                        IRValue.Register(reg) => {
                                            if reg.value >= 0 && reg.value < func.registerTypes.len() {
                                                val objT = func.registerTypes.get(reg.value)
                                                if objT != "unknown" && objT != "" && objT != "void*" {
                                                    inf = objT + "Tag"
                                                }
                                            }
                                        }
                                        _ => {}
                                    }
                                }
                            }
                            if inf == "" || inf == "orbit_int" { inf = "TokType" }
                        }
                        _ => {}
                    }
                    if inf != "" && inf != "unknown" && inf != "void" {
                        func.registerTypes = setStrAt(func.registerTypes, inst.dest, inf)
                    }
                }
                // Forward/backward register string-type propagation
                // (decl_var/store_var handled at top of loop, before the
                // dest >= 0 guard, because those opcodes carry dest == -1)
                match inst.opcode {
                    IROpcode.eq => {
                        if isStringOperand(backend, inst.operand1) {
                            match inst.operand2 {
                                IRValue.Register(reg) => {
                                    if regKnownScalar(func, reg.value) == false && reg.value >= 0 && reg.value < func.registerTypes.len() {
                                        func.registerTypes = setStrAt(func.registerTypes, reg.value, "string")
                                    }
                                }
                                _ => {}
                            }
                        } else if isStringOperand(backend, inst.operand2) {
                            match inst.operand1 {
                                IRValue.Register(reg) => {
                                    if regKnownScalar(func, reg.value) == false && reg.value >= 0 && reg.value < func.registerTypes.len() {
                                        func.registerTypes = setStrAt(func.registerTypes, reg.value, "string")
                                    }
                                }
                                _ => {}
                            }
                        }
                    }
                    IROpcode.ne => {
                        if isStringOperand(backend, inst.operand1) {
                            match inst.operand2 {
                                IRValue.Register(reg) => {
                                    if regKnownScalar(func, reg.value) == false && reg.value >= 0 && reg.value < func.registerTypes.len() {
                                        func.registerTypes = setStrAt(func.registerTypes, reg.value, "string")
                                    }
                                }
                                _ => {}
                            }
                        } else if isStringOperand(backend, inst.operand2) {
                            match inst.operand1 {
                                IRValue.Register(reg) => {
                                    if regKnownScalar(func, reg.value) == false && reg.value >= 0 && reg.value < func.registerTypes.len() {
                                        func.registerTypes = setStrAt(func.registerTypes, reg.value, "string")
                                    }
                                }
                                _ => {}
                            }
                        }
                    }
                    IROpcode.add => {
                        if isStringOperand(backend, inst.operand1) {
                            match inst.operand2 {
                                IRValue.Register(reg) => {
                                    val opT = registerVarDefType(backend, func, reg.value)
                                    if regKnownScalar(func, reg.value) == false && opT != "int" && opT != "float" && opT != "bool" && opT != "void" {
                                        if reg.value >= 0 && reg.value < func.registerTypes.len() {
                                            func.registerTypes = setStrAt(func.registerTypes, reg.value, "string")
                                        }
                                    }
                                }
                                _ => {}
                            }
                        } else if isStringOperand(backend, inst.operand2) {
                            match inst.operand1 {
                                IRValue.Register(reg) => {
                                    val opT = registerVarDefType(backend, func, reg.value)
                                    if regKnownScalar(func, reg.value) == false && opT != "int" && opT != "float" && opT != "bool" && opT != "void" {
                                        if reg.value >= 0 && reg.value < func.registerTypes.len() {
                                            func.registerTypes = setStrAt(func.registerTypes, reg.value, "string")
                                        }
                                    }
                                }
                                _ => {}
                            }
                        }
                    }
                    _ => {}
                }
            }
            pi = pi + 1
        }
        var fpi = 0
        while fpi < func.instructions.len() {
            val fInst: IRInstruction = func.instructions.get(fpi)
            if fInst != NULL && fInst.dest >= 0 && fInst.dest < func.registerTypes.len() {
                match fInst.opcode {
                    IROpcode.add => {
                        if operandDefType(func, fInst.operand1) == "float" || operandDefType(func, fInst.operand2) == "float" {
                            func.registerTypes = setStrAt(func.registerTypes, fInst.dest, "float")
                        }
                    }
                    IROpcode.sub => {
                        if operandDefType(func, fInst.operand1) == "float" || operandDefType(func, fInst.operand2) == "float" {
                            func.registerTypes = setStrAt(func.registerTypes, fInst.dest, "float")
                        }
                    }
                    IROpcode.mul => {
                        if operandDefType(func, fInst.operand1) == "float" || operandDefType(func, fInst.operand2) == "float" {
                            func.registerTypes = setStrAt(func.registerTypes, fInst.dest, "float")
                        }
                    }
                    IROpcode.div => {
                        if operandDefType(func, fInst.operand1) == "float" || operandDefType(func, fInst.operand2) == "float" {
                            func.registerTypes = setStrAt(func.registerTypes, fInst.dest, "float")
                        }
                    }
                    IROpcode.neg => {
                        if operandDefType(func, fInst.operand1) == "float" {
                            func.registerTypes = setStrAt(func.registerTypes, fInst.dest, "float")
                        }
                    }
                    IROpcode.load_var => {
                        var fvn = ""
                        match fInst.operand1 {
                            IRValue.Sym(s) => { fvn = s.value }
                            IRValue.String(s) => { fvn = s.value }
                            _ => {}
                        }
                        if fvn != "" {
                            val fvType = variableDefType(backend, func, fvn)
                            if fvType == "float" || fvType == "orbit_float" {
                                func.registerTypes = setStrAt(func.registerTypes, fInst.dest, "float")
                            }
                        }
                    }
                    _ => {}
                }
            }
            fpi = fpi + 1
        }
        pass = pass + 1
    }
}

fn isCKeyword(name: string) -> bool {
    if name == "auto" { return true }
    if name == "break" { return true }
    if name == "case" { return true }
    if name == "char" { return true }
    if name == "const" { return true }
    if name == "continue" { return true }
    if name == "default" { return true }
    if name == "do" { return true }
    if name == "double" { return true }
    if name == "else" { return true }
    if name == "enum" { return true }
    if name == "extern" { return true }
    if name == "float" { return true }
    if name == "for" { return true }
    if name == "goto" { return true }
    if name == "if" { return true }
    if name == "inline" { return true }
    if name == "int" { return true }
    if name == "long" { return true }
    if name == "register" { return true }
    if name == "restrict" { return true }
    if name == "return" { return true }
    if name == "short" { return true }
    if name == "signed" { return true }
    if name == "sizeof" { return true }
    if name == "static" { return true }
    if name == "struct" { return true }
    if name == "switch" { return true }
    if name == "typedef" { return true }
    if name == "union" { return true }
    if name == "unsigned" { return true }
    if name == "void" { return true }
    if name == "volatile" { return true }
    if name == "while" { return true }
    return false
}

fn sanitizeIdentifier(name: string) -> string {
    var out = ""
    var i = 0
    val len = orbit_string_len(name)
    while i < len {
        val ch = name.at(i)
        if (ch >= 48 && ch <= 57) || (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) {
            out = out + name.slice(i, i + 1)
        } else {
            out = out + "_"
        }
        i = i + 1
    }
    if len > 0 {
        val first = name.at(0)
        if first >= 48 && first <= 57 {
            out = "_" + out
        }
    }
    if isCKeyword(out) {
        return out + "_"
    }
    return out
}

fn isMainFuncName(name: string) -> bool {
    if name == "main" { return true }
    if name == "orbit_main" { return true }
    if name == "main_main" { return true }
    val len = orbit_string_len(name)
    if len > 5 {
        if orbit_string_slice(name, len - 5, len) == "_main" { return true }
    }
    return false
}

fn isDualPathFunction(func: IRFunction) -> bool {
    if func == NULL { return false }
    if func.instructions.len() > 200 { return false }
    if func.instructions.len() < 4 { return false }
    var di = 0
    while di < func.instructions.len() {
        val dInstr: IRInstruction = func.instructions.get(di)
        match dInstr.opcode {
            IROpcode.load_field => { return true }
            IROpcode.store_field => { return true }
            IROpcode.list_get => { return true }
            IROpcode.map_get => { return true }
            IROpcode.map_set => { return true }
            _ => {}
        }
        di = di + 1
    }
    return false
}

fn moduleHasRoute(backend: CBackend) -> bool {
    var i = 0
    while i < backend.module.functions.len() {
        val f: IRFunction = backend.module.functions.get(i)
        if f.routeMethod != "" {
            return true
        }
        i = i + 1
    }
    return false
}

fn isUnionVariantName(backend: CBackend, name: string) -> bool {
    var ti = 0
    while ti < backend.module.types.len() {
        val tDecl: IRTypeDecl = backend.module.types.get(ti)
        if tDecl.kind == "union_type" {
            var vi = 0
            while vi < tDecl.variants.len() {
                val vName: string = tDecl.variants.get(vi)
                if vName == name {
                    return true
                }
                vi = vi + 1
            }
        }
        ti = ti + 1
    }
    return false
}

fn moduleConstructsVariants(backend: CBackend) -> bool {
    var fi = 0
    while fi < backend.module.functions.len() {
        val f: IRFunction = backend.module.functions.get(fi)
        var ii = 0
        while ii < f.instructions.len() {
            val instr: IRInstruction = f.instructions.get(ii)
            var isCall = false
            match instr.opcode {
                IROpcode.call => { isCall = true }
                _ => {}
            }
            if isCall {
                var calleeName = ""
                match instr.operand1 {
                    IRValue.String(s) => { calleeName = s.value }
                    IRValue.Sym(s) => { calleeName = s.value }
                    _ => {}
                }
                if isUnionVariantName(backend, calleeName) {
                    return true
                }
            }
            ii = ii + 1
        }
        fi = fi + 1
    }
    return false
}

fn isModelCtorName(backend: CBackend, name: string) -> bool {
    var i = 0
    while i < backend.module.models.len() {
        val mDecl: IRModelDecl = backend.module.models.get(i)
        if mDecl.name == name {
            return true
        }
        i = i + 1
    }
    return false
}

// Declared field type of a model constructor's positional argument,
// or "" when unknown. The creator was generated from these same
// declarations, so casting to them always matches its signature.
fn modelCtorFieldType(backend: CBackend, name: string, argIdx: int) -> string {
    var i = 0
    while i < backend.module.models.len() {
        val mDecl: IRModelDecl = backend.module.models.get(i)
        if mDecl.name == name {
            if argIdx >= 0 && argIdx < mDecl.fields.len() {
                val mf: IRModelField = mDecl.fields.get(argIdx)
                return mf.typeName
            }
            return ""
        }
        i = i + 1
    }
    return ""
}

fn xor16(a: int, b: int) -> int {
    var r = 0
    var p = 1
    var k = 0
    while k < 16 {
        val abit = (a / p) % 2
        val bbit = (b / p) % 2
        val xb = (abit + bbit) % 2
        r = r + xb * p
        p = p * 2
        k = k + 1
    }
    return r
}

fn fnv1a64Hash(method: string, path: string) -> string {
    var h3 = 52210
    var h2 = 40164
    var h1 = 33826
    var h0 = 8997
    val ml = orbit_string_len(method)
    var mi = 0
    while mi < ml {
        val b = method.at(mi)
        h0 = xor16(h0, b)
        val t0 = h0 * 435
        val r0 = t0 % 65536
        var carry = t0 / 65536
        val t1 = h1 * 435 + carry
        val r1 = t1 % 65536
        carry = t1 / 65536
        val t2 = h2 * 435 + carry
        val r2 = t2 % 65536
        carry = t2 / 65536
        val t3 = h3 * 435 + carry
        val r3 = t3 % 65536
        val c0 = (h0 * 256) % 65536
        val c1 = h0 / 256
        val c2 = (h1 * 256) % 65536 + c1
        val nh2 = (r2 + c0) % 65536
        val carry2 = (r2 + c0) / 65536
        val nh3 = (r3 + c2 + carry2) % 65536
        h3 = nh3
        h2 = nh2
        h1 = r1
        h0 = r0
        mi = mi + 1
    }
    h0 = xor16(h0, 58)
    val t0 = h0 * 435
    val r0 = t0 % 65536
    var carry = t0 / 65536
    val t1 = h1 * 435 + carry
    val r1 = t1 % 65536
    carry = t1 / 65536
    val t2 = h2 * 435 + carry
    val r2 = t2 % 65536
    carry = t2 / 65536
    val t3 = h3 * 435 + carry
    val r3 = t3 % 65536
    val c0 = (h0 * 256) % 65536
    val c1 = h0 / 256
    val c2 = (h1 * 256) % 65536 + c1
    val nh2 = (r2 + c0) % 65536
    val carry2 = (r2 + c0) / 65536
    val nh3 = (r3 + c2 + carry2) % 65536
    h3 = nh3
    h2 = nh2
    h1 = r1
    h0 = r0
    val pl = orbit_string_len(path)
    var pi = 0
    while pi < pl {
        val b = path.at(pi)
        h0 = xor16(h0, b)
        val t0 = h0 * 435
        val r0 = t0 % 65536
        var carry = t0 / 65536
        val t1 = h1 * 435 + carry
        val r1 = t1 % 65536
        carry = t1 / 65536
        val t2 = h2 * 435 + carry
        val r2 = t2 % 65536
        carry = t2 / 65536
        val t3 = h3 * 435 + carry
        val r3 = t3 % 65536
        val c0 = (h0 * 256) % 65536
        val c1 = h0 / 256
        val c2 = (h1 * 256) % 65536 + c1
        val nh2 = (r2 + c0) % 65536
        val carry2 = (r2 + c0) / 65536
        val nh3 = (r3 + c2 + carry2) % 65536
        h3 = nh3
        h2 = nh2
        h1 = r1
        h0 = r0
        pi = pi + 1
    }
    var rev = ""
    val digits9 = "0123456789"
    var keepGoing = true
    while keepGoing {
        var rem = 0
        val d3 = rem * 65536 + h3
        h3 = d3 / 10
        rem = d3 % 10
        val d2 = rem * 65536 + h2
        h2 = d2 / 10
        rem = d2 % 10
        val d1 = rem * 65536 + h1
        h1 = d1 / 10
        rem = d1 % 10
        val d0 = rem * 65536 + h0
        h0 = d0 / 10
        rem = d0 % 10
        rev = rev + digits9.slice(rem, rem + 1)
        if h3 == 0 && h2 == 0 && h1 == 0 && h0 == 0 {
            keepGoing = false
        }
    }
    var dec = ""
    var revIdx = orbit_string_len(rev)
    while revIdx > 0 {
        revIdx = revIdx - 1
        dec = dec + rev.slice(revIdx, revIdx + 1)
    }
    return dec
}

fn generateRoutePreamble(hasRoutes: bool) -> string {
    return routePreambleText(hasRoutes)
}

fn generateRouteTypeDecls(backend: CBackend) -> string {
    var out = ""
    // Forward declare model typedefs
    var mi = 0
    while mi < backend.module.models.len() {
        val modelDecl: IRModelDecl = backend.module.models.get(mi)
        val mFwd = sanitizeIdentifier(modelDecl.name)
        out = out + "typedef struct " + mFwd + " " + mFwd + ";\n"
        mi = mi + 1
    }
    // Forward declare union typedefs
    var ui = 0
    while ui < backend.module.types.len() {
        val tDecl: IRTypeDecl = backend.module.types.get(ui)
        if tDecl.kind == "union_type" {
            out = out + "typedef struct " + tDecl.name + " " + tDecl.name + ";\n"
        }
        ui = ui + 1
    }
    out = out + "\n"
    // Emit enums, unions and aliases in module order
    var ti = 0
    while ti < backend.module.types.len() {
        val tDecl: IRTypeDecl = backend.module.types.get(ti)
        if tDecl.kind == "enumeration" {
            out = out + "typedef enum {\n"
            var vi = 0
            while vi < tDecl.variants.len() {
                val vName: string = tDecl.variants.get(vi)
                out = out + "    " + tDecl.name + "_TAG_" + vName + " = " + orbit_int_to_string_selfhost(vi)
                if vi + 1 < tDecl.variants.len() {
                    out = out + ",\n"
                } else {
                    out = out + "\n"
                }
                vi = vi + 1
            }
            out = out + "} " + tDecl.name + ";\n"
            out = out + "#define " + tDecl.name + "_COUNT " + orbit_int_to_string_selfhost(tDecl.variants.len()) + "\n\n"
        } else if tDecl.kind == "union_type" {
            out = out + "typedef enum {\n"
            var vi = 0
            while vi < tDecl.variants.len() {
                val vName: string = tDecl.variants.get(vi)
                out = out + "    " + tDecl.name + "_TAG_" + vName + " = " + orbit_int_to_string_selfhost(vi)
                if vi + 1 < tDecl.variants.len() {
                    out = out + ",\n"
                } else {
                    out = out + "\n"
                }
                vi = vi + 1
            }
            out = out + "} " + tDecl.name + "_Tag;\n\n"
            out = out + "typedef struct " + tDecl.name + " {\n"
            out = out + "    " + tDecl.name + "_Tag tag;\n"
            out = out + "    union {\n"
            out = out + "        void* data;\n"
            vi = 0
            while vi < tDecl.variants.len() {
                val vName: string = tDecl.variants.get(vi)
                val payload: string = tDecl.richVariants.get(vi)
                if payload != "" {
                    out = out + "        " + mapTypeToC(backend, payload) + " " + vName + ";\n"
                } else {
                    out = out + "        int " + vName + "; /* unit variant */\n"
                }
                vi = vi + 1
            }
            out = out + "    } data;\n"
            out = out + "} " + tDecl.name + ";\n"
            out = out + "#define " + tDecl.name + "_COUNT " + orbit_int_to_string_selfhost(tDecl.variants.len()) + "\n\n"
        } else if tDecl.kind == "alias" {
            out = out + "typedef void* " + tDecl.name + ";\n\n"
        }
        ti = ti + 1
    }
    // Emit model struct definitions and constructors
    mi = 0
    while mi < backend.module.models.len() {
        val modelDecl: IRModelDecl = backend.module.models.get(mi)
        val mName = sanitizeIdentifier(modelDecl.name)
        out = out + "typedef struct " + mName + " {\n"
        var fi = 0
        while fi < modelDecl.fields.len() {
            val field: IRModelField = modelDecl.fields.get(fi)
            val cType = mapTypeToC(backend, field.typeName)
            val sField = sanitizeIdentifier(field.name)
            out = out + "    " + cType + " " + sField + ";\n"
            fi = fi + 1
        }
        out = out + "} " + mName + ";\n"
        if modelDecl.fields.len() == 0 {
            out = out + "#define " + mName + "() (" + mName + "*)orbit_model_" + mName + "_create(arena)\n"
            out = out + "static inline " + mName + "* orbit_model_" + mName + "_create(OrbitArena* a) {\n"
        } else {
            out = out + "#define " + mName + "(...) (" + mName + "*)orbit_model_" + mName + "_create(arena, __VA_ARGS__)\n"
            out = out + "static inline " + mName + "* orbit_model_" + mName + "_create(OrbitArena* a"
            fi = 0
            while fi < modelDecl.fields.len() {
                val field: IRModelField = modelDecl.fields.get(fi)
                val cType = mapTypeToC(backend, field.typeName)
                val sField = sanitizeIdentifier(field.name)
                out = out + ", " + cType + " " + sField
                fi = fi + 1
            }
            out = out + ") {\n"
        }
        out = out + "    " + mName + "* m = (" + mName + "*)orbit_alloc(a, sizeof(" + mName + "));\n"
        fi = 0
        while fi < modelDecl.fields.len() {
            val field: IRModelField = modelDecl.fields.get(fi)
            val sField = sanitizeIdentifier(field.name)
            out = out + "    m->" + sField + " = " + sField + ";\n"
            fi = fi + 1
        }
        out = out + "    return m;\n"
        out = out + "}\n\n"
        mi = mi + 1
    }
    return out
}

fn routeHasParams(path: string) -> bool {
    if orbit_string_indexOf(path, "/:") != -1 { return true }
    if orbit_string_indexOf(path, "/{") != -1 { return true }
    if orbit_string_indexOf(path, "/*") != -1 { return true }
    return false
}

fn generateRouteHandlerBody(func: IRFunction) -> string {
    var body = ""
    // Route limits are enforced once at the admission gate in
    // orbit_handle_request (orbit_kynx_check_route with the live
    // req->method/req->path). Checking again here would spend a second
    // token per request on annotated routes.
    body = body + "            uint64_t _orbit_ls = orbit_rdtsc();\n"
    body = body + "            int _orbit_lslot = orbit_ledger_enter(req->method, req->path);\n"
    body = body + "            OrbitResponse* res = " + sanitizeIdentifier(func.name) + "(arena, req);\n"
    body = body + "            orbit_ledger_exit(_orbit_lslot, orbit_rdtsc() - _orbit_ls);\n"
    body = body + "            orbit_send_response(client_sock, res);\n"
    body = body + "#if ORBIT_LOGS_ACTIVE\n"
    body = body + "            orbit_log_request_fmt(req->method, req->path, (res ? res->status : 200), start);\n"
    body = body + "#endif\n"
    body = body + "#if ORBIT_KYNX_ACTIVE\n"
    body = body + "            if (lease) orbit_kynx_lease_destroy(lease);\n"
    body = body + "#endif\n"
    body = body + "            orbit_perf_end_request(start);\n"
    body = body + "            return keep_alive;\n"
    return body
}

fn generateRouterBlock(backend: CBackend) -> string {
    var out = ""
    out = out + routerPreText()
    var i = 0
    while i < backend.module.functions.len() {
        val func: IRFunction = backend.module.functions.get(i)
        if func.routeMethod != "" && routeHasParams(func.routePath) == false {
            out = out + "    case " + fnv1a64Hash(func.routeMethod, func.routePath) + "ULL: {\n"
            out = out + "        if (strcmp(req->path, \"" + func.routePath + "\") == 0 && strcmp(req->method, \"" + func.routeMethod + "\") == 0) {\n"
            out = out + generateRouteHandlerBody(func)
            out = out + "        }\n"
            out = out + "        break;\n"
            out = out + "    }\n"
        }
        i = i + 1
    }
    // Param routes cannot use the hash switch (their paths never equal the
    // literal). They chain inside default, AFTER the static cases, so a
    // static route always wins over a param pattern covering it.
    var paramChain = ""
    var pi = 0
    while pi < backend.module.functions.len() {
        val pfunc: IRFunction = backend.module.functions.get(pi)
        if pfunc.routeMethod != "" && routeHasParams(pfunc.routePath) {
            paramChain = paramChain + "        if (orbit_route_match(arena, req, \"" + pfunc.routeMethod + "\", \"" + pfunc.routePath + "\")) {\n"
            paramChain = paramChain + generateRouteHandlerBody(pfunc)
            paramChain = paramChain + "        }\n"
        }
        pi = pi + 1
    }
    out = out + routerTailText(paramChain)
    return out
}

fn orbitColumnType(t: string) -> string {
    if t == "int" || t == "bool" { return "INTEGER" }
    if t == "float" { return "REAL" }
    return "TEXT"
}

// One CREATE TABLE IF NOT EXISTS per model, in declaration order, emitted
// into server main right after orbit_db_init. Compiler-generated identifiers
// only (model/field names are grammar-constrained); empty models are skipped.
fn generateModelDDL(backend: CBackend) -> string {
    var ddl = ""
    var mi = 0
    while mi < backend.module.models.len() {
        val m: IRModelDecl = backend.module.models.get(mi)
        if m.fields.len() > 0 {
            var cols = ""
            var fi = 0
            while fi < m.fields.len() {
                val f: IRModelField = m.fields.get(fi)
                if fi > 0 { cols = cols + ", " }
                cols = cols + f.name + " " + orbitColumnType(f.typeName)
                if f.name == "id" { cols = cols + " PRIMARY KEY" }
                fi = fi + 1
            }
            ddl = ddl + "    orbit_db_exec_ddl(\"CREATE TABLE IF NOT EXISTS " + modelTableName(m.name) + " (" + cols + ");\");\n"
        }
        mi = mi + 1
    }
    return ddl
}

fn generateServerMain(backend: CBackend) -> string {
    val db = moduleUsesDatabase(backend.module)
    val auth = moduleUsesAuth(backend.module)
    var hasKynxLimits = false
    var sli = 0
    while sli < backend.module.functions.len() {
        val sf: IRFunction = backend.module.functions.get(sli)
        if sf.routeMethod != "" && sf.routeHasLimit && sf.routeLimitRate > 0 {
            hasKynxLimits = true
        }
        sli = sli + 1
    }
    return serverMainText(db, auth, generateModelDDL(backend), hasKynxLimits)
}

fn generateFunction(backend: CBackend, func: IRFunction) -> string {
    backend.currentFunction = func
    backend.callArgs = []
    // Reset the per-function string tracking BEFORE inferring register types.
    // inferRegisterTypes consults isStringOperand()/isStringVar(), and both read
    // backend.strRegs / backend.strVars. Register ids and local variable names
    // are function-local, so leftover state from the previously generated
    // function marks unrelated registers as strings here. That poisons
    // registerTypes for an integer add, which then makes the classification pass
    // below mark the destination variable as a string, which finally makes every
    // later `v = v + 1` in this function compile to orbit_string_concat.
    backend.strRegs = []
    backend.strVars = []
    backend.declVars = []
    var spi = 0
    while spi < func.params.len() {
        if spi < func.paramTypes.len() {
            if func.paramTypes.get(spi) == "string" {
                backend.strVars.push(func.params.get(spi))
            }
        }
        spi = spi + 1
    }
    inferRegisterTypes(backend, func)
    var rti = 0
    while rti < func.registerTypes.len() {
        if func.registerTypes.get(rti) == "string" {
            backend.strRegs.push(rti)
        }
        rti = rti + 1
    }
    var retType = mapTypeToC(backend, func.returnType)
    var fName = func.name
    var isMain = isMainFuncName(fName)
    var isRoute = func.routeMethod != ""
    if isMain {
        fName = "orbit_main"
        retType = "int"
    }
    if isRoute {
        retType = "OrbitResponse*"
    }
    fName = sanitizeIdentifier(fName)
    val cbFn = orbit_cbuf_create_selfhost()
    // NOTE: tiny functions used to carry __attribute__((always_inline)),
    // but without an `inline` keyword that warns under -Wall, and at the
    // pipeline's fixed -O0 nothing inlines anyway. The dual-path `hot`
    // marker below is kept; revisit both if -O2 ever lands.
    var funcAttr = ""
    if isDualPathFunction(func) {
        funcAttr = funcAttr + "__attribute__((hot)) "
    }
    if isRoute {
        orbit_cbuf_append_selfhost(cbFn, funcAttr + retType + " " + fName + "(OrbitArena* arena, OrbitRequest* req")
    } else if isMain {
        orbit_cbuf_append_selfhost(cbFn, funcAttr + retType + " " + fName + "(OrbitArena* _init_arena")
    } else {
        orbit_cbuf_append_selfhost(cbFn, funcAttr + "static " + retType + " " + fName + "(")
        var i = 0
        if func.params.len() == 0 {
            orbit_cbuf_append_selfhost(cbFn, "void")
        } else {
            while i < func.params.len() {
                val pName = func.params.get(i)
                var pTypeName = "void*"
                if i < func.paramTypes.len() {
                    pTypeName = func.paramTypes.get(i)
                }
                val pType = mapTypeToC(backend, pTypeName)
                orbit_cbuf_append_selfhost(cbFn, pType + " " + pName)
                if i < func.params.len() - 1 {
                    orbit_cbuf_append_selfhost(cbFn, ", ")
                }
                i = i + 1
            }
        }
    }
    orbit_cbuf_append_selfhost(cbFn, ") {\n")
    if isMain {
        orbit_cbuf_append_selfhost(cbFn, "    arena = _init_arena;\n")
    }
    backend.refLabels = []
    var si = 0
    while si < func.instructions.len() {
        val sinst: IRInstruction = func.instructions.get(si)
        if sinst != NULL {
            match sinst.opcode {
                IROpcode.jump => {
                    var starget = generateValue(sinst.operand1)
                    if listContainsStr(backend.refLabels, starget) == false { backend.refLabels.push(starget) }
                }
                IROpcode.jump_if_false => {
                    var starget = generateValue(sinst.operand2)
                    if listContainsStr(backend.refLabels, starget) == false { backend.refLabels.push(starget) }
                }
                _ => {}
            }
        }
        si = si + 1
    }
    i = 0
    while i < func.registerCount {
        var rTypeName = "void*"
        if i < func.registerTypes.len() {
            rTypeName = func.registerTypes.get(i)
        }
        val rType = mapTypeToC(backend, rTypeName)
        if rType != "void" {
            var initValue = "0"
            if rType == "OrbitResult" {
                initValue = "{0}"
            }
            orbit_cbuf_append_selfhost(cbFn, "    __attribute__((unused)) " + rType + " r_" + orbit_int_to_string_selfhost(i) + " = " + initValue + ";\n")
        }
        i = i + 1
    }
    backend.strRegs = []
    backend.strVars = []
    backend.declVars = []
    var rti2 = 0
    while rti2 < func.registerTypes.len() {
        if func.registerTypes.get(rti2) == "string" {
            backend.strRegs.push(rti2)
        }
        rti2 = rti2 + 1
    }
    var pi = 0
    while pi < func.params.len() {
        if pi < func.paramTypes.len() {
            if func.paramTypes.get(pi) == "string" {
                backend.strVars.push(func.params.get(pi))
            }
        }
        pi = pi + 1
    }
    pi = 0
    while pi < func.instructions.len() {
        val inst = func.instructions.get(pi)
        match inst.opcode {
            IROpcode.load_const => {
                match inst.operand1 {
                    IRValue.String(s) => { backend.strRegs.push(inst.dest) }
                    _ => {}
                }
            }
            IROpcode.load_var => {
                var vn = ""
                match inst.operand1 {
                    IRValue.Sym(s) => { vn = s.value }
                    IRValue.String(s) => { vn = s.value }
                    _ => {}
                }
                if vn != "" && isStringVar(backend, vn) {
                    backend.strRegs.push(inst.dest)
                }
            }
            IROpcode.decl_var => {
                match inst.operand1 {
                    IRValue.Sym(s) => {
                        if isStringOperand(backend, inst.operand2) {
                            backend.strVars.push(s.value)
                        }
                    }
                    _ => {}
                }
            }
            IROpcode.store_var => {
                match inst.operand1 {
                    IRValue.Sym(s) => {
                        if isStringOperand(backend, inst.operand2) {
                            backend.strVars.push(s.value)
                        }
                    }
                    _ => {}
                }
            }
            IROpcode.call => {
                var cn = ""
                match inst.operand1 {
                    IRValue.String(s) => { cn = s.value }
                    IRValue.Sym(s) => { cn = s.value }
                    _ => {}
                }
                if isStringReturningFunction(cn) {
                    backend.strRegs.push(inst.dest)
                }
            }
            IROpcode.load_field => {
                var fname3 = ""
                match inst.operand2 {
                    IRValue.String(s) => { fname3 = s.value }
                    IRValue.Sym(s) => { fname3 = s.value }
                    _ => {}
                }
                fname3 = fieldRefName(fname3)
                if isStringFieldName(backend, fname3) {
                    backend.strRegs.push(inst.dest)
                }
            }
            IROpcode.add => {
                if isStringOperand(backend, inst.operand1) || isStringOperand(backend, inst.operand2) {
                    backend.strRegs.push(inst.dest)
                }
            }
            _ => {}
        }
        pi = pi + 1
    }
    // Hoist every declared variable into the function scope. Orbit blocks emit
    // real C braces, so declaring at the point of use would (a) redefine names
    // reused across sibling blocks and (b) leave a name out of scope for later
    // blocks. Declaring once up front avoids both.
    var hi = 0
    while hi < func.instructions.len() {
        val hinst = func.instructions.get(hi)
        var hname = ""
        match hinst.opcode {
            IROpcode.decl_var => {
                match hinst.operand1 {
                    IRValue.Sym(s) => { hname = s.value }
                    IRValue.String(s) => { hname = s.value }
                    _ => {}
                }
            }
            IROpcode.store_var => {
                match hinst.operand1 {
                    IRValue.Sym(s) => { hname = s.value }
                    IRValue.String(s) => { hname = s.value }
                    _ => {}
                }
            }
            IROpcode.load_var => {
                match hinst.operand1 {
                    IRValue.Sym(s) => { hname = s.value }
                    IRValue.String(s) => { hname = s.value }
                    _ => {}
                }
            }
            _ => {}
        }
        if hname != "" && hname != "arena" && hname != "NULL" && hname != "true" && hname != "false" && orbit_string_indexOf(hname, "_TAG_") == -1 && orbit_string_indexOf(hname, "TAG_") == -1 {
            var hseen = false
            var hj = 0
            while hj < backend.declVars.len() {
                if backend.declVars.get(hj) == hname {
                    hseen = true
                }
                hj = hj + 1
            }
            hj = 0
            while hj < func.params.len() {
                if func.params.get(hj) == hname {
                    hseen = true
                }
                hj = hj + 1
            }
            if hseen == false {
                backend.declVars.push(hname)
                val vType = variableDefType(backend, func, hname)
                var cType = "uintptr_t"
                if vType == "int" { cType = "orbit_int" }
                else if vType == "string" { cType = "orbit_string" }
                else if vType == "float" { cType = "orbit_float" }
                else if vType == "bool" { cType = "orbit_bool" }
                else if vType == "result" || vType == "Result" || vType == "OrbitResult" { cType = "OrbitResult" }
                orbit_cbuf_append_selfhost(cbFn, "    __attribute__((unused)) " + cType + " " + hname + ";\n")
                if orbit_string_len(hname) > 0 && hname.at(0) == 95 {
                    orbit_cbuf_append_selfhost(cbFn, "    (void)" + hname + ";\n")
                }
            }
        }
        hi = hi + 1
    }
    if isDualPathFunction(func) {
        orbit_cbuf_append_selfhost(cbFn, "    __attribute__((unused)) orbit_int _orbit_dualpath_;\n")
        orbit_cbuf_append_selfhost(cbFn, "    (void)_orbit_dualpath_;\n")
    }
    i = 0
    var firstDualPathInstr = isDualPathFunction(func)
    while i < func.instructions.len() {
        val instr: IRInstruction = func.instructions.get(i)
        if firstDualPathInstr {
            orbit_cbuf_append_selfhost(cbFn, "    ")
            firstDualPathInstr = false
        }
        emitInstruction(backend, instr, cbFn)
        i = i + 1
    }
    if isRoute {
        orbit_cbuf_append_selfhost(cbFn, "    return orbit_response_create(arena, 500, \"text/plain\", \"Internal Server Error\");\n")
    } else if isMain {
        orbit_cbuf_append_selfhost(cbFn, "    return 0;\n")
    } else if func.returnType != "void" {
        if retType == "orbit_int" {
            orbit_cbuf_append_selfhost(cbFn, "    return 0;\n")
        } else if retType == "orbit_bool" {
            orbit_cbuf_append_selfhost(cbFn, "    return false;\n")
        } else if retType == "orbit_float" {
            orbit_cbuf_append_selfhost(cbFn, "    return 0.0;\n")
        } else if retType == "orbit_string" {
            orbit_cbuf_append_selfhost(cbFn, "    return \"\";\n")
        } else if isEnumType(backend, func.returnType) {
            orbit_cbuf_append_selfhost(cbFn, "    return (" + retType + ")0;\n")
        } else if retType == "OrbitResult" {
            orbit_cbuf_append_selfhost(cbFn, "    return (OrbitResult){0};\n")
        } else {
            orbit_cbuf_append_selfhost(cbFn, "    return NULL;\n")
        }
    }
    orbit_cbuf_append_selfhost(cbFn, "}\n\n")
    return orbit_cbuf_build_selfhost(cbFn)
}

fn escapeString(s: string) -> string {
    var out = ""
    var i = 0
    while i < s.len() {
        val c = s.slice(i, i + 1)
        if c == "\\" {
            out = out + "\\\\"
        } else if c == "\"" {
            out = out + "\\\""
        } else if c == "\n" {
            out = out + "\\n"
        } else if c == "\r" {
            out = out + "\\r"
        } else if c == "\t" {
            out = out + "\\t"
        } else if orbit_string_char_at_selfhost(c, 0) == 27 {
            out = out + "\\x1b"
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

fn generateValue(value: IRValue) -> string {
    if value == NULL { return "" }
    match value {
        IRValue.Int(v) => { return orbit_int_to_string_selfhost(v.value) }
        IRValue.Float(v) => { return orbit_float_to_string_selfhost(v.value) }
        IRValue.String(v) => { return "\"" + escapeString(v.value) + "\"" }
        IRValue.Sym(v) => { return v.value }
        IRValue.Bool(v) => {
            if v.value { return "true" }
            return "false"
        }
        IRValue.Register(v) => {
            if v.value < 0 { return "0" }
            return "r_" + orbit_int_to_string_selfhost(v.value)
        }
        IRValue.Label(v) => { return orbit_int_to_string_selfhost(v.value) }
        _ => { return "" }
    }
}

fn generateRegAssign(backend: CBackend, destReg: int, valStr: string) -> string {
    if orbit_string_indexOf(valStr, "orbit_string_concat") != -1 || orbit_string_indexOf(valStr, "orbit_string_slice") != -1 || orbit_string_indexOf(valStr, "orbit_list_get") != -1 || orbit_string_indexOf(valStr, "_lr.value") != -1 || orbit_string_indexOf(valStr, "orbit_alloc") != -1 {
        return "    r_" + orbit_int_to_string_selfhost(destReg) + " = (void*)(uintptr_t)(" + valStr + ");\n"
    }
    var regT = ""
    if backend != NULL && backend.currentFunction != NULL {
        val f: IRFunction = backend.currentFunction
        if destReg >= 0 && destReg < f.registerTypes.len() {
            regT = f.registerTypes.get(destReg)
        }
    }
    if orbit_string_indexOf(valStr, "TAG_") != -1 {
        if regT != "" && regT != "unknown" && regT != "void*" && regT != "orbit_int" && isEnumType(backend, regT) {
            return "    r_" + orbit_int_to_string_selfhost(destReg) + " = (" + regT + ")" + valStr + ";\n"
        }
        if regT == "int" || regT == "bool" || regT == "orbit_int" || regT == "orbit_bool" {
            return "    r_" + orbit_int_to_string_selfhost(destReg) + " = (orbit_int)(uintptr_t)(" + valStr + ");\n"
        }
        return "    r_" + orbit_int_to_string_selfhost(destReg) + " = (void*)(uintptr_t)(" + valStr + ");\n"
    }
    if regT == "int" || regT == "bool" || regT == "orbit_int" || regT == "orbit_bool" || isEnumType(backend, regT) {
        return "    r_" + orbit_int_to_string_selfhost(destReg) + " = (orbit_int)(uintptr_t)(" + valStr + ");\n"
    }
    if regT == "string" || regT == "orbit_string" {
        return "    r_" + orbit_int_to_string_selfhost(destReg) + " = (orbit_string)(" + valStr + ");\n"
    }
    if regT == "float" || regT == "orbit_float" {
        return "    r_" + orbit_int_to_string_selfhost(destReg) + " = (orbit_float)(" + valStr + ");\n"
    }
    if regT == "result" || regT == "Result" || regT == "OrbitResult" {
        return "    r_" + orbit_int_to_string_selfhost(destReg) + " = " + valStr + ";\n"
    }
    return "    r_" + orbit_int_to_string_selfhost(destReg) + " = (void*)(uintptr_t)(" + valStr + ");\n"
}

// Emits one instruction's C text straight into the caller's chunk buffer.
// Named emit* (not generate*) to mark the void, buffer-appending contract.
fn emitInstruction(backend: CBackend, instr: IRInstruction, cb: string) {
    if instr == NULL { return }
    match instr.opcode {
        IROpcode.nop => {
            orbit_cbuf_append_selfhost(cb, "")
            return
        }
        IROpcode.load_const => {
            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, generateValue(instr.operand1)))
            return
        }
        IROpcode.load_var => {
            var valStr = ""
            var vn = ""
            match instr.operand1 {
                IRValue.String(s) => { valStr = s.value
                    vn = s.value }
                IRValue.Sym(s) => { valStr = s.value
                    vn = s.value }
                _ => { valStr = generateValue(instr.operand1) }
            }
            var lrT = ""
            if backend != NULL && backend.currentFunction != NULL {
                val lf: IRFunction = backend.currentFunction
                if instr.dest >= 0 && instr.dest < lf.registerTypes.len() {
                    lrT = lf.registerTypes.get(instr.dest)
                }
            }
            if orbit_string_indexOf(valStr, "TAG_") != -1 {
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = (orbit_int)(uintptr_t)(" + valStr + ");\n")
                return
            }
            var vType = ""
            if vn != "" && backend != NULL && backend.currentFunction != NULL {
                val lf: IRFunction = backend.currentFunction
                vType = variableDefType(backend, lf, vn)
                if vType == "unknown" || vType == "" {
                    var p = 0
                    while p < lf.params.len() {
                        if lf.params.get(p) == vn {
                            vType = lf.paramTypes.get(p)
                        }
                        p = p + 1
                    }
                }
            }
            if lrT == "float" || lrT == "orbit_float" || vType == "float" || vType == "orbit_float" {
                if backend != NULL && backend.currentFunction != NULL {
                    val lf: IRFunction = backend.currentFunction
                    lf.registerTypes = setStrAt(lf.registerTypes, instr.dest, "float")
                }
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = (orbit_float)(" + valStr + ");\n")
                return
            }
            if lrT == "int" || lrT == "bool" || lrT == "orbit_int" || lrT == "orbit_bool" || lrT == "enumeration" || isEnumType(backend, lrT) {
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = (orbit_int)(uintptr_t)(" + valStr + ");\n")
                return
            }
            if lrT == "result" || lrT == "Result" || lrT == "OrbitResult" || vType == "result" || vType == "Result" || vType == "OrbitResult" {
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = " + valStr + ";\n")
                return
            }
            orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = (void*)(" + valStr + ");\n")
            return
        }
        IROpcode.store_var => {
            val svName = generateValue(instr.operand1)
            orbit_cbuf_append_selfhost(cb, "    " + svName + " = " + storeCastFor(backend, svName) + "(" + generateValue(instr.operand2) + ");\n")
            return
        }
        IROpcode.decl_var => {
            val dvName = generateValue(instr.operand1)
            orbit_cbuf_append_selfhost(cb, "    " + dvName + " = " + storeCastFor(backend, dvName) + "(" + generateValue(instr.operand2) + ");\n")
            return
        }
        IROpcode.add => {
            if isStringOperand(backend, instr.operand1) || isStringOperand(backend, instr.operand2) {
                val s1 = stringifyConcatOperand(backend, instr.operand1)
                val s2 = stringifyConcatOperand(backend, instr.operand2)
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = orbit_string_concat(arena, " + s1 + ", " + s2 + ");\n")
                return
            }
            if operandDefType(backend.currentFunction, instr.operand1) == "float" || operandDefType(backend.currentFunction, instr.operand2) == "float" {
                orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "(orbit_float)(" + generateValue(instr.operand1) + ") + (orbit_float)(" + generateValue(instr.operand2) + ")"))
                return
            }
            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "(uintptr_t)(" + generateValue(instr.operand1) + ") + (uintptr_t)(" + generateValue(instr.operand2) + ")"))
            return
        }
        IROpcode.sub => {
            if operandDefType(backend.currentFunction, instr.operand1) == "float" || operandDefType(backend.currentFunction, instr.operand2) == "float" {
                orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "(orbit_float)(" + generateValue(instr.operand1) + ") - (orbit_float)(" + generateValue(instr.operand2) + ")"))
                return
            }
            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "(uintptr_t)(" + generateValue(instr.operand1) + ") - (uintptr_t)(" + generateValue(instr.operand2) + ")"))
            return
        }
        IROpcode.mul => {
            if operandDefType(backend.currentFunction, instr.operand1) == "float" || operandDefType(backend.currentFunction, instr.operand2) == "float" {
                orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "(orbit_float)(" + generateValue(instr.operand1) + ") * (orbit_float)(" + generateValue(instr.operand2) + ")"))
                return
            }
            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "(uintptr_t)(" + generateValue(instr.operand1) + ") * (uintptr_t)(" + generateValue(instr.operand2) + ")"))
            return
        }
        IROpcode.div => {
            if operandDefType(backend.currentFunction, instr.operand1) == "float" || operandDefType(backend.currentFunction, instr.operand2) == "float" {
                orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "(orbit_float)(" + generateValue(instr.operand1) + ") / (orbit_float)(" + generateValue(instr.operand2) + ")"))
                return
            }
            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "(uintptr_t)(" + generateValue(instr.operand1) + ") / (uintptr_t)(" + generateValue(instr.operand2) + ")"))
            return
        }
        IROpcode.mod => {
            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "(uintptr_t)(" + generateValue(instr.operand1) + ") % (uintptr_t)(" + generateValue(instr.operand2) + ")"))
            return
        }
        IROpcode.eq => {
            val v1 = generateValue(instr.operand1)
            val v2 = generateValue(instr.operand2)
            if isStringOperand(backend, instr.operand1) && isStringOperand(backend, instr.operand2) {
                orbit_cbuf_append_selfhost(cb, "    r_" + orbit_int_to_string_selfhost(instr.dest) + " = strcmp(" + v1 + ", " + v2 + ") == 0;\n")
                return
            }
            if operandDefType(backend.currentFunction, instr.operand1) == "float" || operandDefType(backend.currentFunction, instr.operand2) == "float" {
                orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "((orbit_float)(" + v1 + ") == (orbit_float)(" + v2 + "))"))
                return
            }
            orbit_cbuf_append_selfhost(cb, generateRegAssign(backend, instr.dest, "((uintptr_t)(" + v1 + ") == (uintptr_t)(" + v2 + "))"))
            return
        }
        IROpcode.ne => {
