                        callExpr = callExpr + "(orbit_int)(uintptr_t)(" + aStr + ")"
                    } else {
                        callExpr = callExpr + "(void*)(uintptr_t)(" + aStr + ")"
                    }
                } else if calleeName == "tirEmit" {
