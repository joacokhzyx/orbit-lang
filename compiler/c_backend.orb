                    callExpr = callExpr + "(orbit_int)(uintptr_t)(" + aStr + ")"
                } else if calleeName == "parseTypeDecl" {
                    if argIdx == 1 {
                        callExpr = callExpr + "(TokType)(uintptr_t)(" + aStr + ")"
                    } else if argIdx == 2 {
                        callExpr = callExpr + "(orbit_int)(uintptr_t)(" + aStr + ")"
                    } else {
                        callExpr = callExpr + "(void*)(uintptr_t)(" + aStr + ")"
                    }
                } else if calleeName == "parseBinary" || calleeName == "setStrAt" || calleeName == "isStringReg" {
