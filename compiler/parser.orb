import "./ast.orb"
import "./token.orb"
import "./lexer.orb"

model ParserDiagnostic {
    message: string
    line: int
    column: int
    code: string
    kind: string
}

model Parser {
    lexer: Lexer
    currentToken: Token
    previousToken: Token
    diagnostics: list
    depth: int
}

fn initParser(source: string) -> Parser {
    val lex = initLexer(source)
    val dummy = Token(TokType.EOF, "", 1, 1)
    val mut parser = Parser(lex, dummy, dummy, [], 0)
    advanceParser(parser)
    return parser
}

fn advanceParser(parser: Parser) {
    parser.previousToken = parser.currentToken
    val tok = nextToken(parser.lexer)
    parser.currentToken = tok
}

fn check(parser: Parser, tag: TokType) -> bool {
    val curTag = parser.currentToken.tag
    val matchRes = curTag == tag
    return matchRes
}

fn matchToken(parser: Parser, tag: TokType) -> bool {
    if check(parser, tag) {
        advanceParser(parser)
        return true
    }
    return false
}

fn isAtEnd(parser: Parser) -> bool {
    return parser.currentToken.tag == TokType.EOF
}

fn parserError(parser: Parser, message: string) {
    parser.diagnostics.push(ParserDiagnostic(message, parser.currentToken.line, parser.currentToken.col, "", ""))
}

fn parserUnexpectedToken(parser: Parser, kind: string) {
    val tok = parser.currentToken
    var col = tok.col
    if tokIsSymbol(tok.tag) {
        col = tok.col + tok.text.len()
    }
    parser.diagnostics.push(ParserDiagnostic("unexpected token '" + tokTagName(tok.tag) + "'", tok.line, col, "E0301", kind))
}

fn parseTypeName(parser: Parser) -> string {
    if check(parser, TokType.Identifier) {
        advanceParser(parser)
        return parser.previousToken.text
    }
    parserError(parser, "Expected type name.")
    return "unknown"
}

fn consume(parser: Parser, expected: TokType, message: string) {
    if check(parser, expected) {
        advanceParser(parser)
    } else {
        parserError(parser, message)
        if isAtEnd(parser) == false {
            advanceParser(parser)
        }
    }
}

fn isKeywordToken(tag: TokType) -> bool {
    if tag == TokType.KeywordIf { return true }
    if tag == TokType.KeywordElse { return true }
    if tag == TokType.KeywordFor { return true }
    if tag == TokType.KeywordIn { return true }
    if tag == TokType.KeywordWhile { return true }
    if tag == TokType.KeywordLoop { return true }
    if tag == TokType.KeywordBreak { return true }
    if tag == TokType.KeywordContinue { return true }
    if tag == TokType.KeywordReturn { return true }
    if tag == TokType.KeywordMatch { return true }
    if tag == TokType.KeywordType { return true }
    if tag == TokType.KeywordEnum { return true }
    if tag == TokType.KeywordUnion { return true }
    if tag == TokType.KeywordConst { return true }
    if tag == TokType.KeywordVal { return true }
    if tag == TokType.KeywordVar { return true }
    if tag == TokType.KeywordMut { return true }
    if tag == TokType.KeywordPrivate { return true }
    if tag == TokType.KeywordExtern { return true }
    if tag == TokType.KeywordEvery { return true }
    if tag == TokType.KeywordAsync { return true }
    if tag == TokType.KeywordFn { return true }
    if tag == TokType.KeywordModel { return true }
    if tag == TokType.KeywordRoute { return true }
    if tag == TokType.KeywordGet { return true }
    if tag == TokType.KeywordPost { return true }
    if tag == TokType.KeywordPut { return true }
    if tag == TokType.KeywordPatch { return true }
    if tag == TokType.KeywordDelete { return true }
    if tag == TokType.KeywordHead { return true }
    if tag == TokType.KeywordOptions { return true }
    if tag == TokType.KeywordUse { return true }
    if tag == TokType.KeywordImport { return true }
    if tag == TokType.KeywordTrait { return true }
    if tag == TokType.KeywordImpl { return true }
    return false
}

// Contextual keywords: member names may collide with language keywords
// (map.delete(...), .list, .map, .string, ...). Members resolve by text
// downstream, never by tag, so accept an Identifier or any keyword here.
fn consumeMemberName(parser: Parser, message: string) {
    val t = parser.currentToken.tag
    if t == TokType.Identifier || isKeywordToken(t) {
        advanceParser(parser)
    } else {
        parserError(parser, message)
        if isAtEnd(parser) == false {
            advanceParser(parser)
        }
    }
}

fn getPrecedence(tag: TokType) -> int {
    if tag == TokType.DoublePipe { return 1 }
    if tag == TokType.DoubleAmpersand { return 2 }
    if tag == TokType.DoubleEqual { return 3 }
    if tag == TokType.NotEqual { return 3 }
    if tag == TokType.Less { return 4 }
    if tag == TokType.LessEqual { return 4 }
    if tag == TokType.Greater { return 4 }
    if tag == TokType.GreaterEqual { return 4 }
    if tag == TokType.Plus { return 5 }
    if tag == TokType.Minus { return 5 }
    if tag == TokType.Asterisk { return 6 }
    if tag == TokType.Slash { return 6 }
    if tag == TokType.Percent { return 6 }
    return 0
}

fn parsePostfix(parser: Parser, lhs: ASTNode) -> ASTNode {
    var result = lhs
    var parsing = true
    while parsing {
        if matchToken(parser, TokType.OpenParen) {
            var args = []
            if check(parser, TokType.CloseParen) == false {
                var parsingArgs = true
                while parsingArgs {
                    val arg = parseExpression(parser)
                    args.push(arg)
                    if matchToken(parser, TokType.Comma) == false {
                        parsingArgs = false
                    }
                }
            }
            consume(parser, TokType.CloseParen, "Expected ')' after arguments.")
            result = ASTNode.Call(CallNode(result, args))
        } else {
            if matchToken(parser, TokType.Dot) {
                consumeMemberName(parser, "Expected member name after '.'.")
                val member = parser.previousToken.text
                result = ASTNode.MemberAccess(MemberAccessNode(result, member))
            } else {
                if matchToken(parser, TokType.OpenBracket) {
                    val index = parseExpression(parser)
                    consume(parser, TokType.CloseBracket, "Expected ']' after index.")
                    result = ASTNode.IndexAccess(IndexAccessNode(result, index))
                } else {
                    parsing = false
                }
            }
        }
    }
    return result
}

fn parsePrimary(parser: Parser) -> ASTNode {
    if matchToken(parser, TokType.Bang) {
        val operand = parsePrimary(parser)
        return ASTNode.UnaryOp(UnaryOpNode("!", operand))
    }
    if matchToken(parser, TokType.Minus) {
        val operand = parsePrimary(parser)
        return ASTNode.UnaryOp(UnaryOpNode("-", operand))
    }
    if matchToken(parser, TokType.IntegerLiteral) {
        return ASTNode.Literal(LiteralNode("int", parser.previousToken.text))
    }
    if matchToken(parser, TokType.FloatLiteral) {
        return ASTNode.Literal(LiteralNode("float", parser.previousToken.text))
    }
    if matchToken(parser, TokType.StringLiteral) {
        return ASTNode.Literal(LiteralNode("string", parser.previousToken.text))
    }
    if matchToken(parser, TokType.CharLiteral) {
        return ASTNode.Literal(LiteralNode("char", parser.previousToken.text))
    }
    if matchToken(parser, TokType.Identifier) {
        val name = parser.previousToken.text
        if name == "true" { return ASTNode.Literal(LiteralNode("bool", name)) }
        if name == "false" { return ASTNode.Literal(LiteralNode("bool", name)) }
        val node = ASTNode.Literal(LiteralNode("identifier", name))
        return parsePostfix(parser, node)
    }
    if matchToken(parser, TokType.KeywordOk) {
        val name = parser.previousToken.text
        val node = ASTNode.Literal(LiteralNode("identifier", name))
        return parsePostfix(parser, node)
    }
    if matchToken(parser, TokType.KeywordErr) {
        val name = parser.previousToken.text
        val node = ASTNode.Literal(LiteralNode("identifier", name))
        return parsePostfix(parser, node)
    }
    if matchToken(parser, TokType.KeywordMatch) {
        return parseMatchExpr(parser)
    }
    if matchToken(parser, TokType.OpenParen) {
        val expr = parseExpression(parser)
        consume(parser, TokType.CloseParen, "Expected ')' after expression.")
        return expr
    }
    if matchToken(parser, TokType.KeywordIf) {
        return parseIfExpr(parser)
    }
    if matchToken(parser, TokType.OpenBracket) {
        var elements = []
        while check(parser, TokType.CloseBracket) == false && isAtEnd(parser) == false {
            val eBTag = parser.currentToken.tag
            val eBLine = parser.currentToken.line
            val eBCol = parser.currentToken.col
            elements.push(parseExpression(parser))
            // Panic-mode recovery: an element parse that consumed nothing
            // (e.g. depth-limit fallback) must still advance, else this loop spins.
            if parser.currentToken.tag == eBTag && parser.currentToken.line == eBLine && parser.currentToken.col == eBCol && isAtEnd(parser) == false {
                advanceParser(parser)
            }
            matchToken(parser, TokType.Comma)
        }
        consume(parser, TokType.CloseBracket, "Expected ']' after list literal.")
    return ASTNode.ListLiteral(ListLiteralNode(elements))
}

parserUnexpectedToken(parser, "error.UnexpectedToken")
if isAtEnd(parser) == false {
    advanceParser(parser)
}
return ASTNode.Empty
}

fn parseIfExpr(parser: Parser) -> ASTNode {
    val condition = parseExpression(parser)
    val thenBody = parseExpression(parser)
    var elseBody = ASTNode.Empty
    if matchToken(parser, TokType.KeywordElse) {
        elseBody = parseExpression(parser)
    }
    return ASTNode.If(IfNode(condition, thenBody, elseBody))
}

fn parseMatchExpr(parser: Parser) -> ASTNode {
    val expr = parseExpression(parser)
    consume(parser, TokType.OpenBrace, "Expected '{' after match expression.")
        var cases = []
        while check(parser, TokType.CloseBrace) == false && isAtEnd(parser) == false {
            val pattern = parseExpression(parser)
            consume(parser, TokType.FatArrow, "Expected '=>' in match case.")
            val body = parseExpression(parser)
            matchToken(parser, TokType.Comma)
            cases.push(ASTNode.MatchCase(MatchCaseNode(pattern, body)))
        }
        consume(parser, TokType.CloseBrace, "Expected '}' after match cases.")
    return ASTNode.Match(MatchNode(expr, cases))
}

fn parseBinary(parser: Parser, precedence: int) -> ASTNode {
    var lhs = parsePrimary(parser)

    while getPrecedence(parser.currentToken.tag) > precedence {
        val opToken = parser.currentToken
        advanceParser(parser)
        val nextPrec = getPrecedence(opToken.tag)
        val rhs = parseBinary(parser, nextPrec)
        lhs = ASTNode.BinaryOp(BinaryOpNode(opToken.text, lhs, rhs))
    }

    return lhs
}

fn parseDepthGuard(parser: Parser) -> bool {
    if parser.depth > 600 {
        if parser.diagnostics.len() == 0 {
            val tok = parser.currentToken
            parser.diagnostics.push(ParserDiagnostic("expression or statement nesting too deep", tok.line, tok.col, "E0130", "error.SyntaxDepthLimit"))
        }
        return true
    }
    return false
}

fn parseExpression(parser: Parser) -> ASTNode {
    parser.depth = parser.depth + 1
    var out = ASTNode.Literal(LiteralNode("int", "0"))
    if parseDepthGuard(parser) == false {
        out = parseExpressionInner(parser)
    }
    parser.depth = parser.depth - 1
    return out
}

fn parseExpressionInner(parser: Parser) -> ASTNode {
    val lhs = parseBinary(parser, 0)
    if matchToken(parser, TokType.Equal) {
        val rhs = parseExpression(parser)
        return ASTNode.Assignment(AssignmentNode(lhs, rhs))
    }
    return lhs
}

fn parseVarDecl(parser: Parser, isMutable: bool) -> ASTNode {
    var isMut = isMutable
    if matchToken(parser, TokType.KeywordMut) {
        isMut = true
    }
    consume(parser, TokType.Identifier, "Expected variable name.")
    val name = parser.previousToken.text

    var typeAnnotation = ASTNode.Empty
    if matchToken(parser, TokType.Colon) {
        var isPointer = false
        if matchToken(parser, TokType.Ampersand) {
            isPointer = true
        }
        consume(parser, TokType.Identifier, "Expected type name.")
        var typeName = parser.previousToken.text
        if isPointer {
            typeName = "&" + typeName
        }
        typeAnnotation = ASTNode.TypeAnnotation(TypeAnnotationNode(typeName, false))
    }

    consume(parser, TokType.Equal, "Expected '=' after variable name.")
    val value = parseExpression(parser)

    var annotationName = ""
    match typeAnnotation {
        ASTNode.TypeAnnotation(ta) => { annotationName = ta.token }
        _ => {}
    }
    return ASTNode.VarDecl(VarDeclNode(name, isMut, value, annotationName))
}

fn parseIfStatement(parser: Parser) -> ASTNode {
    val condition = parseExpression(parser)
    val thenBody = parseBlock(parser)
    var elseBody = ASTNode.Empty
    if matchToken(parser, TokType.KeywordElse) {
        if matchToken(parser, TokType.KeywordIf) {
            elseBody = parseIfStatement(parser)
        } else {
            elseBody = parseBlock(parser)
        }
    }
    return ASTNode.If(IfNode(condition, thenBody, elseBody))
}

fn parseWhileStatement(parser: Parser) -> ASTNode {
    val condition = parseExpression(parser)
    val body = parseBlock(parser)
    return ASTNode.While(WhileNode(condition, body))
}

fn parseForStatement(parser: Parser) -> ASTNode {
    consume(parser, TokType.Identifier, "Expected loop variable name.")
    val item = parser.previousToken.text
    consume(parser, TokType.KeywordIn, "Expected 'in' after loop variable.")
    val iterable = parseExpression(parser)
    val body = parseBlock(parser)
    return ASTNode.For(ForNode(item, iterable, body))
}

fn parseMatchStatement(parser: Parser) -> ASTNode {
    val expr = parseExpression(parser)
    consume(parser, TokType.OpenBrace, "Expected '{' after match expression.")
        var cases = []
        while check(parser, TokType.CloseBrace) == false && isAtEnd(parser) == false {
            val pattern = parseExpression(parser)
            consume(parser, TokType.FatArrow, "Expected '=>' in match case.")
            var body = ASTNode.Empty
            if matchToken(parser, TokType.OpenBrace) {
                var stmts = []
                var parsingBody = true
                while parsingBody {
                    if check(parser, TokType.CloseBrace) {
                        parsingBody = false
                    } else {
                        if isAtEnd(parser) {
                            parsingBody = false
                        } else {
                            stmts.push(parseStatement(parser))
                        }
                    }
                }
                consume(parser, TokType.CloseBrace, "Expected '}' after block.")
                body = ASTNode.Block(BlockNode(stmts))
            } else {
                body = parseStatement(parser)
            }
            matchToken(parser, TokType.Comma)
            cases.push(ASTNode.MatchCase(MatchCaseNode(pattern, body)))
        }
        consume(parser, TokType.CloseBrace, "Expected '}' after match cases.")
    return ASTNode.Match(MatchNode(expr, cases))
}

fn parseBlock(parser: Parser) -> ASTNode {
    consume(parser, TokType.OpenBrace, "Expected '{' before block.")
        var statements = []
        var parsingBlock = true
        while parsingBlock {
            if check(parser, TokType.CloseBrace) {
                parsingBlock = false
            } else {
                if isAtEnd(parser) {
                    parsingBlock = false
                } else {
                    statements.push(parseStatement(parser))
                }
            }
        }
        consume(parser, TokType.CloseBrace, "Expected '}' after block.")
    return ASTNode.Block(BlockNode(statements))
}

fn parseGenericParams(parser: Parser) -> list {
    if matchToken(parser, TokType.OpenBracket) == false {
        return []
    }
    var params = []
    while check(parser, TokType.CloseBracket) == false && isAtEnd(parser) == false {
        consume(parser, TokType.Identifier, "Expected generic parameter name.")
        val name = parser.previousToken.text
        var constraint = ""
        if matchToken(parser, TokType.Colon) {
            consume(parser, TokType.Identifier, "Expected constraint type.")
            constraint = parser.previousToken.text
        }
        params.push(ASTNode.GenericParam(GenericParamNode(name, constraint)))
        matchToken(parser, TokType.Comma)
    }
    consume(parser, TokType.CloseBracket, "Expected ']' after generic parameters.")
return params
}

fn parseFunctionDecl(parser: Parser, isPrivate: bool, isExtern: bool) -> ASTNode {
    matchToken(parser, TokType.KeywordFn)
    val isAsync = matchToken(parser, TokType.KeywordAsync)

    consume(parser, TokType.Identifier, "Expected function name.")
    val name = parser.previousToken.text

    val genericParams = parseGenericParams(parser)

    consume(parser, TokType.OpenParen, "Expected '(' after function name.")
    var params = []
    var paramTypes = []
    if check(parser, TokType.CloseParen) == false {
        var parsingParams = true
        while parsingParams {
            if check(parser, TokType.Identifier) {
                advanceParser(parser)
            } else {
                parserUnexpectedToken(parser, "error.UnexpectedToken")
                if isAtEnd(parser) == false {
                    advanceParser(parser)
                }
            }
            val paramName = parser.previousToken.text
            params.push(paramName)
            
            var paramType = "unknown"
            if matchToken(parser, TokType.Colon) {
                var isPointer = false
                if matchToken(parser, TokType.Ampersand) {
                    isPointer = true
                }
                paramType = parseTypeName(parser)
                if isPointer {
                    paramType = "&" + paramType
                }
            }
            
            paramTypes.push(paramType)
            
            if matchToken(parser, TokType.Comma) {
            } else {
                parsingParams = false
            }
        }
    }
    consume(parser, TokType.CloseParen, "Expected ')' after parameters.")

    var returnType = "void"
    if matchToken(parser, TokType.Arrow) {
        var isPointerReturn = false
        if matchToken(parser, TokType.Ampersand) {
            isPointerReturn = true
        }
        returnType = parseTypeName(parser)
        if isPointerReturn {
            returnType = "&" + returnType
        }
    }

    var body = ASTNode.Block(BlockNode([]))
    if check(parser, TokType.OpenBrace) {
        body = parseBlock(parser)
    } else {
        if isExtern == false {
            parserError(parser, "Expected '{' before block.")
        }
    }

    return ASTNode.FunctionDecl(FunctionDeclNode(name, params, paramTypes, returnType, body, isAsync, isPrivate, isExtern, genericParams))
}

fn parseModelDecl(parser: Parser, isPrivate: bool) -> ASTNode {
    if check(parser, TokType.Identifier) {
        advanceParser(parser)
    } else {
        parserUnexpectedToken(parser, "error.UnexpectedToken")
        if isAtEnd(parser) == false {
            advanceParser(parser)
        }
    }
    val name = parser.previousToken.text
    val genericParams = parseGenericParams(parser)
    consume(parser, TokType.OpenBrace, "Expected '{' after model name.")
        var fields = []
        while check(parser, TokType.CloseBrace) == false && isAtEnd(parser) == false {
            // Check for decorator
            var decorators = []
            while matchToken(parser, TokType.At) {
                consume(parser, TokType.Identifier, "Expected decorator name.")
                decorators.push(ASTNode.Decorator(DecoratorNode(parser.previousToken.text, [])))
            }
            consume(parser, TokType.Identifier, "Expected field name.")
            val fieldName = parser.previousToken.text
            consume(parser, TokType.Colon, "Expected ':' after field name.")
            var isPointer = false
            if matchToken(parser, TokType.Ampersand) {
                isPointer = true
            }
            consume(parser, TokType.Identifier, "Expected field type.")
            var fieldType = parser.previousToken.text
            if isPointer {
                fieldType = "&" + fieldType
            }
            fields.push(ASTNode.FieldDecl(FieldDeclNode(fieldName, fieldType, decorators)))
            matchToken(parser, TokType.Comma)
        }
        consume(parser, TokType.CloseBrace, "Expected '}' after model fields.")
    return ASTNode.ModelDecl(ModelDeclNode(name, fields, genericParams))
}

fn parseTypeDecl(parser: Parser, kw: TokType, isPrivate: bool) -> ASTNode {
    consume(parser, TokType.Identifier, "Expected type name.")
    val name = parser.previousToken.text

    var kind = "alias"
    var variants = []
    var variantPayloads = []
    var baseType = ""

    matchToken(parser, TokType.Equal)

    if kw == TokType.KeywordEnum || matchToken(parser, TokType.KeywordEnum) {
        kind = "enum"
        consume(parser, TokType.OpenBrace, "Expected '{' after 'enum'.")
        while check(parser, TokType.CloseBrace) == false && isAtEnd(parser) == false {
            consume(parser, TokType.Identifier, "Expected variant name.")
            val varName = parser.previousToken.text
            var payloadType = ""
            if matchToken(parser, TokType.OpenParen) {
                consume(parser, TokType.Identifier, "Expected payload type.")
                payloadType = parser.previousToken.text
                consume(parser, TokType.CloseParen, "Expected ')' after payload type.")
            }
            variants.push(ASTNode.Literal(LiteralNode("variant", varName)))
            variantPayloads.push(payloadType)
            matchToken(parser, TokType.Comma)
        }
        consume(parser, TokType.CloseBrace, "Expected '}' after enum variants.")
        return ASTNode.TypeDecl(TypeDeclNode(name, kind, variants, baseType, variantPayloads))
    }

    if kw == TokType.KeywordUnion || matchToken(parser, TokType.KeywordUnion) {
        kind = "union"
        consume(parser, TokType.OpenBrace, "Expected '{' after 'union'.")
        while check(parser, TokType.CloseBrace) == false && isAtEnd(parser) == false {
            consume(parser, TokType.Identifier, "Expected variant name.")
            val varName = parser.previousToken.text
            var payloadType = ""
            if matchToken(parser, TokType.OpenParen) {
                consume(parser, TokType.Identifier, "Expected payload type.")
                payloadType = parser.previousToken.text
                consume(parser, TokType.CloseParen, "Expected ')' after payload type.")
            }
            variants.push(ASTNode.Literal(LiteralNode("variant", varName)))
            variantPayloads.push(payloadType)
            matchToken(parser, TokType.Comma)
        }
        consume(parser, TokType.CloseBrace, "Expected '}' after union variants.")
        return ASTNode.TypeDecl(TypeDeclNode(name, kind, variants, baseType, variantPayloads))
    }

    matchToken(parser, TokType.Pipe)
    if check(parser, TokType.Identifier) {
        var isSumType = false
        while check(parser, TokType.Identifier) {
            consume(parser, TokType.Identifier, "Expected variant or type name.")
            val varName = parser.previousToken.text
            var payloadType = ""
            if matchToken(parser, TokType.OpenParen) {
                isSumType = true
                consume(parser, TokType.Identifier, "Expected payload type.")
                payloadType = parser.previousToken.text
                consume(parser, TokType.CloseParen, "Expected ')' after payload type.")
            }
            variants.push(ASTNode.Literal(LiteralNode("variant", varName)))
            variantPayloads.push(payloadType)
            if matchToken(parser, TokType.Pipe) {
                isSumType = true
            } else {
                if isSumType == false && variants.len() == 1 {
                    baseType = varName
                }
                break
            }
        }
        if isSumType {
            kind = "union"
            return ASTNode.TypeDecl(TypeDeclNode(name, kind, variants, "", variantPayloads))
        } else {
            return ASTNode.TypeDecl(TypeDeclNode(name, "alias", [], baseType, []))
        }
    }

    return ASTNode.TypeDecl(TypeDeclNode(name, kind, variants, baseType, variantPayloads))
}

fn isHttpMethodToken(tag: TokType) -> bool {
    if tag == TokType.KeywordGet { return true }
    if tag == TokType.KeywordPost { return true }
    if tag == TokType.KeywordPut { return true }
    if tag == TokType.KeywordPatch { return true }
    if tag == TokType.KeywordDelete { return true }
    if tag == TokType.KeywordHead { return true }
    if tag == TokType.KeywordOptions { return true }
    return false
}

fn parseRouteDecl(parser: Parser, decorators: list) -> ASTNode {
    var method = ""
    if isHttpMethodToken(parser.currentToken.tag) {
        advanceParser(parser)
        method = parser.previousToken.text
    } else {
        parserUnexpectedToken(parser, "error.ExpectedHttpMethod")
        if isAtEnd(parser) == false {
            advanceParser(parser)
        }
    }
    consume(parser, TokType.StringLiteral, "Expected path string.")
    val path = parser.previousToken.text
    val body = parseBlock(parser)
    return ASTNode.RouteDecl(RouteDeclNode(method, path, decorators, body))
}

fn parseTraitDecl(parser: Parser, isPrivate: bool) -> ASTNode {
    consume(parser, TokType.Identifier, "Expected trait name.")
    val name = parser.previousToken.text
    val genericParams = parseGenericParams(parser)
    consume(parser, TokType.OpenBrace, "Expected '{' after trait name.")
        var methods = []
        while check(parser, TokType.CloseBrace) == false && isAtEnd(parser) == false {
            if matchToken(parser, TokType.KeywordFn) {
                consume(parser, TokType.Identifier, "Expected method name.")
                val methodName = parser.previousToken
                consume(parser, TokType.OpenParen, "Expected '(' after method name.")
                while check(parser, TokType.CloseParen) == false && isAtEnd(parser) == false {
                    advanceParser(parser)
                }
                consume(parser, TokType.CloseParen, "Expected ')' after parameters.")
                var returnType = ""
                if matchToken(parser, TokType.Arrow) {
                    var isPointerReturn = false
                    if matchToken(parser, TokType.Ampersand) {
                        isPointerReturn = true
                    }
                    consume(parser, TokType.Identifier, "Expected return type.")
                    returnType = parser.previousToken.text
                    if isPointerReturn {
                        returnType = "&" + returnType
                    }
                }
                matchToken(parser, TokType.SemiColon)
                val emptyBody = ASTNode.Block(BlockNode([]))
                methods.push(ASTNode.FunctionDecl(FunctionDeclNode(methodName.text, [], [], returnType, emptyBody, false, false, false, [])))
            } else {
                advanceParser(parser)
            }
        }
        consume(parser, TokType.CloseBrace, "Expected '}' after trait methods.")
    return ASTNode.TraitDecl(TraitDeclNode(name, genericParams, methods, isPrivate))
}

fn parseImplDecl(parser: Parser) -> ASTNode {
    consume(parser, TokType.Identifier, "Expected trait name.")
    val traitName = parser.previousToken.text
    consume(parser, TokType.KeywordFor, "Expected 'for' after trait name in impl.")
    consume(parser, TokType.Identifier, "Expected type name.")
    val typeName = parser.previousToken.text
    consume(parser, TokType.OpenBrace, "Expected '{' before impl body.")
        var methods = []
        while check(parser, TokType.CloseBrace) == false && isAtEnd(parser) == false {
            methods.push(parseStatement(parser))
        }
        consume(parser, TokType.CloseBrace, "Expected '}' after impl body.")
    return ASTNode.ImplDecl(ImplDeclNode(traitName, typeName, methods))
}

fn parseConstDecl(parser: Parser, isPrivate: bool) -> ASTNode {
    consume(parser, TokType.Identifier, "Expected constant name.")
    val name = parser.previousToken.text
    consume(parser, TokType.Equal, "Expected '=' after constant name.")
    val value = parseExpression(parser)
    return ASTNode.ConstDecl(ConstDeclNode(name, value, isPrivate))
}

fn parseScheduleDecl(parser: Parser) -> ASTNode {
    consume(parser, TokType.IntegerLiteral, "Expected amount (number).")
    val amount = parser.previousToken.text
    consume(parser, TokType.Identifier, "Expected time unit.")
    val unit = parser.previousToken.text
    var atTime = ""
    if matchToken(parser, TokType.Identifier) && parser.previousToken.text == "at" {
        consume(parser, TokType.IntegerLiteral, "Expected time value.")
        atTime = parser.previousToken.text
    }
    consume(parser, TokType.FatArrow, "Expected '=>' after schedule.")
    val handler = parseExpression(parser)
    return ASTNode.ScheduleDecl(ScheduleDeclNode(amount, unit, atTime, handler))
}

fn parseConfigDecl(parser: Parser) -> ASTNode {
    val key = parser.currentToken.text
    advanceParser(parser)
    val value = parseExpression(parser)
    return ASTNode.ConfigDecl(ConfigDeclNode(key, value))
}

fn parseStatement(parser: Parser) -> ASTNode {
    val bTag = parser.currentToken.tag
    val bLine = parser.currentToken.line
    val bCol = parser.currentToken.col
    parser.depth = parser.depth + 1
    var out = ASTNode.Literal(LiteralNode("int", "0"))
    if parseDepthGuard(parser) == false {
        out = parseStatementInner(parser)
    }
    parser.depth = parser.depth - 1
    // Panic-mode recovery: a statement parse that consumed nothing must
    // advance anyway, otherwise enclosing block loops spin forever.
    if parser.currentToken.tag == bTag && parser.currentToken.line == bLine && parser.currentToken.col == bCol && isAtEnd(parser) == false {
        advanceParser(parser)
    }
    return out
}

fn parseStatementInner(parser: Parser) -> ASTNode {
    if matchToken(parser, TokType.KeywordVal) {
        return parseVarDecl(parser, false)
    }
    if matchToken(parser, TokType.KeywordVar) {
        return parseVarDecl(parser, true)
    }
    if matchToken(parser, TokType.KeywordConst) {
        return parseConstDecl(parser, false)
    }
    if matchToken(parser, TokType.KeywordReturn) {
        if check(parser, TokType.KeywordOk) {
            advanceParser(parser)
            var statusText = ""
            if check(parser, TokType.IntegerLiteral) {
                statusText = parser.currentToken.text
                advanceParser(parser)
            }
            var expr = ASTNode.Empty
            if check(parser, TokType.SemiColon) == false && check(parser, TokType.CloseBrace) == false {
                expr = parseExpression(parser)
            }
            matchToken(parser, TokType.SemiColon)
            return ASTNode.ReturnOk(ReturnOkNode(expr, statusText))
        }
        var expr = ASTNode.Empty
        if check(parser, TokType.SemiColon) == false && check(parser, TokType.CloseBrace) == false {
            expr = parseExpression(parser)
        }
        return ASTNode.Return(ReturnNode(expr))
    }
    if matchToken(parser, TokType.KeywordIf) {
        return parseIfStatement(parser)
    }
    if matchToken(parser, TokType.KeywordErr) {
        var codeText = "500"
        if check(parser, TokType.IntegerLiteral) {
            codeText = parser.currentToken.text
            advanceParser(parser)
        }
        var message = ASTNode.Empty
        if check(parser, TokType.SemiColon) == false && check(parser, TokType.CloseBrace) == false {
            message = parseExpression(parser)
        }
        matchToken(parser, TokType.SemiColon)
        return ASTNode.ReturnErr(ReturnErrNode(message, codeText))
    }
    if matchToken(parser, TokType.KeywordWhile) {
        return parseWhileStatement(parser)
    }
    if matchToken(parser, TokType.KeywordFor) {
        return parseForStatement(parser)
    }
    if matchToken(parser, TokType.KeywordMatch) {
        return parseMatchStatement(parser)
    }
    if matchToken(parser, TokType.KeywordBreak) {
        return ASTNode.Break(BreakNode())
    }
    if matchToken(parser, TokType.KeywordContinue) {
        return ASTNode.Continue(ContinueNode())
    }
    return parseExpression(parser)
}

fn parseDeclaration(parser: Parser) -> ASTNode {
    if check(parser, TokType.EOF) {
        return ASTNode.Empty
    }
    if check(parser, TokType.Invalid) {
        parserError(parser, "Invalid character: " + parser.currentToken.text)
        advanceParser(parser)
        return ASTNode.Empty
    }
    // Decorators
    var decorators = []
    while check(parser, TokType.At) {
        matchToken(parser, TokType.At)
        consume(parser, TokType.Identifier, "Expected decorator name.")
        decorators.push(ASTNode.Decorator(DecoratorNode(parser.previousToken.text, [])))
    }

    val isPrivate = matchToken(parser, TokType.KeywordPrivate)
    val isExtern = matchToken(parser, TokType.KeywordExtern)

    if check(parser, TokType.Identifier) {
        val text = parser.currentToken.text
        if text == "port" || text == "cors" || text == "db" || text == "env" {
            return parseConfigDecl(parser)
        }
    }

    if matchToken(parser, TokType.KeywordEvery) {
        return parseScheduleDecl(parser)
    }

    if matchToken(parser, TokType.KeywordImport) {
        consume(parser, TokType.StringLiteral, "Expected import path.")
        val path = parser.previousToken.text
        return ASTNode.ImportStmt(ImportStmtNode(path))
    }

    if matchToken(parser, TokType.KeywordUse) {
        consume(parser, TokType.Identifier, "Expected module name.")
        val module = parser.previousToken.text
        return ASTNode.UseStmt(UseStmtNode(module))
    }

    if matchToken(parser, TokType.KeywordModel) {
        return parseModelDecl(parser, isPrivate)
    }

    if matchToken(parser, TokType.KeywordRoute) {
        return parseRouteDecl(parser, decorators)
    }

    if check(parser, TokType.KeywordFn) || check(parser, TokType.KeywordAsync) {
        return parseFunctionDecl(parser, isPrivate, isExtern)
    }

    if matchToken(parser, TokType.KeywordVal) {
        return parseVarDecl(parser, false)
    }

    if matchToken(parser, TokType.KeywordVar) {
        return parseVarDecl(parser, true)
    }

    if matchToken(parser, TokType.KeywordConst) {
        return parseConstDecl(parser, isPrivate)
    }

    val declTag = parser.currentToken.tag
    if check(parser, TokType.KeywordType) || check(parser, TokType.KeywordEnum) || check(parser, TokType.KeywordUnion) {
        advanceParser(parser)
        return parseTypeDecl(parser, declTag, isPrivate)
    }

    if matchToken(parser, TokType.KeywordTrait) {
        return parseTraitDecl(parser, isPrivate)
    }

    if matchToken(parser, TokType.KeywordImpl) {
        return parseImplDecl(parser)
    }

    val expr = parseExpression(parser)
    return ASTNode.ExpressionStmt(ExpressionStmtNode(expr))
}

fn parseProgram(parser: Parser) -> ASTNode {
    var decls = []
    while check(parser, TokType.EOF) == false {
        val pLine = parser.currentToken.line
        val pCol = parser.currentToken.col
        val decl = parseDeclaration(parser)
        decls.push(decl)
        if parser.currentToken.line == pLine && parser.currentToken.col == pCol && check(parser, TokType.EOF) == false {
            advanceParser(parser)
        }
    }
    return ASTNode.Program(ProgramNode(decls))
}



