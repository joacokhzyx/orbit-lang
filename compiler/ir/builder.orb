// AST->IR lowering with variable scopes and list-kind tracking.
// Large by intent (~3900 lines); the scale is declared, not hidden.
import "../front/ast.orb"
import "../host/extern.orb"
import "./ir.orb"
import "../front/literal.orb"

model IRBuilder {
    module: IRModule
    currentFunction: IRFunction
    labelCounter: int
    variableScopes: list < VarScope >
    loopStartLabels: list < int >
    loopEndLabels: list < int >
    // Names of the loops on the two stacks above, in lockstep: "" for an
    // unlabeled loop (while always pushes ""), the label otherwise. Only
    // recordInstanceModel-style push discipline applies: every push to the
    // label stacks pushes here, closeLoop pops all four, or a later break
    // jumps to the wrong loop.
    loopLabelNames: list < string >
    // Where a `continue` (plain or named) jumps for each loop on the stacks,
    // in lockstep with them. A `while` continues at its start label, but a
    // `for` must continue at its increment: jumping a `for` to its start
    // reloads the same index forever, which is how a plain `continue` in a
    // `for` used to hang. Fourth stack, same push/pop discipline.
    loopContinueLabels: list < int >
    // Generic function templates by name, as parallel lists (the name and
    // the FunctionDecl node). Templates emit no C themselves: each call site
    // monomorphises its own instance through ensureFnInstance below.
    genericFnNames: list < string >
    genericFnDecls: list < ASTNode >
    // Type-variable bindings for the instance under construction, as a stack
    // of frames: parameter names comma-joined beside arguments tab-joined
    // (type spellings never contain tabs, and parameter names never contain
    // commas). Frames nest strictly -- an instance builds its body, which
    // may ensure a nested instance, then pops -- so push/pop pair up and no
    // marks are needed. Lookups run innermost-first, so an inner `T`
    // shadows an outer one, and chaining falls out: substituting frame by
    // frame turns `list<U>` with U->T into `list<T>` for the outer frame.
    fnGenericParams: list < string >
    fnGenericArgs: list < string >
    // Model instance bindings per variable, as parallel lists (the name, the
    // model's own name, the arguments tab-joined), with frame marks like
    // listKindMarks: a `Box { v: 1 }` bound to `b` answers "T int" for `b`
    // while its scope lives, so a generic call taking `b` infers from
    // history, not from the lossy instance-name spelling.
    genInstNames: list < string >
    genInstModels: list < string >
    genInstArgs: list < string >
    genInstMarks: list < int >
    // Queued generic instances: the substituted declaration, the parameter
    // names joined, the bindings joined. ensureFnInstance only registers the
    // prototype; drainFnInstances builds the bodies after pass 3, so no
    // instance ever builds with a caller's scope open.
    fnWorkDecls: list < ASTNode >
    fnWorkParams: list < string >
    fnWorkArgs: list < string >
    modelNames: list < string >
    returnTypes: list < Variable >
    // Element type per named list, as `name -> Orbit type name` (Variable).
    // A list literal knows its own kind; a `var xs = []` that is filled by
    // push() learns it from the first push it can type. Separate from the
    // ordinary variable table because a list's element type is not the
    // variable's type: `var xs: list` says nothing about what is in it.
    listKinds: list < Variable >
    // listKinds length at each open block scope. The array is flat, and a
    // variable declared in one function is an *unrelated* variable in the
    // next: `l: list<string>` in getOr and `l: list<int>` in containsInt are
    // both named `l`. lookupListKind returns the most recent match, so
    // without per-scope marks, the later reader won -- the *read* side was
    // built with the *last writer's* kind, `list<int>` and `list<string>`
    // both taking `l`. The whole std got one elemKind for `l`. Restored on
    // popVariableScope exactly as variableScopes is.
    listKindMarks: list < int >
    // The generic model DECLARATIONS, as IRModelDecl with typeParams filled.
    // Separate from module.models because that list is what the emitter walks,
    // and a declaration's field types are not C types until a use fixes them.
    // An instantiation is pushed back into module.models under its own name.
    genericModels: list < IRModelDecl >
    // Disambiguator for shadowed locals. Minted C names come from here, in
    // AST walk order, so they are deterministic across runs.
    varSeq: int
    // Every local declared so far in the functions being built, as
    // `cname -> type`, and where the current function's entries start. Scopes
    // pop, so two match arms can each declare `t` and the second would reuse
    // the first's C name with another type. defineVariable consults this list
    // to give a local one type for the whole function.
    fnLocals: list < Variable >
    fnLocalMark: int
}

fn initIRBuilder() -> IRBuilder {
    val mod = initIRModule()
    val mainFn = initIRFunction("orbit_main")
    return IRBuilder(mod, mainFn, 0, [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], 0, [], 0)
}

model Variable {
    name: string
    // The C name this declaration owns. Usually the spelling; when a live
    // outer scope already declares `name`, `name__sN`. The backend declares
    // one C variable per cname, so shadowing can no longer clobber.
    cname: string
    typeVal: string
}

model VarScope {
    variables: list < Variable >
}

fn initScope() -> VarScope {
    return VarScope([])
}

fn pushVariableScope(builder: IRBuilder) {
    builder.variableScopes.push(initScope())
    builder.listKindMarks.push(builder.listKinds.len())
    builder.genInstMarks.push(builder.genInstNames.len())
}

fn popVariableScope(builder: IRBuilder) {
    if builder.variableScopes.len() > 0 {
        builder.variableScopes.pop()
    }
    // Pop of a block restores the list-kind registry: entries laid down in a
    // block are not visible after it, same as variables.
    if builder.listKindMarks.len() > 0 {
        val mark = builder.listKindMarks.pop()
        while builder.listKinds.len() > mark {
            builder.listKinds.pop()
        }
    }
    // Same lifetime for model instance bindings: a `Box { v: 1 }` bound in a
    // block answers history only while its scope lives.
    if builder.genInstMarks.len() > 0 {
        val mark = builder.genInstMarks.pop()
        while builder.genInstNames.len() > mark {
            builder.genInstNames.pop()
            builder.genInstModels.pop()
            builder.genInstArgs.pop()
        }
    }
}

fn currentScopeAdd(scope: VarScope, name: string, cname: string, typeVal: string) {
    scope.variables.push(Variable(name, cname, typeVal))
}

// The last declaration of `name` wins, walking backwards -- which is what both
// callers did, and why a re-declaration in an inner scope shadows the outer one.
// The sentinel is a parameter rather than a shared constant because the two
// callers answer differently on absence: a return type that cannot be found is
// "unknown" and has to stay that, while an undeclared list kind is "" because
// "" is what tells listKindNameOf that nothing has pushed a kind yet.
fn lookupLastVariableType(vars: list < Variable >, name: string, absent: string) -> string {
    var i = vars.len()
    while i > 0 {
        i = i - 1
        val v: Variable = vars.get(i)
        if checkVariableName(v, name) {
            return getVariableType(v)
        }
    }
    return absent
}

fn checkVariableName(v: Variable, name: string) -> bool {
    return v.name == name
}

fn getVariableType(v: Variable) -> string {
    return v.typeVal
}

fn scopeGet(scope: VarScope, name: string) -> string {
    var i = scope.variables.len()
    while i > 0 {
        i = i - 1
        val v = scope.variables.get(i)
        if checkVariableName(v, name) {
            return getVariableType(v)
        }
    }
    return "unknown"
}

fn defineVariable(builder: IRBuilder, name: string, typeVal: string) -> string {
    val len = builder.variableScopes.len()
    if len == 0 {
        pushVariableScope(builder)
    }
    var cname = mintVariableName(builder, name)
    val seen = fnLocalType(builder, cname)
    if seen != "" && seen != typeVal {
        val n = builder.varSeq
        builder.varSeq = n + 1
        cname = name + "__s" + n
    }
    builder.fnLocals.push(Variable(name, cname, typeVal))
    val currentScope = builder.variableScopes.get(builder.variableScopes.len() - 1)
    currentScopeAdd(currentScope, name, cname, typeVal)
    return cname
}

// The type the current function gave the C name `cname` the first time it
// declared it, or "" when it has not.
fn fnLocalType(builder: IRBuilder, cname: string) -> string {
    var i = builder.fnLocals.len()
    while i > builder.fnLocalMark {
        i = i - 1
        val v: Variable = builder.fnLocals.get(i)
        if v.cname == cname {
            return v.typeVal
        }
    }
    return ""
}

fn endFnLocals(builder: IRBuilder, prevMark: int) {
    while builder.fnLocals.len() > builder.fnLocalMark {
        builder.fnLocals.pop()
    }
    builder.fnLocalMark = prevMark
}

// True when any live scope declares `name`. Scopes pop, so a declaration in
// a closed block is not live and does not force a mint.
fn scopeHasName(builder: IRBuilder, name: string) -> bool {
    var i = builder.variableScopes.len()
    while i > 0 {
        i = i - 1
        val scope: VarScope = builder.variableScopes.get(i)
        var j = scope.variables.len()
        while j > 0 {
            j = j - 1
            val v: Variable = scope.variables.get(j)
            if checkVariableName(v, name) {
                return true
            }
        }
    }
    return false
}

// The C name for a declaration of `name` here: the spelling, unless a live
// outer scope already owns it, in which case `name__sN`. The counter lives
// on the builder so mints follow AST walk order and stay deterministic.
// Without shadowing the cname IS the spelling, which is what keeps the
// emitted C byte-identical for every program that never redeclares.
fn mintVariableName(builder: IRBuilder, name: string) -> string {
    if scopeHasName(builder, name) == false {
        return name
    }
    val n = builder.varSeq
    builder.varSeq = n + 1
    return name + "__s" + n
}

// The C name a read or write of `name` means here: the innermost live
// declaration's cname, or the spelling when nothing declares it (globals,
// enum constants, and anything genuinely unknown pass through unchanged,
// so converting a site that is not a variable is a no-op by construction).
fn variableSymbol(builder: IRBuilder, name: string) -> string {
    var i = builder.variableScopes.len()
    while i > 0 {
        i = i - 1
        val scope: VarScope = builder.variableScopes.get(i)
        var j = scope.variables.len()
        while j > 0 {
            j = j - 1
            val v: Variable = scope.variables.get(j)
            if checkVariableName(v, name) {
                return v.cname
            }
        }
    }
    return name
}

fn lookupVariable(builder: IRBuilder, name: string) -> string {
    var i = builder.variableScopes.len()
    while i > 0 {
        i = i - 1
        val scope = builder.variableScopes.get(i)
        val typeVal = scopeGet(scope, name)
        if typeVal != "unknown" {
            return typeVal
        }
    }
    return "unknown"
}

fn registerFunctionReturnType(builder: IRBuilder, name: string, typeVal: string) {
    builder.returnTypes.push(Variable(name, name, typeVal))
}

// What type does the frontend say a builtin call returns, without a builder in
// hand?
//
// The table above is the frontend's answer, and it is the one that has to be
// right: it is what gives a call result a register type. c_backend.orb kept a
// second copy of the same knowledge for its own purposes, and the two drifted
// -- feBuildTimeCallType did not list orbit_response_error, orbit_auth_role,
// or the three crypto helpers, so the backend answered "unknown" for calls the
// frontend had typed. "unknown" is the safe answer for a string, because
// refusing to guess is what keeps a scalar from being hoisted as an integer.
// It is not safe for a result or a response, which is the exact failure the
// comment in ensureDefIndex describes: an aggregate bound to a val, hoisted as
// uintptr_t, and an aggregate-to-integer C error from the C compiler.
//
// So the backend asks here instead of keeping its own list, and a builtin the
// frontend types can never be unknown to the emitter.
fn builtinReturnType(name: string) -> string {
    if name == "orbit_base64url_encode_str" { return "string" }
    if name == "orbit_sha256_hex" { return "string" }
    if name == "orbit_hmac_sha256_base64url" { return "string" }
    if name == "orbit_auth_bearer_token" { return "string" }
    if name == "orbit_auth_current_role" { return "string" }
    if name == "orbit_auth_role" { return "string" }
    if name == "orbit_auth_has_role" { return "bool" }
    if name == "orbit_cache_get" { return "string" }
    if name == "orbit_cache_set" { return "bool" }
    if name == "orbit_file_upload_save" { return "string" }
    if name == "orbit_http_param_get" { return "string" }
    if name == "orbit_http_body_get" { return "string" }
    if name == "orbit_http_query_get" { return "string" }
    if name == "orbit_http_header_get" { return "string" }
    if name == "orbit_http_client_fetch" { return "result" }
    if name == "orbit_http_query_get_all" { return "list" }
    if name == "orbit_db_query_all" { return "string" }
    if name == "orbit_db_query_where" { return "string" }
    if name == "orbit_db_query_where_p" { return "string" }
    if name == "orbit_db_query_where_v" { return "string" }
    if name == "orbit_db_query_get" { return "string" }
    if name == "orbit_db_query_first" { return "string" }
    if name == "orbit_db_query_order" { return "string" }
    if name == "orbit_db_query_order_desc" { return "string" }
    if name == "orbit_db_count_all" { return "int" }
    if name == "orbit_db_count_v" { return "int" }
    if name == "orbit_db_insert" { return "bool" }
    if name == "orbit_db_update" { return "bool" }
    if name == "orbit_db_delete" { return "bool" }
    if name == "orbit_string_len" { return "int" }
    if name == "orbit_string_indexOf" { return "int" }
    if name == "orbit_string_slice" { return "string" }
    if name == "orbit_string_slice_known_len" { return "string" }
    if name == "orbit_os_isatty_selfhost" { return "bool" }
    // The first float in this table: a float a call returns still has to be
    // a float where it lands, or the hoisted local is an integer slot and
    // the value truncates on the way in (`val v = orbit_string_to_float`
    // bound 1.5 and read back 1.0). Nothing else here returns a float, so
    // the absence never showed until a float-returning extern was stored.
    if name == "orbit_string_to_float" { return "float" }
    // Float getters over parsed JSON share the same store-or-truncate
    // shape: the call answers a double and only this row keeps it one.
    if name == "orbit_object_get_float" { return "float" }
    if name == "orbit_json_array_get_float" { return "float" }
    if name == "orbit_response_json" { return "response" }
    if name == "orbit_response_error" { return "response" }
    if name == "system_uptime" { return "int" }
    if name == "system_pid" { return "int" }
    if name == "system_active_workers" { return "int" }
    if name == "system_http_requests_total" { return "int" }
    if name == "system_latency_avg_us" { return "int" }
    if name == "system_latency_p50_us" { return "int" }
    if name == "system_latency_p95_us" { return "int" }
    if name == "system_latency_p99_us" { return "int" }
    if name == "ok" || name == "err" { return "result" }
    // A result bound straight to a name hoists as an integer without this:
    // the def-index reads no other table, and an OrbitResult is a struct,
    // so the store is a C type error naming generated code.
    if name == "orbit_random_bytes" { return "result" }
    if name == "orbit_json_parse" { return "result" }
    return ""
}

fn lookupFunctionReturnType(builder: IRBuilder, name: string) -> string {
    val fromTable = lookupLastVariableType(builder.returnTypes, name, "unknown")
    if fromTable != "unknown" { return fromTable }
    // Builtins live in builtinReturnType, not in a startup table, so there is
    // only one list that can drift. User functions still come from the table.
    val builtin = builtinReturnType(name)
    if builtin != "" { return builtin }
    return "unknown"
}

fn lowercaseModelChar(c: int, source: string, idx: int) -> string {
    if c == 65 { return "a" }
    if c == 66 { return "b" }
    if c == 67 { return "c" }
    if c == 68 { return "d" }
    if c == 69 { return "e" }
    if c == 70 { return "f" }
    if c == 71 { return "g" }
    if c == 72 { return "h" }
    if c == 73 { return "i" }
    if c == 74 { return "j" }
    if c == 75 { return "k" }
    if c == 76 { return "l" }
    if c == 77 { return "m" }
    if c == 78 { return "n" }
    if c == 79 { return "o" }
    if c == 80 { return "p" }
    if c == 81 { return "q" }
    if c == 82 { return "r" }
    if c == 83 { return "s" }
    if c == 84 { return "t" }
    if c == 85 { return "u" }
    if c == 86 { return "v" }
    if c == 87 { return "w" }
    if c == 88 { return "x" }
    if c == 89 { return "y" }
    if c == 90 { return "z" }
    return orbit_string_slice(source, idx, idx + 1)
}

fn modelTableName(name: string) -> string {
    var table = ""
    var i = 0
    while i < orbit_string_len(name) {
        table = table + lowercaseModelChar(name.at(i), name, i)
        i = i + 1
    }
    return table + "s"
}

fn fieldTypeOfModel(builder: IRBuilder, typeName: string, fieldName: string) -> string {
    val t = modelFieldTypeOf(builder, typeName, fieldName)
    if t == "! no such model field" { return "unknown" }
    return t
}

// The model-then-field walk both of the above need, with the answer and the
// "no such field" case kept apart. They used to be the same seventeen lines
// written twice, and the temptation was to define modelHasField as
// `fieldTypeOfModel(...) != "unknown"` -- which quietly changes its meaning for
// a field that is declared with no type at all, since "" is a plausible typeVal
// and is not "unknown". A sentinel that cannot be a type name is the honest
// way to say "absent". The language has no module-level constant, so the
// sentinel is this literal in the three places that need it, and it is spelled
// with a leading "!" because no declared type name can start with one.
fn modelFieldTypeOf(builder: IRBuilder, typeName: string, fieldName: string) -> string {
    var mi = 0
    while mi < builder.module.models.len() {
        val m: IRModelDecl = builder.module.models.get(mi)
        if m.name == typeName {
            var fi = 0
            while fi < m.fields.len() {
                val f: IRModelField = m.fields.get(fi)
                if f.name == fieldName {
                    return f.typeName
                }
                fi = fi + 1
            }
        }
        mi = mi + 1
    }
    return "! no such model field"
}

// Is `name` a model this program declares? An object literal in a position
// whose declared type is one is that model's struct, not the runtime object. A
// generic declaration counts: `Box { v: 1 }` is a struct either way, and which
// struct is decided by the instantiation this call reaches below.
fn isModelDeclName(builder: IRBuilder, name: string) -> bool {
    var i = 0
    while i < builder.module.models.len() {
        val m: IRModelDecl = builder.module.models.get(i)
        if m.name == name { return true }
        i = i + 1
    }
    var gi = 0
    while gi < builder.genericModels.len() {
        val gm: IRModelDecl = builder.genericModels.get(gi)
        if gm.name == name { return true }
        gi = gi + 1
    }
    return false
}

/* ── Monomorphisation ────────────────────────────────────────────────────────
 *
 * `model Box[T] { v: T }` is one declaration and many structs. There is no
 * grammar for a type argument at an expression site -- `Box<int>` lexes as a
 * comparison, and adding one is a far bigger change than the feature is worth
 * -- so the argument is INFERRED from the literal that fixes it. `Box { v: 1 }`
 * is `Box_int` and `Box { v: "hi" }` is `Box_string`: two C structs that share
 * no storage and no member names, each emitted by the same code that has always
 * emitted a model's struct, because an instantiation is an ordinary IRModelDecl
 * with its fields already substituted. `T` therefore never reaches mapTypeToC,
 * which has no case for it and is not given one.
 *
 * Three functions, deliberately in this order. The name is PURE, so a use site
 * that asks what type a literal is and the site that builds it cannot disagree
 * about which struct it is; the registration is IMPURE and idempotent; and the
 * inference both read is one walk over the literal, so there is one answer.
 */

// Which type parameter does `declared` stand for, or -1 when it is not exactly
// one. A field declared `T` is bound by the value written for it. A field
// declared anything that merely MENTIONS a parameter binds nothing, which is
// what turns a parameter nothing determines into a diagnostic instead of a
// guess: there is no `unknown` to substitute and no second question to ask.
fn typeParamIndex(params: list < string >, declared: string) -> int {
    var i = 0
    while i < params.len() {
        if params.get(i) == declared { return i }
        i = i + 1
    }
    return -1
}

// `list<T>`, reduced to the element slot: the index of T in it, or -1 for
// anything else. One level is what a model field can be lowered with -- a
// `list<list<T>>` field has no element type to read, and inventing one would
// be a type nobody declared.
// The index of the parameter inside `declared`'s innermost list, or -1. The
// peel itself is in literal.orb, because the checker peels the same way and two
// copies of this rule disagreed: the checker reached the parameter in a
// `list<list<T>>` field and the builder did not, so the same literal checked as
// `list<list<float>>` and built as `Nested_unknown`.
fn listElementParamIndex(params: list < string >, declared: string) -> int {
    return typeParamIndex(params, listPeeledInner(declared))
}

// The argument a whole word stands for, or the word unchanged. Keeping this
// word-at-a-time is the difference between substituting a type parameter and
// corrupting a type name: the `T` in `T` is the parameter, and the `T` in
// `string` is not.
fn argumentForTypeName(word: string, params: list < string >, args: list < string >) -> string {
    val idx = typeParamIndex(params, word)
    if idx < 0 || idx >= args.len() { return word }
    val a = args.get(idx)
    if a == "" { return word }
    return a
}

// The declared type with every type parameter replaced by its argument. `T`
// becomes `int` before anything is lowered, and `list<T>` becomes `list<int>`
// by the same walk -- which is exactly the string a model written out longhand
// would have had, so every downstream rule reads it the way it always has.
fn substituteTypeParams(declared: string, params: list < string >, args: list < string >) -> string {
    var out = ""
    var i = 0
    while i < orbit_string_len(declared) {
        if isTypeNameChar(declared.at(i)) {
            var j = i
            while j < orbit_string_len(declared) {
                if isTypeNameChar(declared.at(j)) == false { break }
                j = j + 1
            }
            out = out + argumentForTypeName(declared.slice(i, j), params, args)
            i = j
        } else {
            out = out + declared.slice(i, i + 1)
            i = i + 1
        }
    }
    return out
}

// The type arguments a literal fixes, in declaration order, one per parameter.
// A parameter nothing determines stays "unknown", which is this compiler's
// standing answer for a value it could not type and which mapTypeToC has always
// lowered to `void*`. It is not a new sentinel: a field of an untyped model is
// already emitted that way, and the struct name says so (`Box_unknown`).
//
// Fields are walked in DECLARATION order and the first one that determines a
// parameter wins. The literal is keyed and the model is ordered, so declaration
// order is the only order both agree on; and first-wins makes the answer a
// function of the model rather than of the keys, which is what stops the
// checker and this builder disagreeing about which struct a literal is.
// The element of a list literal `depth` levels down, or Empty.
fn listLiteralValueAtDepth(node: ASTNode, depth: int) -> ASTNode {
    var current = node
    var d = 0
    while d < depth {
        match current {
            ASTNode.ListLiteral(ll) => {
                if ll.elements.len() == 0 { return ASTNode.Empty }
                current = ll.elements.get(0)
            }
            _ => { return ASTNode.Empty }
        }
        d = d + 1
    }
    return current
}

fn modelLiteralArgTypes(builder: IRBuilder, gm: IRModelDecl, literal: ASTNode) -> list < string > {
    var args: list < string > = []
    var p = 0
    while p < gm.typeParams.len() {
        args.push("unknown")
        p = p + 1
    }
    var fi = 0
    while fi < gm.fields.len() {
        val f: IRModelField = gm.fields.get(fi)
        val valueNode = literalFieldValue(literal, f.name)
        val direct = typeParamIndex(gm.typeParams, f.typeName)
        if direct >= 0 {
            if args.get(direct) == "unknown" {
                // Inside a generic instance the value's type may name a
                // parameter: resolve it here, or the literal instantiates
                // `Box_T` instead of the call's `Box_int`.
                args.set(direct, resolveFnType(builder, staticExprTypeName(builder, valueNode)))
            }
        }
        val elem = listElementParamIndex(gm.typeParams, f.typeName)
        if elem >= 0 {
            if args.get(elem) == "unknown" {
                // The depth the peel reached is the depth the value has to be
                // descended to match: the last peel produced the parameter name,
                // not a list, so the list holding that parameter's values is one
                // level above it.
                val depth = listPeelDepth(f.typeName) - 1
                if depth >= 0 {
                    match listLiteralValueAtDepth(valueNode, depth) {
                        ASTNode.ListLiteral(ll) => { args.set(elem, resolveFnType(builder, listLiteralKindName(builder, ll))) }
                        _ => {}
                    }
                }
            }
        }
        fi = fi + 1
    }
    return args
}

// The generic declaration called `name`, or NULL.
fn genericModelByName(builder: IRBuilder, name: string) -> IRModelDecl {
    var gi = 0
    while gi < builder.genericModels.len() {
        val gm: IRModelDecl = builder.genericModels.get(gi)
        if gm.name == name { return gm }
        gi = gi + 1
    }
    return NULL
}

// The name this literal's instantiation carries: the model's own name unchanged
// when it has no type parameters, `Model_arg_arg` when it has.
//
// PURE. A binding asks this what type its value is before anything is built,
// and the build asks it again for the constructor name; one answer for both is
// what makes `val b = Box { v: 1 }` bind `b` to the struct that was emitted.
fn modelInstanceName(builder: IRBuilder, modelName: string, literal: ASTNode) -> string {
    val gm = genericModelByName(builder, modelName)
    if gm == NULL { return modelName }
    val args = modelLiteralArgTypes(builder, gm, literal)
    var out = modelName
    var i = 0
    while i < args.len() {
        out = out + "_" + mangleTypeArg(args.get(i))
        i = i + 1
    }
    return out
}

// Register the instantiation and return its name. The one impure step, and
// idempotent: a second `Box { v: 1 }` finds the struct the first one declared
// and is lowered against it. Two literals that infer the same arguments are the
// same type, and that is what makes the struct rather than the literal the unit
// of monomorphisation.
fn ensureModelInstance(builder: IRBuilder, modelName: string, literal: ASTNode) -> string {
    val gm = genericModelByName(builder, modelName)
    if gm == NULL { return modelName }
    val instance = modelInstanceName(builder, modelName, literal)
    var mi = 0
    while mi < builder.module.models.len() {
        val m: IRModelDecl = builder.module.models.get(mi)
        if m.name == instance { return instance }
        mi = mi + 1
    }
    val args = modelLiteralArgTypes(builder, gm, literal)
    val fields = []
    var fi = 0
    while fi < gm.fields.len() {
        val f: IRModelField = gm.fields.get(fi)
        fields.push(IRModelField(f.name, substituteTypeParams(f.typeName, gm.typeParams, args)))
        fi = fi + 1
    }
    builder.module.models.push(IRModelDecl(instance, fields, []))
    return instance
}

// Register the instantiation for WRITTEN arguments -- `Box<int>` in a
// signature or an annotation -- and return its name.
fn ensureModelInstanceFromArgs(builder: IRBuilder, modelName: string, args: list < string >) -> string {
    val gm = genericModelByName(builder, modelName)
    if gm == NULL { return "" }
    if args.len() != gm.typeParams.len() { return "" }
    var mi = 0
    while mi < builder.module.models.len() {
        val m: IRModelDecl = builder.module.models.get(mi)
        if m.name == modelName { return modelName }
        mi = mi + 1
    }
    var instance = modelName
    var ai = 0
    while ai < args.len() {
        instance = instance + "_" + mangleTypeArg(args.get(ai))
        ai = ai + 1
    }
    mi = 0
    while mi < builder.module.models.len() {
        val m: IRModelDecl = builder.module.models.get(mi)
        if m.name == instance { return instance }
        mi = mi + 1
    }
    val fields = []
    var fi = 0
    while fi < gm.fields.len() {
        val f: IRModelField = gm.fields.get(fi)
        fields.push(IRModelField(f.name, substituteTypeParams(f.typeName, gm.typeParams, args)))
        fi = fi + 1
    }
    builder.module.models.push(IRModelDecl(instance, fields, []))
    return instance
}

// The instance a declared type names, registering it if this is the first
// mention. `Box<int>` -> `Box_int`.
fn declaredTypeInstanceName(builder: IRBuilder, declared: string) -> string {
    val lt = orbit_string_indexOf(declared, "<")
    if lt <= 0 { return "" }
    val bare = orbit_string_slice(declared, 0, lt)
    if genericModelByName(builder, bare) == NULL { return "" }
    val n = orbit_string_len(declared)
    if n < 2 { return "" }
    if orbit_string_slice(declared, n - 1, n) != ">" { return "" }
    val args = splitTypeArgs(orbit_string_slice(declared, lt + 1, n - 1))
    if args.len() == 0 { return "" }
    return ensureModelInstanceFromArgs(builder, bare, args)
}

fn splitTypeArgs(s: string) -> list < string > {
    var out = []
    var cur = ""
    var depth = 0
    var i = 0
    while i < orbit_string_len(s) {
        val c = s.at(i)
        if c == 60 { depth = depth + 1 }
        if c == 62 { depth = depth - 1 }
        if c == 44 && depth == 0 {
            out.push(trimTypeArg(cur))
            cur = ""
        } else {
            cur = cur + s.slice(i, i + 1)
        }
        i = i + 1
    }
    if orbit_string_len(trimTypeArg(cur)) > 0 { out.push(trimTypeArg(cur)) }
    return out
}

// A generic template by name, or Empty when no template declares it. Kept
// beside the declaration (parallel lists, the instance-map shape) so the
// function table stays closed to one-C-function names.
fn genericFnByName(builder: IRBuilder, name: string) -> ASTNode {
    var i = 0
    while i < builder.genericFnNames.len() {
        if builder.genericFnNames.get(i) == name {
            return builder.genericFnDecls.get(i)
        }
        i = i + 1
    }
    return ASTNode.Empty
}

fn recordGenericFn(builder: IRBuilder, f: FunctionDeclNode) {
    var i = 0
    while i < builder.genericFnNames.len() {
        if builder.genericFnNames.get(i) == f.name { return }
        i = i + 1
    }
    builder.genericFnNames.push(f.name)
    builder.genericFnDecls.push(ASTNode.FunctionDecl(f))
}

// Record one model instance binding: variable `varName` was built from
// model `modelName` with the given argument spellings, in the model's
// parameter order. The scope marks truncate it on pop, so history never
// outlives the binding.
fn recordGenericInstance(builder: IRBuilder, varName: string, modelName: string, args: list < string >) {
    var joined = ""
    var i = 0
    while i < args.len() {
        if i > 0 { joined = joined + "\t" }
        val a: string = args.get(i)
        joined = joined + a
        i = i + 1
    }
    builder.genInstNames.push(varName)
    builder.genInstModels.push(modelName)
    builder.genInstArgs.push(joined)
}

// The instance rows behind one argument, in "model-param arg" order: recorded
// history for a variable, recomputed bindings for a literal in hand, nothing
// otherwise. An instance name (`Box_int`) is not an application, so the
// model's own parameters are read off the declaration site instead of peeled
// from the spelling.
fn genericInstanceRows(builder: IRBuilder, modelName: string, node: ASTNode) -> list < string > {
    val gm = genericModelByName(builder, modelName)
    if gm == NULL { return [] }
    match node {
        ASTNode.Literal(l) => {
            if l.valType == "identifier" {
                var i = builder.genInstNames.len()
                while i > 0 {
                    i = i - 1
                    val n: string = builder.genInstNames.get(i)
                    if n == l.text {
                        val m: string = builder.genInstModels.get(i)
                        if m == modelName {
                            val a: string = builder.genInstArgs.get(i)
                            val argList = splitPayloadTypes(a)
                            val rows = []
                            var k = 0
                            while k < gm.typeParams.len() && k < argList.len() {
                                val mp: string = gm.typeParams.get(k)
                                val av: string = argList.get(k)
                                rows.push(mp + " " + av)
                                k = k + 1
                            }
                            return rows
                        }
                        return []
                    }
                }
                return []
            }
        }
        _ => {}
    }
    val args = modelLiteralArgTypes(builder, gm, node)
    val rows = []
    var k = 0
    while k < gm.typeParams.len() && k < args.len() {
        val mp: string = gm.typeParams.get(k)
        val av: string = args.get(k)
        rows.push(mp + " " + av)
        k = k + 1
    }
    return rows
}

// The template's parameter names, in order.
fn genericFnParamNames(f: FunctionDeclNode) -> list < string > {
    val out = []
    var i = 0
    while i < f.genericParams.len() {
        match f.genericParams.get(i) {
            ASTNode.GenericParam(g) => { out.push(g.name) }
            _ => {}
        }
        i = i + 1
    }
    return out
}

// One parameter occurrence bound from one argument type: same container base
// peels one level, a bare name binds the whole actual, anything else binds
// nothing. The checker's twin in its own closure; both must answer alike,
// the way model inference does, or the caller's instance and the checker's
// disagree about which function ran.
fn inferFnArgBinding(declared: string, actual: string, param: string) -> string {
    if declared == param { return actual }
    val dOpen = orbit_string_indexOf(declared, "<")
    val aOpen = orbit_string_indexOf(actual, "<")
    if dOpen <= 0 || aOpen <= 0 { return "" }
    val dBase = orbit_string_slice(declared, 0, dOpen)
    val aBase = orbit_string_slice(actual, 0, aOpen)
    if dBase != aBase { return "" }
    if orbit_string_slice(declared, orbit_string_len(declared) - 1, orbit_string_len(declared)) != ">" { return "" }
    if orbit_string_slice(actual, orbit_string_len(actual) - 1, orbit_string_len(actual)) != ">" { return "" }
    val dArgs = splitTypeArgs(orbit_string_slice(declared, dOpen + 1, orbit_string_len(declared) - 1))
    val aArgs = splitTypeArgs(orbit_string_slice(actual, aOpen + 1, orbit_string_len(actual) - 1))
    if dArgs.len() != aArgs.len() { return "" }
    var i = 0
    while i < dArgs.len() {
        val dPart: string = dArgs.get(i)
        val aPart: string = aArgs.get(i)
        val found = inferFnArgBinding(dPart, aPart, param)
        if found != "" { return found }
        i = i + 1
    }
    return ""
}

// The head of a "name arg" binding row (before the first space), its tail
// after it. Twins of sema.orb's bindingHead/bindingTail in this closure.
fn bindingHeadOf(row: string) -> string {
    var i = 0
    while i < orbit_string_len(row) {
        if row.at(i) == 32 { return orbit_string_slice(row, 0, i) }
        i = i + 1
    }
    return row
}

fn bindingTailOf(row: string) -> string {
    var i = 0
    while i < orbit_string_len(row) {
        if row.at(i) == 32 { return orbit_string_slice(row, i + 1, orbit_string_len(row)) }
        i = i + 1
    }
    return row
}

// The base of a type spelling ("Box<T>" -> "Box", "T" -> "T").
fn containerBaseOf(spelling: string) -> string {
    val lt = orbit_string_indexOf(spelling, "<")
    if lt <= 0 { return spelling }
    return orbit_string_slice(spelling, 0, lt)
}

// Whether a spelling mentions a parameter as a whole word. Twin of sema's
// paramMentioned; isTypeNameChar is this closure's word test.
fn paramMentionedBuilder(spelling: string, param: string) -> bool {
    var i = 0
    while i < orbit_string_len(spelling) {
        if isTypeNameChar(spelling.at(i)) {
            var j = i
            while j < orbit_string_len(spelling) {
                if isTypeNameChar(spelling.at(j)) == false { break }
                j = j + 1
            }
            if orbit_string_slice(spelling, i, j) == param { return true }
            i = j
        } else {
            i = i + 1
        }
    }
    return false
}

// Whether a spelling names one of the parameters itself (another variable,
// not a fix). Twin of the checker's skip inside cohereBinding.
fn isSelfParam(params: list < string >, value: string) -> bool {
    var i = 0
    while i < params.len() {
        val pname: string = params.get(i)
        if pname == value { return true }
        i = i + 1
    }
    return false
}

// The bindings a call fixes, in parameter order: first concrete win per
// position order, unknowns skipped, exactly the checker's rule, because the
// instance name has to be the checker's instance. Values naming a parameter
// are skipped like unknowns, for the same reason as there.
fn inferFnBindings(builder: IRBuilder, f: FunctionDeclNode, c: CallNode) -> list < string > {
    val params = genericFnParamNames(f)
    val bindings = []
    var p = 0
    while p < params.len() {
        bindings.push("unknown")
        p = p + 1
    }
    var i = 0
    while i < f.paramTypes.len() && i < c.args.len() {
        val dt: string = f.paramTypes.get(i)
        val at = staticExprTypeName(builder, c.args.get(i))
        var p2 = 0
        while p2 < params.len() {
            val pname: string = params.get(p2)
            val found = inferFnArgBinding(dt, at, pname)
            if found != "" && found != "unknown" && isSelfParam(params, found) == false {
                val cur: string = bindings.get(p2)
                if cur == "unknown" {
                    bindings.set(p2, found)
                }
            }
            p2 = p2 + 1
        }
        // A model-typed position binds from history, not spelling: the
        // instance name is not an application to peel. The checker ran the
        // same rule, so both sides name the same instance.
        var mi = 0
        while mi < params.len() {
            val mpname: string = params.get(mi)
            if paramMentionedBuilder(dt, mpname) {
                val mrows = genericInstanceRows(builder, containerBaseOf(dt), c.args.get(i))
                var r = 0
                while r < mrows.len() {
                    val mrow: string = mrows.get(r)
                    if bindingHeadOf(mrow) == mpname {
                        val mval = bindingTailOf(mrow)
                        if mval != "" && mval != "unknown" && mval != "void" && isSelfParam(params, mval) == false {
                            val mcur: string = bindings.get(mi)
                            if mcur == "unknown" {
                                bindings.set(mi, mval)
                            }
                        }
                    }
                    r = r + 1
                }
            }
            mi = mi + 1
        }
        i = i + 1
    }
    return bindings
}

// Push one instance frame: parameter names beside the bindings fixed for
// this call, joined (names with commas, spellings with tabs) because nested
// lists would need re-typing at every read.
fn pushFnGenericFrameJoined(builder: IRBuilder, names: string, args: string) {
    builder.fnGenericParams.push(names)
    builder.fnGenericArgs.push(args)
}

fn popFnGenericFrame(builder: IRBuilder) {
    builder.fnGenericParams.pop()
    builder.fnGenericArgs.pop()
}

// A type spelling with the enclosing instances' bindings applied, innermost
// frame first so shadowing and chaining fall out. Identity with no frames,
// so non-generic code pays nothing and reads nothing different.
fn resolveFnType(builder: IRBuilder, spelling: string) -> string {
    var out = spelling
    var f = builder.fnGenericParams.len()
    while f > 0 {
        f = f - 1
        val namesRow: string = builder.fnGenericParams.get(f)
        val argsRow: string = builder.fnGenericArgs.get(f)
        out = substituteTypeParams(out, splitTypeArgs(namesRow), splitPayloadTypes(argsRow))
    }
    return out
}

// The instance a call's bindings name: `f` unchanged without parameters,
// `f_int` / `f_list_string` with them. Same mangling the models use, so the
// name reads the same everywhere.
fn fnInstanceName(name: string, bindings: list < string >) -> string {
    var out = name
    var i = 0
    while i < bindings.len() {
        val b: string = bindings.get(i)
        out = out + "_" + mangleTypeArg(b)
        i = i + 1
    }
    return out
}

// Build the instance a call needs, or find it built: substitute the
// signature, register the prototype first (a recursive call meets the shell,
// never a rebuild), then build the body with the bindings pushed so nested
// `T` annotations resolve. Returns the instance name, or "" when no
// template declares the callee.
// Queue the instance a call needs: substitute the signature, register the
// prototype now (a recursive call meets the shell, never a rebuild), queue
// the body for the drain below. Bodies build after their callers, never
// nested inside them: building an instance with the caller's variable scope
// still open minted its parameters against the caller's locals (`b` became
// an unassigned `b__s0` and the first field read segfaulted), so instances
// build in the drain with clean scopes, exactly like top-level functions.
fn ensureFnInstance(builder: IRBuilder, name: string, bindings: list < string >) -> string {
    val inst = fnInstanceName(name, bindings)
    if findFunction(builder.module, inst) >= 0 { return inst }
    match genericFnByName(builder, name) {
        ASTNode.FunctionDecl(fd) => {
            val params = genericFnParamNames(fd)
            val subTypes = []
            var i = 0
            while i < fd.paramTypes.len() {
                val pt: string = fd.paramTypes.get(i)
                subTypes.push(substituteTypeParams(pt, params, bindings))
                i = i + 1
            }
            val subReturn = substituteTypeParams(fd.returnType, params, bindings)
            val clone = FunctionDeclNode(inst, fd.params, subTypes, subReturn, fd.body, fd.isAsync, fd.isPrivate, fd.isExtern, [])
            registerFunctionSignature(builder, ASTNode.FunctionDecl(clone))
            var q = 0
            var queued = false
            while q < builder.fnWorkDecls.len() {
                match builder.fnWorkDecls.get(q) {
                    ASTNode.FunctionDecl(qd) => {
                        if qd.name == inst { queued = true }
                    }
                    _ => {}
                }
                q = q + 1
            }
            if queued == false {
                builder.fnWorkDecls.push(ASTNode.FunctionDecl(clone))
                builder.fnWorkParams.push(joinTypeNames(params))
                builder.fnWorkArgs.push(joinTypeNames(bindings))
            }
            return inst
        }
        _ => {}
    }
    return name
}

// Comma-join parameter names, tab-join argument spellings: the queued form
// of a frame, split back by pushFnGenericFrameJoined's readers.
fn joinTypeNames(items: list < string >) -> string {
    var out = ""
    var i = 0
    while i < items.len() {
        if i > 0 {
            out = out + ","
        }
        val item: string = items.get(i)
        out = out + item
        i = i + 1
    }
    return out
}

// Bodies queued by ensureFnInstance, drained after pass 3 with clean scopes:
// each instance builds exactly like a top-level function, so nothing it
// declares can collide with a caller's locals. Extern templates never reach
// here (sema refuses them); the guard is insurance, not a path.
fn drainFnInstances(builder: IRBuilder) {
    var i = 0
    while i < builder.fnWorkDecls.len() {
        // Annotated: matches everywhere bind variant-typed payloads off an
        // ASTNode-typed scrutinee. An unknown-typed scrutinee binds unknowns,
        // and passing those to struct-typed parameters wraps the value (the
        // ForNode lesson): bodies compiled from wrapped decls call themselves.
        val work: ASTNode = builder.fnWorkDecls.get(i)
        match work {
            ASTNode.FunctionDecl(fd) => {
                if fd.isExtern == false {
                    val params: string = builder.fnWorkParams.get(i)
                    val args: string = builder.fnWorkArgs.get(i)
                    pushFnGenericFrameJoined(builder, params, args)
                    buildFunction(builder, fd)
                    popFnGenericFrame(builder)
                }
            }
            _ => {}
        }
        i = i + 1
    }
}

// parseTypeName writes arguments as ", " -- `Pair<string, float>` is stored with
// the space -- so the second argument arrives as " float". An untrimmed argument
// substitutes into the field type as " float", which no type rule matches, and
// the field is emitted as void*. The instance NAME was unaffected, because
// mangleTypeArg drops the space anyway, which is why this presented as a struct
// whose field silently had the wrong C type.
fn trimTypeArg(s: string) -> string {
    var start = 0
    var end = orbit_string_len(s)
    while start < end {
        if isTypeArgSpace(s.at(start)) == false { break }
        start = start + 1
    }
    while end > start {
        if isTypeArgSpace(s.at(end - 1)) == false { break }
        end = end - 1
    }
    if end <= start { return "" }
    return orbit_string_slice(s, start, end)
}

fn isTypeArgSpace(c: int) -> bool {
    if c == 32 { return true }
    if c == 9 { return true }
    if c == 10 { return true }
    if c == 13 { return true }
    return false
}

// The value a literal writes under one key, or Empty. The literal is keyed
// while the model's constructor is ordered, so this recovers the order.
fn literalFieldValue(node: ASTNode, name: string) -> ASTNode {
    match node {
        ASTNode.ObjectLiteral(ol) => {
            var i = 0
            while i < ol.fields.len() {
                val field: ASTNode = ol.fields.get(i)
                match field {
                    ASTNode.FieldInit(fi) => {
                        if fi.name == name { return fi.value }
                    }
                    _ => {}
                }
                i = i + 1
            }
        }
        _ => {}
    }
    return ASTNode.Empty
}

// An object literal written where the declared type is a model builds that
// model's struct, not the runtime's dynamic object: the fields are known, so
// each is passed positionally to the constructor the model already has. The
// checker has already rejected a key the model does not declare and a declared
// field the literal omits.
//
// A generic model is instantiated HERE, at the literal that fixes its type
// arguments, and everything below then works on the instantiation exactly as
// it works on a model that was written out longhand. That is the whole trick:
// no new emitter, no new type case, one more IRModelDecl.
fn buildObjectLiteralAsModel(builder: IRBuilder, node: ASTNode, modelName: string) -> int {
    val instance = ensureModelInstance(builder, modelName, node)
    val resReg = ir_alloc_register(builder.currentFunction, instance)
    var fieldCount = 0
    var mi = 0
    while mi < builder.module.models.len() {
        val m: IRModelDecl = builder.module.models.get(mi)
        if m.name == instance {
            var fi = 0
            while fi < m.fields.len() {
                val f: IRModelField = m.fields.get(fi)
                val valueNode = literalFieldValue(node, f.name)
                val arg = ir_init_instr(IROpcode.arg)
                arg.operand1 = buildCallArgValue(builder, valueNode)
                ir_emit(builder.currentFunction, arg)
                fieldCount = fieldCount + 1
                fi = fi + 1
            }
        }
        mi = mi + 1
    }
    val call = ir_init_instr(IROpcode.call)
    call.dest = resReg
    call.operand1 = ir_string(instance)
    call.operand2 = ir_int(fieldCount)
    ir_emit(builder.currentFunction, call)
    return resReg
}

fn buildCallArgValue(builder: IRBuilder, node: ASTNode) -> IRValue {
    match node {
        ASTNode.Literal(l) => {
            // A bare function name as a value is the function's address, not
            // a variable to load: no scope declares it, so buildExpr would
            // emit a load of a name nothing defines and the C would read a
            // live stack slot where the function is. A live variable shadows
            // the function of the same name -- pipeline.orb keeps a `check`
            // string beside the `check` parser helper -- so only a name no
            // scope declares takes this path.
            if l.valType == "identifier" {
                if scopeHasName(builder, l.text) == false {
                    if fnTypeSpellingFor(builder, l.text) != "" {
                        return ir_symbol(l.text)
                    }
                }
            }
            if l.valType == "string" || l.valType == "string_raw" {
                return ir_string(literalStringValue(l))
            }
            if l.valType == "int" {
                return ir_int(parseIntSelfhost(l.text))
            }
            if l.valType == "char" {
                return ir_int(charCodeOf(l.text))
            }
            if l.valType == "bool" {
                if l.text == "true" {
                    return ir_bool(true)
                }
                return ir_bool(false)
            }
            val reg = buildExpr(builder, node)
            return ir_register(reg)
        }
        _ => {
            val reg = buildExpr(builder, node)
            return ir_register(reg)
        }
    }
}

fn dotPosOf(s: string) -> int {
    var i = 0
    while i < orbit_string_len(s) {
        if s.at(i) == 46 {
            return i
        }
        i = i + 1
    }
    return -1
}

fn beforeDot(s: string) -> string {
    val d = dotPosOf(s)
    if d <= 0 {
        return ""
    }
    return orbit_string_slice(s, 0, d)
}

fn afterDot(s: string) -> string {
    val d = dotPosOf(s)
    if d <= 0 {
        return ""
    }
    return orbit_string_slice(s, d + 1, orbit_string_len(s))
}

fn listElementType(source: string) -> string {
    val ownerType = beforeDot(source)
    val fieldName = afterDot(source)
    if ownerType == "IRModule" && fieldName == "functions" { return "IRFunction" }
    if ownerType == "IRModule" && fieldName == "models" { return "IRModelDecl" }
    if ownerType == "IRModule" && fieldName == "types" { return "IRTypeDecl" }
    if ownerType == "IRModule" && fieldName == "globals" { return "IRGlobal" }
    if ownerType == "IRModelDecl" && fieldName == "fields" { return "IRModelField" }
    if ownerType == "IRVariantDecl" && fieldName == "fields" { return "IRVariantField" }
    if ownerType == "IRFunction" && fieldName == "instructions" { return "IRInstruction" }
    if ownerType == "IRBuilder" && fieldName == "variableScopes" { return "VarScope" }
    if ownerType == "IRBuilder" && fieldName == "genericModels" { return "IRModelDecl" }
    if ownerType == "IRBuilder" && fieldName == "returnTypes" { return "Variable" }
    if ownerType == "VarScope" && fieldName == "variables" { return "Variable" }
    return "unknown"
}

/* ── List element kinds ────────────────────────────────────────────────────
 *
 * A list has one element type (F-0002), and until now the compiler had no way
 * to say which, so `xs.get(i)` emitted a hardcoded `*(void**)`: one read for
 * a list of strings, one for a list of ints, one for a list of lists, and all
 * three the same. This is where the kind is decided.
 *
 * Decided once, here, and carried on the instruction as `elemKind`, because
 * the reader and the writer have to agree and two independent guesses would
 * not. The builder is the only place that knows: it is the only place that
 * sees the list literal, the variable it was bound to, and the value pushed
 * into it. Everything downstream reads `elemKind` and lowers accordingly.
 *
 * The kind is named as an Orbit type string, "" for "could not tell", because
 * that is what the rest of the builder already passes around.
 */

fn isScalarKindName(k: string) -> bool {
    if k == "int" || k == "orbit_int" { return true }
    if k == "float" || k == "orbit_float" { return true }
    if k == "string" || k == "orbit_string" { return true }
    if k == "bool" || k == "orbit_bool" { return true }
    return false
}

fn isReferenceKindName(k: string) -> bool {
    if k == "list" || k == "map" || k == "object" || k == "ref" { return true }
    if k == "" || k == "unknown" || k == "void" { return false }
    if isScalarKindName(k) { return false }
    // A capitalised name is a model, and a model value is a pointer.
    val fc = k.at(0)
    return fc >= 65 && fc <= 90
}

/** @brief The OrbitElemKind number for a type name. 0 when there is none. */
fn elemKindCode(k: string) -> int {
    if k == "string" || k == "orbit_string" { return 1 }
    if k == "int" || k == "orbit_int" { return 2 }
    if k == "float" || k == "orbit_float" { return 3 }
    if k == "bool" || k == "orbit_bool" { return 4 }
    if isReferenceKindName(k) { return 5 }
    return 0
}

/** @brief The register type a list read should be declared with.
 *
 *  A reference element keeps "unknown", so its register is still `void*`:
 *  the element is a pointer but the compiler does not know which pointer, and
 *  declaring it as one particular struct would be a guess the C compiler is
 *  entitled to reject. */
fn registerTypeForKind(k: string) -> string {
    if k == "string" || k == "orbit_string" { return "string" }
    if k == "int" || k == "orbit_int" { return "int" }
    if k == "float" || k == "orbit_float" { return "float" }
    if k == "bool" || k == "orbit_bool" { return "bool" }
    return "unknown"
}

/** @brief registerTypeForKind, from the kind number the instruction carries. */
fn registerTypeForElemKind(code: int) -> string {
    if code == 1 { return "string" }
    if code == 2 { return "int" }
    if code == 3 { return "float" }
    if code == 4 { return "bool" }
    return "unknown"
}

/** @brief The register type of a reference element read from a list.
 *
 *  A list element is a pointer, and the register can say which pointer only
 *  when the element's type is a list, a declared non-generic model or a
 *  declared union. An enumeration, a type parameter and a generic instance
 *  keep "unknown". */
fn referenceElementRegisterType(builder: IRBuilder, name: string) -> string {
    if name == "" || name == "ref" { return "unknown" }
    if annotationBaseType(name) == "list" { return "list" }
    return declaredReferenceRegisterType(builder, name)
}

/** @brief A declared non-generic model or a declared union as a register type.
 *
 *  Both are pointers in C, and the name is the pointee the emitter declares. */
fn declaredReferenceRegisterType(builder: IRBuilder, name: string) -> string {
    if name == "" { return "unknown" }
    if isUnionTypeName(builder, name) { return name }
    if modelDeclared(builder, name) && genericModelByName(builder, name) == NULL { return name }
    return "unknown"
}

/** @brief The register type of a list read: the scalar the kind names, else the element's own type. */
fn listReadRegisterType(builder: IRBuilder, node: ASTNode, code: int) -> string {
    val scalar = registerTypeForElemKind(code)
    if scalar != "unknown" { return scalar }
    var name = listKindNameOf(builder, node)
    if name == "" || name == "ref" {
        name = annotationListElement(resolveExprType(builder, node))
    }
    return referenceElementRegisterType(builder, name)
}

/** @brief The enumeration or union a `Type.Variant` reference names, or "".
 *
 *  `var tag = TokType.EOF` and `var out = ASTNode.Empty` bound `tag` and `out`
 *  to unknown, although the name in front of the dot is the type. A variable
 *  of that name wins, as it does in buildExpr, and the member has to be a
 *  variant the declaration lists, so `Shape.area(x)` on a trait function keeps
 *  its old answer. */
fn variantReferenceType(builder: IRBuilder, object: ASTNode, member: string) -> string {
    match object {
        ASTNode.Literal(lit) => {
            if lit.valType != "identifier" { return "" }
            if lookupVariable(builder, lit.text) != "unknown" { return "" }
            var ti = 0
            while ti < builder.module.types.len() {
                val td: IRTypeDecl = builder.module.types.get(ti)
                if td.name == lit.text && (td.kind == "enumeration" || td.kind == "union_type") {
                    var vi = 0
                    while vi < td.variants.len() {
                        if td.variants.get(vi) == member { return td.name }
                        vi = vi + 1
                    }
                }
                ti = ti + 1
            }
            return ""
        }
        _ => { return "" }
    }
}

/** @brief The static type of an expression, for the purpose of a list's element type.
 *
 *  Deliberately narrow. It answers for literals, list and object literals,
 *  interpolation, arithmetic, comparisons, and names; everything else is
 *  "unknown", which leaves the list untyped and the read undecoded. A wrong
 *  answer here would be worse than no answer: it would emit a typed accessor
 *  for a slot holding something else. */
// orbit-walk: none -- asks what type an expression is
fn staticExprTypeName(builder: IRBuilder, node: ASTNode) -> string {
    match node {
        ASTNode.Literal(lit) => {
            if lit.valType == "identifier" {
                // A list is a list. Its ELEMENT type is a different question
                // and has a different answerer, listKindNameOf; answering this
                // one with the element type is what made `outer.push(inner)`
                // push a list as an int and then read the list pointer back
                // through orbit_list_read_int.
                val vt = lookupVariable(builder, lit.text)
                if vt != "unknown" { return vt }
                // A bare function name in value position is the function as a
                // value, typed by its registered signature. Without this
                // `val f = foo` bound f to unknown and the call through it
                // had no type to check or emit against.
                val ft = fnTypeSpellingFor(builder, lit.text)
                if ft != "" { return ft }
                return vt
            }
            if lit.valType == "string" { return "string" }
            if lit.valType == "int" { return "int" }
            if lit.valType == "float" { return "float" }
            if lit.valType == "bool" { return "bool" }
            return "unknown"
        }
        ASTNode.ListLiteral(ll) => { return "list" }
        ASTNode.ObjectLiteral(ol) => { return "object" }
        // `Model { ... }` is worth the model's own name: the name in front is
        // the type, and without this `val p = Post { ... }` bound p to unknown
        // and every field read through it had nothing to read a field type off.
        // A generic model's own name is not a type, so this is where the
        // instantiation is named: `Box { v: 1 }` is a `Box_int`, which is what
        // a field read through it needs to cast to.
        ASTNode.TypedLiteral(tl) => { return modelInstanceName(builder, tl.declaredType, tl.value) }
        ASTNode.Interp(ip) => { return "string" }
        // The value of an `if` is the value of the branch that ran, and the
        // then branch is the one that decides it, so that is what an `if` is
        // worth as a type. An `if` in a chain answers with the innermost then
        // branch, which is the only one guaranteed to be there.
        ASTNode.If(ifn) => { return branchTypeName(builder, ifn.thenBody) }
        ASTNode.UnaryOp(u) => {
            if u.op == "!" { return "bool" }
            return staticExprTypeName(builder, u.operand)
        }
        ASTNode.BinaryOp(b) => {
            if b.op == "==" || b.op == "!=" || b.op == "<" || b.op == ">" || b.op == "<=" || b.op == ">=" { return "bool" }
            if b.op == "&&" || b.op == "||" { return "bool" }
            // Int-only, like the checker says: an int and an int, or an answer
            // this static reader does not have.
            if b.op == "&" || b.op == "|" || b.op == "^" || b.op == "<<" || b.op == ">>" {
                val lhsBitType = staticExprTypeName(builder, b.lhs)
                val rhsBitType = staticExprTypeName(builder, b.rhs)
                if lhsBitType == "int" && rhsBitType == "int" { return "int" }
                return "unknown"
            }
            val lt = staticExprTypeName(builder, b.lhs)
            val rt = staticExprTypeName(builder, b.rhs)
            if b.op == "+" && (lt == "string" || rt == "string") { return "string" }
            if lt == "float" || rt == "float" { return "float" }
            if lt == "int" && rt == "int" { return "int" }
            return "unknown"
        }
        ASTNode.MemberAccess(vma) => {
            val variantOwner = variantReferenceType(builder, vma.object, vma.field)
            if variantOwner != "" { return variantOwner }
            return resolveExprType(builder, node)
        }
        ASTNode.Call(c) => {
            match c.callee {
                ASTNode.MemberAccess(ma) => {
                    val ctorOwner = variantReferenceType(builder, ma.object, ma.field)
                    if ctorOwner != "" { return ctorOwner }
                    // A read of a list has the list's element type, which is
                    // how `val x = xs.get(0)` learns what x is.
                    if ma.field == "get" || ma.field == "at" {
                        val recvKind = listKindNameOf(builder, ma.object)
                        if recvKind != "" {
                            val readType = registerTypeForKind(recvKind)
                            if readType != "unknown" { return readType }
                            return referenceElementRegisterType(builder, recvKind)
                        }
                    }
                    return resolveExprType(builder, node)
                }
                _ => { return resolveExprType(builder, node) }
            }
        }
        _ => { return resolveExprType(builder, node) }
    }
}

/** @brief The one element type of a list literal, or "" when it has none.
 *
 *  A literal whose elements disagree has no element type, and that is a
 *  front-end error (sema raises it) rather than something to guess at here. */
fn listLiteralKindName(builder: IRBuilder, ll: ListLiteralNode) -> string {
    if ll.elements.len() == 0 { return "" }
    var decided = ""
    var ei = 0
    while ei < ll.elements.len() {
        val et = staticExprTypeName(builder, ll.elements.get(ei))
        if et == "unknown" || et == "void" {
            ei = ei + 1
            continue
        }
        if et == "list" || et == "map" || et == "object" || isReferenceKindName(et) {
            decided = "ref"
        } else if decided == "" {
            decided = et
        } else if decided != et {
            return ""
        }
        ei = ei + 1
    }
    return decided
}

/** @brief Is this expression a list? Used to decide whether `.at()` is a
 *  character read or an element read. */
fn isListExpression(builder: IRBuilder, node: ASTNode) -> bool {
    match node {
        ASTNode.ListLiteral(ll) => { return true }
        ASTNode.Literal(lit) => {
            if lit.valType == "identifier" {
                val vt = lookupVariable(builder, lit.text)
                if vt == "list" || vt == "List" { return true }
            }
            return false
        }
        ASTNode.Call(c) => {
            var calleeName = ""
            match c.callee {
                ASTNode.Literal(l2) => { if l2.valType == "identifier" { calleeName = l2.text } }
                _ => {}
            }
            val rt = lookupFunctionReturnType(builder, calleeName)
            if rt == "list" || rt == "List" { return true }
            return false
        }
        ASTNode.MemberAccess(ma) => {
            if annotationBaseType(fieldTypeOfModel(builder, resolveExprType(builder, ma.object), ma.field)) == "list" { return true }
            return false
        }
        _ => { return false }
    }
}

/** @brief The element type of a list expression, "" when undecided. */
// What an ELEMENT READ of `node` yields, as a kind name, or "" when nothing
// says. Two sources, in one place, because a read that answers "float" while
// the opcode carrying the read says "raw" is a value printed as a number.
//
// The first is the name-keyed registry, which only a name can fill. The second
// is the receiver's own declared type: `post.grid.get(0)` on a
// `list<list<float>>` field has no name to look up, and the element type is
// right there in the type. Splitting those two across the read sites is how the
// answer came out "float" in one place and "unknown" in the other -- and the
// second is what reaches the emitter.
fn listReadElemKindName(builder: IRBuilder, node: ASTNode) -> string {
    val recorded = listKindNameOf(builder, node)
    if recorded != "" { return recorded }
    val elem = annotationListElement(resolveExprType(builder, node))
    if elem == "string" || elem == "int" || elem == "float" || elem == "bool" { return elem }
    return ""
}

// orbit-walk: none -- asks which list kind an expression is
fn listKindNameOf(builder: IRBuilder, node: ASTNode) -> string {
    match node {
        ASTNode.ListLiteral(ll) => { return listLiteralKindName(builder, ll) }
        // A list built by an `if` is a list: `val xs = if c { [1] } else { [2] }`
        // then `xs.push(3)` has to know what is in it, exactly as a literal
        // does. A block branch is worth its last statement, the same rule
        // branchTypeName types it by.
        ASTNode.If(ifn) => { return listKindNameOf(builder, branchValueNode(ifn.thenBody)) }
        ASTNode.Block(blk) => { return listKindNameOf(builder, branchValueNode(node)) }
        ASTNode.Literal(lit) => {
            if lit.valType == "identifier" {
                val vt = lookupVariable(builder, lit.text)
                if annotationBaseType(vt) == "list" {
                    val recorded = lookupListKind(builder, variableSymbol(builder, lit.text))
                    if recorded != "" { return recorded }
                    return annotationListElement(vt)
                }
            }
            return ""
        }
        ASTNode.MemberAccess(ma) => {
            val src = resolveListSource(builder, node)
            if src == "" { return "" }
            val tabled = listElementType(src)
            if tabled != "unknown" { return tabled }
            // A field declared `list<T>` says its element type itself.
            return annotationListElement(resolveExprType(builder, node))
        }
        _ => { return "" }
    }
}

// The container base of an annotation: "list<string>" means a list, and the
// parameter payload is carried professionally, not in the C type. The emitted
// C for a list local is one struct either way.
fn annotationBaseType(t: string) -> string {
    val lt = t.indexOf("<")
    if lt < 0 { return t }
    return t.slice(0, lt)
}

// The payload of a `list<T>` annotation, or "": a bare `list` never said.
fn annotationListElement(t: string) -> string {
    if t.slice(0, 4) != "list" { return "" }
    val lt = t.indexOf("<")
    if lt < 0 { return "" }
    // orbit_string_slice's third argument is the end index, not a length.
    return t.slice(lt + 1, t.len() - 1)
}

fn recordListKind(builder: IRBuilder, name: string, kindName: string) {
    if name == "" || kindName == "" { return }
    // Kinds ride resolved: inside a generic instance `T` is already the
    // call's type, so recording the spelling would type every later read
    // through the untyped accessor. Identity with no instance on the stack.
    val kind = resolveFnType(builder, kindName)
    if lookupListKind(builder, name) != "" { return }
    builder.listKinds.push(Variable(name, name, kind))
}

/** @brief Remember the element type a write into a named list implies.
 *
 *  `var xs = []` followed by `xs.push(10)` is the ordinary way to build a
 *  list, and the literal is empty, so the create carries no kind. The push is
 *  where the type becomes knowable, and recording it there is what lets the
 *  read after it be typed. Only a plain name is recorded: a list reached
 *  through a field is described by its declaration, and a list built by a
 *  function is described by nothing the builder can see. */
fn recordPushListKind(builder: IRBuilder, node: ASTNode, kindCode: int, valueType: string) {
    if kindCode == 0 { return }
    match node {
        ASTNode.Literal(lit) => {
            if lit.valType == "identifier" {
                val vt = lookupVariable(builder, lit.text)
                if vt == "list" || vt == "List" {
                    var pushedKind = elemKindTypeName(kindCode)
                    if kindCode == 5 && referenceElementRegisterType(builder, valueType) != "unknown" {
                        pushedKind = valueType
                    }
                    recordListKind(builder, variableSymbol(builder, lit.text), pushedKind)
                }
            }
        }
        _ => {}
    }
}

/** @brief The element kind a write into @p receiver's list carries.
 *
 *  The slot's own kind when the slot has one, and the written value's kind when
 *  it does not. Every write to a list has to use one kind and so does every
 *  read, which is the whole reason the kind is carried on the instruction
 *  rather than guessed at each end: two guesses are two answers.
 *
 *  Taking the slot's kind is what makes `val xs: list<float> = []` mean it.
 *  The empty literal gives the create no kind, so the first push is where the
 *  slot's kind and the written value's kind are first compared at all, and
 *  emitting the value's kind there adopts an int slot for a list the program
 *  declared a float -- after which the run-time refusal fires on the second
 *  push, having already put the wrong thing in the first slot. An int in a
 *  float slot is a conversion the emitter performs on the way in; a float in
 *  an int slot is a truncation, and that is what sema now refuses to write. */
fn listWriteKind(builder: IRBuilder, receiver: ASTNode, value: ASTNode) -> int {
    val slotKind = listKindNameOf(builder, receiver)
    if slotKind != "" { return elemKindCode(slotKind) }
    val valueType = staticExprTypeName(builder, value)
    val kind = elemKindCode(valueType)
    // A list with no kind yet takes this one, which is the `var xs = []` then
    // `xs.push(10)` shape the registry exists for.
    recordPushListKind(builder, receiver, kind, valueType)
    return kind
}

/** @brief The Orbit type name a kind number stands for, for the tables above. */
fn elemKindTypeName(kindCode: int) -> string {
    if kindCode == 1 { return "string" }
    if kindCode == 2 { return "int" }
    if kindCode == 3 { return "float" }
    if kindCode == 4 { return "bool" }
    if kindCode == 5 { return "ref" }
    return ""
}

fn lookupListKind(builder: IRBuilder, name: string) -> string {
    return lookupLastVariableType(builder.listKinds, name, "")
}

fn memberCallReturnType(builder: IRBuilder, receiver: ASTNode, member: string) -> string {
    val t = resolveExprType(builder, receiver)
    if t == "string" {
        if member == "len" { return "int" }
        if member == "contains" { return "bool" }
        if member == "slice" { return "string" }
        if member == "to_int" { return "int" }
        if member == "indexOf" { return "int" }
        if member == "at" { return "int" }
        if member == "startsWith" { return "bool" }
        if member == "endsWith" { return "bool" }
        if member == "trim" { return "string" }
        if member == "toUpper" { return "string" }
        if member == "toLower" { return "string" }
        if member == "padLeft" { return "string" }
        if member == "padRight" { return "string" }
        if member == "join" { return "string" }
        if member == "split" { return "list<string>" }
        return "unknown"
    }
    if annotationBaseType(t) == "list" {
        if member == "len" { return "int" }
        if member == "push" { return "void" }
        if member == "pop" { return memberElemType(builder, receiver) }
        if member == "get" || member == "at" { return memberElemType(builder, receiver) }
        if member == "clear" { return "void" }
        if member == "contains" { return "bool" }
        if member == "indexOf" { return "int" }
        return "unknown"
    }
    if t == "map" || t == "Map" {
        if member == "has" { return "bool" }
        if member == "keys" { return "list<string>" }
        if member == "delete" { return "void" }
        return "unknown"
    }
    return "unknown"
}

fn memberElemType(builder: IRBuilder, receiver: ASTNode) -> string {
    val kind = listKindNameOf(builder, receiver)
    // A receiver with no recorded kind can still carry one in its declared
    // type: `post.tags` is a `list<string>` because the model field says so,
    // and no push ever told the registry. Reading the element off the
    // annotation is what turns that field's element type into a typed read.
    val elem = annotationListElement(resolveExprType(builder, receiver))
    if elem == "string" || elem == "int" || elem == "float" || elem == "bool" {
        return elem
    }
    // An element that is ITSELF a list is still an answer, and dropping it is
    // what made `list<list<float>>` read back as unknown: the register had no
    // element kind, so the read of the inner list came out raw.
    if annotationBaseType(elem) == "list" { return elem }
    if kind == "string" || kind == "orbit_string" { return "string" }
    if kind == "int" || kind == "orbit_int" { return "int" }
    if kind == "float" || kind == "orbit_float" { return "float" }
    if kind == "bool" || kind == "orbit_bool" { return "bool" }
    return "unknown"
}

// orbit-walk: none -- asks what type an expression is
fn resolveExprType(builder: IRBuilder, node: ASTNode) -> string {
    match node {
        ASTNode.Literal(lit) => {
            if lit.valType == "identifier" {
                val vt = lookupVariable(builder, lit.text)
                if vt != "unknown" { return vt }
                val ft = fnTypeSpellingFor(builder, lit.text)
                if ft != "" { return ft }
                return vt
            }
            return "unknown"
        }
        ASTNode.ObjectLiteral(ol) => { return "object" }
        // A generic model literal is its instantiation, for the same reason
        // staticExprTypeName answers with the model name at all: this is the
        // one place the name in front of `{...}` becomes a type.
        ASTNode.TypedLiteral(tl) => { return modelInstanceName(builder, tl.declaredType, tl.value) }
        // A list literal is a list. It was missing here, so `val n = [10,20,30]`
        // bound n to "unknown" and every later use of n -- `.at()`, `.get()`,
        // `.push()` -- had nothing to say what was in it. That is the same
        // missing-type hole as the missing element type, one level up: the
        // variable's own type was unknown, so the element type could not be
        // reached either.
        ASTNode.ListLiteral(ll) => { return "list" }
        ASTNode.MemberAccess(ma) => {
            val objType = resolveExprType(builder, ma.object)
            if objType != "unknown" && modelHasField(builder, objType, ma.field) {
                return fieldTypeOfModel(builder, objType, ma.field)
            }
            return "unknown"
        }
        ASTNode.Call(c) => {
            var calleeName = ""
            var calleeIsMember = false
            var calleeObject = ASTNode.Empty
            match c.callee {
                ASTNode.Literal(lit2) => {
                    if lit2.valType == "identifier" {
                        calleeName = lit2.text
                    }
                }
                ASTNode.MemberAccess(ma2) => {
                    calleeName = ma2.field
                    calleeIsMember = true
                    calleeObject = ma2.object
                }
                _ => {}
            }
            if calleeIsMember {
                val mt = memberCallReturnType(builder, calleeObject, calleeName)
                if mt != "unknown" { return mt }
            }
            // A call through a variable holding a function value answers the
            // signature's return type. The function table below only knows
            // declared functions, so without this the call typed unknown and
            // the value it produced was hoisted as an integer. A declared
            // function wins over a shadowing value, the way sema resolves
            // the callee: the value needs its own name to be called.
            if calleeIsMember == false && calleeName != "" {
                if findFunction(builder.module, calleeName) < 0 {
                    val vt = lookupVariable(builder, calleeName)
                    if builderIsFnType(vt) { return builderFnTypeReturn(vt) }
                }
            }
            // `Bag(7, xs)` constructs a model, so the call is worth the model's
            // name; without it `val bag = Bag(...)` bound bag to unknown and
            // `bag.names.get(1)` had no field type to read an element kind from.
            if calleeIsMember == false && calleeName != "" && findFunction(builder.module, calleeName) < 0 {
                if modelDeclared(builder, calleeName) { return calleeName }
            }
            return lookupFunctionReturnType(builder, calleeName)
        }
        ASTNode.If(ifn) => { return branchTypeName(builder, ifn.thenBody) }
        _ => { return "unknown" }
    }
}

// The node a branch is worth. A branch written as a block is worth its last
// statement, and a declaration is worth the value it declares; everything else
// is its own value. This is the same rule sema's checkBlock types a block by
// ("the type of the last statement"), so the type layer and the builder agree
// on what `if c { 1 } else { 2 }` is worth.
// orbit-walk-misses: AssignmentNode, BinaryOpNode, CallNode, ConfigDeclNode, ConstDeclNode, FieldInitNode, ForNode, FunctionDeclNode, IfNode, IndexAccessNode, MatchCaseNode, MatchNode, MemberAccessNode, RangeNode, ReturnErrNode, ReturnNode, ReturnOkNode, RouteDeclNode, ScheduleDeclNode, TryNode, TypedLiteralNode, UnaryOpNode, WhileNode
fn branchValueNode(node: ASTNode) -> ASTNode {
    match node {
        ASTNode.Block(b) => {
            if b.statements.len() == 0 { return ASTNode.Empty }
            return branchValueNode(b.statements.get(b.statements.len() - 1))
        }
        ASTNode.ExpressionStmt(e) => { return branchValueNode(e.expr) }
        ASTNode.VarDecl(v) => { return branchValueNode(v.value) }
        _ => { return node }
    }
}

// The type a branch is worth: an `if` is worth the type of its then branch, and
// a declaration is worth its annotation when it has one.
fn branchTypeName(builder: IRBuilder, node: ASTNode) -> string {
    match node {
        ASTNode.VarDecl(v) => {
            if v.typeAnnotation != "" { return v.typeAnnotation }
            return staticExprTypeName(builder, v.value)
        }
        _ => { return staticExprTypeName(builder, branchValueNode(node)) }
    }
}

fn resolveListSource(builder: IRBuilder, node: ASTNode) -> string {
    match node {
        ASTNode.MemberAccess(ma) => {
            val objType = resolveExprType(builder, ma.object)
            if objType != "unknown" && annotationBaseType(fieldTypeOfModel(builder, objType, ma.field)) == "list" {
                return objType + "." + ma.field
            }
            return ""
        }
        _ => { return "" }
    }
}

fn inferValueType(builder: IRBuilder, node: ASTNode) -> string {
    match node {
        ASTNode.Call(c) => {
            match c.callee {
                ASTNode.MemberAccess(ma) => {
                    val ctorOwner = variantReferenceType(builder, ma.object, ma.field)
                    if ctorOwner != "" { return ctorOwner }
                    if ma.field == "get" {
                        val objType = resolveExprType(builder, ma.object)
                        if annotationBaseType(objType) == "list" {
                            val elemType = listElementType(resolveListSource(builder, ma.object))
                            if elemType != "unknown" {
                                return elemType
                            }
                        }
                    }
                }
                _ => {}
            }
            val callType = resolveExprType(builder, node)
            if callType != "unknown" { return callType }
            // A reference element read of a list declared `list<Item>` or
            // `list<list<T>>` is the element's own type.
            match c.callee {
                ASTNode.MemberAccess(rma) => {
                    if (rma.field == "get" || rma.field == "at") && isListExpression(builder, rma.object) {
                        val readCode = elemKindCode(listReadElemKindName(builder, rma.object))
                        return listReadRegisterType(builder, rma.object, readCode)
                    }
                }
                _ => {}
            }
            return callType
        }
        // A literal, an operator and an interpolation are typed by
        // staticExprTypeName; resolveExprType answers unknown for all of them,
        // which left `var i = 0` untyped and every read of i with it.
        _ => { return staticExprTypeName(builder, node) }
    }
}

fn modelDeclared(builder: IRBuilder, name: string) -> bool {
    var i = 0
    while i < builder.module.models.len() {
        val m: IRModelDecl = builder.module.models.get(i)
        if m.name == name { return true }
        i = i + 1
    }
    return false
}

fn modelHasField(builder: IRBuilder, typeName: string, fieldName: string) -> bool {
    return modelFieldTypeOf(builder, typeName, fieldName) != "! no such model field"
}

// A tab-joined payload list split back into spellings. Tabs ride from the
// parser, which joins with them because commas need depth tracking;
// sema.orb's splitBindingRows is the same split for the same reason, in its
// own module closure.
fn splitPayloadTypes(joined: string) -> list < string > {
    val parts = []
    if joined == "" { return parts }
    var start = 0
    var i = 0
    while i <= orbit_string_len(joined) {
        var end = false
        if i == orbit_string_len(joined) { end = true }
        var isTab = false
        if end == false {
            if joined.at(i) == 9 { isTab = true }
        }
        if end || isTab {
            parts.push(orbit_string_slice(joined, start, i))
            start = i + 1
        }
        i = i + 1
    }
    return parts
}

// The i-th payload type of a variant, or "" past the end. Named for tags
// (union member names in IR), not variants: sema.orb owns variantPayloadAt
// over its own registry, and cross-file names are closed.
fn variantTagPayloadAt(builder: IRBuilder, tagName: string, idx: int) -> string {
    if tagName.len() == 0 { return "unknown" }
    var ti = 0
    while ti < builder.module.types.len() {
        val t: IRTypeDecl = builder.module.types.get(ti)
        if t.kind == "union_type" {
            var vi = 0
            while vi < t.variants.len() {
                if t.variants.get(vi) == tagName {
                    if vi < t.richVariants.len() {
                        val p: string = t.richVariants.get(vi)
                        val parts = splitPayloadTypes(p)
                        if idx >= 0 && idx < parts.len() {
                            val part: string = parts.get(idx)
                            return part
                        }
                    }
                    return ""
                }
                vi = vi + 1
            }
        }
        ti = ti + 1
    }
    return "unknown"
}

// The union first declaring a variant, or "" when none does. Bare `V(a)`
// patterns carry no owner; the tag still has to come from somewhere.
fn variantTagOwner(builder: IRBuilder, tagName: string) -> string {
    if tagName.len() == 0 { return "" }
    var ti = 0
    while ti < builder.module.types.len() {
        val t: IRTypeDecl = builder.module.types.get(ti)
        if t.kind == "union_type" {
            var vi = 0
            while vi < t.variants.len() {
                if t.variants.get(vi) == tagName {
                    return t.name
                }
                vi = vi + 1
            }
        }
        ti = ti + 1
    }
    return ""
}

// The packed-struct type holding a variant's payloads (`Owner_Variant`),
// or "" when no union declares the variant. Multi-payload match bindings
// read `Owner_Variant._0` off the data pointer through it.
fn variantStructOf(builder: IRBuilder, tagName: string) -> string {
    val owner = variantTagOwner(builder, tagName)
    if owner == "" { return "" }
    return owner + "_" + tagName
}

// The register type of a variant's payload word, for `union_get_data`. Only a
// single int, bool, string, declared model or declared union payload is
// written: a float is not stored as a number in the word, and several payloads
// make the word a pointer to a packed struct that has no declared name. The owner is the union the tag test uses,
// so two unions sharing a variant name do not answer for each other.
fn unionDataRegisterType(builder: IRBuilder, tagOwner: string, tagName: string) -> string {
    var owner = tagOwner
    if owner == "" { owner = variantTagOwner(builder, tagName) }
    if owner == "" { return "unknown" }
    var ti = 0
    while ti < builder.module.types.len() {
        val t: IRTypeDecl = builder.module.types.get(ti)
        if t.kind == "union_type" && t.name == owner {
            var vi = 0
            while vi < t.variants.len() {
                if t.variants.get(vi) == tagName && vi < t.richVariants.len() {
                    val p: string = t.richVariants.get(vi)
                    if p == "int" || p == "bool" || p == "string" { return p }
                    return declaredReferenceRegisterType(builder, p)
                }
                vi = vi + 1
            }
        }
        ti = ti + 1
    }
    return "unknown"
}

fn variantPayloadType(builder: IRBuilder, tagName: string) -> string {
    if tagName.len() == 0 { return "unknown" }
    // Structural first: consult declared union payloads (richVariants).
    var ti = 0
    while ti < builder.module.types.len() {
        val t: IRTypeDecl = builder.module.types.get(ti)
        if t.kind == "union_type" {
            var vi = 0
            while vi < t.variants.len() {
                if t.variants.get(vi) == tagName {
                    if vi < t.richVariants.len() {
                        val p: string = t.richVariants.get(vi)
                        if p != "" { return p }
                    }
                }
                vi = vi + 1
            }
        }
        ti = ti + 1
    }
    // Convention fallback: payload model named <Tag>Node.
    val modelName = tagName + "Node"
    var mi = 0
    while mi < builder.module.models.len() {
        val m: IRModelDecl = builder.module.models.get(mi)
        if m.name == modelName {
            return modelName
        }
        mi = mi + 1
    }
    return "unknown"
}

// Does `typeName` declare a variant called `variantName`? The tag constants are
// per type, so this is what makes the scrutinee's own type the owner of a bare
// pattern.
fn typeDeclaresVariant(builder: IRBuilder, typeName: string, variantName: string) -> bool {
    var ti = 0
    while ti < builder.module.types.len() {
        val t: IRTypeDecl = builder.module.types.get(ti)
        if t.name == typeName {
            var vi = 0
            while vi < t.variants.len() {
                if t.variants.get(vi) == variantName {
                    return true
                }
                vi = vi + 1
            }
            return false
        }
        ti = ti + 1
    }
    return false
}

// The tagged type first declaring a variant: a union or an enumeration.
// variantTagOwner answers the union-only question the payload path asks -- a
// payload type only a union has -- and a bare `V` pattern has no payload, so an
// enumeration is one of its possible owners.
fn taggedVariantOwner(builder: IRBuilder, tagName: string) -> string {
    if tagName.len() == 0 { return "" }
    var ti = 0
    while ti < builder.module.types.len() {
        val t: IRTypeDecl = builder.module.types.get(ti)
        if t.kind == "union_type" || t.kind == "enumeration" {
            var vi = 0
            while vi < t.variants.len() {
                if t.variants.get(vi) == tagName {
                    return t.name
                }
                vi = vi + 1
            }
        }
        ti = ti + 1
    }
    return ""
}

// The owner of a bare variant pattern (`V`, no type in front of it).
//
// The scrutinee's own type is the answer when the builder can type it: the tag
// constants are per type, so with two types declaring the same variant name at
// different positions, "the first type declaring it" is a different number from
// the scrutinee's. A known type that does not declare the name means the
// pattern is not a variant pattern at all -- it is an ordinary expression, and
// comparing values is the behavior to keep.
//
// When the builder cannot type the scrutinee, the name decides, the way a bare
// `V(a)` pattern already resolves its tag.
fn bareVariantOwner(builder: IRBuilder, scrutinee: ASTNode, variantName: string) -> string {
    if variantName == "" { return "" }
    val st = resolveExprType(builder, scrutinee)
    if st != "unknown" {
        if typeDeclaresVariant(builder, st, variantName) { return st }
        return ""
    }
    return taggedVariantOwner(builder, variantName)
}

fn fieldOwnerForObject(builder: IRBuilder, obj: ASTNode, fieldName: string) -> string {
    // Resolve the type of the actual receiver expression, not only bare
    // variables. This preserves the owner in IR for chained accesses such as
    // `parser.currentToken.line`; otherwise C generation falls back to a
    // global field-name lookup and can cast a Token as an unrelated model.
    val objType = resolveExprType(builder, obj)
    if objType != "unknown" && modelHasField(builder, objType, fieldName) {
        return objType
    }
    return ""
}

fn allocLabel(builder: IRBuilder) -> int {
    val lbl = builder.labelCounter
    builder.labelCounter = builder.labelCounter + 1
    return lbl
}

fn registerModel(builder: IRBuilder, node: ASTNode) {
    match node {
        ASTNode.ModelDecl(m) => {
            builder.modelNames.push(m.name)
            val irFields = []
            var fi = 0
            while fi < m.fields.len() {
                val fNode: ASTNode = m.fields.get(fi)
                match fNode {
                    ASTNode.FieldDecl(f) => {
                        irFields.push(IRModelField(f.name, f.fieldType))
                    }
                    _ => {}
                }
                fi = fi + 1
            }
            val params = []
            var gi = 0
            while gi < m.genericParams.len() {
                match m.genericParams.get(gi) {
                    ASTNode.GenericParam(gparam) => { params.push(gparam.name) }
                    _ => {}
                }
                gi = gi + 1
            }
            // A generic declaration goes to genericModels, never to
            // module.models: its fields are spelled in terms of names that
            // only a use can fill in, and module.models is walked by the
            // emitter. Each instantiation the builder synthesises goes into
            // module.models on its own, already substituted.
            if params.len() > 0 {
                builder.genericModels.push(IRModelDecl(m.name, irFields, params))
            } else {
                builder.module.models.push(IRModelDecl(m.name, irFields, []))
            }
        }
        ASTNode.MigrationDecl(m) => {
            builder.module.migrations.push(unescapeString(m.sql))
        }
        _ => {}
    }
}

fn builderRegisterType(builder: IRBuilder, node: ASTNode) {
    match node {
        ASTNode.TypeDecl(t) => {
            var kind = t.kind
            if kind == "enum" {
                kind = "enumeration"
            } else if kind == "union" {
                kind = "union_type"
            }
            val irVariants = []
            var vi = 0
            while vi < t.variants.len() {
                val vn: ASTNode = t.variants.get(vi)
                match vn {
                    ASTNode.Literal(l) => { irVariants.push(l.text) }
                    _ => {}
                }
                vi = vi + 1
            }
            val irRich = []
            var rvi = 0
            while rvi < t.variantPayloads.len() {
                val payload: string = t.variantPayloads.get(rvi)
                irRich.push(payload)
                rvi = rvi + 1
            }
            val irType = IRTypeDecl(t.name, kind, irVariants, irRich, [])
            builder.module.types.push(irType)
        }
        _ => {}
    }
}

fn registerFunctionSignature(builder: IRBuilder, node: ASTNode) {
    match node {
        ASTNode.FunctionDecl(f) => {
            val func = initIRFunction(f.name)
            // A return type may name an instance that no literal in this
            // function creates, so the instance is registered from the written
            // argument before the module is emitted. The PROTOTYPE is rendered
            // from this IRFunction, so it has to be the instance name here and
            // not the annotation.
            val retInstance = declaredTypeInstanceName(builder, f.returnType)
            if retInstance != "" {
                func.returnType = retInstance
            } else {
                func.returnType = f.returnType
            }
            func.isExtern = f.isExtern
            registerFunctionReturnType(builder, f.name, func.returnType)
            var i = 0
            while i < f.params.len() {
                val p = f.params.get(i)
                func.params.push(p)
                val pType = f.paramTypes.get(i)
                // The PROTOTYPE is rendered from paramTypes, so an annotation of
                // `Box<int>` has to become the instance name here as well as in
                // the body: `Box<int>` reaching mapTypeToC falls through to the
                // pointer default and emits `Box_int_*` from a mangled name.
                val pInstance = declaredTypeInstanceName(builder, pType)
                if pInstance != "" {
                    func.paramTypes.push(pInstance)
                } else {
                    func.paramTypes.push(pType)
                }
                i = i + 1
            }
            builder.module.functions.push(func)
        }
        ASTNode.RouteDecl(r) => {
            val m = unquoteString(r.http_method)
            val p = unquoteString(r.path)
            val routeName = "route_" + m + "_" + p
            val func = initRouteFunction(routeName, m, p)
            if r.has_limit {
                func.routeHasLimit = true
                func.routeLimitRate = r.limit_rate
                func.routeLimitWindowMs = r.limit_window_ms
                var b = r.limit_burst
                if b <= 0 { b = r.limit_rate }
                func.routeLimitBurst = b
            }
            registerFunctionReturnType(builder, routeName, "response")
            builder.module.functions.push(func)
        }
        _ => {}
    }
}

// One entry of a register-type list replaced, the list rebuilt. The other
// module closure has setStrAt for this, and cross-file names are closed,
// so this is the local spelling: same shape, distinct global name.
fn setRegisterTypeAt(regTypes: list < string >, idx: int, value: string) -> list < string > {
    val out = []
    var i = 0
    while i < regTypes.len() {
        if i == idx {
            out.push(value)
        } else {
            out.push(regTypes.get(i))
        }
        i = i + 1
    }
    return out
}

fn findFunction(module: IRModule, name: string) -> int { var i = 0
    while i < module.functions.len() {
        val f: IRFunction = module.functions.get(i)
        if f.name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// First-class function values spell `fn(p1;p2)->ret`, the same spelling
// sema.orb infers for a bare function name (duplicated here because
// cross-file names are closed). All signatures are registered before any
// body builds, so the table answers in any declaration order; a generic
// template registers no signature and answers "".
fn builderIsFnType(t: string) -> bool {
    if t.len() < 5 { return false }
    return t.slice(0, 3) == "fn("
}

fn builderFnTypeReturn(t: string) -> string {
    val arrow = t.indexOf(")->")
    if arrow < 0 { return "unknown" }
    return t.slice(arrow + 3, t.len())
}

fn fnTypeSpellingFor(builder: IRBuilder, name: string) -> string {
    val idx = findFunction(builder.module, name)
    if idx < 0 { return "" }
    val f: IRFunction = builder.module.functions.get(idx)
    var out = "fn("
    var i = 0
    while i < f.paramTypes.len() {
        if i > 0 { out = out + ";" }
        out = out + f.paramTypes.get(i)
        i = i + 1
    }
    out = out + ")->" + f.returnType
    return out
}

fn buildAST(builder: IRBuilder, rootNode: ASTNode) -> IRModule {
    match rootNode {
        ASTNode.Program(p) => {
            // Pass 1: Register models and types
            var i = 0
            while i < p.decls.len() {
                val decl = p.decls.get(i)
                registerModel(builder, decl)
                builderRegisterType(builder, decl)
                i = i + 1
            }
            // Pass 2: Register function signatures
            i = 0
            while i < p.decls.len() {
                val decl = p.decls.get(i)
                // A generic template registers its declaration, not a
                // signature: there is no one C function to prototype, and
                // each call site monomorphises its own instance below.
                match decl {
                    ASTNode.FunctionDecl(f) => {
                        if f.genericParams.len() > 0 {
                            recordGenericFn(builder, f)
                        } else {
                            registerFunctionSignature(builder, decl)
                        }
                    }
                    _ => { registerFunctionSignature(builder, decl) }
                }
                i = i + 1
            }
            // Pass 3: Build function bodies and other declarations
            i = 0
            while i < p.decls.len() {
                val decl = p.decls.get(i)
                buildDecl(builder, decl)
                i = i + 1
            }
            // Pass 4: Build queued generic instances with clean scopes. Calls
            // during pass 3 only registered prototypes; bodies build here, so
            // an instance's locals can never collide with a caller's.
            drainFnInstances(builder)
        }
        _ => {}
    }
    // Add main function if it has instructions
    if builder.currentFunction.instructions.len() > 0 {
        builder.module.functions.push(builder.currentFunction)
    }
    return builder.module
}

fn getOrCreateFunction(builder: IRBuilder, name: string) -> IRFunction {
    val idx = findFunction(builder.module, name)
    if idx >= 0 {
        val found: IRFunction = builder.module.functions.get(idx)
        return found
    }
    val func = initIRFunction(name)
    builder.module.functions.push(func)
    return func
}

// The C literal for a top-level declaration's value, or "" when the value is
// not a compile-time constant.
//
// Only literals qualify, and that is the whole scope of the feature: a
// top-level `val` is a name for a value the programmer wrote down, not a
// mutable slot, so nothing that has to be computed belongs here. Sema refuses
// the rest with a diagnostic rather than letting it silently become a local --
// see checkTopLevelDeclaration.
// orbit-walk: none -- asks the value of a top-level literal
fn topLevelConstantValue(node: ASTNode) -> string {
    match node {
        ASTNode.Literal(l) => {
            if l.valType == "int" { return l.text }
            if l.valType == "bool" { if l.text == "true" { return "1" } return "0" }
            return ""
        }
        ASTNode.UnaryOp(u) => {
            // A negative literal is a unary minus over a literal, and that is
            // still a constant: `val MIN = -2147483648`.
            if u.op != "-" { return "" }
            val inner = topLevelConstantValue(u.operand)
            if inner == "" { return "" }
            return "-" + inner
        }
        _ => { return "" }
    }
}

// The number a `port` declaration carries, or 0 when the value is not an
// integer literal. Sema has already refused any `port` whose value is not an
// integer literal in 1..65535, so this reads what the parser kept rather than
// validating it a second time. 0 means "no declaration" and leaves the
// emitted default in place.
fn declaredPortValue(value: ASTNode) -> int {
    match value {
        ASTNode.Literal(lit) => {
            if lit.valType == "int" { return parseIntSelfhost(lit.text) }
        }
        _ => {}
    }
    return 0
}

fn buildDecl(builder: IRBuilder, node: ASTNode) {
    match node {
        ASTNode.FunctionDecl(f) => {
            // Generic templates emit nothing themselves; instances are built
            // on demand at call sites (recorded in pass 2 above).
            if f.genericParams.len() == 0 && f.isExtern == false {
                buildFunction(builder, f)
            }
        }
        ASTNode.RouteDecl(r) => {
            buildRoute(builder, r)
        }
        // A top-level declaration with a compile-time constant value becomes a
        // file-scope define in the emitted C, so every function sees the same
        // thing. It used to become a decl_var in whatever function happened to
        // be current -- which is the module's pseudo-main -- so the name was a
        // local, uninitialised, and every read of it was whatever the stack
        // held. `val g = 5` followed by `print(g)` printed an address.
        //
        // The compiler itself never hit that, because its sixteen lexer
        // constants were pasted into the emitter's prelude as literal
        // "#define CHAR_SPACE ' '" strings and the declarations in lexer.orb
        // were decoration. Two sources of truth for one set of names, which had
        // already diverged: lexer.orb declared CHAR_ASTERISK, the pasted list
        // said CHAR_STAR, and using the constant the compiler's own source
        // declared failed to build.
        ASTNode.VarDecl(v) => {
            val constValue = topLevelConstantValue(v.value)
            if constValue != "" {
                builder.module.globals.push(IRGlobal(v.name, ir_string(constValue), inferValueType(builder, v.value)))
                defineVariable(builder, v.name, inferValueType(builder, v.value))
                return
            }
            val func = builder.currentFunction
            val varVal = buildCallArgValue(builder, v.value)
            var vType = v.typeAnnotation
            if vType == "" {
                vType = inferValueType(builder, v.value)
            }
            val vInstance = declaredTypeInstanceName(builder, vType)
            var vc = ""
            if vInstance != "" {
                vc = defineVariable(builder, v.name, vInstance)
            } else {
                vc = defineVariable(builder, v.name, annotationBaseType(vType))
            }
            val instr = ir_init_instr(IROpcode.decl_var)
            instr.operand1 = ir_symbol(vc)
            instr.operand2 = varVal
            ir_emit(func, instr)
            val vElem = annotationListElement(v.typeAnnotation)
            if vElem != "" {
                recordListKind(builder, vc, vElem)
            } else {
                val topElem = annotationListElement(vType)
                if topElem != "" {
                    recordListKind(builder, vc, topElem)
                } else {
                    recordListKind(builder, vc, listKindNameOf(builder, v.value))
                }
            }
        }
        ASTNode.ConstDecl(c) => {
            val constLiteral = topLevelConstantValue(c.value)
            if constLiteral != "" {
                builder.module.globals.push(IRGlobal(c.name, ir_string(constLiteral), inferValueType(builder, c.value)))
                defineVariable(builder, c.name, inferValueType(builder, c.value))
                return
            }
            val valueReg = buildExpr(builder, c.value)
            val irGlobal = IRGlobal(c.name, ir_register(valueReg), inferValueType(builder, c.value))
            builder.module.globals.push(irGlobal)
        }
        ASTNode.ConfigDecl(cfg) => {
            // `port N` is not code: it only tells the emitted server main
            // which port to bind. The other keys parse and are discarded, as
            // they always were.
            if cfg.key == "port" {
                builder.module.configPort = declaredPortValue(cfg.value)
            }
        }
        _ => {}
    }
}

fn buildFunction(builder: IRBuilder, f: FunctionDeclNode) {
    val func = getOrCreateFunction(builder, f.name)
    // The same resolution the prototype got. Two IRFunctions carry one name --
    // the prototype and the body -- and the type verifier reads the last one it
    // finds, so a body still carrying the annotation makes `-> Box<int>` look
    // like it returns something the call destination disagrees with.
    val bodyInstance = declaredTypeInstanceName(builder, f.returnType)
    if bodyInstance != "" {
        func.returnType = bodyInstance
    } else {
        func.returnType = f.returnType
    }
    val prevFunc = builder.currentFunction
    builder.currentFunction = func
    val prevLocalMark = builder.fnLocalMark
    builder.fnLocalMark = builder.fnLocals.len()
    pushVariableScope(builder)
    var i = 0
    while i < f.params.len() {
        val p = f.params.get(i)
        var pType = "unknown"
        if i < f.paramTypes.len() {
            pType = f.paramTypes.get(i)
        }
        val pElem = annotationListElement(pType)
        // `Box<int>` as a parameter is the instance, and the instance has to
        // exist before struct emission reads the module: a signature may be the
        // only mention of the type in the program. Every other annotation keeps
        // its base type, and an EMPTY type name here would define the variable
        // with no type at all -- which is not "unknown", it is nothing, and the
        // first field read through the parameter then loads a field nobody
        // declared.
        val pInstance = declaredTypeInstanceName(builder, pType)
        val pBase = annotationBaseType(pType)
        var pc = ""
        if pInstance != "" {
            pc = defineVariable(builder, p, pInstance)
            // An instance-typed parameter records its bindings from the
            // written form (exact, no loss): a later generic call taking
            // this parameter infers from history.
            val plt = orbit_string_indexOf(pType, "<")
            if plt > 0 && orbit_string_slice(pType, orbit_string_len(pType) - 1, orbit_string_len(pType)) == ">" {
                val pbase = orbit_string_slice(pType, 0, plt)
                if genericModelByName(builder, pbase) != NULL {
                    recordGenericInstance(builder, p, pbase, splitTypeArgs(orbit_string_slice(pType, plt + 1, orbit_string_len(pType) - 1)))
                }
            }
        } else {
            pc = defineVariable(builder, p, pBase)
        }
        if pElem != "" {
            recordListKind(builder, pc, pElem)
        }
        val instr = ir_init_instr(IROpcode.arg)
        var regType = pInstance
        if regType == "" { regType = pBase }
        instr.dest = ir_alloc_register(func, regType)
        instr.operand1 = ir_int(i)
        ir_emit(func, instr)
        i = i + 1
    }
    buildNode(builder, f.body)
    // Auto-append ret if missing
    ensureTrailingRet(func)
    popVariableScope(builder)
    builder.currentFunction = prevFunc
    endFnLocals(builder, prevLocalMark)
}

fn unquoteString(s: string) -> string {
    val len = orbit_string_len(s)
    if len >= 2 {
        if s.at(0) == 34 {
            if s.at(len - 1) == 34 {
                return s.slice(1, len - 1)
            }
        }
    }
    return s
}

fn getOrCreateRouteFunction(builder: IRBuilder, name: string, method: string, path: string) -> IRFunction {
    val idx = findFunction(builder.module, name)
    if idx >= 0 {
        val found: IRFunction = builder.module.functions.get(idx)
        return found
    }
    val func = initRouteFunction(name, method, path)
    builder.module.functions.push(func)
    return func
}

fn buildRoute(builder: IRBuilder, r: RouteDeclNode) {
    val method = unquoteString(r.http_method)
    val path = unquoteString(r.path)
    val routeName = "route_" + method + "_" + path
    val func = getOrCreateRouteFunction(builder, routeName, method, path)
    if r.has_limit {
        func.routeHasLimit = true
        func.routeLimitRate = r.limit_rate
        func.routeLimitWindowMs = r.limit_window_ms
        var b = r.limit_burst
        if b <= 0 { b = r.limit_rate }
        func.routeLimitBurst = b
    }
    val prevFunc = builder.currentFunction
    builder.currentFunction = func
    val prevLocalMark = builder.fnLocalMark
    builder.fnLocalMark = builder.fnLocals.len()
    pushVariableScope(builder)
    buildNode(builder, r.body)
    ensureTrailingRet(func)
    popVariableScope(builder)
    builder.currentFunction = prevFunc
    endFnLocals(builder, prevLocalMark)
}

fn isTerminatorInstr(instr: IRInstruction) -> bool {
    match instr.opcode {
        IROpcode.ret => { return true }
        IROpcode.jump => { return true }
        IROpcode.jump_if_false => { return true }
        _ => { return false }
    }
}

// Whether the instruction that wrote a register is a list_get or a list_pop.
// The scan runs back from the end: the definition is almost always the last
// instruction or one before it.
fn definedByListRead(func: IRFunction, reg: int) -> bool {
    var i = func.instructions.len() - 1
    while i >= 0 {
        val ins: IRInstruction = func.instructions.get(i)
        if ins.dest == reg {
            match ins.opcode {
                IROpcode.list_get => { return true }
                IROpcode.list_pop => { return true }
                _ => { return false }
            }
        }
        i = i - 1
    }
    return false
}

// A `val`/`var` declaration, returning the register its value is in (or -1
// when the value is a constant the caller passed straight through). The
// register is the value of the declaration, so this is also how a block whose
// last statement is a declaration gets the value of that block -- the same
// rule branchTypeName types it by.
fn buildVarDecl(builder: IRBuilder, v: VarDeclNode) -> int {
    val varVal = buildCallArgValue(builder, v.value)
    var vType = v.typeAnnotation
    if vType == "" {
        vType = inferValueType(builder, v.value)
    }
    // Inside a generic instance the spelling may name a parameter: `T` is
    // the call's type here, not an opaque word, or the declaration below
    // emits a `void*` where an `orbit_int` belongs.
    vType = resolveFnType(builder, vType)
    // The static reader gave up, but the register the value lives in has a
    // type: the local is that type, as the C backend already infers from the
    // definition.
    if vType == "" || vType == "unknown" {
        match varVal {
            IRValue.Register(vr) => {
                val vf = builder.currentFunction
                if vr.value >= 0 && vr.value < vf.registerTypes.len() {
                    val rt = vf.registerTypes.get(vr.value)
                    if rt == "int" || rt == "float" || rt == "bool" || rt == "string" {
                        vType = rt
                    }
                }
            }
            _ => {}
        }
    }
    // A read of an object field is lowered from the writes to that key in the
    // same function, which is blind to an object built elsewhere and to a key
    // the literal never wrote. The declaration is the read's expected type,
    // so hand it to the read while it is still visible here; the scan still
    // wins wherever it has an answer.
    if v.typeAnnotation != "" {
        val declKind = fieldKindCode(annotationBaseType(vType))
        if declKind != 0 {
            match varVal {
                IRValue.Register(r) => { recordFieldKindOnDef(builder.currentFunction, r.value, declKind) }
                _ => {}
            }
        }
    }
    // A value received through try has no static type until the annotation
    // says so: a result carries no payload tag, so the unwrap register is
    // unknown. For a float the backend would convert the word instead of
    // decoding its bits. The annotation is the promise -- sema already
    // checked it against the value -- and only a try value is retyped, so a
    // plain unknown keeps the lenient form everywhere else. The emitter casts
    // the word to the register's type for int, bool, string and list.
    match v.value {
        ASTNode.Try(t) => {
            var unwrapType = ""
            if vType == "float" || vType == "orbit_float" { unwrapType = "float" }
            if vType == "int" || vType == "bool" || vType == "string" { unwrapType = vType }
            if annotationBaseType(vType) == "list" { unwrapType = "list" }
            if unwrapType != "" {
                match varVal {
                    IRValue.Register(r) => {
                        val func = builder.currentFunction
                        if r.value >= 0 && r.value < func.registerTypes.len() {
                            func.registerTypes = setRegisterTypeAt(func.registerTypes, r.value, unwrapType)
                        }
                    }
                    _ => {}
                }
            }
        }
        _ => {}
    }
    // A list read with no recorded element type is a word. The annotation
    // says what the word is, as it does for a try value, and sema checked it
    // against the list. The emitter casts the word to the register's type.
    if v.typeAnnotation != "" {
        match varVal {
            IRValue.Register(r) => {
                val readFn = builder.currentFunction
                if r.value >= 0 && r.value < readFn.registerTypes.len() && readFn.registerTypes.get(r.value) == "unknown" && definedByListRead(readFn, r.value) {
                    var readType = ""
                    if vType == "int" || vType == "bool" || vType == "string" {
                        readType = vType
                    } else if annotationBaseType(vType) == "list" {
                        readType = "list"
                    } else {
                        readType = declaredReferenceRegisterType(builder, vType)
                    }
                    if readType != "unknown" {
                        readFn.registerTypes = setRegisterTypeAt(readFn.registerTypes, r.value, readType)
                    }
                }
            }
            _ => {}
        }
    }
    // A model literal bound to a name records its instance bindings: a later
    // generic call taking this variable infers from history, not from the
    // lossy instance-name spelling.
    match v.value {
        ASTNode.TypedLiteral(tl) => {
            val gm = genericModelByName(builder, tl.declaredType)
            if gm != NULL {
                recordGenericInstance(builder, v.name, tl.declaredType, modelLiteralArgTypes(builder, gm, tl.value))
            }
        }
        _ => {}
    }
    // An annotated generic model names its instance; every other annotation
    // keeps its base type, because `list<int>` is a list with an element and
    // the element is recorded separately.
    val vInstance = ""
    var vc = ""
    if vInstance != "" {
        vc = defineVariable(builder, v.name, vInstance)
    } else {
        vc = defineVariable(builder, v.name, annotationBaseType(vType))
    }
    val varInstr = ir_init_instr(IROpcode.decl_var)
    varInstr.operand1 = ir_symbol(vc)
    varInstr.operand2 = varVal
    ir_emit(builder.currentFunction, varInstr)
    val vElem = annotationListElement(v.typeAnnotation)
    if vElem != "" {
        recordListKind(builder, vc, vElem)
    } else {
        val inferredElem = annotationListElement(vType)
        if inferredElem != "" {
            recordListKind(builder, vc, inferredElem)
        } else {
            recordListKind(builder, vc, listKindNameOf(builder, v.value))
        }
    }
    match varVal {
        IRValue.Register(r) => { return r.value }
        _ => { return -1 }
    }
}

// The body of an `if`, once. An `if` that has a value and an `if` that is a
// statement are the same `if`: the branches, the labels, the jump to the merge
// and the end label are identical, and the only difference is that a value
// wants somewhere to put the branch's result. That is the same shape as
// buildMatchBody, and for the same reason: two callers wanting different results
// from one construct is not two constructs.
//
// The result register IS the phi. C has no phi node, so each branch copies its
// own value into the one register and the merge reads it afterwards; a branch
// that produced no value at all (an empty block) copies a zero, because the
// register is a plain C variable that the other branch may have written.
//
// asExpr false allocates no result register at all: an `if` used as a
// statement would only carry a dead declaration into the emitted C.
/** @brief `a && b` and `a || b`, with the right operand evaluated only when the left one allows it.
 *
 *  The result register takes the left value and, when the right operand runs,
 *  the right value, so the control flow is the whole of the semantics: both
 *  operands used to be built before an and_op/or_op instruction, which ran a
 *  guarded read (`j >= 0 && xs.get(j) > k`) and a call on the right side
 *  regardless of the left. and_op and or_op stay in the opcode set but this
 *  builder no longer emits them. */
fn buildShortCircuit(builder: IRBuilder, bin: BinaryOpNode) -> int {
    val lhsReg = buildExpr(builder, bin.lhs)
    val resultReg = ir_alloc_register(builder.currentFunction, "bool")
    emitIfResult(builder, resultReg, lhsReg)
    val endLabel = allocLabel(builder)
    val jmpFalse = ir_init_instr(IROpcode.jump_if_false)
    jmpFalse.operand1 = ir_register(lhsReg)
    if bin.op == "&&" {
        jmpFalse.operand2 = ir_label(endLabel)
        ir_emit(builder.currentFunction, jmpFalse)
    } else {
        val rhsLabel = allocLabel(builder)
        jmpFalse.operand2 = ir_label(rhsLabel)
        ir_emit(builder.currentFunction, jmpFalse)
        ir_emit(builder.currentFunction, jumpTo(endLabel))
        val lblRhs = ir_init_instr(IROpcode.label)
        lblRhs.operand1 = ir_label(rhsLabel)
        ir_emit(builder.currentFunction, lblRhs)
    }
    val rhsReg = buildExpr(builder, bin.rhs)
    emitIfResult(builder, resultReg, rhsReg)
    val lblEnd = ir_init_instr(IROpcode.label)
    lblEnd.operand1 = ir_label(endLabel)
    ir_emit(builder.currentFunction, lblEnd)
    return resultReg
}

fn buildIfBody(builder: IRBuilder, n: IfNode, asExpr: bool) -> int {
    val condReg = buildExpr(builder, n.condition)
    val elseLabel = allocLabel(builder)
    val endLabel = allocLabel(builder)
    var resultReg = -1
    if asExpr {
        resultReg = ir_alloc_register(builder.currentFunction, branchTypeName(builder, n.thenBody))
    }
    val jmpFalse = ir_init_instr(IROpcode.jump_if_false)
    jmpFalse.operand1 = ir_register(condReg)
    jmpFalse.operand2 = ir_label(elseLabel)
    ir_emit(builder.currentFunction, jmpFalse)
    val thenStart = builder.currentFunction.instructions.len()
    var thenReg = -1
    if asExpr {
        thenReg = buildBranchValue(builder, n.thenBody)
    } else {
        buildNode(builder, n.thenBody)
    }
    val thenAdded = builder.currentFunction.instructions.len() - thenStart
    var thenTerminates = false
    if thenAdded > 0 {
        val lastThen: IRInstruction = builder.currentFunction.instructions.get(builder.currentFunction.instructions.len() - 1)
        thenTerminates = isTerminatorInstr(lastThen)
    }
    if thenTerminates == false {
        if asExpr {
            emitIfResult(builder, resultReg, thenReg)
        }
        val jmpEnd = ir_init_instr(IROpcode.jump)
        jmpEnd.operand1 = ir_label(endLabel)
        ir_emit(builder.currentFunction, jmpEnd)
    }
    val lblElseInstr = ir_init_instr(IROpcode.label)
    lblElseInstr.operand1 = ir_label(elseLabel)
    ir_emit(builder.currentFunction, lblElseInstr)
    var hasElse = true
    match n.elseBody {
        ASTNode.Empty => { hasElse = false }
        _ => {}
    }
    var elseReg = -1
    if hasElse {
        if asExpr {
            elseReg = buildBranchValue(builder, n.elseBody)
        } else {
            buildNode(builder, n.elseBody)
        }
    }
    var elseTerminates = thenTerminates
    if hasElse && builder.currentFunction.instructions.len() > 0 {
        val lastElse: IRInstruction = builder.currentFunction.instructions.get(builder.currentFunction.instructions.len() - 1)
        elseTerminates = isTerminatorInstr(lastElse)
    }
    if thenTerminates == false || elseTerminates == false {
        if asExpr && hasElse && elseTerminates == false {
            emitIfResult(builder, resultReg, elseReg)
        }
        val lblEndInstr = ir_init_instr(IROpcode.label)
        lblEndInstr.operand1 = ir_label(endLabel)
        ir_emit(builder.currentFunction, lblEndInstr)
    }
    if asExpr { return resultReg }
    return 0
}

// One branch's value into the `if`'s result register. A branch with no value --
// an empty block, a `return` -- leaves a zero rather than copying a register
// that was never allocated, which would put a negative register number into the
// emitted C.
fn emitIfResult(builder: IRBuilder, resultReg: int, valueReg: int) {
    var src = valueReg
    if src < 0 {
        val zeroReg = ir_alloc_register(builder.currentFunction, "int")
        val zeroInstr = ir_init_instr(IROpcode.load_const)
        zeroInstr.dest = zeroReg
        zeroInstr.operand1 = ir_int(0)
        ir_emit(builder.currentFunction, zeroInstr)
        src = zeroReg
    }
    inheritRegisterType(builder, resultReg, src)
    val copyInstr = ir_init_instr(IROpcode.copy)
    copyInstr.dest = resultReg
    copyInstr.operand1 = ir_register(src)
    ir_emit(builder.currentFunction, copyInstr)
}

// A branch result register the static reader could not type takes the type of
// the first branch value whose register has one, as the C backend infers it
// from the copies.
fn inheritRegisterType(builder: IRBuilder, dest: int, src: int) {
    val f = builder.currentFunction
    if dest < 0 || dest >= f.registerTypes.len() || src < 0 || src >= f.registerTypes.len() { return }
    if f.registerTypes.get(dest) != "unknown" { return }
    val st = f.registerTypes.get(src)
    if st == "int" || st == "float" || st == "bool" || st == "string" {
        f.registerTypes = setRegisterTypeAt(f.registerTypes, dest, st)
    }
}

// One branch, built for its value. A block branch runs its statements in its
// own scope and is worth its last one; a branch written as an expression is
// built as an expression. -1 means the branch has no value, and the caller
// decides what to do about that.
fn buildBranchValue(builder: IRBuilder, node: ASTNode) -> int {
    match node {
        ASTNode.Block(b) => {
            pushVariableScope(builder)
            val count = b.statements.len()
            var i = 0
            while i + 1 < count {
                buildNode(builder, b.statements.get(i))
                i = i + 1
            }
            var reg = -1
            if count > 0 {
                reg = buildLastStatementValue(builder, b.statements.get(count - 1))
            }
            popVariableScope(builder)
            return reg
        }
        ASTNode.Empty => { return -1 }
        _ => { return buildExpr(builder, node) }
    }
}

// The value of a block's last statement, or -1 when it has none to give.
//
// The statements of a block are not wrapped in a node of their own: a bare
// expression statement IS the expression. So this is a division between the two
// kinds of statement, and it is the division buildNode already draws: the forms
// listed here are the ones it builds without asking for a value, and everything
// else is a value form -- a literal, an operator, a call, a read, a literal
// list or object, a match, a try, a nested `if`, or the bare expression a block
// statement is -- which buildExpr answers with a register.
//
// A `val` is the one statement that has both: the declaration runs, and the
// value it declared is the value of the block.
fn buildLastStatementValue(builder: IRBuilder, node: ASTNode) -> int {
    match node {
        ASTNode.VarDecl(v) => { return buildVarDecl(builder, v) }
        ASTNode.ExpressionStmt(e) => { return buildExpr(builder, e.expr) }
        ASTNode.Return(x) => { buildNode(builder, node)
            return -1
        }
        ASTNode.ReturnOk(x) => { buildNode(builder, node)
            return -1
        }
        ASTNode.ReturnErr(x) => { buildNode(builder, node)
            return -1
        }
        ASTNode.While(x) => { buildNode(builder, node)
            return -1
        }
        ASTNode.For(x) => { buildNode(builder, node)
            return -1
        }
        ASTNode.Block(x) => { buildNode(builder, node)
            return -1
        }
        ASTNode.Break(x) => { buildNode(builder, node)
            return -1
        }
        ASTNode.Continue(x) => { buildNode(builder, node)
            return -1
        }
        ASTNode.Empty => { return -1 }
        _ => { return buildExpr(builder, node) }
    }
}

// `break` jumps to the innermost loop's end label, `continue` to its start
// label. Those are the same nine lines with a different stack, and the two arms
// used to say so twice. Neither stack is checked for emptiness here beyond the
// length test: a break outside a loop has no label to jump to and emits
// nothing, which is what both arms always did.
fn emitLoopJump(builder: IRBuilder, labels: list < int >) -> int {
    if labels.len() > 0 {
        val label = labels.get(labels.len() - 1)
        val jmp = ir_init_instr(IROpcode.jump)
        jmp.operand1 = ir_label(label)
        ir_emit(builder.currentFunction, jmp)
    }
    return -1
}

// A `break outer` jumps to the named loop's end, searched innermost-first
// so it resolves exactly the way the checker's loopLabels stack does. An
// empty name keeps the old top-of-stack behavior; an unresolvable name
// emits nothing, which is safe because the checker already refused it.
fn emitNamedLoopJump(builder: IRBuilder, labels: list < int >, name: string) -> int {
    if name == "" { return emitLoopJump(builder, labels) }
    var i = builder.loopLabelNames.len()
    while i > 0 {
        i = i - 1
        if builder.loopLabelNames.get(i) == name {
            val label = labels.get(i)
            val jmp = ir_init_instr(IROpcode.jump)
            jmp.operand1 = ir_label(label)
            ir_emit(builder.currentFunction, jmp)
            return -1
        }
    }
    return -1
}

// The tail every loop ends with: jump back to the top, label the end, and pop
// both label stacks. `while` and `for` each wrote these ten lines out, and the
// two copies differed only in what the end-label instruction was called. A
// missing pop means a `break` in the next loop jumps to the wrong place, and
// that is not a crash you would blame on this file.
fn jumpTo(label: int) -> IRInstruction {
    val jmp = ir_init_instr(IROpcode.jump)
    jmp.operand1 = ir_label(label)
    return jmp
}

fn closeLoop(builder: IRBuilder, endLabel: int) {
    val lblEnd = ir_init_instr(IROpcode.label)
    lblEnd.operand1 = ir_label(endLabel)
    ir_emit(builder.currentFunction, lblEnd)
    builder.loopStartLabels.pop()
    builder.loopEndLabels.pop()
    builder.loopLabelNames.pop()
    builder.loopContinueLabels.pop()
}

// A C function whose body does not end in a return is undefined behaviour when
// it is called, and gcc only mentions it under -Wreturn-type, which is not in
// this project's -Wall set -- so the emitter appends the return rather than
// hoping. buildFunction and buildRoute each wrote these fifteen lines out, and
// only one of the two had a comment saying what they were for, which is how a
// reader ends up believing there is one of them.
fn ensureTrailingRet(func: IRFunction) {
    if func.instructions.len() > 0 {
        val last: IRInstruction = func.instructions.get(func.instructions.len() - 1)
        match last.opcode {
            IROpcode.ret => { return }
            _ => {}
        }
    }
    val ret = ir_init_instr(IROpcode.ret)
    ret.operand1 = ir_none()
    ir_emit(func, ret)
}

// The list path of `for`: walk slots 0..len, rebinding item (and the
// user's index, when named) every iteration. Extracted verbatim from the
// buildNode For arm when the range path arrived, so neither path pays for
// the other's shape.
//
// `stmt` is annotated ForNode on purpose: parameters pass raw, while an
// unannotated (unknown) parameter wraps the value and the field reads land
// on the wrong slots (`body` read the iterable). The annotation typechecks
// because `iterable` is declared ASTNode, as built.
fn buildForList(builder: IRBuilder, stmt: ForNode) {
    val iterReg = buildExpr(builder, stmt.iterable)
    // The element type of the iterable, decided here so the loop
    // variable is not `unknown`. A `for x in [1,2,3] { print(x) }`
    // whose x was unknown reached print as a string and printed the
    // integer 1 as the address 0x1, or segfaulted; the variable's type
    // is what tells those two emitters apart.
    // The same two sources as an explicit read, and for the same reason: a `for`
    // over a list whose kind was never pushed -- it came from a field or
    // from a `->` function -- has no name-keyed entry, and the loop
    // variable then typed as the raw word.
    val iterKind = elemKindCode(listReadElemKindName(builder, stmt.iterable))
    val iterElemType = listReadRegisterType(builder, stmt.iterable, iterKind)
    val lenReg = ir_alloc_register(builder.currentFunction, "int")
    val lenInstr = ir_init_instr(IROpcode.list_len)
    lenInstr.dest = lenReg
    lenInstr.operand1 = ir_register(iterReg)
    ir_emit(builder.currentFunction, lenInstr)
    val zeroReg = ir_alloc_register(builder.currentFunction, "int")
    val zeroConst = ir_init_instr(IROpcode.load_const)
    zeroConst.dest = zeroReg
    zeroConst.operand1 = ir_int(0)
    ir_emit(builder.currentFunction, zeroConst)

    val idxC = defineVariable(builder, stmt.item + "_idx", "int")
    val itemC = defineVariable(builder, stmt.item, iterElemType)
    // The user's index name, when `for x, i` names one: a sibling
    // variable the emitter rewrites every iteration from the hidden
    // counter. defineVariable mints on collision (`i__sN`), and reads
    // resolve innermost-first, so an index shadowing the hidden
    // `<item>_idx` still reads the user's, while the machinery below
    // keeps using idxC directly and never the name.
    var indexC = ""
    if stmt.indexVar != "" {
        indexC = defineVariable(builder, stmt.indexVar, "int")
    }
    val idxInit = ir_init_instr(IROpcode.decl_var)
    idxInit.operand1 = ir_symbol(idxC)
    idxInit.operand2 = ir_register(zeroReg)
    ir_emit(builder.currentFunction, idxInit)
    val startLabel = allocLabel(builder)
    val endLabel = allocLabel(builder)
    builder.loopStartLabels.push(startLabel)
    builder.loopEndLabels.push(endLabel)
    builder.loopLabelNames.push(stmt.label)
    val incrLabel = allocLabel(builder)
    builder.loopContinueLabels.push(incrLabel)
    val lblStart = ir_init_instr(IROpcode.label)
    lblStart.operand1 = ir_label(startLabel)
    ir_emit(builder.currentFunction, lblStart)
    // Load idx from variable
    val idxLoadReg = ir_alloc_register(builder.currentFunction, "int")
    val idxLoad = ir_init_instr(IROpcode.load_var)
    idxLoad.dest = idxLoadReg
    idxLoad.operand1 = ir_symbol(idxC)
    ir_emit(builder.currentFunction, idxLoad)
    val condReg = ir_alloc_register(builder.currentFunction, "bool")
    val condInstr = ir_init_instr(IROpcode.lt)
    condInstr.dest = condReg
    condInstr.operand1 = ir_register(idxLoadReg)
    condInstr.operand2 = ir_register(lenReg)
    ir_emit(builder.currentFunction, condInstr)
    val jmpFalse = ir_init_instr(IROpcode.jump_if_false)
    jmpFalse.operand1 = ir_register(condReg)
    jmpFalse.operand2 = ir_label(endLabel)
    ir_emit(builder.currentFunction, jmpFalse)
    val itemReg = ir_alloc_register(builder.currentFunction, iterElemType)
    val getInstr = ir_init_instr(IROpcode.list_get)
    getInstr.dest = itemReg
    getInstr.operand1 = ir_register(iterReg)
    getInstr.operand2 = ir_register(idxLoadReg)
    getInstr.elemKind = iterKind
    ir_emit(builder.currentFunction, getInstr)
    val declItem = ir_init_instr(IROpcode.decl_var)
    declItem.operand1 = ir_symbol(itemC)
    declItem.operand2 = ir_register(itemReg)
    ir_emit(builder.currentFunction, declItem)
    if indexC != "" {
        val declIndex = ir_init_instr(IROpcode.decl_var)
        declIndex.operand1 = ir_symbol(indexC)
        declIndex.operand2 = ir_register(idxLoadReg)
        ir_emit(builder.currentFunction, declIndex)
    }
    buildNode(builder, stmt.body)
    // The increment a `continue` must not skip: continuing a `for`
    // to its start label reloads the same index and hangs, so the
    // loop's continue target is this label, emitted here.
    val lblIncr = ir_init_instr(IROpcode.label)
    lblIncr.operand1 = ir_label(incrLabel)
    ir_emit(builder.currentFunction, lblIncr)
    // Increment and store idx
    val incReg = ir_alloc_register(builder.currentFunction, "int")
    val incInstr = ir_init_instr(IROpcode.add)
    incInstr.dest = incReg
    incInstr.operand1 = ir_register(idxLoadReg)
    incInstr.operand2 = ir_int(1)
    ir_emit(builder.currentFunction, incInstr)
    val storeIdx = ir_init_instr(IROpcode.store_var)
    storeIdx.operand1 = ir_symbol(idxC)
    storeIdx.operand2 = ir_register(incReg)
    ir_emit(builder.currentFunction, storeIdx)
    ir_emit(builder.currentFunction, jumpTo(startLabel))
    closeLoop(builder, endLabel)
}

// The range path of `for`: count a hidden counter from lo while it is below
// hi, rebinding the item to the counter every iteration. O(1) memory on
// purpose: materializing `0..n` as a list first would make a large bound a
// large allocation, and the counter is all the loop needs. Both bounds
// evaluate once, before the loop, so `for x in 0..f()` calls f once. The
// user's index, when named, is the 0-based position (counter minus lo),
// exactly what it is over a list.
fn buildForRange(builder: IRBuilder, stmt: ForNode, r: RangeNode) {
    val loReg = buildExpr(builder, r.lo)
    val hiReg = buildExpr(builder, r.hi)
    val counterC = defineVariable(builder, stmt.item + "_range", "int")
    val itemC = defineVariable(builder, stmt.item, "int")
    var indexC = ""
    if stmt.indexVar != "" {
        indexC = defineVariable(builder, stmt.indexVar, "int")
    }
    val counterInit = ir_init_instr(IROpcode.decl_var)
    counterInit.operand1 = ir_symbol(counterC)
    counterInit.operand2 = ir_register(loReg)
    ir_emit(builder.currentFunction, counterInit)
    val startLabel = allocLabel(builder)
    val endLabel = allocLabel(builder)
    builder.loopStartLabels.push(startLabel)
    builder.loopEndLabels.push(endLabel)
    builder.loopLabelNames.push(stmt.label)
    val incrLabel = allocLabel(builder)
    builder.loopContinueLabels.push(incrLabel)
    val lblStart = ir_init_instr(IROpcode.label)
    lblStart.operand1 = ir_label(startLabel)
    ir_emit(builder.currentFunction, lblStart)
    val counterLoadReg = ir_alloc_register(builder.currentFunction, "int")
    val counterLoad = ir_init_instr(IROpcode.load_var)
    counterLoad.dest = counterLoadReg
    counterLoad.operand1 = ir_symbol(counterC)
    ir_emit(builder.currentFunction, counterLoad)
    val condReg = ir_alloc_register(builder.currentFunction, "bool")
    val condInstr = ir_init_instr(IROpcode.lt)
    condInstr.dest = condReg
    condInstr.operand1 = ir_register(counterLoadReg)
    condInstr.operand2 = ir_register(hiReg)
    ir_emit(builder.currentFunction, condInstr)
    val jmpFalse = ir_init_instr(IROpcode.jump_if_false)
    jmpFalse.operand1 = ir_register(condReg)
    jmpFalse.operand2 = ir_label(endLabel)
    ir_emit(builder.currentFunction, jmpFalse)
    val declItem = ir_init_instr(IROpcode.decl_var)
    declItem.operand1 = ir_symbol(itemC)
    declItem.operand2 = ir_register(counterLoadReg)
    ir_emit(builder.currentFunction, declItem)
    if indexC != "" {
        val posReg = ir_alloc_register(builder.currentFunction, "int")
        val posInstr = ir_init_instr(IROpcode.sub)
        posInstr.dest = posReg
        posInstr.operand1 = ir_register(counterLoadReg)
        posInstr.operand2 = ir_register(loReg)
        ir_emit(builder.currentFunction, posInstr)
        val declIndex = ir_init_instr(IROpcode.decl_var)
        declIndex.operand1 = ir_symbol(indexC)
        declIndex.operand2 = ir_register(posReg)
        ir_emit(builder.currentFunction, declIndex)
    }
    buildNode(builder, stmt.body)
    val lblIncr = ir_init_instr(IROpcode.label)
    lblIncr.operand1 = ir_label(incrLabel)
    ir_emit(builder.currentFunction, lblIncr)
    val incReg = ir_alloc_register(builder.currentFunction, "int")
    val incInstr = ir_init_instr(IROpcode.add)
    incInstr.dest = incReg
    incInstr.operand1 = ir_register(counterLoadReg)
    incInstr.operand2 = ir_int(1)
    ir_emit(builder.currentFunction, incInstr)
    val storeCounter = ir_init_instr(IROpcode.store_var)
    storeCounter.operand1 = ir_symbol(counterC)
    storeCounter.operand2 = ir_register(incReg)
    ir_emit(builder.currentFunction, storeCounter)
    ir_emit(builder.currentFunction, jumpTo(startLabel))
    closeLoop(builder, endLabel)
}

// orbit-walk-misses: AssignmentNode, BinaryOpNode, CallNode, ConfigDeclNode, ConstDeclNode, ExpressionStmtNode, FieldInitNode, FunctionDeclNode, IndexAccessNode, MatchCaseNode, MemberAccessNode, ScheduleDeclNode, TryNode, TypedLiteralNode, UnaryOpNode
fn buildNode(builder: IRBuilder, node: ASTNode) {
    match node {
        ASTNode.Block(b) => {
            pushVariableScope(builder)
            var i = 0
            while i < b.statements.len() {
                buildNode(builder, b.statements.get(i))
                i = i + 1
            }
            popVariableScope(builder)
        }
        ASTNode.If(stmt) => {
            buildIfBody(builder, stmt, false)
        }
        ASTNode.While(stmt) => {
            val startLabel = allocLabel(builder)
            val endLabel = allocLabel(builder)
            builder.loopStartLabels.push(startLabel)
            builder.loopEndLabels.push(endLabel)
            builder.loopLabelNames.push("")
            builder.loopContinueLabels.push(startLabel)
            val lblStartInstr = ir_init_instr(IROpcode.label)
            lblStartInstr.operand1 = ir_label(startLabel)
            ir_emit(builder.currentFunction, lblStartInstr)
            val condReg = buildExpr(builder, stmt.condition)
            val jmpFalse = ir_init_instr(IROpcode.jump_if_false)
            jmpFalse.operand1 = ir_register(condReg)
            jmpFalse.operand2 = ir_label(endLabel)
            ir_emit(builder.currentFunction, jmpFalse)
            buildNode(builder, stmt.body)
            ir_emit(builder.currentFunction, jumpTo(startLabel))
            closeLoop(builder, endLabel)
        }
        ASTNode.For(stmt) => {
            // A range counts with its own counter; a list walks its slots.
            // The split is here so neither path pays for the other's shape,
            // and both share labels, index and continue-target handling.
            match stmt.iterable {
                ASTNode.Range(r) => { buildForRange(builder, stmt, r) }
                _ => { buildForList(builder, stmt) }
            }
        }
        ASTNode.Return(r) => {
            // Check for Empty expr
            match r.expr {
                ASTNode.Empty => {
                    val retInstr = ir_init_instr(IROpcode.ret)
                    retInstr.operand1 = ir_none()
                    ir_emit(builder.currentFunction, retInstr)
                }
                ASTNode.Literal(lit) => {
                    if lit.valType == "int" {
                        // parseIntSelfhost already reads the "0x" prefix and
                        // steps over "_", so the hand-rolled digit loop that
                        // used to be here was a second dialect of the same
                        // thing: it understood decimal only, which made
                        // `return 0xFF` compile to 0.
                        var litVal = parseIntSelfhost(lit.text)
                        if orbit_string_len(lit.text) > 0 && lit.text.at(0) == 45 {
                            litVal = 0 - litVal
                        }
                        val retInstr = ir_init_instr(IROpcode.ret)
                        retInstr.operand1 = ir_int(litVal)
                        ir_emit(builder.currentFunction, retInstr)
                    } else {
                        val retReg = buildExpr(builder, r.expr)
                        val retInstr = ir_init_instr(IROpcode.ret)
                        retInstr.operand1 = ir_register(retReg)
                        ir_emit(builder.currentFunction, retInstr)
                    }
                }
                _ => {
                    var retReg = -1
                    if isModelDeclName(builder, builder.currentFunction.returnType) {
                        match r.expr {
                            ASTNode.ObjectLiteral(ol) => {
                                retReg = buildObjectLiteralAsModel(builder, r.expr, builder.currentFunction.returnType)
                            }
                            _ => {}
                        }
                    }
                    if retReg < 0 {
                        retReg = buildExpr(builder, r.expr)
                    }
                    val retInstr = ir_init_instr(IROpcode.ret)
                    retInstr.operand1 = ir_register(retReg)
                    ir_emit(builder.currentFunction, retInstr)
                }
            }
        }
        ASTNode.ReturnOk(r) => {
            if builder.currentFunction.returnType == "result" {
                val valReg = buildExpr(builder, r.expr)
                val instr = ir_init_instr(IROpcode.result_ok)
                instr.operand1 = ir_register(valReg)
                val resReg = ir_alloc_register(builder.currentFunction, "result")
                instr.dest = resReg
                ir_emit(builder.currentFunction, instr)
                val retInstr = ir_init_instr(IROpcode.ret)
                retInstr.operand1 = ir_register(resReg)
                ir_emit(builder.currentFunction, retInstr)
                return
            }
            var statusCode = 200
            if r.status != "" {
                statusCode = parseIntSelfhost(r.status)
            }
            // The body is built first, before the status argument is pushed.
            // Arguments are a flat stack the backend drains in order, and a
            // call emitted while the list is half built would be handed
            // whatever happened to be on top of it.
            val bodyValue = buildCallArgValue(builder, r.expr)
            val arg1 = ir_init_instr(IROpcode.arg)
            arg1.operand1 = ir_int(statusCode)
            ir_emit(builder.currentFunction, arg1)
            val arg2 = ir_init_instr(IROpcode.arg)
            // An object is a value, not text: serialize it here so the response
            // is a JSON string, and so every string inside it gets escaped.
            if isObjectValue(builder, bodyValue) {
                val jsonReg = emitObjectToJson(builder, bodyValue)
                arg2.operand1 = ir_register(jsonReg)
            } else {
                arg2.operand1 = bodyValue
            }
            ir_emit(builder.currentFunction, arg2)
            val resReg = ir_alloc_register(builder.currentFunction, "response")
            val callInstr = ir_init_instr(IROpcode.call)
            callInstr.dest = resReg
            callInstr.operand1 = ir_string("orbit_response_json")
            callInstr.operand2 = ir_int(2)
            ir_emit(builder.currentFunction, callInstr)
            val retInstr = ir_init_instr(IROpcode.ret)
            retInstr.operand1 = ir_register(resReg)
            ir_emit(builder.currentFunction, retInstr)
        }
        ASTNode.ReturnErr(r) => {
            if builder.currentFunction.returnType == "result" {
                val msgReg = buildExpr(builder, r.expr)
                var code = 500
                if r.code != "" {
                    code = parseIntSelfhost(r.code)
                }
                val instr = ir_init_instr(IROpcode.result_err)
                instr.operand1 = ir_register(msgReg)
                instr.operand2 = ir_int(code)
                val resReg = ir_alloc_register(builder.currentFunction, "result")
                instr.dest = resReg
                ir_emit(builder.currentFunction, instr)
                val retInstr = ir_init_instr(IROpcode.ret)
                retInstr.operand1 = ir_register(resReg)
                ir_emit(builder.currentFunction, retInstr)
                return
            }
            var statusCode = 500
            if r.code != "" {
                statusCode = parseIntSelfhost(r.code)
            }
            val arg1 = ir_init_instr(IROpcode.arg)
            arg1.operand1 = ir_int(statusCode)
            ir_emit(builder.currentFunction, arg1)
            val arg2 = ir_init_instr(IROpcode.arg)
            arg2.operand1 = buildCallArgValue(builder, r.expr)
            ir_emit(builder.currentFunction, arg2)
            val resReg = ir_alloc_register(builder.currentFunction, "response")
            val callInstr = ir_init_instr(IROpcode.call)
            callInstr.dest = resReg
            callInstr.operand1 = ir_string("orbit_response_error")
            callInstr.operand2 = ir_int(2)
            ir_emit(builder.currentFunction, callInstr)
            val retInstr = ir_init_instr(IROpcode.ret)
            retInstr.operand1 = ir_register(resReg)
            ir_emit(builder.currentFunction, retInstr)
        }
        ASTNode.VarDecl(v) => {
            buildVarDecl(builder, v)
        }
        ASTNode.Match(m) => {
            buildMatchStatement(builder, m)
        }
        ASTNode.ModelDecl(m) => {
            // Models are registered in pass 1, no codegen needed
        }
        ASTNode.MigrationDecl(m) => {
            // Registered in pass 1, no codegen needed
        }
        ASTNode.TypeDecl(t) => {
            // Types are registered in pass 1
        }
        ASTNode.RouteDecl(r) => {
            // Routes are handled in pass 2/3
        }
        ASTNode.Empty => {}
        _ => {
            // Expression statement
            buildExpr(builder, node)
        }
    }
}

// The body of a match, once. buildMatchStatement and buildMatchExpr were the
// same 170 lines twice, differing in 5: whether a case body is built as a
// statement or as an expression, and whether the whole thing hands back a
// register. A match is a match; the two callers wanted different results from
// it, not a different algorithm.
// One variant tag test: the shape a qualified pattern (`T.V`) and a bare one
// (`V`, with its owner resolved) both lower to. A union scrutinee is a tag
// node, so its tag is read first; an enumeration scrutinee IS the tag, so the
// value is compared as it stands. The arm is jumped over when the tag is some
// other variant.
fn emitVariantTagTest(builder: IRBuilder, matchReg: int, nextLabel: int, owner: string, field: string) {
    var cmpReg = matchReg
    if isUnionTypeName(builder, owner) {
        cmpReg = ir_alloc_register(builder.currentFunction, "int")
        val tagInstr = ir_init_instr(IROpcode.union_get_tag)
        tagInstr.dest = cmpReg
        tagInstr.operand1 = ir_register(matchReg)
        ir_emit(builder.currentFunction, tagInstr)
    }
    val patReg = ir_alloc_register(builder.currentFunction, "int")
    val constInstr = ir_init_instr(IROpcode.load_var)
    constInstr.dest = patReg
    constInstr.operand1 = ir_symbol(owner + "_TAG_" + field)
    ir_emit(builder.currentFunction, constInstr)
    val eqReg = ir_alloc_register(builder.currentFunction, "bool")
    val eqInstr = ir_init_instr(IROpcode.eq)
    eqInstr.dest = eqReg
    eqInstr.operand1 = ir_register(cmpReg)
    eqInstr.operand2 = ir_register(patReg)
    ir_emit(builder.currentFunction, eqInstr)
    val jmp = ir_init_instr(IROpcode.jump_if_false)
    jmp.operand1 = ir_register(eqReg)
    jmp.operand2 = ir_label(nextLabel)
    ir_emit(builder.currentFunction, jmp)
}

fn buildMatchBody(builder: IRBuilder, m: MatchNode, asExpr: bool) -> int {
    val matchReg = buildExpr(builder, m.expr)
    // Only the expression form has a value to return. Allocating it
    // unconditionally would emit a dead register for every match used as a
    // statement, and the emitted C carries those declarations.
    val resultReg = ir_alloc_register(builder.currentFunction, "unknown")
    val endLabel = allocLabel(builder)
    val numCases = m.cases.len()
    val caseLabels: list < int > = []
    var i = 0
    while i < numCases {
        caseLabels.push(allocLabel(builder))
        i = i + 1
    }
    i = 0
    while i < numCases {
        val caseNode = m.cases.get(i)
        match caseNode {
            ASTNode.MatchCase(c) => {
                val caseLabel = caseLabels.get(i)
                val caseLbl = ir_init_instr(IROpcode.label)
                caseLbl.operand1 = ir_label(caseLabel)
                ir_emit(builder.currentFunction, caseLbl)
                var nextLabel = endLabel
                if i + 1 < numCases {
                    nextLabel = caseLabels.get(i + 1)
                }
                match c.pattern {
                    ASTNode.Literal(lit) => {
                        if lit.text == "_" {
                            // Wildcard: always match
                        } else {
                            // A bare name that is a variant of the matched type
                            // is the same test as the qualified spelling:
                            // `match o { NoInt => ... }` means what
                            // `OptInt.NoInt` means. Without this the name built
                            // as an ordinary expression -- an uppercase name went
                            // to load_const, and the C step rejected the result
                            // with `unknown type name 'NoInt'`.
                            var litOwner = ""
                            if lit.valType == "identifier" {
                                litOwner = bareVariantOwner(builder, m.expr, lit.text)
                            }
                            if litOwner != "" {
                                emitVariantTagTest(builder, matchReg, nextLabel, litOwner, lit.text)
                            } else {
                                val patReg = buildExpr(builder, c.pattern)
                                val eqReg = ir_alloc_register(builder.currentFunction, "bool")
                                val eqInstr = ir_init_instr(IROpcode.eq)
                                eqInstr.dest = eqReg
                                eqInstr.operand1 = ir_register(matchReg)
                                eqInstr.operand2 = ir_register(patReg)
                                ir_emit(builder.currentFunction, eqInstr)
                                val jmp = ir_init_instr(IROpcode.jump_if_false)
                                jmp.operand1 = ir_register(eqReg)
                                jmp.operand2 = ir_label(nextLabel)
                                ir_emit(builder.currentFunction, jmp)
                            }
                        }
                    }
                    ASTNode.MemberAccess(mp) => {
                        // Payload-less variant pattern, e.g. ASTNode.Empty =>
                        // The scrutinee of a tagged union is a node pointer, so
                        // compare its tag instead of the pointer itself.
                        var mpOwner = ""
                        match mp.object {
                            ASTNode.Literal(mpl) => { mpOwner = mpl.text }
                            _ => {}
                        }
                        if mpOwner != "" {
                            emitVariantTagTest(builder, matchReg, nextLabel, mpOwner, mp.field)
                        } else {
                            val mpPatReg = buildExpr(builder, c.pattern)
                            val mpEqReg = ir_alloc_register(builder.currentFunction, "bool")
                            val mpEqInstr = ir_init_instr(IROpcode.eq)
                            mpEqInstr.dest = mpEqReg
                            mpEqInstr.operand1 = ir_register(matchReg)
                            mpEqInstr.operand2 = ir_register(mpPatReg)
                            ir_emit(builder.currentFunction, mpEqInstr)
                            val mpJmp = ir_init_instr(IROpcode.jump_if_false)
                            mpJmp.operand1 = ir_register(mpEqReg)
                            mpJmp.operand2 = ir_label(nextLabel)
                            ir_emit(builder.currentFunction, mpJmp)
                        }
                    }
                    ASTNode.Call(callPattern) => {
                        // Tagged union variant destructuring pattern e.g. ASTNode.Program(p)
                        var tagName = ""
                        var tagOwner = ""
                        match callPattern.callee {
                            ASTNode.MemberAccess(ma2) => {
                                tagName = ma2.field
                                match ma2.object {
                                    ASTNode.Literal(ol2) => { tagOwner = ol2.text }
                                    _ => {}
                                }
                            }
                            ASTNode.Literal(lit2) => { tagName = lit2.text }
                            _ => {}
                        }
                        val tagReg = ir_alloc_register(builder.currentFunction, "int")
                        val tagInstr = ir_init_instr(IROpcode.union_get_tag)
                        tagInstr.dest = tagReg
                        tagInstr.operand1 = ir_register(matchReg)
                        ir_emit(builder.currentFunction, tagInstr)

                        var dataType = "unknown"
                        if callPattern.args.len() == 1 {
                            dataType = unionDataRegisterType(builder, tagOwner, tagName)
                        }
                        val dataReg = ir_alloc_register(builder.currentFunction, dataType)
                        val dataInstr = ir_init_instr(IROpcode.union_get_data)
                        dataInstr.dest = dataReg
                        dataInstr.operand1 = ir_register(matchReg)
                        ir_emit(builder.currentFunction, dataInstr)

                        if callPattern.args.len() == 1 {
                            val argNode = callPattern.args.get(0)
                            match argNode {
                                ASTNode.Literal(argLit) => {
                                    if argLit.valType == "identifier" {
                                        val argC = defineVariable(builder, argLit.text, variantPayloadType(builder, tagName))
                                        val declVar = ir_init_instr(IROpcode.decl_var)
                                        declVar.operand1 = ir_symbol(argC)
                                        declVar.operand2 = ir_register(dataReg)
                                        ir_emit(builder.currentFunction, declVar)
                                    }
                                }
                                _ => {}
                            }
                        }

                        // The tag to compare against must be the bare integer
                        // constant, NOT buildExpr(callee): buildExpr now builds a
                        // real variant node for payload-less union variants, and
                        // comparing the scrutinee's tag against a freshly built
                        // node pointer can never be true.
                        var varPatReg = -1
                        if tagOwner != "" {
                            varPatReg = ir_alloc_register(builder.currentFunction, "int")
                            val varPatInstr = ir_init_instr(IROpcode.load_var)
                            varPatInstr.dest = varPatReg
                            varPatInstr.operand1 = ir_symbol(tagOwner + "_TAG_" + tagName)
                            ir_emit(builder.currentFunction, varPatInstr)
                        } else {
                            // Bare `V(a)`: no owner in the pattern, so the tag
                            // comes from the first union declaring the
                            // variant. Without this the callee built as a bare
                            // variable reference, which never compiled.
                            val bareOwner = variantTagOwner(builder, tagName)
                            if bareOwner != "" {
                                varPatReg = ir_alloc_register(builder.currentFunction, "int")
                                val varPatInstr = ir_init_instr(IROpcode.load_var)
                                varPatInstr.dest = varPatReg
                                varPatInstr.operand1 = ir_symbol(bareOwner + "_TAG_" + tagName)
                                ir_emit(builder.currentFunction, varPatInstr)
                            } else {
                                varPatReg = buildExpr(builder, callPattern.callee)
                            }
                        }
                        val eqReg = ir_alloc_register(builder.currentFunction, "bool")
                        val eqInstr = ir_init_instr(IROpcode.eq)
                        eqInstr.dest = eqReg
                        eqInstr.operand1 = ir_register(tagReg)
                        eqInstr.operand2 = ir_register(varPatReg)
                        ir_emit(builder.currentFunction, eqInstr)

                        val jmp = ir_init_instr(IROpcode.jump_if_false)
                        jmp.operand1 = ir_register(eqReg)
                        jmp.operand2 = ir_label(nextLabel)
                        ir_emit(builder.currentFunction, jmp)

                        if callPattern.args.len() > 1 {
                            // Multi-payload: each identifier argument binds one
                            // packed-struct field (`T_V._0`, `T_V._1`), read off
                            // the data pointer the tag test just kept. The reads
                            // come after the test: before it they ran on every
                            // variant, and a unit variant's data is null.
                            // The struct type comes from the qualified owner
                            // when there is one, else the first union declaring
                            // the variant; the checker already refused a count
                            // mismatch, so every index below is declared.
                            var structName = ""
                            if tagOwner != "" {
                                structName = tagOwner + "_" + tagName
                            } else {
                                structName = variantStructOf(builder, tagName)
                            }
                            var ai = 0
                            while ai < callPattern.args.len() {
                                match callPattern.args.get(ai) {
                                    ASTNode.Literal(argLit) => {
                                        if argLit.valType == "identifier" {
                                            val argC = defineVariable(builder, argLit.text, variantTagPayloadAt(builder, tagName, ai))
                                            val fieldReg = ir_alloc_register(builder.currentFunction, "unknown")
                                            val fieldInstr = ir_init_instr(IROpcode.load_field)
                                            fieldInstr.dest = fieldReg
                                            fieldInstr.operand1 = ir_register(dataReg)
                                            fieldInstr.operand2 = ir_symbol(structName + "._" + ai)
                                            ir_emit(builder.currentFunction, fieldInstr)
                                            val declVar = ir_init_instr(IROpcode.decl_var)
                                            declVar.operand1 = ir_symbol(argC)
                                            declVar.operand2 = ir_register(fieldReg)
                                            ir_emit(builder.currentFunction, declVar)
                                        }
                                    }
                                    _ => {}
                                }
                                ai = ai + 1
                            }
                        }
                    }
                    _ => {
                        val patReg = buildExpr(builder, c.pattern)
                        val eqReg = ir_alloc_register(builder.currentFunction, "bool")
                        val eqInstr = ir_init_instr(IROpcode.eq)
                        eqInstr.dest = eqReg
                        eqInstr.operand1 = ir_register(matchReg)
                        eqInstr.operand2 = ir_register(patReg)
                        ir_emit(builder.currentFunction, eqInstr)
                        val jmp = ir_init_instr(IROpcode.jump_if_false)
                        jmp.operand1 = ir_register(eqReg)
                        jmp.operand2 = ir_label(nextLabel)
                        ir_emit(builder.currentFunction, jmp)
                    }
                }
                if asExpr {
                    val bodyReg = buildExpr(builder, c.body)
                    inheritRegisterType(builder, resultReg, bodyReg)
                    val copyInstr = ir_init_instr(IROpcode.copy)
                    copyInstr.dest = resultReg
                    copyInstr.operand1 = ir_register(bodyReg)
                    ir_emit(builder.currentFunction, copyInstr)
                } else {
                    buildNode(builder, c.body)
                }
                val jmpEnd = ir_init_instr(IROpcode.jump)
                jmpEnd.operand1 = ir_label(endLabel)
                ir_emit(builder.currentFunction, jmpEnd)
            }
            _ => {}
        }
        i = i + 1
    }
    // Place end label after all cases
    val lblEnd = ir_init_instr(IROpcode.label)
    lblEnd.operand1 = ir_label(endLabel)
    ir_emit(builder.currentFunction, lblEnd)
    if asExpr { return resultReg }
    return 0
}

fn buildMatchStatement(builder: IRBuilder, m: MatchNode) {
    buildMatchBody(builder, m, false)
}

fn buildMatchExpr(builder: IRBuilder, m: MatchNode) -> int {
    return buildMatchBody(builder, m, true)
}

fn isEnumerationTypeName(builder: IRBuilder, name: string) -> bool {
    var ei = 0
    while ei < builder.module.types.len() {
        val et: IRTypeDecl = builder.module.types.get(ei)
        if et.name == name && et.kind == "enumeration" { return true }
        ei = ei + 1
    }
    return false
}

fn isUnionTypeName(builder: IRBuilder, name: string) -> bool {
    var ui = 0
    while ui < builder.module.types.len() {
        val ut: IRTypeDecl = builder.module.types.get(ui)
        if ut.name == name {
            if ut.kind == "union_type" {
                return true
            }
        }
        ui = ui + 1
    }
    return false
}

// ── String interpolation ──────────────────────────────────────────────
//
// "${...}" is a string with holes in it, and the whole feature is a chain of
// string concatenations, because that is what the backend already emits for
// `+` when one side is a string: stringifyConcatOperand converts the other
// side with the runtime helper that matches its register type. So an
// interpolated value is not converted here, only fed to `add` alongside a
// string, which keeps interpolation and concatenation from drifting apart.
//
// One thing does need care: an interpolation that is a single expression and
// no literal text, "${n}", would concatenate nothing and hand back whatever
// type the expression had. Starting such a case from an empty string forces it
// through the same string path, so the result is a string either way, and costs
// one extra concat only in that case.

// A literal chunk is not a value the program can name, so its text is resolved
// here. isRaw decides whether that text is taken verbatim or unescaped first,
// which is the only thing triple-quoting changes.
fn interpChunkValue(node: ASTNode, isRaw: bool) -> string {
    var text = ""
    match node {
        ASTNode.Literal(l) => { text = l.text }
        _ => { return "" }
    }
    if isRaw { return text }
    return unescapeStringBody(text)
}

fn isStringChunkNode(node: ASTNode) -> bool {
    match node {
        ASTNode.Literal(l) => {
            if l.valType == "string_chunk" { return true }
            return false
        }
        _ => { return false }
    }
}

// A chunk becomes a string constant, which is a string register the backend
// will concatenate without converting. An expression is built as-is and left
// for `add` to stringify.
fn buildInterpPart(builder: IRBuilder, node: ASTNode, isRaw: bool) -> int {
    if !isStringChunkNode(node) { return buildExpr(builder, node) }
    val chunkReg = ir_alloc_register(builder.currentFunction, "string")
    val chunkInstr = ir_init_instr(IROpcode.load_const)
    chunkInstr.dest = chunkReg
    chunkInstr.operand1 = ir_string(interpChunkValue(node, isRaw))
    ir_emit(builder.currentFunction, chunkInstr)
    return chunkReg
}

fn buildInterpString(builder: IRBuilder, parts: list < ASTNode >, isRaw: bool) -> int {
    var acc = -1
    var pi = 0
    while pi < parts.len() {
        val partReg = buildInterpPart(builder, parts.get(pi), isRaw)
        if acc == -1 {
            if isStringChunkNode(parts.get(pi)) {
                acc = partReg
            } else {
                // A leading expression with no literal text in front of it:
                // start from "" so the result is a string, not whatever type
                // the expression happened to be.
                acc = buildInterpPart(builder, ASTNode.Literal(LiteralNode("string_chunk", "")), isRaw)
                val firstCat = ir_init_instr(IROpcode.add)
                val firstReg = ir_alloc_register(builder.currentFunction, "string")
                firstCat.dest = firstReg
                firstCat.operand1 = ir_register(acc)
                firstCat.operand2 = ir_register(partReg)
                ir_emit(builder.currentFunction, firstCat)
                acc = firstReg
            }
        } else {
            val catReg = ir_alloc_register(builder.currentFunction, "string")
            val catInstr = ir_init_instr(IROpcode.add)
            catInstr.dest = catReg
            catInstr.operand1 = ir_register(acc)
            catInstr.operand2 = ir_register(partReg)
            ir_emit(builder.currentFunction, catInstr)
            acc = catReg
        }
        pi = pi + 1
    }
    return acc
}

// One emitter for the native-dispatch call shape the `req.*`, `model.*` and
// `system.*` tables produce: fixed prefix arguments, then one per user
// argument, one result register typed as the native's return type, and the
// call. These three tables used to each transcribe that around their lookup.
// Model.where(cond, p1..pn) / Model.count(cond, p1..pn): the param count
// travels explicitly so the C side validates placeholders before touching
// varargs (a bare ... call cannot detect a short argument list).
fn emitModelCountedCall(builder: IRBuilder, nativeName: string, modelName: string, args: list < ASTNode >) -> int {
    val tableArg = ir_init_instr(IROpcode.arg)
    tableArg.operand1 = ir_string(modelTableName(modelName))
    ir_emit(builder.currentFunction, tableArg)
    val condArg = ir_init_instr(IROpcode.arg)
    condArg.operand1 = buildCallArgValue(builder, args.get(0))
    ir_emit(builder.currentFunction, condArg)
    val nArg = ir_init_instr(IROpcode.arg)
    nArg.operand1 = ir_int(args.len() - 1)
    ir_emit(builder.currentFunction, nArg)
    var pi = 1
    while pi < args.len() {
        val pa = ir_init_instr(IROpcode.arg)
        pa.operand1 = buildCallArgValue(builder, args.get(pi))
        ir_emit(builder.currentFunction, pa)
        pi = pi + 1
    }
    val resReg = ir_alloc_register(builder.currentFunction, lookupFunctionReturnType(builder, nativeName))
    val call = ir_init_instr(IROpcode.call)
    call.dest = resReg
    call.operand1 = ir_string(nativeName)
    call.operand2 = ir_int(args.len() + 2)
    ir_emit(builder.currentFunction, call)
    return resReg
}

fn emitModelWhereV(builder: IRBuilder, modelName: string, args: list < ASTNode >) -> int {
    return emitModelCountedCall(builder, "orbit_db_query_where_v", modelName, args)
}

fn emitModelCountV(builder: IRBuilder, modelName: string, args: list < ASTNode >) -> int {
    return emitModelCountedCall(builder, "orbit_db_count_v", modelName, args)
}

fn emitNativeCall(builder: IRBuilder, nativeName: string, fixedArgs: list < IRValue >, userArgs: list < ASTNode >) -> int {
    var fai = 0
    while fai < fixedArgs.len() {
        val fa = ir_init_instr(IROpcode.arg)
        fa.operand1 = fixedArgs.get(fai)
        ir_emit(builder.currentFunction, fa)
        fai = fai + 1
    }
    var ai = 0
    while ai < userArgs.len() {
        val a = ir_init_instr(IROpcode.arg)
        a.operand1 = buildCallArgValue(builder, userArgs.get(ai))
        ir_emit(builder.currentFunction, a)
        ai = ai + 1
    }
    val res = ir_alloc_register(builder.currentFunction, lookupFunctionReturnType(builder, nativeName))
    val call = ir_init_instr(IROpcode.call)
    call.dest = res
    call.operand1 = ir_string(nativeName)
    call.operand2 = ir_int(userArgs.len() + fixedArgs.len())
    ir_emit(builder.currentFunction, call)
    return res
}

// A call through a local holding a function value: the arguments ride .arg
// instructions like any call, but the callee is the loaded value, not a
// name, and the destination is typed by the signature. The value was checked
// against the signature in sema, so this is only the shape of the call.
fn buildFnVarCall(builder: IRBuilder, c: CallNode, sig: string) -> int {
    var ai = 0
    while ai < c.args.len() {
        val argInstr = ir_init_instr(IROpcode.arg)
        argInstr.operand1 = buildCallArgValue(builder, c.args.get(ai))
        ir_emit(builder.currentFunction, argInstr)
        ai = ai + 1
    }
    val calleeReg = buildExpr(builder, c.callee)
    val resReg = ir_alloc_register(builder.currentFunction, builderFnTypeReturn(sig))
    val callInstr = ir_init_instr(IROpcode.call)
    callInstr.dest = resReg
    callInstr.operand1 = ir_register(calleeReg)
    callInstr.operand2 = ir_int(c.args.len())
    ir_emit(builder.currentFunction, callInstr)
    return resReg
}

// One orbit_string_concat call over two IR values, for builder-side
// string assembly (staged response headers). Both sides are strings,
// so the void* transport the call emission uses is exact.
fn emitConcatCall(builder: IRBuilder, left: IRValue, right: IRValue) -> int {
    val arg1 = ir_init_instr(IROpcode.arg)
    arg1.operand1 = left
    ir_emit(builder.currentFunction, arg1)
    val arg2 = ir_init_instr(IROpcode.arg)
    arg2.operand1 = right
    ir_emit(builder.currentFunction, arg2)
    val resReg = ir_alloc_register(builder.currentFunction, "string")
    val callInstr = ir_init_instr(IROpcode.call)
    callInstr.dest = resReg
    callInstr.operand1 = ir_string("orbit_string_concat")
    callInstr.operand2 = ir_int(2)
    ir_emit(builder.currentFunction, callInstr)
    return resReg
}

// res.header(name, value) / res.cookie(name, value) in a route body.
// There is no response object yet to attach to -- `return ok` builds it
// later -- so the line stages into a hidden string local the backend
// flushes onto the constructed response (one decl: the hoister dedups
// by name, and routes without headers never mention it, so their
// emission is byte-identical). A user variable named res wins over the
// receiver; the caller guards that with scopeHasName.
fn buildResHeaderCall(builder: IRBuilder, c: CallNode, memberName: string) -> int {
    // Each argument builds exactly once: the header line takes the nodes
    // (emitNativeCall builds them), the cookie chain takes built values.
    var lineReg = 0
    if memberName == "cookie" {
        // Set-Cookie: name=value; Path=/ -- the value rides concat
        // assembly, then one header_line call so names and values face
        // the same colon/CRLF validation as res.header.
        val nameVal = buildCallArgValue(builder, c.args.get(0))
        val valueVal = buildCallArgValue(builder, c.args.get(1))
        val t1 = emitConcatCall(builder, nameVal, ir_string("="))
        val t2 = emitConcatCall(builder, ir_register(t1), valueVal)
        val cookieVal = emitConcatCall(builder, ir_register(t2), ir_string("; Path=/"))
        val scName = ir_string("Set-Cookie")
        val argName = ir_init_instr(IROpcode.arg)
        argName.operand1 = scName
        ir_emit(builder.currentFunction, argName)
        val argVal = ir_init_instr(IROpcode.arg)
        argVal.operand1 = ir_register(cookieVal)
        ir_emit(builder.currentFunction, argVal)
        val hlReg = ir_alloc_register(builder.currentFunction, "string")
        val hlCall = ir_init_instr(IROpcode.call)
        hlCall.dest = hlReg
        hlCall.operand1 = ir_string("orbit_response_header_line")
        hlCall.operand2 = ir_int(2)
        ir_emit(builder.currentFunction, hlCall)
        lineReg = hlReg
    } else {
        lineReg = emitNativeCall(builder, "orbit_response_header_line", [], [c.args.get(0), c.args.get(1)])
    }
    // No decl_var: the backend hoister declares the hidden name with an
    // empty initializer on sight (load/store register it), so every path
    // starts staged-empty and later headers only append. A decl per call
    // would reset the accumulator; one decl cannot dominate every path.
    val loadReg = ir_alloc_register(builder.currentFunction, "string")
    val loadInstr = ir_init_instr(IROpcode.load_var)
    loadInstr.dest = loadReg
    loadInstr.operand1 = ir_symbol("_orbit_res_headers")
    ir_emit(builder.currentFunction, loadInstr)
    val catReg = emitConcatCall(builder, ir_register(loadReg), ir_register(lineReg))
    val storeInstr = ir_init_instr(IROpcode.store_var)
    storeInstr.operand1 = ir_symbol("_orbit_res_headers")
    storeInstr.operand2 = ir_register(catReg)
    ir_emit(builder.currentFunction, storeInstr)
    val resReg = ir_alloc_register(builder.currentFunction, "void")
    return resReg
}

// The register type of a call by name. The function table and the builtin
// table answer first. What neither knows is the builtin `print`, which the
// checker types void, and the construction of a model, which is a value of
// that model (the checker's rule for a callee that names a model). A generic
// model's own name is not a type, so its construction keeps "unknown".
fn callResultType(builder: IRBuilder, callName: string) -> string {
    val declared = lookupFunctionReturnType(builder, callName)
    if declared != "unknown" { return declared }
    if findFunction(builder.module, callName) >= 0 { return "unknown" }
    if callName == "print" { return "void" }
    if modelDeclared(builder, callName) && genericModelByName(builder, callName) == NULL { return callName }
    return "unknown"
}

fn buildCall(builder: IRBuilder, c: CallNode) -> int {
    // Check if it's a method call (member access)
    match c.callee {
        ASTNode.MemberAccess(ma) => {
            // Union variant construction: Type.Variant(payload) is NOT a method
            // call. The type name must not be evaluated nor passed as receiver.
            var isVariantCtor = false
            match ma.object {
                ASTNode.Literal(ol) => {
                    if ol.valType == "identifier" {
                        if isUnionTypeName(builder, ol.text) {
                            isVariantCtor = true
                        }
                    }
                }
                _ => {}
            }
            if isVariantCtor {
                var vi = 0
                while vi < c.args.len() {
                    val vArgReg = buildExpr(builder, c.args.get(vi))
                    val vArgInstr = ir_init_instr(IROpcode.arg)
                    vArgInstr.operand1 = ir_register(vArgReg)
                    ir_emit(builder.currentFunction, vArgInstr)
                    vi = vi + 1
                }
                val vRes = ir_alloc_register(builder.currentFunction, "void*")
                val vCall = ir_init_instr(IROpcode.call)
                vCall.dest = vRes
                vCall.operand1 = ir_string(ma.field)
                vCall.operand2 = ir_int(c.args.len())
                ir_emit(builder.currentFunction, vCall)
                return vRes
            }
            val memberName = ma.field
            var reqBuiltin = ""
            var reqOperand = ir_symbol("req")
            match ma.object {
                ASTNode.Literal(ol) => {
                    if ol.valType == "identifier" && ol.text == "req" {
                        if memberName == "file" {
                            reqBuiltin = "orbit_file_upload_save"
                        } else if memberName == "param" {
                            reqBuiltin = "orbit_http_param_get"
                        } else if memberName == "body" || memberName == "json" {
                            reqBuiltin = "orbit_http_body_get"
                        } else if memberName == "query" {
                            reqBuiltin = "orbit_http_query_get"
                        } else if memberName == "queryAll" {
                            reqBuiltin = "orbit_http_query_get_all"
                        } else if memberName == "bearer_token" {
                            reqBuiltin = "orbit_auth_bearer_token"
                            reqOperand = ir_symbol("req->headers")
                        } else if memberName == "has_role" {
                            reqBuiltin = "orbit_auth_has_role"
                            reqOperand = ir_symbol("req->headers")
                        } else if memberName == "role" {
                            reqBuiltin = "orbit_auth_current_role"
                            reqOperand = ir_symbol("req->headers")
                        } else if memberName == "header" {
                            reqBuiltin = "orbit_http_header_get"
                        }
                    }
                    // Staged response headers: res.header / res.cookie keep
                    // their lines in a hidden local the backend flushes onto
                    // the constructed response. A user variable named res
                    // wins (scopeHasName): hijacking it would reroute a
                    // program's own method call into header staging.
                    if ol.valType == "identifier" && ol.text == "res" {
                        if memberName == "header" || memberName == "cookie" {
                            if scopeHasName(builder, ol.text) == false {
                                if c.args.len() == 2 {
                                    return buildResHeaderCall(builder, c, memberName)
                                }
                            }
                        }
                    }
                }
                _ => {}
            }
            if reqBuiltin != "" {
                val reqFixed = []
                reqFixed.push(reqOperand)
                return emitNativeCall(builder, reqBuiltin, reqFixed, c.args)
            }
            var modelName = ""
            match ma.object {
                ASTNode.Literal(ol) => {
                    if ol.valType == "identifier" && ol.text.len() > 0 {
                        val firstChar = ol.text.at(0)
                        if firstChar >= 65 && firstChar <= 90 {
                            modelName = ol.text
                        }
                    }
                }
                _ => {}
            }
            var modelBuiltin = ""
            if modelName != "" {
                if memberName == "all" {
                    modelBuiltin = "orbit_db_query_all"
                } else if memberName == "where" {
                    if c.args.len() == 2 {
                        modelBuiltin = "orbit_db_query_where_p"
                    } else if c.args.len() > 2 {
                        // N params ride a varargs call: (table, cond, n, p...).
                        // emitNativeCall cannot insert the computed n between
                        // cond and the params, so this one is emitted by hand.
                        return emitModelWhereV(builder, modelName, c.args)
                    } else {
                        modelBuiltin = "orbit_db_query_where"
                    }
                } else if memberName == "find" {
                    modelBuiltin = "orbit_db_query_get"
                } else if memberName == "first" {
                    modelBuiltin = "orbit_db_query_first"
                } else if memberName == "order" {
                    modelBuiltin = "orbit_db_query_order"
                } else if memberName == "order_desc" {
                    modelBuiltin = "orbit_db_query_order_desc"
                } else if memberName == "count" {
                    if c.args.len() == 0 {
                        modelBuiltin = "orbit_db_count_all"
                    } else {
                        return emitModelCountV(builder, modelName, c.args)
                    }
                } else if memberName == "create" {
                    modelBuiltin = "orbit_db_insert"
                } else if memberName == "update" {
                    modelBuiltin = "orbit_db_update"
                } else if memberName == "delete" {
                    modelBuiltin = "orbit_db_delete"
                }
            }
            if modelBuiltin != "" {
                val modelFixed = []
                modelFixed.push(ir_string(modelTableName(modelName)))
                return emitNativeCall(builder, modelBuiltin, modelFixed, c.args)
            }
            var systemBuiltin = ""
            match ma.object {
                ASTNode.Literal(ol) => {
                    if ol.valType == "identifier" && ol.text == "system" {
                        if memberName == "uptime" {
                            systemBuiltin = "system_uptime"
                        } else if memberName == "pid" {
                            systemBuiltin = "system_pid"
                        } else if memberName == "active_workers" {
                            systemBuiltin = "system_active_workers"
                        } else if memberName == "http_requests_total" {
                            systemBuiltin = "system_http_requests_total"
                        } else if memberName == "latency_avg_us" {
                            systemBuiltin = "system_latency_avg_us"
                        } else if memberName == "latency_p50_us" {
                            systemBuiltin = "system_latency_p50_us"
                        } else if memberName == "latency_p95_us" {
                            systemBuiltin = "system_latency_p95_us"
                        } else if memberName == "latency_p99_us" {
                            systemBuiltin = "system_latency_p99_us"
                        }
                    }
                }
                _ => {}
            }
            if systemBuiltin != "" {
                val sysFixed = []
                return emitNativeCall(builder, systemBuiltin, sysFixed, c.args)
            }
            val objReg = buildExpr(builder, ma.object)
            // Collection methods
            if memberName == "push" && c.args.len() >= 1 {
                val valReg = buildExpr(builder, c.args.get(0))
                val pushInstr = ir_init_instr(IROpcode.list_push)
                pushInstr.operand1 = ir_register(objReg)
                pushInstr.operand2 = ir_register(valReg)
                val resReg = ir_alloc_register(builder.currentFunction, "void")
                pushInstr.dest = resReg
                pushInstr.elemKind = listWriteKind(builder, ma.object, c.args.get(0))
                ir_emit(builder.currentFunction, pushInstr)
                return resReg
            }
            if memberName == "get" && c.args.len() >= 1 {
                // `.get("k")` on a dynamic object is a keyed field read, not an
                // index. It fell through to the list read below, so
                // `orbit_object_set_int(o, "a", 1)` was read back with
                // orbit_list_read_word and the program died dereferencing a
                // struct as a list. A load_field on an object is what the
                // emitter already types by the setter that wrote the key.
                if resolveExprType(builder, ma.object) == "object" {
                    val objFieldReg = ir_alloc_register(builder.currentFunction, "object")
                    val objFieldInstr = ir_init_instr(IROpcode.load_field)
                    objFieldInstr.dest = objFieldReg
                    objFieldInstr.operand1 = ir_register(objReg)
                    // A literal key is the field NAME, not a value to evaluate:
                    // the emitter resolves the getter by matching it against
                    // the setter that wrote that key, and a register operand has
                    // no name to match.
                    val keyArg = c.args.get(0)
                    var keyIsLiteral = false
                    var keyText = ""
                    match keyArg {
                        ASTNode.Literal(kl) => {
                            if kl.valType == "string" || kl.valType == "string_raw" {
                                keyIsLiteral = true
                                keyText = literalStringValue(kl)
                            }
                        }
                        _ => {}
                    }
                    if keyIsLiteral {
                        objFieldInstr.operand2 = ir_string(keyText)
                    } else {
                        objFieldInstr.operand2 = ir_register(buildExpr(builder, keyArg))
                    }
                    ir_emit(builder.currentFunction, objFieldInstr)
                    return objFieldReg
                }
                val idxReg = buildExpr(builder, c.args.get(0))
                val getInstr = ir_init_instr(IROpcode.list_get)
                getInstr.operand1 = ir_register(objReg)
                getInstr.operand2 = ir_register(idxReg)
                getInstr.elemKind = elemKindCode(listReadElemKindName(builder, ma.object))
                val resReg = ir_alloc_register(builder.currentFunction, listReadRegisterType(builder, ma.object, getInstr.elemKind))
                getInstr.dest = resReg
                ir_emit(builder.currentFunction, getInstr)
                return resReg
            }
            if memberName == "set" && c.args.len() >= 2 {
                val idxReg = buildExpr(builder, c.args.get(0))
                val valReg = buildExpr(builder, c.args.get(1))
                val setInstr = ir_init_instr(IROpcode.list_set)
                setInstr.operand1 = ir_register(objReg)
                setInstr.operand2 = ir_register(idxReg)
                setInstr.operand3 = ir_register(valReg)
                val resReg = ir_alloc_register(builder.currentFunction, "void")
                setInstr.dest = resReg
                setInstr.elemKind = listWriteKind(builder, ma.object, c.args.get(1))
                ir_emit(builder.currentFunction, setInstr)
                return resReg
            }
            if memberName == "len" {
                var isStringLen = false
                match ma.object {
                    ASTNode.Literal(ol) => {
                        if ol.valType == "string" {
                            isStringLen = true
                        }
                        if ol.valType == "identifier" {
                            var pi = 0
                            while pi < builder.currentFunction.params.len() {
                                if builder.currentFunction.params.get(pi) == ol.text {
                                    if pi < builder.currentFunction.paramTypes.len() {
                                        if builder.currentFunction.paramTypes.get(pi) == "string" {
                                            isStringLen = true
                                        }
                                    }
                                }
                                pi = pi + 1
                            }
                        }
                    }
                    ASTNode.MemberAccess(om) => {
                        if modelFieldIsString(builder, om.field) {
                            isStringLen = true
                        }
                    }
                    _ => {}
                }
                if isStringLen {
                    val argInstr = ir_init_instr(IROpcode.arg)
                    argInstr.operand1 = ir_register(objReg)
                    ir_emit(builder.currentFunction, argInstr)
                    val lenCall = ir_init_instr(IROpcode.call)
                    val resReg = ir_alloc_register(builder.currentFunction, "int")
                    lenCall.dest = resReg
                    lenCall.operand1 = ir_string("orbit_string_len")
                    lenCall.operand2 = ir_int(1)
                    ir_emit(builder.currentFunction, lenCall)
                    return resReg
                }
                val lenInstr = ir_init_instr(IROpcode.list_len)
                lenInstr.operand1 = ir_register(objReg)
                val resReg = ir_alloc_register(builder.currentFunction, "int")
                lenInstr.dest = resReg
                ir_emit(builder.currentFunction, lenInstr)
                return resReg
            }
            if memberName == "pop" {
                val popInstr = ir_init_instr(IROpcode.list_pop)
                popInstr.operand1 = ir_register(objReg)
                popInstr.elemKind = elemKindCode(listKindNameOf(builder, ma.object))
                val resReg = ir_alloc_register(builder.currentFunction, listReadRegisterType(builder, ma.object, popInstr.elemKind))
                popInstr.dest = resReg
                ir_emit(builder.currentFunction, popInstr)
                return resReg
            }
            // clear() is a void collection method. It used to fall through to
            // the default call path, which spelled it `clear(...)`: the front
            // end said nothing and the C step died on an undefined reference
            // to a function nobody declared. F-0004's shape, on a name the
            // runtime already defines.
            if memberName == "clear" {
                val arg1 = ir_init_instr(IROpcode.arg)
                arg1.operand1 = ir_register(objReg)
                ir_emit(builder.currentFunction, arg1)
                val callInstr = ir_init_instr(IROpcode.call)
                val resReg = ir_alloc_register(builder.currentFunction, "void")
                callInstr.dest = resReg
                callInstr.operand1 = ir_string("orbit_list_clear")
                callInstr.operand2 = ir_int(1)
                ir_emit(builder.currentFunction, callInstr)
                return resReg
            }
            if memberName == "has" && c.args.len() >= 1 {
                val keyReg = buildExpr(builder, c.args.get(0))
                val hasInstr = ir_init_instr(IROpcode.map_has)
                hasInstr.operand1 = ir_register(objReg)
                hasInstr.operand2 = ir_register(keyReg)
                val resReg = ir_alloc_register(builder.currentFunction, "bool")
                hasInstr.dest = resReg
                ir_emit(builder.currentFunction, hasInstr)
                return resReg
            }
            if memberName == "delete" && c.args.len() >= 1 {
                val keyReg = buildExpr(builder, c.args.get(0))
                val delInstr = ir_init_instr(IROpcode.map_delete)
                delInstr.operand1 = ir_register(objReg)
                delInstr.operand2 = ir_register(keyReg)
                val resReg = ir_alloc_register(builder.currentFunction, "void")
                delInstr.dest = resReg
                ir_emit(builder.currentFunction, delInstr)
                return resReg
            }
            if memberName == "keys" {
                val keysInstr = ir_init_instr(IROpcode.map_keys)
                keysInstr.operand1 = ir_register(objReg)
                val resReg = ir_alloc_register(builder.currentFunction, "list")
                keysInstr.dest = resReg
                ir_emit(builder.currentFunction, keysInstr)
                return resReg
            }
            // String methods become calls to runtime functions
            if memberName == "contains" && c.args.len() >= 1 {
                val subReg = buildExpr(builder, c.args.get(0))
                val arg1 = ir_init_instr(IROpcode.arg)
                arg1.operand1 = ir_register(objReg)
                ir_emit(builder.currentFunction, arg1)
                val arg2 = ir_init_instr(IROpcode.arg)
                arg2.operand1 = ir_register(subReg)
                ir_emit(builder.currentFunction, arg2)
                val callInstr = ir_init_instr(IROpcode.call)
                val resReg = ir_alloc_register(builder.currentFunction, "bool")
                callInstr.dest = resReg
                callInstr.operand1 = ir_string("orbit_string_contains")
                // Arity is not optional metadata. The backend reads it to know
                // how many of the pending arguments belong to this call, and
                // left at zero it swept up every argument still in flight --
                // which is how `ok 200 system.uptime()` emitted
                // `system_uptime((void*)(uintptr_t)(200))`.
                callInstr.operand2 = ir_int(2)
                ir_emit(builder.currentFunction, callInstr)
                return resReg
            }
            if memberName == "at" && c.args.len() >= 1 {
                // `.at()` is a character read on a string and an element read
                // on a list, and which one it is depends entirely on the
                // receiver. It used to be a string read unconditionally, so
                // `n.at(1)` over `[10,20,30]` called orbit_string_at on an
                // OrbitList and answered whatever byte of the header it landed
                // on: 48, 0, 0, stable, and none of them 20. The receiver
                // decides, and the receiver is the one thing that knows.
                if isListExpression(builder, ma.object) {
                    val idxReg = buildExpr(builder, c.args.get(0))
                    val getInstr = ir_init_instr(IROpcode.list_get)
                    getInstr.operand1 = ir_register(objReg)
                    getInstr.operand2 = ir_register(idxReg)
                    getInstr.elemKind = elemKindCode(listReadElemKindName(builder, ma.object))
                    val resReg = ir_alloc_register(builder.currentFunction, listReadRegisterType(builder, ma.object, getInstr.elemKind))
                    getInstr.dest = resReg
                    ir_emit(builder.currentFunction, getInstr)
                    return resReg
                }
                val idxReg = buildExpr(builder, c.args.get(0))
                val arg1 = ir_init_instr(IROpcode.arg)
                arg1.operand1 = ir_register(objReg)
                ir_emit(builder.currentFunction, arg1)
                val arg2 = ir_init_instr(IROpcode.arg)
                arg2.operand1 = ir_register(idxReg)
                ir_emit(builder.currentFunction, arg2)
                val callInstr = ir_init_instr(IROpcode.call)
                val resReg = ir_alloc_register(builder.currentFunction, "int")
                callInstr.dest = resReg
                callInstr.operand1 = ir_string("orbit_string_at")
                callInstr.operand2 = ir_int(2)
                ir_emit(builder.currentFunction, callInstr)
                return resReg
            }
            if memberName == "indexOf" && c.args.len() >= 1 {
                val subReg = buildExpr(builder, c.args.get(0))
                val arg1 = ir_init_instr(IROpcode.arg)
                arg1.operand1 = ir_register(objReg)
                ir_emit(builder.currentFunction, arg1)
                val arg2 = ir_init_instr(IROpcode.arg)
                arg2.operand1 = ir_register(subReg)
                ir_emit(builder.currentFunction, arg2)
                val callInstr = ir_init_instr(IROpcode.call)
                val resReg = ir_alloc_register(builder.currentFunction, "int")
                callInstr.dest = resReg
                callInstr.operand1 = ir_string("orbit_string_find")
                callInstr.operand2 = ir_int(2)
                ir_emit(builder.currentFunction, callInstr)
                return resReg
            }
            if memberName == "slice" && c.args.len() >= 2 {
                val startReg = buildExpr(builder, c.args.get(0))
                val endReg = buildExpr(builder, c.args.get(1))
                val arg1 = ir_init_instr(IROpcode.arg)
                arg1.operand1 = ir_register(objReg)
                ir_emit(builder.currentFunction, arg1)
                val arg2 = ir_init_instr(IROpcode.arg)
                arg2.operand1 = ir_register(startReg)
                ir_emit(builder.currentFunction, arg2)
                val arg3 = ir_init_instr(IROpcode.arg)
                arg3.operand1 = ir_register(endReg)
                ir_emit(builder.currentFunction, arg3)
                val callInstr = ir_init_instr(IROpcode.call)
                val resReg = ir_alloc_register(builder.currentFunction, "string")
                callInstr.dest = resReg
                callInstr.operand1 = ir_string("orbit_string_slice")
                callInstr.operand2 = ir_int(3)
                ir_emit(builder.currentFunction, callInstr)
                return resReg
            }
            if memberName == "to_int" && c.args.len() == 0 {
                val arg1 = ir_init_instr(IROpcode.arg)
                arg1.operand1 = ir_register(objReg)
                ir_emit(builder.currentFunction, arg1)
                val callInstr = ir_init_instr(IROpcode.call)
                val resReg = ir_alloc_register(builder.currentFunction, "int")
                callInstr.dest = resReg
                callInstr.operand1 = ir_string("orbit_string_to_int")
                callInstr.operand2 = ir_int(1)
                ir_emit(builder.currentFunction, callInstr)
                return resReg
            }
            // Default method call: emit obj as first arg, then call memberName as function
            val argVals: list < IRValue > = []
            var ai0 = 0
            while ai0 < c.args.len() {
                argVals.push(buildCallArgValue(builder, c.args.get(ai0)))
                ai0 = ai0 + 1
            }
            val arg1 = ir_init_instr(IROpcode.arg)
            arg1.operand1 = ir_register(objReg)
            ir_emit(builder.currentFunction, arg1)
            var ei0 = 0
            while ei0 < argVals.len() {
                val argInstr = ir_init_instr(IROpcode.arg)
                argInstr.operand1 = argVals.get(ei0)
                ir_emit(builder.currentFunction, argInstr)
                ei0 = ei0 + 1
            }
            val resReg = ir_alloc_register(builder.currentFunction, "unknown")
            val callInstr = ir_init_instr(IROpcode.call)
            callInstr.dest = resReg
            callInstr.operand1 = ir_string(memberName)
            callInstr.operand2 = ir_int(c.args.len() + 1)
            ir_emit(builder.currentFunction, callInstr)
            return resReg
        }
        _ => {
            val litText = ""
            match c.callee {
                ASTNode.Literal(lit) => {
                    // Direct function call by name
                    if lit.text == "ok" && c.args.len() == 1 {
                        val valReg = buildExpr(builder, c.args.get(0))
                        val instr = ir_init_instr(IROpcode.result_ok)
                        instr.operand1 = ir_register(valReg)
                        val resReg = ir_alloc_register(builder.currentFunction, "result")
                        instr.dest = resReg
                        ir_emit(builder.currentFunction, instr)
                        return resReg
                    }
                    if lit.text == "err" && c.args.len() >= 1 {
                        val msgReg = buildExpr(builder, c.args.get(0))
                        // 500, not ir_int(500). The default has to be a bare
                        // register index, because that is what codeReg holds
                        // once a second argument overwrites it, and what
                        // ir_register() takes. The IRValue it used to be meant
                        // `err "msg"` passed a register holding a pointer to a
                        // boxed integer where the error code belonged.
                        var codeReg = 500
                        if c.args.len() >= 2 {
                            codeReg = buildExpr(builder, c.args.get(1))
                        }
                        val instr = ir_init_instr(IROpcode.result_err)
                        instr.operand1 = ir_register(msgReg)
                        instr.operand2 = ir_register(codeReg)
                        val resReg = ir_alloc_register(builder.currentFunction, "result")
                        instr.dest = resReg
                        ir_emit(builder.currentFunction, instr)
                        return resReg
                    }
                    // Regular function call. Evaluate every argument first so a
                    // nested call (arg[i] is itself a call) cannot steal the
                    // pending .arg instructions of this call. Literals are
                    // passed as constant operands so
                    // the C backend inlines them; buildExpr would materialize
                    // them into load_const registers.
                    // A generic callee monomorphises per call site: infer the
                    // bindings from the argument types, ensure the instance,
                    // and call it by its instance name, answering its
                    // substituted return type.
                    var callName = lit.text
                    match genericFnByName(builder, lit.text) {
                        ASTNode.FunctionDecl(gfd) => {
                            callName = ensureFnInstance(builder, lit.text, inferFnBindings(builder, gfd, c))
                        }
                        _ => {}
                    }
                    // A call through a variable holding a function value is
                    // indirect: the name is a local, not a C function, so the
                    // direct emission below would call a symbol nothing
                    // declares. A declared function wins, the way sema
                    // resolves the callee.
                    if findFunction(builder.module, lit.text) < 0 {
                        val vsig = lookupVariable(builder, lit.text)
                        if builderIsFnType(vsig) {
                            return buildFnVarCall(builder, c, vsig)
                        }
                    }
                    val argVals: list < IRValue > = []
                    var ai = 0
                    while ai < c.args.len() {
                        argVals.push(buildCallArgValue(builder, c.args.get(ai)))
                        ai = ai + 1
                    }
                    var ei = 0
                    while ei < argVals.len() {
                        val argInstr = ir_init_instr(IROpcode.arg)
                        argInstr.operand1 = argVals.get(ei)
                        ir_emit(builder.currentFunction, argInstr)
                        ei = ei + 1
                    }
                    val resReg = ir_alloc_register(builder.currentFunction, callResultType(builder, callName))
                    val callInstr = ir_init_instr(IROpcode.call)
                    callInstr.dest = resReg
                    callInstr.operand1 = ir_string(callName)
                    callInstr.operand2 = ir_int(c.args.len())
                    ir_emit(builder.currentFunction, callInstr)
                    return resReg
                }
                _ => {
                    val argRegs2: list < int > = []
                    var ai2 = 0
                    while ai2 < c.args.len() {
                        argRegs2.push(buildExpr(builder, c.args.get(ai2)))
                        ai2 = ai2 + 1
                    }
                    var ei2 = 0
                    while ei2 < argRegs2.len() {
                        val argInstr = ir_init_instr(IROpcode.arg)
                        argInstr.operand1 = ir_register(argRegs2.get(ei2))
                        ir_emit(builder.currentFunction, argInstr)
                        ei2 = ei2 + 1
                    }
                    val resReg2 = ir_alloc_register(builder.currentFunction, "unknown")
                    val callInstr = ir_init_instr(IROpcode.call)
                    callInstr.dest = resReg2
                    callInstr.operand1 = ir_register(buildExpr(builder, c.callee))
                    callInstr.operand2 = ir_int(c.args.len())
                    ir_emit(builder.currentFunction, callInstr)
                    return resReg2
                }
            }
        }
    }
    return 0
}

// The two helpers below ask "is this value an object?" from the register type
// the builder itself allocated. That is authoritative about what the C side
// will see, unlike the string heuristics in the backend, which guess from the
// shape of the emitted text.
fn isObjectValue(builder: IRBuilder, value: IRValue) -> bool {
    match value {
        IRValue.Register(r) => {
            if r.value < 0 { return false }
            if r.value < builder.currentFunction.registerTypes.len() {
                return builder.currentFunction.registerTypes.get(r.value) == "object"
            }
        }
        _ => {}
    }
    return false
}

fn emitObjectToJson(builder: IRBuilder, value: IRValue) -> int {
    val selfArg = ir_init_instr(IROpcode.arg)
    selfArg.operand1 = value
    ir_emit(builder.currentFunction, selfArg)
    val jsonReg = ir_alloc_register(builder.currentFunction, "string")
    val callInstr = ir_init_instr(IROpcode.call)
    callInstr.dest = jsonReg
    callInstr.operand1 = ir_string("orbit_object_to_json")
    callInstr.operand2 = ir_int(1)
    ir_emit(builder.currentFunction, callInstr)
    return jsonReg
}

// An object literal lowers to a create followed by one set per field, in
// source order, which is what makes the JSON come out in the order it was
// written. The value is built before the key so a field whose value is itself
// a call cannot swallow the key argument.
fn buildObjectLiteral(builder: IRBuilder, node: ASTNode) -> int {
    val objectReg = ir_alloc_register(builder.currentFunction, "object")
    val createInstr = ir_init_instr(IROpcode.call)
    createInstr.dest = objectReg
    createInstr.operand1 = ir_string("orbit_object_create")
    createInstr.operand2 = ir_int(0)
    ir_emit(builder.currentFunction, createInstr)
    match node {
        ASTNode.ObjectLiteral(ol) => {
            var i = 0
            while i < ol.fields.len() {
                val field: ASTNode = ol.fields.get(i)
                match field {
                    ASTNode.FieldInit(fi) => {
                        val valueReg = buildExpr(builder, fi.value)
                        val setter = objectFieldSetter(builder, valueReg)
                        val argSelf = ir_init_instr(IROpcode.arg)
                        argSelf.operand1 = ir_register(objectReg)
                        ir_emit(builder.currentFunction, argSelf)
                        val argKey = ir_init_instr(IROpcode.arg)
                        argKey.operand1 = ir_string(fi.name)
                        ir_emit(builder.currentFunction, argKey)
                        val argValue = ir_init_instr(IROpcode.arg)
                        argValue.operand1 = ir_register(valueReg)
                        ir_emit(builder.currentFunction, argValue)
                        val setInstr = ir_init_instr(IROpcode.call)
                        setInstr.operand1 = ir_string(setter)
                        setInstr.operand2 = ir_int(3)
                        ir_emit(builder.currentFunction, setInstr)
                    }
                    _ => {}
                }
                i = i + 1
            }
        }
        _ => {}
    }
    return objectReg
}

// One setter per value type, named for it, so the runtime never has to guess
// and the C call is typed. A register whose type is not known falls back to
// the string setter, which is what the rest of the compiler does for an
// unidentifiable value. Lists are JSON arrays through orbit_object_set_list.
fn objectFieldSetter(builder: IRBuilder, valueReg: int) -> string {
    if valueReg < 0 || valueReg >= builder.currentFunction.registerTypes.len() {
        return "orbit_object_set_string"
    }
    val t = builder.currentFunction.registerTypes.get(valueReg)
    if t == "int" { return "orbit_object_set_int" }
    if t == "float" { return "orbit_object_set_float" }
    if t == "bool" { return "orbit_object_set_bool" }
    if t == "object" { return "orbit_object_set_object" }
    if t == "list" || orbit_string_slice(t, 0, 4) == "list" { return "orbit_object_set_list" }
    return "orbit_object_set_string"
}

/** @brief The IRFieldKind number a declared type name stands for. 0 for none.
 *
 *  Only the kinds an object field can hold and the emitter has a getter for:
 *  a model, a result or any other name reads back through the string setter
 *  the object write path already used, so a number for it would pick a getter
 *  the write cannot match. `list` keeps its own number because the field
 *  needs `get_list`, which an object reference cannot stand in for. */
fn fieldKindCode(t: string) -> int {
    if t == "string" || t == "orbit_string" { return 1 }
    if t == "int" || t == "orbit_int" { return 2 }
    if t == "float" || t == "orbit_float" { return 3 }
    if t == "bool" || t == "orbit_bool" { return 4 }
    if t == "object" { return 5 }
    if t == "list" { return 6 }
    return 0
}

/** @brief Record the field kind on the instruction that defined @p reg.
 *
 *  `val ratio: float = o.ratio` is a read whose kind the setter scan in the
 *  emitter cannot supply when the object was built in another function, and
 *  never can for a key no literal wrote. The declaration is the read's
 *  expected type and the builder is the only stage that sees it, so the kind
 *  is written onto the read's own instruction and carried from there.
 *
 *  The register's first definition is the read: `ir_alloc_register` mints a
 *  fresh id per value, so the destination names exactly one instruction.
 *  Anything that is not a load_field -- `val x: int = f(o.a)` stores the
 *  call's result, not the read's -- records nothing, because a kind on a
 *  call would answer for all of its arguments. */
fn recordFieldKindOnDef(func: IRFunction, reg: int, kindCode: int) {
    if reg < 0 || kindCode == 0 { return }
    var i = 0
    while i < func.instructions.len() {
        val inst: IRInstruction = func.instructions.get(i)
        if inst != NULL && inst.dest == reg {
            var isLoad = false
            match inst.opcode {
                IROpcode.load_field => { isLoad = true }
                _ => {}
            }
            if isLoad { inst.fieldKind = kindCode }
            return
        }
        i = i + 1
    }
}

// The declared type of a top-level constant, or "" when the name is not one.
// Used to give a global's load registers their real type: without it the
// builder's first heuristic -- "capitalised means enum constant" -- typed a
// register NAME and the C came out as `NAME* r_0`.
fn topLevelConstantType(builder: IRBuilder, name: string) -> string {
    var gi = 0
    while gi < builder.module.globals.len() {
        val g: IRGlobal = builder.module.globals.get(gi)
        if g.name == name { return g.typeName }
        gi = gi + 1
    }
    return ""
}

// The type an operand value carries: an inline literal is its own type and a
// register is whatever the builder allocated it as.
fn operandTypeName(builder: IRBuilder, v: IRValue) -> string {
    match v {
        IRValue.Int(i) => { return "int" }
        IRValue.Float(f) => { return "float" }
        IRValue.String(s) => { return "string" }
        IRValue.Bool(b) => { return "bool" }
        IRValue.Register(r) => {
            val types = builder.currentFunction.registerTypes
            if r.value >= 0 && r.value < types.len() {
                val t: string = types.get(r.value)
                return t
            }
            return "unknown"
        }
        _ => { return "unknown" }
    }
}

// A comparison is a bool whatever its operands are: the language has no
// operator overload, so the result type needs no operand type. An arithmetic
// or bitwise operator is typed only when both operands carry the same proven
// type it is defined on; mixed or unknown operands keep "unknown", except a
// `+` with a string operand.
fn binaryResultType(builder: IRBuilder, op: string, lhs: IRValue, rhs: IRValue) -> string {
    if op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=" { return "bool" }
    val lt = operandTypeName(builder, lhs)
    val rt = operandTypeName(builder, rhs)
    // `+` with a string on either side is a concatenation, and the emitter
    // lowers it to orbit_string_concat whatever the other operand is.
    if op == "+" && (lt == "string" || rt == "string") { return "string" }
    if lt != rt { return "unknown" }
    if op == "+" || op == "-" || op == "*" || op == "/" {
        if lt == "int" || lt == "float" { return lt }
        return "unknown"
    }
    if op == "%" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
        if lt == "int" { return "int" }
    }
    return "unknown"
}

// Negation keeps the operand's type when that is a number; complement is
// defined on int only.
fn unaryResultType(builder: IRBuilder, op: string, operandReg: int) -> string {
    val types = builder.currentFunction.registerTypes
    if operandReg < 0 || operandReg >= types.len() { return "unknown" }
    val t: string = types.get(operandReg)
    if op == "-" && (t == "int" || t == "float") { return t }
    if op == "~" && t == "int" { return "int" }
    return "unknown"
}

// The register type of a model field read. The owner is the receiver's model,
// resolved by the declared type of the receiver, and the field's type is the
// one the model declares. The scalar spellings, `list` and `list<T>`, a
// declared enumeration, a declared non-generic model and a declared union are
// written; a generic instance and a type parameter keep "unknown".
fn fieldRegisterType(builder: IRBuilder, ownerName: string, fieldName: string) -> string {
    if ownerName == "" { return "unknown" }
    val ft = fieldTypeOfModel(builder, ownerName, fieldName)
    if ft == "int" || ft == "float" || ft == "bool" || ft == "string" || ft == "list" { return ft }
    if annotationBaseType(ft) == "list" { return "list" }
    if isEnumerationTypeName(builder, ft) { return ft }
    return declaredReferenceRegisterType(builder, ft)
}

// orbit-walk-misses: ConfigDeclNode, ConstDeclNode, ExpressionStmtNode, ForNode, FunctionDeclNode, MatchCaseNode, RangeNode, ReturnErrNode, ReturnNode, ReturnOkNode, RouteDeclNode, ScheduleDeclNode, VarDeclNode, WhileNode
fn buildExpr(builder: IRBuilder, node: ASTNode) -> int {
    // A type annotation is not a runtime operation: the value underneath is the
    // expression, and the annotation only says which declared type it has. A
    // model literal is the one case that needs it, because a `{...}` and a
    // `Model{...}` build differently and only the annotation says which.
    match node {
        ASTNode.TypedLiteral(tl) => {
            match tl.value {
                ASTNode.ObjectLiteral(ol) => {
                    if isModelDeclName(builder, tl.declaredType) {
                        return buildObjectLiteralAsModel(builder, tl.value, tl.declaredType)
                    }
                }
                _ => {}
            }
            return buildExpr(builder, tl.value)
        }
        _ => {}
    }
    match node {
        ASTNode.Literal(lit) => {
            if lit.valType == "identifier" {
                val varType = lookupVariable(builder, lit.text)
                // The symbol resolves by NAME, the register by TYPE, and the
                // two answers are independent: a live declaration with an
                // uninferrable type (a `val t0 = h0 * 435`, BinOp has no
                // resolveExprType arm) still owns its C symbol. Gating the
                // read on a known type falls through to the spelling, which
                // is a different variable when this one shadows -- the read
                // silently goes stale while the define minted. An undefined
                // name resolves to its own spelling, so the fallthrough below
                // runs exactly as before for globals, enum constants and
                // genuine unknowns.
                val sym = variableSymbol(builder, lit.text)
                if varType != "unknown" || sym != lit.text {
                    val varReg = ir_alloc_register(builder.currentFunction, varType)
                    val loadVar = ir_init_instr(IROpcode.load_var)
                    loadVar.dest = varReg
                    loadVar.operand1 = ir_symbol(sym)
                    ir_emit(builder.currentFunction, loadVar)
                    return varReg
                }
                // A top-level `val`/`const` with a constant value is a file
                // constant: load it like a variable, typed like one. It used to
                // fall through to the uppercase heuristic below, which typed a
                // capitalised name as if it were an enum variant.
                val gType = topLevelConstantType(builder, lit.text)
                if gType != "" {
                    val gReg = ir_alloc_register(builder.currentFunction, gType)
                    val gLoad = ir_init_instr(IROpcode.load_var)
                    gLoad.dest = gReg
                    gLoad.operand1 = ir_symbol(lit.text)
                    ir_emit(builder.currentFunction, gLoad)
                    return gReg
                }
                // A bare function name is its address, a constant. Loading it
                // as a variable mints a hoisted local of the same name, which
                // shadows the C function and reads uninitialised stack -- so
                // this is a load_const, which declares nothing. A variable
                // shadows the function of the same name, so only a name no
                // scope declares takes this path.
                if scopeHasName(builder, lit.text) == false {
                    val faddr = fnTypeSpellingFor(builder, lit.text)
                    if faddr != "" {
                        val fnReg = ir_alloc_register(builder.currentFunction, faddr)
                        val fnLoad = ir_init_instr(IROpcode.load_const)
                        fnLoad.dest = fnReg
                        fnLoad.operand1 = ir_symbol(lit.text)
                        ir_emit(builder.currentFunction, fnLoad)
                        return fnReg
                    }
                }
                // Check if it's an uppercase (type/enum constant)
                val fc0 = lit.text.at(0)
                if fc0 >= 65 && fc0 <= 90 {
                    val typeReg = ir_alloc_register(builder.currentFunction, lit.text)
                    val loadConst = ir_init_instr(IROpcode.load_const)
                    loadConst.dest = typeReg
                    loadConst.operand1 = ir_symbol(lit.text)
                    ir_emit(builder.currentFunction, loadConst)
                    return typeReg
                }
                // Unknown identifier - emit load anyway
                val unknownReg = ir_alloc_register(builder.currentFunction, "unknown")
                val loadInstr = ir_init_instr(IROpcode.load_var)
                loadInstr.dest = unknownReg
                loadInstr.operand1 = ir_symbol(lit.text)
                ir_emit(builder.currentFunction, loadInstr)
                return unknownReg
            }
            var litAllocType = lit.valType
            if litAllocType == "char" {
                litAllocType = "int"
            }
            // A raw string differs from a string only in how the lowering
            // reads its text; the register holds the same `orbit_string`.
            if litAllocType == "string_raw" {
                litAllocType = "string"
            }
            val litReg = ir_alloc_register(builder.currentFunction, litAllocType)
            val litInstr = ir_init_instr(IROpcode.load_const)
            litInstr.dest = litReg
            if lit.valType == "string" || lit.valType == "string_raw" {
                litInstr.operand1 = ir_string(literalStringValue(lit))
            } else if lit.valType == "char" {
                litInstr.operand1 = ir_int(charCodeOf(lit.text))
            } else if lit.valType == "int" {
                // The value, not the source text. Emitting the text worked only
                // because every decimal integer is also a valid C literal:
                // "0xFF" survived by luck and "3_0" did not, reaching the C
                // compiler as an integer with a "_0" suffix.
                litInstr.operand1 = ir_int(parseIntSelfhost(lit.text))
            } else {
                litInstr.operand1 = ir_symbol(lit.text)
            }
            ir_emit(builder.currentFunction, litInstr)
            return litReg
        }
        ASTNode.BinaryOp(bin) => {
            if bin.op == "=" {
                // Assignment
                val rhsReg = buildExpr(builder, bin.rhs)
                match bin.lhs {
                    ASTNode.Literal(lit) => {
                        val storeInstr = ir_init_instr(IROpcode.store_var)
                        storeInstr.operand1 = ir_symbol(variableSymbol(builder, lit.text))
                        storeInstr.operand2 = ir_register(rhsReg)
                        ir_emit(builder.currentFunction, storeInstr)
                        return rhsReg
                    }
                    ASTNode.MemberAccess(ma) => {
                        val objReg = buildExpr(builder, ma.object)
                        val storeField = ir_init_instr(IROpcode.store_field)
                        storeField.operand1 = ir_register(objReg)
                        var storeFieldRef = ma.field
                        val ownerA = fieldOwnerForObject(builder, ma.object, ma.field)
                        if ownerA != "" {
                            storeFieldRef = ownerA + "." + ma.field
                        }
                        storeField.operand2 = ir_symbol(storeFieldRef)
                        storeField.operand3 = ir_register(rhsReg)
                        ir_emit(builder.currentFunction, storeField)
                        return rhsReg
                    }
                    ASTNode.IndexAccess(ia) => {
                        val objReg = buildExpr(builder, ia.object)
                        val idxReg = buildExpr(builder, ia.index)
                        val setInstr = ir_init_instr(IROpcode.list_set)
                        setInstr.operand1 = ir_register(objReg)
                        setInstr.operand2 = ir_register(idxReg)
                        setInstr.operand3 = ir_register(rhsReg)
                        val resReg = ir_alloc_register(builder.currentFunction, "void")
                        setInstr.dest = resReg
                        setInstr.elemKind = listWriteKind(builder, ia.object, bin.rhs)
                        ir_emit(builder.currentFunction, setInstr)
                        return rhsReg
                    }
                    _ => {
                        return rhsReg
                    }
                }
            }
            if bin.op == "&&" || bin.op == "||" {
                return buildShortCircuit(builder, bin)
            }
            val lhsOperand = buildCallArgValue(builder, bin.lhs)
            val rhsOperand = buildCallArgValue(builder, bin.rhs)
            var opCode = IROpcode.add
            if bin.op == "+" { opCode = IROpcode.add }
            if bin.op == "-" { opCode = IROpcode.sub }
            if bin.op == "*" { opCode = IROpcode.mul }
            if bin.op == "/" { opCode = IROpcode.div }
            if bin.op == "%" { opCode = IROpcode.mod }
            if bin.op == "==" { opCode = IROpcode.eq }
            if bin.op == "!=" { opCode = IROpcode.ne }
            if bin.op == "<" { opCode = IROpcode.lt }
            if bin.op == "<=" { opCode = IROpcode.le }
            if bin.op == ">" { opCode = IROpcode.gt }
            if bin.op == ">=" { opCode = IROpcode.ge }
            if bin.op == "&" { opCode = IROpcode.bit_and }
            if bin.op == "|" { opCode = IROpcode.bit_or }
            if bin.op == "^" { opCode = IROpcode.bit_xor }
            if bin.op == "<<" { opCode = IROpcode.shl }
            if bin.op == ">>" { opCode = IROpcode.shr }
            val binInstr = ir_init_instr(opCode)
            val binReg = ir_alloc_register(builder.currentFunction, binaryResultType(builder, bin.op, lhsOperand, rhsOperand))
            binInstr.dest = binReg
            binInstr.operand1 = lhsOperand
            binInstr.operand2 = rhsOperand
            ir_emit(builder.currentFunction, binInstr)
            return binReg
        }
        ASTNode.UnaryOp(u) => {
            val operandReg = buildExpr(builder, u.operand)
            if u.op == "!" {
                val reg = ir_alloc_register(builder.currentFunction, "bool")
                val instr = ir_init_instr(IROpcode.not_op)
                instr.dest = reg
                instr.operand1 = ir_register(operandReg)
                ir_emit(builder.currentFunction, instr)
                return reg
            }
            if u.op == "-" {
                val reg = ir_alloc_register(builder.currentFunction, unaryResultType(builder, "-", operandReg))
                val instr = ir_init_instr(IROpcode.neg)
                instr.dest = reg
                instr.operand1 = ir_register(operandReg)
                ir_emit(builder.currentFunction, instr)
                return reg
            }
            if u.op == "~" {
                val reg = ir_alloc_register(builder.currentFunction, unaryResultType(builder, "~", operandReg))
                val instr = ir_init_instr(IROpcode.bit_not)
                instr.dest = reg
                instr.operand1 = ir_register(operandReg)
                ir_emit(builder.currentFunction, instr)
                return reg
            }
            return operandReg
        }
        ASTNode.Call(c) => {
            return buildCall(builder, c)
        }
        ASTNode.MemberAccess(ma) => {
            val memberText = ma.field
            var reqValueBuiltin = ""
            var reqValueOperand = ir_symbol("req")
            match ma.object {
                ASTNode.Literal(lit) => {
                    if lit.valType == "identifier" && lit.text == "req" {
                        if memberText == "body" || memberText == "json" {
                            reqValueBuiltin = "orbit_http_body_get"
                        } else if memberText == "bearer_token" {
                            reqValueBuiltin = "orbit_auth_bearer_token"
                            reqValueOperand = ir_symbol("req->headers")
                        } else if memberText == "role" {
                            reqValueBuiltin = "orbit_auth_current_role"
                            reqValueOperand = ir_symbol("req->headers")
                        }
                    }
                }
                _ => {}
            }
            if reqValueBuiltin != "" {
                val reqValueArg = ir_init_instr(IROpcode.arg)
                reqValueArg.operand1 = reqValueOperand
                ir_emit(builder.currentFunction, reqValueArg)
                val reqValueRes = ir_alloc_register(builder.currentFunction, lookupFunctionReturnType(builder, reqValueBuiltin))
                val reqValueCall = ir_init_instr(IROpcode.call)
                reqValueCall.dest = reqValueRes
                reqValueCall.operand1 = ir_string(reqValueBuiltin)
                reqValueCall.operand2 = ir_int(1)
                ir_emit(builder.currentFunction, reqValueCall)
                return reqValueRes
            }
            // Check if object is uppercase (type/enum constant reference like Type.Variant)
            var enumConstName = ""
            var enumOwnerName = ""
            match ma.object {
                ASTNode.Literal(lit) => {
                    if lit.valType == "identifier" {
                        val fc = lit.text.at(0)
                        if fc >= 65 && fc <= 90 {
                            enumOwnerName = lit.text
                            enumConstName = lit.text + "_TAG_" + memberText
                        }
                    }
                }
                _ => {}
            }
            if enumConstName != "" {
                // A payload-less variant of a tagged union used as a VALUE must
                // build a real variant node, exactly like Type.Variant(payload)
                // does in buildCall. Emitting the bare Type_TAG_Variant integer
                // here produced values that consumers later dereferenced as node
                // pointers (checkNode reading ->tag off the raw int 38).
                // Plain enums (IROpcode, TokType, ...) are genuine C enums and
                // keep loading the constant.
                if isUnionTypeName(builder, enumOwnerName) {
                    val ctorReg = ir_alloc_register(builder.currentFunction, "void*")
                    val ctorCall = ir_init_instr(IROpcode.call)
                    ctorCall.dest = ctorReg
                    ctorCall.operand1 = ir_string(memberText)
                    ctorCall.operand2 = ir_int(0)
                    ir_emit(builder.currentFunction, ctorCall)
                    return ctorReg
                }
                // Enum constant reference: Type.Variant -> Type_TAG_Variant
                var constType = "unknown"
                if isEnumerationTypeName(builder, enumOwnerName) { constType = enumOwnerName }
                val reg = ir_alloc_register(builder.currentFunction, constType)
                val instr = ir_init_instr(IROpcode.load_var)
                instr.dest = reg
                instr.operand1 = ir_string(enumConstName)
                ir_emit(builder.currentFunction, instr)
                return reg
            }
            // Regular field access
            val objReg = buildExpr(builder, ma.object)
            val ownerName = fieldOwnerForObject(builder, ma.object, memberText)
            var fieldType = fieldRegisterType(builder, ownerName, memberText)
            if (memberText == "length" || memberText == "len") && resolveExprType(builder, ma.object) == "string" {
                fieldType = "int"
            }
            val fieldReg = ir_alloc_register(builder.currentFunction, fieldType)
            val fieldInstr = ir_init_instr(IROpcode.load_field)
            fieldInstr.dest = fieldReg
            fieldInstr.operand1 = ir_register(objReg)
            var fieldRef = memberText
            if ownerName != "" {
                fieldRef = ownerName + "." + memberText
            }
            fieldInstr.operand2 = ir_symbol(fieldRef)
            ir_emit(builder.currentFunction, fieldInstr)
            // A field access must evaluate to the field's VALUE, never to a union tag.
            // Extracting the tag here discarded the node pointer and returned a bare
            // integer (e.g. ASTNode_TAG_Literal == 22), which then got passed to
            // functions expecting an ASTNode and crashed on the first tag read.
            // Callers that genuinely need the tag already emit union_get_tag on the
            // scrutinee themselves: see buildMatchStatement and buildMatchExpr, which
            // both emit union_get_tag AND union_get_data from the register returned
            // here. Doing it early also broke `match x.field { ... }`, since that
            // would have read the tag of a tag.
            return fieldReg
        }
        ASTNode.Interp(ip) => {
            return buildInterpString(builder, ip.parts, ip.isRaw)
        }
        ASTNode.ObjectLiteral(ol) => {
            return buildObjectLiteral(builder, node)
        }
        ASTNode.ListLiteral(ll) => {
            val elemCount = ll.elements.len()
            val listReg = ir_alloc_register(builder.currentFunction, "list")
            val createInstr = ir_init_instr(IROpcode.list_create)
            createInstr.dest = listReg
            createInstr.operand1 = ir_int(8)
            createInstr.operand2 = ir_int(elemCount)
            createInstr.elemKind = elemKindCode(listLiteralKindName(builder, ll))
            ir_emit(builder.currentFunction, createInstr)
            var ei = 0
            while ei < elemCount {
                val elemReg = buildExpr(builder, ll.elements.get(ei))
                val pushInstr = ir_init_instr(IROpcode.list_push)
                pushInstr.operand1 = ir_register(listReg)
                pushInstr.operand2 = ir_register(elemReg)
                val voidReg = ir_alloc_register(builder.currentFunction, "void")
                pushInstr.dest = voidReg
                pushInstr.elemKind = elemKindCode(staticExprTypeName(builder, ll.elements.get(ei)))
                ir_emit(builder.currentFunction, pushInstr)
                ei = ei + 1
            }
            return listReg
        }
        ASTNode.IndexAccess(ia) => {
            val objReg = buildExpr(builder, ia.object)
            val idxReg = buildExpr(builder, ia.index)
            val getInstr = ir_init_instr(IROpcode.list_get)
            val elemKind = elemKindCode(listReadElemKindName(builder, ia.object))
            val resReg = ir_alloc_register(builder.currentFunction, listReadRegisterType(builder, ia.object, elemKind))
            getInstr.dest = resReg
            getInstr.operand1 = ir_register(objReg)
            getInstr.operand2 = ir_register(idxReg)
            getInstr.elemKind = elemKind
            ir_emit(builder.currentFunction, getInstr)
            return resReg
        }
        ASTNode.Match(m) => {
            return buildMatchExpr(builder, m)
        }
        ASTNode.If(ifn) => {
            return buildIfBody(builder, ifn, true)
        }
        ASTNode.Try(t) => {
            return buildTryExpr(builder, t)
        }
        ASTNode.Assignment(a) => {
            val rhsReg = buildExpr(builder, a.value)
            match a.target {
                ASTNode.Literal(lit) => {
                    val storeInstr = ir_init_instr(IROpcode.store_var)
                    storeInstr.operand1 = ir_symbol(variableSymbol(builder, lit.text))
                    storeInstr.operand2 = ir_register(rhsReg)
                    ir_emit(builder.currentFunction, storeInstr)
                    return rhsReg
                }
                ASTNode.MemberAccess(ma) => {
                    val objReg = buildExpr(builder, ma.object)
                    val storeField = ir_init_instr(IROpcode.store_field)
                    storeField.operand1 = ir_register(objReg)
                    var storeFieldRef2 = ma.field
                    val ownerB = fieldOwnerForObject(builder, ma.object, ma.field)
                    if ownerB != "" {
                        storeFieldRef2 = ownerB + "." + ma.field
                    }
                    storeField.operand2 = ir_symbol(storeFieldRef2)
                    storeField.operand3 = ir_register(rhsReg)
                    ir_emit(builder.currentFunction, storeField)
                    return rhsReg
                }
                ASTNode.IndexAccess(ia) => {
                    val objReg = buildExpr(builder, ia.object)
                    val idxReg = buildExpr(builder, ia.index)
                    val setInstr = ir_init_instr(IROpcode.list_set)
                    setInstr.operand1 = ir_register(objReg)
                    setInstr.operand2 = ir_register(idxReg)
                    setInstr.operand3 = ir_register(rhsReg)
                    val resReg = ir_alloc_register(builder.currentFunction, "void")
                    setInstr.dest = resReg
                    setInstr.elemKind = listWriteKind(builder, ia.object, a.value)
                    ir_emit(builder.currentFunction, setInstr)
                    return rhsReg
                }
                _ => { return rhsReg }
            }
        }
        ASTNode.FieldInit(fi) => {
            return buildExpr(builder, fi.value)
        }
        ASTNode.Break(b) => { return emitNamedLoopJump(builder, builder.loopEndLabels, b.label) }
        ASTNode.Continue(c) => { return emitNamedLoopJump(builder, builder.loopContinueLabels, c.label) }
        _ => {
            return -1
        }
    }
}

fn buildTryExpr(builder: IRBuilder, t: TryNode) -> int {
    val exprReg = buildExpr(builder, t.expr)
    val func = builder.currentFunction
    val isOkReg = ir_alloc_register(func, "bool")
    val checkInstr = ir_init_instr(IROpcode.result_is_ok)
    checkInstr.dest = isOkReg
    checkInstr.operand1 = ir_register(exprReg)
    ir_emit(func, checkInstr)
    val errLabel = allocLabel(builder)
    val endLabel = allocLabel(builder)
    val jmp = ir_init_instr(IROpcode.jump_if_false)
    jmp.operand1 = ir_register(isOkReg)
    jmp.operand2 = ir_label(errLabel)
    ir_emit(func, jmp)
    val unwrapReg = ir_alloc_register(func, "unknown")
    val unwrapInstr = ir_init_instr(IROpcode.result_unwrap)
    unwrapInstr.dest = unwrapReg
    unwrapInstr.operand1 = ir_register(exprReg)
    ir_emit(func, unwrapInstr)
    val jmpEnd = ir_init_instr(IROpcode.jump)
    jmpEnd.operand1 = ir_label(endLabel)
    ir_emit(func, jmpEnd)
    val lblErr = ir_init_instr(IROpcode.label)
    lblErr.operand1 = ir_label(errLabel)
    ir_emit(func, lblErr)
    if t.errName != "" {
        val errStrReg = ir_alloc_register(func, "string")
        val unwrapErr = ir_init_instr(IROpcode.result_unwrap_err)
        unwrapErr.dest = errStrReg
        unwrapErr.operand1 = ir_register(exprReg)
        ir_emit(func, unwrapErr)
        val errC = defineVariable(builder, t.errName, "string")
        val declErr = ir_init_instr(IROpcode.decl_var)
        declErr.operand1 = ir_symbol(errC)
        declErr.operand2 = ir_register(errStrReg)
        ir_emit(func, declErr)
    }
    match t.catchBody {
        ASTNode.Empty => {
            // Without a handler, propagate the original Result unchanged.
            val retInstr = ir_init_instr(IROpcode.ret)
            retInstr.operand1 = ir_register(exprReg)
            ir_emit(func, retInstr)
        }
        _ => { buildNode(builder, t.catchBody) }
    }
    val lblEnd = ir_init_instr(IROpcode.label)
    lblEnd.operand1 = ir_label(endLabel)
    ir_emit(func, lblEnd)
    return unwrapReg
}

fn hexNibbleValue(code: int) -> int {
    if code >= 48 && code <= 57 { return code - 48 }
    if code >= 65 && code <= 70 { return code - 55 }
    if code >= 97 && code <= 102 { return code - 87 }
    return -1
}

// The text of a string literal, as a runtime value. An ordinary literal still
// goes through unescapeString; a raw one only has its delimiters removed,
// because r#"..."# exists precisely so that its contents are taken literally.
fn literalStringValue(l: LiteralNode) -> string {
    if l.valType == "string_raw" { return rawStringValue(l.text) }
    return unescapeString(l.text)
}

// Strip the """ delimiters from a raw string literal and return everything
// between them untouched. A backslash stays two characters and a newline stays
// a newline, which is the whole point of the form. The lexer guarantees both
// ends, so this only has to take three characters off each side.
fn rawStringValue(s: string) -> string {
    if s.len() < 6 { return "" }
    return s.slice(3, s.len() - 3)
}

fn unescapeString(s: string) -> string {
    if s.len() < 2 { return s }
    return unescapeStringBody(s.slice(1, s.len() - 1))
}

// The same rules as unescapeString, for text that is already just a body: a
// chunk of an interpolated string, where the delimiters are elsewhere and
// re-adding them would be wrong, since a chunk may legitimately end in a
// backslash that would then escape the delimiter we made up.
fn unescapeStringBody(inner: string) -> string {
    var out = ""
    var i = 0
    while i < inner.len() {
        val c = inner.slice(i, i + 1)
        if c == "\\" {
            if i + 1 < inner.len() {
                val next = inner.slice(i + 1, i + 2)
                if next == "n" { out = out + "\n" }
                else if next == "t" { out = out + "\t" }
                else if next == "r" { out = out + "\r" }
                else if next == "\"" { out = out + "\"" }
                else if next == "\\" { out = out + "\\" }
                else if next == "x" {
                    // \xHH byte escape (e.g. \x1b for ESC). Anything
                    // malformed stays literal, exactly as before.
                    var consumed = 2
                    if i + 3 < inner.len() {
                        val hi = hexNibbleValue(orbit_string_char_at_selfhost(inner, i + 2))
                        val lo = hexNibbleValue(orbit_string_char_at_selfhost(inner, i + 3))
                        if hi >= 0 && lo >= 0 && hi * 16 + lo > 0 {
                            out = out + orbit_string_from_char_selfhost(hi * 16 + lo)
                            consumed = 4
                        } else {
                            out = out + "\\" + next
                        }
                    } else {
                        out = out + "\\" + next
                    }
                    i = i + consumed
                } else {
                    out = out + "\\" + next
                }
                if next != "x" { i = i + 2 }
            } else {
                out = out + c
                i = i + 1
            }
        } else {
            out = out + c
            i = i + 1
        }
    }
    return out
}

fn charCodeOf(s: string) -> int {
    if s.len() < 3 { return 0 }
    val inner = s.slice(1, s.len() - 1)
    val c0 = inner.at(0)
    if c0 != 92 { return c0 }
    if inner.len() < 2 { return 0 }
    val c1 = inner.at(1)
    if c1 == 110 { return 10 } // \n
    if c1 == 116 { return 9 } // \t
    if c1 == 114 { return 13 } // \r
    if c1 == 48 { return 0 } // \0
    if c1 == 92 { return 92 } // \\
    if c1 == 39 { return 39 } // \'
    if c1 == 34 { return 34 } // \"
    return c1
}

fn modelFieldIsString(builder: IRBuilder, fieldName: string) -> bool {
    var allString = true
    var found = false
    var mi = 0
    while mi < builder.module.models.len() {
        val m: IRModelDecl = builder.module.models.get(mi)
        var fi = 0
        while fi < m.fields.len() {
            val f: IRModelField = m.fields.get(fi)
            if f.name == fieldName {
                found = true
                if f.typeName != "string" {
                    allString = false
                }
            }
            fi = fi + 1
        }
        mi = mi + 1
    }
    if found == false { return false }
    return allString
}
