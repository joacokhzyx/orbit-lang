// Intermediate Representation for Orbit Self-Hosting Compiler

union IROpcode {
    nop,
    load_const,
    load_var,
    store_var,
    decl_var,
    add,
    sub,
    mul,
    div,
    mod,
    eq,
    ne,
    lt,
    le,
    gt,
    ge,
    and_op,
    or_op,
    not_op,
    neg,
    begin_block,
    end_block,
    call,
    ret,
    jump,
    jump_if_false,
    alloc,
    free,
    db_get,
    db_set,
    db_all,
    db_where,
    http_response,
    label,
    copy,
    arg,
    load_field,
    store_field,
    switch_op,
    type_info,

    // Collection opcodes
    list_create,
    list_push,
    list_get,
    list_set,
    list_len,
    list_pop,
    map_create,
    map_set,
    map_get,
    map_has,
    map_delete,
    map_keys,

    // Result opcodes
    result_ok,
    result_err,
    result_unwrap,
    result_is_ok,
    result_unwrap_err,

    // Union opcodes
    union_create,
    union_get_tag,
    union_get_data,

    // Bitwise and shift opcodes, appended so existing tag numbers never
    // shift. Operands and results are ints; the emitter reinterprets them as
    // unsigned so what the operator sees is the bit pattern and not the sign.
    bit_and,
    bit_or,
    bit_xor,
    shl,
    shr,
    bit_not,

    // Runtime-module opcodes. Valid only in a module with runtimeModule set
    // (docs/IR_SPEC.md), appended so existing tag numbers never shift.
    str_len,
    byte_load,
    bytes_alloc,
    byte_store,
    str_offset,
    bytes_copy,
    // Pointers and words, for a runtime module only: a 64-bit copy between a
    // string and an RtPtr, a load or store of 8 or 4 bytes (elemKind), the bit
    // pattern of a float and back.
    reinterpret,
    mem_load,
    mem_store,
    float_bits,
    bits_float
}

model IRValueInt { value: int }
model IRValueFloat { value: float }
model IRValueString { value: string }
model IRValueSymbol { value: string }
model IRValueBool { value: bool }
model IRValueRegister { value: int }
model IRValueLabel { value: int }

union IRValue {
    Int(IRValueInt),
    Float(IRValueFloat),
    String(IRValueString),
    Sym(IRValueSymbol),
    Bool(IRValueBool),
    Register(IRValueRegister),
    Label(IRValueLabel),
    None
}

model IRInstruction {
    opcode: IROpcode
    dest: int // -1 if null
    operand1: IRValue
    operand2: IRValue
    operand3: IRValue
    // The element type of the list this instruction touches, as an
    // OrbitElemKind number (0 undecided, 1 string, 2 int, 3 float, 4 bool,
    // 5 ref). Only the collection opcodes set it, and only the builder sets
    // it -- it is the one place the element type is decided, so the reader
    // and the writer cannot disagree about which accessor to emit. 0 means
    // "nobody could tell", which lowers to the untyped accessor and to a
    // `void*` destination, exactly as before.
    elemKind: int
    // The kind of the object field a load_field reads, as an IRFieldKind
    // number (0 undecided, 1 string, 2 int, 3 float, 4 bool, 5 object,
    // 6 list). The setter scan in the backend answers from the writes to
    // that key in the SAME function; a field of an object built in another
    // function, and a key nothing ever wrote, have no such write. There the
    // declared type of the read is what the program meant, and the builder
    // is the only place that sees it, so it records it here, at the read,
    // once. Like elemKind this exists so the reader and the writer cannot
    // disagree -- but it is a fallback: the setter scan still wins wherever
    // it has an answer, so no read that was lowered correctly before moves.
    fieldKind: int
    // The Orbit source line of a `div` or `mod`, which can fail at run time
    // and then names the line it failed on. 0 means unknown: only those two
    // opcodes set it, and an instruction the compiler synthesizes has none.
    line: int
}

// Factory functions for IRValue
fn ir_int(v: int) -> IRValue {
    val m = IRValueInt(v)
    return IRValue.Int(m)
}

fn ir_string(v: string) -> IRValue {
    val m = IRValueString(v)
    return IRValue.String(m)
}

fn ir_symbol(v: string) -> IRValue {
    val m = IRValueSymbol(v)
    return IRValue.Sym(m)
}

fn ir_bool(v: bool) -> IRValue {
    val m = IRValueBool(v)
    return IRValue.Bool(m)
}

fn ir_register(v: int) -> IRValue {
    val m = IRValueRegister(v)
    return IRValue.Register(m)
}

fn ir_label(v: int) -> IRValue {
    val m = IRValueLabel(v)
    return IRValue.Label(m)
}

fn ir_none() -> IRValue {
    return IRValue.None
}

fn ir_init_instr(opcode: IROpcode) -> IRInstruction {
    return IRInstruction(opcode, -1, ir_none(), ir_none(), ir_none(), 0, 0, 0)
}

model IRFunction {
    name: string
    params: list < string >
    paramTypes: list < string >
    instructions: list < IRInstruction >
    registerCount: int
    registerTypes: list < string >
    returnType: string
    isExtern: bool
    routeMethod: string
    routePath: string
    routeHasLimit: bool
    routeLimitRate: int
    routeLimitWindowMs: int
    routeLimitBurst: int
    // An `export fn` of a runtime module: emitted under its own name, without
    // the leading arena parameter.
    isExport: bool
}

fn initIRFunction(name: string) -> IRFunction {
    return IRFunction(name, [], [], [], 0, [], "void", false, "", "", false, 0, 0, 0, false)
}

fn initRouteFunction(name: string, method: string, path: string) -> IRFunction {
    return IRFunction(name, [], [], [], 0, [], "OrbitResponse*", false, method, path, false, 0, 0, 0, false)
}

fn ir_alloc_register(func: IRFunction, typeName: string) -> int {
    val reg = func.registerCount
    func.registerCount = func.registerCount + 1
    func.registerTypes.push(typeName)
    return reg
}

fn ir_emit(func: IRFunction, instr: IRInstruction) {
    func.instructions.push(instr)
}

model IRModelField {
    name: string
    typeName: string
}

model IRModelDecl {
    name: string
    fields: list < IRModelField >
    // The type parameter names, in declaration order. A model with any is a
    // GENERIC DECLARATION and never reaches the emitter: it lives in
    // IRBuilder.genericModels, not in IRModule.models, because a field typed
    // `T` has no C type until a use says what T is. Only the instantiations
    // the builder synthesises -- `Box` with `T` fixed at `int` is `Box_int`,
    // fields already substituted -- are IRModelDecls in module.models, so
    // every existing consumer of that list sees exactly what it saw before.
    typeParams: list < string >
}

model IRVariantField {
    name: string
    typeName: string
}

model IRVariantDecl {
    name: string
    hasPayload: bool
    payloadType: string
    fields: list < IRVariantField >
}

model IRTypeDecl {
    name: string
    kind: string // "enumeration", "union_type", "alias", "trait"
    variants: list < string >
    richVariants: list < string >
    methods: list < string >
}

model IRModule {
    functions: list < IRFunction >
    globals: list < IRGlobal > // list of IRGlobal
    models: list < IRModelDecl >
    types: list < IRTypeDecl >
    migrations: list < string >
    // The `port N` service declaration, or 0 when the program declares none.
    // The emitted server main binds this; argv[1] still overrides at run time.
    configPort: int
    // The base name of the root source file, which a run-time diagnostic that
    // names a line (division by zero) prints beside it. Not a path: the IR is
    // byte-reproducible across checkouts, and a path is not.
    sourceName: string
    // Set by `--runtime-module`: the module has no entry point and its
    // `export fn` functions are the runtime library's symbols.
    runtimeModule: bool
}

model IRGlobal {
    name: string
    value: IRValue
    typeName: string
}

fn initIRModule() -> IRModule {
    return IRModule([], [], [], [], [], 0, "", false)
}
