// External functions provided by the runtime for self-hosted compiler
extern fn orbit_int_to_string_selfhost(value: int) -> string
extern fn orbit_float_to_string_selfhost(value: float) -> string
extern fn orbit_string_char_at_selfhost(s: string, index: int) -> int
extern fn orbit_os_argc_selfhost() -> int
extern fn orbit_os_argv_selfhost(index: int) -> string
extern fn orbit_os_exec_selfhost(command: string) -> string
extern fn orbit_os_spawn_selfhost(command: string) -> int
extern fn orbit_os_spawn_bg_selfhost(command: string, logfile: string) -> int
extern fn orbit_os_kill_selfhost(pid: int, mode: int) -> int
extern fn orbit_os_env_selfhost(var_name: string) -> string
extern fn orbit_file_write_selfhost(path: string, content: string) -> bool
extern fn orbit_file_read_selfhost(path: string) -> string
extern fn orbit_file_list_dir_selfhost(path: string) -> list
extern fn orbit_os_exit_selfhost(code: int)
extern fn orbit_os_write_stderr_selfhost(content: string)
// Chunk buffer for codegen: the handle rides in a string-typed local
// (never inspected as text) because self-host int is 32 bits.
extern fn orbit_cbuf_create_selfhost() -> string
extern fn orbit_cbuf_append_selfhost(buf: string, s: string)
extern fn orbit_cbuf_build_selfhost(buf: string) -> string
// Memory snapshot of the global arena (see ORBIT_MEM_REPORT).
extern fn orbit_mem_report_selfhost() -> string
