// Orbit Self-Hosting Compiler - numeric literal text
// compiler/literal.orb
//
// This function used to live in builder.orb, which is the wrong side of the
// import graph: the parser called it to read a route's `limit` rate, and the
// parser does not import -- and must not import -- the IR builder. Nothing
// caught it because an unresolved call is not an error: `orbit check` stayed
// clean and the C compiler rejected the output with a name it had never been
// given. So a program that used the parser without the builder -- which is
// exactly what `orbit frontend` is -- could not be built at all (F-0004).
//
// A leaf module both callers can reach is the fix. This one imports nothing,
// so builder.orb and parser.orb can both depend on it and the graph stays a
// DAG.

fn parseIntSelfhost(s: string) -> int {
    var result = 0
    var i = 0
    // A leading 0 and a letter give the base: 0x/0X hex, 0b/0B binary,
    // 0o/0O octal. Anything else is base 10, where a '_' separator is simply
    // not a digit and is skipped, so 1_000_000 reads as one million without a
    // special case.
    var base = 10
    if s.len() > 2 {
        if s.at(0) == 48 {
            val marker = s.at(1)
            if marker == 120 || marker == 88 { base = 16 } // 'x' 'X'
            if marker == 98 || marker == 66 { base = 2 } // 'b' 'B'
            if marker == 111 || marker == 79 { base = 8 } // 'o' 'O'
            if base != 10 { i = 2 }
        }
    }
    while i < orbit_string_len(s) {
        val c = s.at(i)
        if c >= 48 && c <= 57 {
            // The lexer already refused a digit the base cannot express, so a
            // '8' never reaches here in octal. The check is kept because this
            // function is also reachable from a string this did not lex.
            if (base == 8 && c > 55) || (base == 2 && c > 49) {
                i = i + 1
                continue
            }
            result = result * base + (c - 48)
        } else if base == 16 {
            if c >= 97 && c <= 102 { result = result * 16 + (c - 87) } // 'a'-'f'
            if c >= 65 && c <= 70 { result = result * 16 + (c - 55) } // 'A'-'F'
        }
        i = i + 1
    }
    return result
}

// Does this integer literal denote a value orbit_int can hold?
//
// parseIntSelfhost cannot answer that question, because asking it is the
// defect: it accumulates `result * base + digit` into an int and wraps, so
// 2147483648 comes back as -2147483648 and the caller cannot tell a value that
// fit from one that did not. A literal is the one thing in a program that
// cannot be checked later -- by the time there is a register, the wrong number
// is already the program -- so the check happens on the text.
//
// The digits are tested against the limit as they arrive and the walk stops
// the moment the partial value passes it, so no intermediate ever has to hold
// a value that does not fit. The bound is 2147483647: orbit_int is a C int
// (runtime/types.c), and INT_MIN is spelled separately, as a negation.
fn intLiteralFitsSelfhost(s: string) -> bool {
    var i = 0
    var base = 10
    if s.len() > 2 {
        if s.at(0) == 48 && (s.at(1) == 120 || s.at(1) == 88) { // '0' 'x' 'X'
            base = 16
            i = 2
        }
    }
    var value = 0
    val limit = 2147483647
    while i < orbit_string_len(s) {
        val c = s.at(i)
        if c >= 48 && c <= 57 {
            if value > (limit - (c - 48)) / base { return false }
            value = value * base + (c - 48)
        } else if base == 16 {
            if c >= 97 && c <= 102 {
                if value > (limit - (c - 87)) / 16 { return false }
                value = value * 16 + (c - 87)
            } else if c >= 65 && c <= 70 {
                if value > (limit - (c - 55)) / 16 { return false }
                value = value * 16 + (c - 55)
            }
        }
        i = i + 1
    }
    return true
}

// ── Generic instantiation names ──────────────────────────────────────────
//
// `Box<int>` becomes the struct `Box_int` in the emitted C, and the checker
// and the builder MUST agree on that string: a symbol typed `Box_int` beside a
// literal built as something else would pass `orbit check` and then read the
// wrong member. Two copies of this rule is exactly the failure this module
// exists to prevent (see the note at the top), so there is one copy and both
// callers import it.

fn isTypeNameChar(c: int) -> bool {
    if c >= 48 && c <= 57 { return true }
    if c >= 65 && c <= 90 { return true }
    if c >= 97 && c <= 122 { return true }
    if c == 95 { return true }
    return false
}

// The struct-name suffix for one type argument. `list<string>` is
// `list_string`, so no punctuation survives into a C identifier and two
// different arguments cannot collide. The emitter's own sanitizeIdentifier
// would turn the punctuation into runs of `_` instead, which is also correct
// but makes `Box_list__string_` unreadable in the generated C.
fn mangleTypeArg(s: string) -> string {
    var out = ""
    var i = 0
    while i < orbit_string_len(s) {
        val c = s.at(i)
        if isTypeNameChar(c) {
            out = out + s.slice(i, i + 1)
        } else {
            // `&&` does not short-circuit in this language, so the guard is a
            // statement and not a second operand: slicing at -1 of an empty
            // string is the thing being kept out of reach.
            val n = orbit_string_len(out)
            if n > 0 {
                if orbit_string_slice(out, n - 1, n) != "_" { out = out + "_" }
            }
        }
        i = i + 1
    }
    val n2 = orbit_string_len(out)
    if n2 > 0 {
        if orbit_string_slice(out, n2 - 1, n2) == "_" { out = orbit_string_slice(out, 0, n2 - 1) }
    }
    return out
}
