import "./ast.orb"
import "./parser.orb"
import "./pipeline.orb"

// orbit doctor: read-only project checks with optional whitespace fixes.
//
// Usage: orbit doctor [dir] [--fix]
// Exit codes: 0 clean, 1 findings, 2 usage.
//
// Checks (each finding prints file:line, a code, and a one-line fix):
//   D001  C toolchain resolution (ORBIT_CC -> CC -> gcc -> clang -> cc)
//   D002  route conflicts incl. param normalization and wildcard coverage
//   D003  unused private fns (high-confidence only)
//   D004  unused models (high-confidence only)
//   D005  system.* misuse (unknown member)
//   D006  trailing whitespace (fixed by --fix)
//   D007  missing final newline (fixed by --fix)
//   D008  file does not pass the compiler's own checks
//
// --fix applies only D006/D007 whitespace tidies. Nothing semantic is
// ever changed automatically.

model DoctorStats {
    findings: int
    files: int
    jsonMode: bool
    quiet: bool
    color: string
    findItems: list
    // Per-layer duration in milliseconds, so the scan budget in ENGINEERING.md
    // is measured instead of asserted. Four counters because four phases do
    // different amounts of work, and one total would hide which one.
    textMs: int
    astMs: int
    semaMs: int
    ioMs: int
}

/** @brief Everything one run needs that is not a finding.
 *
 *  A model rather than a growing argument list: `doctorRun` was already at
 *  six positional flags and the fix engine needed seven more. Two of these
 *  (`codeFilter`, `codeSkip`) exist because a check that cannot be turned off
 *  individually cannot be adopted incrementally, and thirty checks landing in a
 *  repository at once is how a tool gets uninstalled. */
model DoctorOptions {
    dir: string
    fixMode: bool
    quiet: bool
    verbose: bool
    jsonMode: bool
    color: string
    // Apply "suggested" edits too, not only "safe" ones.
    unsafeMode: bool
    // Run the C step on every fixed file, not only the front end.
    verifyBuild: bool
    // Report what would be fixed without writing anything.
    dryRun: bool
    // Comma-separated code allowlist and denylist, "" for neither.
    codeFilter: string
    codeSkip: string
    // Findings at least this severe are printed even when filtered; "warning"
    // or "error", "" for no floor.
    minSeverity: string
    // Path to a baseline file whose entries do not fail the exit code.
    baseline: string
    // Ledger snapshot to check routes against; "" falls back to
    // $ORBIT_LEDGER_OUT, and an empty result there means the production checks
    // stay silent rather than guessing.
    telemetry: string
    // Path to the ENGINEERING.md whose latency budget D033 enforces; "" falls
    // back to ./ENGINEERING.md.
    budgetDoc: string
}

model DoctorFinding {
    file: string
    line: int
    code: string
    severity: string
    message: string
    fix: string
    // Added by the fix engine. `column` is 0 when the check has no column to
    // name, and `layer` is the §2.2 layer that produced the finding, which is
    // what makes a report groupable by where the answer came from.
    column: int
    layer: string
    edits: list
    // "safe", "suggested" or "none": what kind of fix this finding carries.
    // --fix applies safe ones by default; suggested needs --unsafe.
    fixKind: string
    // Filled in by the fix engine, never by a check: whether the edit was
    // written, and if not, why. A doctor that silently failed to fix something
    // is worse than one that never offered.
    applied: string
    verified: string
}

/** @brief One range replacement in the original source.
 *
 *  Lines are 1-based and inclusive on both ends, so `endLine == startLine` is a
 *  replacement and `endLine == startLine - 1` is a pure insertion in front of
 *  that line. Lines and not byte offsets: this is the only addressing the
 *  runtime offers reliably, it is what the existing whitespace fixes already
 *  did, and a diagnostic that names a line is a diagnostic a human can find.
 *
 *  `kind` is "safe" or "suggested" and it belongs to the EDIT, not the finding,
 *  because one fix can be safe in one place and not in another. */
model DoctorEdit {
    startLine: int
    endLine: int
    text: string
    kind: string
}

// ── The fix engine ──────────────────────────────────────────────────────────
//
// A fix is a list of range replacements applied to the ORIGINAL text, and it is
// applied only after the result has been checked. That order is the whole
// design: doctor is allowed to be wrong about a finding, and it is not allowed
// to be wrong about a file.
//
// Edits are in the token/text domain rather than on the AST on purpose. Only 10
// of the 43 AST node models carry a line and a column -- FunctionDeclNode,
// BlockNode, IfNode and RouteDeclNode among them -- so an AST-level fix would
// have to guess where a statement ends, and a range that is one line off turns
// "extract this branch" into "delete the function header". Ranges in the
// original text cannot be off: they were read off the source.
//
// A moved range carries its own comments with it, which a re-printed AST would
// drop, and the result can be handed to fmtFormatSource afterwards.

/** @brief The edits of one finding, or an empty list when it carries none. */
fn doctorEditsOf(f: DoctorFinding) -> list {
    return f.edits
}

/** @brief Whether every edit in the list may be applied without --unsafe. */
fn doctorEditsAreSafe(edits: list) -> bool {
    var i = 0
    while i < edits.len() {
        val e: DoctorEdit = edits.get(i)
        if e.kind != "safe" { return false }
        i = i + 1
    }
    return true
}

/** @brief Where each source line starts, in characters.
 *
 *  The fixes splice into THIS text by offset rather than re-joining a line
 *  list. Re-joining is the obvious implementation and it is wrong: it rewrites
 *  the line endings of every line in the file to \n, so a CRLF file silently
 *  becomes an LF file the moment you fix one trailing space on line 900. */
fn doctorLineStarts(source: string) -> list {
    val starts = []
    starts.push(0)
    val n = orbit_string_len(source)
    var i = 0
    while i < n {
        if orbit_string_char_at_selfhost(source, i) == 10 {
            starts.push(i + 1)
        }
        i = i + 1
    }
    return starts
}

/** @brief The offset a line begins at, clamped to the end of the file.
 *
 *  One past the last line is the append point, and it is a real offset: a file
 *  with no final newline still has an end we can insert in front of. */
fn doctorStartOffset(starts: list, line: int, total: int) -> int {
    if line < 1 { return 0 }
    if line > starts.len() { return total }
    return starts.get(line - 1)
}

/** @brief Sort edits by the line they touch, earliest first.
 *
 *  An insertion at line N is keyed to N, and a replacement of lines N..M to N,
 *  so two edits to the same line are adjacent after the sort and the overlap
 *  check sees both. */
fn doctorSortEdits(edits: list) -> list {
    val out = []
    var i = 0
    while i < edits.len() {
        val e: DoctorEdit = edits.get(i)
        var at = 0
        while at < out.len() {
            val o: DoctorEdit = out.get(at)
            if e.startLine < o.startLine { break }
            at = at + 1
        }
        val rest = []
        var r = 0
        while r < out.len() {
            if r != at { rest.push(out.get(r)) }
            r = r + 1
        }
        rest.push(e)
        out = rest
        i = i + 1
    }
    return out
}

/** @brief Why `edits` cannot be applied, or "" when they can.
 *
 *  Two fixes that both rewrite one line cannot both be right: whichever ran
 *  second was computed against text the first one replaced. That is a
 *  conflict to report, not a merge to guess at. */
fn doctorEditsConflict(edits: list) -> string {
    val sorted = doctorSortEdits(edits)
    var i = 0
    while i < sorted.len() {
        val a: DoctorEdit = sorted.get(i)
        val j = i + 1
        while j < sorted.len() {
            val b: DoctorEdit = sorted.get(j)
            if b.startLine <= a.endLine {
                return "two fixes both rewrite line " + orbit_int_to_string_selfhost(a.startLine)
            }
            j = j + 1
        }
        i = i + 1
    }
    return ""
}

/** @brief `source` with every edit applied, or "" when they cannot all be. */
fn doctorApplyEdits(source: string, edits: list) -> string {
    val reason = doctorEditsConflict(edits)
    if reason != "" { return "" }
    val starts = doctorLineStarts(source)
    val total = orbit_string_len(source)
    val sorted = doctorSortEdits(edits)
    val out = orbit_cbuf_create_selfhost()
    var cursor = 0
    var i = 0
    while i < sorted.len() {
        val e: DoctorEdit = sorted.get(i)
        val from = doctorStartOffset(starts, e.startLine, total)
        val to = from
        if e.endLine >= e.startLine {
            val endLine = e.endLine + 1
            if endLine <= starts.len() {
                to = starts.get(endLine - 1)
            } else {
                to = total
            }
        }
        if from < cursor { from = cursor }
        if to < from { to = from }
        if from > total { from = total }
        if to > total { to = total }
        orbit_cbuf_append_selfhost(out, orbit_string_slice(source, cursor, from))
        orbit_cbuf_append_selfhost(out, doctorEditText(source, from, to, e.text))
        cursor = to
        i = i + 1
    }
    orbit_cbuf_append_selfhost(out, orbit_string_slice(source, cursor, total))
    return orbit_cbuf_build_selfhost(out)
}

/** @brief The line ending a check should write when it appends a line.
 *
 *  A new line in a CRLF file has to end in CRLF, or one fix makes the file
 *  mixed and the next `git diff` is noise. */
fn doctorEolOf(source: string) -> string {
    val n = orbit_string_len(source)
    var i = 0
    while i < n {
        if orbit_string_char_at_selfhost(source, i) == 10 {
            if i > 0 && orbit_string_char_at_selfhost(source, i - 1) == 13 { return "\r\n" }
            return "\n"
        }
        i = i + 1
    }
    return "\n"
}

/** @brief The text an edit writes, with the line ending it displaced restored.
 *
 *  A line replacement's range includes the newline that ended it, so a fix that
 *  supplies only the line's content would join it to the next line. Rather than
 *  making every check remember to append its own ending, the engine puts back
 *  whatever the replaced range ended with -- which is also what keeps a CRLF
 *  file CRLF. */
fn doctorEditText(source: string, from: int, to: int, text: string) -> string {
    if from >= to { return text }
    val replaced = orbit_string_slice(source, from, to)
    val n = orbit_string_len(replaced)
    if n == 0 { return text }
    val last = orbit_string_char_at_selfhost(replaced, n - 1)
    var ending = ""
    if last == 10 {
        if n > 1 && orbit_string_char_at_selfhost(replaced, n - 2) == 13 { ending = "\r\n" }
        else { ending = "\n" }
    } else if last == 13 {
        ending = "\r"
    }
    if ending == "" { return text }
    if doctorEndsWithNewline(text) { return text }
    return text + ending
}

fn doctorEndsWithNewline(s: string) -> bool {
    val n = orbit_string_len(s)
    if n == 0 { return true }
    // A lone CR is not a terminator: in a CRLF file the CR belongs to the line's
    // text and the LF is what ends the line.
    return orbit_string_char_at_selfhost(s, n - 1) == 10
}

/** @brief Whether `edited` may replace `before`, and why not when it may not.
 *
 *  Returns "" when the fix is good. Anything else is the reason to refuse, and
 *  every reason here is a reason a user would rather hear than not:
 *
 *  - the ORIGINAL did not compile, so "still compiles" is not evidence of
 *    anything. Doctor does not fix files it cannot read the shape of;
 *  - the EDITED does not compile. This is the one that matters, and it is the
 *    only reason the engine is allowed to write anything at all;
 *  - with --verify-build, the EDITED does not survive the C step. The front end
 *    alone is not enough, and the four bugs this engine exists because of all
 *    passed `orbit check`: a fix that typechecks and miscompiles is worse than
 *    no fix, because it is a fix nobody re-reads.
 */
fn doctorVerifyFix(before: string, edited: string, file: string, verifyBuild: bool) -> string {
    if checkSourceWithFile(before, file) == false {
        return "skipped: this file does not pass the compiler's own checks, so a fix could not be verified"
    }
    if checkSourceWithFile(edited, file) == false {
        return "not applied: the result no longer passes the compiler's checks"
    }
    if verifyBuild {
        val tmp = orbit_os_temp_dir_selfhost() + "/orbit_doctor_fix_check"
        if compileSourceWithFile(edited, file, tmp, false) == false {
            return "not applied: the result does not compile (front end passed, C step failed)"
        }
    }
    return ""
}

/** @brief Apply every fixable finding in `edits`, and record what happened.
 *
 *  One pass per file, all findings' edits applied together, so that two fixes to
 *  different parts of one file do not each re-read a version the other has
 *  already changed. A conflict between two findings aborts both and says so,
 *  because "fixed" for one of them would be a lie about the other. */
fn doctorFixFile(stats: DoctorStats, file: string, source: string, edits: list, unsafeMode: bool, verifyBuild: bool, dryRun: bool) -> string {
    if edits.len() == 0 { return "" }
    val edited = doctorApplyEdits(source, edits)
    if edited == "" {
        return "not applied: the edits conflict (see the finding)"
    }
    if edited == source {
        return "no change"
    }
    val why = doctorVerifyFix(source, edited, file, verifyBuild)
    if why != "" { return why }
    if dryRun {
        return "would apply (dry run; not written)"
    }
    if orbit_file_write_selfhost(file, edited) == false {
        return "not applied: the file could not be written"
    }
    return "applied"
}

fn doctorSeverity(code: string) -> string {
    if code == "D001" { return "error" }
    if code == "D008" { return "error" }
    return "warning"
}

fn doctorUseColor(stats: DoctorStats) -> bool {
    if stats.color == "always" { return true }
    if stats.color == "never" { return false }
    if orbit_os_env_selfhost("NO_COLOR") != "" { return false }
    val term = orbit_os_env_selfhost("TERM")
    if term == "dumb" { return false }
    if term == "" {
        if orbit_os_env_selfhost("WT_SESSION") != "" { return true }
        if orbit_os_env_selfhost("ConEmuANSI") == "ON" { return true }
        return false
    }
    if orbit_string_indexOf(term, "color") != -1 { return true }
    if orbit_string_indexOf(term, "256") != -1 { return true }
    if orbit_string_indexOf(term, "xterm") != -1 { return true }
    if orbit_string_indexOf(term, "ansi") != -1 { return true }
    return false
}

fn doctorDisplayPath(dir: string, file: string) -> string {
    if dir == "" || dir == "." { return file }
    var prefix = dir
    val last = orbit_string_char_at_selfhost(prefix, orbit_string_len(prefix) - 1)
    if last != 47 && last != 92 {
        prefix = prefix + "/"
    }
    if orbit_string_indexOf(file, prefix) == 0 {
        return orbit_string_slice(file, orbit_string_len(prefix), orbit_string_len(file))
    }
    return file
}

fn doctorRenderText(stats: DoctorStats, dir: string, f: DoctorFinding) -> string {
    val loc = doctorDisplayPath(dir, f.file) + ":" + orbit_int_to_string_selfhost(f.line)
    if doctorUseColor(stats) == false {
        return loc + " " + f.severity + " [" + f.code + "] " + f.message + " fix: " + f.fix
    }
    var sev = f.severity
    if sev == "error" {
        sev = "\x1b[31merror\x1b[0m"
    } else {
        sev = "\x1b[33mwarning\x1b[0m"
    }
    return "\x1b[1m" + loc + "\x1b[0m " + sev + " \x1b[36m[" + f.code + "]\x1b[0m " + f.message + " fix: " + f.fix
}

// Only ever ADDS fields. The existing six are a contract: `cli_probe.py` reads
// `"code"` out of this output and an editor may read the rest, so removing or
// renaming one is a breaking change. The new ones are what makes a finding
// actionable by a machine rather than only by a reader -- an editor that knows
// the column can jump, and one that knows the edits can offer the fix.
fn doctorRenderJson(f: DoctorFinding) -> string {
    var out = "    {\"file\": \"" + doctorJsonEscape(f.file) + "\", \"line\": " + orbit_int_to_string_selfhost(f.line)
    out = out + ", \"code\": \"" + f.code + "\", \"severity\": \"" + f.severity + "\", \"message\": \"" + doctorJsonEscape(f.message) + "\", \"fix\": \"" + doctorJsonEscape(f.fix) + "\""
    out = out + ", \"column\": " + orbit_int_to_string_selfhost(f.column)
    out = out + ", \"layer\": \"" + doctorLayerOf(f.code) + "\""
    out = out + ", \"fix_kind\": \"" + f.fixKind + "\""
    out = out + ", \"applied\": \"" + doctorJsonEscape(f.applied) + "\""
    out = out + ", \"edits\": ["
    var i = 0
    while i < f.edits.len() {
        val e: DoctorEdit = f.edits.get(i)
        if i > 0 { out = out + ", " }
        out = out + "{\"start_line\": " + orbit_int_to_string_selfhost(e.startLine) + ", \"end_line\": " + orbit_int_to_string_selfhost(e.endLine) + ", \"kind\": \"" + e.kind + "\", \"text\": \"" + doctorJsonEscape(e.text) + "\"}"
        i = i + 1
    }
    out = out + "]}"
    return out
}

fn doctorJsonEscape(s: string) -> string {
    var out = ""
    var i = 0
    while i < orbit_string_len(s) {
        val c = orbit_string_char_at_selfhost(s, i)
        if c == 34 {
            out = out + "\\\""
        } else if c == 92 {
            out = out + "\\\\"
        } else if c == 10 {
            out = out + "\\n"
        } else if c == 13 {
            out = out + "\\r"
        } else if c == 9 {
            out = out + "\\t"
        } else if c < 32 {
            out = out + "?"
        } else {
            out = out + orbit_string_slice(s, i, i + 1)
        }
        i = i + 1
    }
    return out
}

model DoctorDecl {
    name: string
    kind: string
    file: string
    line: int
    isPrivate: bool
    isExtern: bool
}

model DoctorRoute {
    method: string
    rawPath: string
    normPath: string
    file: string
    line: int
}

model DoctorRouteLine {
    isRoute: bool
    method: string
    path: string
}

fn doctorReport(stats: DoctorStats, file: string, line: int, code: string, message: string, fix: string) {
    doctorReportFull(stats, file, line, 0, code, message, fix, "none", [])
}

// The same report with the parts a Layer 1 text check does not have. A check
// that knows its column, its layer, or how to fix itself says so here rather
// than being asked about it later: a fix engine that has to re-derive the
// column from the message is a fix engine that guesses.
fn doctorReportFull(stats: DoctorStats, file: string, line: int, column: int, code: string, message: string, fix: string, fixKind: string, edits: list) {
    stats.findings = stats.findings + 1
    stats.findItems.push(DoctorFinding(file, line, code, doctorSeverity(code), message, fix, column, doctorLayerOf(code), edits, fixKind, "", ""))
}

// Which of the three layers a code comes from. The §2.3-§2.5 split, so a report
// can say where an answer came from and so a new check cannot be filed into the
// wrong layer by accident.
fn doctorLayerOf(code: string) -> string {
    if code == "D002" || code == "D005" || code == "D006" || code == "D007" { return "text" }
    if code == "D001" || code == "D008" { return "io" }
    return "ast"
}

fn doctorIsWordChar(c: int) -> bool {
    if c >= 48 && c <= 57 { return true }
    if c >= 65 && c <= 90 { return true }
    if c >= 97 && c <= 122 { return true }
    if c == 95 { return true }
    return false
}

fn doctorStartsWith(s: string, prefix: string) -> bool {
    val n = orbit_string_len(s)
    val p = orbit_string_len(prefix)
    if n < p { return false }
    return orbit_string_slice(s, 0, p) == prefix
}

fn doctorEndsWithOrb(name: string) -> bool {
    val n = orbit_string_len(name)
    if n < 4 { return false }
    return orbit_string_slice(name, n - 4, n) == ".orb"
}

fn doctorJoinPath(dir: string, name: string) -> string {
    if dir == "" || dir == "." { return name }
    return dir + "/" + name
}

fn doctorTrimLeft(s: string) -> string {
    val n = orbit_string_len(s)
    var i = 0
    while i < n {
        val c = orbit_string_char_at_selfhost(s, i)
        if c == 32 || c == 9 {
            i = i + 1
        } else {
            return orbit_string_slice(s, i, n)
        }
    }
    return ""
}

fn doctorListContains(items: list, value: string) -> bool {
    var i = 0
    while i < items.len() {
        if items.get(i) == value { return true }
        i = i + 1
    }
    return false
}

fn doctorFirstLine(s: string) -> string {
    val pos = orbit_string_indexOf(s, "\n")
    if pos == -1 { return s }
    return orbit_string_slice(s, 0, pos)
}

// Collect .orb files under root, recursing into subdirectories.
// Needs only orbit_file_list_dir_selfhost: a path whose listing is
// non-empty is treated as a directory, otherwise as a file.
fn doctorCollectOrbFiles(root: string) -> list {
    var files = []
    if doctorEndsWithOrb(root) {
        files.push(root)
        return files
    }
    val dirs = []
    dirs.push(root)
    var di = 0
    while di < dirs.len() {
        val dir: string = dirs.get(di)
        val entries = orbit_file_list_dir_selfhost(dir)
        var ei = 0
        while ei < entries.len() {
            val e: string = entries.get(ei)
            val full = doctorJoinPath(dir, e)
            if doctorEndsWithOrb(e) {
                files.push(full)
            } else {
                val sub = orbit_file_list_dir_selfhost(full)
                if sub.len() > 0 {
                    dirs.push(full)
                }
            }
            ei = ei + 1
        }
        di = di + 1
    }
    return files
}

fn doctorProbeCompiler(stats: DoctorStats, cand: string, origin: string) -> bool {
    val out = orbit_os_exec_selfhost(cand + " --version")
    if out == "" { return false }
    if doctorStartsWith(out, "[ERROR") { return false }
    // Machine output must stay parseable: the toolchain line is human
    // chatter and stays out of --format json (quiet keeps it: it is the
    // D001-family evidence line, not a summary).
    if stats.jsonMode == false {
        print("toolchain: found '" + cand + "' via " + origin + " (" + doctorFirstLine(out) + ").")
    }
    return true
}

// Resolution order mirrors the compiler's own C toolchain lookup:
// ORBIT_CC first, then CC, then plain names off PATH.
fn doctorCheckToolchain(stats: DoctorStats) {
    val fromOrbit = orbit_os_env_selfhost("ORBIT_CC")
    if fromOrbit != "" {
        if doctorProbeCompiler(stats, fromOrbit, "ORBIT_CC") { return }
        doctorReport(stats, "toolchain", 1, "D001", "ORBIT_CC is set to '" + fromOrbit + "' but it did not answer '--version'.", "point ORBIT_CC at a working gcc, clang, or cc binary.")
        return
    }
    val fromCC = orbit_os_env_selfhost("CC")
    if fromCC != "" {
        if doctorProbeCompiler(stats, fromCC, "CC") { return }
        doctorReport(stats, "toolchain", 1, "D001", "CC is set to '" + fromCC + "' but it did not answer '--version'.", "point CC at a working gcc, clang, or cc binary.")
        return
    }
    if doctorProbeCompiler(stats, "gcc", "PATH") { return }
    if doctorProbeCompiler(stats, "clang", "PATH") { return }
    if doctorProbeCompiler(stats, "cc", "PATH") { return }
    doctorReport(stats, "toolchain", 1, "D001", "no C compiler answered (tried ORBIT_CC, CC, gcc, clang, cc in that order).", "install gcc or clang and add it to PATH, or set ORBIT_CC to your compiler.")
}

fn doctorIsHttpMethod(method: string) -> bool {
    if method == "GET" { return true }
    if method == "POST" { return true }
    if method == "PUT" { return true }
    if method == "PATCH" { return true }
    if method == "DELETE" { return true }
    if method == "HEAD" { return true }
    if method == "OPTIONS" { return true }
    return false
}

// Text scan keeps exact line numbers (the AST route node carries none).
fn doctorParseRouteLine(line: string) -> DoctorRouteLine {
    var cut = line
    val cpos = orbit_string_indexOf(line, "//")
    if cpos != -1 { cut = orbit_string_slice(line, 0, cpos) }
    val t = doctorTrimLeft(cut)
    if doctorStartsWith(t, "route") == false { return DoctorRouteLine(false, "", "") }
    if orbit_string_len(t) <= 5 { return DoctorRouteLine(false, "", "") }
    val c5 = orbit_string_char_at_selfhost(t, 5)
    if c5 != 32 && c5 != 9 { return DoctorRouteLine(false, "", "") }
    val rest = doctorTrimLeft(orbit_string_slice(t, 5, orbit_string_len(t)))
    var mi = 0
    while mi < orbit_string_len(rest) {
        val c = orbit_string_char_at_selfhost(rest, mi)
        if c == 32 || c == 9 { break }
        mi = mi + 1
    }
    val method = orbit_string_slice(rest, 0, mi)
    if doctorIsHttpMethod(method) == false { return DoctorRouteLine(false, "", "") }
    val rest2 = doctorTrimLeft(orbit_string_slice(rest, mi, orbit_string_len(rest)))
    if orbit_string_len(rest2) < 2 { return DoctorRouteLine(false, "", "") }
    if orbit_string_char_at_selfhost(rest2, 0) != 34 { return DoctorRouteLine(false, "", "") }
    var path = ""
    var qi = 1
    val rn = orbit_string_len(rest2)
    var found = false
    while qi < rn {
        val c = orbit_string_char_at_selfhost(rest2, qi)
        if c == 92 {
            if qi + 2 > rn { break }
            path = path + orbit_string_slice(rest2, qi, qi + 2)
            qi = qi + 2
        } else {
            if c == 34 {
                found = true
                break
            }
            path = path + orbit_string_slice(rest2, qi, qi + 1)
            qi = qi + 1
        }
    }
    if found == false { return DoctorRouteLine(false, "", "") }
    return DoctorRouteLine(true, method, path)
}

fn doctorNormSegment(seg: string) -> string {
    val n = orbit_string_len(seg)
    if n == 0 { return seg }
    val c0 = orbit_string_char_at_selfhost(seg, 0)
    if c0 == 42 { return "*" }
    if c0 == 58 { return ":param" }
    if c0 == 123 {
        if orbit_string_char_at_selfhost(seg, n - 1) == 125 { return ":param" }
    }
    return seg
}

// :id and {id} both become :param so GET /users/:id and
// GET /users/{uuid} normalize to the same shape.
fn doctorNormPath(path: string) -> string {
    var out = ""
    var start = 0
    var i = 0
    val n = orbit_string_len(path)
    var first = true
    while i <= n {
        var isEnd = false
        if i == n {
            isEnd = true
        } else {
            if orbit_string_char_at_selfhost(path, i) == 47 { isEnd = true }
        }
        if isEnd {
            val ns = doctorNormSegment(orbit_string_slice(path, start, i))
            if first {
                out = ns
                first = false
            } else {
                out = out + "/" + ns
            }
            start = i + 1
        }
        i = i + 1
    }
    return out
}

fn doctorRouteIsWildcard(norm: string) -> bool {
    if norm == "*" { return true }
    return orbit_string_indexOf(norm, "/*") != -1
}

fn doctorWildcardCovers(wild: string, specific: string) -> bool {
    if wild == "*" { return true }
    val pos = orbit_string_indexOf(wild, "/*")
    if pos == -1 { return false }
    val prefix = orbit_string_slice(wild, 0, pos)
    if specific == prefix { return true }
    return doctorStartsWith(specific, prefix + "/")
}

fn doctorCollectRoutes(lines: list, file: string, routes: list) {
    var i = 0
    while i < lines.len() {
        val rl = doctorParseRouteLine(lines.get(i))
        if rl.isRoute {
            routes.push(DoctorRoute(rl.method, rl.path, doctorNormPath(rl.path), file, i + 1))
        }
        i = i + 1
    }
}

/** @brief Checks that carry a PRODUCTION NUMBER rather than a rule.
 *
 *  Every other check reasons about the source: a name is unused, a string looks
 *  like a key. These three read a ledger snapshot -- what $ORBIT_LEDGER_OUT wrote
 *  when a service exited -- and compare it against what the source claims. The
 *  difference is the whole point, and it cuts both ways:
 *
 *    - a route the source registers but the ledger never recorded is dead code
 *      that no amount of reading the source can find, because "nobody calls it"
 *      is not the same claim as "nothing in the scanned files mentions it"
 *    - an arena overflow on one route is a leak CONFIRMED, counted, not a
 *      suspicion from reading allocations
 *    - a p99 that exceeds the budget in ENGINEERING.md is the budget being
 *      wrong about production, which is the opposite of the usual finding
 *
 *  Absent a snapshot they stay silent. Not "assume the best", but: a check that
 *  reports production problems with no production data is guessing, and a guess
 *  here would be a finding nobody can act on or refute. */
fn doctorCheckTelemetry(stats: DoctorStats, routes: list, opts: DoctorOptions) {
    val path = doctorTelemetryPath(opts)
    if path == "" { return }
    val text = orbit_file_read_selfhost(path)
    if text == "" { return }

    // A route in the source with no entry in the ledger. Compared on the
    // NORMALISED path, because the ledger keys on the template the router
    // registered and :id and {id} are the same route by then.
    var i = 0
    while i < routes.len() {
        val r: DoctorRoute = routes.get(i)
        if doctorTelemetryHasRoute(text, r.method, r.normPath) == false {
            doctorReport(stats, r.file, r.line, "D031", "route " + r.method + " " + r.path + " is registered but the ledger at " + path + " has no record of it.", "if nothing requests it, delete it; if it is only used by tests or by another service, say so here rather than leaving the snapshot to be guessed at.")
        } else {
            val overflow = doctorTelemetryNumber(text, r.method, r.normPath, "arena_overflow")
            if overflow > 0 {
                doctorReport(stats, r.file, r.line, "D032", "route " + r.method + " " + r.path + " overflowed its predicted arena " + orbit_int_to_string_selfhost(overflow) + " time(s) in the ledger at " + path + ".", "the request needed more memory than the oracle predicted; either the prediction is too tight for this route or the handler allocates per request what it could reuse.")
            }
            val p99 = doctorTelemetryNumber(text, r.method, r.normPath, "p99_us")
            val budget = doctorLatencyBudgetUs(opts)
            if budget > 0 && p99 > budget {
                doctorReport(stats, r.file, r.line, "D033", "route " + r.method + " " + r.path + " has a measured p99 of " + orbit_int_to_string_selfhost(p99) + " us, over the " + orbit_int_to_string_selfhost(budget) + " us budget in ENGINEERING.md.", "the budget is a claim about production and this is production disagreeing with it: fix the route, or change the budget and say why it moved.")
            }
        }
        i = i + 1
    }
}

/** @brief Where the telemetry snapshot is, or "" when there is none.
 *
 *  An explicit flag beats an environment variable: a doctor run whose findings
 *  depend on a snapshot has to be able to say WHICH snapshot, or two runs of the
 *  same command disagree with no visible difference. */
fn doctorTelemetryPath(opts: DoctorOptions) -> string {
    if opts.telemetry != "" { return opts.telemetry }
    return orbit_os_env_selfhost("ORBIT_LEDGER_OUT")
}

/** @brief The p99 budget in microseconds, from ENGINEERING.md, or 0.
 *
 *  Read from the document rather than hard-coded here, so the budget and the
 *  check cannot drift apart. A missing or unparseable budget yields 0, which
 *  disables D033 instead of guessing a threshold -- a check with no stated
 *  budget has no business inventing one. */
fn doctorLatencyBudgetUs(opts: DoctorOptions) -> int {
    val doc = orbit_file_read_selfhost(opts.budgetDoc)
    if doc == "" {
        // Fall back to the working directory, so running from inside the repo (the
        // normal case) needs no flag, while the golden runner -- which runs each
        // case from a throwaway directory -- can point at the repo's copy.
        val here = orbit_file_read_selfhost("ENGINEERING.md")
        if here == "" { return 0 }
        return doctorLatencyBudgetFrom(here)
    }
    return doctorLatencyBudgetFrom(doc)
}

/** @brief The p99 budget in microseconds out of an ENGINEERING.md, or 0.
 *
 *  Split out so both the flag path and the cwd fallback share one parser. The
 *  cell reads "<= 2 ms at 500K RPS sustained"; the first number and its unit are
 *  the budget, and anything richer is not parseable without guessing. */
fn doctorLatencyBudgetFrom(doc: string) -> int {
    if doc == "" { return 0 }
    val marker = "| Latency P99 |"
    val at = orbit_string_indexOf(doc, marker)
    if at == -1 { return 0 }
    val lineEnd = orbit_string_indexOf(orbit_string_slice(doc, at, orbit_string_len(doc)), "\n")
    if lineEnd == -1 { return 0 }
    val line = orbit_string_slice(doc, at, at + lineEnd)
    // The cell reads "<= 2 ms at 500K RPS sustained". Take the first number and
    // its unit; anything richer than that is not parseable without guessing.
    val atMs = orbit_string_indexOf(line, " ms")
    if atMs == -1 { return 0 }
    val numEnd = atMs
    var numStart = numEnd
    while numStart > 0 {
        val c = orbit_string_char_at_selfhost(line, numStart - 1)
        if c >= 48 && c <= 57 { numStart = numStart - 1 }
        else { break }
    }
    if numEnd <= numStart { return 0 }
    val numText = orbit_string_slice(line, numStart, numEnd)
    val ms = doctorLeadingDigits(numText)
    if ms == 0 { return 0 }
    return ms * 1000
}

/** @brief The first index at or after `from` that is not a space.
 *
 *  JSON does not promise anything about the space after a colon, and the two
 *  writers of this file already differ: the runtime emits no space and a
 *  hand-written fixture usually has one. A parser that assumed the runtime's
 *  spacing silently found nothing in every fixture, and the fixture is how the
 *  check gets tested. */
fn doctorSkipSpace(s: string, from: int) -> int {
    var i = from
    val n = orbit_string_len(s)
    while i < n {
        val c = orbit_string_char_at_selfhost(s, i)
        if c == 32 || c == 9 { i = i + 1 }
        else { break }
    }
    return i
}

/** @brief The integer at the start of `s`, or 0. */
fn doctorLeadingDigits(s: string) -> int {
    var acc = 0
    var i = 0
    val n = orbit_string_len(s)
    while i < n {
        val c = orbit_string_char_at_selfhost(s, i)
        if c >= 48 && c <= 57 {
            acc = acc * 10 + (c - 48)
        } else {
            break
        }
        i = i + 1
    }
    return acc
}

/** @brief The object for `method path` in the snapshot, or "" when absent.
 *
 *  Matching on the PATH alone and then reading the object it sits in, rather than
 *  on the whole `"method": ..., "path": ...` prefix. Whitespace after a colon is
 *  not specified by JSON, and the two producers of this file already disagree:
 *  the runtime writes `"path":"/x"` and a hand-written fixture usually writes
 *  `"path": "/x"`. Pinning the spacing made the check silently find nothing in
 *  every fixture, and the fixtures are how the check is tested.
 *
 *  The quotes around the path are what make it safe: `"path": "/a"` cannot match
 *  inside `"path": "/a/b"`, because the closing quote of the needle would have to
 *  be a character that is not there. The method is verified afterwards rather
 *  than in the needle, for the same reason.
 *
 *  A substring search over the raw JSON rather than a parser, because the shape
 *  of this file is pinned by runtime/test_ledger_percentiles.c -- the risky half,
 *  being wrong about what the producer emits, is covered there. A JSON parser
 *  written in Orbit would be several hundred new lines to read five numbers. */
fn doctorTelemetryObject(text: string, method: string, path: string) -> string {
    // Every "path" key has to be tried, not just the first: with two routes in
    // the snapshot the first match is route one, and a linear search that stops
    // there reports the SECOND route as never requested while saying nothing
    // about the first. The scan is bounded by the route count, which is 64.
    val key = "\"path\":"
    var from = 0
    var guard = 0
    while guard < 4096 {
        guard = guard + 1
        val at = orbit_string_indexOf(orbit_string_slice(text, from, orbit_string_len(text)), key)
        if at == -1 { return "" }
        val keyAt = from + at
        val vs = doctorSkipSpace(text, keyAt + orbit_string_len(key))
        if orbit_string_char_at_selfhost(text, vs) != 34 { from = keyAt + orbit_string_len(key) }
        else {
            val needle = path + "\""
            val afterQuote = orbit_string_slice(text, vs + 1, orbit_string_len(text))
            if doctorStartsWith(afterQuote, needle) {
                // Found this route. Walk back to the object's opening brace so the
                // method can be checked inside THIS object rather than guessed
                // from the surrounding text.
                var open = vs + 1
                while open > 0 {
                    if orbit_string_char_at_selfhost(text, open) == 123 { break }
                    open = open - 1
                }
                if orbit_string_char_at_selfhost(text, open) == 123 {
                    val rest = orbit_string_slice(text, open, orbit_string_len(text))
                    val close = orbit_string_indexOf(rest, "}")
                    if close != -1 {
                        val obj = orbit_string_slice(rest, 0, close)
                        val wantMethod = "\"method\":"
                        val at2 = orbit_string_indexOf(obj, wantMethod)
                        if at2 != -1 {
                            val ms = doctorSkipSpace(obj, at2 + orbit_string_len(wantMethod))
                            if orbit_string_char_at_selfhost(obj, ms) == 34 {
                                val me = orbit_string_indexOf(orbit_string_slice(obj, ms + 1, orbit_string_len(obj)), "\"")
                                if me != -1 {
                                    val found = orbit_string_slice(obj, ms + 1, ms + 1 + me)
                                    // Same method AND same path is a hit. The path
                                    // alone would let GET /x match a POST /x row.
                                    if found == method { return obj }
                                }
                            }
                        }
                    }
                }
            }
            from = keyAt + orbit_string_len(key)
        }
    }
    return ""
}

/** @brief Whether the snapshot has a record for this route. */
fn doctorTelemetryHasRoute(text: string, method: string, path: string) -> bool {
    return doctorTelemetryObject(text, method, path) != ""
}

/** @brief One number out of a route's snapshot object, or 0 when absent.
 *
 *  0 for a missing key, which is the honest answer: no recorded overflow, no
 *  recorded p99. Both checks treat 0 as "nothing to report" rather than "zero
 *  violations measured on a service that may not have run". */
fn doctorTelemetryNumber(text: string, method: string, path: string, key: string) -> int {
    val obj = doctorTelemetryObject(text, method, path)
    if obj == "" { return 0 }
    val needle = "\"" + key + "\":"
    val at = orbit_string_indexOf(obj, needle)
    if at == -1 { return 0 }
    val start = doctorSkipSpace(obj, at + orbit_string_len(needle))
    return doctorLeadingDigits(orbit_string_slice(obj, start, orbit_string_len(obj)))
}

/** @brief Mutable routes with no guard and no validation before they return.
 *
 *  A POST/PUT/PATCH/DELETE that returns without asking who is asking, or
 *  whether the request makes sense, is the shape of an unauthenticated write.
 *  The check is deliberately textual and block-local: it looks at the lines
 *  between the route's opening brace and the closing brace at the same
 *  indentation, and stops at the first return, because a guard AFTER the write
 *  has already lost the race.
 *
 *  What counts as a guard is the runtime's own vocabulary -- orbit_auth_*,
 *  req.body, a validation `if` that returns early -- rather than a guess about
 *  the author's naming. A service that guards through a helper it calls is not
 *  visible to a text scan, so this under-reports by construction: the failure
 *  mode of the opposite would be a finding on every correctly-guarded route,
 *  which is how a check gets switched off. */
fn doctorScanMutableRoutes(stats: DoctorStats, lines: list, file: string) {
    var i = 0
    while i < lines.len() {
        val rl = doctorParseRouteLine(lines.get(i))
        i = i + 1
        if rl.isRoute == false {}
        if rl.isRoute && doctorIsMutableMethod(rl.method) {
            val indent = doctorIndentOf(lines.get(i - 1))
            var guarded = false
            var j = i
            while j < lines.len() {
                val line = lines.get(j)
                if line == "}" {}
                if doctorTrimSpace(line) == "}" && doctorIndentOf(line) == indent {
                    // end of the route block
                    if guarded == false {
                        doctorReport(stats, file, i, "D011", "mutable route " + rl.method + " " + rl.path + " returns without a role guard or a request validation block.", "check the caller before the write: an authenticated role, or an early return on a malformed request.")
                    }
                    break
                }
                if guarded == false && doctorLooksLikeGuard(line) { guarded = true }
                j = j + 1
            }
        }
    }
}

/** @brief Whether this method changes state, so it needs a guard. */
fn doctorIsMutableMethod(method: string) -> bool {
    if method == "POST" { return true }
    if method == "PUT" { return true }
    if method == "PATCH" { return true }
    if method == "DELETE" { return true }
    return false
}

/** @brief Leading spaces of a line, as a count. Used to find a block's end. */
fn doctorIndentOf(line: string) -> int {
    var n = 0
    val len = orbit_string_len(line)
    while n < len {
        val c = orbit_string_char_at_selfhost(line, n)
        if c == 32 || c == 9 { n = n + 1 }
        else { break }
    }
    return n
}

/** @brief Whether a line does the work a guard would do.
 *
 *  The runtime's guard vocabulary: an auth call, reading the request, or an
 *  early-returning validation. Checking for these names rather than trying to
 *  reason about control flow is what keeps the check from inventing findings on
 *  routes that are correctly guarded through a helper. */
fn doctorLooksLikeGuard(line: string) -> bool {
    val code = doctorCodePart(line)
    if doctorContainsWord(code, "orbit_auth_has_role") { return true }
    if doctorContainsWord(code, "orbit_auth_current_role") { return true }
    if doctorContainsWord(code, "orbit_auth_bearer_token") { return true }
    if doctorContainsWord(code, "req.body") { return true }
    if doctorContainsWord(code, "req.query") { return true }
    if doctorContainsWord(code, "req.param") { return true }
    if doctorContainsWord(code, "http_param_get") { return true }
    // An `if` that returns early is validation: reject the malformed case before
    // the write. A bare `if` is not, because it may be an optimisation.
    if doctorStartsWith(doctorTrimSpace(code), "if ") {
        return true
    }
    return false
}

/** @brief D014 N+1 and D015 loop-bound string building, on one pass.
 *
 *  Both are questions about WHERE a statement sits inside a loop, and tracking
 *  loop nesting by indentation answers both from the same walk. The nesting is
 *  recomputed from the start of the file at each candidate rather than
 *  incremented: a brace counter that is off by one reports the wrong lines, and
 *  recounting is O(file) only at the few places a finding can appear.
 */
fn doctorScanLoops(stats: DoctorStats, lines: list, file: string) {
    val stringNames = doctorStringDecls(lines)
    var i = 0
    while i < lines.len() {
        val code = doctorTrimSpace(doctorCodePart(lines.get(i)))
        val line = i + 1
        if doctorLoopKeyword(code) {
            if doctorLoopContainsDb(lines, i) {
                doctorReport(stats, file, line, "D014", "a database query sits inside this loop, so it runs once per iteration.", "fetch the rows once before the loop, or batch the query; this is the N+1 shape and its cost grows with the row count.")
            }
            // D015 looks INSIDE the loop body, not at the header: the concat is
            // on a line between the loop keyword and its closing brace.
            if doctorLoopConcatGrowsWithSource(lines, i, stringNames) {
                doctorReport(stats, file, line, "D015", "a value is built by string concatenation inside this loop, so the whole prefix is copied every iteration.", "accumulate into a list and join once after the loop.")
            }
        }
        i = i + 1
    }
    doctorScanMagicNumbers(stats, lines, file)
}

/** @brief Whether a line opens a loop. */
fn doctorLoopKeyword(code: string) -> bool {
    if doctorStartsWith(code, "while ") { return true }
    if doctorStartsWith(code, "for ") { return true }
    if doctorStartsWith(code, "loop ") { return true }
    if code == "loop" { return true }
    return false
}

/** @brief Whether the code calls the database. */

fn doctorIsDbCall(code: string) -> bool {
    // Substring, not whole-word: the needle is a PREFIX of a longer name
    // (orbit_db_query_all ends in _all), and doctorContainsWord's right-hand
    // boundary check sees that underscore as a word character and rejects it.
    if orbit_string_indexOf(code, "orbit_db_query") != -1 { return true }
    if orbit_string_indexOf(code, "orbit_db_insert") != -1 { return true }
    if orbit_string_indexOf(code, "orbit_db_delete") != -1 { return true }
    return false
}

/** @brief Whether a db call appears inside the loop opened at `start`.
 *
 *  Scans forward to the loop's own closing brace, found by indentation. Bounded
 *  by the file length and stopped at that one brace, so it cannot walk into the
 *  next function.
 */
fn doctorLoopContainsDb(lines: list, start: int) -> bool {
    val baseIndent = doctorIndentOf(lines.get(start))
    var i = start + 1
    var guard = 0
    while i < lines.len() {
        guard = guard + 1
        if guard > 4096 { return false }
        val code = doctorTrimSpace(doctorCodePart(lines.get(i)))
        if code == "}" && doctorIndentOf(lines.get(i)) == baseIndent { return false }
        if doctorIsDbCall(code) { return true }
        i = i + 1
    }
    return false
}

/** @brief Whether the concatenation accumulates a WHOLE ELEMENT per iteration.
 *
 *  `for name in items { out = out + name }` is the quadratic shape: the prefix
 *  grows by an element and is recopied every time. `while i < items.len() { out =
 *  out + items.get(i) }` is the same cost, and is what 19 of the findings in
 *  std/ and tests/suite/ were -- an index loop over a collection, not a counter.
 *
 *  Both are real. What is NOT the finding is a loop that concatenates something
 *  whose size does not grow with the iteration count, which is what a plain
 *  `i = i + 1` counter loop looks like. So the test is whether the accumulated
 *  expression READS from the loop's own source. */
fn doctorLoopConcatGrowsWithSource(lines: list, start: int, stringNames: list) -> bool {
    val header = doctorTrimSpace(doctorCodePart(lines.get(start)))
    // The name being iterated: the `for` binding, or the collection in the bound.
    // What growing-with-the-iteration looks like on the concatenated line. For a
    // `for name in names` the body reads the BINDING (`out + name`), not the
    // collection (`out + names`), so the binding is the subject. For an index
    // loop the body reads the collection (`out + items.get(i)`), so that is.
    var subject = ""
    var binding = ""
    val inAt = orbit_string_indexOf(header, " in ")
    if inAt != -1 {
        binding = doctorLeadingName(orbit_string_slice(header, 4, inAt))
        subject = doctorLeadingName(doctorTrimSpace(orbit_string_slice(header, inAt + 4, orbit_string_len(header))))
    } else {
        val lt = orbit_string_indexOf(header, "<")
        if lt == -1 { return false }
        val bound = doctorTrimSpace(orbit_string_slice(header, lt + 1, orbit_string_len(header)))
        val dot = orbit_string_indexOf(bound, ".")
        if dot > 0 { subject = orbit_string_slice(bound, 0, dot) }
    }
    if subject == "" { return false }
    val bindingIsSubject = binding != ""
    val baseIndent = doctorIndentOf(lines.get(start))
    var i = start + 1
    var guard = 0
    while i < lines.len() {
        guard = guard + 1
        if guard > 4096 { return false }
        val raw = lines.get(i)
        val code = doctorTrimSpace(doctorCodePart(raw))
        if code == "}" && doctorIndentOf(raw) == baseIndent { return false }
        if doctorIsSelfConcat(code, stringNames) {
            // Does the accumulated value read the thing being iterated? Either
            // the collection itself, or -- for a `for` loop -- its binding.
            if orbit_string_indexOf(code, subject) != -1 { return true }
            if bindingIsSubject {
                // Whole-word match, not a trailing space: `out + name` ends the
                // line, so `binding + " "` never appears in it.
                if doctorContainsWord(code, binding) { return true }
            }
        }
        i = i + 1
    }
    return false
}

/** @brief Whether a line accumulates one name into itself by +.
 *
 *  AND that the accumulation is of STRINGS. `sum = sum + l.get(i)` over a list
 *  of ints is the same shape and costs nothing -- a fixed-width integer add --
 *  and reporting it put integer sums in a finding whose text says "string is
 *  built by concatenation". The evidence is the declared type of the
 *  accumulator, from its `val`/`var` declaration in this file.
 *
 *  No declaration, no finding. An accumulator whose type cannot be seen is
 *  assumed NOT to be a string, because the alternative -- report every self-add
 *  in a loop -- is 6 findings in std/ that are all arithmetic. */
fn doctorIsSelfConcat(code: string, declIndex: list) -> bool {
    if orbit_string_indexOf(code, " + ") == -1 { return false }
    val eq = orbit_string_indexOf(code, " = ")
    if eq == -1 { return false }
    val lhs = doctorLeadingName(doctorTrimSpace(orbit_string_slice(code, 0, eq)))
    if lhs == "" { return false }
    val rhs = doctorTrimSpace(orbit_string_slice(code, eq + 3, orbit_string_len(code)))
    if doctorStartsWith(rhs, lhs + " ") == false { return false }
    return doctorDeclaredAsString(lhs, declIndex)
}

/** @brief Whether a declaration's initialiser is a string literal.
 *
 *  `val out = ""` and `val s = "x" + y` are strings by inspection. A `val s = 0`
 * is not, and neither is one initialised from a function call, whose type this
 *  cannot see -- guessing there is how an integer accumulator ends up reported
 *  as a string. */
fn doctorInitialisesString(rest: string) -> bool {
    val eq = orbit_string_indexOf(rest, " = ")
    if eq == -1 { return false }
    val rhs = doctorTrimSpace(orbit_string_slice(rest, eq + 3, orbit_string_len(rest)))
    // Length, not equality with "": `val out = ""` has a rhs of TWO quote
    // characters, and comparing it to the empty string to mean "no initialiser"
    // is a test that a real empty-string initialiser does not pass.
    if orbit_string_len(rhs) == 0 { return false }
    if orbit_string_char_at_selfhost(rhs, 0) == 34 { return true }
    return false
}

/** @brief Whether `name` is declared `string` somewhere in this file.
 *
 *  Index built once per file by doctorStringDecls. `list<string>` counts: a list
 *  of strings concatenated element by element is still string building. */
fn doctorDeclaredAsString(name: string, declIndex: list) -> bool {
    var i = 0
    while i < declIndex.len() {
        val e: string = declIndex.get(i)
        if e == name { return true }
        i = i + 1
    }
    return false
}

/** @brief The names this file declares as string, for doctorIsSelfConcat.
 *
 *  Scans `val`/`var` declarations and keeps the ones whose type mentions string.
 *  Text-level because the alternative is a scope-tracking pass over the AST for
 *  one type question. */
fn doctorStringDecls(lines: list) -> list {
    val out = []
    var i = 0
    while i < lines.len() {
        // The RAW line, not doctorCodePart: this check asks whether the
        // initialiser IS a string literal, and codePart deletes literal contents,
        // which turned `val out = ""` into `val out = ` and made the empty string
        // invisible. Comments are stripped separately so a commented-out
        // declaration still does not count.
        var code = doctorTrimSpace(lines.get(i))
        val cpos = orbit_string_indexOf(code, "//")
        if cpos != -1 { code = doctorTrimSpace(orbit_string_slice(code, 0, cpos)) }
        var rest = ""
        if doctorStartsWith(code, "val ") {
            rest = doctorTrimSpace(orbit_string_slice(code, 4, orbit_string_len(code)))
        }
        if doctorStartsWith(code, "var ") {
            rest = doctorTrimSpace(orbit_string_slice(code, 4, orbit_string_len(code)))
        }
        if rest != "" {
            val nm = doctorLeadingName(rest)
            if nm != "" {
                // Two kinds of evidence, because a string accumulator is
                // usually not annotated: an explicit `string` or `list<string>`
                // type, or an initialiser that IS a string. `val out = ""` is
                // the commonest way to write it and says as much as a type would.
                val typedAsString = doctorContainsFold(rest, "string")
                val initialisedFromString = doctorInitialisesString(rest)
                if typedAsString || initialisedFromString {
                    if doctorListContains(out, nm) == false { out.push(nm) }
                }
            }
        }
        i = i + 1
    }
    return out
}

/** @brief A repeated, uninformative integer literal used as a bound.
 *
 *  All three have to hold, which is why this does not fire on every number: the
 *  number is three or more digits, the name it is bound to says nothing about
 *  what it means, and the same number-and-name pair appeared earlier in the
 *  file. A number that appears once is a number the author chose; a number that
 *  appears twice under the same vague name is a constant pretending to be a
 *  local. */
fn doctorScanMagicNumbers(stats: DoctorStats, lines: list, file: string) {
    val seen = []
    var i = 0
    while i < lines.len() {
        val code = doctorCodePart(lines.get(i))
        val j = doctorFirstBigNumber(code, 0)
        while j > 0 {
            val num = doctorNumberAt(code, j)
            val name = doctorMagicOwnerName(code, j)
            if num != "" && name != "" {
                if doctorIsVagueName(name) {
                    doctorRememberMagic(seen, num, name, file, i + 1, stats)
                }
            }
            j = doctorNextBigNumber(code, j + orbit_string_len(num))
        }
        i = i + 1
    }
}

/** @brief The offset of the first run of 3+ digits at or after `from`, or -1. */
fn doctorFirstBigNumber(code: string, from: int) -> int {
    return doctorNextBigNumber(code, from)
}

/** @brief The offset of the next run of 3+ digits at or after `from`, or -1. */
fn doctorNextBigNumber(code: string, from: int) -> int {
    val n = orbit_string_len(code)
    var j = from
    while j < n {
        val c = orbit_string_char_at_selfhost(code, j)
        if c >= 48 && c <= 57 {
            val start = j
            var digits = 0
            var k = j
            while k < n {
                val d = orbit_string_char_at_selfhost(code, k)
                if d >= 48 && d <= 57 {
                    digits = digits + 1
                    k = k + 1
                } else {
                    break
                }
            }
            if digits >= 3 { return start }
            j = k
        } else {
            j = j + 1
        }
    }
    return -1
}

/** @brief The run of digits beginning at `at`. */
fn doctorNumberAt(code: string, at: int) -> string {
    val n = orbit_string_len(code)
    var k = at
    while k < n {
        val d = orbit_string_char_at_selfhost(code, k)
        if d >= 48 && d <= 57 { k = k + 1 }
        else { break }
    }
    if k <= at { return "" }
    return orbit_string_slice(code, at, k)
}

/** @brief The identifier the number at `at` is compared against or assigned to. */
fn doctorMagicOwnerName(code: string, at: int) -> string {
    val before = doctorTrimSpace(orbit_string_slice(code, 0, at))
    // A declaration owns its own literal: `val limit = 86400`.
    if doctorStartsWith(before, "val ") {
        return doctorLeadingName(doctorTrimSpace(orbit_string_slice(before, 4, orbit_string_len(before))))
    }
    if doctorStartsWith(before, "var ") {
        return doctorLeadingName(doctorTrimSpace(orbit_string_slice(before, 4, orbit_string_len(before))))
    }
    // In a comparison the literal is on the RIGHT of the operator, so the owner
    // is the word after it, not the one before. Reading the left side gave `n` for
    // `if n > limit` and `n` is not vague, so nothing was ever reported.
    val after = doctorTrimSpace(orbit_string_slice(code, at, orbit_string_len(code)))
    return doctorLeadingName(doctorTrimAfterOperator(after))
}

/** @brief The first identifier in `s` that is not a comparison operator. */
fn doctorTrimAfterOperator(s: string) -> string {
    var i = 0
    val n = orbit_string_len(s)
    var word = ""
    while i < n {
        val c = orbit_string_char_at_selfhost(s, i)
        if doctorIsWordChar(c) {
            word = word + orbit_string_slice(s, i, i + 1)
            i = i + 1
        } else {
            break
        }
    }
    return word
}

/** @brief Whether a name says nothing about the number it holds. */
fn doctorIsVagueName(name: string) -> bool {
    val vague = ["limit", "max", "min", "count", "size", "len", "value", "num", "threshold", "cap", "bound"]
    var i = 0
    while i < vague.len() {
        val v: string = vague.get(i)
        if doctorStartsWith(name, v) { return true }
        i = i + 1
    }
    return false
}

/** @brief Record a magic number and report it only on its second sighting. */
fn doctorRememberMagic(seen: list, num: string, name: string, file: string, line: int, stats: DoctorStats) {
    // Keyed on the NUMBER, not on number-and-name. The same timeout written
    // under two vague names is one constant hiding in two places, and keying on
    // the pair reported neither. A number that appears once is a number the
    // author chose, so it stays silent.
    var i = 0
    while i < seen.len() {
        val e: string = seen.get(i)
        if e == num {
            doctorReport(stats, file, line, "D016", "the bare number " + num + " appears again here, under '" + name + "', after appearing earlier in this file.", "hoist it to one named constant that says what it is -- a timeout in ms, a page size, a byte count -- so the value is stated once and has a name.")
            return
        }
        i = i + 1
    }
    seen.push(num)
}

/** @brief The statements a node carries, as a list to walk.
 *
 *  A function body is a Block ASTNode, not a list. The schema in ast.orb now
 *  says `body: ASTNode` -- matching IfNode, and matching the parser, which has
 *  always handed parseBlock()'s single ASTNode to that field. Five models
 *  declared it `list`, and `.len()` on the result read a model pointer as a list
 *  header: -1184889136 for a one-statement body, while params, paramTypes and
 *  genericParams beside it were all correct. Same model, same field type, wrong
 *  offset. That is the ASTBODYLEN known defect.
 *
 *  The Block is unwrapped here, once. Nothing outside this file and sema.orb's
 *  checkNode ever measures one.
 */
fn doctorStmtsOf(node: ASTNode) -> list {
    var stmts = []
    match node {
        ASTNode.FunctionDecl(f) => {
            match f.body {
                ASTNode.Block(b) => { stmts = b.statements }
                _ => {}
            }
        }
        ASTNode.RouteDecl(r) => {
            match r.body {
                ASTNode.Block(b) => { stmts = b.statements }
                _ => {}
            }
        }
        ASTNode.While(w) => {
            match w.body {
                ASTNode.Block(b) => { stmts = b.statements }
                _ => {}
            }
        }
        ASTNode.For(fo) => {
            match fo.body {
                ASTNode.Block(b) => { stmts = b.statements }
                _ => {}
            }
        }
        ASTNode.MatchCase(c) => {
            // `1 => doThing()` parses the arm body as a bare statement, not a
            // block. Unwrapping only the Block shape made every braceless arm
            // invisible, which is the more common way people write short arms.
            match c.body {
                ASTNode.Block(b) => { stmts = b.statements }
                _ => { stmts.push(c.body) }
            }
        }
        ASTNode.Block(b) => { stmts = b.statements }
        _ => {}
    }
    return stmts
}

/** @brief Element `i` of a node list, pinned to ASTNode.
 *
 *  `nodes.get(i)` on a bare `list` returns a value the backend has to cast to
 *  some model, and it has no way to know which. Handing the result to a function
 *  whose parameter is ASTNode is what makes the cast correct.
 */
fn doctorNodeAt(nodes: list, i: int) -> ASTNode {
    return nodes.get(i)
}

/** @brief D017 complexity, D018 recursion without tail calls, D019 allocation in a loop.
 *
 *  One walk per function declaration, because all three need the same subtree.
 *
 *  Every access goes through doctorStmtsOf or a `match`. Reading a declaration's
 *  fields directly is what produced the garbage lengths this file spent a while
 *  working around, and sema.orb's checkNode is the shape that works.
 */
fn doctorScanFunctions(stats: DoctorStats, node: ASTNode, file: string, lines: list) {
    match node {
        ASTNode.Program(p) => {
            var i = 0
            val decls = p.decls
            while i < decls.len() {
                doctorScanFunctions(stats, doctorNodeAt(decls, i), file, lines)
                i = i + 1
            }
        }
        ASTNode.FunctionDecl(f) => {
            doctorCheckComplexity(stats, node, f.name, file, lines)
            doctorCheckRecursion(stats, node, f.name, file, lines)
            doctorCheckLoopAllocs(stats, node, f.name, file, lines)
        }
        _ => {}
    }
}

/** @brief Cyclomatic complexity: 1 + one per decision point.
 *
 *  Base 1 plus one per `if`, `while`, `for`, each match arm and each `try`, which
 *  is the count ENGINEERING.md specifies. Thresholds: to 10 passes, 11 to 20 is a
 *  warning, over 20 is an error. Over the error threshold means more independent
 *  paths through the function than one reviewer can hold at once, and that is
 *  worth failing on rather than noting.
 */
fn doctorCheckComplexity(stats: DoctorStats, node: ASTNode, fnName: string, file: string, lines: list) {
    val body = doctorStmtsOf(node)
    var complexity = 1
    var i = 0
    while i < body.len() {
        complexity = complexity + doctorDecisionPoints(doctorNodeAt(body, i))
        i = i + 1
    }
    val line = doctorFindDeclLine(lines, "fn", fnName)
    if complexity > 20 {
        doctorReport(stats, file, line, "D017", "fn " + fnName + " has a cyclomatic complexity of " + orbit_int_to_string_selfhost(complexity) + ", over the safe limit of 20.", "extract the branches into functions of their own; a path count this high is not reviewable, and it is usually one function doing three jobs.")
    } else {
        if complexity > 10 {
            doctorReport(stats, file, line, "D017", "fn " + fnName + " has a cyclomatic complexity of " + orbit_int_to_string_selfhost(complexity) + ".", "consider extracting sub-functions; above 10 the branches stop being independently checkable.")
        }
    }
}

/** @brief Decision points in one subtree. */
fn doctorDecisionPoints(node: ASTNode) -> int {
    var n = 0
    match node {
        ASTNode.If(x) => { n = 1 }
        ASTNode.Try(x) => { n = 1 }
        ASTNode.Match(x) => {
            val cases = x.cases
            n = cases.len()
        }
        ASTNode.Block(b) => {
            val stmts = b.statements
            var i = 0
            while i < stmts.len() {
                n = n + doctorDecisionPoints(doctorNodeAt(stmts, i))
                i = i + 1
            }
        }
        ASTNode.MatchCase(c) => {
            val stmts = doctorStmtsOf(node)
            var i = 0
            while i < stmts.len() {
                n = n + doctorDecisionPoints(doctorNodeAt(stmts, i))
                i = i + 1
            }
        }
        ASTNode.While(w) => {
            n = 1
            val stmts = doctorStmtsOf(node)
            var i = 0
            while i < stmts.len() {
                n = n + doctorDecisionPoints(doctorNodeAt(stmts, i))
                i = i + 1
            }
        }
        ASTNode.For(fo) => {
            n = 1
            val stmts = doctorStmtsOf(node)
            var i = 0
            while i < stmts.len() {
                n = n + doctorDecisionPoints(doctorNodeAt(stmts, i))
                i = i + 1
            }
        }
        ASTNode.FunctionDecl(f) => {
            val stmts = doctorStmtsOf(node)
            var i = 0
            while i < stmts.len() {
                n = n + doctorDecisionPoints(doctorNodeAt(stmts, i))
                i = i + 1
            }
        }
        ASTNode.RouteDecl(r) => {
            val stmts = doctorStmtsOf(node)
            var i = 0
            while i < stmts.len() {
                n = n + doctorDecisionPoints(doctorNodeAt(stmts, i))
                i = i + 1
            }
        }
        ASTNode.ExpressionStmt(e) => { n = doctorDecisionPoints(e.expr) }
        ASTNode.Assignment(a) => {
            n = doctorDecisionPoints(a.target)
            n = n + doctorDecisionPoints(a.value)
        }
        ASTNode.Return(r) => { n = doctorDecisionPoints(r.expr) }
        ASTNode.ReturnOk(r) => { n = doctorDecisionPoints(r.expr) }
        ASTNode.ReturnErr(r) => { n = doctorDecisionPoints(r.expr) }
        ASTNode.VarDecl(v) => { n = doctorDecisionPoints(v.value) }
        ASTNode.Call(c) => {
            val args = c.args
            var i = 0
            while i < args.len() {
                n = n + doctorDecisionPoints(doctorNodeAt(args, i))
                i = i + 1
            }
        }
        ASTNode.BinaryOp(b) => {
            n = doctorDecisionPoints(b.lhs)
            n = n + doctorDecisionPoints(b.rhs)
        }
        ASTNode.UnaryOp(u) => { n = doctorDecisionPoints(u.operand) }
        ASTNode.IndexAccess(ix) => { n = doctorDecisionPoints(ix.index) }
        ASTNode.MemberAccess(m) => { n = doctorDecisionPoints(m.object) }
        ASTNode.ListLiteral(l) => {
            val els = l.elements
            var i = 0
            while i < els.len() {
                n = n + doctorDecisionPoints(doctorNodeAt(els, i))
                i = i + 1
            }
        }
        _ => {}
    }
    return n
}

/** @brief A recursive function whose recursive call is not the value it returns.
 *
 *  Tail position means the call IS the returned value: `return self(n - 1)` is
 *  tail, `return 1 + self(n - 1)` is not, and neither is `val r = self(n); return
 *  r`. The second shape holds a frame per level, so a deep input exhausts the
 *  stack under load rather than under a test.
 *
 *  Only self-recursion is followed. A mutual cycle is real, but blaming the right
 *  member of it needs a call graph doctor does not have here, and guessing which
 *  member to name would be worse than silence.
 */
fn doctorCheckRecursion(stats: DoctorStats, node: ASTNode, fnName: string, file: string, lines: list) {
    val body = doctorStmtsOf(node)
    if doctorCallsName(body, fnName) == false { return }
    if doctorHasTailSelfCall(body, fnName) { return }
    doctorReport(stats, file, doctorFindDeclLine(lines, "fn", fnName), "D018", "fn " + fnName + " calls itself, but the call is not the value it returns.", "make the recursive call the whole of a return, so the frame is released before the next call; otherwise a deep input exhausts the stack under sustained load rather than under a test.")
}

/** @brief Whether any statement in a body calls `name`. */
fn doctorCallsName(body: list, name: string) -> bool {
    var i = 0
    while i < body.len() {
        if doctorNodeCalls(doctorNodeAt(body, i), name) { return true }
        i = i + 1
    }
    return false
}

/** @brief Whether a subtree contains a call to `name`. */
fn doctorNodeCalls(node: ASTNode, name: string) -> bool {
    var found = false
    match node {
        ASTNode.Call(c) => {
            if doctorCalleeIsName(c.callee, name) { found = true }
            val args = c.args
            var i = 0
            while i < args.len() {
                if doctorNodeCalls(doctorNodeAt(args, i), name) { found = true }
                i = i + 1
            }
        }
        ASTNode.FunctionDecl(f) => { found = doctorCallsName(doctorStmtsOf(node), name) }
        ASTNode.RouteDecl(r) => { found = doctorCallsName(doctorStmtsOf(node), name) }
        ASTNode.While(w) => { found = doctorCallsName(doctorStmtsOf(node), name) }
        ASTNode.For(fo) => { found = doctorCallsName(doctorStmtsOf(node), name) }
        ASTNode.MatchCase(c) => { found = doctorCallsName(doctorStmtsOf(node), name) }
        ASTNode.Block(b) => { found = doctorCallsName(b.statements, name) }
        ASTNode.ExpressionStmt(e) => { found = doctorNodeCalls(e.expr, name) }
        ASTNode.Assignment(a) => { found = doctorNodeCalls(a.value, name) }
        ASTNode.Return(r) => { found = doctorNodeCalls(r.expr, name) }
        ASTNode.VarDecl(v) => { found = doctorNodeCalls(v.value, name) }
        ASTNode.If(x) => { found = doctorNodeCalls(x.condition, name) }
        ASTNode.Match(x) => {
            val cases = x.cases
            var i = 0
            while i < cases.len() {
                if doctorNodeCalls(doctorNodeAt(cases, i), name) { found = true }
                i = i + 1
            }
        }
        ASTNode.BinaryOp(b) => {
            found = doctorNodeCalls(b.lhs, name)
            if found == false { found = doctorNodeCalls(b.rhs, name) }
        }
        ASTNode.UnaryOp(u) => { found = doctorNodeCalls(u.operand, name) }
        _ => {}
    }
    return found
}

/** @brief Whether a callee expression names exactly `name`.
 *
 *  `name`, not `obj.name`: a call through a receiver is not a call to the
 *  method's own name, and treating it as one would make every method call look
 *  like a self-recursive call.
 */
fn doctorCalleeIsName(callee: ASTNode, name: string) -> bool {
    return doctorCalleeText(callee) == name
}

/** @brief A callee rendered as text, or "" when it is not a plain reference.
 *
 *  The callee is an ASTNode, not a list of tokens -- ast.orb said `callee: list`
 *  while the parser has always passed a single parsed expression, and builder.orb
 *  has always matched on it. A bare name comes through as a Literal; anything
 *  computed (`getFn(i)()`) returns "", so it is not mistaken for a name.
 */
fn doctorCalleeText(callee: ASTNode) -> string {
    var out = ""
    match callee {
        ASTNode.Literal(l) => {
            if l.valType == "identifier" { out = l.text }
        }
        _ => {}
    }
    return out
}

/** @brief Whether some statement is exactly `return <name>(...)`. */
fn doctorHasTailSelfCall(body: list, name: string) -> bool {
    var i = 0
    while i < body.len() {
        if doctorIsTailSelfReturn(doctorNodeAt(body, i), name) { return true }
        i = i + 1
    }
    return false
}

/** @brief Whether this statement returns a self-call and nothing else. */
fn doctorIsTailSelfReturn(node: ASTNode, name: string) -> bool {
    var isTail = false
    match node {
        ASTNode.Return(r) => {
            // The returned expression must BE the call. An operator wrapped around
            // it, or a variable holding it, keeps the frame alive.
            match r.expr {
                ASTNode.Call(c) => {
                    if doctorCalleeIsName(c.callee, name) { isTail = true }
                }
                _ => {}
            }
        }
        _ => {}
    }
    return isTail
}

/** @brief An allocation inside a loop body, repeated every iteration. */
fn doctorCheckLoopAllocs(stats: DoctorStats, node: ASTNode, fnName: string, file: string, lines: list) {
    val body = doctorStmtsOf(node)
    val line = doctorFindDeclLine(lines, "fn", fnName)
    var i = 0
    while i < body.len() {
        doctorScanLoopAllocs(stats, doctorNodeAt(body, i), fnName, file, line, false, "")
        i = i + 1
    }
}

/** @brief Walk a function body, reporting allocating statements that are inside a loop.
 *
 *  `inLoop` is context, not structure. The first version of this walker tried to
 *  infer it from where it stood: report in a loop body, and descend without
 *  reporting everywhere else. That drops every allocation that is not *directly*
 *  in the body -- one inside an `if`, a `match` arm, or a nested block was
 *  descended into and then discarded by the `_` arm. A check that finds the
 *  obvious case and misses the one two braces down is worse than no check,
 *  because the report it does make reads as coverage.
 *
 *  So `inLoop` is carried down the walk, and any statement reached while it is
 *  set is eligible. Each statement is still visited exactly once, along the one
 *  path from the outermost enclosing loop, so nesting cannot duplicate a report.
 *
 *  Recursion terminates on strictly smaller subtrees.
 *
 *  Nothing here passes a bound payload to a function taking an ASTNode:
 *  `ASTNode.While(w)` binds `w` to a WhileNode, and casting that to ASTNode lands
 *  in the callee's `_` arm and yields an empty statement list. That mistake was
 *  made ten times in this file before it was found once and then fixed
 *  everywhere.
 */
fn doctorScanLoopAllocs(stats: DoctorStats, node: ASTNode, fnName: string, file: string, line: int, inLoop: bool, kind: string) {
    match node {
        ASTNode.While(w) => {
            doctorScanLoopStmts(stats, doctorStmtsOf(node), fnName, file, line, true, "while")
        }
        ASTNode.For(fo) => {
            doctorScanLoopStmts(stats, doctorStmtsOf(node), fnName, file, line, true, "for")
        }
        ASTNode.Block(b) => {
            doctorScanLoopStmts(stats, b.statements, fnName, file, line, inLoop, kind)
        }
        ASTNode.If(x) => {
            doctorScanLoopAllocs(stats, x.thenBody, fnName, file, line, inLoop, kind)
            if x.elseBody != NULL {
                doctorScanLoopAllocs(stats, x.elseBody, fnName, file, line, inLoop, kind)
            }
        }
        ASTNode.Match(m) => {
            val cases = m.cases
            var i = 0
            while i < cases.len() {
                doctorScanLoopAllocs(stats, doctorNodeAt(cases, i), fnName, file, line, inLoop, kind)
                i = i + 1
            }
        }
        ASTNode.MatchCase(c) => {
            doctorScanLoopStmts(stats, doctorStmtsOf(node), fnName, file, line, inLoop, kind)
        }
        ASTNode.Try(t) => {
            doctorScanLoopAllocs(stats, t.expr, fnName, file, line, inLoop, kind)
            doctorScanLoopAllocs(stats, t.catchBody, fnName, file, line, inLoop, kind)
        }
        // Value-position if/match. `val picked = if m > 0 { list_create(n) }
        // else { list_create(n) }` allocates, but the VarDecl arm never descends
        // into its value, so the `_` arm ate the whole subtree.
        ASTNode.VarDecl(v) => {
            doctorScanLoopAllocs(stats, v.value, fnName, file, line, inLoop, kind)
        }
        ASTNode.ConstDecl(c) => {
            doctorScanLoopAllocs(stats, c.value, fnName, file, line, inLoop, kind)
        }
        ASTNode.Assignment(a) => {
            doctorScanLoopAllocs(stats, a.value, fnName, file, line, inLoop, kind)
        }
        ASTNode.Return(r) => {
            doctorScanLoopAllocs(stats, r.expr, fnName, file, line, inLoop, kind)
        }
        ASTNode.ReturnOk(r) => {
            doctorScanLoopAllocs(stats, r.expr, fnName, file, line, inLoop, kind)
        }
        ASTNode.ReturnErr(r) => {
            doctorScanLoopAllocs(stats, r.expr, fnName, file, line, inLoop, kind)
        }
        ASTNode.ExpressionStmt(e) => {
            doctorScanLoopAllocs(stats, e.expr, fnName, file, line, inLoop, kind)
        }
        ASTNode.BinaryOp(b) => {
            doctorScanLoopAllocs(stats, b.lhs, fnName, file, line, inLoop, kind)
            doctorScanLoopAllocs(stats, b.rhs, fnName, file, line, inLoop, kind)
        }
        ASTNode.UnaryOp(u) => {
            doctorScanLoopAllocs(stats, u.operand, fnName, file, line, inLoop, kind)
        }
        ASTNode.Call(c) => {
            val args = c.args
            var i = 0
            while i < args.len() {
                doctorScanLoopAllocs(stats, doctorNodeAt(args, i), fnName, file, line, inLoop, kind)
                i = i + 1
            }
        }
        ASTNode.IndexAccess(ix) => {
            doctorScanLoopAllocs(stats, ix.object, fnName, file, line, inLoop, kind)
            doctorScanLoopAllocs(stats, ix.index, fnName, file, line, inLoop, kind)
        }
        ASTNode.MemberAccess(m) => {
            doctorScanLoopAllocs(stats, m.object, fnName, file, line, inLoop, kind)
        }
        ASTNode.ListLiteral(l) => {
            val els = l.elements
            var i = 0
            while i < els.len() {
                doctorScanLoopAllocs(stats, doctorNodeAt(els, i), fnName, file, line, inLoop, kind)
                i = i + 1
            }
        }
        ASTNode.Interp(inp) => {
            val parts = inp.parts
            var i = 0
            while i < parts.len() {
                doctorScanLoopAllocs(stats, doctorNodeAt(parts, i), fnName, file, line, inLoop, kind)
                i = i + 1
            }
        }
        _ => {}
    }
}

/** @brief Visit each statement in a list, reporting the allocating ones, then descend. */
fn doctorScanLoopStmts(stats: DoctorStats, stmts: list, fnName: string, file: string, line: int, inLoop: bool, kind: string) {
    var i = 0
    while i < stmts.len() {
        val stmt = doctorNodeAt(stmts, i)
        val at = doctorAllocLine(stmt)
        if inLoop && at != 0 {
            val where = line
            if at > 0 { where = at }
            doctorReport(stats, file, where, "D019", "fn " + fnName + " allocates inside a " + kind + " loop, so the allocation is repeated on every iteration.", "build the collection once before the loop and reuse it, or reuse one collection across iterations.")
        }
        doctorScanLoopAllocs(stats, stmt, fnName, file, line, inLoop, kind)
        i = i + 1
    }
}

/** @brief The line an allocating statement sits on, 0 if it does not allocate, -1 if unknown. */
fn doctorAllocLine(node: ASTNode) -> int {
    var at = 0
    match node {
        ASTNode.Assignment(a) => {
            if doctorExprAllocates(a.value) { at = -1 }
        }
        ASTNode.VarDecl(v) => {
            if doctorExprAllocates(v.value) { at = v.line }
        }
        ASTNode.ExpressionStmt(e) => {
            if doctorExprAllocates(e.expr) { at = -1 }
        }
        // `parseStatementInner` returns a bare expression unwrapped, so a bare
        // allocating call in a loop arrives as the Call itself, not as an
        // ExpressionStmt. The arm above was therefore dead.
        ASTNode.Call(c) => {
            if doctorIsAllocName(doctorCalleeText(c.callee)) { at = -1 }
        }
        ASTNode.ListLiteral(l) => { at = -1 }
        ASTNode.ObjectLiteral(o) => { at = -1 }
        ASTNode.Return(r) => {
            if doctorExprAllocates(r.expr) { at = -1 }
        }
        _ => {}
    }
    return at
}

/** @brief Whether an expression is an allocating call or a collection literal. */
fn doctorExprAllocates(node: ASTNode) -> bool {
    var isAlloc = false
    match node {
        ASTNode.Call(c) => {
            if doctorIsAllocName(doctorCalleeText(c.callee)) { isAlloc = true }
        }
        // An EMPTY list literal is not a reportable allocation. `var acc = []`
        // inside a loop is how an accumulator is written in this language, and
        // this check's advice -- build it once before the loop and reuse it --
        // is not merely unhelpful there, it is wrong: the accumulator has to
        // start empty on every iteration or the results accumulate. Eight of
        // the first D019 hits on this tree were all of this shape, which is what
        // a check that reports the language's most common idiom looks like.
        //
        // A NON-empty literal is still an allocation built per iteration, so it
        // is reported. Only `[]` is exempt.
        ASTNode.ListLiteral(l) => {
            if l.elements.len() > 0 { isAlloc = true }
        }
        ASTNode.ObjectLiteral(o) => { isAlloc = true }
        _ => {}
    }
    return isAlloc
}

/** @brief Whether a callee name is one of the runtime's allocating constructors. */

fn doctorIsAllocName(name: string) -> bool {
    if name == "list_create" { return true }
    if name == "map_create" { return true }
    if name == "orbit_os_alloc" { return true }
    if name == "orbit_os_create_arena" { return true }
    if name == "orbit_list_create_selfhost" { return true }
    if name == "orbit_cbuf_create_selfhost" { return true }
    if doctorEndsWith(name, "_alloc") { return true }
    if doctorEndsWith(name, "_create") { return true }
    return false
}

/** @brief Whether `s` ends with `suffix`. */
fn doctorEndsWith(s: string, suffix: string) -> bool {
    val sn = orbit_string_len(s)
    val xn = orbit_string_len(suffix)
    if xn == 0 { return true }
    if sn < xn { return false }
    return orbit_string_slice(s, sn - xn, sn) == suffix
}

fn doctorCheckRoutes(stats: DoctorStats, routes: list) {
    var a = 0
    while a < routes.len() {
        var b = a + 1
        while b < routes.len() {
            val ra: DoctorRoute = routes.get(a)
            val rb: DoctorRoute = routes.get(b)
            if ra.method == rb.method {
                if ra.normPath == rb.normPath {
                    if ra.rawPath == rb.rawPath {
                        doctorReport(stats, rb.file, rb.line, "D002", "duplicate route " + rb.method + " " + rb.rawPath + " (first seen at " + ra.file + ":" + orbit_int_to_string_selfhost(ra.line) + ").", "keep one handler and remove the other.")
                    } else {
                        doctorReport(stats, rb.file, rb.line, "D002", "route " + rb.method + " " + rb.rawPath + " collides with " + ra.file + ":" + orbit_int_to_string_selfhost(ra.line) + " (" + ra.method + " " + ra.rawPath + "); both normalize to " + rb.normPath + ".", "merge the handlers or give the paths distinct shapes.")
                    }
                } else {
                    if doctorRouteIsWildcard(ra.normPath) {
                        if doctorWildcardCovers(ra.normPath, rb.normPath) {
                            doctorReport(stats, rb.file, rb.line, "D002", "route " + rb.method + " " + rb.rawPath + " is covered by wildcard " + ra.method + " " + ra.rawPath + " at " + ra.file + ":" + orbit_int_to_string_selfhost(ra.line) + ".", "order the specific route before the wildcard or narrow the wildcard.")
                        }
                    }
                    if doctorRouteIsWildcard(rb.normPath) {
                        if doctorWildcardCovers(rb.normPath, ra.normPath) {
                            doctorReport(stats, ra.file, ra.line, "D002", "route " + ra.method + " " + ra.rawPath + " is covered by wildcard " + rb.method + " " + rb.rawPath + " at " + rb.file + ":" + orbit_int_to_string_selfhost(rb.line) + ".", "order the specific route before the wildcard or narrow the wildcard.")
                        }
                    }
                }
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn doctorFindDeclLine(lines: list, keyword: string, name: string) -> int {
    var i = 0
    while i < lines.len() {
        // Cheap gate before the expensive path. Trimming a line and stripping
        // "private "/"extern " allocates about five strings, and running that
        // over every line of the file for every declaration is what this scan
        // costs. A line whose trimmed text starts with the keyword necessarily
        // CONTAINS it, so an indexOf miss is a certain miss: the filter can only
        // skip work that could not have matched, which is what makes it safe to
        // add in front of logic that decides a reported line number.
        val raw = lines.get(i)
        if orbit_string_indexOf(raw, keyword) != -1 {
            var rest = doctorTrimLeft(raw)
            if doctorStartsWith(rest, "private ") {
                rest = doctorTrimLeft(orbit_string_slice(rest, 8, orbit_string_len(rest)))
            }
            if doctorStartsWith(rest, "extern ") {
                rest = doctorTrimLeft(orbit_string_slice(rest, 7, orbit_string_len(rest)))
            }
            if doctorStartsWith(rest, keyword) {
                val after = orbit_string_slice(rest, orbit_string_len(keyword), orbit_string_len(rest))
                if orbit_string_len(after) > 0 {
                    val c0 = orbit_string_char_at_selfhost(after, 0)
                    if c0 == 32 || c0 == 9 {
                        val tail = doctorTrimLeft(after)
                        if doctorStartsWith(tail, name) {
                            if orbit_string_len(tail) == orbit_string_len(name) { return i + 1 }
                            val ec = orbit_string_char_at_selfhost(tail, orbit_string_len(name))
                            if doctorIsWordChar(ec) == false { return i + 1 }
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    return 0
}

fn doctorCollectDecls(node: ASTNode, lines: list, file: string, decls: list) {
    match node {
        ASTNode.Program(p) => {
            var i = 0
            while i < p.decls.len() {
                doctorCollectDecls(p.decls.get(i), lines, file, decls)
                i = i + 1
            }
        }
        ASTNode.FunctionDecl(f) => {
            decls.push(DoctorDecl(f.name, "fn", file, doctorFindDeclLine(lines, "fn", f.name), f.isPrivate, f.isExtern))
        }
        ASTNode.ModelDecl(m) => {
            decls.push(DoctorDecl(m.name, "model", file, doctorFindDeclLine(lines, "model", m.name), false, false))
        }
        _ => {}
    }
}

// AST walk collecting every referenced name: identifier uses plus the
// type names in annotations, so models used as types count as used.
fn doctorWalkRefs(node: ASTNode, refs: list) {
    match node {
        ASTNode.Program(p) => {
            var i = 0
            while i < p.decls.len() {
                doctorWalkRefs(p.decls.get(i), refs)
                i = i + 1
            }
        }
        ASTNode.FunctionDecl(f) => {
            var i = 0
            while i < f.paramTypes.len() {
                refs.push(f.paramTypes.get(i))
                i = i + 1
            }
            if f.returnType != "" { refs.push(f.returnType) }
            doctorWalkRefs(f.body, refs)
        }
        ASTNode.RouteDecl(r) => { doctorWalkRefs(r.body, refs) }
        ASTNode.ModelDecl(m) => {
            var i = 0
            while i < m.fields.len() {
                doctorWalkRefs(m.fields.get(i), refs)
                i = i + 1
            }
        }
        ASTNode.FieldDecl(fd) => {
            if fd.fieldType != "" { refs.push(fd.fieldType) }
        }
        ASTNode.VarDecl(v) => {
            if v.typeAnnotation != "" { refs.push(v.typeAnnotation) }
            doctorWalkRefs(v.value, refs)
        }
        ASTNode.ConstDecl(c) => { doctorWalkRefs(c.value, refs) }
        ASTNode.Block(b) => {
            var i = 0
            while i < b.statements.len() {
                doctorWalkRefs(b.statements.get(i), refs)
                i = i + 1
            }
        }
        ASTNode.If(n) => {
            doctorWalkRefs(n.condition, refs)
            doctorWalkRefs(n.thenBody, refs)
            doctorWalkRefs(n.elseBody, refs)
        }
        ASTNode.While(n) => {
            doctorWalkRefs(n.condition, refs)
            doctorWalkRefs(n.body, refs)
        }
        ASTNode.For(n) => {
            doctorWalkRefs(n.iterable, refs)
            doctorWalkRefs(n.body, refs)
        }
        ASTNode.Return(n) => { doctorWalkRefs(n.expr, refs) }
        ASTNode.ReturnOk(n) => { doctorWalkRefs(n.expr, refs) }
        ASTNode.ReturnErr(n) => { doctorWalkRefs(n.expr, refs) }
        ASTNode.Match(n) => {
            doctorWalkRefs(n.expr, refs)
            var i = 0
            while i < n.cases.len() {
                doctorWalkRefs(n.cases.get(i), refs)
                i = i + 1
            }
        }
        ASTNode.MatchCase(n) => {
            doctorWalkRefs(n.pattern, refs)
            doctorWalkRefs(n.body, refs)
        }
        ASTNode.Try(n) => {
            doctorWalkRefs(n.expr, refs)
            doctorWalkRefs(n.catchBody, refs)
        }
        ASTNode.BinaryOp(n) => {
            doctorWalkRefs(n.lhs, refs)
            doctorWalkRefs(n.rhs, refs)
        }
        ASTNode.UnaryOp(n) => { doctorWalkRefs(n.operand, refs) }
        ASTNode.Call(n) => {
            doctorWalkRefs(n.callee, refs)
            var i = 0
            while i < n.args.len() {
                doctorWalkRefs(n.args.get(i), refs)
                i = i + 1
            }
        }
        ASTNode.MemberAccess(n) => { doctorWalkRefs(n.object, refs) }
        ASTNode.IndexAccess(n) => {
            doctorWalkRefs(n.object, refs)
            doctorWalkRefs(n.index, refs)
        }
        ASTNode.ListLiteral(n) => {
            var i = 0
            while i < n.elements.len() {
                doctorWalkRefs(n.elements.get(i), refs)
                i = i + 1
            }
        }
        ASTNode.Assignment(n) => {
            doctorWalkRefs(n.target, refs)
            doctorWalkRefs(n.value, refs)
        }
        ASTNode.ExpressionStmt(n) => { doctorWalkRefs(n.expr, refs) }
        ASTNode.TypeAnnotation(n) => { refs.push(n.token) }
        ASTNode.ImplDecl(n) => {
            refs.push(n.traitName)
            refs.push(n.typeName)
            var i = 0
            while i < n.methods.len() {
                doctorWalkRefs(n.methods.get(i), refs)
                i = i + 1
            }
        }
        ASTNode.TraitDecl(n) => {
            var i = 0
            while i < n.methods.len() {
                doctorWalkRefs(n.methods.get(i), refs)
                i = i + 1
            }
        }
        ASTNode.ScheduleDecl(n) => { doctorWalkRefs(n.handler, refs) }
        ASTNode.ConfigDecl(n) => { doctorWalkRefs(n.value, refs) }
        ASTNode.FieldInit(n) => { doctorWalkRefs(n.value, refs) }
        ASTNode.Literal(n) => {
            if n.valType == "identifier" { refs.push(n.text) }
        }
        _ => {}
    }
}

fn doctorContainsWord(hay: string, word: string) -> bool {
    val hn = orbit_string_len(hay)
    val wn = orbit_string_len(word)
    if wn == 0 { return false }
    if hn < wn { return false }
    // Same reasoning as the gate in doctorFindDeclLine: the loop below slices a
    // fresh string per offset, so a line that does not contain the word at all
    // should not reach it. Measured 2.5x on the scan that does run.
    if orbit_string_indexOf(hay, word) == -1 { return false }
    var i = 0
    while i + wn <= hn {
        if orbit_string_slice(hay, i, i + wn) == word {
            var leftOk = true
            if i > 0 {
                if doctorIsWordChar(orbit_string_char_at_selfhost(hay, i - 1)) { leftOk = false }
            }
            var rightOk = true
            if i + wn < hn {
                if doctorIsWordChar(orbit_string_char_at_selfhost(hay, i + wn)) { rightOk = false }
            }
            if leftOk && rightOk { return true }
        }
        i = i + 1
    }
    return false
}

// Text safety net for positions the AST walk does not model: a name is
// only reported when no whole-word use exists outside its own decl line.
fn doctorUsedInText(files: list, sources: list, fileLines: list, declFile: string, declLine: int, word: string) -> bool {
    var i = 0
    while i < files.len() {
        val fp: string = files.get(i)
        val src: string = sources.get(i)
        if orbit_string_indexOf(src, word) != -1 {
            // The line list comes from the run, not from splitting here. This
            // function runs once per unused declaration over every file, so
            // splitting inside it made the search O(decls x files x bytes).
            val lines: list = fileLines.get(i)
            var ln = 1
            while ln <= lines.len() {
                var isDeclLine = false
                if fp == declFile && ln == declLine { isDeclLine = true }
                if isDeclLine == false {
                    val t: string = lines.get(ln - 1)
                    if doctorContainsWord(t, word) { return true }
                }
                ln = ln + 1
            }
        }
        i = i + 1
    }
    return false
}

fn doctorCheckUnused(stats: DoctorStats, decls: list, refs: list, files: list, sources: list, fileLines: list) {
    var i = 0
    while i < decls.len() {
        val d: DoctorDecl = decls.get(i)
        var reportable = true
        if d.name == "main" { reportable = false }
        if d.isExtern { reportable = false }
        if d.kind == "fn" && d.isPrivate == false { reportable = false }
        if reportable {
            if doctorListContains(refs, d.name) == false {
                if doctorUsedInText(files, sources, fileLines, d.file, d.line, d.name) == false {
                    if d.kind == "fn" {
                        doctorReport(stats, d.file, d.line, "D003", "private fn '" + d.name + "' is never called in the scanned files.", "call it, or remove it if it is no longer needed.")
                    } else {
                        doctorReport(stats, d.file, d.line, "D004", "model '" + d.name + "' is never referenced in the scanned files.", "use it, or remove it if it is no longer needed.")
                    }
                }
            }
        }
        i = i + 1
    }
}

// Drop // comments and "..." spans so strings and comments never count
// as system uses.
/** @brief The contents of every string literal on a line, in order.
 *
 *  The inverse of doctorCodePart, which drops literals. Secrets have to be found
 *  INSIDE them, so a scan that reuses the code part would find nothing at all
 *  and look like it had run. Escapes are left as written: a secret prefix does
 *  not contain a backslash, and un-escaping would mean guessing at what the
 *  author meant.
 *
 *  A line comment ends the literals: text after "//" is not code, and a secret
 *  in a comment is a secret in a file, but reporting it against the wrong line
 *  is worse than not reporting it. */
fn doctorStringLiterals(line: string) -> list {
    var out = []
    val cpos = orbit_string_indexOf(line, "//")
    var n = orbit_string_len(line)
    if cpos != -1 { n = cpos }
    var i = 0
    while i < n {
        if orbit_string_char_at_selfhost(line, i) == 34 {
            val start = i + 1
            var j = start
            var closed = false
            while j < n {
                val c = orbit_string_char_at_selfhost(line, j)
                if c == 92 {
                    j = j + 2
                    continue
                }
                if c == 34 {
                    closed = true
                    break
                }
                j = j + 1
            }
            if closed {
                out.push(orbit_string_slice(line, start, j))
                i = j + 1
            } else {
                i = n
            }
        } else {
            i = i + 1
        }
    }
    return out
}

/** @brief The first secret-shaped prefix in `text`, or "".
 *
 *  Returns the PREFIX and never the value. A diagnostic that quoted the string
 *  it found would copy the credential into CI logs, a build page and every
 *  terminal that ran the tool, which is how a secret stops being a secret. The
 *  prefix is enough to find the line and enough to say what kind of key it is. */
fn doctorSecretPrefix(text: string) -> string {
    val prefixes = ["sk-", "ghp_", "AKIA", "-----BEGIN", "password=", "secret=", "token=", "apikey="]
    // A credential has material after its prefix. Without this the scanner flags
    // its OWN prefix table -- eight findings on one line inside doctor.orb, one
    // per prefix it is made of -- which is how a check becomes noise on the
    // first file it ever sees. Requiring real content after the prefix is also
    // the honest definition: "sk-" alone is a shape, not a leaked key.
    val tn = orbit_string_len(text)
    var i = 0
    while i < prefixes.len() {
        val p: string = prefixes.get(i)
        if tn >= orbit_string_len(p) + 8 {
            if doctorContainsFold(text, p) { return p }
        }
        i = i + 1
    }
    return ""
}

/** @brief Case-insensitive substring test, without allocating a lowered copy.
 *
 *  orbit_string_indexOf is case-sensitive and there is no case-insensitive form
 *  in the runtime, so this compares a window of `needle` against `hay` folding
 *  ASCII. ASCII only, deliberately: a secret prefix is ASCII, and folding
 *  anything above 127 needs a table this does not have. */
fn doctorContainsFold(hay: string, needle: string) -> bool {
    val hn = orbit_string_len(hay)
    val nn = orbit_string_len(needle)
    if nn == 0 { return false }
    if hn < nn { return false }
    var i = 0
    while i + nn <= hn {
        var j = 0
        var same = true
        while j < nn {
            if doctorFoldChar(orbit_string_char_at_selfhost(hay, i + j)) != doctorFoldChar(orbit_string_char_at_selfhost(needle, j)) {
                same = false
                break
            }
            j = j + 1
        }
        if same { return true }
        i = i + 1
    }
    return false
}

fn doctorFoldChar(c: int) -> int {
    if c >= 65 && c <= 90 { return c + 32 }
    return c
}

fn doctorCodePart(line: string) -> string {
    var cut = line
    val cpos = orbit_string_indexOf(line, "//")
    if cpos != -1 { cut = orbit_string_slice(line, 0, cpos) }
    val n = orbit_string_len(cut)
    // Only string literals get dropped, so a line with no quote is returned
    // as-is instead of rebuilt one arena allocation per character. Lines
    // that do have a quote are copied in runs, between the quotes.
    var k = 0
    var hasStr = false
    while k < n {
        if orbit_string_char_at_selfhost(cut, k) == 34 { hasStr = true }
        k = k + 1
    }
    if hasStr == false { return cut }
    val buf = orbit_cbuf_create_selfhost()
    var i = 0
    var inStr = false
    while i < n {
        val c = orbit_string_char_at_selfhost(cut, i)
        if inStr {
            if c == 92 {
                i = i + 2
            } else {
                if c == 34 { inStr = false }
                i = i + 1
            }
        } else {
            if c == 34 {
                inStr = true
                i = i + 1
            } else {
                val start = i
                while i < n && orbit_string_char_at_selfhost(cut, i) != 34 {
                    i = i + 1
                }
                orbit_cbuf_append_selfhost(buf, orbit_string_slice(cut, start, i))
            }
        }
    }
    return orbit_cbuf_build_selfhost(buf)
}

fn doctorIsValidSystemMember(member: string) -> bool {
    if member == "uptime" { return true }
    if member == "pid" { return true }
    if member == "active_workers" { return true }
    if member == "http_requests_total" { return true }
    if member == "latency_avg_us" { return true }
    if member == "latency_p50_us" { return true }
    if member == "latency_p95_us" { return true }
    if member == "latency_p99_us" { return true }
    return false
}

fn doctorScanSystemLine(line: string) -> string {
    var i = 0
    val n = orbit_string_len(line)
    while i + 7 <= n {
        if orbit_string_slice(line, i, i + 7) == "system." {
            var j = i + 7
            var member = ""
            while j < n {
                val c = orbit_string_char_at_selfhost(line, j)
                if doctorIsWordChar(c) {
                    member = member + orbit_string_slice(line, j, j + 1)
                    j = j + 1
                } else {
                    break
                }
            }
            if member != "" {
                if doctorIsValidSystemMember(member) == false { return member }
            }
            i = j
        } else {
            i = i + 1
        }
    }
    return ""
}

fn doctorScanSystem(stats: DoctorStats, lines: list, file: string) {
    var i = 0
    while i < lines.len() {
        val bad = doctorScanSystemLine(doctorCodePart(lines.get(i)))
        if bad != "" {
            doctorReport(stats, file, i + 1, "D005", "unknown member 'system." + bad + "'. Valid members are: uptime, pid, active_workers, http_requests_total, latency_avg_us, latency_p50_us, latency_p95_us, latency_p99_us.", "use one of: uptime, pid, active_workers, http_requests_total, latency_avg_us, latency_p50_us, latency_p95_us, latency_p99_us.")
        }
        i = i + 1
    }
}

fn doctorHasTrailingWs(line: string) -> bool {
    var end = orbit_string_len(line)
    if end == 0 { return false }
    if orbit_string_char_at_selfhost(line, end - 1) == 13 { end = end - 1 }
    if end == 0 { return false }
    val c = orbit_string_char_at_selfhost(line, end - 1)
    return c == 32 || c == 9
}

// Returns the line's CONTENT: trailing spaces, tabs and the carriage return of
// a CRLF ending all go. The fix engine puts the original line ending back, so a
// check hands over text, not terminators, and cannot invent a mixed-ending file.
fn doctorStripTrailingWs(line: string) -> string {
    var end = orbit_string_len(line)
    while end > 0 {
        val c = orbit_string_char_at_selfhost(line, end - 1)
        if c == 32 || c == 9 || c == 13 {
            end = end - 1
        } else {
            break
        }
    }
    return orbit_string_slice(line, 0, end)
}

fn doctorBuildFixedSource(source: string) -> string {
    val lines = splitBuildLines(source)
    // Re-joining line by line with `out = out + line` was quadratic in the
    // file size; the chunk buffer appends instead.
    val buf = orbit_cbuf_create_selfhost()
    var i = 0
    while i < lines.len() {
        orbit_cbuf_append_selfhost(buf, doctorStripTrailingWs(lines.get(i)))
        orbit_cbuf_append_selfhost(buf, "\n")
        i = i + 1
    }
    return orbit_cbuf_build_selfhost(buf)
}

// The two whitespace checks carry their own edits, so --fix goes through the
// same engine every future fix will: apply the edits, verify the result, write
// it. A fix engine first exercised on a hand-rolled path somewhere else is a
// fix engine nobody has run.
fn doctorScanStyle(stats: DoctorStats, lines: list, file: string, eol: string, endsWithNewline: bool) {
    var i = 0
    while i < lines.len() {
        val raw = lines.get(i)
        if doctorHasTrailingWs(raw) {
            var edits = []
            edits.push(DoctorEdit(i + 1, i + 1, doctorStripTrailingWs(raw), "safe"))
            doctorReportFull(stats, file, i + 1, orbit_string_len(raw) - 1, "D006", "trailing whitespace on this line.", "remove the trailing spaces or tabs (doctor --fix does this).", "safe", edits)
        }
        i = i + 1
    }
    // Whether the file ends with a newline is a fact about the BYTES, not about
    // the line list: splitBuildLines drops the final newline, so "the last line
    // exists" cannot tell a terminated file from an unterminated one.
    if endsWithNewline == false {
        val endEdits = []
        endEdits.push(DoctorEdit(lines.len() + 1, lines.len(), eol, "safe"))
        doctorReportFull(stats, file, lines.len(), 0, "D007", "file does not end with a newline.", "end the file with a single newline (doctor --fix does this).", "safe", endEdits)
    }
}

/** @brief Layer 1 checks that read string literals: secrets and SQL surfaces.
 *
 *  One pass over the lines, because the literals are the same literals both
 *  checks need and splitting them twice is the mistake this function exists to
 *  avoid. Neither check reports the literal's contents: for a secret that is the
 *  whole point, and for a SQL string the line number and the keyword are enough
 *  to act on. */
fn doctorScanLiterals(stats: DoctorStats, lines: list, file: string) {
    var i = 0
    while i < lines.len() {
        val literals = doctorStringLiterals(lines.get(i))
        var k = 0
        while k < literals.len() {
            val lit: string = literals.get(k)
            val secret = doctorSecretPrefix(lit)
            if secret != "" {
                doctorReport(stats, file, i + 1, "D009", "a string literal looks like a hardcoded credential (prefix '" + secret + "').", "read it from the environment instead; the value is not shown here on purpose.")
            } else {
                val kw = doctorSqlKeyword(lit)
                if kw != "" {
                    val interpolated = doctorHasInterpolationOn(lines, i, lit)
                    if interpolated {
                        doctorReport(stats, file, i + 1, "D010", "a SQL statement starting with " + doctorTrimSpace(kw) + " is built by string interpolation.", "use a parameterised query instead of pasting values into the SQL text.")
                    }
                }
            }
            k = k + 1
        }
        i = i + 1
    }
}

/** @brief The first SQL keyword in `text`, or "".
 *
 *  A keyword alone is not a finding: plenty of prose mentions SELECT. It becomes
 *  a finding when the string is also interpolated, which is what doctorScanLiterals
 *  checks before reporting. */
fn doctorSqlKeyword(text: string) -> string {
    val kws = ["SELECT ", "INSERT ", "UPDATE ", "DELETE ", "DROP "]
    var i = 0
    while i < kws.len() {
        val k: string = kws.get(i)
        if doctorContainsFold(text, k) { return k }
        i = i + 1
    }
    return ""
}

/** @brief Whether the literal at `idx` on line `i` has values pasted into it.
 *
 *  Interpolation in this language is a plain "+" against the literal's closing
 *  quote, so the evidence is that the line continues after the string ends.
 *  Looking only at the current line is a deliberate under-report: a SQL string
 *  continued on the next line would be missed, and a false D010 on a query
 *  built without interpolation is the failure mode that makes people turn a
 *  check off. */
fn doctorHasInterpolationOn(lines: list, i: int, lit: string) -> bool {
    val line = lines.get(i)
    // Three pieces: a quote, the literal, then a quote-space-plus. Writing this
    // as one string is how it went wrong first time: `"\"" + lit + "\" + " +"`
    // ends with a dangling `+`, and the lexer then reads the rest of the file as
    // one unterminated string.
    val marker = "\"" + lit + "\" +"
    return doctorContainsFold(line, marker)
}

/** @brief var that is never written after its declaration, reported as D013.
 *
 *  A `var` exists because something changes it. A `var` that is only ever
 *  assigned once, at its declaration, is a `val` wearing a `var`, and the
 *  difference is not style: `val` cannot be reassigned, so the compiler stops
 *  checking every write to it. Only single-assignment text is considered, and
 *  the name is matched whole, so a same-named local in another function does
 *  not make this one look written. */
fn doctorScanMutableDecls(stats: DoctorStats, lines: list, file: string) {
    var i = 0
    while i < lines.len() {
        val raw = lines.get(i)
        val trimmed = doctorTrimSpace(raw)
        if doctorStartsWith(trimmed, "var ") {
            // Slice the TRIMMED line. Slicing the raw one at a fixed offset
            // depends on the indentation, and an indented `var i = 0` yielded the
            // name "var" -- which then "was never reassigned" for every single
            // declaration in the tree.
            val rest = doctorTrimSpace(orbit_string_slice(trimmed, 4, orbit_string_len(trimmed)))
            val first = doctorLeadingName(rest)
            // `var mut x` says out loud that x is mutable. Recommending val
            // against an explicit declaration of intent is exactly the false
            // positive that gets a check switched off, so it is not reported
            // either way -- not even when the truth is that it never is.
            val name = ""
            if first == "mut" {
                val afterMut = doctorTrimSpace(orbit_string_slice(rest, 3, orbit_string_len(rest)))
                if doctorLeadingName(afterMut) == "" {
                    i = i + 1
                }
            } else {
                name = first
            }
            if name != "" {
                var writes = 0
                var j = 0
                while j < lines.len() {
                    if doctorAssignsTo(lines.get(j), name) { writes = writes + 1 }
                    j = j + 1
                }
                // One write is the declaration itself. Zero would mean the
                // declaration line did not look like an assignment, which means
                // we do not understand this form and must not report it.
                if writes == 1 {
                    doctorReport(stats, file, i + 1, "D013", "'" + name + "' is declared var but never assigned again.", "make it a val: nothing can reassign it, and the compiler stops checking every write.")
                }
            }
        }
        i = i + 1
    }
}

/** @brief The identifier at the start of `rest`, or "" when there is none. */
fn doctorLeadingName(rest: string) -> string {
    var i = 0
    val n = orbit_string_len(rest)
    var name = ""
    while i < n {
        val c = orbit_string_char_at_selfhost(rest, i)
        if doctorIsWordChar(c) {
            name = name + rest.slice(i, i + 1)
            i = i + 1
        } else {
            break
        }
    }
    return name
}

/** @brief Whether this line ASSIGNS to `name`: `name = ...` or `name += ...`.
 *
 *  It has to require the `=`. Checking only that the next character is not a
 *  word character counted every plain USE of the name as a write, so a `var`
 *  that was read and printed looked reassigned and D013 never fired. `==`, `<`
 *  and `!=` are comparisons and a following `+` is arithmetic, not a compound
 *  assignment, so those are excluded by looking at what follows the operator. */
fn doctorAssignsTo(line: string, name: string) -> bool {
    val code = doctorCodePart(line)
    val n = orbit_string_len(code)
    val nn = orbit_string_len(name)
    var i = 0
    while i + nn <= n {
        if orbit_string_slice(code, i, i + nn) == name {
            var beforeOk = true
            if i > 0 {
                if doctorIsWordChar(orbit_string_char_at_selfhost(code, i - 1)) { beforeOk = false }
            }
            if beforeOk {
                var after = i + nn
                // `name` at end of line cannot be an assignment.
                if after < n {
                    val c = orbit_string_char_at_selfhost(code, after)
                    if c == 32 || c == 9 {
                        var k = after
                        while k < n {
                            val sp = orbit_string_char_at_selfhost(code, k)
                            if sp != 32 && sp != 9 { break }
                            k = k + 1
                        }
                        if k < n {
                            val op = orbit_string_char_at_selfhost(code, k)
                            if op == 61 {
                                if k + 1 >= n { return true }
                                // `==` is a comparison.
                                if orbit_string_char_at_selfhost(code, k + 1) != 61 { return true }
                            }
                            if op == 43 || op == 45 || op == 42 || op == 47 {
                                var m = k + 1
                                while m < n {
                                    val sp2 = orbit_string_char_at_selfhost(code, m)
                                    if sp2 != 32 && sp2 != 9 { break }
                                    m = m + 1
                                }
                                if m < n {
                                    if orbit_string_char_at_selfhost(code, m) == 61 { return true }
                                }
                            }
                        }
                    }
                }
            }
            i = i + nn
            continue
        }
        i = i + 1
    }
    return false
}

fn doctorPrintGates() {
    print("gates: doctor never runs these itself; run them from the repository root:")
    print("  python scripts/verify_seed.py --cc <gcc-or-clang> --emit-fixed-point <path-to-orbit>")
    print("  python scripts/parity_selfhost.py --cc <gcc-or-clang> --compiler <path-to-orbit>")
    print("  python scripts/test_suite.py --cc <gcc-or-clang> --compiler <path-to-orbit>")
}

fn doctorPrintHelp() {
    print("Usage: orbit doctor [dir] [options]")
    print("")
    print("Scans .orb files under [dir] (default: the current directory) without changing them.")
    print("  --fix           Apply the fixes doctor knows how to make.")
    print("  --unsafe        Also apply the structural fixes; off by default.")
    print("  --verify-build  Check each fixed file compiles to C (on by default with --fix).")
    print("  --fast          Skip that C check; the front end is still checked.")
    print("  --dry-run       Report what --fix would change, and change nothing.")
    print("  --only CODES    Only these codes, e.g. --only D006,D007.")
    print("  --skip CODES    Every code but these.")
    print("  --min-severity warning|error  Hide anything below this severity.")
    print("  --baseline FILE Print findings listed in FILE but do not fail on them.")
    print("  --telemetry FILE A ledger snapshot to check routes against; defaults to")
    print("                  $ORBIT_LEDGER_OUT. Absent, D031-D033 stay silent.")
    print("  --budget-doc FILE  The ENGINEERING.md whose latency budget D033 enforces;")
    print("                      defaults to ./ENGINEERING.md.")
    print("  --quiet         Findings (and fixes) only; no summaries or gate list.")
    print("  --verbose       Also print the scan scope and the per-phase timings.")
    print("  --format text|json  Output format; json is a JSON array on stdout.")
    print("  --color always|never|auto  ANSI colors (auto honors NO_COLOR/TERM).")
    print("")
    print("Exit codes: 0 clean, 1 findings, 2 usage.")
}

fn doctorUsage() {
    orbit_os_write_stderr_selfhost("Usage: orbit doctor [dir] [options]\nRun `orbit doctor --help` for details.\n")
}

/** @brief Where the typecheck cache lives, or "" when caching is off.
 *
 *  Follows the compiler's existing convention: ORBIT_DOCTOR_CACHE wins, then
 *  ORBIT_CCACHE_DIR (so one scratch dir serves the whole toolchain), then
 *  XDG_CACHE_HOME/orbit/doctor. ORBIT_DOCTOR_CACHE=0 disables it outright --
 *  a cache you cannot turn off is a cache you cannot debug. */
fn doctorCacheDir() -> string {
    val override = orbit_os_env_selfhost("ORBIT_DOCTOR_CACHE")
    if doctorTrimSpace(override) == "0" { return "" }
    if override != "" { return override }
    val shared = orbit_os_env_selfhost("ORBIT_CCACHE_DIR")
    if shared != "" { return doctorJoinPath(shared, "doctor") }
    val xdg = orbit_os_env_selfhost("XDG_CACHE_HOME")
    if xdg == "" { return "" }
    return doctorJoinPath(doctorJoinPath(xdg, "orbit"), "doctor")
}

/** @brief Typecheck one file, reusing a previous answer for the same bytes.
 *
 *  The key is a hash of the SOURCE, not the path: move a file and its answer
 *  still applies, edit a byte and it does not. Keying by path would make a
 *  rename look like a first run, and keying by path+mtime would trust a clock.
 *
 *  What is cached is the boolean and nothing else. The compiler's diagnostics
 *  go to stderr as a side effect of typechecking, so a cache hit does not
 *  reprint them; the finding text points at `orbit check` for the detail rather
 *  than claiming "see the error above", which would be a promise a cache hit
 *  cannot keep. */
/** @brief A fingerprint of everything the semantic check of `file` depends on.
 *
 *  The dependency is NOT the file. checkSourceWithFile resolves and typechecks
 *  the transitive import closure, so the answer changes when a module this file
 *  imports changes. Keying the cache on this file's own bytes therefore kept a
 *  stale "clean" answer alive across an edit to an imported module: doctor
 *  called a file clean that `orbit check` rejected on the same tree, and the
 *  only reason the compiler was right and the cache was wrong is that the key
 *  was narrower than the computation.
 *
 *  The walk mirrors resolveModuleAST: same declaration order, same path
 *  resolution, each module visited once. An approximation here would be worse
 *  than no cache at all, because it errs in the direction that hides errors.
 *
 *  `memo` is shared across the run and holds one entry per module, so the tree
 *  pays for one closure walk in total instead of one per file -- which is the
 *  5.8x amplification the resolver's per-file traversal costs today.
 */
fn doctorClosureFingerprintReuse(path: string, source: string, imports: list, knownFiles: list, knownImports: list, knownSources: list, memo: list) -> string {
    val seen = [path]
    val acc = doctorClosureWalkReuse(path, source, imports, seen, knownFiles, knownImports, knownSources, memo)
    return acc + ":" + orbit_string_hash_selfhost(source)
}

/** @brief doctorClosureWalk, but reading imports this run already parsed.
 *
 *  Same traversal and same order as doctorClosureWalk; the only difference is
 *  where an import's own import list comes from. A module inside the scanned
 *  tree was parsed in the pass above, so asking again costs a second parse of
 *  the whole tree to rediscover a graph we already walked. A module outside it
 *  is read and parsed, which is the same as the resolver will do. */
fn doctorClosureWalkReuse(path: string, source: string, imports: list, seen: list, knownFiles: list, knownImports: list, knownSources: list, memo: list) -> string {
    val baseDir = getDir(path)
    var acc = ""
    var i = 0
    while i < imports.len() {
        val rel: string = imports.get(i)
        val full = normalizePath(resolveFilePath(baseDir, rel))
        if doctorListContains(seen, full) {
            // Already walked in this closure: reaching a module twice adds
            // nothing, and recursing on it again is how a cyclic import becomes
            // infinite.
            i = i + 1
        } else {
            seen.push(full)
            val at = doctorIndexOfFile(knownFiles, full)
            if at >= 0 {
                val sub: string = knownImports.get(at)
                val subSource: string = knownSources.get(at)
                acc = acc + "|" + doctorModuleFingerprintReuse(full, subSource, sub, seen, knownFiles, knownImports, knownSources, memo)
            } else {
                val subSource2 = orbit_file_read_selfhost(full)
                if subSource2 == "" {
                    // A MISSING import is part of the answer too, so its absence
                    // is in the fingerprint: creating the file later turns an
                    // import error into something else, and the entry written
                    // before it must not survive that.
                    acc = acc + "|missing:" + full
                } else {
                    val parser = initParser(subSource2)
                    val ast2 = parseProgram(parser)
                    val subImports = []
                    doctorCollectImports(ast2, subImports)
                    acc = acc + "|" + doctorModuleFingerprintReuse(full, subSource2, subImports, seen, knownFiles, knownImports, knownSources, memo)
                }
            }
            i = i + 1
        }
    }
    return acc
}

/** @brief One module's contribution, memoized across the whole run. */
fn doctorModuleFingerprintReuse(path: string, source: string, imports: list, seen: list, knownFiles: list, knownImports: list, knownSources: list, memo: list) -> string {
    val hit = doctorMemoLookup(memo, path)
    if hit != "" { return hit }
    val sub = doctorClosureWalkReuse(path, source, imports, seen, knownFiles, knownImports, knownSources, memo)
    val digest = sub + ":" + orbit_string_hash_selfhost(source)
    memo.push(path + "=" + digest)
    return digest
}

/** @brief Where `path` sits in the parallel lists of the parse pass, or -1. */
fn doctorIndexOfFile(knownFiles: list, path: string) -> int {
    var i = 0
    while i < knownFiles.len() {
        val p: string = knownFiles.get(i)
        if p == path { return i }
        i = i + 1
    }
    return -1
}

/** @brief The memoized digest for `path`, or "" when it is not there yet. */
fn doctorMemoLookup(memo: list, path: string) -> string {
    val prefix = path + "="
    var i = 0
    while i < memo.len() {
        val e: string = memo.get(i)
        if doctorStartsWith(e, prefix) {
            return orbit_string_slice(e, orbit_string_len(prefix), orbit_string_len(e))
        }
        i = i + 1
    }
    return ""
}

/** @brief Every import path in declaration order, which is resolution order. */
fn doctorCollectImports(node: ASTNode, out: list) {
    match node {
        ASTNode.Program(p) => {
            var i = 0
            while i < p.decls.len() {
                doctorCollectImports(p.decls.get(i), out)
                i = i + 1
            }
        }
        ASTNode.ImportStmt(imp) => {
            out.push(stripQuotes(imp.path))
        }
        _ => {}
    }
}

/** @brief Imports whose module contributes nothing this file uses.
 *
 *  An import is dead when the file names none of the module's public
 *  declarations: no fn, no model, no route. The module's own source is parsed to
 *  learn its exported names, because the alternative -- assume an import is
 *  used -- is what keeps dead imports alive forever.
 *
 *  Deliberately NOT reported: an import of a module whose only contribution is a
 *  side effect (a std module that registers something at load, say). The check
 *  cannot see a side effect, so it only fires when the file provably names
 *  nothing, which is a claim the text supports. */
fn doctorCheckUnusedImports(stats: DoctorStats, file: string, refs: list, imports: list, baseDir: string) {
    var i = 0
    while i < imports.len() {
        val rel: string = imports.get(i)
        i = i + 1
        val full = normalizePath(resolveFilePath(baseDir, rel))
        val modSource = orbit_file_read_selfhost(full)
        if modSource == "" {}
        if modSource != "" {
            val exports = doctorModuleExports(modSource)
            // The module's OWN imports count too. A file can import a module
            // for a symbol that module re-exports, or for the externs its own
            // imports make available, and legitimately name neither. Requiring
            // the module's own closure to be unnamed too is the difference
            // between reporting dead imports and reporting the module system:
            // without it, removing the flagged imports from io.orb and
            // bytes.orb broke both files at the very next build.
            val closureRefs = doctorClosureRefs(full, modSource)
            if exports.len() > 0 && doctorRefsHitAny(refs, exports) == false {
                if doctorRefsHitAny(closureRefs, exports) == false {
                    doctorReport(stats, file, 1, "D012", "this file imports " + rel + " but names none of its declarations, directly or through what they import.", "delete the import, or use what it brings in; a module nothing in its own closure names here is dead weight in every file that pulls it.")
                }
            }
        }
    }
}

/** @brief Every name a module references, plus what its own imports export.
 *
 *  One level of imports, which covers the re-export and extern-availability
 *  cases without parsing the whole module graph once per importing file. */
fn doctorClosureRefs(modulePath: string, moduleSource: string) -> list {
    val refs = []
    val parser = initParser(moduleSource)
    val ast = parseProgram(parser)
    if parser.diagnostics.len() > 0 { return refs }
    doctorWalkRefs(ast, refs)
    val baseDir = getDir(modulePath)
    val imports = []
    doctorCollectImports(ast, imports)
    var i = 0
    while i < imports.len() {
        val rel: string = imports.get(i)
        i = i + 1
        val subSource = orbit_file_read_selfhost(normalizePath(resolveFilePath(baseDir, rel)))
        if subSource != "" {
            val subExports = doctorModuleExports(subSource)
            var k = 0
            while k < subExports.len() {
                val e: string = subExports.get(k)
                if doctorListContains(refs, e) == false { refs.push(e) }
                k = k + 1
            }
        }
    }
    return refs
}

/** @brief The public names a module source declares: fns, models, routes, types. */
fn doctorModuleExports(source: string) -> list {
    val out = []
    val lines = splitBuildLines(source)
    var i = 0
    while i < lines.len() {
        val t = doctorTrimLeft(doctorCodePart(lines.get(i)))
        val name = doctorDeclaredName(t)
        if name != "" {
            if doctorListContains(out, name) == false { out.push(name) }
        }
        i = i + 1
    }
    return out
}

/** @brief The declaration name on a line that begins a fn/model/route, or "".
 *
 *  Text-level on purpose: this runs over an import's source without building an
 *  AST for it, which would mean parsing every module in the tree twice. The
 *  shapes it accepts are the four declaration keywords, so a line that is a call
 *  or a comment contributes nothing. */
fn doctorDeclaredName(trimmedLine: string) -> string {
    // "extern fn" first: a module's runtime bindings are exported too, and a
    // file that imports hash.orb for orbit_hmac_sha256_base64url names an extern
    // fn and no other declaration. Checking "fn " first matched the tail of
    // "extern fn" and reported a module in use as dead.
    if doctorStartsWith(trimmedLine, "extern fn ") {
        val restE = doctorTrimSpace(orbit_string_slice(trimmedLine, 10, orbit_string_len(trimmedLine)))
        return doctorLeadingName(restE)
    }
    val kws = ["fn ", "model ", "route ", "type "]
    var i = 0
    while i < kws.len() {
        val kw: string = kws.get(i)
        if doctorStartsWith(trimmedLine, kw) {
            var rest = doctorTrimSpace(orbit_string_slice(trimmedLine, orbit_string_len(kw), orbit_string_len(trimmedLine)))
            if doctorStartsWith(rest, "private ") { return "" }
            if doctorStartsWith(rest, "extern ") { rest = doctorTrimSpace(orbit_string_slice(rest, 7, orbit_string_len(rest))) }
            // For a route the name is the METHOD; the interesting exports are the
            // handler's, which come on the next line. Routes are excluded by the
            // caller for now via this returning the method token, which is
            // referenced by nothing and so counts as unused correctly.
            return doctorLeadingName(rest)
        }
        i = i + 1
    }
    return ""
}

/** @brief Every name one subtree references, as a fresh list.
 *
 *  D012 asks a per-file question -- does THIS file name anything from what it
 *  imports -- so it cannot use the run-wide refs list, which is every name in
 *  every file and would make the check answer "yes" for any shared symbol. */
fn doctorRefsInSubtree(node: ASTNode) -> list {
    val refs = []
    doctorWalkRefs(node, refs)
    return refs
}

/** @brief Whether any name in `refs` appears in `names`. */
fn doctorRefsHitAny(refs: list, names: list) -> bool {
    var i = 0
    while i < refs.len() {
        if doctorListContains(names, refs.get(i)) { return true }
        i = i + 1
    }
    return false
}

fn doctorTypecheckByFingerprint(stats: DoctorStats, file: string, source: string, fingerprint: string, cacheState: list) -> bool {
    val dir = doctorCacheDir()
    val digest = orbit_string_hash_selfhost(fingerprint)
    var path = ""
    if dir != "" && digest != "" {
        if doctorCacheReady(dir, cacheState) {
            path = doctorJoinPath(dir, digest + ".ok")
        }
    }
    if path != "" {
        val probe = orbit_file_read_selfhost(path)
        if probe == "ok" { return true }
        if probe == "bad" { return false }
    }
    val start = orbit_clock_ms()
    val okRes = checkSourceWithFile(source, file)
    stats.semaMs = stats.semaMs + (orbit_clock_ms() - start)
    if path != "" {
        if okRes {
            orbit_file_write_selfhost(path, "ok")
        } else {
            orbit_file_write_selfhost(path, "bad")
        }
    }
    return okRes
}

/** @brief Whether the cache directory exists and is writable, creating it once.
 *
 *  Probed by writing a file rather than by asking the OS: the question is not
 *  "does this path exist" but "will the writes that follow survive", and a
 *  directory that exists but is read-only answers differently. The probe is
 *  remembered so a large tree does not rewrite it once per file. */
fn doctorCacheReady(dir: string, cacheState: list) -> bool {
    if doctorListContains(cacheState, dir) { return true }
    val probe = doctorJoinPath(dir, ".writable")
    val existing = orbit_file_read_selfhost(probe)
    if existing == "yes" {
        cacheState.push(dir)
        return true
    }
    if orbit_os_mkdir_selfhost(dir) == false { return false }
    if orbit_file_write_selfhost(probe, "yes") == false { return false }
    cacheState.push(dir)
    return true
}

fn doctorRun(opts: DoctorOptions) {
    val stats = DoctorStats(0, 0, opts.jsonMode, opts.quiet, opts.color, [], 0, 0, 0, 0)
    val ioStart = orbit_clock_ms()
    var files = doctorCollectOrbFiles(opts.dir)
    if files.len() == 0 {
        val probe = orbit_file_read_selfhost(opts.dir)
        if probe != "" {
            files.push(opts.dir)
        }
    }
    if files.len() == 0 {
        print("doctor: no .orb files found under \"" + opts.dir + "\"; nothing to check.")
        orbit_os_exit_selfhost(1)
        return
    }
    val sources = []
    var fi2 = 0
    while fi2 < files.len() {
        val fp2: string = files.get(fi2)
        sources.push(orbit_file_read_selfhost(fp2))
        fi2 = fi2 + 1
    }
    stats.ioMs = (orbit_clock_ms() - ioStart)
    // Every file is split exactly once, here, and the list is threaded to every
    // consumer. Splitting inside the consumers meant one split per declaration
    // (780 of them over the compiler itself), because splitBuildLines slices
    // the string once per line and every slice measures the whole string.
    //
    // This is a text pass, so it is charged to textMs rather than to ioMs: the
    // io clock stops at the last read, and a phase that reports the wrong number
    // is worse than one that reports nothing.
    val textStart0 = orbit_clock_ms()
    val fileLines = []
    var li = 0
    while li < files.len() {
        val lsrc: string = sources.get(li)
        fileLines.push(splitBuildLines(lsrc))
        li = li + 1
    }
    stats.textMs = stats.textMs + (orbit_clock_ms() - textStart0)
    stats.files = files.len()
    doctorCheckToolchain(stats)

    // The fix pass runs over the findings, not over the files. That ordering is
    // the difference between "fix what it found" and "tidy every file it
    // opened": a file with no findings is not rewritten, so a fix can never
    // change a byte the analysis did not point at.
    val routes = []
    val decls = []
    val refs = []
    // What the parse pass produced, kept for the fingerprint pass. Parsing a
    // file twice to find its imports is the one cost the cache cannot absorb.
    val parsedFiles = []
    val parsedAsts = []
    val parsedImports = []
    val parsedSources = []
    var i = 0
    while i < files.len() {
        val fp3: string = files.get(i)
        val src3: string = sources.get(i)
        if src3 == "" {
            doctorReport(stats, fp3, 1, "D008", "file is empty or could not be read.", "add content, or drop the path from the scan.")
        } else {
            // The text scans get their own clock rather than being inferred as
            // "the rest of the loop": a total that wraps three phases is not a
            // measurement of any of them, and the budgets are per phase.
            val textStart = orbit_clock_ms()
            val fplines: list = fileLines.get(i)
            doctorCollectRoutes(fplines, fp3, routes)
            doctorScanSystem(stats, fplines, fp3)
            doctorScanLiterals(stats, fplines, fp3)
            doctorScanMutableRoutes(stats, fplines, fp3)
            doctorScanLoops(stats, fplines, fp3)
            doctorScanMutableDecls(stats, fplines, fp3)
            val slen = orbit_string_len(src3)
            val endsNl = false
            if slen > 0 {
                if orbit_string_char_at_selfhost(src3, slen - 1) == 10 { endsNl = true }
            }
            doctorScanStyle(stats, fplines, fp3, doctorEolOf(src3), endsNl)
            stats.textMs = stats.textMs + (orbit_clock_ms() - textStart)
            val astStart = orbit_clock_ms()
            val parser = initParser(src3)
            val ast = parseProgram(parser)
            if parser.diagnostics.len() == 0 {
                doctorCollectDecls(ast, fplines, fp3, decls)
                doctorWalkRefs(ast, refs)
                doctorScanFunctions(stats, ast, fp3, fplines)
                // Kept for the fingerprint pass below, which needs this file's
                // imports. Without it the fingerprint re-parses every file in
                // the tree, which is the parse the line above just paid for.
                val imps = []
                doctorCollectImports(ast, imps)
                parsedFiles.push(fp3)
                parsedAsts.push(ast)
                parsedImports.push(imps)
                parsedSources.push(src3)
                // D012 needs, per file, the names it references and the modules
                // it imports, checked together after the walk. Recorded here
                // because the refs walk above already produced the names and
                // re-walking per import would be a second traversal.
                doctorCheckUnusedImports(stats, fp3, doctorRefsInSubtree(ast), imps, getDir(fp3))
            } else {
                // A parse failure is a finding, and it is the one D008 case that
                // costs nothing: the parser just said so. Reporting it here is
                // what keeps a file that cannot be parsed from being reported
                // as CLEAN, which is what happens if this is left to the
                // typecheck -- the typecheck is skipped for exactly these files,
                // so a check that waits for it waits forever.
                val pd: ParserDiagnostic = parser.diagnostics.get(0)
                doctorReport(stats, fp3, pd.line, "D008", "this file does not parse, so no analysis beyond the text checks could run on it (" + pd.message + ").", "run `orbit check " + fp3 + "` and fix the first parse error.")
            }
            stats.astMs = stats.astMs + ((orbit_clock_ms() - astStart))
        }
        i = i + 1
    }
    // Second pass, and it has to be a second pass: the fingerprint of a file
    // depends on its import CLOSURE, so a file's key can need the import list of
    // a module that has not been parsed yet. Doing it after the parse pass also
    // means the closure reads parses this run already paid for, instead of
    // re-parsing the whole tree to rediscover the edges of the graph.
    val closureMemo = []
    val cacheState = []
    var pi = 0
    while pi < parsedFiles.len() {
        val pfile: string = parsedFiles.get(pi)
        val psrc: string = parsedSources.get(pi)
        val pimps: list = parsedImports.get(pi)
        val fingerprint = doctorClosureFingerprintReuse(pfile, psrc, pimps, parsedFiles, parsedImports, parsedSources, closureMemo)
        val okRes = doctorTypecheckByFingerprint(stats, pfile, psrc, fingerprint, cacheState)
        if okRes == false {
            doctorReport(stats, pfile, 1, "D008", "this file does not pass the compiler's semantic checks.", "run `orbit check " + pfile + "` and address the first error. (The detail is not reprinted here: it comes from the typecheck, which a cached answer skips.)")
        }
        pi = pi + 1
    }
    doctorCheckRoutes(stats, routes)
    doctorCheckUnused(stats, decls, refs, files, sources, fileLines)
    doctorCheckTelemetry(stats, routes, opts)

    doctorApplyFixes(stats, opts, files, sources)
    val baseline = doctorLoadBaseline(opts.baseline)
    val printed = doctorPrintFindings(stats, opts, baseline)
    if opts.verbose {
        print("doctor: scanned " + orbit_int_to_string_selfhost(stats.files) + " files under \"" + opts.dir + "\".")
        print("doctor: " + orbit_int_to_string_selfhost(printed) + " finding(s) shown, " + orbit_int_to_string_selfhost(stats.findings) + " reported.")
        print("doctor: " + orbit_int_to_string_selfhost(stats.textMs) + " ms text, " + orbit_int_to_string_selfhost(stats.astMs) + " ms ast, " + orbit_int_to_string_selfhost(stats.semaMs) + " ms semantic, " + orbit_int_to_string_selfhost(stats.ioMs) + " ms io.")
    }
    if opts.quiet == false && opts.jsonMode == false {
        doctorPrintGates()
    }
    // Counts the findings the reader can SEE, which is what "1 error, 0 warnings"
    // has to mean. Counting the unfiltered set made `--only D006` print one
    // warning and then report the error it had just hidden, which is the kind of
    // summary that teaches people not to read summaries.
    var errCount = 0
    var warnCount = 0
    var si = 0
    while si < stats.findItems.len() {
        val sf: DoctorFinding = stats.findItems.get(si)
        si = si + 1
        if doctorFiltered(sf, opts) {} else {
            if sf.severity == "error" {
                errCount = errCount + 1
            } else {
                warnCount = warnCount + 1
            }
        }
    }
    val shownTotal = errCount + warnCount
    if stats.findings == 0 {
        if opts.quiet == false && opts.jsonMode == false {
            print("doctor: no findings in " + orbit_int_to_string_selfhost(stats.files) + " files under \"" + opts.dir + "\".")
        }
    } else {
        if opts.quiet == false && opts.jsonMode == false {
            print("doctor: " + orbit_int_to_string_selfhost(shownTotal) + " finding(s) (" + orbit_int_to_string_selfhost(errCount) + " error(s), " + orbit_int_to_string_selfhost(warnCount) + " warning(s)) in " + orbit_int_to_string_selfhost(stats.files) + " files under \"" + opts.dir + "\".")
            if shownTotal != stats.findings {
                print("doctor: " + orbit_int_to_string_selfhost(stats.findings - shownTotal) + " finding(s) hidden by --only/--skip/--min-severity.")
            }
        }
        if printed > 0 { orbit_os_exit_selfhost(1) }
    }
}

/** @brief Whether this finding is shown and counted toward the exit code.
 *
 *  A finding in the baseline is printed and marked, and does not fail the run.
 *  That is the whole mechanism for adopting thirty checks at once: the ones you
 *  have not fixed yet are visible, and only the ones you have never looked at
 *  are allowed to be invisible. */
fn doctorFiltered(f: DoctorFinding, opts: DoctorOptions) -> bool {
    if opts.codeFilter != "" {
        if doctorListHasCode(opts.codeFilter, f.code) == false { return true }
    }
    if opts.codeSkip != "" {
        if doctorListHasCode(opts.codeSkip, f.code) { return true }
    }
    if opts.minSeverity != "" {
        if f.severity == "error" { return false }
        if opts.minSeverity == "error" { return true }
    }
    return false
}

fn doctorListHasCode(csv: string, code: string) -> bool {
    var i = 0
    var cur = ""
    var guard = 0
    while guard < 256 {
        guard = guard + 1
        if i >= orbit_string_len(csv) {
            if doctorTrimSpace(cur) == code { return true }
            return false
        }
        val c = csv.at(i)
        if c == 44 {
            if doctorTrimSpace(cur) == code { return true }
            cur = ""
        } else {
            cur = cur + csv.slice(i, i + 1)
        }
        i = i + 1
    }
    return false
}

fn doctorTrimSpace(s: string) -> string {
    var start = 0
    var end = orbit_string_len(s)
    while start < end && doctorIsSpace(s.at(start)) { start = start + 1 }
    while end > start && doctorIsSpace(s.at(end - 1)) { end = end - 1 }
    if end <= start { return "" }
    return s.slice(start, end)
}

fn doctorIsSpace(c: int) -> bool {
    if c == 32 { return true }
    if c == 9 { return true }
    if c == 10 { return true }
    if c == 13 { return true }
    return false
}

/** @brief The identity of a finding, as a baseline line reads it. */
fn doctorFingerprint(f: DoctorFinding) -> string {
    return f.code + " " + f.file + ":" + orbit_int_to_string_selfhost(f.line)
}

fn doctorLoadBaseline(path: string) -> list {
    var out = []
    if path == "" { return out }
    val text = orbit_file_read_selfhost(path)
    if text == "" { return out }
    val lines = splitBuildLines(text)
    var i = 0
    while i < lines.len() {
        val l = doctorTrimSpace(lines.get(i))
        if l != "" {
            if l.at(0) != 35 {
                out.push(l)
            }
        }
        i = i + 1
    }
    return out
}

/** @brief Print the findings, honouring the filters, and return how many were
 *         counted toward the exit code.
 *
 *  Three things are shown but NOT counted, and each is a promise the run makes
 *  to the reader: a finding in the baseline is one you have already decided to
 *  live with, and a finding this run applied is one that is now gone. Counting
 *  either would mean `--fix` could never return success, and a gate nobody can
 *  turn green is a gate everybody turns off. */
fn doctorPrintFindings(stats: DoctorStats, opts: DoctorOptions, baseline: list) -> int {
    if opts.jsonMode {
        print("[")
    }
    var counted = 0
    var ti = 0
    var firstJson = true
    while ti < stats.findItems.len() {
        val tf: DoctorFinding = stats.findItems.get(ti)
        if doctorFiltered(tf, opts) == false {
            val known = baseline.len() > 0 && doctorListContains(baseline, doctorFingerprint(tf))
            val fixed = tf.applied == "applied"
            if known == false && fixed == false {
                counted = counted + 1
            }
            if opts.jsonMode {
                if firstJson == false { print(",") }
                firstJson = false
                print(doctorRenderJson(tf))
            } else {
                print(doctorRenderText(stats, opts.dir, tf))
                if known {
                    print("  (in baseline: known finding, not counted toward the exit code)")
                }
                if fixed {
                    if tf.verified == "" {
                        print("  fix: applied")
                    } else {
                        print("  fix: applied (verified: " + tf.verified + ")")
                    }
                } else if tf.applied != "" {
                    print("  fix: " + tf.applied)
                }
            }
        }
        ti = ti + 1
    }
    if opts.jsonMode {
        print("]")
    }
    return counted
}

/** @brief Run the fix engine over every finding that carries an edit.
 *
 *  One pass over the findings, edits gathered per file, then one apply per file:
 *  two fixes to different parts of one file must not each read a version the
 *  other already changed. */
fn doctorApplyFixes(stats: DoctorStats, opts: DoctorOptions, files: list, sources: list) {
    if opts.fixMode == false { return }
    val perFile = []
    var i = 0
    while i < files.len() {
        perFile.push([])
        i = i + 1
    }
    var any = false
    var fi = 0
    while fi < stats.findItems.len() {
        val f: DoctorFinding = stats.findItems.get(fi)
        fi = fi + 1
        val edits = f.edits
        // Every branch below either moves on or opts out. The one thing this loop
        // must never do is fall through: advancing the index AND carrying on
        // processes the same finding twice, which is how `--fix` came to skip
        // every finding that followed one without edits. Since D008 is reported
        // first and carries no edits, that was most of them.
        if doctorEditsAreSafe(edits) == false && opts.unsafeMode == false {
            f.applied = "not applied: this fix is structural; re-run with --fix --unsafe to apply it"
        } else {
            var target = -1
            var gi = 0
            while gi < files.len() {
                if files.get(gi) == f.file { target = gi }
                gi = gi + 1
            }
            if target < 0 {
                f.applied = "not applied: doctor could not find " + f.file + " among the files it scanned"
            } else {
                val bucket = perFile.get(target)
                var e = 0
                while e < edits.len() {
                    bucket.push(edits.get(e))
                    e = e + 1
                }
                any = true
            }
        }
    }
    if any == false { return }
    var pi = 0
    while pi < files.len() {
        val edits = perFile.get(pi)
        if edits.len() > 0 {
            val outcome = doctorFixFile(stats, files.get(pi), sources.get(pi), edits, opts.unsafeMode, opts.verifyBuild, opts.dryRun)
            var fi2 = 0
            while fi2 < stats.findItems.len() {
                val f: DoctorFinding = stats.findItems.get(fi2)
                if f.file == files.get(pi) && f.applied == "" {
                    if f.edits.len() > 0 {
                        f.applied = outcome
                        if opts.verifyBuild {
                            f.verified = "front end and C step"
                        } else {
                            f.verified = "front end only (--fast)"
                        }
                    }
                }
                fi2 = fi2 + 1
            }
        }
        pi = pi + 1
    }
}

fn runDoctor() {
    val opts = DoctorOptions(".", false, false, false, false, "auto", false, false, false, "", "", "", "", "", "")
    val seenFlags = []
    var dirSet = false
    var i = 2
    while true {
        val a = orbit_os_argv_selfhost(i)
        if a == "" { break }
        if a == "--help" || a == "-h" {
            doctorPrintHelp()
            return
        }
        if a == "--quiet" {
            opts.quiet = true
        } else if a == "--verbose" {
            opts.verbose = true
        } else if a == "--fix" {
            opts.fixMode = true
        } else if a == "--unsafe" {
            opts.unsafeMode = true
        } else if a == "--verify-build" {
            opts.verifyBuild = true
        } else if a == "--fast" {
            opts.verifyBuild = false
        } else if a == "--dry-run" {
            opts.dryRun = true
        } else if a == "--format" || a == "--color" || a == "--only" || a == "--skip" || a == "--min-severity" || a == "--baseline" || a == "--telemetry" || a == "--budget-doc" {
            val name = a
            val v = orbit_os_argv_selfhost(i + 1)
            if v == "" {
                doctorUsage()
                orbit_os_exit_selfhost(2)
                return
            }
            if doctorListContains(seenFlags, name) {
                doctorUsage()
                orbit_os_exit_selfhost(2)
                return
            }
            seenFlags.push(name)
            i = i + 1
            if name == "--format" {
                if v == "text" { opts.jsonMode = false }
                else if v == "json" { opts.jsonMode = true }
                else { doctorUsage() orbit_os_exit_selfhost(2) return }
            } else if name == "--color" {
                if v == "always" || v == "never" || v == "auto" { opts.color = v }
                else { doctorUsage() orbit_os_exit_selfhost(2) return }
            } else if name == "--only" {
                opts.codeFilter = v
            } else if name == "--skip" {
                opts.codeSkip = v
            } else if name == "--min-severity" {
                if v == "warning" || v == "error" { opts.minSeverity = v }
                else { doctorUsage() orbit_os_exit_selfhost(2) return }
            } else if name == "--baseline" {
                opts.baseline = v
            } else if name == "--telemetry" {
                opts.telemetry = v
            } else if name == "--budget-doc" {
                opts.budgetDoc = v
            }
        } else if doctorStartsWith(a, "-") {
            doctorUsage()
            orbit_os_exit_selfhost(2)
            return
        } else {
            if dirSet {
                doctorUsage()
                orbit_os_exit_selfhost(2)
                return
            }
            dirSet = true
            opts.dir = a
        }
        i = i + 1
    }
    // --verify-build is on by default for a fix pass and off otherwise, so the
    // flag names what it changes instead of what it turns on. A fix that
    // typechecks and miscompiles is the failure this exists to prevent.
    if opts.fixMode && doctorListContains(seenFlags, "--verify-build") == false && doctorListContains(seenFlags, "--fast") == false {
        opts.verifyBuild = true
    }
    doctorRun(opts)
}
