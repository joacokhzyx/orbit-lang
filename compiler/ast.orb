// Orbit Self-Hosted Compiler - Abstract Syntax Tree Definitions
// compiler/ast.orb

model Loc {
    line: int
    column: int
}

model ParamNode {
    name: string
    typeName: string
}

model FieldInitNode {
    name: string
    value: list
}

model TypeAnnotationNode {
    token: string
    isNullable: bool
}

model GenericParamNode {
    name: string
    constraint: string
}

model DecoratorNode {
    name: string
    arguments: list
}

model FieldDeclNode {
    name: string
    fieldType: string
    decorators: list
}

model ModelDeclNode {
    name: string
    fields: list
    genericParams: list
}

model TypeDeclNode {
    name: string
    kind: string
    variants: list
    baseType: string
    variantPayloads: list
}

model FunctionDeclNode {
    name: string
    params: list
    paramTypes: list
    returnType: string
    body: list
    isAsync: bool
    isPrivate: bool
    isExtern: bool
    genericParams: list
}

model RouteDeclNode {
    http_method: string
    path: string
    decorators: list
    body: list
    has_limit: bool
    limit_rate: int
    limit_window_ms: int
    limit_burst: int
}

model TraitDeclNode {
    name: string
    genericParams: list
    methods: list
    isPrivate: bool
}

model ImplDeclNode {
    traitName: string
    typeName: string
    methods: list
}

model VarDeclNode {
    name: string
    isMutable: bool
    value: list
    typeAnnotation: string
}

model ConstDeclNode {
    name: string
    value: list
    isPrivate: bool
}

model ScheduleDeclNode {
    amount: string
    unit: string
    atTime: string
    handler: list
}

model ConfigDeclNode {
    key: string
    value: string
}

model ImportStmtNode {
    path: string
}

model UseStmtNode {
    module: string
}

model ExpressionStmtNode {
    expr: list
}

model ProgramNode {
    decls: list
}

model LiteralNode {
    valType: string
    text: string
}

// A string literal that contained "${", split into its literal chunks (plain
// strings, still unprocessed) and the expressions between them, in order.
// isRaw records that the source was triple-quoted, so literal chunks keep
// their backslashes and quotes instead of being unescaped.
model InterpNode {
    parts: list
    isRaw: bool
}

// An object literal: { key: value, ... }. Fields are FieldInitNodes, which
// already existed for another purpose and fit exactly. The point of the
// literal is that it is a real value -- readable, nestable, passable -- and
// not just text assembled for a response.
model ObjectLiteralNode {
    fields: list
}

model BlockNode {
    statements: list
}

model IfNode {
    condition: list
    thenBody: list
    elseBody: list
}

model WhileNode {
    condition: list
    body: list
}

model ForNode {
    item: string
    iterable: list
    body: list
}

model ReturnNode {
    expr: list
}

model ReturnOkNode {
    expr: list
    status: string
}

model ReturnErrNode {
    expr: list
    code: string
}

model MatchNode {
    expr: list
    cases: list
    // The `match` keyword's own line and column. Sema reports a non-exhaustive
    // match against this position and no other node carries one, because no
    // other node is reported on. Plain ints, the shape every other position in
    // the compiler already has (Token.line, ParserDiagnostic.column).
    line: int
    col: int
}

model MatchCaseNode {
    pattern: list
    body: list
}

model TryNode {
    expr: list
    catchBody: list
    errName: string
}

model BinaryOpNode {
    op: string
    lhs: list
    rhs: list
    // Where the operator was. A division by a zero divisor is reported
    // against this, and without it the diagnostic could only name the
    // function the expression was emitted into.
    line: int
    col: int
}

model UnaryOpNode {
    op: string
    operand: list
}

model CallNode {
    callee: list
    args: list
    // Where the `(` was. Sema reports a constant index that is past the end of
    // a list or a string against this, and it is the only way that check can
    // point at a line: the IR carries no position, so a runtime diagnostic can
    // only name the function it was emitted into.
    line: int
    col: int
}

model MemberAccessNode {
    object: list
    field: string
    // Where the '.' was. A field that a model does not declare is reported
    // against this, and without it the diagnostic could only name the
    // function it was emitted into.
    line: int
    col: int
}

model IndexAccessNode {
    object: list
    index: list
    line: int
    col: int
}

model ListLiteralNode {
    elements: list
}

model AssignmentNode {
    target: list
    value: list
}

model BreakNode {}

model ContinueNode {}

type ASTNode = Program(ProgramNode) | FunctionDecl(FunctionDeclNode) | RouteDecl(RouteDeclNode) | ModelDecl(ModelDeclNode) | TypeDecl(TypeDeclNode) | FieldDecl(FieldDeclNode) | TraitDecl(TraitDeclNode) | ImplDecl(ImplDeclNode) | VarDecl(VarDeclNode) | ConstDecl(ConstDeclNode) | ScheduleDecl(ScheduleDeclNode) | ConfigDecl(ConfigDeclNode) | ImportStmt(ImportStmtNode) | UseStmt(UseStmtNode) | ExpressionStmt(ExpressionStmtNode) | If(IfNode) | While(WhileNode) | For(ForNode) | Return(ReturnNode) | ReturnOk(ReturnOkNode) | ReturnErr(ReturnErrNode) | Match(MatchNode) | MatchCase(MatchCaseNode) | Try(TryNode) | Literal(LiteralNode) | Interp(InterpNode) | ObjectLiteral(ObjectLiteralNode) | BinaryOp(BinaryOpNode) | UnaryOp(UnaryOpNode) | Call(CallNode) | MemberAccess(MemberAccessNode) | IndexAccess(IndexAccessNode) | ListLiteral(ListLiteralNode) | Assignment(AssignmentNode) | TypeAnnotation(TypeAnnotationNode) | GenericParam(GenericParamNode) | Decorator(DecoratorNode) | Block(BlockNode) | Break(BreakNode) | Continue(ContinueNode) | Param(ParamNode) | FieldInit(FieldInitNode) | Empty
