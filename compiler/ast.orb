// Orbit Self-Hosted Compiler - Abstract Syntax Tree Definitions
// compiler/ast.orb

model Loc {
    line: int
    column: int
}

model IdentifierNode {
    name: string
    loc: Loc
}

model ParamNode {
    name: string
    type_name: string
}

model FunctionNode {
    name: string
    params: list
    return_type: string
    is_async: bool
}

model RouteNode {
    http_method: string
    path: string
    body_statements: list
}

model ModelFieldNode {
    field_name: string
    type_name: string
}

model ModelNode {
    name: string
    fields: list
}

model ProgramNode {
    file_path: string
    functions: list
    routes: list
    models: list
}

fn createProgram(path: string) -> ProgramNode {
    return ProgramNode {
        file_path: path,
        functions: [],
        routes: [],
        models: []
    }
}

