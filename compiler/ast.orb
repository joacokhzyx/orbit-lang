// Orbit Self-Hosted Compiler - Abstract Syntax Tree Definitions
// compiler/ast.orb

import "memory.orb"

// --- DORB Architecture: Struct of Arrays (SoA) AST ---
// These structures represent the Phase 1 goal: Zero-Allocation Parsing.

type NodeIndex = int

model TokenSpan {
    start: int
    len: int
}

model ASTPool {
    kinds: ArrayPool // NodeKind (int)
    tokens: list     // TokenSpan
    
    // Graph Edges (Index-based pointers to other nodes in the pool)
    // -1 represents null/none
    lhs: ArrayPool 
    rhs: ArrayPool 
    extra: ArrayPool 
}

fn initASTPool() -> ASTPool {
    return ASTPool(initArrayPool(), [], initArrayPool(), initArrayPool(), initArrayPool())
}

// Node Kinds
fn kindProgram() -> int { return 1 }
fn kindFunctionDecl() -> int { return 2 }
fn kindModelDecl() -> int { return 3 }
fn kindVarDecl() -> int { return 4 }
fn kindReturn() -> int { return 5 }
fn kindCall() -> int { return 6 }
fn kindBinaryOp() -> int { return 7 }
fn kindIf() -> int { return 8 }
fn kindWhile() -> int { return 9 }
fn kindMatch() -> int { return 10 }
fn kindMatchCase() -> int { return 11 }
fn kindFieldDecl() -> int { return 12 }
fn kindTypeDecl() -> int { return 13 }
fn kindBlock() -> int { return 14 }
fn kindLiteralInt() -> int { return 101 }
fn kindLiteralString() -> int { return 102 }
fn kindIdentifier() -> int { return 100 }
