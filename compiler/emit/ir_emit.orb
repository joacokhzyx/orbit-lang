// IRv1 textual emitter for `orbit build --emit-ir <path>` (D1).
//
// Serializes the in-memory IRModule exactly as buildAST left it: the pipeline
// calls this before the optimizer and before the C backend, so registerTypes
// is the builder's list, not the inferred one (docs/IR_SPEC_ALIGNMENT.md §6,
// P1) except that "unknown" is written as "void*" (irTypeName), plus one extern entry per runtime symbol the module calls without
// declaring it (irRuntimeExterns).  The text form is docs/IR_SPEC.md §5: one root object
// {"irVersion":"1","module":{...}}, keys in model declaration order, compact
// JSON, one trailing LF.  Nothing here invents semantics: every opcode name is
// an IROpcode variant and every operand comes from the IRValue union.
//
// Fail-closed: JSON has no NaN/Infinity literal, so a non-finite float has no
// valid serialization (V-08).  emitIRv1 assumes finiteness; irNonFiniteFloat
// names the offender so the caller aborts instead of writing a document the
// loader would misread.
import "../host/extern.orb"
import "../ir/ir.orb"

fn irJsonHex2(code: int) -> string {
    val digits = "0123456789abcdef"
    val hi = code / 16
    val lo = code - hi * 16
    return orbit_string_slice(digits, hi, hi + 1) + orbit_string_slice(digits, lo, lo + 1)
}

// JSON string body escaping (RFC 8259).  c_backend's escapeString cannot be
// reused: it emits C's `\x1b`, which is not a JSON escape.  Bytes below 0x20
// and DEL become \u00XX; everything else (UTF-8 continuation bytes included,
// since the loop slices one byte at a time) passes through untouched.
fn irJsonEscape(s: string) -> string {
    var out = ""
    var i = 0
    while i < s.len() {
        val c = s.slice(i, i + 1)
        if c == "\\" {
            out = out + "\\\\"
        } else if c == "\"" {
            out = out + "\\\""
        } else if c == "\n" {
            out = out + "\\n"
        } else if c == "\r" {
            out = out + "\\r"
        } else if c == "\t" {
            out = out + "\\t"
        } else {
            val code = orbit_string_char_at_selfhost(c, 0)
            if code < 32 || code == 127 {
                out = out + "\\u00" + irJsonHex2(code)
            } else {
                out = out + c
            }
        }
        i = i + 1
    }
    return out
}

fn irJsonBool(v: bool) -> string {
    if v { return "true" }
    return "false"
}

// Appends into the caller's buffer.  The returning form allocated one buffer
// per call -- three per function, and a buffer reserves 64 KB up front -- so a
// 1012-function module charged ~190 MB for lists that are a few hundred bytes
// each.  Writing into the document buffer costs no extra allocation.
fn irAppendStringList(buf: string, items: list < string >) {
    orbit_cbuf_append_selfhost(buf, "[")
    var i = 0
    while i < items.len() {
        if i > 0 { orbit_cbuf_append_selfhost(buf, ",") }
        val s: string = items.get(i)
        orbit_cbuf_append_selfhost(buf, "\"" + irJsonEscape(s) + "\"")
        i = i + 1
    }
    orbit_cbuf_append_selfhost(buf, "]")
}

// The builder writes "unknown" for a value it could not type. The C backend
// declares such a register, parameter or return as `void*` (mapTypeToC), so the
// document says `void*`: one pointer word, nothing for a consumer to infer.
fn irTypeName(t: string) -> string {
    if t == "unknown" { return "void*" }
    return t
}

fn irAppendTypeList(buf: string, items: list < string >) {
    orbit_cbuf_append_selfhost(buf, "[")
    var i = 0
    while i < items.len() {
        if i > 0 { orbit_cbuf_append_selfhost(buf, ",") }
        val s: string = items.get(i)
        orbit_cbuf_append_selfhost(buf, "\"" + irJsonEscape(irTypeName(s)) + "\"")
        i = i + 1
    }
    orbit_cbuf_append_selfhost(buf, "]")
}

// One name per IROpcode variant, in §1 order (the union's declaration order).
// The trailing arm is unreachable while the union has exactly these 66
// variants; it returns no name rather than inventing one.
fn irOpcodeName(op: IROpcode) -> string {
    match op {
        IROpcode.nop => { return "nop" }
        IROpcode.load_const => { return "load_const" }
        IROpcode.load_var => { return "load_var" }
        IROpcode.store_var => { return "store_var" }
        IROpcode.decl_var => { return "decl_var" }
        IROpcode.add => { return "add" }
        IROpcode.sub => { return "sub" }
        IROpcode.mul => { return "mul" }
        IROpcode.div => { return "div" }
        IROpcode.mod => { return "mod" }
        IROpcode.eq => { return "eq" }
        IROpcode.ne => { return "ne" }
        IROpcode.lt => { return "lt" }
        IROpcode.le => { return "le" }
        IROpcode.gt => { return "gt" }
        IROpcode.ge => { return "ge" }
        IROpcode.and_op => { return "and_op" }
        IROpcode.or_op => { return "or_op" }
        IROpcode.not_op => { return "not_op" }
        IROpcode.neg => { return "neg" }
        IROpcode.begin_block => { return "begin_block" }
        IROpcode.end_block => { return "end_block" }
        IROpcode.call => { return "call" }
        IROpcode.ret => { return "ret" }
        IROpcode.jump => { return "jump" }
        IROpcode.jump_if_false => { return "jump_if_false" }
        IROpcode.alloc => { return "alloc" }
        IROpcode.free => { return "free" }
        IROpcode.db_get => { return "db_get" }
        IROpcode.db_set => { return "db_set" }
        IROpcode.db_all => { return "db_all" }
        IROpcode.db_where => { return "db_where" }
        IROpcode.http_response => { return "http_response" }
        IROpcode.label => { return "label" }
        IROpcode.copy => { return "copy" }
        IROpcode.arg => { return "arg" }
        IROpcode.load_field => { return "load_field" }
        IROpcode.store_field => { return "store_field" }
        IROpcode.switch_op => { return "switch_op" }
        IROpcode.type_info => { return "type_info" }
        IROpcode.list_create => { return "list_create" }
        IROpcode.list_push => { return "list_push" }
        IROpcode.list_get => { return "list_get" }
        IROpcode.list_set => { return "list_set" }
        IROpcode.list_len => { return "list_len" }
        IROpcode.list_pop => { return "list_pop" }
        IROpcode.map_create => { return "map_create" }
        IROpcode.map_set => { return "map_set" }
        IROpcode.map_get => { return "map_get" }
        IROpcode.map_has => { return "map_has" }
        IROpcode.map_delete => { return "map_delete" }
        IROpcode.map_keys => { return "map_keys" }
        IROpcode.result_ok => { return "result_ok" }
        IROpcode.result_err => { return "result_err" }
        IROpcode.result_unwrap => { return "result_unwrap" }
        IROpcode.result_is_ok => { return "result_is_ok" }
        IROpcode.result_unwrap_err => { return "result_unwrap_err" }
        IROpcode.union_create => { return "union_create" }
        IROpcode.union_get_tag => { return "union_get_tag" }
        IROpcode.union_get_data => { return "union_get_data" }
        IROpcode.bit_and => { return "bit_and" }
        IROpcode.bit_or => { return "bit_or" }
        IROpcode.bit_xor => { return "bit_xor" }
        IROpcode.shl => { return "shl" }
        IROpcode.shr => { return "shr" }
        IROpcode.bit_not => { return "bit_not" }
        _ => { return "" }
    }
}

// §5.2 value = none | intVal | floatVal | strVal | symVal | boolVal | regVal
//             | labelVal;  unused operands are exactly {"kind":"None"}.
fn irValueText(value: IRValue) -> string {
    if value == NULL { return "{\"kind\":\"None\"}" }
    match value {
        IRValue.Int(v) => { return "{\"kind\":\"Int\",\"value\":" + orbit_int_to_string_selfhost(v.value) + "}" }
        IRValue.Float(v) => { return "{\"kind\":\"Float\",\"value\":" + orbit_float_to_string_selfhost(v.value) + "}" }
        IRValue.String(v) => { return "{\"kind\":\"String\",\"value\":\"" + irJsonEscape(v.value) + "\"}" }
        IRValue.Sym(v) => { return "{\"kind\":\"Sym\",\"value\":\"" + irJsonEscape(v.value) + "\"}" }
        IRValue.Bool(v) => { return "{\"kind\":\"Bool\",\"value\":" + irJsonBool(v.value) + "}" }
        IRValue.Register(v) => { return "{\"kind\":\"Register\",\"value\":" + orbit_int_to_string_selfhost(v.value) + "}" }
        IRValue.Label(v) => { return "{\"kind\":\"Label\",\"value\":" + orbit_int_to_string_selfhost(v.value) + "}" }
        _ => { return "{\"kind\":\"None\"}" }
    }
}

// The text of one instruction returns a string: a few hundred bytes, so the
// `+` prefix copy inside it costs kilobytes, while the document and the
// function must not do this (that copy is what made emission quadratic).
fn irInstructionText(instr: IRInstruction) -> string {
    var out = "{\"opcode\":\"" + irOpcodeName(instr.opcode) + "\","
    out = out + "\"dest\":" + orbit_int_to_string_selfhost(instr.dest) + ","
    out = out + "\"operand1\":" + irValueText(instr.operand1) + ","
    out = out + "\"operand2\":" + irValueText(instr.operand2) + ","
    out = out + "\"operand3\":" + irValueText(instr.operand3) + ","
    out = out + "\"elemKind\":" + orbit_int_to_string_selfhost(instr.elemKind) + "}"
    return out
}

fn irAppendFunctionText(buf: string, f: IRFunction) {
    orbit_cbuf_append_selfhost(buf, "{\"name\":\"" + irJsonEscape(f.name) + "\",")
    orbit_cbuf_append_selfhost(buf, "\"params\":")
    irAppendStringList(buf, f.params)
    orbit_cbuf_append_selfhost(buf, ",\"paramTypes\":")
    irAppendTypeList(buf, f.paramTypes)
    orbit_cbuf_append_selfhost(buf, ",\"instructions\":[")
    var i = 0
    while i < f.instructions.len() {
        if i > 0 { orbit_cbuf_append_selfhost(buf, ",") }
        val instr: IRInstruction = f.instructions.get(i)
        orbit_cbuf_append_selfhost(buf, irInstructionText(instr))
        i = i + 1
    }
    orbit_cbuf_append_selfhost(buf, "],")
    orbit_cbuf_append_selfhost(buf, "\"registerCount\":" + orbit_int_to_string_selfhost(f.registerCount) + ",")
    orbit_cbuf_append_selfhost(buf, "\"registerTypes\":")
    irAppendTypeList(buf, f.registerTypes)
    orbit_cbuf_append_selfhost(buf, ",\"returnType\":\"" + irJsonEscape(irTypeName(f.returnType)) + "\",")
    orbit_cbuf_append_selfhost(buf, "\"isExtern\":" + irJsonBool(f.isExtern) + ",")
    orbit_cbuf_append_selfhost(buf, "\"routeMethod\":\"" + irJsonEscape(f.routeMethod) + "\",")
    orbit_cbuf_append_selfhost(buf, "\"routePath\":\"" + irJsonEscape(f.routePath) + "\",")
    orbit_cbuf_append_selfhost(buf, "\"routeHasLimit\":" + irJsonBool(f.routeHasLimit) + ",")
    orbit_cbuf_append_selfhost(buf, "\"routeLimitRate\":" + orbit_int_to_string_selfhost(f.routeLimitRate) + ",")
    orbit_cbuf_append_selfhost(buf, "\"routeLimitWindowMs\":" + orbit_int_to_string_selfhost(f.routeLimitWindowMs) + ",")
    orbit_cbuf_append_selfhost(buf, "\"routeLimitBurst\":" + orbit_int_to_string_selfhost(f.routeLimitBurst) + "}")
}

fn irAppendModelText(buf: string, m: IRModelDecl) {
    orbit_cbuf_append_selfhost(buf, "{\"name\":\"" + irJsonEscape(m.name) + "\",\"fields\":[")
    var i = 0
    while i < m.fields.len() {
        if i > 0 { orbit_cbuf_append_selfhost(buf, ",") }
        val f: IRModelField = m.fields.get(i)
        orbit_cbuf_append_selfhost(buf, "{\"name\":\"" + irJsonEscape(f.name) + "\",\"typeName\":\"" + irJsonEscape(f.typeName) + "\"}")
        i = i + 1
    }
    orbit_cbuf_append_selfhost(buf, "],")
    orbit_cbuf_append_selfhost(buf, "\"typeParams\":")
    irAppendStringList(buf, m.typeParams)
    orbit_cbuf_append_selfhost(buf, "}")
}

fn irAppendTypeText(buf: string, t: IRTypeDecl) {
    orbit_cbuf_append_selfhost(buf, "{\"name\":\"" + irJsonEscape(t.name) + "\",\"kind\":\"" + irJsonEscape(t.kind) + "\",")
    orbit_cbuf_append_selfhost(buf, "\"variants\":")
    irAppendStringList(buf, t.variants)
    orbit_cbuf_append_selfhost(buf, ",\"richVariants\":")
    irAppendStringList(buf, t.richVariants)
    orbit_cbuf_append_selfhost(buf, ",\"methods\":")
    irAppendStringList(buf, t.methods)
    orbit_cbuf_append_selfhost(buf, "}")
}

// A NaN fails `v != v`; ±Infinity fails `v - v != 0.0` because v - v is NaN.
// Reachable only if the builder ever produces IRValue.Float -- it does not at
// this pin -- so this is the defensive half of the V-08 rule.
fn irValueNonFinite(value: IRValue) -> bool {
    if value == NULL { return false }
    match value {
        IRValue.Float(v) => {
            if v.value != v.value { return true }
            val d = v.value - v.value
            if d != 0.0 { return true }
            return false
        }
        _ => { return false }
    }
}

// Returns "" when every float in the module is finite, else a description of
// the first offender (caller turns it into a diagnostic and aborts).
fn irNonFiniteFloat(module: IRModule) -> string {
    var fi = 0
    while fi < module.functions.len() {
        val f: IRFunction = module.functions.get(fi)
        var ii = 0
        while ii < f.instructions.len() {
            val instr: IRInstruction = f.instructions.get(ii)
            if irValueNonFinite(instr.operand1) || irValueNonFinite(instr.operand2) || irValueNonFinite(instr.operand3) {
                return "function '" + f.name + "' instruction " + orbit_int_to_string_selfhost(ii)
            }
            ii = ii + 1
        }
        fi = fi + 1
    }
    var gi = 0
    while gi < module.globals.len() {
        val g: IRGlobal = module.globals.get(gi)
        if irValueNonFinite(g.value) {
            return "global '" + g.name + "'"
        }
        gi = gi + 1
    }
    return ""
}

// A growable buffer, not `out = out + piece`.  `+` copies the whole prefix on
// every step, so the document cost the sum of its prefixes in time and in arena
// bytes -- quadratic in the output size, which is 550 MB of arena for the
// 550 KB document of compiler/front/lexer.orb.  The buffer is the same one
// std/string join/toUpper use (runtime/collections.c orbit_cbuf_append).
// A runtime symbol the module calls with no `extern fn` of its own gets one
// here, in the document only: the module the C backend reads is untouched, so
// the C is the same bytes. The parameters are the arguments the IR `call`
// carries. The leading `OrbitArena*` of a symbol in `functionNeedsArena` is
// added by the C backend at the call site and is not a parameter here. Types
// follow runtime/orbit_api.h; the `orbit_db_*` rows follow runtime/database.c,
// which the net header does not declare.
fn irExternDecl(name: string, params: list < string >, types: list < string >, ret: string) -> IRFunction {
    val f = initIRFunction(name)
    f.params = params
    f.paramTypes = types
    f.returnType = ret
    f.isExtern = true
    return f
}

fn irRuntimeExtern(name: string) -> IRFunction {
    if name == "orbit_string_len" { return irExternDecl(name, ["s"], ["string"], "int") }
    if name == "orbit_string_at" { return irExternDecl(name, ["s", "index"], ["string", "int"], "int") }
    if name == "orbit_string_slice" { return irExternDecl(name, ["s", "start", "end"], ["string", "int", "int"], "string") }
    if name == "orbit_string_slice_known_len" { return irExternDecl(name, ["s", "start", "end", "totalLen"], ["string", "int", "int", "int"], "string") }
    if name == "orbit_string_indexOf" || name == "orbit_string_find" { return irExternDecl(name, ["s", "substr"], ["string", "string"], "int") }
    if name == "orbit_object_create" { return irExternDecl(name, [], [], "object") }
    if name == "orbit_object_set_int" { return irExternDecl(name, ["o", "key", "v"], ["object", "string", "int"], "void") }
    if name == "orbit_object_set_float" { return irExternDecl(name, ["o", "key", "v"], ["object", "string", "float"], "void") }
    if name == "orbit_object_set_bool" { return irExternDecl(name, ["o", "key", "v"], ["object", "string", "bool"], "void") }
    if name == "orbit_object_set_string" { return irExternDecl(name, ["o", "key", "v"], ["object", "string", "string"], "void") }
    if name == "orbit_object_set_object" { return irExternDecl(name, ["o", "key", "v"], ["object", "string", "object"], "void") }
    if name == "orbit_object_set_list" { return irExternDecl(name, ["o", "key", "v"], ["object", "string", "list"], "void") }
    if name == "orbit_db_query_all" || name == "orbit_db_query_first" { return irExternDecl(name, ["table"], ["string"], "string") }
    if name == "orbit_db_query_where" { return irExternDecl(name, ["table", "condition"], ["string", "string"], "string") }
    if name == "orbit_db_query_where_p" { return irExternDecl(name, ["table", "condition", "param"], ["string", "string", "string"], "string") }
    if name == "orbit_db_query_get" { return irExternDecl(name, ["table", "id"], ["string", "string"], "string") }
    if name == "orbit_db_query_order" || name == "orbit_db_query_order_desc" { return irExternDecl(name, ["table", "column"], ["string", "string"], "string") }
    if name == "orbit_db_count_all" { return irExternDecl(name, ["table"], ["string"], "int") }
    if name == "orbit_db_insert" { return irExternDecl(name, ["table", "json"], ["string", "string"], "bool") }
    if name == "orbit_db_update" { return irExternDecl(name, ["table", "id", "json"], ["string", "string", "string"], "bool") }
    if name == "orbit_db_delete" { return irExternDecl(name, ["table", "id"], ["string", "string"], "bool") }
    if name == "system_uptime" || name == "system_pid" || name == "system_active_workers" || name == "system_http_requests_total" { return irExternDecl(name, [], [], "int") }
    if name == "system_latency_avg_us" || name == "system_latency_p50_us" || name == "system_latency_p95_us" || name == "system_latency_p99_us" { return irExternDecl(name, [], [], "int") }
    return initIRFunction("")
}

fn irHasFunctionNamed(module: IRModule, name: string) -> bool {
    var i = 0
    while i < module.functions.len() {
        val f: IRFunction = module.functions.get(i)
        if f.name == name { return true }
        i = i + 1
    }
    return false
}

// The extern entries the document adds, in order of first call.
fn irRuntimeExterns(module: IRModule) -> list < IRFunction > {
    val out: list < IRFunction > = []
    val seen: list < string > = []
    var fi = 0
    while fi < module.functions.len() {
        val f: IRFunction = module.functions.get(fi)
        var ii = 0
        while ii < f.instructions.len() {
            val instr: IRInstruction = f.instructions.get(ii)
            var isCall = false
            match instr.opcode {
                IROpcode.call => { isCall = true }
                _ => {}
            }
            if isCall {
                var callee = ""
                match instr.operand1 {
                    IRValue.String(s) => { callee = s.value }
                    IRValue.Sym(s) => { callee = s.value }
                    _ => {}
                }
                if callee != "" {
                    val ext = irRuntimeExtern(callee)
                    if ext.name != "" && irHasFunctionNamed(module, callee) == false {
                        var known = false
                        var si = 0
                        while si < seen.len() {
                            if seen.get(si) == callee { known = true }
                            si = si + 1
                        }
                        if known == false {
                            seen.push(callee)
                            out.push(ext)
                        }
                    }
                }
            }
            ii = ii + 1
        }
        fi = fi + 1
    }
    return out
}

fn emitIRv1(module: IRModule) -> string {
    val buf = orbit_cbuf_create_selfhost()
    orbit_cbuf_append_selfhost(buf, "{\"irVersion\":\"1\",\"module\":{\"functions\":[")
    var fi = 0
    while fi < module.functions.len() {
        if fi > 0 { orbit_cbuf_append_selfhost(buf, ",") }
        val f: IRFunction = module.functions.get(fi)
        irAppendFunctionText(buf, f)
        fi = fi + 1
    }
    val externs = irRuntimeExterns(module)
    var ei = 0
    while ei < externs.len() {
        if fi > 0 || ei > 0 { orbit_cbuf_append_selfhost(buf, ",") }
        val ext: IRFunction = externs.get(ei)
        irAppendFunctionText(buf, ext)
        ei = ei + 1
    }
    orbit_cbuf_append_selfhost(buf, "],\"globals\":[")
    var gi = 0
    while gi < module.globals.len() {
        if gi > 0 { orbit_cbuf_append_selfhost(buf, ",") }
        val g: IRGlobal = module.globals.get(gi)
        orbit_cbuf_append_selfhost(buf, "{\"name\":\"" + irJsonEscape(g.name) + "\",\"value\":" + irValueText(g.value) + ",\"typeName\":\"" + irJsonEscape(g.typeName) + "\"}")
        gi = gi + 1
    }
    orbit_cbuf_append_selfhost(buf, "],\"models\":[")
    var mi = 0
    while mi < module.models.len() {
        if mi > 0 { orbit_cbuf_append_selfhost(buf, ",") }
        val m: IRModelDecl = module.models.get(mi)
        irAppendModelText(buf, m)
        mi = mi + 1
    }
    orbit_cbuf_append_selfhost(buf, "],\"types\":[")
    var ti = 0
    while ti < module.types.len() {
        if ti > 0 { orbit_cbuf_append_selfhost(buf, ",") }
        val t: IRTypeDecl = module.types.get(ti)
        irAppendTypeText(buf, t)
        ti = ti + 1
    }
    orbit_cbuf_append_selfhost(buf, "],\"migrations\":")
    irAppendStringList(buf, module.migrations)
    orbit_cbuf_append_selfhost(buf, "}}\n")
    return orbit_cbuf_build_selfhost(buf)
}
