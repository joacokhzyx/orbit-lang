// Split from c_backend: C string templates for preamble, router, and
// server-main emission. Callers in c_backend own the IR; this file owns
// only the emitted C text shapes.
// globals carries ready-made "#define NAME value" lines (one per top-level
// val/const), rendered by the backend where IRGlobal/IRValue live.
fn routePreambleText(hasRoutes: bool, globals: string) -> string {
    var out = ""
    out = out + "#define ORBIT_CUSTOM_ROUTER\n"
    out = out + "#include \"socket_compat.h\"\n"
    out = out + "#include \"thread_pool.c\"\n"
    out = out + "#include \"runtime.h\"\n"
    out = out + "#include <signal.h>\n"
    out = out + "\n"
    if hasRoutes {
        out = out + "void orbit_print_kynx_gradient(const char* text) {\n"
        out = out + "    size_t len = strlen(text);\n"
        out = out + "    if (len == 0) return;\n"
        out = out + "    for (size_t i = 0; i < len; i++) {\n"
        out = out + "        float t = (float)i / (float)(len > 1 ? len - 1 : 1);\n"
        out = out + "        int r = (int)(96.0f + t * (30.0f - 96.0f));\n"
        out = out + "        int g = (int)(165.0f + t * (58.0f - 165.0f));\n"
        out = out + "        int b = (int)(250.0f + t * (138.0f - 250.0f));\n"
        out = out + "        printf(\"\\x1b[38;2;%d;%d;%dm%c\", r, g, b, text[i]);\n"
        out = out + "    }\n"
        out = out + "    printf(\"\\x1b[0m\");\n"
        out = out + "}\n"
        out = out + "\n"
    }
    // Memoised: the environment cannot change under a running server, and
    // this used to cost two getenv calls per logged request.
    out = out + "int orbit_color_enabled(void) {\n"
    out = out + "    static int cached = -1;\n"
    out = out + "    if (cached < 0) {\n"
    out = out + "        cached = 1;\n"
    out = out + "        const char* no_color = getenv(\"NO_COLOR\");\n"
    out = out + "        if (no_color != NULL && no_color[0] != 0) cached = 0;\n"
    out = out + "        const char* term = getenv(\"TERM\");\n"
    out = out + "        if (term != NULL && strcmp(term, \"dumb\") == 0) cached = 0;\n"
    out = out + "    }\n"
    out = out + "    return cached;\n"
    out = out + "}\n"
    out = out + "\n"
    // The server banner is server-only: emitting it into plain programs
    // leaves an unused static definition (a -Wall warning) for nothing.
    if hasRoutes {
        out = out + "void orbit_render_server_banner(int port, int num_workers, int kynx_enabled, double ready_ms) {\n"
        out = out + "    if (orbit_color_enabled() == 0) {\n"
        out = out + "        printf(\"\\n  Orbit 0.1.0\\n\\n\");\n"
        out = out + "        printf(\"   - Local: http://localhost:%d\\n\", port);\n"
        out = out + "        printf(\"   - Workers: %d\\n\", num_workers);\n"
        out = out + "        if (kynx_enabled) {\n"
        out = out + "            printf(\"   - Secured by Kynx.\\n\");\n"
        out = out + "        }\n"
        out = out + "        printf(\"\\n- Starting...\\n\");\n"
        out = out + "        printf(\"- Ready in %.1f ms\\n\\n\", ready_ms);\n"
        out = out + "        fflush(stdout);\n"
        out = out + "        return;\n"
        out = out + "    }\n"
        out = out + "    printf(\"\\n  Orbit 0.1.0\");\n"
        out = out + "    printf(\"\\n\\n\");\n"
        out = out + "\n"
        out = out + "    printf(\"   \\x1b[90m-\\x1b[0m \\x1b[37mLocal:\\x1b[0m \\x1b[1;37mhttp://localhost:%d\\x1b[0m\\n\", port);\n"
        out = out + "    printf(\"   \\x1b[90m-\\x1b[0m \\x1b[37mWorkers:\\x1b[0m \\x1b[1;37m%d\\x1b[0m\\n\", num_workers);\n"
        out = out + "\n"
        out = out + "    if (kynx_enabled) {\n"
        out = out + "        printf(\"   \\x1b[90m-\\x1b[0m \");\n"
        out = out + "        printf(\"\\x1b[90mSecured by \\x1b[0m\");\n"
        out = out + "        orbit_print_kynx_gradient(\"Kynx\");\n"
        out = out + "        printf(\"\\x1b[90m.\\x1b[0m\");\n"
        out = out + "        printf(\"\\n\");\n"
        out = out + "    }\n"
        out = out + "\n"
        out = out + "    printf(\"\\n\\x1b[32m✓\\x1b[0m \\x1b[37mStarting...\\x1b[0m\\n\");\n"
        out = out + "    printf(\"\\x1b[32m✓\\x1b[0m \\x1b[37mReady in %.1f ms\\x1b[0m\\n\\n\", ready_ms);\n"
        out = out + "    fflush(stdout);\n"
        out = out + "}\n"
        out = out + "\n"
    }
    out = out + "#ifdef _WIN32\n"
    out = out + "void __main(void) {}\n"
    out = out + "#endif\n"
    // One define per top-level `val`/`const` the program declares, in
    // declaration order. This used to be 43 pasted strings holding the
    // compiler's own lexer constants, which is how the compiler kept working
    // while top-level declarations were broken: the names in lexer.orb were
    // decoration and the values were text in the emitter. Two sources of truth
    // for one set of names, and they had already drifted -- lexer.orb declared
    // CHAR_ASTERISK where the pasted list said CHAR_STAR, so using the constant
    // the compiler's own source declared failed to build.
    //
    // The numeric literal is the rendering on purpose. The pasted list wrote
    // printable ASCII as a character literal, which is a trap for the values
    // that need an escape (92 is a backslash, 39 is a quote, 34 is a double
    // quote) and it bought nothing: a #define is text, so 32 works wherever
    // ' ' did.
    out = out + globals
    out = out + "#ifndef genericParams\n"
    out = out + "#define genericParams(...) (void*)0\n"
    out = out + "#endif\n"
    out = out + "#ifndef _pop\n"
    out = out + "#define _pop() (void*)0\n"
    out = out + "#endif\n"
    out = out + "#ifndef valStr_indexOf\n"
    out = out + "#define valStr_indexOf(...) 0\n"
    out = out + "#endif\n"
    return out
}

// The request-log helper as its own text: the router block and the shard
// header carry the same definition from this one source.
//
// Buffered on purpose: the worker loop flushes once per pass, so a burst
// of requests costs one write instead of one syscall per line.
fn orbitLogFmtText() -> string {
    var out = ""
    out = out + "/* Buffered on purpose: the worker loop flushes once per pass, so a\n"
    out = out + " * burst of requests costs one write instead of one per line. */\n"
    out = out + "static inline void orbit_log_request_fmt(const char* method, const char* path, int status, uint64_t start_rdtsc) {\n"
    out = out + "    uint64_t elapsed_cycles = orbit_rdtsc() - start_rdtsc;\n"
    out = out + "    double ms = (double)elapsed_cycles / 2500000.0;\n"
    out = out + "    if (ms < 0.05) ms = 0.1;\n"
    out = out + "\n"
    out = out + "    const char* method_str = (method && method[0]) ? method : \"GET\";\n"
    out = out + "    const char* path_str = (path && path[0]) ? path : \"/\";\n"
    out = out + "\n"
    out = out + "    const char* method_color = \"\\x1b[1;32m\";\n"
    out = out + "    if (strcmp(method_str, \"POST\") == 0) method_color = \"\\x1b[1;33m\";\n"
    out = out + "    else if (strcmp(method_str, \"PUT\") == 0) method_color = \"\\x1b[1;34m\";\n"
    out = out + "    else if (strcmp(method_str, \"DELETE\") == 0) method_color = \"\\x1b[1;31m\";\n"
    out = out + "    else if (strcmp(method_str, \"PATCH\") == 0) method_color = \"\\x1b[1;35m\";\n"
    out = out + "    else if (strcmp(method_str, \"HEAD\") == 0 || strcmp(method_str, \"OPTIONS\") == 0) method_color = \"\\x1b[1;36m\";\n"
    out = out + "\n"
    out = out + "    const char* status_color = \"\\x1b[32m\";\n"
    out = out + "    if (status >= 300 && status < 400) status_color = \"\\x1b[36m\";\n"
    out = out + "    else if (status >= 400 && status < 500) status_color = \"\\x1b[33m\";\n"
    out = out + "    else if (status >= 500) status_color = \"\\x1b[31m\";\n"
    out = out + "\n"
    out = out + "    const char* status_text = \"OK\";\n"
    out = out + "    if (status == 201) status_text = \"Created\";\n"
    out = out + "    else if (status == 204) status_text = \"No Content\";\n"
    out = out + "    else if (status == 304) status_text = \"Not Modified\";\n"
    out = out + "    else if (status == 400) status_text = \"Bad Request\";\n"
    out = out + "    else if (status == 401) status_text = \"Unauthorized\";\n"
    out = out + "    else if (status == 403) status_text = \"Forbidden\";\n"
    out = out + "    else if (status == 404) status_text = \"Not Found\";\n"
    out = out + "    else if (status == 500) status_text = \"Internal Error\";\n"
    out = out + "    else if (status == 503) status_text = \"Siege Mode Active\";\n"
    out = out + "\n"
    out = out + "    if (orbit_color_enabled() == 0) {\n"
    out = out + "        printf(\"  %-6s %-32s %d %s %.1f ms\\n\",\n"
    out = out + "            method_str, path_str, status, status_text, ms);\n"
    out = out + "        return;\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    printf(\"  %s%-6s\\x1b[0m \\x1b[1;37m%-32s\\x1b[0m %s%d %-18s\\x1b[0m \\x1b[2;90m%.1f ms\\x1b[0m\\n\",\n"
    out = out + "        method_color, method_str, path_str, status_color, status, status_text, ms);\n"
    out = out + "}\n"
    return out
}

fn orbitLogFmtProto() -> string {
    return "static inline void orbit_log_request_fmt(const char* method, const char* path, int status, uint64_t start_rdtsc);\n"
}

// Every emitted helper that has a definition but no forward declaration,
// with the linkage its definition carries. The shard header declares them;
// their definitions live in exactly one shard.
fn preambleHelperProtos(hasRoutes: bool) -> string {
    var out = ""
    out = out + "int orbit_color_enabled(void);\n"
    if hasRoutes {
        out = out + "void orbit_print_kynx_gradient(const char* text);\n"
        out = out + "void orbit_render_server_banner(int port, int num_workers, int kynx_enabled, double ready_ms);\n"
    }
    return out
}

fn routerHelperProtos() -> string {
    var out = ""
    out = out + orbitLogFmtProto()
    out = out + "int orbit_handle_request(orbit_socket_t client_sock, const char* raw_request, size_t raw_len, OrbitArena* arena, size_t* out_consumed);\n"
    return out
}

fn serverHelperProtos(hasKynxLimits: bool) -> string {
    var out = ""
    out = out + "#ifdef _WIN32\n"
    out = out + "unsigned __stdcall orbit_worker_loop(void* arg);\n"
    out = out + "#else\n"
    out = out + "void* orbit_worker_loop(void* arg);\n"
    out = out + "#endif\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "BOOL WINAPI orbit_ctrl_handler(DWORD type);\n"
    out = out + "#else\n"
    out = out + "void orbit_term_handler(int sig);\n"
    out = out + "#endif\n"
    if hasKynxLimits {
        out = out + "void orbit_kynx_register_limits(void);\n"
    }
    return out
}

fn mainProto() -> string {
    return "int main(int argc, char* argv[]);\n"
}

fn routerPreText(logsActive: string, kynxActive: string) -> string {
    var out = ""
    out = out + "#ifdef ORBIT_WITH_NET\n"
    out = out + "#define ORBIT_LOGS_ACTIVE " + logsActive + "\n"
    out = out + "#define ORBIT_KYNX_ACTIVE " + kynxActive + "\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + orbitLogFmtText()
    out = out + "#endif\n"
    out = out + "\n"
    // Only referenced from the ORBIT_KYNX_ACTIVE blocks below; emitting it
    // unconditionally would be an unused static function (-Werror) in a
    // kynx-off program, so gate it on the same condition.
    if kynxActive == "1" {
        out = out + "/* Resolve a socket's peer address to a printable string once, at\n"
        out = out + " * connection adoption. A TCP connection has one peer for its whole\n"
        out = out + " * lifetime, so this never needs re-running per request. */\n"
        out = out + "static void orbit_kynx_peer_ip_string(orbit_socket_t sock, char* out, size_t out_len) {\n"
        out = out + "    struct sockaddr_storage ksa; socklen_t kslen = sizeof(ksa);\n"
        out = out + "    out[0] = '\\0';\n"
        out = out + "    if (getpeername(sock, (struct sockaddr*)&ksa, &kslen) == 0) {\n"
        out = out + "        if (ksa.ss_family == AF_INET) inet_ntop(AF_INET, &((struct sockaddr_in*)&ksa)->sin_addr, out, out_len);\n"
        out = out + "        else if (ksa.ss_family == AF_INET6) inet_ntop(AF_INET6, &((struct sockaddr_in6*)&ksa)->sin6_addr, out, out_len);\n"
        out = out + "    }\n"
        out = out + "}\n"
        out = out + "\n"
    }
    out = out + "int orbit_handle_request_full(orbit_socket_t client_sock, const char* raw_request, size_t raw_len, OrbitArena* arena, size_t* out_consumed, const char* kynx_peer_cached) {\n"
    out = out + "    (void)kynx_peer_cached;\n"
    out = out + "    uint64_t start = orbit_rdtsc();\n"
    out = out + "    orbit_perf_start_request();\n"
    out = out + "\n"
    out = out + "    OrbitRequest* req = NULL;\n"
    out = out + "    int perr = 0;\n"
    out = out + "    size_t consumed = orbit_http_parse_request_ex(arena, raw_request, raw_len, &req, &perr);\n"
    out = out + "    if (out_consumed) *out_consumed = consumed;\n"
    out = out + "    if (perr) {\n"
    out = out + "        OrbitResponse* bad_te = orbit_response_create(arena, 501, \"text/plain\", \"501 Transfer-Encoding not supported\");\n"
    out = out + "        bad_te = orbit_response_or_500(arena, bad_te);\n"
    out = out + "        orbit_send_response(client_sock, bad_te);\n"
    out = out + "        orbit_perf_end_request(start);\n"
    out = out + "        return 0;\n"
    out = out + "    }\n"
    out = out + "    if (!req) return 1;\n"
    out = out + "\n"
    out = out + "    int keep_alive = 1;\n"
    out = out + "    if (strstr(raw_request, \"Connection: close\") || strstr(raw_request, \"connection: close\")) keep_alive = 0;\n"
    out = out + "\n"
    out = out + "#if ORBIT_KYNX_ACTIVE\n"
    out = out + "    /* Kynx 0.1: peer identity (+ trusted-proxy XFF) -> admission gate.\n"
    out = out + "     * The peer string is resolved once per connection by the worker loop\n"
    out = out + "     * and handed in; only a caller that has none (the 5-arg entry point)\n"
    out = out + "     * reaches getpeername here. XFF is read only when a trusted proxy is\n"
    out = out + "     * configured -- with none, no header could ever be believed. */\n"
    out = out + "    char kynx_ip[64] = {0};\n"
    out = out + "    {\n"
    out = out + "        char kynx_peer_local[64] = {0};\n"
    out = out + "        const char* kynx_peer = kynx_peer_cached;\n"
    out = out + "        if (!kynx_peer || !kynx_peer[0]) {\n"
    out = out + "            orbit_kynx_peer_ip_string(client_sock, kynx_peer_local, sizeof(kynx_peer_local));\n"
    out = out + "            kynx_peer = kynx_peer_local;\n"
    out = out + "        }\n"
    out = out + "        const char* kynx_xff = NULL;\n"
    out = out + "        if (orbit_kynx_has_trusted_proxies()) {\n"
    out = out + "            orbit_string kynx_xff_s = orbit_http_header_get(arena, req, \"X-Forwarded-For\");\n"
    out = out + "            if (kynx_xff_s && kynx_xff_s[0]) kynx_xff = kynx_xff_s;\n"
    out = out + "        }\n"
    out = out + "        orbit_kynx_effective_ip(kynx_peer, kynx_xff, kynx_ip, sizeof(kynx_ip));\n"
    out = out + "        if (!orbit_kynx_check_route(kynx_ip, req->method, req->path)) {\n"
    out = out + "            int kynx_ra_ms = orbit_kynx_last_retry_ms();\n"
    out = out + "            int kynx_ra_s = (kynx_ra_ms + 999) / 1000;\n"
    out = out + "            if (kynx_ra_s < 1) kynx_ra_s = 1;\n"
    out = out + "            char kynx_ra_buf[16];\n"
    out = out + "            snprintf(kynx_ra_buf, sizeof(kynx_ra_buf), \"%d\", kynx_ra_s);\n"
    out = out + "            OrbitResponse* blocked = orbit_response_create(arena, 429, \"text/plain\", \"429 Too Many Requests - Kynx admission control\");\n"
    out = out + "            orbit_response_add_header(arena, blocked, \"Retry-After\", kynx_ra_buf);\n"
    out = out + "            blocked = orbit_response_or_500(arena, blocked);\n"
    out = out + "            orbit_send_response(client_sock, blocked);\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + "            orbit_log_request_fmt(\"KYNX\", kynx_ip, blocked ? blocked->status : 500, start);\n"
    out = out + "#endif\n"
    out = out + "            orbit_perf_end_request(start);\n"
    out = out + "            return 0;\n"
    out = out + "        }\n"
    out = out + "    }\n"
    out = out + "#endif\n"
    out = out + "\n"
    out = out + "#if ORBIT_KYNX_ACTIVE\n"
    out = out + "    extern OrbitKynxLease* orbit_kynx_lease_create_for_route(const char* path, const char* method, OrbitArena* arena);\n"
    out = out + "    extern void orbit_kynx_lease_destroy(OrbitKynxLease* lease);\n"
    out = out + "    OrbitKynxLease* lease = orbit_kynx_lease_create_for_route(req->path, req->method, arena);\n"
    out = out + "    if (lease && (lease->flags & 1)) {\n"
    out = out + "        OrbitResponse* res = orbit_response_create(arena, 503, \"text/plain\", \"503 Siege Mode Active - Non-critical Route Blocked\");\n"
    out = out + "        res = orbit_response_or_500(arena, res);\n"
    out = out + "        orbit_send_response(client_sock, res);\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + "        orbit_log_request_fmt(req->method, req->path, res ? res->status : 500, start);\n"
    out = out + "#endif\n"
    out = out + "        orbit_kynx_lease_destroy(lease);\n"
    out = out + "        orbit_perf_end_request(start);\n"
    out = out + "        return 0;\n"
    out = out + "    }\n"
    out = out + "#endif\n"
    out = out + "        \n"
    out = out + "    if (req->path && strcmp(req->path, \"/_pulse\") == 0) {\n"
    out = out + "        OrbitResponse* res = orbit_response_create(arena, 200, \"text/html\", ORBIT_PULSE_DASHBOARD_HTML);\n"
    out = out + "        res = orbit_response_or_500(arena, res);\n"
    out = out + "        orbit_send_response(client_sock, res);\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + "        orbit_log_request_fmt(req->method, req->path, res ? res->status : 500, start);\n"
    out = out + "#endif\n"
    out = out + "#if ORBIT_KYNX_ACTIVE\n"
    out = out + "        if (lease) orbit_kynx_lease_destroy(lease);\n"
    out = out + "#endif\n"
    out = out + "        orbit_perf_end_request(start);\n"
    out = out + "        return keep_alive;\n"
    out = out + "    }\n"
    out = out + "    if (req->path && strcmp(req->path, \"/_pulse/data\") == 0) {\n"
    out = out + "        orbit_string json = orbit_pulse_get_stats_json(arena);\n"
    out = out + "        OrbitResponse* res = orbit_response_json(arena, 200, json);\n"
    out = out + "        res = orbit_response_or_500(arena, res);\n"
    out = out + "        orbit_send_response(client_sock, res);\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + "        orbit_log_request_fmt(req->method, req->path, res ? res->status : 500, start);\n"
    out = out + "#endif\n"
    out = out + "#if ORBIT_KYNX_ACTIVE\n"
    out = out + "        if (lease) orbit_kynx_lease_destroy(lease);\n"
    out = out + "#endif\n"
    out = out + "        orbit_perf_end_request(start);\n"
    out = out + "        return keep_alive;\n"
    out = out + "    }\n"
    out = out + "    if (req->path && (strcmp(req->path, \"/_ledger\") == 0 || strcmp(req->path, \"/_ledger/data\") == 0)) {\n"
    out = out + "        uint64_t _orbit_ls = orbit_rdtsc();\n"
    out = out + "        int _orbit_lslot = orbit_ledger_enter(req->method, req->path);\n"
    out = out + "        OrbitResponse* res = NULL;\n"
    out = out + "        if (!orbit_ledger_is_loopback(client_sock)) {\n"
    out = out + "            res = orbit_response_create(arena, 403, \"text/plain\", \"Forbidden: /_ledger serves loopback only.\");\n"
    out = out + "        } else if (strcmp(req->path, \"/_ledger/data\") == 0) {\n"
    out = out + "            orbit_string json = orbit_ledger_json(arena);\n"
    out = out + "            res = orbit_response_json(arena, 200, json);\n"
    out = out + "        } else {\n"
    out = out + "            orbit_string html = orbit_ledger_html(arena);\n"
    out = out + "            res = orbit_response_create(arena, 200, \"text/html\", html);\n"
    out = out + "        }\n"
    out = out + "        orbit_ledger_exit(_orbit_lslot, orbit_rdtsc() - _orbit_ls, arena);\n"
    // Every response this file builds passes through orbit_response_or_500
    // before it is sent, and the status it logs comes from the same pointer: a
    // build that failed is a 500 the client can see, not the status the branch
    // meant to send and never did.
    out = out + "        res = orbit_response_or_500(arena, res);\n"
    out = out + "        orbit_send_response(client_sock, res);\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + "        orbit_log_request_fmt(req->method, req->path, res ? res->status : 500, start);\n"
    out = out + "#endif\n"
    out = out + "#if ORBIT_KYNX_ACTIVE\n"
    out = out + "        if (lease) orbit_kynx_lease_destroy(lease);\n"
    out = out + "#endif\n"
    out = out + "        orbit_perf_end_request(start);\n"
    out = out + "        return keep_alive;\n"
    out = out + "    }\n"
    return out
}

fn routerTailText(chain: string) -> string {
    var out = ""
    if chain != "" {
        out = out + chain
        out = out + "    else {\n"
    } else {
        out = out + "    {\n"
    }
    out = out + "        OrbitResponse* res = orbit_response_create(arena, 404, \"text/plain\", \"Not Found\");\n"
    out = out + "        res = orbit_response_or_500(arena, res);\n"
    out = out + "        orbit_send_response(client_sock, res);\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + "        orbit_log_request_fmt(req->method, req->path, res ? res->status : 500, start);\n"
    out = out + "#endif\n"
    out = out + "#if ORBIT_KYNX_ACTIVE\n"
    out = out + "        if (lease) orbit_kynx_lease_destroy(lease);\n"
    out = out + "#endif\n"
    out = out + "        orbit_perf_end_request(start);\n"
    out = out + "        return keep_alive;\n"
    out = out + "    }\n"
    out = out + "    return keep_alive;\n"
    out = out + "}\n"
    out = out + "int orbit_handle_request(orbit_socket_t client_sock, const char* raw_request, size_t raw_len, OrbitArena* arena, size_t* out_consumed) {\n"
    out = out + "    return orbit_handle_request_full(client_sock, raw_request, raw_len, arena, out_consumed, NULL);\n"
    out = out + "}\n"
    out = out + "#endif\n"
    return out
}

fn serverMainText(hasDb: bool, hasAuth: bool, modelDDL: string, hasKynxLimits: bool, portText: string) -> string {
    var out = ""
    out = out + "#ifdef _WIN32\n"
    out = out + "unsigned __stdcall orbit_worker_loop(void* arg) {\n"
    out = out + "#else\n"
    out = out + "void* orbit_worker_loop(void* arg) {\n"
    out = out + "#endif\n"
    out = out + "    OrbitWorkerCtx* ctx = (OrbitWorkerCtx*)arg;\n"
    out = out + "\n"
    out = out + "    /* Each thread owns its private arena — zero pool contention */\n"
    out = out + "    OrbitArena* thread_arena = orbit_arena_create(131072);\n"
    out = out + "    /* A refused request is answered, not fatal: the boundary handler is\n"
    out = out + "     * installed for this worker's lifetime (orbit_request_oom_arm). */\n"
    out = out + "    orbit_request_oom_install();\n"
    out = out + "\n"
    out = out + "    orbit_socket_t clients[512];\n"
    out = out + "    size_t buffered[512];\n"
    out = out + "    char* buffers[512];\n"
    out = out + "    /* Per-connection peer IP string, resolved once at adoption: a\n"
    out = out + "     * connection's peer cannot change, so admission never re-resolves it. */\n"
    out = out + "    char* peers[512];\n"
    out = out + "    int num_clients = 0;\n"
    out = out + "    \n"
    out = out + "    /* Thread-local pre-allocated buffer pool to eliminate malloc/free overhead */\n"
    out = out + "    char* buffer_pool = (char*)malloc(512 * 16384);\n"
    out = out + "    char* free_buffers[512];\n"
    out = out + "    for (int j = 0; j < 512; j++) {\n"
    out = out + "        free_buffers[j] = buffer_pool + j * 16384;\n"
    out = out + "    }\n"
    out = out + "    int free_buffers_count = 512;\n"
    out = out + "    /* A peer string is owned by exactly one live slot or by this\n"
    out = out + "     * free stack, never both -- the same discipline free_buffers\n"
    out = out + "     * keeps for buffers[]. Without it, swap-remove copies a\n"
    out = out + "     * pointer and the next adoption overwrites the peer string of\n"
    out = out + "     * a connection that is still live. */\n"
    out = out + "    char* peer_pool = (char*)malloc(512 * 64);\n"
    out = out + "    char* free_peers[512];\n"
    out = out + "    for (int j = 0; j < 512; j++) {\n"
    out = out + "        peers[j] = peer_pool + j * 64;\n"
    out = out + "        peers[j][0] = '\\0';\n"
    out = out + "        free_peers[j] = peers[j];\n"
    out = out + "    }\n"
    out = out + "    int free_peers_count = 512;\n"
    out = out + "    /* Drain: after a stop is requested, finish adopted and queued\n"
    out = out + "     * connections, then exit. New idle connections are dropped. */\n"
    out = out + "    while (!orbit_stop_requested() || num_clients > 0 || !orbit_accept_q_empty(&ctx->q)) {\n"
    out = out + "        fd_set readfds;\n"
    out = out + "        FD_ZERO(&readfds);\n"
    out = out + "        orbit_socket_t max_fd = 0;\n"
    out = out + "        FD_SET(ctx->wake_recv, &readfds);\n"
    out = out + "        if (ctx->wake_recv > max_fd) max_fd = ctx->wake_recv;\n"
    out = out + "\n"
    out = out + "        for (int i = 0; i < num_clients; i++) {\n"
    out = out + "            FD_SET(clients[i], &readfds);\n"
    out = out + "            if (clients[i] > max_fd) max_fd = clients[i];\n"
    out = out + "        }\n"
    out = out + "\n"
    out = out + "        /* Select timeout is bounded to 1s so an idle worker re-checks\n"
    out = out + "         * its accept queue even if a wake datagram is ever dropped. */\n"
    out = out + "        int _orbit_sel_s = 30;\n"
    out = out + "        if (_orbit_sel_s > 1) _orbit_sel_s = 1;\n"
    out = out + "        struct timeval tv = {_orbit_sel_s, 0};\n"
    out = out + "        int activity = select((int)max_fd + 1, &readfds, NULL, NULL, &tv);\n"
    out = out + "\n"
    out = out + "        if (activity < 0) {\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "            int err = WSAGetLastError();\n"
    out = out + "            if (err == WSAENOTSOCK) {\n"
    out = out + "                for (int i = 0; i < num_clients; ) {\n"
    out = out + "                    int optval;\n"
    out = out + "                    int optlen = sizeof(optval);\n"
    out = out + "                    if (getsockopt(clients[i], SOL_SOCKET, SO_TYPE, (char*)&optval, &optlen) == SOCKET_ERROR) {\n"
    out = out + "                        orbit_socket_close(clients[i]);\n"
    out = out + "                        free_buffers[free_buffers_count++] = buffers[i];\n"
    out = out + "                        clients[i] = clients[num_clients - 1];\n"
    out = out + "                        buffered[i] = buffered[num_clients - 1];\n"
    out = out + "                        buffers[i] = buffers[num_clients - 1];\n"
    out = out + "                        free_peers[free_peers_count++] = peers[i];\n"
    out = out + "                        peers[i] = peers[num_clients - 1];\n"
    out = out + "                        num_clients--;\n"
    out = out + "                    } else {\n"
    out = out + "                        i++;\n"
    out = out + "                    }\n"
    out = out + "                }\n"
    out = out + "            }\n"
    out = out + "#else\n"
    out = out + "            if (errno == EBADF || errno == ENOTSOCK) {\n"
    out = out + "                for (int i = 0; i < num_clients; ) {\n"
    out = out + "                    if (fcntl(clients[i], F_GETFD) == -1) {\n"
    out = out + "                        orbit_socket_close(clients[i]);\n"
    out = out + "                        free_buffers[free_buffers_count++] = buffers[i];\n"
    out = out + "                        clients[i] = clients[num_clients - 1];\n"
    out = out + "                        buffered[i] = buffered[num_clients - 1];\n"
    out = out + "                        buffers[i] = buffers[num_clients - 1];\n"
    out = out + "                        free_peers[free_peers_count++] = peers[i];\n"
    out = out + "                        peers[i] = peers[num_clients - 1];\n"
    out = out + "                        num_clients--;\n"
    out = out + "                    } else {\n"
    out = out + "                        i++;\n"
    out = out + "                    }\n"
    out = out + "                }\n"
    out = out + "            }\n"
    out = out + "#endif\n"
    out = out + "            continue;\n"
    out = out + "        }\n"
    out = out + "\n"
    out = out + "        if (FD_ISSET(ctx->wake_recv, &readfds)) {\n"
    out = out + "            orbit_wake_drain(ctx->wake_recv);\n"
    out = out + "        }\n"
    out = out + "\n"
    out = out + "        /* Adopt sockets pushed by the acceptor thread (lock-free SPSC). */\n"
    out = out + "        orbit_socket_t new_sock;\n"
    out = out + "        while (orbit_accept_q_pop(&ctx->q, &new_sock)) {\n"
    out = out + "            if (num_clients < 512 && free_buffers_count > 0) {\n"
    out = out + "                clients[num_clients] = new_sock;\n"
    out = out + "                buffered[num_clients] = 0;\n"
    out = out + "                buffers[num_clients] = free_buffers[--free_buffers_count];\n"
    out = out + "                peers[num_clients] = free_peers[--free_peers_count];\n"
    out = out + "#if ORBIT_KYNX_ACTIVE\n"
    out = out + "                orbit_kynx_peer_ip_string(new_sock, peers[num_clients], 64);\n"
    out = out + "#endif\n"
    out = out + "                num_clients++;\n"
    out = out + "            } else {\n"
    out = out + "                orbit_socket_close(new_sock);\n"
    out = out + "            }\n"
    out = out + "        }\n"
    out = out + "\n"
    out = out + "        for (int i = 0; i < num_clients; ) {\n"
    out = out + "            orbit_socket_t client_sock = clients[i];\n"
    out = out + "            int drop = 0;\n"
    out = out + "            /* While draining, drop idle connections: only\n"
    out = out + "             * in-flight requests (buffered bytes) run to completion. */\n"
    out = out + "            if (orbit_stop_requested() && buffered[i] == 0) drop = 1;\n"
    out = out + "            \n"
    out = out + "            if (FD_ISSET(client_sock, &readfds)) {\n"
    out = out + "                int received = recv(client_sock, buffers[i] + buffered[i], 16384 - 1 - buffered[i], 0);\n"
    out = out + "                if (received == 0) {\n"
    out = out + "                    drop = 1;\n"
    out = out + "                } else if (received < 0) {\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "                    int err = WSAGetLastError();\n"
    out = out + "                    if (err != WSAEWOULDBLOCK) drop = 1;\n"
    out = out + "#else\n"
    out = out + "                    if (errno != EAGAIN && errno != EWOULDBLOCK) drop = 1;\n"
    out = out + "#endif\n"
    out = out + "                } else {\n"
    out = out + "                    buffered[i] += received;\n"
    out = out + "                    buffers[i][buffered[i]] = 0;\n"
    out = out + "                    \n"
    out = out + "                    int keep_alive = 1;\n"
    out = out + "                    size_t parsed = 0;\n"
    out = out + "                    while (parsed < buffered[i]) {\n"
    out = out + "    size_t consumed = 0;\n"
    out = out + "    /* The boundary is this frame's: a refusal inside the request below\n"
    out = out + "     * returns here instead of ending the process, and is answered 503\n"
    out = out + "     * (ENGINEERING.md section 7, kynx-lease-abort). The jmp_buf has to\n"
    out = out + "     * outlive the request, which is why it lives here and not in the\n"
    out = out + "     * runtime. The connection closes with the request: how much of it\n"
    out = out + "     * was consumed died with the stack. */\n"
    out = out + "    jmp_buf orbit_oom_jb;\n"
    out = out + "    orbit_arena_reset(thread_arena);\n"
    out = out + "    orbit_request_oom_arm(&orbit_oom_jb);\n"
    out = out + "    if (setjmp(orbit_oom_jb)) {\n"
    out = out + "        orbit_kynx_lease_abandon();\n"
    out = out + "        OrbitResponse* oom_res = orbit_response_create(thread_arena, 503, \"text/plain\", orbit_request_oom_message());\n"
    out = out + "        oom_res = orbit_response_or_500(thread_arena, oom_res);\n"
    out = out + "        orbit_send_response(client_sock, oom_res);\n"
    out = out + "        keep_alive = 0;\n"
    out = out + "        break;\n"
    out = out + "    }\n"
    out = out + "    int keep = orbit_handle_request_full(client_sock, buffers[i] + parsed, buffered[i] - parsed, thread_arena, &consumed, peers[i]);\n"
    out = out + "    orbit_request_oom_disarm();\n"
    out = out + "    if (!keep) keep_alive = 0;\n"
    out = out + "    if (consumed == 0) break;\n"
    out = out + "    parsed += consumed;\n"
    out = out + "                    }\n"
    out = out + "                    \n"
    out = out + "                    if (parsed > 0) {\n"
    out = out + "                        memmove(buffers[i], buffers[i] + parsed, buffered[i] - parsed);\n"
    out = out + "                        buffered[i] -= parsed;\n"
    out = out + "                    }\n"
    out = out + "                    \n"
    out = out + "                    if (buffered[i] == 16384 - 1 || !keep_alive) {\n"
    out = out + "                        drop = 1;\n"
    out = out + "                    }\n"
    out = out + "                }\n"
    out = out + "            }\n"
    out = out + "            \n"
    out = out + "            if (drop) {\n"
    out = out + "                orbit_socket_close(client_sock);\n"
    out = out + "                free_buffers[free_buffers_count++] = buffers[i];\n"
    out = out + "                clients[i] = clients[num_clients - 1];\n"
    out = out + "                buffered[i] = buffered[num_clients - 1];\n"
    out = out + "                buffers[i] = buffers[num_clients - 1];\n"
    out = out + "                free_peers[free_peers_count++] = peers[i];\n"
    out = out + "                peers[i] = peers[num_clients - 1];\n"
    out = out + "                num_clients--;\n"
    out = out + "            } else {\n"
    out = out + "                i++;\n"
    out = out + "            }\n"
    out = out + "        }\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + "        /* One flush per pass: every log line this pass produced\n"
    out = out + "         * goes out in a single write, not one syscall per line. */\n"
    out = out + "        fflush(stdout);\n"
    out = out + "#endif\n"
    out = out + "    }\n"
    out = out + "    free(buffer_pool);\n"
    out = out + "    free(peer_pool);\n"
    out = out + "    orbit_arena_destroy(thread_arena);\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "    return 0;\n"
    out = out + "#else\n"
    out = out + "    return NULL;\n"
    out = out + "#endif\n"
    out = out + "}\n"
    out = out + "\n"
    out = out + "/* Graceful shutdown: Ctrl-C / SIGTERM stops accepting; workers\n"
    out = out + " * finish in-flight requests, then the process exits cleanly. */\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "BOOL WINAPI orbit_ctrl_handler(DWORD type) {\n"
    out = out + "    if (type == CTRL_C_EVENT || type == CTRL_BREAK_EVENT) {\n"
    out = out + "        orbit_request_stop();\n"
    out = out + "        return TRUE;\n"
    out = out + "    }\n"
    out = out + "    return FALSE;\n"
    out = out + "}\n"
    out = out + "#else\n"
    out = out + "void orbit_term_handler(int sig) {\n"
    out = out + "    (void)sig;\n"
    out = out + "    orbit_request_stop();\n"
    out = out + "}\n"
    out = out + "#endif\n"
    out = out + "\n"
    out = out + "int main(int argc, char* argv[]) {\n"
    out = out + "    uint64_t _orbit_boot_t0 = orbit_rdtsc();\n"
    out = out + "    orbit_http_init();\n"
    if hasDb {
        // Same default as the plain main in c_backend.orb: .orbit/data
        // (see the note there about legacy ./orbit.db migration).
        out = out + "    orbit_db_init(\".orbit/data/app.db\");\n"
        if hasAuth {
            out = out + "    orbit_auth_init();\n"
        }
        out = out + modelDDL
    } else {
        out = out + "    \n"
    }
    // Arm ORBIT_LEDGER_OUT before any request is served. The dump is written
    // from an atexit hook, and the cases worth finding -- a route nobody ever
    // asked for, a route whose arena overflowed -- only exist after the service
    // has been up. Arming it here is what lets `orbit doctor` read the ledger
    // from a file instead of needing an HTTP client.
    out = out + "    orbit_ledger_enable_file_dump();\n"
    out = out + "    orbit_arena_pool_init(16, 131072);\n"
    out = out + "    orbit_string_pool_init(2048);\n"
    out = out + "\n"
    out = out + "    OrbitKynxConfig kynx_cfg = {\n"
    out = out + "        .pool_size       = 512,\n"
    out = out + "        .rate_limit      = 50,\n"
    out = out + "        .window_ms       = 1000,\n"
    out = out + "        .ban_threshold   = 200,\n"
    out = out + "        .score_increment = 10,\n"
    out = out + "        .score_decay     = 1,\n"
    out = out + "        .enabled         = true\n"
    out = out + "    };\n"
    out = out + "    orbit_kynx_init(kynx_cfg);\n"
    if hasKynxLimits {
        out = out + "#if ORBIT_KYNX_ACTIVE\n"
        out = out + "    orbit_kynx_register_limits();\n"
        out = out + "#endif\n"
    }
    out = out + "\n"
    out = out + "    OrbitArena* startup_arena = orbit_arena_pool_acquire();\n"
    out = out + "    int _orbit_exit_code = orbit_main(startup_arena);\n"
    out = out + "    orbit_arena_pool_release(startup_arena);\n"
    out = out + "\n"
    out = out + "    int port = " + portText + ";\n"
    out = out + "    if (argc > 1) {\n"
    out = out + "        port = atoi(argv[1]);\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    orbit_socket_t server_sock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);\n"
    out = out + "    if (server_sock == ORBIT_INVALID_SOCKET) {\n"
    out = out + "        fprintf(stderr, \"Could not create network socket. Check that networking is available on this machine, then try again.\\n\");\n"
    out = out + "        return 1;\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    int reuse = 1;\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "    setsockopt(server_sock, SOL_SOCKET, SO_EXCLUSIVEADDRUSE, (char*)&reuse, sizeof(reuse));\n"
    out = out + "#else\n"
    out = out + "    setsockopt(server_sock, SOL_SOCKET, SO_REUSEADDR, (char*)&reuse, sizeof(reuse));\n"
    out = out + "#endif\n"
    out = out + "    int nodelay = 1;\n"
    out = out + "    setsockopt(server_sock, IPPROTO_TCP, TCP_NODELAY, (char*)&nodelay, sizeof(nodelay));\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "    u_long mode = 1;\n"
    out = out + "    ioctlsocket(server_sock, FIONBIO, &mode);\n"
    out = out + "#else\n"
    out = out + "    int flags = fcntl(server_sock, F_GETFL, 0);\n"
    out = out + "    fcntl(server_sock, F_SETFL, flags | O_NONBLOCK);\n"
    out = out + "#endif\n"
    out = out + "    orbit_enable_reuseport(server_sock);\n"
    out = out + "\n"
    out = out + "    struct sockaddr_in server_addr;\n"
    out = out + "    server_addr.sin_family = AF_INET;\n"
    out = out + "    server_addr.sin_addr.s_addr = INADDR_ANY;\n"
    out = out + "    server_addr.sin_port = htons(port);\n"
    out = out + "\n"
    out = out + "    if (bind(server_sock, (struct sockaddr*)&server_addr, sizeof(server_addr)) == ORBIT_SOCKET_ERROR) {\n"
    out = out + "        fprintf(stderr, \"Port %d is not available. Another program may be using it.\\n\", port);\n"
    out = out + "        fprintf(stderr, \"Change the port in your .orb file and try again.\\n\");\n"
    out = out + "        orbit_socket_close(server_sock);\n"
    out = out + "        return 1;\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    if (listen(server_sock, SOMAXCONN) == ORBIT_SOCKET_ERROR) {\n"
    out = out + "        fprintf(stderr, \"Could not listen on port %d. Try again, and check firewall settings if it persists.\\n\", port);\n"
    out = out + "        orbit_socket_close(server_sock);\n"
    out = out + "        return 1;\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "    HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);\n"
    out = out + "    if (hOut != INVALID_HANDLE_VALUE) {\n"
    out = out + "        DWORD dwMode = 0;\n"
    out = out + "        if (GetConsoleMode(hOut, &dwMode)) {\n"
    out = out + "            SetConsoleMode(hOut, dwMode | 0x0001 | 0x0004);\n"
    out = out + "        }\n"
    out = out + "        SetConsoleOutputCP(65001);\n"
    out = out + "    }\n"
    out = out + "#endif\n"
    out = out + "\n"
    out = out + "    int num_workers = 0;\n"
    out = out + "    if (num_workers <= 0) {\n"
    out = out + "        const char* _orbit_env_w = getenv(\"ORBIT_WORKERS\");\n"
    out = out + "        if (_orbit_env_w != NULL) {\n"
    out = out + "            int _orbit_env_n = atoi(_orbit_env_w);\n"
    out = out + "            if (_orbit_env_n > 0) num_workers = _orbit_env_n;\n"
    out = out + "        }\n"
    out = out + "    }\n"
    out = out + "    if (num_workers <= 0) num_workers = ORBIT_CPU_COUNT();\n"
    out = out + "    if (num_workers <= 0) num_workers = 1;\n"
    out = out + "    if (num_workers > 64) num_workers = 64;\n"
    out = out + "    orbit_system_set_workers(num_workers);\n"
    out = out + "\n"
    out = out + "    orbit_render_server_banner(port, num_workers, kynx_cfg.enabled, (orbit_rdtsc() - _orbit_boot_t0) / 2500000.0);\n"
    out = out + "    /* Start record for `orbit stop`: this server's pid, so a later\n"
    out = out + "     * stop in the same directory kills exactly this process. Written\n"
    out = out + "     * only when .orbit/ exists (start-managed projects); a bare\n"
    out = out + "     * `orbit build` run elsewhere skips it silently, and a stale\n"
    out = out + "     * file from a killed server is told apart by probing the pid. */\n"
    out = out + "    {\n"
    out = out + "        FILE* _orbit_start_pid = fopen(\".orbit/start.pid\", \"w\");\n"
    out = out + "        if (_orbit_start_pid) {\n"
    out = out + "            fprintf(_orbit_start_pid, \"%d\\n\", (int)system_pid());\n"
    out = out + "            fclose(_orbit_start_pid);\n"
    out = out + "        }\n"
    out = out + "    }\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "    SetConsoleCtrlHandler(orbit_ctrl_handler, TRUE);\n"
    out = out + "#else\n"
    out = out + "    signal(SIGINT, orbit_term_handler);\n"
    out = out + "    signal(SIGTERM, orbit_term_handler);\n"
    out = out + "#endif\n"
    out = out + "\n"
    out = out + "    orbit_thread_t* workers = (orbit_thread_t*)malloc(sizeof(orbit_thread_t) * (size_t)num_workers);\n"
    out = out + "    OrbitWorkerCtx* ctxs = (OrbitWorkerCtx*)malloc(sizeof(OrbitWorkerCtx) * (size_t)num_workers);\n"
    out = out + "\n"
    out = out + "    OrbitAcceptorCtx acceptor;\n"
    out = out + "    acceptor.server_sock = server_sock;\n"
    out = out + "    acceptor.num_workers = num_workers;\n"
    out = out + "    acceptor.wake_send = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);\n"
    out = out + "    if (acceptor.wake_send == ORBIT_INVALID_SOCKET) {\n"
    out = out + "        fprintf(stderr, \"Could not start server internals (wake socket). Try again.\\n\");\n"
    out = out + "        orbit_socket_close(server_sock);\n"
    out = out + "        return 1;\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    int _wake_ok = 1;\n"
    out = out + "    for (int i = 0; i < num_workers; i++) {\n"
    out = out + "        orbit_accept_q_init(&ctxs[i].q);\n"
    out = out + "        ctxs[i].thread_id = i;\n"
    out = out + "        ctxs[i].port      = port;\n"
    out = out + "        if (!orbit_wake_recv_create(&ctxs[i].wake_recv, &acceptor.wake_addr[i])) {\n"
    out = out + "            fprintf(stderr, \"Could not start server internals (worker wake socket). Try again.\\n\");\n"
    out = out + "            _wake_ok = 0;\n"
    out = out + "            break;\n"
    out = out + "        }\n"
    out = out + "        acceptor.queues[i] = &ctxs[i].q;\n"
    out = out + "    }\n"
    out = out + "    if (!_wake_ok) {\n"
    out = out + "        orbit_socket_close(acceptor.wake_send);\n"
    out = out + "        orbit_socket_close(server_sock);\n"
    out = out + "        return 1;\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    orbit_thread_t acceptor_thread;\n"
    out = out + "    ORBIT_THREAD_CREATE(acceptor_thread, orbit_acceptor_loop, &acceptor);\n"
    out = out + "\n"
    out = out + "    for (int i = 1; i < num_workers; i++) {\n"
    out = out + "        ORBIT_THREAD_CREATE(workers[i], orbit_worker_loop, &ctxs[i]);\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    orbit_worker_loop(&ctxs[0]);\n"
    out = out + "\n"
    out = out + "    /* A stop was requested (or ctxs[0] drained): close the listener,\n"
    out = out + "     * join every thread, then run the normal cleanup below. */\n"
    out = out + "    orbit_socket_close(server_sock);\n"
    out = out + "    ORBIT_THREAD_JOIN(acceptor_thread);\n"
    out = out + "    for (int i = 1; i < num_workers; i++) {\n"
    out = out + "        ORBIT_THREAD_JOIN(workers[i]);\n"
    out = out + "    }\n"
    out = out + "    printf(\"Server stopped.\\n\");\n"
    out = out + "    fflush(stdout);\n"
    out = out + "    remove(\".orbit/start.pid\");\n"
    out = out + "\n"
    out = out + "    orbit_kynx_cleanup();\n"
    out = out + "    orbit_arena_pool_cleanup();\n"
    out = out + "    orbit_string_pool_cleanup();\n"
    if hasDb {
        out = out + "    orbit_db_close();\n"
    } else {
        out = out + "    \n"
    }
    out = out + "    orbit_http_cleanup();\n"
    out = out + "    orbit_socket_close(server_sock);\n"
    out = out + "    return _orbit_exit_code;\n"
    out = out + "}\n"
    return out
}
