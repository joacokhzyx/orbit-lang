import "./lexer.orb"
import "./parser.orb"
import "./resolver.orb"
import "./sema.orb"
import "./builder.orb"
import "./ir.orb"
import "./optimizer.orb"
import "./c_backend.orb"

fn compileSource(source: string, outputPath: string) -> bool {
    return compileSourceWithFile(source, "", outputPath)
}

fn compileSourceWithFile(source: string, inputPath: string, outputPath: string) -> bool {
    val parser = initParser(source)
    val rawAST = parseProgram(parser)
    print("[pipeline] Parser diagnostics: " + orbit_int_to_string_selfhost(parser.diagnostics.len()))
    var i = 0
    while i < parser.diagnostics.len() {
        val diag: ParserDiagnostic = parser.diagnostics.get(i)
        print("Parser error at line " + orbit_int_to_string_selfhost(diag.line) + ": " + diag.message)
        i = i + 1
    }
    if parser.diagnostics.len() > 0 {
        return false
    }

    print("[pipeline] Resolving module imports...")
    val resolver = initModuleResolver()
    val ast = resolveModuleAST(resolver, rawAST, inputPath)

    print("[pipeline] Semantic analysis...")
    val sema = initSema()
    analyze(sema, ast)
    if hasErrors(sema) {
        var ei = 0
        while ei < sema.errors.len() {
            print("Semantic error: " + sema.errors.get(ei))
            ei = ei + 1
        }
        return false
    }

    print("[pipeline] Building IR...")
    val builder = initIRBuilder()
    val irModule = buildAST(builder, ast)
    print("[pipeline] IR module has " + orbit_int_to_string_selfhost(irModule.functions.len()) + " functions")

    print("[pipeline] Optimizing IR...")
    val optStats = optimizeIRModule(irModule)
    print("[pipeline] Superluminal optimizer applied " + orbit_int_to_string_selfhost(optStats.patterns_applied) + " simplifications")

    print("[pipeline] Code generation...")
    val backend = initCBackend(irModule)
    val cCode = generateC(backend)

    print("[pipeline] Writing C source...")
    val cPath = outputPath + ".c"

    if orbit_file_write_selfhost(cPath, cCode) == false {
        print("Error writing C file: " + cPath)
        return false
    }

    print("[pipeline] Compiling executable binary...")
    var linkFlags = ""
    val osName = orbit_os_env_selfhost("OS")
    val winDir = orbit_os_env_selfhost("WINDIR")
    if osName == "Windows_NT" || winDir != "" {
        linkFlags = " -lws2_32"
    }

    var cCompiler = orbit_os_env_selfhost("ORBIT_CC")
    if cCompiler == "" {
        cCompiler = orbit_os_env_selfhost("CC")
    }
    if cCompiler == "" {
        cCompiler = "zig cc"
    }

    val compCmd = cCompiler + " -O0 -Wno-error=int-conversion -Wno-error=incompatible-pointer-types " + cPath + " -o " + outputPath + " -I src/runtime" + linkFlags + " 2>&1"
    val compOutput = orbit_os_exec_selfhost(compCmd)
    if compOutput != "" {
        print("[pipeline] Compiler output: " + compOutput)
        if compOutput.indexOf("[ERROR") != -1 || compOutput.indexOf("error:") != -1 || compOutput.indexOf("Error:") != -1 {
            return false
        }
    }
    return true
}

