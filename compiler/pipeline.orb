import "./lexer.orb"
import "./parser.orb"
import "./resolver.orb"
import "./sema.orb"
import "./builder.orb"
import "./ir.orb"
import "./c_backend.orb"

fn compileSource(source: string, outputPath: string) -> bool {
    return compileSourceWithFile(source, "", outputPath)
}

fn compileSourceWithFile(source: string, inputPath: string, outputPath: string) -> bool {
    print("[pipeline] Parsing program... source len=" + orbit_itoa(source.len()))
    // DEBUG: direct list test
    val testList = []
    print("[pipeline] DEBUG: testList initial len=" + orbit_itoa(testList.len()))
    testList.push(1)
    print("[pipeline] DEBUG: after push1 len=" + orbit_itoa(testList.len()))
    testList.push(2)
    print("[pipeline] DEBUG: after push2 len=" + orbit_itoa(testList.len()))
    val parser = initParser(source)
    val rawAST = parseProgram(parser)
    print("[pipeline] Parser diagnostics: " + orbit_itoa(parser.diagnostics.len()))
    var i = 0
    while i < parser.diagnostics.len() {
        val diag: ParserDiagnostic = parser.diagnostics.get(i)
        print("Parser error at line " + orbit_itoa(diag.line) + ": " + diag.message)
        i = i + 1
    }
    if parser.diagnostics.len() > 0 {
        return false
    }

    print("[pipeline] Resolving module imports...")
    val resolver = initModuleResolver()
    val ast = resolveModuleAST(resolver, rawAST, inputPath)

    print("[pipeline] Semantic analysis...")
    val sema = initSema()
    analyze(sema, ast)
    if hasErrors(sema) {
        var ei = 0
        while ei < sema.errors.len() {
            print("Semantic error: " + sema.errors.get(ei))
            ei = ei + 1
        }
        return false
    }

    print("[pipeline] Building IR...")
    val builder = initIRBuilder()
    val irModule = buildAST(builder, ast)
    print("[pipeline] IR module has " + orbit_itoa(irModule.functions.len()) + " functions")

    print("[pipeline] Code generation...")
    val backend = initCBackend(irModule)
    val cCode = generateC(backend)

    print("[pipeline] Writing C source...")
    val cPath = outputPath + ".c"

    if orbit_file_write(cPath, cCode) == false {
        print("Error writing C file: " + cPath)
        return false
    }

    print("[pipeline] Compiling executable binary...")
    val compCmd = "zig cc -O0 -Wno-error=int-conversion -Wno-error=incompatible-pointer-types \"" + cPath + "\" -o \"" + outputPath + "\" -I src/runtime -lws2_32"
    val compOutput = orbit_os_exec(compCmd)
    if compOutput != "" {
        print("[pipeline] Compiler output: " + compOutput)
    }
    return true
}
