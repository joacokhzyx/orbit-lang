import "./lexer.orb"
import "./parser.orb"
import "./resolver.orb"
import "./sema.orb"
import "./builder.orb"
import "./ir.orb"
import "./optimizer.orb"
import "./cteval.orb"
import "./c_backend.orb"

fn cteEnabled() -> bool {
    return true
}

fn getSourceLine(source: string, lineNum: int) -> string {
    if source == "" { return "" }
    var curLine = 1
    var start = 0
    var i = 0
    while i < orbit_string_len(source) {
        if orbit_string_char_at_selfhost(source, i) == 10 {
            if curLine == lineNum {
                var slice = orbit_string_slice(source, start, i)
                val sl = orbit_string_len(slice)
                if sl > 0 && orbit_string_char_at_selfhost(slice, sl - 1) == 13 {
                    slice = orbit_string_slice(slice, 0, sl - 1)
                }
                return slice
            }
            curLine = curLine + 1
            start = i + 1
        }
        i = i + 1
    }
    if curLine == lineNum {
        var slice = orbit_string_slice(source, start, orbit_string_len(source))
        val sl = orbit_string_len(slice)
        if sl > 0 && orbit_string_char_at_selfhost(slice, sl - 1) == 13 {
            slice = orbit_string_slice(slice, 0, sl - 1)
        }
        return slice
    }
    return ""
}

fn renderErrorCard(code: string, message: string, file: string, line: int, col: int, sourceLine: string, hint: string) -> string {
    var out = "\n"
    out = out + "error[" + code + "]: " + message + "\n"
    out = out + "  --> " + file + ":" + orbit_int_to_string_selfhost(line) + ":" + orbit_int_to_string_selfhost(col) + "\n"
    out = out + "   |\n"
    if sourceLine != "" {
        var lineStr = orbit_int_to_string_selfhost(line)
        if line < 10 {
            lineStr = " " + lineStr
        }
        out = out + lineStr + " | " + sourceLine + "\n"
        out = out + "   | "
        var sp = 0
        while sp < col - 1 {
            out = out + " "
            sp = sp + 1
        }
        out = out + "^-- here\n"
        out = out + "   |\n"
    }
    out = out + "   = help: " + hint + "\n"
    return out
}

fn reportErrorCard(code: string, message: string, file: string, line: int, col: int, sourceLine: string, hint: string, kind: string) {
    val card = renderErrorCard(code, message, file, line, col, sourceLine, hint)
    orbit_os_write_stderr_selfhost(card)
    orbit_os_write_stderr_selfhost("\nERROR: " + kind + "\n")
}

fn compileSource(source: string, outputPath: string) -> bool {
    return compileSourceWithFile(source, "", outputPath)
}

fn compileSourceWithFile(source: string, inputPath: string, outputPath: string) -> bool {
    val parser = initParser(source)
    val rawAST = parseProgram(parser)
    if parser.diagnostics.len() > 0 {
        val diag: ParserDiagnostic = parser.diagnostics.get(0)
        if diag.code != "" {
            val srcLine = getSourceLine(source, diag.line)
            reportErrorCard(diag.code, diag.message, inputPath, diag.line, diag.column, srcLine, "Check for missing brackets, quotes, or keywords before this token.", diag.kind)
        } else {
            var i = 0
            while i < parser.diagnostics.len() {
                val d: ParserDiagnostic = parser.diagnostics.get(i)
                print("Parser error at line " + orbit_int_to_string_selfhost(d.line) + ": " + d.message)
                i = i + 1
            }
        }
        return false
    }

    val resolver = initModuleResolver()
    val ast = resolveModuleAST(resolver, rawAST, inputPath)
    if resolver.errors.len() > 0 {
        var ri = 0
        while ri < resolver.errors.len() {
            print("Import error: " + resolver.errors.get(ri))
            ri = ri + 1
        }
        return false
    }

    val sema = initSema()
    analyze(sema, ast)
    if hasErrors(sema) {
        val firstErr = sema.errors.get(0)
        if orbit_string_indexOf(firstErr, "Non-void function must return a value") != -1 {
            reportErrorCard("return/missing-value", "Non-void function must return a value", "<unknown>", 1, 1, "", "Ensure type consistency and scope rules are satisfied.", "error.SemanticAnalysisFailed")
        } else {
            var ei = 0
            while ei < sema.errors.len() {
                print("Semantic error: " + sema.errors.get(ei))
                ei = ei + 1
            }
        }
        return false
    }

    val builder = initIRBuilder()
    val irModule = buildAST(builder, ast)

    irModule.boostRaw = computeBoostRawPct(irModule)

    val optStats = optimizeIRModule(irModule)
    var cteFolds = 0
    if cteEnabled() {
        cteFolds = cteOptimize(irModule)
    }

    val backend = initCBackend(irModule)
    val cCode = generateC(backend)
    val hasDb = moduleUsesDatabase(irModule)

    // Use a constant intermediate-C filename: clang embeds the C file path in
    // anonymous-struct names and type diagnostics, so a path derived from the
    // output name (e.g. stage2.exe.c vs stage3.exe.c) would make the 3-stage
    // bootstrap fixed-point comparison fail even though the code is identical.
    var cPath = "orbit_selfhost_build.c"
    val tmpDir = orbit_os_env_selfhost("TEMP")
    if tmpDir != "" {
        cPath = tmpDir + "/" + cPath
    }

    if orbit_file_write_selfhost(cPath, cCode) == false {
        print("Error writing C file: " + cPath)
        return false
    }

    var linkFlags = ""
    val osName = orbit_os_env_selfhost("OS")
    val winDir = orbit_os_env_selfhost("WINDIR")
    if osName == "Windows_NT" || winDir != "" {
        linkFlags = " -lws2_32"
    }

    // Sovereignty: the compiler never assumes a specific toolchain vendor.
    // Resolution order: ORBIT_CC -> CC -> POSIX "cc" convention.
    var cCompiler = orbit_os_env_selfhost("ORBIT_CC")
    if cCompiler == "" {
        cCompiler = orbit_os_env_selfhost("CC")
    }
    if cCompiler == "" {
        cCompiler = "cc"
    }

    var dbFlags = ""
    val isWindowsHost = osName == "Windows_NT" || winDir != ""
    if hasDb {
        if isWindowsHost {
            dbFlags = " -DORBIT_WITH_DB -Iruntime/vendor runtime/vendor/win-x64/sqlite3.lib"
        } else {
            dbFlags = " -DORBIT_WITH_DB -Iruntime/vendor -lsqlite3"
        }
    }

    val compCmd = cCompiler + " -s -w -O0 -Wno-error=int-conversion -Wno-error=incompatible-pointer-types " + cPath + " -o " + outputPath + " -I runtime -DORBIT_WITH_NET" + dbFlags + linkFlags + " 2>&1"
    val compOutput = orbit_os_exec_selfhost(compCmd)
    if compOutput != "" {
        if compOutput.indexOf("[ERROR") != -1 || compOutput.indexOf("error:") != -1 || compOutput.indexOf("Error:") != -1 {
            if compOutput.indexOf("not recognized") != -1 || compOutput.indexOf("not found") != -1 || compOutput.indexOf("no se reconoce") != -1 {
                orbit_os_write_stderr_selfhost("C compiler '" + cCompiler + "' was not found. Set the ORBIT_CC environment variable to your C compiler (e.g. gcc, clang, cc).\n")
            }
            orbit_os_write_stderr_selfhost(compOutput)
            return false
        }
    }
    return true
}

