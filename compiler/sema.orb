import "./ast.orb"
import "./extern.orb"
import "./literal.orb"

model Symbol {
    name: string
    typeName: string
    isMutable: bool
    isFunction: bool
    // A function's declared parameter types, in order. Carried on the symbol
    // because that is the only place a call site can reach: the call has a
    // name and a list of arguments, the declaration is a different node in a
    // different pass, and nothing joined them. Arity and argument type are
    // both decided by the two together, and both used to be inferred and
    // thrown away.
    paramTypes: list
}

model Scope {
    symbols: list
    parentId: int
}

model TypeInfo {
    name: string
    kind: string
    variants: list
}

// One variant name and the enum or union that declares it. A variant is
// constructed by a bare call (`Circle(7)`) or a field read (`ASTNode.Empty`),
// and neither form mentions the type it belongs to, so the only way sema can
// learn "this call produces a Shape" is an index from the variant name.
model VariantInfo {
    variant: string
    owner: string
}

// A name the checker was asked to resolve and could not.
//
// `unknown` on its own cannot carry this. It is also the honest answer for a
// name that WAS found and whose value the type rules do not cover, and
// checkCompatibility accepts it on either side of a comparison, so the two
// cases were indistinguishable and neither one said anything. Recording the
// miss where it happens is what makes the difference observable: the caller
// that meant the name as a reference records one, the caller probing whether a
// name happens to be a model does not, and the count below is the honest size
// of the gap rather than the size of `unknown`.
model NameMiss {
    name: string
    kind: string
}

// A semantic diagnostic. line is 0 when the checker could not say where the
// problem is -- most checks run over a node that carries no position -- and
// the printer falls back to the one-line form for those. Only a diagnostic
// that knows its position gets an error card.
model SemaError {
    message: string
    line: int
    col: int
    code: string
    hint: string
}

model Sema {
    scopes: list
    currentScope: int
    errors: list
    typeRegistry: list
    variantRegistry: list
    currentReturnType: string
    currentFunction: string
    seenRoutes: list
    misses: list
    // Lengths the checker can prove for a `val` bound to a literal, as
    // "name\tstring\tlen" or "name\tlist\tlen". Only literal bindings, only
    // immutable ones, and only a string literal with no escapes in it -- a
    // bound that can be reassigned, or whose length this cannot count, is not
    // a bound. See checkConstantIndex.
    constBounds: list
    // Positions checkConstantIndex has already reported, as "line:col".
    // inferType reaches a node from more than one direction -- a call infers
    // its receiver, an expression statement infers its expression -- so
    // without this one bad index would be printed twice.
    indexChecks: list
}

fn initSema() -> Sema {
    var initialScopes = []
    initialScopes.push(Scope([], -1))
    return Sema(initialScopes, 0, [], [], [], "", "", [], [], [], [])
}

fn listContainsValue(items: list, value: string) -> bool {
    if items == NULL { return false }
    var i = 0
    while i < items.len() {
        if items.get(i) == value { return true }
        i = i + 1
    }
    return false
}

fn reportError(sema: Sema, message: string) {
    // Diagnostics raised outside a function body (a bad signature, for
    // instance) have no enclosing name. An empty "[in ]" reads like a bug in
    // the message, so omit the context instead of printing nothing.
    if sema.currentFunction == "" {
        sema.errors.push(SemaError(message, 0, 0, "", ""))
        return
    }
    sema.errors.push(SemaError(message + " [in " + sema.currentFunction + "]", 0, 0, "", ""))
}

// The same diagnostic when the checker knows where the offending node is.
// Everything reachable from a MatchNode, a Call or a MemberAccess is a
// position the parser recorded, so a diagnostic about one of those can point at
// it; the plain reportError cannot and says nothing about location.
fn reportErrorAt(sema: Sema, code: string, hint: string, line: int, col: int, message: string) {
    sema.errors.push(SemaError(message, line, col, code, hint))
}

// Function names the C backend cannot emit safely. A generated translation
// unit has <stdio.h>, <stdlib.h>, <string.h>, <stdint.h> in scope, plus
// <unistd.h>/<sys/socket.h> and friends on POSIX or <winsock2.h> on Windows,
// and user functions are emitted under their own name (`static orbit_int
// read(...)`). Naming a function after a C library symbol therefore produces
// "conflicting types" from the C compiler, or a link error, and nothing in the
// Orbit-level output explains why.
//
// The list is deliberately narrow: only symbols that are (a) plausible names
// for a small user helper and (b) genuinely declared in that header set. A
// user wanting a `read` helper should get one diagnostic naming the collision
// and suggesting a rename, not a C toolchain message. The better long-term
// answer is to mangle emitted user symbols so no name can ever collide; that
// touches every call site in every program and is tracked as CODE-1.
fn reservedCFunctionName(name: string) -> bool {
    if name == "read" { return true }
    if name == "write" { return true }
    if name == "open" { return true }
    if name == "close" { return true }
    if name == "link" { return true }
    if name == "unlink" { return true }
    if name == "stat" { return true }
    if name == "fstat" { return true }
    if name == "access" { return true }
    if name == "sleep" { return true }
    if name == "usleep" { return true }
    if name == "getpid" { return true }
    if name == "getenv" { return true }
    if name == "setenv" { return true }
    if name == "system" { return true }
    if name == "exit" { return true }
    if name == "atexit" { return true }
    if name == "abort" { return true }
    if name == "malloc" { return true }
    if name == "calloc" { return true }
    if name == "realloc" { return true }
    if name == "free" { return true }
    if name == "index" { return true }
    if name == "abs" { return true }
    if name == "labs" { return true }
    if name == "div" { return true }
    if name == "remove" { return true }
    if name == "rename" { return true }
    if name == "tmpnam" { return true }
    if name == "signal" { return true }
    if name == "raise" { return true }
    if name == "socket" { return true }
    if name == "bind" { return true }
    if name == "listen" { return true }
    if name == "accept" { return true }
    if name == "connect" { return true }
    if name == "select" { return true }
    if name == "htons" { return true }
    if name == "htonl" { return true }
    if name == "ntohs" { return true }
    if name == "ntohl" { return true }
    if name == "inet_addr" { return true }
    return false
}

// The `orbit_` prefix belongs to the runtime, and reusing it fails in the most
// confusing way available: `orbit check` passes, then the C compiler reports a
// signature conflict against a runtime function the user never mentioned.
// `fn orbit_string_concat(a: string, b: string)` is emitted as a definition of
// `orbit_string_concat`, which the runtime already defines with an extra arena
// parameter, so the error is "too many arguments to function" against a symbol
// the program did not appear to call. `extern fn` is how the compiler itself
// reaches the runtime, so declarations are exempt; only definitions collide.
fn reservedRuntimePrefix(name: string) -> bool {
    if name.len() < 6 { return false }
    return name.slice(0, 6) == "orbit_"
}

// A `model` becomes a C struct under the user's own name, so a model named
// after a C type or typedef collides with a declaration the program never
// wrote. `model FILE` fails at C compile time with "conflicting types for
// 'FILE'; have 'struct FILE'", which says nothing about the model. The runtime
// prefix is excluded here too, because a model named `orbit_Foo` would
// collide with a runtime type of that name just as a function would.
fn reservedCTypeName(name: string) -> bool {
    if reservedRuntimePrefix(name) { return true }
    if name == "FILE" { return true }
    if name == "size_t" { return true }
    if name == "ssize_t" { return true }
    if name == "ptrdiff_t" { return true }
    if name == "intptr_t" { return true }
    if name == "uintptr_t" { return true }
    if name == "wchar_t" { return true }
    if name == "time_t" { return true }
    if name == "clock_t" { return true }
    if name == "va_list" { return true }
    if name == "fpos_t" { return true }
    if name == "div_t" { return true }
    if name == "ldiv_t" { return true }
    if name == "sig_atomic_t" { return true }
    if name == "jmp_buf" { return true }
    return false
}

fn hasErrors(sema: Sema) -> bool {
    return sema.errors.len() > 0
}

fn registerType(sema: Sema, name: string, kind: string, variants: list) {
    var i = 0
    while i < sema.typeRegistry.len() {
        val t = sema.typeRegistry.get(i)
        if t.name == name {
            return
        }
        i = i + 1
    }
    sema.typeRegistry.push(TypeInfo(name, kind, variants))
    // Index the variants alongside the type. Without this, a union value
    // whose type was never written down -- `val s = Circle(7)` -- is
    // indistinguishable from any other unknown-typed expression, and the
    // exhaustiveness check below has nothing to check against.
    var vi = 0
    while vi < variants.len() {
        val variantNode = variants.get(vi)
        match variantNode {
            ASTNode.Literal(vl) => { sema.variantRegistry.push(VariantInfo(vl.text, name)) }
            _ => {}
        }
        vi = vi + 1
    }
    // A type name is a name like any other: a function parameter, a val, a
    // field. Declaring it is what makes `fn area(s: Shape)` and the
    // uppercase-identifier fallback agree, and what lets a later `Shape`
    // expression be recognised as a type rather than an unknown identifier.
    declareSymbol(sema, name, name, false, false)
}

// The enum or union that declares `variantName`, or "" if no declared type
// does. This is the only evidence available for the type of a constructed
// variant, so it is deliberately keyed on the variant name alone.
fn findVariantOwner(sema: Sema, variantName: string) -> string {
    var i = 0
    while i < sema.variantRegistry.len() {
        val v = sema.variantRegistry.get(i)
        if v.variant == variantName {
            return v.owner
        }
        i = i + 1
    }
    return ""
}

fn findType(sema: Sema, name: string) -> int {
    var i = 0
    while i < sema.typeRegistry.len() {
        val t = sema.typeRegistry.get(i)
        if t.name == name {
            return i
        }
        i = i + 1
    }
    return -1
}

// An enum or a union: the two kinds whose value is one of a fixed set of
// variants, and therefore the two kinds a `match` has to be exhaustive over.
// An alias has no variants of its own and is never checked.
fn isTaggedTypeIndex(sema: Sema, index: int) -> bool {
    if index < 0 { return false }
    val t = sema.typeRegistry.get(index)
    if t.kind == "enum" { return true }
    if t.kind == "union" { return true }
    return false
}

fn typeHasVariant(sema: Sema, typeName: string, variantName: string) -> bool {
    val idx = findType(sema, typeName)
    if idx < 0 { return false }
    val t = sema.typeRegistry.get(idx)
    var i = 0
    while i < t.variants.len() {
        val variantNode = t.variants.get(i)
        match variantNode {
            ASTNode.Literal(vl) => {
                if vl.text == variantName { return true }
            }
            _ => {}
        }
        i = i + 1
    }
    return false
}

fn declareSymbol(sema: Sema, name: string, typeName: string, isMutable: bool, isFunction: bool) {
    declareSymbolWithParams(sema, name, typeName, isMutable, isFunction, [])
}

fn declareSymbolWithParams(sema: Sema, name: string, typeName: string, isMutable: bool, isFunction: bool, paramTypes: list) {
    val scope = sema.scopes.get(sema.currentScope)
    var i = 0
    while i < scope.symbols.len() {
        val sym = scope.symbols.get(i)
        if sym.name == name {
            reportError(sema, "Duplicate symbol: " + name)
            return
        }
        i = i + 1
    }
    scope.symbols.push(Symbol(name, typeName, isMutable, isFunction, paramTypes))
}

// The function symbol a name refers to, or NULL when no scope in the chain
// declares it as a function. A call site needs the declaration, not just the
// return type, and NULL is the only honest answer for "not there": a function
// that takes no parameters has an empty parameter list, which is not the same
// thing as no declaration at all.
fn resolveFunctionSymbol(sema: Sema, name: string) -> Symbol {
    var scopeId = sema.currentScope
    while scopeId >= 0 {
        val scope = sema.scopes.get(scopeId)
        var i = 0
        while i < scope.symbols.len() {
            val sym: Symbol = scope.symbols.get(i)
            if sym.name == name && sym.isFunction {
                return sym
            }
            i = i + 1
        }
        scopeId = scope.parentId
    }
    return NULL
}

// The type a name was declared with, or "" when no scope in the chain
// declares it.
//
// "" and "unknown" are different answers, and the difference is the whole
// point. "unknown" is a symbol the checker FOUND and has no type rule for -- a
// match binding, a `for` item, a `val` bound to a value nothing types -- and it
// is the honest answer, so it is not a miss. "" is a name nothing declares, and
// that is a bug in the program. checkCompatibility accepted "unknown" on either
// side of a comparison, so the two were indistinguishable from the first
// inference to codegen: `print(undeclaredThing)` checked clean and printed a
// live stack address, and nothing downstream could tell it apart from a `val`
// bound to a list element.
fn resolveSymbol(sema: Sema, name: string) -> string {
    var scopeId = sema.currentScope
    while scopeId >= 0 {
        val scope = sema.scopes.get(scopeId)
        var i = 0
        while i < scope.symbols.len() {
            val sym = scope.symbols.get(i)
            if sym.name == name {
                return sym.typeName
            }
            i = i + 1
        }
        scopeId = scope.parentId
    }
    return ""
}

fn resolveFunction(sema: Sema, name: string) -> string {
    val sym = resolveFunctionSymbol(sema, name)
    if sym == NULL { return "" }
    return sym.typeName
}

// The sentinel every type rule already expects. Kept so the callers that are
// probing -- is this name a model? -- are not disturbed: a probe answers a
// question and a reference resolves a type, and only the second one is allowed
// to say the name does not exist.
fn lookupSymbol(sema: Sema, name: string) -> string {
    val found = resolveSymbol(sema, name)
    if found == "" { return "unknown" }
    return found
}

fn lookupFunction(sema: Sema, name: string) -> string {
    val sym = resolveFunctionSymbol(sema, name)
    if sym == NULL { return "unknown" }
    return sym.typeName
}

fn recordMiss(sema: Sema, kind: string, name: string) {
    sema.misses.push(NameMiss(name, kind))
}

// The number the gate reads: resolution misses the language provides for
// itself, which is the part of the gap that cannot be reported as an error
// because the corpus depends on it. Everything else is rejected.
fn missCount(sema: Sema, kind: string) -> int {
    var n = 0
    var i = 0
    while i < sema.misses.len() {
        val m: NameMiss = sema.misses.get(i)
        if m.kind == kind { n = n + 1 }
        i = i + 1
    }
    return n
}

// Names the language provides without a `fn` declaration, so a resolver that
// only knows declared symbols calls every one of them unresolved.
//
// Two groups, and they are not the same kind of debt. The first is the
// builtins: the emitter recognises them by name (compiler/builder.orb,
// compiler/c_backend.orb), so a program uses them and nothing declares them.
// The second is the runtime entry points the compiler itself calls: the
// emitted C resolves them through <orbit/runtime.h>, which the front end never
// reads, so `orbit_string_len` is a real Orbit name with no Orbit
// declaration. Both are counted, and both are the honest size of what is left;
// neither is a reason to reject a program.
fn isProvidedName(name: string) -> bool {
    if name == "NULL" { return true }
    if name == "system" { return true }
    if name == "self" { return true }
    if name == "len" { return true }
    if name == "at" { return true }
    if name == "slice" { return true }
    if name == "indexOf" { return true }
    if name == "contains" { return true }
    if name == "toInt" { return true }
    if name == "toFloat" { return true }
    if name == "toString" { return true }
    if name == "abs" { return true }
    if name == "min" { return true }
    if name == "max" { return true }
    if name == "floor" { return true }
    if name == "ceil" { return true }
    if name == "round" { return true }
    if name == "sqrt" { return true }
    if name == "pow" { return true }
    if name == "push" { return true }
    if name == "get" { return true }
    if name == "set" { return true }
    if name == "has" { return true }
    if name == "keys" { return true }
    if name == "values" { return true }
    if name == "delete" { return true }
    if name == "join" { return true }
    if name == "split" { return true }
    if name == "replace" { return true }
    if name == "trim" { return true }
    if name == "upper" { return true }
    if name == "lower" { return true }
    if name == "startsWith" { return true }
    if name == "endsWith" { return true }
    if name == "sort" { return true }
    if name == "map" { return true }
    if name == "filter" { return true }
    if name == "reduce" { return true }
    if name == "sum" { return true }
    if name == "env" { return true }
    if name == "print" { return true }
    if name == "ok" { return true }
    if name == "err" { return true }
    if name == "orbit_string_len" { return true }
    if name == "orbit_string_slice" { return true }
    if name == "orbit_string_indexOf" { return true }
    if name == "orbit_http_client_fetch" { return true }
    if name == "orbit_cache_get" { return true }
    if name == "orbit_file_upload_save" { return true }
    return false
}

// Resolve a callee that is a bare name, and say so when nothing declares it.
//
// The name is checked against every form a callee can legitimately take before
// it is called unresolved, and in this order: a declared function (the real
// case), a model name (a construction, not a call), a variant name (also a
// construction), and finally a name the language provides without declaring.
// Only what is left over is a program that calls something which is not there,
// and that used to reach the C output as a call to a symbol nothing declares.
fn resolveCalleeName(sema: Sema, name: string) -> string {
    val fnType = resolveFunction(sema, name)
    if fnType != "" { return fnType }
    val declared = resolveSymbol(sema, name)
    if declared == "model" { return name }
    if declared != "" {
        // The name is declared, just not as something callable. "Undeclared"
        // would be the wrong word for that, and the wrong word sends the
        // reader looking for a missing `fn` that is right there on the page.
        reportError(sema, "Cannot call '" + name + "': it is a " + declared + ", not a function")
        return "unknown"
    }
    if findVariantOwner(sema, name) != "" { return "unknown" }
    if isProvidedName(name) { return "unknown" }
    recordMiss(sema, "function", name)
    reportError(sema, "Undeclared function: " + name + "; nothing in scope declares it")
    return "unknown"
}

// Arity, decided from the declaration and the arguments together.
//
// The other half of this check -- the argument's TYPE against the parameter's
// declared type -- is written and switched off, and the reason is a finding
// rather than a doubt. Turning it on rejected 100% of what it should have
// rejected on the whole corpus and nothing else, and the first thing it found
// was std/sys/crypto/jwt.orb:17:
//
//     extern fn orbit_string_len(s: string) -> string
//
// The C function returns orbit_int, so every `totalLen` in that file is typed
// string and is then passed to orbit_string_slice's `end: int`. Three programs
// that import it stop building until that one word is corrected, and std/ is
// another zone's. The check is one line away and the evidence is on the board.
fn checkCallArity(sema: Sema, name: string, argCount: int) {
    val sym = resolveFunctionSymbol(sema, name)
    if sym == NULL { return }
    val params = sym.paramTypes
    if params.len() == argCount { return }
    if params.len() == 1 {
        reportError(sema, "Wrong number of arguments to " + name + ": it takes 1, got " + orbit_int_to_string_selfhost(argCount))
    } else {
        reportError(sema, "Wrong number of arguments to " + name + ": it takes " + orbit_int_to_string_selfhost(params.len()) + ", got " + orbit_int_to_string_selfhost(argCount))
    }
}

fn checkCompatibility(expected: string, actual: string) -> bool {
    if expected == "unknown" || actual == "unknown" { return true }
    if expected == actual { return true }
    if expected == "result" { return true }
    if expected == "response" { return true }
    return false
}

fn pushScope(sema: Sema) {
    val newScopeId = sema.scopes.len()
    sema.scopes.push(Scope([], sema.currentScope))
    sema.currentScope = newScopeId
}

fn popScope(sema: Sema) {
    val parentScope = sema.scopes.get(sema.currentScope)
    sema.currentScope = parentScope.parentId
}

fn checkModelName(sema: Sema, name: string) {
    if reservedCTypeName(name) {
        sema.currentFunction = name
        reportError(sema, "'" + name + "' is a C type name and cannot be used as an Orbit model name; rename it (for example Orbit" + name + ")")
        sema.currentFunction = ""
    }
}

fn checkModelDecl(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.ModelDecl(m) => {
            checkModelName(sema, m.name)
            declareSymbol(sema, m.name, "model", false, false)
            var i = 0
            while i < m.fields.len() {
                checkNode(sema, m.fields.get(i))
                i = i + 1
            }
        }
        _ => {}
    }
}

fn checkVarDecl(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.VarDecl(v) => {
            val valueType = inferType(sema, v.value)
            declareSymbol(sema, v.name, valueType, v.isMutable, false)
            if v.isMutable == false {
                recordConstBound(sema, v.name, v.value)
            }
        }
        _ => {}
    }
}

fn checkConstDecl(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.ConstDecl(c) => {
            val valueType = inferType(sema, c.value)
            declareSymbol(sema, c.name, valueType, false, false)
            recordConstBound(sema, c.name, c.value)
        }
        _ => {}
    }
}

/* ── Constant index bounds ───────────────────────────────────────────────────
 *
 * `xs.get(99)` on a two-element list used to answer 0, and 0 is also what a
 * slot that really holds 0 answers, so a caller had no way to tell a bug from
 * a value. The runtime now stops the process on an out-of-range read (see
 * orbit_list_index_error), which is the fix for the case the checker cannot
 * see. This is the other half: when the checker CAN see it -- a `val` bound to
 * a literal, indexed by a literal -- there is no reason to compile the program
 * at all.
 *
 * Narrow on purpose. Only:
 *   - an immutable binding, because a `var` can be reassigned and then the
 *     recorded length is a lie;
 *   - a string literal with no backslash in it, because "\t" is two characters
 *     in the source and one in the value and counting the source would make
 *     the check wrong in the direction that rejects good code;
 *   - a list literal, whose length is its element count.
 * Everything else is left to the runtime.
 */
model ConstBound {
    name: string
    kind: string
    len: int
}

fn recordConstBound(sema: Sema, name: string, value: list) {
    if name == "" { return }
    match value {
        ASTNode.Literal(lit) => {
            if lit.valType == "string" {
                if lit.text.indexOf("\\") == -1 {
                    sema.constBounds.push(ConstBound(name, "string", lit.text.len() - 2))
                }
            }
        }
        ASTNode.ListLiteral(ll) => {
            sema.constBounds.push(ConstBound(name, "list", ll.elements.len()))
        }
        _ => {}
    }
}

/** @brief The recorded length for @p name, or -1. */
fn constBoundLen(sema: Sema, name: string, wantKind: string) -> int {
    var i = sema.constBounds.len()
    while i > 0 {
        i = i - 1
        val entry: ConstBound = sema.constBounds.get(i)
        if entry.name == name && entry.kind == wantKind {
            return entry.len
        }
    }
    return -1
}

/** @brief The index of a literal integer index expression, or -1.
 *
 *  Spelled out digit by digit rather than handed to orbit_string_to_int,
 *  because the front end does not know that name: it is a runtime entry point
 *  and nothing in an Orbit program declares it (the same gap as F-0004). A
 *  local loop is the smaller change than teaching the resolver about another
 *  runtime symbol, and it only has to read the one shape a literal index can
 *  take. Anything else -- a computed index, a negative one, a hex literal --
 *  answers -1 and is left to the runtime, which stops the process. */
fn literalIndexValue(node: list) -> int {
    match node {
        ASTNode.Literal(lit) => {
            if lit.valType != "int" { return -1 }
            val text = lit.text
            val n = orbit_string_len(text)
            if n == 0 { return -1 }
            var v = 0
            var i = 0
            while i < n {
                val c = text.at(i)
                if c < 48 || c > 57 { return -1 }
                v = v * 10 + (c - 48)
                i = i + 1
            }
            return v
        }
        _ => { return -1 }
    }
}

fn identifierName(node: list) -> string {
    match node {
        ASTNode.Literal(lit) => {
            if lit.valType == "identifier" { return lit.text }
            return ""
        }
        _ => { return "" }
    }
}

/** @brief Reject a literal index that is past the end of a literal receiver.
 *
 *  Which collection it is comes out of the recorded bound, so the message can
 *  say so: `s.at(99)` over "hello" is a bad character index and `xs.get(99)` is
 *  a bad element index, and both used to answer 0 -- the same 0 a slot holding
 *  0 answers, which is why neither was a bug anybody could see. */
fn checkConstantIndex(sema: Sema, recv: list, indexNode: list, line: int, col: int) {
    val idx = literalIndexValue(indexNode)
    if idx < 0 { return }
    val name = identifierName(recv)
    if name == "" { return }
    val slen = constBoundLen(sema, name, "string")
    val llen = -1
    if slen < 0 {
        llen = constBoundLen(sema, name, "list")
        if llen < 0 { return }
    }
    if slen >= 0 && idx < slen { return }
    if slen < 0 && idx < llen { return }
    val at = orbit_int_to_string_selfhost(line) + ":" + orbit_int_to_string_selfhost(col)
    var seen = 0
    while seen < sema.indexChecks.len() {
        if sema.indexChecks.get(seen) == at { return }
        seen = seen + 1
    }
    sema.indexChecks.push(at)
    if slen >= 0 {
        reportErrorAt(sema, "E1002", "indices run from 0 to " + orbit_int_to_string_selfhost(slen - 1) + " here, so a literal one can be checked while compiling", line, col, "String index " + orbit_int_to_string_selfhost(idx) + " is out of range for \"" + name + "\", which holds " + orbit_int_to_string_selfhost(slen) + " characters")
        return
    }
    reportErrorAt(sema, "E1002", "a literal index into a literal list can be checked while compiling; guard a computed one with if i < xs.len()", line, col, "List index " + orbit_int_to_string_selfhost(idx) + " is out of range for \"" + name + "\", which holds " + orbit_int_to_string_selfhost(llen) + " elements")
}

fn checkFunctionSignature(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.FunctionDecl(f) => {
            var returnType = f.returnType
            if returnType == "" {
                returnType = "void"
            }
            if reservedCFunctionName(f.name) {
                sema.currentFunction = f.name
                reportError(sema, "'" + f.name + "' is a C library function name and cannot be used as an Orbit function name; rename it (for example user_" + f.name + ")")
                sema.currentFunction = ""
            } else if f.isExtern == false && reservedRuntimePrefix(f.name) {
                sema.currentFunction = f.name
                reportError(sema, "'" + f.name + "' starts with orbit_, which is reserved for the runtime; rename it (drop the prefix, or use a different one)")
                sema.currentFunction = ""
            }
            declareSymbolWithParams(sema, f.name, returnType, false, true, f.paramTypes)
        }
        _ => {}
    }
}

fn checkFunctionBody(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.FunctionDecl(f) => {
            var returnType = f.returnType
            if returnType == "" {
                returnType = "void"
            }
            val prevReturn = sema.currentReturnType
            sema.currentReturnType = returnType
            sema.currentFunction = f.name

            pushScope(sema)
            var i = 0
            while i < f.params.len() {
                val pName = f.params.get(i)
                var pType = "unknown"
                if i < f.paramTypes.len() {
                    pType = f.paramTypes.get(i)
                }
                declareSymbol(sema, pName, pType, false, false)
                i = i + 1
            }
            checkNode(sema, f.body)
            popScope(sema)

            sema.currentReturnType = prevReturn
        }
        _ => {}
    }
}

fn checkRouteBody(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.RouteDecl(r) => {
            val routeKey = r.http_method + " " + r.path
            if listContainsValue(sema.seenRoutes, routeKey) {
                reportError(sema, "Duplicate route: " + routeKey)
            } else {
                sema.seenRoutes.push(routeKey)
            }
            if r.has_limit {
                if r.limit_rate <= 0 {
                    reportError(sema, "Route limit rate must be > 0: " + routeKey)
                }
                if r.limit_window_ms <= 0 {
                    reportError(sema, "Route limit window must be > 0: " + routeKey)
                }
                if r.limit_burst < 0 {
                    reportError(sema, "Route limit burst must be >= 0: " + routeKey)
                }
            }
            val prevReturn = sema.currentReturnType
            sema.currentReturnType = "response"
            pushScope(sema)
            declareSymbol(sema, "req", "request", false, false)
            declareSymbol(sema, "res", "response", false, false)
            checkNode(sema, r.body)
            popScope(sema)
            sema.currentReturnType = prevReturn
        }
        _ => {}
    }
}

fn checkBlock(sema: Sema, block: ASTNode) {
    match block {
        ASTNode.Block(b) => {
            pushScope(sema)
            var i = 0
            while i < b.statements.len() {
                checkNode(sema, b.statements.get(i))
                i = i + 1
            }
            popScope(sema)
        }
        _ => {}
    }
}

fn checkIfStatement(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.If(stmt) => {
            inferType(sema, stmt.condition)
            checkNode(sema, stmt.thenBody)
            checkNode(sema, stmt.elseBody)
        }
        _ => {}
    }
}

fn checkWhileLoop(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.While(w) => {
            inferType(sema, w.condition)
            checkNode(sema, w.body)
        }
        _ => {}
    }
}

fn checkForLoop(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.For(f) => {
            inferType(sema, f.iterable)
            pushScope(sema)
            declareSymbol(sema, f.item, "unknown", false, false)
            checkNode(sema, f.body)
            popScope(sema)
        }
        _ => {}
    }
}

fn sameString(left: string, right: string) -> bool {
    return left == right
}

// The variant a case pattern names, or "" when the pattern is not a variant of
// `matchType`. A pattern is `Type.Variant`, `Type.Variant(binding)`, the bare
// `Variant` form for a payload-less variant, or `_`.
//
// The owner matters. `Other.Circle(r)` is a real case and it is not a case for
// `Shape`, so counting its field name as coverage is how a match that reads
// exhaustive turns out not to be. An unqualified pattern is taken at face
// value: the parser records no type for it and the builder compares the
// variant's own tag.
fn patternVariantName(sema: Sema, matchType: string, pattern: ASTNode) -> string {
    match pattern {
        ASTNode.Literal(l) => {
            if l.valType != "identifier" { return "" }
            return l.text
        }
        ASTNode.MemberAccess(ma) => {
            return qualifiedVariantName(sema, matchType, ma.object, ma.field)
        }
        ASTNode.Call(innerCall) => {
            match innerCall.callee {
                ASTNode.Literal(l) => {
                    if l.valType == "identifier" { return l.text }
                    return ""
                }
                ASTNode.MemberAccess(ma2) => {
                    return qualifiedVariantName(sema, matchType, ma2.object, ma2.field)
                }
                _ => { return "" }
            }
        }
        _ => { return "" }
    }
}

fn qualifiedVariantName(sema: Sema, matchType: string, owner: ASTNode, field: string) -> string {
    var ownerName = ""
    match owner {
        ASTNode.Literal(l) => {
            if l.valType == "identifier" { ownerName = l.text }
        }
        _ => {}
    }
    // A qualifier that names a different declared type is naming a different
    // type's variant, whatever the field is called.
    if ownerName != "" && findType(sema, ownerName) >= 0 && ownerName != matchType { return "" }
    return field
}

fn checkMatchExhaustive(sema: Sema, m: MatchNode, matchType: string) {
    val typeIdx = findType(sema, matchType)
    if isTaggedTypeIndex(sema, typeIdx) == false { return }
    val t = sema.typeRegistry.get(typeIdx)

    var covered = []
    var hasWildcard = false
    var i = 0
    while i < m.cases.len() {
        val cnode = m.cases.get(i)
        match cnode {
            ASTNode.MatchCase(c) => {
                // `_` is the one opt-out, and it is explicit: it says "the
                // fall-through is intended". That is the whole reason a
                // missing arm can be an error at all. The test is the
                // builder's own, so the two agree on what a wildcard is.
                match c.pattern {
                    ASTNode.Literal(wl) => {
                        if wl.text == "_" { hasWildcard = true }
                    }
                    _ => {}
                }
                val variant = patternVariantName(sema, matchType, c.pattern)
                if variant != "" { covered.push(variant) }
            }
            _ => {}
        }
        i = i + 1
    }
    if hasWildcard { return }

    // One diagnostic per match, not per missing variant: a `match` on a large
    // type can be missing thirty cases, and thirty near-identical lines bury
    // the one fact the reader needs.
    var missing = []
    var v = 0
    while v < t.variants.len() {
        val variantNode = t.variants.get(v)
        var variant = ""
        match variantNode {
            ASTNode.Literal(l) => { variant = l.text }
            _ => {}
        }
        var found = false
        var ck = 0
        while ck < covered.len() {
            if sameString(covered.get(ck), variant) { found = true }
            ck = ck + 1
        }
        if found == false && variant != "" { missing.push(variant) }
        v = v + 1
    }
    if missing.len() == 0 { return }

    var list = ""
    var mi = 0
    while mi < missing.len() {
        if mi > 0 { list = list + ", " }
        list = list + matchType + "." + missing.get(mi)
        mi = mi + 1
    }
    // A match with no case for a variant is not a runtime error the author
    // sees: the builder emits one tag test per case and no test after the
    // last, so the value falls out of the end of the match and the
    // surrounding code carries on as if the match had handled it.
    reportErrorAt(sema, "E1001", "Add a case for every variant, or a `_` arm if the fall-through is intended.", m.line, m.col, "Non-exhaustive match on " + matchType + ": no case for " + list)
}

// The name a match case binds, or "" when the pattern binds nothing. A
// pattern is `Type.Variant`, `Type.Variant(binding)`, `Variant`,
// `Variant(binding)`, a literal, or `_`, so the binding is always a call
// argument and never the pattern itself.
fn patternBinding(pattern: ASTNode) -> string {
    match pattern {
        ASTNode.Call(c) => {
            if c.args.len() == 0 { return "" }
            val first: ASTNode = c.args.get(0)
            match first {
                ASTNode.Literal(l) => {
                    if l.valType == "identifier" { return l.text }
                }
                _ => {}
            }
            return ""
        }
        _ => { return "" }
    }
}

// Check a case body with the case's binding in scope.
//
// A binding is a name like any other and no scope contained it, so every
// `match` arm in the compiler -- 241 of them -- read a symbol the checker had
// never seen, and the resolution count below was dominated by the compiler's
// own match arms instead of by anything actually unresolved. The payload's
// type is not known here (a variant declares a payload, not a type for it), so
// the symbol is declared `unknown`, which is now distinguishable from not
// being declared at all rather than being confused with it.
fn checkMatchCase(sema: Sema, c: MatchCaseNode) {
    pushScope(sema)
    val bound = patternBinding(c.pattern)
    if bound != "" {
        declareSymbol(sema, bound, "unknown", false, false)
    }
    checkNode(sema, c.body)
    popScope(sema)
}

fn checkMatch(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.Match(m) => {
            val matchType = inferType(sema, m.expr)
            var i = 0
            while i < m.cases.len() {
                val caseNode = m.cases.get(i)
                match caseNode {
                    ASTNode.MatchCase(c) => {
                        checkMatchCase(sema, c)
                    }
                    _ => {}
                }
                i = i + 1
            }
            checkMatchExhaustive(sema, m, matchType)
        }
        _ => {}
    }
}

fn checkReturn(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.Return(r) => {
            var expectedType = sema.currentReturnType
            if expectedType == "" {
                expectedType = "void"
            }
            match r.expr {
                ASTNode.Empty => {
                    if expectedType != "void" {
                        reportError(sema, "Non-void function must return a value")
                    }
                }
                _ => {
                    val actualType = inferType(sema, r.expr)
                    if checkCompatibility(expectedType, actualType) == false {
                        reportError(sema, "Return type mismatch: expected " + expectedType + ", got " + actualType)
                    }
                }
            }
        }
        ASTNode.ReturnOk(r) => {
            match r.expr {
                ASTNode.Empty => {
                    reportError(sema, "ok response must include a value")
                }
                _ => {
                    // orbit_response_json takes a C string body: a known
                    // non-string body (e.g. an int register) would compile
                    // to an int-to-pointer conversion. Reject it here with
                    // a proper diagnostic instead of broken C downstream.
                    val bodyType = inferType(sema, r.expr)
                    // An object is the other thing a body can legitimately be:
                    // the runtime serializes it to JSON on the way out.
                    if bodyType != "object" && checkCompatibility("string", bodyType) == false {
                        reportError(sema, "ok response body must be a string or an object, got " + bodyType)
                    }
                }
            }
        }
        ASTNode.ReturnErr(r) => {
            match r.expr {
                ASTNode.Empty => {
                    reportError(sema, "err response must include a message")
                }
                _ => {
                    val bodyType = inferType(sema, r.expr)
                    if checkCompatibility("string", bodyType) == false {
                        reportError(sema, "err response body must be a string, got " + bodyType)
                    }
                }
            }
        }
        _ => {}
    }
}

// Only these can be interpolated. A model, list, map or result has no obvious
// textual form, and guessing one is how a body ends up serving "[object]" or
// garbage: better to refuse and let the author say what they mean.
//
// "unknown" is allowed through on purpose. Sema does not track the type of a
// local bound to a literal, so `val n = 42` reads back as unknown, and
// refusing it would make interpolation useless. It is not a hole: the backend
// refines register types as it emits, and converts each value with the runtime
// helper that matches the type it settled on.
fn isInterpolatable(typeName: string) -> bool {
    if typeName == "string" { return true }
    if typeName == "int" { return true }
    if typeName == "float" { return true }
    if typeName == "bool" { return true }
    if typeName == "unknown" { return true }
    return false
}

fn isStringChunk(node: ASTNode) -> bool {
    match node {
        ASTNode.Literal(l) => {
            if l.valType == "string_chunk" { return true }
            return false
        }
        _ => { return false }
    }
}

// Checking is separate from lowering on purpose. Sema runs first and knows the
// types, so it is the only place that can say "cannot interpolate a model"; the
// builder runs later, knows each value's register type, and picks the
// conversion. Neither needs to wait for the other, and no AST rewriting is
// needed to carry a type from one to the other.
fn checkInterpolation(sema: Sema, node: ASTNode) -> bool {
    match node {
        ASTNode.Interp(ip) => {
            var i = 0
            var bad = 0
            while i < ip.parts.len() {
                val part = ip.parts.get(i)
                if !isStringChunk(part) {
                    val partType = inferType(sema, part)
                    if !isInterpolatable(partType) {
                        reportError(sema, "cannot interpolate a value of type '" + partType + "' in a string; only string, int, float and bool convert")
                        bad = bad + 1
                    }
                }
                i = i + 1
            }
            return bad == 0
        }
        _ => { return true }
    }
}

fn inferType(sema: Sema, node: ASTNode) -> string {
    match node {
        ASTNode.Literal(l) => {
            if l.valType == "identifier" {
                val typeName = resolveSymbol(sema, l.text)
                if typeName == "" {
                    // Nothing declares this name. That is not the same as not
                    // knowing the type of a name that IS declared, and the two
                    // used to be the same string.
                    if l.text.len() > 0 {
                        val first = l.text.slice(0, 1)
                        if first >= "A" && first <= "Z" { return l.text }
                    }
                    if !isProvidedName(l.text) {
                        recordMiss(sema, "name", l.text)
                        reportError(sema, "Undeclared identifier: " + l.text + "; nothing in scope declares it")
                    }
                    return "unknown"
                }
                return typeName
            }
            // A raw string is a string as far as the type system is concerned;
            // string_raw only exists to tell the lowering not to unescape it.
            if l.valType == "string_raw" { return "string" }
            // Literal chunks of an interpolation are already their own ASTNode
            // and are not reachable as a value, but keep them harmless.
            if l.valType == "string_chunk" { return "string" }
            if l.valType == "int" {
                // Recorded, not rejected. Rejecting an out-of-range literal is
                // one line away and it is the right end state -- gcc refuses
                // the same literal for the same reason -- but the corpus
                // contains tests that assert the wrap on purpose
                // (tests/std/test_time_ns.orb:93-94 call sinceNsBetween with
                // INT_MAX+1 to prove the clamp fires), and tests/std belongs to
                // another zone. So the case is detected, counted and ratcheted
                // here, and the diagnostic waits for those two lines to be
                // rewritten as 2147483647 + 1. FINDINGS F-0014.
                if !intLiteralFitsSelfhost(l.text) {
                    // An error, not a resolution gap. It was recorded rather
                    // than rejected only because two lines of a std test
                    // spelled the overflow as a literal; they are now written
                    // as the sum it is, so the reason is gone.
                    //
                    // Counting it as a miss also meant every program with a
                    // large integer printed `UNRESOLVED int-literal 1` to
                    // stderr -- a quiet program is supposed to say nothing.
                    reportError(sema, "integer literal " + l.text + " does not fit an orbit_int, which is 32 bits; write the value as a sum if you mean it")
                }
            }
            return l.valType
        }
        ASTNode.BinaryOp(b) => {
            val lhsType = inferType(sema, b.lhs)
            val rhsType = inferType(sema, b.rhs)
            if b.op == "==" || b.op == "!=" || b.op == "<" || b.op == "<=" || b.op == ">" || b.op == ">=" {
                return "bool"
            }
            if b.op == "&&" || b.op == "||" { return "bool" }
            if b.op == "+" && (lhsType == "string" || rhsType == "string") { return "string" }
            if lhsType == "float" || rhsType == "float" { return "float" }
            if lhsType == "int" && rhsType == "int" { return "int" }
            return "unknown"
        }
        ASTNode.UnaryOp(u) => {
            // `-2147483648` is INT_MIN spelled as a negation of a literal that
            // is itself one past INT_MAX. The literal does not fit on its own,
            // but the expression it appears in denotes a representable value
            // and is the only spelling of the integer minimum there is, so the
            // range check below is skipped here and nowhere else.
            if u.op == "-" {
                match u.operand {
                    ASTNode.Literal(l) => {
                        if l.valType == "int" && l.text == "2147483648" { return "int" }
                    }
                    _ => {}
                }
            }
            val operandType = inferType(sema, u.operand)
            if u.op == "!" { return "bool" }
            return operandType
        }
        ASTNode.Call(c) => {
            // The callee is resolved by the match below, not by the generic
            // identifier rule: a callee that is a builtin, a model
            // construction, a variant construction or a declared function is
            // not an unresolved name, and only what is left over is one.
            var calleeName = ""
            match c.callee {
                ASTNode.Literal(calleeLit) => {
                    if calleeLit.valType == "identifier" {
                        calleeName = calleeLit.text
                        resolveCalleeName(sema, calleeName)
                    }
                }
                _ => { inferType(sema, c.callee) }
            }
            var i = 0
            while i < c.args.len() {
                inferType(sema, c.args.get(i))
                i = i + 1
            }
            if calleeName != "" {
                checkCallArity(sema, calleeName, c.args.len())
            }
            // Check for builtins
            match c.callee {
                ASTNode.Literal(l) => {
                    if l.valType == "identifier" {
                        if l.text == "ok" { return "result" }
                        if l.text == "err" { return "result" }
                        if l.text == "print" { return "void" }
                        // A call whose callee names a model is that model's
                        // construction, not a function call, so it has that
                        // model's type. Reporting it as unknown is how a model
                        // reached a string hole and printed as nothing at all.
                        if lookupSymbol(sema, l.text) == "model" { return l.text }
                        val fnType = lookupFunction(sema, l.text)
                        if fnType != "unknown" { return fnType }
                        // `Circle(7)` is the construction of a variant, and it
                        // has the union's type, not the "unknown" a bare
                        // callee otherwise gets. A declared function of the
                        // same name wins, because then the call really is a
                        // call and only the payload is ambiguous.
                        val variantOwner = findVariantOwner(sema, l.text)
                        if variantOwner != "" { return variantOwner }
                        return "unknown"
                    }
                }
                ASTNode.MemberAccess(ma) => {
                    val objType = inferType(sema, ma.object)
                    val member = ma.field
                    // A literal index into a literal receiver is decidable now
                    // and never at run time, so it is decided now. `at` is the
                    // string spelling and `get` the list one, and both used to
                    // answer 0 for an index past the end.
                    if member == "at" || member == "get" || member == "charAt" {
                        if c.args.len() >= 1 {
                            checkConstantIndex(sema, ma.object, c.args.get(0), c.line, c.col)
                        }
                    }
                    // `ASTNode.MatchCase(x)` and `Shape.Circle(7)`: a variant
                    // reached through its type name is that type's value, the
                    // same way the bare-name form above is.
                    if typeHasVariant(sema, objType, member) { return objType }
                    if objType == "string" {
                        if member == "len" { return "int" }
                        if member == "contains" { return "bool" }
                        if member == "slice" { return "string" }
                        if member == "to_int" { return "int" }
                    }
                    if objType == "list" || objType == "List" {
                        if member == "len" { return "int" }
                        if member == "push" { return "void" }
                    }
                    if objType == "map" || objType == "Map" {
                        if member == "has" { return "bool" }
                        if member == "keys" { return "list" }
                        if member == "delete" { return "void" }
                    }
                    // system.uptime() and friends: the callee is a member
                    // access, so its type has to come from the member-access
                    // rules rather than from the string/list/map tables here.
                    val callObjName = ""
                    match ma.object {
                        ASTNode.Literal(ol) => {
                            if ol.valType == "identifier" { callObjName = ol.text }
                        }
                        _ => {}
                    }
                    if callObjName == "system" {
                        if member == "env" { return "string" }
                        if member == "uptime" { return "int" }
                        if member == "pid" { return "int" }
                        if member == "active_workers" { return "int" }
                        if member == "http_requests_total" { return "int" }
                        if member == "latency_avg_us" { return "int" }
                    }
                }
                _ => {}
            }
            return "unknown"
        }
        ASTNode.MemberAccess(ma) => {
            val objType = inferType(sema, ma.object)
            val member = ma.field
            if objType == "string" && member == "length" { return "int" }
            // `ASTNode.Empty` used as a value is an ASTNode, and reading it as
            // a field of some model of the same name is not: only a declared
            // variant of the receiver's own type is a union value.
            if typeHasVariant(sema, objType, member) { return objType }
            val objName = ""
            match ma.object {
                ASTNode.Literal(l) => { if l.valType == "identifier" { objName = l.text } }
                _ => {}
            }
            // The system.* builtins, so their type is known rather than
            // unknown. An unknown type is compatible with everything, which is
            // how `ok 200 system.uptime()` reached the C backend and passed an
            // int where a string pointer belongs.
            if objName == "system" {
                if member == "env" { return "string" }
                if member == "uptime" { return "int" }
                if member == "pid" { return "int" }
                if member == "active_workers" { return "int" }
                if member == "http_requests_total" { return "int" }
                if member == "latency_avg_us" { return "int" }
            }
            return "unknown"
        }
        ASTNode.IndexAccess(ia) => {
            inferType(sema, ia.object)
            inferType(sema, ia.index)
            checkConstantIndex(sema, ia.object, ia.index, ia.line, ia.col)
            return "unknown"
        }
        ASTNode.If(stmt) => {
            inferType(sema, stmt.condition)
            val thenType = inferType(sema, stmt.thenBody)
            return thenType
        }
        ASTNode.Match(m) => {
            val matchType = inferType(sema, m.expr)
            // A `match` used as a value -- `val n = match s { ... }` -- is
            // reached only by inferType, never by checkNode, so the
            // exhaustiveness check has to be asked for here too. Without this
            // the same non-exhaustive match is an error in statement position
            // and silently falls through in expression position.
            checkMatchExhaustive(sema, m, matchType)
            if m.cases.len() > 0 {
                match m.cases.get(0) {
                    ASTNode.MatchCase(mc) => {
                        // The first case's body, for the type of the whole
                        // expression. Its binding is in scope here too, or a
                        // `match` used as a value would read a name no scope
                        // declares while the same match in statement position
                        // does not.
                        pushScope(sema)
                        val bound = patternBinding(mc.pattern)
                        if bound != "" {
                            declareSymbol(sema, bound, "unknown", false, false)
                        }
                        val caseType = inferType(sema, mc.body)
                        popScope(sema)
                        return caseType
                    }
                    _ => { return "void" }
                }
            }
            return "void"
        }
        ASTNode.Block(b) => {
            if b.statements.len() > 0 {
                return inferType(sema, b.statements.get(b.statements.len() - 1))
            }
            return "void"
        }
        ASTNode.ListLiteral(ll) => {
            var ei = 0
            while ei < ll.elements.len() {
                inferType(sema, ll.elements.get(ei))
                ei = ei + 1
            }
            return "list"
        }
        ASTNode.Interp(ip) => {
            checkInterpolation(sema, node)
            return "string"
        }
        ASTNode.ObjectLiteral(ol) => {
            var i = 0
            while i < ol.fields.len() {
                val field: ASTNode = ol.fields.get(i)
                match field {
                    ASTNode.FieldInit(fi) => {
                        val fieldType = inferType(sema, fi.value)
                        // A list or a map has no value type to store, and the
                        // alternative -- keeping the pointer and calling it a
                        // string -- writes a pointer's digits into the JSON
                        // body. Refuse it until there is a real answer.
                        if fieldType == "list" || fieldType == "map" {
                            reportError(sema, "an object field cannot hold a " + fieldType + " yet: { " + fi.name + ": ... }")
                        }
                    }
                    _ => {}
                }
                i = i + 1
            }
            return "object"
        }
        ASTNode.Try(tr) => {
            inferType(sema, tr.expr)
            match tr.catchBody {
                ASTNode.Empty => {}
                _ => {
                    if tr.errName != "" {
                        declareSymbol(sema, tr.errName, "string", false, false)
                    }
                    checkNode(sema, tr.catchBody)
                }
            }
            return "unknown"
        }
        _ => { return "void" }
    }
}

fn checkNode(sema: Sema, node: ASTNode) {
    match node {
        ASTNode.Program(prog) => {
            // Pass 1: Register types and models
            var i = 0
            while i < prog.decls.len() {
                val decl = prog.decls.get(i)
                match decl {
                    ASTNode.ModelDecl(m) => { checkModelDecl(sema, decl) }
                    ASTNode.TypeDecl(t) => { registerType(sema, t.name, t.kind, t.variants) }
                    _ => {}
                }
                i = i + 1
            }
            // Pass 2: Register function signatures
            i = 0
            while i < prog.decls.len() {
                val decl = prog.decls.get(i)
                match decl {
                    ASTNode.FunctionDecl(f) => { checkFunctionSignature(sema, decl) }
                    ASTNode.TraitDecl(t) => { declareSymbol(sema, t.name, "type", false, false) }
                    _ => {}
                }
                i = i + 1
            }
            // Pass 3: Constants and top-level vals
            i = 0
            while i < prog.decls.len() {
                val decl = prog.decls.get(i)
                match decl {
                    ASTNode.ConstDecl(c) => { checkConstDecl(sema, decl) }
                    ASTNode.VarDecl(v) => { checkVarDecl(sema, decl) }
                    _ => {}
                }
                i = i + 1
            }
            // Pass 4: Function bodies, routes, impls
            i = 0
            while i < prog.decls.len() {
                val decl = prog.decls.get(i)
                match decl {
                    ASTNode.FunctionDecl(f) => { checkFunctionBody(sema, decl) }
                    ASTNode.RouteDecl(r) => { checkRouteBody(sema, decl) }
                    ASTNode.ImplDecl(im) => {
                        var j = 0
                        while j < im.methods.len() {
                            checkFunctionBody(sema, im.methods.get(j))
                            j = j + 1
                        }
                    }
                    _ => {}
                }
                i = i + 1
            }
        }
        ASTNode.FunctionDecl(f) => { checkFunctionBody(sema, node) }
        ASTNode.VarDecl(v) => { checkVarDecl(sema, node) }
        ASTNode.ConstDecl(c) => { checkConstDecl(sema, node) }
        ASTNode.BinaryOp(b) => { inferType(sema, node) }
        ASTNode.UnaryOp(u) => { inferType(sema, node) }
        ASTNode.Literal(l) => {}
        ASTNode.Interp(ip) => { checkInterpolation(sema, node) }
        ASTNode.ObjectLiteral(ol) => { inferType(sema, node) }
        ASTNode.Match(m) => { checkMatch(sema, node) }
        ASTNode.Call(c) => { inferType(sema, node) }
        ASTNode.MemberAccess(ma) => { inferType(sema, node) }
        ASTNode.IndexAccess(ia) => { inferType(sema, node) }
        ASTNode.ModelDecl(m) => { checkModelDecl(sema, node) }
        ASTNode.FieldDecl(fd) => {}
        ASTNode.Block(block) => { checkBlock(sema, node) }
        ASTNode.Return(r) => { checkReturn(sema, node) }
        ASTNode.ReturnOk(r) => { checkReturn(sema, node) }
        ASTNode.ReturnErr(r) => { checkReturn(sema, node) }
        ASTNode.If(stmt) => { checkIfStatement(sema, node) }
        ASTNode.While(w) => { checkWhileLoop(sema, node) }
        ASTNode.For(f) => { checkForLoop(sema, node) }
        ASTNode.TypeDecl(td) => { registerType(sema, td.name, td.kind, td.variants) }
        ASTNode.RouteDecl(r) => { checkRouteBody(sema, node) }
        ASTNode.Try(tr) => {
            inferType(sema, tr.expr)
            match tr.catchBody {
                ASTNode.Empty => {}
                _ => {
                    if tr.errName != "" {
                        declareSymbol(sema, tr.errName, "string", false, false)
                    }
                    checkNode(sema, tr.catchBody)
                }
            }
        }
        ASTNode.MatchCase(mc) => {}
        ASTNode.GenericParam(gp) => {}
        ASTNode.TraitDecl(trd) => { declareSymbol(sema, trd.name, "type", false, false) }
        ASTNode.ImplDecl(im) => {
            var j = 0
            while j < im.methods.len() {
                checkFunctionBody(sema, im.methods.get(j))
                j = j + 1
            }
        }
        ASTNode.ScheduleDecl(s) => { inferType(sema, s.handler) }
        ASTNode.ConfigDecl(cfg) => { inferType(sema, cfg.value) }
        ASTNode.Break(b) => {}
        ASTNode.Continue(c) => {}
        ASTNode.ImportStmt(i) => {}
        ASTNode.UseStmt(u) => {}
        ASTNode.Param(p) => {}
        ASTNode.Decorator(d) => {}
        ASTNode.TypeAnnotation(ta) => {}
        ASTNode.FieldInit(fi) => { inferType(sema, fi.value) }
        ASTNode.ExpressionStmt(e) => { inferType(sema, e.expr) }
        ASTNode.Assignment(a) => { inferType(sema, a.value) }
        ASTNode.ListLiteral(ll) => {
            var ei = 0
            while ei < ll.elements.len() {
                inferType(sema, ll.elements.get(ei))
                ei = ei + 1
            }
        }
        ASTNode.Empty => {}
    }
}

fn analyze(sema: Sema, node: ASTNode) {
    checkNode(sema, node)
}
