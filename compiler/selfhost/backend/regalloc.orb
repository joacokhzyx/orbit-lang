// compiler/selfhost/backend/regalloc.orb
// Linear Scan Register Allocator

import "../mir.orb"

// Representación de los registros físicos de x86-64
fn REG_RAX() -> int { return 0 }
fn REG_RCX() -> int { return 1 }
fn REG_RDX() -> int { return 2 }
fn REG_RBX() -> int { return 3 }
fn REG_RSP() -> int { return 4 }
fn REG_RBP() -> int { return 5 }
fn REG_RSI() -> int { return 6 }
fn REG_RDI() -> int { return 7 }
// Y R8 a R15...

model LiveInterval {
    mirIdx: int
    startInst: int
    endInst: int
    physicalReg: int // -1 if spilled to stack
}

model RegAllocContext {
    freeRegs: list // list of int
    activeIntervals: list // list of LiveInterval
    spillOffset: int
}

fn initRegAllocContext() -> RegAllocContext {
    // Inicializar registros disponibles (Caller/Callee saved)
    return RegAllocContext([REG_RAX(), REG_RCX(), REG_RDX(), REG_RSI(), REG_RDI()], [], 0)
}

// O(N) Linear Scan
fn allocateRegisters(func: MIRFunction) -> list {
    val ctx = initRegAllocContext()
    var mapping = [] // mirIdx -> physicalReg or StackOffset
    
    // Pass 1: Compute Liveness (Mock)
    // Pass 2: Linear Scan allocation
    // Si activeIntervals excede freeRegs, decidimos hacer 'spill' del intervalo que termina más tarde.
    
    return mapping
}
