// compiler/selfhost/backend/linker.orb
// Tiny Linker: PE (Windows) / ELF (Linux) Executable Builder

import "x86_64.orb"

// Constants for PE Header
fn PE_MAGIC() -> int { return 0x5A4D } // MZ
fn PE_MACHINE_X64() -> int { return 0x8664 }

// Constants for ELF Header
fn ELF_MAGIC() -> int { return 0x464C457F } // \x7F ELF

