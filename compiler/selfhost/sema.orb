import "../ast.orb"
import "query.orb"

// Orbit DORB Architecture: Semantic Analyzer (Type Checker)

model SemanticError {
    node: NodeIndex
    message: string
}

model SemanticResult {
    ok: bool
    error: SemanticError
}

fn createSemaOk() -> SemanticResult {
    return SemanticResult(true, SemanticError(-1, ""))
}

fn createSemaError(node: NodeIndex, msg: string) -> SemanticResult {
    return SemanticResult(false, SemanticError(node, msg))
}

// Flat Symbol Table (To be optimized into a Robin Hood HashMap in Phase 3)
model Symbol {
    name: string
    typeName: string
    isMutable: bool
    isFunction: bool
    node: NodeIndex
}

model Scope {
    symbols: list // list of Symbol
    parentId: int
}

model SemaContext {
    query: QueryContext
    scopes: list // list of Scope
    currentScope: int
    currentReturnType: string
    errors: list // list of SemanticError
}

fn initSemaContext(query: QueryContext) -> SemaContext {
    val globalScope = Scope([], -1)
    return SemaContext(query, [globalScope], 0, "", [])
}

fn pushScope(ctx: SemaContext) {
    val newScope = Scope([], ctx.currentScope)
    ctx.scopes.push(newScope)
    ctx.currentScope = ctx.scopes.len() - 1
}

fn popScope(ctx: SemaContext) {
    val scope = ctx.scopes.get(ctx.currentScope)
    ctx.currentScope = scope.parentId
}

fn registerSymbol(ctx: SemaContext, sym: Symbol) -> bool {
    val scope = ctx.scopes.get(ctx.currentScope)
    
    // Check for shadowing/re-declaration
    var i = 0
    while i < scope.symbols.len() {
        val existing = scope.symbols.get(i)
        if existing.name == sym.name {
            ctx.errors.push(SemanticError(sym.node, "Symbol '" + sym.name + "' is already defined in this scope."))
            return false
        }
        i = i + 1
    }
    
    scope.symbols.push(sym)
    return true
}

fn lookupSymbol(ctx: SemaContext, name: string) -> Symbol {
    var curr = ctx.currentScope
    while curr != -1 {
        val scope = ctx.scopes.get(curr)
        var i = 0
        while i < scope.symbols.len() {
            val sym = scope.symbols.get(i)
            if sym.name == name {
                return sym
            }
            i = i + 1
        }
        curr = scope.parentId
    }
    // Return empty symbol if not found
    return Symbol("", "", false, false, -1)
}

fn analyzeProgram(ctx: SemaContext) -> SemanticResult {
    var i = 0
    var programNode = -1
    while i < ctx.query.pool.kinds.len() {
        if queryKind(ctx.query, i) == kindProgram() {
            programNode = i
            break
        }
        i = i + 1
    }
    
    if programNode == -1 {
        return createSemaError(-1, "No Program node found in ASTPool.")
    }
    
    var decl = queryLhs(ctx.query, programNode)
    while decl != -1 {
        val res = analyzeDeclaration(ctx, decl)
        if res.ok == false { return res }
        decl = getNextSibling(ctx.query, decl)
    }
    
    return createSemaOk()
}

fn analyzeDeclaration(ctx: SemaContext, decl: NodeIndex) -> SemanticResult {
    val kind = queryKind(ctx.query, decl)
    
    if kind == kindFunctionDecl() {
        val name = getFunctionName(ctx.query, decl)
        val retType = getFunctionReturnType(ctx.query, decl)
        
        val sym = Symbol(name, retType, false, true, decl)
        registerSymbol(ctx, sym)
        
        pushScope(ctx)
        ctx.currentReturnType = retType
        
        var stmt = queryExtra(ctx.query, decl)
        while stmt != -1 {
            val res = analyzeStatement(ctx, stmt)
            if res.ok == false { return res }
            stmt = getNextSibling(ctx.query, stmt)
        }
        
        ctx.currentReturnType = ""
        popScope(ctx)
    }
    
    if kind == kindModelDecl() {
        val name = getModelName(ctx.query, decl)
        val sym = Symbol(name, "type", false, false, decl)
        registerSymbol(ctx, sym)
    }
    
    return createSemaOk()
}

fn analyzeStatement(ctx: SemaContext, stmt: NodeIndex) -> SemanticResult {
    val kind = queryKind(ctx.query, stmt)
    
    if kind == kindVarDecl() {
        val nameIdx = queryLhs(ctx.query, stmt)
        val name = queryText(ctx.query, nameIdx)
        val isMut = queryExtra(ctx.query, stmt) == 1
        
        val sym = Symbol(name, "unknown", isMut, false, stmt)
        registerSymbol(ctx, sym)
        return createSemaOk()
    }
    
    if kind == kindReturn() {
        val expr = queryLhs(ctx.query, stmt)
        return createSemaOk()
    }
    
    return createSemaOk()
}
