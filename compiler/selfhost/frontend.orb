// Orbit Self-Hosted Frontend Entry Point (DORB Architecture)
import "dorb_parser.orb"
import "query.orb"
import "sema.orb"
import "mir.orb"
import "../ast.orb"

model CompilationResult {
    ok: bool
    ast: ASTPool
    mir: list // list of MIRFunction
}

fn compileDORB(source: string) -> CompilationResult {
    // Phase 1: Zero-Allocation Parse -> Struct of Arrays AST
    val pool = parseDorbProgram(source)
    
    // Phase 2: Lazy Query System & Semantic Analysis
    val queryCtx = initQueryContext(source, pool)
    val semaCtx = initSemaContext(queryCtx)
    
    val semaRes = analyzeProgram(semaCtx)
    
    if semaRes.ok == false {
        // En el futuro, reportSemaError(semaCtx, ...)
        return CompilationResult(false, pool, [])
    }
    
    // Phase 3: Lowering to MIR (SSA Form)
    var mirFunctions = []
    
    // Find program node
    var i = 0
    var programNode = -1
    while i < pool.kinds.len() {
        if queryKind(queryCtx, i) == kindProgram() {
            programNode = i
            break
        }
        i = i + 1
    }
    
    if programNode != -1 {
        var decl = queryLhs(queryCtx, programNode)
        while decl != -1 {
            if queryKind(queryCtx, decl) == kindFunctionDecl() {
                val mirFn = lowerFunction(queryCtx, decl)
                mirFunctions.push(mirFn)
            }
            decl = getNextSibling(queryCtx, decl)
        }
    }
    
    return CompilationResult(true, pool, mirFunctions)
}
