// compiler/selfhost/mir.orb
// Mid-level Intermediate Representation (SSA Form)

import "../ast.orb"
import "query.orb"
import "../memory.orb"

// MIR is represented in Static Single Assignment (SSA) format.
// This allows for O3 optimizations like DCE, GVN, and Register Allocation.

type MirInstIndex = int

// Opcodes for the MIR
fn opAdd() -> int { return 1 }
fn opSub() -> int { return 2 }
fn opCall() -> int { return 3 }
fn opLoad() -> int { return 4 }
fn opStore() -> int { return 5 }
fn opBranch() -> int { return 6 }
fn opCondBranch() -> int { return 7 }
fn opReturn() -> int { return 8 }
fn opAlloc() -> int { return 9 }

// FSM Opcodes for Colorless Async
fn opYield() -> int { return 10 }
fn opResume() -> int { return 11 }
fn opIoCall() -> int { return 12 }

// Like ASTPool, MIR is purely Data-Oriented (SoA)
model MIRPool {
    opcodes: ArrayPool       // list of int (opcode)
    types: ArrayPool         // list of int (type index)
    operands1: ArrayPool     // list of int (MIR index or literal index)
    operands2: ArrayPool     // list of int
    operands3: ArrayPool     // list of int
    sourceMap: ArrayPool     // list of NodeIndex (to map back to AST for errors)
}

fn initMIRPool() -> MIRPool {
    return MIRPool(initArrayPool(), initArrayPool(), initArrayPool(), initArrayPool(), initArrayPool(), initArrayPool())
}

fn pushMirInst(pool: MIRPool, op: int, typ: int, op1: int, op2: int, op3: int, src: NodeIndex) -> MirInstIndex {
    pushArrayPool(pool.opcodes, op)
    pushArrayPool(pool.types, typ)
    pushArrayPool(pool.operands1, op1)
    pushArrayPool(pool.operands2, op2)
    pushArrayPool(pool.operands3, op3)
    pushArrayPool(pool.sourceMap, src)
    return pool.opcodes.len - 1
}

// Basic Block representation
model BasicBlock {
    id: int
    firstInst: MirInstIndex
    lastInst: MirInstIndex
    predecessors: list // list of int (block id)
    successors: list   // list of int (block id)
}

model MIRFunction {
    name: string
    blocks: list // list of BasicBlock
    pool: MIRPool
}

fn initMIRFunction(name: string) -> MIRFunction {
    return MIRFunction(name, [], initMIRPool())
}

// Helper to detect I/O operations (mock)
fn isIoCall(name: string) -> bool {
    // Si la función empieza con 'fetch' o 'read', la consideramos bloqueante
    // En el futuro, esto se verificará en el SymbolTable (Sema).
    return name == "fetch" || name == "readFile"
}

// Lowers an AST Function into a MIR SSA Function (With FSM splitting)
fn lowerFunction(ctx: QueryContext, funcNode: NodeIndex) -> MIRFunction {
    val name = getFunctionName(ctx, funcNode)
    val mirFn = initMIRFunction(name)
    
    // Create entry block (State 0)
    var currentBlock = BasicBlock(0, -1, -1, [], [])
    var nextBlockId = 1
    
    // In dorb_parser: rhs = retType, extra = body block node
    val blockNode = queryExtra(ctx, funcNode)
    var stmt = queryLhs(ctx, blockNode)
    
    while stmt != -1 {
        val kind = queryKind(ctx, stmt)
        
        // --- Colorless Async Block Splitting (FSM) ---
        // Si detectamos una llamada a función que es I/O, partimos el bloque.
        if kind == kindCall() {
            val callNameNode = queryLhs(ctx, stmt)
            val callName = queryText(ctx, callNameNode)
            if isIoCall(callName) {
                // Generamos un IoCall
                val callOp = pushMirInst(mirFn.pool, opIoCall(), 0, stmt, -1, -1, stmt)
                
                // Generamos Yield (Suspender ejecución, retornar estado a epoll)
                pushMirInst(mirFn.pool, opYield(), 0, nextBlockId, -1, -1, stmt)
                
                // Cerramos el bloque actual
                mirFn.blocks.push(currentBlock)
                
                // Abrimos el siguiente bloque (Siguiente estado de la FSM)
                currentBlock = BasicBlock(nextBlockId, -1, -1, [currentBlock.id], [])
                nextBlockId = nextBlockId + 1
                
                // Generamos Resume (Retomar estado al despertar)
                pushMirInst(mirFn.pool, opResume(), 0, currentBlock.id, callOp, -1, stmt)
            }
        }
        // ---------------------------------------------
        
        if kind == kindReturn() {
            // Lower return expression
            val exprNode = queryLhs(ctx, stmt)
            val retOp = pushMirInst(mirFn.pool, opLoad(), 0, exprNode, -1, -1, exprNode)
            pushMirInst(mirFn.pool, opReturn(), 0, retOp, -1, -1, stmt)
        }
        
        if kind == kindVarDecl() {
            // Lower allocation
            val varId = pushMirInst(mirFn.pool, opAlloc(), 0, -1, -1, -1, stmt)
            val valExpr = queryRhs(ctx, stmt)
            if valExpr != -1 {
                val valId = pushMirInst(mirFn.pool, opLoad(), 0, valExpr, -1, -1, valExpr)
                pushMirInst(mirFn.pool, opStore(), 0, varId, valId, -1, stmt)
            }
        }
        
        stmt = getNextSibling(ctx, stmt)
    }
    
    mirFn.blocks.push(currentBlock)
    return mirFn
}
