// compiler/selfhost/mir.orb
// Mid-level Intermediate Representation (SSA Form)

import "../ast.orb"
import "query.orb"

// MIR is represented in Static Single Assignment (SSA) format.
// This allows for O3 optimizations like DCE, GVN, and Register Allocation.

type MirInstIndex = int

// Opcodes for the MIR
fn opAdd() -> int { return 1 }
fn opSub() -> int { return 2 }
fn opCall() -> int { return 3 }
fn opLoad() -> int { return 4 }
fn opStore() -> int { return 5 }
fn opBranch() -> int { return 6 }
fn opCondBranch() -> int { return 7 }
fn opReturn() -> int { return 8 }
fn opAlloc() -> int { return 9 }

// Like ASTPool, MIR is purely Data-Oriented (SoA)
model MIRPool {
    opcodes: list       // list of int (opcode)
    types: list         // list of int (type index)
    operands1: list     // list of int (MIR index or literal index)
    operands2: list     // list of int
    operands3: list     // list of int
    sourceMap: list     // list of NodeIndex (to map back to AST for errors)
}

fn initMIRPool() -> MIRPool {
    return MIRPool([], [], [], [], [], [])
}

fn pushMirInst(pool: MIRPool, op: int, typ: int, op1: int, op2: int, op3: int, src: NodeIndex) -> MirInstIndex {
    pool.opcodes.push(op)
    pool.types.push(typ)
    pool.operands1.push(op1)
    pool.operands2.push(op2)
    pool.operands3.push(op3)
    pool.sourceMap.push(src)
    return pool.opcodes.len() - 1
}

// Basic Block representation
model BasicBlock {
    id: int
    firstInst: MirInstIndex
    lastInst: MirInstIndex
    predecessors: list // list of int (block id)
    successors: list   // list of int (block id)
}

model MIRFunction {
    name: string
    blocks: list // list of BasicBlock
    pool: MIRPool
}

fn initMIRFunction(name: string) -> MIRFunction {
    return MIRFunction(name, [], initMIRPool())
}

// Lowers an AST Function into a MIR SSA Function
fn lowerFunction(ctx: QueryContext, funcNode: NodeIndex) -> MIRFunction {
    val name = getFunctionName(ctx, funcNode)
    val mirFn = initMIRFunction(name)
    
    // Create entry block
    val entryBlock = BasicBlock(0, -1, -1, [], [])
    mirFn.blocks.push(entryBlock)
    
    // Traverse the body linearly (naive for now)
    var currentStmt = queryLhs(ctx, queryRhs(ctx, funcNode)) // func -> rhs (body/type) ... wait
    // Actually, body is extra or rhs depending on how we pushed it.
    // In dorb_parser: rhs = retType, extra = firstStmt
    var stmt = queryExtra(ctx, funcNode)
    
    while stmt != -1 {
        val kind = queryKind(ctx, stmt)
        
        if kind == kindReturn() {
            // Lower return expression
            val exprNode = queryLhs(ctx, stmt)
            // Just a mock operand for now
            val retOp = pushMirInst(mirFn.pool, opLoad(), 0, exprNode, -1, -1, exprNode)
            pushMirInst(mirFn.pool, opReturn(), 0, retOp, -1, -1, stmt)
        }
        
        if kind == kindVarDecl() {
            // Lower allocation
            val varId = pushMirInst(mirFn.pool, opAlloc(), 0, -1, -1, -1, stmt)
            val valExpr = queryRhs(ctx, stmt)
            if valExpr != -1 {
                val valId = pushMirInst(mirFn.pool, opLoad(), 0, valExpr, -1, -1, valExpr)
                pushMirInst(mirFn.pool, opStore(), 0, varId, valId, -1, stmt)
            }
        }
        
        stmt = getNextSibling(ctx, stmt)
    }
    
    return mirFn
}
