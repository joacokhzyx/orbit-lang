
import "../lexer.orb"
import "../token.orb"
import "../ast.orb"

model ParserError {
    code: int
    message: string
}

model ParseResult {
    ok: bool
    value: ASTNode
    error: ParserError
}

model Diagnostics {
    errors: list
}

model ParseContext {
    lexer: Lexer
    current: Token
    peek: Token
    diagnostics: Diagnostics
}

fn initContext(source: string) -> ParseContext {
    val lexer = initLexer(source)
    val diag = Diagnostics([])
    val ctx = ParseContext(lexer, Token(TokType.EOF, "", 0, 0), Token(TokType.EOF, "", 0, 0), diag)
    advanceCtx(ctx)
    advanceCtx(ctx)
    return ctx
}

fn advanceCtx(ctx: ParseContext) {
    ctx.current = ctx.peek
    ctx.peek = nextToken(ctx.lexer)
}

fn createError(code: int, msg: string) -> ParseResult {
    return ParseResult(false, ASTNode.Empty, ParserError(code, msg))
}

fn createOk(val: ASTNode) -> ParseResult {
    return ParseResult(true, val, ParserError(0, ""))
}

// Simple Expression Parser returning ParseResult
fn parseExpression(ctx: ParseContext) -> ParseResult {
    return parsePrimary(ctx)
}

fn parsePrimary(ctx: ParseContext) -> ParseResult {
    if ctx.current.tag == TokType.IntegerLiteral {
        val valStr = ctx.current.text
        advanceCtx(ctx)
        return createOk(ASTNode.Literal(LiteralNode("int", valStr)))
    }
    if ctx.current.tag == TokType.StringLiteral {
        val valStr = ctx.current.text
        advanceCtx(ctx)
        return createOk(ASTNode.Literal(LiteralNode("string", valStr)))
    }
    if ctx.current.tag == TokType.Identifier {
        val name = ctx.current.text
        advanceCtx(ctx)
        if ctx.current.tag == TokType.OpenParen {
            advanceCtx(ctx)
            var args = []
            if ctx.current.tag != TokType.CloseParen {
                val argRes = parseExpression(ctx)
                if argRes.ok {
                    args.push(argRes.value)
                } else {
                    return argRes
                }
            }
            if ctx.current.tag == TokType.CloseParen {
                advanceCtx(ctx)
            } else {
                ctx.diagnostics.errors.push(ParserError(1, "Expected closing parenthesis"))
                return createError(1, "Expected closing parenthesis")
            }
            return createOk(ASTNode.Call(CallNode([ASTNode.Literal(LiteralNode("identifier", name))], args)))
        }
        return createOk(ASTNode.Literal(LiteralNode("identifier", name)))
    }

    val text = ctx.current.text
    advanceCtx(ctx)
    ctx.diagnostics.errors.push(ParserError(2, "Unexpected token: " + text))
    return createError(2, "Unexpected token: " + text)
}

fn parseStatement(ctx: ParseContext) -> ParseResult {
    if ctx.current.tag == TokType.KeywordReturn {
        advanceCtx(ctx)
        val retExpr = parseExpression(ctx)
        if retExpr.ok == false { return retExpr }
        return createOk(ASTNode.Return(ReturnNode([retExpr.value])))
    }
    if ctx.current.tag == TokType.KeywordVal {
        advanceCtx(ctx)
        val name = ctx.current.text
        if ctx.current.tag == TokType.Identifier { advanceCtx(ctx) }
        if ctx.current.tag == TokType.Equal { advanceCtx(ctx) }
        val valExpr = parseExpression(ctx)
        if valExpr.ok == false { return valExpr }
        return createOk(ASTNode.VarDecl(VarDeclNode(name, false, [valExpr.value])))
    }
    if ctx.current.tag == TokType.KeywordVar {
        advanceCtx(ctx)
        val name = ctx.current.text
        if ctx.current.tag == TokType.Identifier { advanceCtx(ctx) }
        if ctx.current.tag == TokType.Equal { advanceCtx(ctx) }
        val valExpr = parseExpression(ctx)
        if valExpr.ok == false { return valExpr }
        return createOk(ASTNode.VarDecl(VarDeclNode(name, true, [valExpr.value])))
    }

    val stmtExpr = parseExpression(ctx)
    if stmtExpr.ok == false { return stmtExpr }
    return createOk(ASTNode.ExpressionStmt(ExpressionStmtNode([stmtExpr.value])))
}

fn parseFunction(ctx: ParseContext) -> ParseResult {
    if ctx.current.tag == TokType.KeywordFn { advanceCtx(ctx) }
    val name = ctx.current.text
    if ctx.current.tag == TokType.Identifier { advanceCtx(ctx) }
    if ctx.current.tag == TokType.OpenParen { advanceCtx(ctx) }
    // We skip params for now
    var params = []
    while ctx.current.tag != TokType.CloseParen {
        advanceCtx(ctx)
    }
    if ctx.current.tag == TokType.CloseParen { advanceCtx(ctx) }

    var retType = "unknown"
    if ctx.current.tag == TokType.Arrow {
        advanceCtx(ctx) // Type
        retType = ctx.current.text
        if ctx.current.tag == TokType.Identifier { advanceCtx(ctx) }
    }

    if ctx.current.tag == TokType.OpenBrace { advanceCtx(ctx) }
    var body = []
    while ctx.current.tag != TokType.CloseBrace {
        if ctx.current.tag == TokType.EOF {
            break
        }
        val stmt = parseStatement(ctx)
        if stmt.ok == false { return stmt }
        body.push(stmt.value)
    }
    if ctx.current.tag == TokType.CloseBrace { advanceCtx(ctx) }

    return createOk(ASTNode.FunctionDecl(FunctionDeclNode(name, params, [], retType, body, false, false, false, [])))
}

fn parseModelDecl(ctx: ParseContext) -> ParseResult {
    if ctx.current.tag == TokType.KeywordModel { advanceCtx(ctx) }
    val name = ctx.current.text
    if ctx.current.tag == TokType.Identifier { advanceCtx(ctx) }
    
    if ctx.current.tag == TokType.OpenBrace { advanceCtx(ctx) }
    var fields = []
    while ctx.current.tag != TokType.CloseBrace {
        if ctx.current.tag == TokType.EOF { break }
        val fieldName = ctx.current.text
        if ctx.current.tag == TokType.Identifier { advanceCtx(ctx) }
        
        if ctx.current.tag == TokType.Colon { advanceCtx(ctx) }
        val fieldType = ctx.current.text // type name
        if ctx.current.tag == TokType.Identifier { advanceCtx(ctx) }
        
        fields.push(ASTNode.FieldDecl(FieldDeclNode(fieldName, fieldType, [])))
    }
    if ctx.current.tag == TokType.CloseBrace { advanceCtx(ctx) }
    
    return createOk(ASTNode.ModelDecl(ModelDeclNode(name, fields, [])))
}

fn parseTypeDecl(ctx: ParseContext) -> ParseResult {
    if ctx.current.tag == TokType.KeywordType { advanceCtx(ctx) }
    val name = ctx.current.text
    if ctx.current.tag == TokType.Identifier { advanceCtx(ctx) }
    if ctx.current.tag == TokType.Equal { advanceCtx(ctx) }
    
    var variants = []
    val baseType = ctx.current.text
    if ctx.current.tag == TokType.Identifier { advanceCtx(ctx) }
    
    // Simplification for union/alias parsing
    while ctx.current.tag == TokType.Pipe {
        advanceCtx(ctx)
        val variantName = ctx.current.text
        if ctx.current.tag == TokType.Identifier { advanceCtx(ctx) }
        variants.push(ASTNode.Literal(LiteralNode("variant", variantName)))
        if ctx.current.tag == TokType.OpenParen {
            advanceCtx(ctx)
            if ctx.current.tag == TokType.Identifier { advanceCtx(ctx) }
            if ctx.current.tag == TokType.CloseParen { advanceCtx(ctx) }
        }
    }
    
    return createOk(ASTNode.TypeDecl(TypeDeclNode(name, "alias", variants, baseType)))
}

fn parseProgram(ctx: ParseContext) -> ParseResult {
    var decls = []
    while ctx.current.tag != TokType.EOF {
        if ctx.current.tag == TokType.KeywordFn {
            val fnRes = parseFunction(ctx)
            if fnRes.ok == false { return fnRes }
            decls.push(fnRes.value)
        } else if ctx.current.tag == TokType.KeywordModel {
            val modelRes = parseModelDecl(ctx)
            if modelRes.ok == false { return modelRes }
            decls.push(modelRes.value)
        } else if ctx.current.tag == TokType.KeywordType {
            val typeRes = parseTypeDecl(ctx)
            if typeRes.ok == false { return typeRes }
            decls.push(typeRes.value)
        } else {
            advanceCtx(ctx)
        }
    }
    return createOk(ASTNode.Program(ProgramNode(decls)))
}

fn generateAST(source: string) -> string {
    val ctx = initContext(source)
    val res = parseProgram(ctx)
    if res.ok {
        return "AST generated successfully"
    }
    return "Error: " + res.error.message
}

