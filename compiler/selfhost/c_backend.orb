// compiler/selfhost/c_backend.orb
// Generador de C para la arquitectura DORB (FSM + Oracle)

import "mir.orb"

fn generateCCode(mirFunctions: list) -> string {
    var c_code = "#include <stdint.h>\n#include \"runtime/oracle.h\"\n#include \"runtime/arena.h\"\n\n"
    
    var i = 0
    while i < mirFunctions.len() {
        val mirFn = mirFunctions.get(i)
        
        c_code = c_code + "void " + mirFn.name + "(OrbitArena* _arena) {\n"
        
        // Inyectar Oracle Memory Model
        // (Usamos un hash dummy para el route_id en este prototipo)
        c_code = c_code + "    oracle_begin_session(_arena, 123456789ULL);\n"
        
        // FSM State Variable (Guardada en el TLS del Oracle en la versión final)
        c_code = c_code + "    int _fsm_state = 0; // tls_oracle_session.resume_state\n"
        c_code = c_code + "    switch(_fsm_state) {\n"
        
        var b = 0
        while b < mirFn.blocks.len() {
            val block = mirFn.blocks.get(b)
            c_code = c_code + "        case " + b + ": {\n"
            
            // Aquí iteraríamos sobre las instrucciones del bloque...
            // Por brevedad en este prototipo, solo emitimos comentarios.
            c_code = c_code + "            // Ejecutando BasicBlock " + b + "\n"
            
            // Si el bloque termina en Yield (esperar I/O):
            // if last_inst == opYield ...
            // c_code = c_code + "            _fsm_state = " + nextBlock + "; return; // Suspender FSM\n"
            
            c_code = c_code + "            break;\n"
            c_code = c_code + "        }\n"
            b = b + 1
        }
        
        c_code = c_code + "    }\n"
        
        // Finalizar Oracle Session
        c_code = c_code + "    oracle_end_session(_arena);\n"
        c_code = c_code + "}\n\n"
        
        i = i + 1
    }
    
    return c_code
}
