// Orbit self-hosting compiler entry point.
//
// Subcommands supported:
//   - `build <input.orb> [-o output.exe]`: Standard build driver.
//   - `run <input.orb>`: Build, then run it with inherited stdio.
//   - `check <input.orb>`: Parse and typecheck only, no code emitted.
//   - `doctor [dir] [--fix]`: Read-only project checks, whitespace fixes with --fix.
//   - `fmt [file.orb]`: Token-based source formatter, whitespace only.
//   - `frontend <input.orb> [-o output.tir]`: Executes self-hosted frontend pipeline and emits canonical TIR.
//   - `cluster ...`: Single-host multiprocess orchestration.
//   - `start [file.orb]` / `dev [file.orb]`: Build into .orbit/ and run; dev adds watch/restart.
//   - `lextrace <input.orb>`: Debug lexer trace (first 2000 tokens).
//   - `--help, -h` / `--version, -v`

import "./extern.orb"
import "../tools/fmt.orb"
import "../tir/entry.orb"
import "../tools/palette.orb"
import "./pipeline.orb"
import "../tools/doctor.orb"
import "./cluster.orb"
import "./start.orb"

fn frontendOutputPath() -> string {
    var i = 2
    while true {
        val a = orbit_os_argv_selfhost(i)
        if a == "" { break }
        if a == "-o" {
            val next = orbit_os_argv_selfhost(i + 1)
            if next != "" { return next }
        }
        i = i + 1
    }
    return "orbit.tir"
}

fn runLexTrace() {
    val inputPath = orbit_os_argv_selfhost(2)
    val source = orbit_file_read_selfhost(inputPath)
    val lexer = initLexer(source)
    var i = 0
    while i < 2000 {
        val tok = nextToken(lexer)
        print(orbit_int_to_string_selfhost(i))
        print(orbit_int_to_string_selfhost(tok.line))
        print(orbit_int_to_string_selfhost(tok.col))
        print(tokTagName(tok.tag))
        if tok.tag == TokType.EOF {
            break
        }
        i = i + 1
    }
}

fn runFrontend() {
    val inputPath = orbit_os_argv_selfhost(2)
    if inputPath == "" {
        orbit_os_write_stderr_selfhost("Usage: orbit frontend <input.orb> [-o output.tir]\n")
        orbit_os_exit_selfhost(2)
        return
    }

    val source = orbit_file_read_selfhost(inputPath)
    if source == "" {
        orbit_os_write_stderr_selfhost("orbit frontend: could not read input file '" + inputPath + "'.\n")
        orbit_os_exit_selfhost(1)
        return
    }

    val output = compileFrontendSource(inputPath, source)
    if output == "" {
        orbit_os_write_stderr_selfhost("orbit frontend: no TIR emitted because diagnostics contain errors.\n")
        orbit_os_exit_selfhost(1)
        return
    }

    val outputPath = frontendOutputPath()
    if orbit_file_write_selfhost(outputPath, output) == false {
        orbit_os_write_stderr_selfhost("orbit frontend: unable to write TIR output '" + outputPath + "'.\n")
        orbit_os_exit_selfhost(1)
        return
    }
}

fn helpText(useColor: bool) -> string {
    var h = "Usage: orbit <command> [options]\n"
    h = h + "\n"
    h = h + "Commands:\n"
    h = h + "  " + palettePaint(paletteBold(), "build", useColor) + " <file.orb> [-o out] [--release] [--backend=c|native] [--emit-ir path] [--quiet] [--verbose] [--color always|never|auto]\n"
    h = h + "                             Compile to a native executable (-O1; --release selects -O2)\n"
    h = h + "                             --backend=c|native picks the code generator (also ORBIT_BACKEND);\n"
    h = h + "                             native runs R6 (ORBIT_R6) and never falls back to C\n"
    h = h + "  " + palettePaint(paletteBold(), "run", useColor) + " <file.orb> [--backend=c|native] [--quiet] [--verbose] [--color always|never|auto]\n"
    h = h + "                             Build and run it (shares your terminal)\n"
    h = h + "  " + palettePaint(paletteBold(), "start", useColor) + " [file.orb] [--port N] [--quiet] [--verbose] [--color always|never|auto]\n"
    h = h + "                             Build into .orbit/ and run (service when it declares routes)\n"
    h = h + "  " + palettePaint(paletteBold(), "dev", useColor) + " [file.orb] [--port N] [--quiet] [--verbose] [--color always|never|auto]\n"
    h = h + "                             Watch sources, rebuild and restart on change\n"
    h = h + "  " + palettePaint(paletteBold(), "stop", useColor) + "\n"
    h = h + "                             Stop the service running from this directory\n"
    h = h + "  " + palettePaint(paletteBold(), "check", useColor) + " <file.orb> [--quiet] [--verbose] [--color always|never|auto]\n"
    h = h + "                             Parse and typecheck, no code emitted\n"
    h = h + "  " + palettePaint(paletteBold(), "fmt", useColor) + " <file.orb>             Format a file (writes only on success)\n"
    h = h + "  " + palettePaint(paletteBold(), "fmt", useColor) + " --check <file|dir>     List files that need formatting\n"
    h = h + "  " + palettePaint(paletteBold(), "doctor", useColor) + " [dir] [--fix]      Read-only project checks (whitespace fixes with --fix)\n"
    h = h + "  " + palettePaint(paletteBold(), "frontend", useColor) + " <input.orb> [-o output.tir]\n"
    h = h + "  " + palettePaint(paletteBold(), "cluster", useColor) + " up --nodes N --port-base P [--log-dir D] [--service S]\n"
    h = h + "  " + palettePaint(paletteBold(), "cluster", useColor) + " status|drain <node>|restart --rolling|down|logs <node>\n"
    h = h + "                           Single-host multiprocess orchestration (see docs/CLUSTER.md)\n"
    h = h + "  " + palettePaint(paletteBold(), "--help, -h", useColor) + "                 Show this help\n"
    h = h + "  " + palettePaint(paletteBold(), "--version, -v", useColor) + "              Show version\n"
    h = h + "\n"
    h = h + "Developer inspection: " + palettePaint(paletteBold(), "lextrace", useColor) + " <file.orb>\n"
    return h
}

fn bareHelpText(useColor: bool) -> string {
    var h = palettePaint(paletteBold(), "Orbit " + orbitVersion(), useColor) + "  " + palettePaint(paletteDim(), "self-hosted compiler, C to native", useColor) + "\n"
    h = h + "\n"
    h = h + "Usage: orbit <command> [options]  (orbit --help for full help)\n"
    h = h + "\n"
    h = h + "  " + palettePaint(paletteBold(), "check", useColor) + " hello.orb          " + palettePaint(paletteDim(), "typecheck only", useColor) + "\n"
    h = h + "  " + palettePaint(paletteBold(), "build", useColor) + " hello.orb -o hello " + palettePaint(paletteDim(), "compile to native", useColor) + "\n"
    h = h + "  " + palettePaint(paletteBold(), "run", useColor) + " hello.orb            " + palettePaint(paletteDim(), "build and run", useColor) + "\n"
    h = h + "  " + palettePaint(paletteBold(), "start", useColor) + " [main.orb]        " + palettePaint(paletteDim(), "build into .orbit/ and run", useColor) + "\n"
    h = h + "  " + palettePaint(paletteBold(), "stop", useColor) + "                " + palettePaint(paletteDim(), "stop the service running from this directory", useColor) + "\n"
    h = h + "  " + palettePaint(paletteBold(), "doctor", useColor) + "                   " + palettePaint(paletteDim(), "project checks", useColor) + "\n"
    h = h + "\n"
    h = h + palettePaint(paletteDim(), "No input given. Next step: `orbit check hello.orb` then `orbit build hello.orb -o hello`", useColor) + "\n"
    return h
}

fn printHelp() {
    print(helpText(paletteUseColorStdout("auto")))
}

fn printHelpErr() {
    orbit_os_write_stderr_selfhost(helpText(paletteUseColorStderr("auto")))
}

fn isKnownCommand(cmd: string) -> bool {
    if cmd == "build" || cmd == "run" || cmd == "check" { return true }
    if cmd == "fmt" || cmd == "doctor" || cmd == "frontend" { return true }
    if cmd == "lextrace" || cmd == "cluster" { return true }
    if cmd == "start" || cmd == "dev" || cmd == "stop" { return true }
    if cmd == "--help" || cmd == "-h" || cmd == "--version" || cmd == "-v" { return true }
    return false
}

fn endsWithOrb(path: string) -> bool {
    val n = orbit_string_len(path)
    if n < 4 { return false }
    return orbit_string_slice(path, n - 4, n) == ".orb"
}

fn wantsHelp() -> bool {
    var i = 2
    while i <= 5 {
        val a = orbit_os_argv_selfhost(i)
        if a == "--help" || a == "-h" { return true }
        if a == "" { return false }
        i = i + 1
    }
    return false
}

// The value of a `--backend=<name>` argument, or "" when the argument is
// anything else (an empty value is also "", and fails as an unknown input).
fn backendFlagValue(arg: string) -> string {
    if arg.len() <= 10 { return "" }
    if arg.slice(0, 10) != "--backend=" { return "" }
    return arg.slice(10, arg.len())
}

fn runRun() {
    if wantsHelp() {
        print("Usage: orbit run <file.orb> [--backend=c|native] [--quiet] [--verbose] [--color always|never|auto]\n  Build and run it (shares your terminal)\n")
        return
    }
    // --quiet silences the compiler's own progress lines, but changes
    // nothing else: the child program owns the terminal and its output
    // always passes through.
    var runQuiet = false
    var runVerbose = false
    var runColor = "auto"
    var runBackend = ""
    var inputPath = ""
    var ri = 2
    while true {
        val ra = orbit_os_argv_selfhost(ri)
        if ra == "" { break }
        if ra == "--quiet" { runQuiet = true }
        else if ra == "--verbose" { runVerbose = true }
        else if backendFlagValue(ra) != "" {
            runBackend = backendFlagValue(ra)
            if backendKnown(runBackend) == false {
                orbit_os_write_stderr_selfhost("Unknown backend '" + runBackend + "'. Use --backend=c or --backend=native.\n")
                orbit_os_exit_selfhost(2)
                return
            }
        } else if ra == "--color" {
            val rc = orbit_os_argv_selfhost(ri + 1)
            if rc == "always" || rc == "never" || rc == "auto" {
                runColor = rc
                ri = ri + 1
            } else {
                orbit_os_write_stderr_selfhost("Usage: orbit run <file.orb> [--backend=c|native] [--quiet] [--verbose] [--color always|never|auto]\n")
                orbit_os_exit_selfhost(2)
                return
            }
        } else if inputPath == "" { inputPath = ra }
        else {
            orbit_os_write_stderr_selfhost("Usage: orbit run <file.orb> [--backend=c|native] [--quiet] [--verbose] [--color always|never|auto]\n")
            orbit_os_exit_selfhost(2)
            return
        }
        ri = ri + 1
    }
    if inputPath == "" {
        orbit_os_write_stderr_selfhost("Usage: orbit run <file.orb> [--backend=c|native] [--quiet] [--verbose] [--color always|never|auto]\n")
        orbit_os_exit_selfhost(2)
        return
    }
    val source = orbit_file_read_selfhost(inputPath)
    if source == "" {
        orbit_os_write_stderr_selfhost("orbit run: could not read input file '" + inputPath + "'.\n")
        orbit_os_exit_selfhost(1)
        return
    }
    var outputPath = inputPath + ".run"
    val osName = orbit_os_env_selfhost("OS")
    val winDir = orbit_os_env_selfhost("WINDIR")
    if osName == "Windows_NT" || winDir != "" {
        outputPath = outputPath + ".exe"
    }
    if compileSourceWithFile(source, inputPath, outputPath, runVerbose, runQuiet, runColor, false, "", runBackend) == false {
        orbit_os_exit_selfhost(1)
        return
    }
    val code = orbit_os_spawn_selfhost("\"" + outputPath + "\"")
    orbit_os_exit_selfhost(code)
}

fn runCheck() {
    if wantsHelp() {
        print("Usage: orbit check <file.orb> [--quiet] [--verbose] [--color always|never|auto]\n  Parse and typecheck, no code emitted\n")
        return
    }
    var checkQuiet = false
    var checkVerbose = false
    var checkColor = "auto"
    var inputPath = ""
    var ci = 2
    while true {
        val ca = orbit_os_argv_selfhost(ci)
        if ca == "" { break }
        if ca == "--quiet" { checkQuiet = true }
        else if ca == "--verbose" { checkVerbose = true }
        else if ca == "--color" {
            val cc = orbit_os_argv_selfhost(ci + 1)
            if cc == "always" || cc == "never" || cc == "auto" {
                checkColor = cc
                ci = ci + 1
            } else {
                orbit_os_write_stderr_selfhost("Usage: orbit check <file.orb> [--quiet] [--verbose] [--color always|never|auto]\n")
                orbit_os_exit_selfhost(2)
                return
            }
        } else if inputPath == "" { inputPath = ca }
        else {
            orbit_os_write_stderr_selfhost("Usage: orbit check <file.orb> [--quiet] [--verbose] [--color always|never|auto]\n")
            orbit_os_exit_selfhost(2)
            return
        }
        ci = ci + 1
    }
    if inputPath == "" {
        orbit_os_write_stderr_selfhost("Usage: orbit check <file.orb> [--quiet] [--verbose] [--color always|never|auto]\n")
        orbit_os_exit_selfhost(2)
        return
    }
    val source = orbit_file_read_selfhost(inputPath)
    if source == "" {
        orbit_os_write_stderr_selfhost("orbit check: could not read input file '" + inputPath + "'.\n")
        orbit_os_exit_selfhost(1)
        return
    }
    if checkVerbose {
        print("check " + inputPath + " (" + orbit_int_to_string_selfhost(orbit_string_len(source)) + " bytes)")
    }
    val checkStart = orbit_clock_ms()
    if checkSourceWithFile(source, inputPath, checkColor) == false {
        orbit_os_exit_selfhost(1)
        return
    }
    if checkQuiet == false {
        val useOut = paletteUseColorStdout(checkColor)
        val ms = orbit_clock_ms() - checkStart
        val check = palettePaint(paletteOk(), "✓", useOut)
        val timing = palettePaint(paletteDim(), "(" + orbit_int_to_string_selfhost(ms) + " ms)", useOut)
        print(check + " Checked " + inputPath + ": no errors. " + timing)
    }
}

fn main() {
    val cmd = orbit_os_argv_selfhost(1)
    if cmd == "" {
        print(bareHelpText(paletteUseColorStdout("auto")))
        return
    }
    if cmd == "--help" || cmd == "-h" {
        printHelp()
        return
    }
    if cmd == "--version" || cmd == "-v" {
        print("orbit " + orbitVersion())
        return
    }
    if cmd != "" && isKnownCommand(cmd) == false {
        if cmd.at(0) == 45 {
            orbit_os_write_stderr_selfhost("Unknown option: " + cmd + "\n")
            printHelpErr()
            orbit_os_exit_selfhost(2)
            return
        }
        if endsWithOrb(cmd) == false && orbit_file_read_selfhost(cmd) == "" {
            orbit_os_write_stderr_selfhost("Unknown command: " + cmd + "\n")
            printHelpErr()
            orbit_os_exit_selfhost(2)
            return
        }
    }
    if cmd == "build" && wantsHelp() {
        print("Usage: orbit build <file.orb> [-o out] [--release] [--backend=c|native] [--emit-ir path] [--quiet] [--verbose] [--color always|never|auto]\n  Compile to a native executable (default -O1; --release adds -O2)\n  --backend=c|native picks the code generator (also ORBIT_BACKEND); native runs R6 (ORBIT_R6)\n")
        return
    }
    if cmd == "run" {
        runRun()
        return
    }
    if cmd == "check" {
        runCheck()
        return
    }
    // fmt dispatch (agent)
    if cmd == "fmt" {
        runFmt()
        return
    }
    // doctor dispatch (agent)
    if cmd == "doctor" {
        runDoctor()
        return
    }
    // cluster dispatch (agent)
    if cmd == "cluster" {
        runCluster()
        return
    }
    if cmd == "start" {
        runStart()
        return
    }
    if cmd == "dev" {
        runDev()
        return
    }
    if cmd == "stop" {
        runStop()
        return
    }
    var outputPath = ""
    var inputPath = ""
    // --quiet silences the progress and result lines (a successful build
    // is quiet); --verbose echoes the C compiler invocation and the output.
    var buildQuiet = false
    var buildVerbose = false
    var buildColor = "auto"
    // --release is additive and build-only: the default is -O1, this selects
    // the -O2 shape for callers who measured their own workload (M1: -O2 adds
    // nothing measurable on the compute routes, so -O1 is the default).
    var buildRelease = false
    var emitIrPath = ""
    var buildBackend = ""
    var i = 1
    while true {
        val arg = orbit_os_argv_selfhost(i)
        if arg == "" { break }

        if arg == "frontend" {
            runFrontend()
            return
        }

        if arg == "lextrace" {
            runLexTrace()
            return
        }

        if arg == "-o" {
            val nextArg = orbit_os_argv_selfhost(i + 1)
            if nextArg != "" {
                outputPath = nextArg
                i = i + 1
            }
        } else if arg == "--quiet" {
            buildQuiet = true
        } else if arg == "--release" {
            buildRelease = true
        } else if backendFlagValue(arg) != "" {
            buildBackend = backendFlagValue(arg)
            if backendKnown(buildBackend) == false {
                orbit_os_write_stderr_selfhost("Unknown backend '" + buildBackend + "'. Use --backend=c or --backend=native.\n")
                orbit_os_exit_selfhost(2)
                return
            }
        } else if arg == "--verbose" {
            buildVerbose = true
        } else if arg == "--emit-ir" {
            val irOut = orbit_os_argv_selfhost(i + 1)
            if irOut == "" {
                orbit_os_write_stderr_selfhost("Usage: orbit build <file.orb> [-o out] [--release] [--backend=c|native] [--emit-ir path] [--quiet] [--verbose] [--color always|never|auto]\n")
                orbit_os_exit_selfhost(2)
                return
            }
            emitIrPath = irOut
            i = i + 1
        } else if arg == "--color" {
            val bc = orbit_os_argv_selfhost(i + 1)
            if bc == "always" || bc == "never" || bc == "auto" {
                buildColor = bc
                i = i + 1
            } else {
                orbit_os_write_stderr_selfhost("Usage: orbit build <file.orb> [-o out] [--release] [--backend=c|native] [--emit-ir path] [--quiet] [--verbose] [--color always|never|auto]\n")
                orbit_os_exit_selfhost(2)
                return
            }
        } else {
            if arg != "build" && inputPath == "" {
                inputPath = arg
            } else if arg != "build" {
                orbit_os_write_stderr_selfhost("Usage: orbit build <file.orb> [-o out] [--release] [--backend=c|native] [--emit-ir path] [--quiet] [--verbose] [--color always|never|auto]\n")
                orbit_os_exit_selfhost(2)
                return
            }
        }
        i = i + 1
    }

    if inputPath == "" {
        orbit_os_write_stderr_selfhost("Usage: orbit build <file.orb> [-o out] [--release] [--backend=c|native] [--emit-ir path] [--quiet] [--verbose] [--color always|never|auto]\n")
        orbit_os_exit_selfhost(2)
        return
    }

    if outputPath == "" {
        outputPath = inputPath + ".c"
    }

    val source = orbit_file_read_selfhost(inputPath)
    if source == "" {
        orbit_os_write_stderr_selfhost("orbit build: could not read input file '" + inputPath + "'.\n")
        orbit_os_exit_selfhost(1)
        return
    }

    if compileSourceWithFile(source, inputPath, outputPath, buildVerbose, buildQuiet, buildColor, buildRelease, emitIrPath, buildBackend) == false {
        orbit_os_exit_selfhost(1)
    }
}
