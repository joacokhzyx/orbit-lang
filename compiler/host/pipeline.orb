// Compile pipeline driver: check/build/run entry points, diagnostics
// rendering (error cards, sema errors), and C toolchain probing.
// Large by intent (~750 lines); the size is the driver surface,
// not hidden coupling.
import "../front/lexer.orb"
import "../front/parser.orb"
import "../front/resolver.orb"
import "../front/sema.orb"
import "../ir/builder.orb"
import "../ir/ir.orb"
import "../emit/ir_emit.orb"
import "../ir/optimizer.orb"
import "../ir/cteval.orb"
import "../ir/prune.orb"
import "../emit/c_backend.orb"
import "../tools/palette.orb"

fn cteEnabled() -> bool {
    return orbit_os_env_selfhost("ORBIT_NO_CTE") == ""
}

fn getSourceLine(source: string, lineNum: int) -> string {
    if source == "" { return "" }
    var curLine = 1
    var start = 0
    var i = 0
    while i < orbit_string_len(source) {
        if orbit_string_char_at_selfhost(source, i) == 10 {
            if curLine == lineNum {
                var slice = orbit_string_slice(source, start, i)
                val sl = orbit_string_len(slice)
                if sl > 0 && orbit_string_char_at_selfhost(slice, sl - 1) == 13 {
                    slice = orbit_string_slice(slice, 0, sl - 1)
                }
                return slice
            }
            curLine = curLine + 1
            start = i + 1
        }
        i = i + 1
    }
    if curLine == lineNum {
        var slice = orbit_string_slice(source, start, orbit_string_len(source))
        val sl = orbit_string_len(slice)
        if sl > 0 && orbit_string_char_at_selfhost(slice, sl - 1) == 13 {
            slice = orbit_string_slice(slice, 0, sl - 1)
        }
        return slice
    }
    return ""
}

fn sourceBaseName(path: string) -> string {
    val slash = lastIndexOfSlash(path)
    if slash == -1 { return path }
    return path.slice(slash + 1, path.len())
}

fn renderErrorCard(code: string, message: string, file: string, line: int, col: int, sourceLine: string, hint: string, colorMode: string) -> string {
    val useColor = paletteUseColorStderr(colorMode)
    val loc = file + ":" + orbit_int_to_string_selfhost(line) + ":" + orbit_int_to_string_selfhost(col)
    var out = "\n"
    out = out + palettePaint(paletteError(), "error[" + code + "]:", useColor) + " " + message + "\n"
    out = out + "  --> " + palettePaint(paletteBold(), loc, useColor) + "\n"
    out = out + "   |\n"
    if sourceLine != "" {
        var lineStr = orbit_int_to_string_selfhost(line)
        if line < 10 {
            lineStr = " " + lineStr
        }
        out = out + lineStr + " | " + sourceLine + "\n"
        out = out + "   | "
        var sp = 0
        while sp < col - 1 {
            out = out + " "
            sp = sp + 1
        }
        out = out + palettePaint(paletteError(), "^-- here", useColor) + "\n"
        out = out + "   |\n"
    }
    out = out + "   = help: " + hint + "\n"
    return out
}

fn reportErrorCard(code: string, message: string, file: string, line: int, col: int, sourceLine: string, hint: string, kind: string, colorMode: string) {
    val card = renderErrorCard(code, message, file, line, col, sourceLine, hint, colorMode)
    orbit_os_write_stderr_selfhost(card)
    orbit_os_write_stderr_selfhost("\n" + palettePaint(paletteError(), "ERROR:", paletteUseColorStderr(colorMode)) + " " + kind + "\n")
}

// The hint under a parser diagnostic.
//
// E0301 is a token the parser had no use for, and the generic advice -- look for
// a missing bracket, quote or keyword -- is the right advice for it. The `if`
// codes are different in kind: the token is one the parser understands, and
// what it is doing there is wrong, so each of them says what to write instead.
fn parserDiagnosticHint(diag: ParserDiagnostic) -> string {
    if diag.code == "E0302" {
        return "Give the `if` an `else` branch, or use it as a statement, where no value is wanted."
    }
    if diag.code == "E0303" {
        return "A branch that begins with an operator needs `then` before it, as in `if n then -1 else 0`."
    }
    if diag.code == "E0304" {
        return "Write a branch that holds statements as `{ ... }`."
    }
    return "Check for missing brackets, quotes, or keywords before this token."
}

// Two shapes of semantic diagnostic, chosen by what the checker knew. A check
// that ran over a positioned node prints the card, pointing at the line; the
// rest have no position to point at and print the one-line form, which is
// what they printed before cards existed and is the only honest option.
fn printSemaErrors(sema: Sema, source: string, inputPath: string, colorMode: string) {
    val useColor = paletteUseColorStderr(colorMode)
    var ei = 0
    while ei < sema.errors.len() {
        val diag: SemaError = sema.errors.get(ei)
        if diag.code != "" && diag.line > 0 {
            reportErrorCard(diag.code, diag.message, inputPath, diag.line, diag.col, getSourceLine(source, diag.line), diag.hint, "error.SemanticAnalysisFailed", colorMode)
        } else {
            orbit_os_write_stderr_selfhost(palettePaint(paletteError(), "Semantic error:", useColor) + " " + diag.message + "\n")
        }
        ei = ei + 1
    }
}

// How much of this program the front end could not resolve, as lines a gate can
// sum. On stderr, and only when the count is not zero, so a clean program says
// nothing and the shape of a successful build is unchanged.
//
//     UNRESOLVED total <n>
//     UNRESOLVED name <n>
//     UNRESOLVED function <n>
//     UNRESOLVED int-literal <n>
//
// `total` is the number to ratchet: it is the size of the name-resolution gap,
// counted the same way on every run, and it is the thing that must never go up.
// The per-kind lines say which front-end rule to write next, and the same
// "LABEL value" shape is what scripts/unknown_census.py already parses, so a
// ratchet over this is a grep. Absence of the line means zero.
//
// This reports a count; it never fails. The number exists so "do not regress
// this" is a property of the build rather than a rule people follow, which is
// D7. The bar is not zero and moving it to zero is not this slot's job: 30.5%
// of inferred types in the corpus are `unknown`, and a gate that fails on a
// high count is a gate everybody turns off.
fn reportResolutionGaps(sema: Sema) {
    if sema.misses.len() == 0 { return }
    val names = missCount(sema, "name")
    val functions = missCount(sema, "function")
    val literals = missCount(sema, "int-literal")
    var out = "UNRESOLVED total " + orbit_int_to_string_selfhost(names + functions + literals) + "\n"
    if names > 0 {
        out = out + "UNRESOLVED name " + orbit_int_to_string_selfhost(names) + "\n"
    }
    if functions > 0 {
        out = out + "UNRESOLVED function " + orbit_int_to_string_selfhost(functions) + "\n"
    }
    if literals > 0 {
        out = out + "UNRESOLVED int-literal " + orbit_int_to_string_selfhost(literals) + "\n"
    }
    orbit_os_write_stderr_selfhost(out)
}

// Phase memory report for ORBIT_MEM_REPORT=1. Zero cost when unset (one
// getenv) and stderr-only, so build stdout and emitted artifacts are
// untouched.
fn reportMemStage(stage: string) {
    if orbit_os_env_selfhost("ORBIT_MEM_REPORT") != "" {
        orbit_os_write_stderr_selfhost("[mem] " + stage + " " + orbit_mem_report_selfhost() + "\n")
    }
}

// Parse + resolve + typecheck only. No C is emitted and no C compiler
// runs, so `orbit check` stays fast even on modest machines.
fn checkSourceWithFile(source: string, inputPath: string, colorMode: string) -> bool {
    val useColor = paletteUseColorStderr(colorMode)
    val parser = initParser(source)
    val rawAST = parseProgram(parser)
    if parser.diagnostics.len() > 0 {
        val diag: ParserDiagnostic = parser.diagnostics.get(0)
        if diag.code != "" {
            val srcLine = getSourceLine(source, diag.line)
            reportErrorCard(diag.code, diag.message, inputPath, diag.line, diag.column, srcLine, parserDiagnosticHint(diag), diag.kind, colorMode)
        } else {
            var i = 0
            while i < parser.diagnostics.len() {
                val d: ParserDiagnostic = parser.diagnostics.get(i)
                orbit_os_write_stderr_selfhost(palettePaint(paletteError(), "Parser error", useColor) + " at line " + orbit_int_to_string_selfhost(d.line) + ": " + d.message + "\n")
                i = i + 1
            }
        }
        return false
    }

    val resolver = initModuleResolver()
    val ast = resolveModuleAST(resolver, rawAST, inputPath)
    if resolver.errors.len() > 0 {
        var ri = 0
        while ri < resolver.errors.len() {
            orbit_os_write_stderr_selfhost(palettePaint(paletteError(), "Import error", useColor) + ": " + resolver.errors.get(ri) + "\n")
            ri = ri + 1
        }
        return false
    }

    val sema = initSema()
    analyze(sema, ast)
    reportResolutionGaps(sema)
    if hasErrors(sema) {
        printSemaErrors(sema, source, inputPath, colorMode)
        return false
    }
    return true
}

// Runtime headers travel with the compiler binary: prefer <bindir>/runtime
// so `orbit build` (and `orbit cluster up`) work from any working
// directory, falling back to the legacy relative "runtime" when the
// binary's directory ships no headers.
fn compilerRuntimeDir() -> string {
    val selfDir = getDir(orbit_os_argv_selfhost(0))
    if selfDir != "" {
        val cand = selfDir + "/runtime"
        if orbit_file_list_dir_selfhost(cand).len() > 0 {
            return cand
        }
    }
    return "runtime"
}

// Separate compilation against the net-variant static library
// (libruntime_net.a, built by scripts/mklib_runtime.py).
//
// The C step compiles the small user TU with -DORBIT_SEPARATE_COMPILATION and
// links the prebuilt archive instead of recompiling the whole runtime unity on
// every build. runtime.h honours the flag by exposing only runtime/orbit_api.h;
// every emitted TU already defines ORBIT_CUSTOM_ROUTER and its own
// orbit_handle_request, while the archive is built with -DORBIT_LIB_NO_ROUTER
// so the fallback router never meets at link time (see orbit_api.h).
//
// DB programs stay on the unity build by design: the net variant defines no
// DB symbols and orbit_api.h errors on ORBIT_WITH_DB, so attempting the link
// there would fail at compile time instead of running.
//
// ORBIT_LINK_RUNTIME picks the mode:
//   unset  link the archive when one sits beside the runtime directory and
//          still matches the runtime sources; otherwise the unity build, with
//          no message (--verbose names a stale or unstamped archive).
//   1      always link. A missing archive fails the C step; the test suite
//          lane uses this so a missing archive is loud.
//   0      always the unity build.
// ORBIT_RUNTIME_LIB names the archive and replaces the lookup beside the
// runtime directory. It is the caller's own file, so it gets no freshness check.

fn runtimeLibFileExists(path: string) -> bool {
    var dir = getDir(path)
    if dir == "" { dir = "." }
    return appDirHasFile(dir, appBaseName(path))
}

fn runtimeLibDirBeside(rtDir: string, rel: string) -> string {
    val base = getDir(rtDir)
    if base == "" { return rel }
    return base + "/" + rel
}

// The installed layout keeps the archive in lib/ next to runtime/. A checkout
// keeps it in .orbit/lib/, where scripts/mklib_runtime.py writes it.
fn findRuntimeLib(rtDir: string) -> string {
    val installed = runtimeLibDirBeside(rtDir, "lib") + "/libruntime_net.a"
    if runtimeLibFileExists(installed) { return installed }
    val checkout = runtimeLibDirBeside(rtDir, ".orbit/lib") + "/libruntime_net.a"
    if runtimeLibFileExists(checkout) { return checkout }
    return ""
}

// The runtime sources the archive is built from: the .c and .h files directly
// in the runtime directory, minus the test programs. scripts/mklib_runtime.py
// selects the same set.
fn runtimeSourceCounts(name: string) -> bool {
    val n = name.len()
    if n < 3 { return false }
    if n >= 5 && name.slice(0, 5) == "test_" { return false }
    val ext = name.slice(n - 2, n)
    return ext == ".c" || ext == ".h"
}

fn lineListed(lines: list < string >, want: string) -> bool {
    var i = 0
    while i < lines.len() {
        val line: string = lines.get(i)
        if line == want { return true }
        i = i + 1
    }
    return false
}

// mklib_runtime.py writes <archive>.stamp with one "<name> <fnv1a-32 hex>"
// line per runtime source. The archive is fresh when the runtime directory
// holds exactly those files with exactly those digests. An archive with no
// stamp predates the check and counts as stale.
fn runtimeArchiveFresh(rtDir: string, archive: string) -> bool {
    val stamp = orbit_file_read_selfhost(archive + ".stamp")
    if stamp == "" { return false }
    val recorded = splitBuildLines(stamp)
    val names = orbit_file_list_dir_selfhost(rtDir)
    var seen = 0
    var i = 0
    while i < names.len() {
        val name: string = names.get(i)
        if runtimeSourceCounts(name) {
            val digest = orbit_string_hash_selfhost(orbit_file_read_selfhost(rtDir + "/" + name))
            if lineListed(recorded, name + " " + digest) == false { return false }
            seen = seen + 1
        }
        i = i + 1
    }
    return seen == recorded.len()
}

// The archive to link, or "" for the unity build.
fn runtimeLibToLink(rtDir: string, hasDb: bool, verbose: bool) -> string {
    val mode = orbit_os_env_selfhost("ORBIT_LINK_RUNTIME")
    if mode == "0" || hasDb { return "" }
    val override = orbit_os_env_selfhost("ORBIT_RUNTIME_LIB")
    if mode == "1" {
        if override != "" { return override }
        val found = findRuntimeLib(rtDir)
        if found != "" { return found }
        return ".orbit/lib/libruntime_net.a"
    }
    if override != "" {
        if runtimeLibFileExists(override) { return override }
        return ""
    }
    val archive = findRuntimeLib(rtDir)
    if archive == "" { return "" }
    if runtimeArchiveFresh(rtDir, archive) == false {
        if verbose {
            print("link " + archive + " does not match " + rtDir + ", using the unity build")
        }
        return ""
    }
    return archive
}

fn orbitVersion() -> string {
    return "0.1.0-rc.2"
}

fn appLeadingDigits(s: string) -> string {
    var out = ""
    var i = 0
    while i < s.len() {
        val c = s.at(i)
        if c < 48 || c > 57 { break }
        out = out + s.slice(i, i + 1)
        i = i + 1
    }
    if out == "" { return "0" }
    return out
}

fn appTrailingDigits(s: string) -> string {
    var out = ""
    var i = s.len() - 1
    while i >= 0 {
        val c = s.at(i)
        if c < 48 || c > 57 { break }
        out = s.slice(i, i + 1) + out
        i = i - 1
    }
    if out == "" { return "0" }
    return out
}

fn appSplitDots(s: string) -> list < string > {
    val parts = []
    var rest = s
    while true {
        val pos = orbit_string_indexOf(rest, ".")
        if pos == -1 { break }
        parts.push(rest.slice(0, pos))
        rest = rest.slice(pos + 1, rest.len())
    }
    parts.push(rest)
    return parts
}

// "0.1.0-rc.2" -> "0,1,0,2": leading digits of the first three dot parts,
// trailing digits of the last part. The -rc tail drops out of the numeric
// fields; the full string stays in the text fields below.
fn appVersionNums() -> string {
    val parts = appSplitDots(orbitVersion())
    var a = "0"
    var b = "0"
    var c = "0"
    var d = "0"
    if parts.len() > 0 {
        val p0: string = parts.get(0)
        a = appLeadingDigits(p0)
    }
    if parts.len() > 1 {
        val p1: string = parts.get(1)
        b = appLeadingDigits(p1)
    }
    if parts.len() > 2 {
        val p2: string = parts.get(2)
        c = appLeadingDigits(p2)
        d = appTrailingDigits(p2)
    }
    if parts.len() > 3 {
        val p3: string = parts.get(3)
        d = appTrailingDigits(p3)
    }
    return a + "," + b + "," + c + "," + d
}

fn appBaseName(path: string) -> string {
    var base = path
    var i = 0
    while i < base.len() {
        val ch = base.slice(i, i + 1)
        if ch == "/" || ch == "\\" {
            base = base.slice(i + 1, base.len())
            i = 0
            continue
        }
        i = i + 1
    }
    return base
}

fn appDirHasFile(dir: string, name: string) -> bool {
    val items = orbit_file_list_dir_selfhost(dir)
    var i = 0
    while i < items.len() {
        val item: string = items.get(i)
        if item == name { return true }
        i = i + 1
    }
    return false
}

// The mark travels with the install: orbit.ico beside the compiler binary
// (installed layout), else the repo asset (dev loop). Empty when neither
// exists: version info still stamps, the icon just stays out.
fn appFindIcon() -> string {
    val selfDir = getDir(orbit_os_argv_selfhost(0))
    if selfDir != "" && appDirHasFile(selfDir, "orbit.ico") {
        return selfDir + "/orbit.ico"
    }
    if appDirHasFile("assets", "orbit.ico") {
        return "assets/orbit.ico"
    }
    return ""
}

// Windows version resource + mark. Fixed Orbit branding, no user input:
// there is deliberately no syntax for this, so a .orb file cannot fake it.
fn appRcText(exeBase: string, description: string, iconPath: string) -> string {
    val nums = appVersionNums()
    val ver = orbitVersion()
    var rc = "1 VERSIONINFO\n"
    rc = rc + "FILEVERSION " + nums + "\n"
    rc = rc + "PRODUCTVERSION " + nums + "\n"
    rc = rc + "FILEFLAGSMASK 0x3fL\n"
    rc = rc + "FILEFLAGS 0x0L\n"
    rc = rc + "FILEOS 0x40004L\n"
    rc = rc + "FILETYPE 0x1L\n"
    rc = rc + "FILESUBTYPE 0x0L\n"
    rc = rc + "BEGIN\n"
    rc = rc + "    BLOCK \"StringFileInfo\"\n"
    rc = rc + "    BEGIN\n"
    rc = rc + "        BLOCK \"040904b0\"\n"
    rc = rc + "        BEGIN\n"
    rc = rc + "            VALUE \"CompanyName\", \"orbit-lang\"\n"
    rc = rc + "            VALUE \"FileDescription\", \"" + description + "\"\n"
    rc = rc + "            VALUE \"FileVersion\", \"" + ver + "\"\n"
    rc = rc + "            VALUE \"InternalName\", \"" + exeBase + "\"\n"
    rc = rc + "            VALUE \"LegalCopyright\", \"MIT\"\n"
    rc = rc + "            VALUE \"OriginalFilename\", \"" + exeBase + "\"\n"
    rc = rc + "            VALUE \"ProductName\", \"Orbit\"\n"
    rc = rc + "            VALUE \"ProductVersion\", \"" + ver + "\"\n"
    rc = rc + "        END\n"
    rc = rc + "    END\n"
    rc = rc + "    BLOCK \"VarFileInfo\"\n"
    rc = rc + "    BEGIN\n"
    rc = rc + "        VALUE \"Translation\", 0x409, 1200\n"
    rc = rc + "    END\n"
    rc = rc + "END\n"
    if iconPath != "" {
        rc = rc + "IDI_ICON1 ICON \"" + iconPath + "\"\n"
    }
    return rc
}

// Returns the link fragment (" \"<res>\"") or "": windres, then llvm-rc,
// else an honest note and an unstamped binary. The build never fails for
// branding alone.
fn appResourceFragment(tmpDir: string, outputPath: string, description: string, verbose: bool) -> string {
    val rcPath = tmpDir + "/orbit_app.rc"
    val resPath = tmpDir + "/orbit_app.res"
    val rc = appRcText(appBaseName(outputPath), description, appFindIcon())
    if orbit_file_write_selfhost(rcPath, rc) == false {
        return ""
    }
    if verbose {
        print("rc " + rcPath)
    }
    val ignoredW = orbit_os_exec_selfhost("windres \"" + rcPath + "\" -O coff -o \"" + resPath + "\"")
    if appDirHasFile(tmpDir, "orbit_app.res") == false {
        val ignoredL = orbit_os_exec_selfhost("llvm-rc /FO \"" + resPath + "\" \"" + rcPath + "\"")
    }
    if appDirHasFile(tmpDir, "orbit_app.res") == false {
        orbit_os_write_stderr_selfhost("orbit build: note: no resource compiler (windres/llvm-rc); binary ships without Orbit metadata.\n")
        return ""
    }
    return " \"" + resPath + "\""
}

fn splitBuildLines(source: string) -> list < string > {
    var lines = []
    var start = 0
    var i = 0
    val n = orbit_string_len(source)
    while i < n {
        if orbit_string_char_at_selfhost(source, i) == 10 {
            lines.push(orbit_string_slice(source, start, i))
            start = i + 1
        }
        i = i + 1
    }
    if start < n {
        lines.push(orbit_string_slice(source, start, n))
    }
    return lines
}

fn replaceBuildToken(haystack: string, needle: string, replacement: string) -> string {
    if needle == "" { return haystack }
    var out = ""
    var rest = haystack
    while true {
        val idx = orbit_string_indexOf(rest, needle)
        if idx < 0 { break }
        out = out + orbit_string_slice(rest, 0, idx) + replacement
        rest = orbit_string_slice(rest, idx + orbit_string_len(needle), orbit_string_len(rest))
    }
    return out + rest
}

// Did the shell fail to exec the C compiler, as opposed to the C compiler
// starting and rejecting what we handed it? The two need different
// diagnostics, and the shell's wording is not distinctive enough to search for
// on its own: `sh: 1: gcc: not found` and clang's `'socket_compat.h' file not
// found` both contain "not found", so a bare substring test read a wrong
// -I/runtime path as a missing toolchain and told the user to set ORBIT_CC for
// a compiler that was sitting right there.
//
// What separates them is the compiler's own name. The shell names the program
// it could not run, immediately before the wording and on the same line, and no
// compiler diagnostic does: for a missing include the driver prints the header
// it wanted, never itself. So the test is positional -- take the text between
// the start of that line and the wording, and require the quoted-or-colon
// suffixed name in it. A substring search for the name would be no better than
// the one it replaces, since the default compiler is "cc" and half of C
// contains those two letters.
//
// The wordings cover the shells a build can run under: POSIX sh and bash differ
// ("gcc: not found" vs "gcc: command not found"), and cmd.exe has its own pair,
// one English and one Spanish, with single quotes in the first and double
// quotes in the second.
fn ccToolchainMissing(cCompiler: string, compOutput: string) -> bool {
    if cCompiler == "" || compOutput == "" { return false }
    // ORBIT_CC may name a wrapper with arguments ("ccache gcc"); only the
    // program appears in the shell's message.
    var name = cCompiler
    val sp = orbit_string_indexOf(name, " ")
    if sp > 0 {
        name = orbit_string_slice(name, 0, sp)
    }
    if namesToolchainBefore(compOutput, name, "not found") { return true }
    if namesToolchainBefore(compOutput, name, "not recognized") { return true }
    if namesToolchainBefore(compOutput, name, "no se reconoce") { return true }
    return false
}

// Does `ccName` appear, in one of the forms a shell quotes it, in the part of
// `compOutput` that precedes the first `wording` on its own line?
fn namesToolchainBefore(compOutput: string, ccName: string, wording: string) -> bool {
    val at = orbit_string_indexOf(compOutput, wording)
    if at == -1 { return false }
    var lineStart = at
    while lineStart > 0 && orbit_string_char_at_selfhost(compOutput, lineStart - 1) != 10 {
        lineStart = lineStart - 1
    }
    val head = orbit_string_slice(compOutput, lineStart, at)
    if orbit_string_indexOf(head, ccName + ":") != -1 { return true }
    if orbit_string_indexOf(head, "'" + ccName + "'") != -1 { return true }
    if orbit_string_indexOf(head, "\"" + ccName + "\"") != -1 { return true }
    return false
}

// The C step failed after Orbit's own phases passed. Explain what
// happened in Orbit terms, show the scrubbed C log truncated, and
// point at the full log plus the next step. Never dump raw toolchain
// paths or generated-code internals without framing.
fn reportCStepFailure(inputPath: string, cPath: string, rtDir: string, tmpDir: string, compOutput: string, verbose: bool) {
    var logPath = "orbit_build.cc.log"
    if tmpDir != "" {
        logPath = tmpDir + "/orbit_build.cc.log"
    }
    val logOk = orbit_file_write_selfhost(logPath, compOutput)
    // Scrub machine paths: the C file path in both slash flavors
    // (toolchains render whichever they were given), and the runtime
    // dir only when it is a real path (a bare "runtime" would also
    // rewrite prose that merely names it).
    var clean = replaceBuildToken(compOutput, cPath, "<build>")
    clean = replaceBuildToken(clean, replaceBuildToken(cPath, "/", "\\"), "<build>")
    if orbit_string_indexOf(rtDir, "/") != -1 {
        clean = replaceBuildToken(clean, rtDir, "<runtime>")
    }
    if orbit_string_indexOf(rtDir, "\\") != -1 {
        clean = replaceBuildToken(clean, rtDir, "<runtime>")
    }
    val lines = splitBuildLines(clean)
    var limit = 25
    if verbose {
        limit = lines.len()
    }
    orbit_os_write_stderr_selfhost("orbit build: couldn't finish the C step - this one is on me, not your code.\n")
    orbit_os_write_stderr_selfhost("  Your program translated cleanly; the C compiler rejected my output:\n")
    var shown = 0
    var li = 0
    while li < lines.len() {
        if shown >= limit { break }
        orbit_os_write_stderr_selfhost("  " + lines.get(li) + "\n")
        shown = shown + 1
        li = li + 1
    }
    if lines.len() > shown {
        orbit_os_write_stderr_selfhost("  ... " + orbit_int_to_string_selfhost(lines.len() - shown) + " more lines (full log: " + logPath + ")\n")
    }
    if logOk == false {
        orbit_os_write_stderr_selfhost("  (couldn't write the full log to " + logPath + ")\n")
    }
    // A locked output file is the one C-step failure the user causes
    // themselves: on Windows the exe is unwritable while its server runs, so
    // rebuilding over `orbit start` output always lands here. Name it instead
    // of filing it: the "file an issue" tip below would send them to report
    // their own running server as a compiler bug.
    if orbit_string_indexOf(clean, "cannot open output file") != -1 {
        if orbit_string_indexOf(clean, "Permission denied") != -1 {
            orbit_os_write_stderr_selfhost("  The linker could not write the output file because it is locked: on Windows an exe stays locked while its server runs.\n")
            orbit_os_write_stderr_selfhost("  Stop that server first (it is usually your own, from `orbit start`), then rebuild. Your program is fine; no issue to file.\n")
            return
        }
    }
    orbit_os_write_stderr_selfhost("  Tip: run `orbit check " + inputPath + "` first - if that passes, file an issue with the .orb file and I'll read it.\n")
}

// The line under a failed build. Additive: the card and the ERROR line stay
// exactly as they were, and this names the file, the count and the time on
// stderr in dim, so a script reading stdout still sees nothing.
fn compileFailed(inputPath: string, errCount: int, startMs: int, colorMode: string) {
    val useErr = paletteUseColorStderr(colorMode)
    val ms = orbit_clock_ms() - startMs
    var noun = "errors"
    if errCount == 1 {
        noun = "error"
    }
    val line = "Failed to compile " + inputPath + " with " + orbit_int_to_string_selfhost(errCount) + " " + noun + " in " + orbit_int_to_string_selfhost(ms) + " ms"
    orbit_os_write_stderr_selfhost(palettePaint(paletteDim(), line, useErr) + "\n")
}

// Backend selection. `--backend=c|native` wins over ORBIT_BACKEND, which wins
// over this default. The default is one function so changing it is a one-line
// commit that the suite_native and suite_std_native gates decide.
fn hostIsWindows() -> bool {
    return orbit_os_env_selfhost("OS") == "Windows_NT" || orbit_os_env_selfhost("WINDIR") != ""
}

fn defaultBackend() -> string {
    if hostIsWindows() { return "native" }
    return "c"
}

fn backendKnown(name: string) -> bool {
    return name == "c" || name == "native"
}

fn requestedBackend(flag: string) -> string {
    if flag != "" { return flag }
    return orbit_os_env_selfhost("ORBIT_BACKEND")
}

// "c", "native", or "" when the requested name is not a backend.
fn resolveBackend(flag: string) -> string {
    val wanted = requestedBackend(flag)
    if wanted == "" { return defaultBackend() }
    if backendKnown(wanted) { return wanted }
    return ""
}

// The directory intermediate files go to. Every platform's temp variable is
// honoured, not just the Windows one.
fn buildTempDir() -> string {
    var tmpDir = orbit_os_env_selfhost("TEMP")
    if tmpDir == "" {
        tmpDir = orbit_os_env_selfhost("TMPDIR")
    }
    if tmpDir == "" {
        tmpDir = orbit_os_env_selfhost("TMP")
    }
    if tmpDir == "" {
        tmpDir = orbit_os_temp_dir_selfhost()
    }
    return tmpDir
}

fn reportCompiled(inputPath: string, outputPath: string, startMs: int, colorMode: string) {
    val useColorOut = paletteUseColorStdout(colorMode)
    val ms = orbit_clock_ms() - startMs
    val check = palettePaint(paletteOk(), "✓", useColorOut)
    val word = palettePaint(paletteOk(), "Compiled", useColorOut)
    val file = palettePaint(paletteBright(), inputPath, useColorOut)
    val timing = palettePaint(paletteDim(), "in " + orbit_int_to_string_selfhost(ms) + " ms", useColorOut)
    print(check + " " + word + " " + file + " " + timing)
    print("wrote " + outputPath)
}

fn emitIrDocument(irModule: IRModule, irPath: string, verbose: bool, useColorErr: bool) -> bool {
    val badFloat = irNonFiniteFloat(irModule)
    if badFloat != "" {
        orbit_os_write_stderr_selfhost(palettePaint(paletteError(), "orbit build:", useColorErr) + " cannot emit IR: non-finite float in " + badFloat + " has no JSON form (V-08)\n")
        return false
    }
    var tofi = 0
    while tofi < irModule.functions.len() {
        typeObjectFieldReads(irModule.functions.get(tofi))
        typeRegistersByComparison(irModule.functions.get(tofi))
        tofi = tofi + 1
    }
    if orbit_file_write_selfhost(irPath, emitIRv1(irModule)) == false {
        orbit_os_write_stderr_selfhost(palettePaint(paletteError(), "orbit build:", useColorErr) + " could not write IR file '" + irPath + "'.\n")
        return false
    }
    if verbose {
        print("ir: wrote " + irPath)
    }
    return true
}

// The native backend is R6, a separate executable. It is found, in order:
//   1. ORBIT_R6, the path of the executable (an error when it does not exist);
//   2. r6.exe beside the orbit executable (a portable directory);
//   3. bin/r6.exe under the directory holding orbit (the installed layout:
//      orbit.exe, bin/r6.exe, lib/, runtime/, std/ under one root).
fn findInstalledR6() -> string {
    val dir = getDir(orbit_os_argv_selfhost(0))
    if dir == "" { return "" }
    val beside = dir + "/r6.exe"
    if runtimeLibFileExists(beside) { return beside }
    val installed = dir + "/bin/r6.exe"
    if runtimeLibFileExists(installed) { return installed }
    return ""
}

// R6 links the runtime archives (libruntime_net.a, libruntime_net_db.a,
// sqlite3.lib) from the directory in R6_RUNTIME_DIR. ORBIT_R6_RUNTIME names
// it; otherwise the installed lib/ beside the orbit executable, when it holds
// the archive. When neither exists the variable is left as the caller has it.
fn r6RuntimeDir() -> string {
    val named = orbit_os_env_selfhost("ORBIT_R6_RUNTIME")
    if named != "" { return named }
    val dir = getDir(orbit_os_argv_selfhost(0))
    if dir == "" { return "" }
    val lib = dir + "/lib"
    if runtimeLibFileExists(lib + "/libruntime_net.a") { return lib }
    return ""
}

fn shellPath(path: string) -> string {
    return replaceBuildToken(path, "/", "\\")
}

fn nativeIrTempPath(outputPath: string) -> string {
    val name = "orbit_native_" + appBaseName(outputPath) + ".ir"
    val tmpDir = buildTempDir()
    if tmpDir == "" { return name }
    return tmpDir + "/" + name
}

// The IR protocol this compiler emits. `r6 --version` prints
// "r6 <semver> ir-protocol <N>"; an r6 that prints another N (or nothing)
// reads a different IR, so it is refused before it is given a program.
fn r6IrProtocol() -> string {
    return "2"
}

// How long the version probe may take. A current r6 answers in milliseconds;
// a stale one that ignores the flag and waits for input is the case this bounds.
fn r6ProbeTimeoutMs() -> int {
    return 5000
}

// How long one native build may run. ORBIT_R6_TIMEOUT_MS overrides it.
fn r6BuildTimeoutMs() -> int {
    val named = orbit_os_env_selfhost("ORBIT_R6_TIMEOUT_MS")
    if named != "" {
        val n = orbit_string_to_int(named)
        if n > 0 { return n }
    }
    return 300000
}

fn trimLineEnd(line: string) -> string {
    var end = orbit_string_len(line)
    while end > 0 && (orbit_string_char_at_selfhost(line, end - 1) == 13 || orbit_string_char_at_selfhost(line, end - 1) == 32) {
        end = end - 1
    }
    return orbit_string_slice(line, 0, end)
}

// "" when the r6 at `r6` answers `--version` with a known protocol, otherwise
// the reason, ready to print after the path.
fn r6RefusalReason(r6: string) -> string {
    val tmpDir = buildTempDir()
    var probe = "orbit_r6_version.txt"
    if tmpDir != "" {
        probe = tmpDir + "/" + probe
    }
    val code = orbit_os_run_timeout_selfhost("\"" + shellPath(r6) + "\" --version", r6ProbeTimeoutMs(), shellPath(probe))
    if code == -2 {
        return "did not answer `--version` within " + orbit_int_to_string_selfhost(r6ProbeTimeoutMs() / 1000) + " s; it is probably an older r6 that waits for input"
    }
    if code != 0 {
        return "could not run `--version` (exit " + orbit_int_to_string_selfhost(code) + ")"
    }
    val lines = splitBuildLines(orbit_file_read_selfhost(probe))
    if lines.len() == 0 {
        return "printed nothing for `--version`"
    }
    val first: string = lines.get(0)
    val line = trimLineEnd(first)
    val suffix = " ir-protocol " + r6IrProtocol()
    val wanted = orbit_string_len(line) > 3 && orbit_string_slice(line, 0, 3) == "r6 "
    val known = orbit_string_len(line) >= orbit_string_len(suffix) && orbit_string_slice(line, orbit_string_len(line) - orbit_string_len(suffix), orbit_string_len(line)) == suffix
    if wanted == false || known == false {
        return "printed '" + line + "' for `--version`, and this compiler needs 'r6 <version>" + suffix + "'"
    }
    return ""
}

// Runs R6 on the emitted IR. Its stderr is the diagnostic and passes through
// untouched; a refusal is a compile error and never falls back to the C
// backend. The command is wrapped in one more pair of quotes because the
// Windows shell strips the outermost pair of a command that begins with one.
fn nativeBuild(irPath: string, irIsTemp: bool, inputPath: string, outputPath: string, verbose: bool, colorMode: string) -> bool {
    val useColorErr = paletteUseColorStderr(colorMode)
    val head = palettePaint(paletteError(), "orbit build:", useColorErr)
    val named = orbit_os_env_selfhost("ORBIT_R6")
    var r6 = ""
    if named != "" {
        if runtimeLibFileExists(named) == false {
            orbit_os_write_stderr_selfhost(head + " ORBIT_R6 is '" + named + "' and that file doesn't exist. Point it at r6.exe, or unset it to use the installed one.\n")
            return false
        }
        r6 = named
    } else {
        r6 = findInstalledR6()
    }
    if r6 == "" {
        orbit_os_write_stderr_selfhost(head + " the native backend needs r6.exe and couldn't find it.\n")
        orbit_os_write_stderr_selfhost("  Tip: set ORBIT_R6 to its path, or put it in bin\\r6.exe under the Orbit install. `orbit build --backend=c` needs neither.\n")
        return false
    }
    val refusal = r6RefusalReason(r6)
    if refusal != "" {
        orbit_os_write_stderr_selfhost(head + " the native backend found '" + r6 + "' and it " + refusal + ".\n")
        orbit_os_write_stderr_selfhost("  Tip: set ORBIT_R6 to a current r6.exe, or build with --backend=c.\n")
        return false
    }
    var cmd = ""
    val rtDir = r6RuntimeDir()
    if rtDir != "" {
        cmd = cmd + "set \"R6_RUNTIME_DIR=" + shellPath(rtDir) + "\" && "
    }
    val tmpDir = buildTempDir()
    if tmpDir != "" {
        cmd = cmd + "set \"R6_TMPDIR=" + shellPath(tmpDir) + "\" && "
    }
    cmd = cmd + "\"" + shellPath(r6) + "\" build \"" + shellPath(irPath) + "\" -o \"" + shellPath(outputPath) + "\""
    if verbose {
        print("r6 " + cmd)
    }
    val code = orbit_os_run_timeout_selfhost(cmd, r6BuildTimeoutMs(), "")
    if irIsTemp && verbose == false {
        val ignoredDel = orbit_os_exec_selfhost("del /F /Q \"" + shellPath(irPath) + "\" 2>NUL")
    }
    if code == -2 {
        orbit_os_write_stderr_selfhost(head + " the native backend (R6 at '" + r6 + "') did not finish " + inputPath + " within " + orbit_int_to_string_selfhost(r6BuildTimeoutMs() / 1000) + " s and was stopped. ORBIT_R6_TIMEOUT_MS changes the limit.\n")
        return false
    }
    if code != 0 {
        orbit_os_write_stderr_selfhost(head + " the native backend (R6) refused " + inputPath + " (exit " + orbit_int_to_string_selfhost(code) + "); its diagnostic is above.\n")
        orbit_os_write_stderr_selfhost("  Tip: `orbit build --backend=c " + inputPath + "` builds it with the C backend.\n")
        return false
    }
    return true
}

fn compileSourceWithFile(source: string, inputPath: string, outputPath: string, verbose: bool, quiet: bool, colorMode: string, release: bool, emitIrPath: string, backendArg: string) -> bool {
    val useColorOut = paletteUseColorStdout(colorMode)
    val useColorErr = paletteUseColorStderr(colorMode)
    val startMs = orbit_clock_ms()
    val parser = initParser(source)
    val rawAST = parseProgram(parser)
    if parser.diagnostics.len() > 0 {
        val diag: ParserDiagnostic = parser.diagnostics.get(0)
        if diag.code != "" {
            val srcLine = getSourceLine(source, diag.line)
            reportErrorCard(diag.code, diag.message, inputPath, diag.line, diag.column, srcLine, parserDiagnosticHint(diag), diag.kind, colorMode)
        } else {
            var i = 0
            while i < parser.diagnostics.len() {
                val d: ParserDiagnostic = parser.diagnostics.get(i)
                orbit_os_write_stderr_selfhost(palettePaint(paletteError(), "Parser error", useColorErr) + " at line " + orbit_int_to_string_selfhost(d.line) + ": " + d.message + "\n")
                i = i + 1
            }
        }
        compileFailed(inputPath, parser.diagnostics.len(), startMs, colorMode)
        return false
    }

    reportMemStage("parse")

    val resolver = initModuleResolver()
    val ast = resolveModuleAST(resolver, rawAST, inputPath)
    if resolver.errors.len() > 0 {
        var ri = 0
        while ri < resolver.errors.len() {
            orbit_os_write_stderr_selfhost(palettePaint(paletteError(), "Import error", useColorErr) + ": " + resolver.errors.get(ri) + "\n")
            ri = ri + 1
        }
        compileFailed(inputPath, resolver.errors.len(), startMs, colorMode)
        return false
    }
    reportMemStage("resolve")

    val sema = initSema()
    analyze(sema, ast)
    reportResolutionGaps(sema)
    if hasErrors(sema) {
        val firstErr: SemaError = sema.errors.get(0)
        if orbit_string_indexOf(firstErr.message, "Non-void function must return a value") != -1 {
            reportErrorCard("return/missing-value", "Non-void function must return a value", "<unknown>", 1, 1, "", "Ensure type consistency and scope rules are satisfied.", "error.SemanticAnalysisFailed", colorMode)
        } else {
            printSemaErrors(sema, source, inputPath, colorMode)
        }
        compileFailed(inputPath, sema.errors.len(), startMs, colorMode)
        return false
    }
    reportMemStage("sema")

    val builder = initIRBuilder()
    val irModule = buildAST(builder, ast)
    irModule.sourceName = sourceBaseName(inputPath)
    reportMemStage("build")

    // The C backend has to stay the path when ORBIT_SKIP_CC is set: that
    // switch is defined as "emit the intermediate C and stop", and the
    // bootstrap reads that C whatever the default backend is.
    val backendName = resolveBackend(backendArg)
    if backendName == "" {
        orbit_os_write_stderr_selfhost(palettePaint(paletteError(), "orbit build:", useColorErr) + " unknown backend '" + requestedBackend(backendArg) + "'. Use c or native (--backend=c|native, ORBIT_BACKEND).\n")
        return false
    }
    val native = backendName == "native" && orbit_os_env_selfhost("ORBIT_SKIP_CC") == ""
    if native && hostIsWindows() == false {
        orbit_os_write_stderr_selfhost(palettePaint(paletteError(), "orbit build:", useColorErr) + " the native backend targets Windows x86-64 only. Use --backend=c on this platform.\n")
        return false
    }

    // --emit-ir dumps IRv1 straight after the builder, before the optimizer
    // and the C backend touch the module, so registerTypes is what buildAST
    // produced (P1, docs/IR_SPEC_ALIGNMENT.md section 6).  A non-finite float
    // has no JSON form, so it aborts the build instead of writing a bad
    // document (V-08); a failed write is reported the same way.  The native
    // backend compiles this same document, so it takes the same path.
    var irPath = emitIrPath
    if native && irPath == "" {
        irPath = nativeIrTempPath(outputPath)
    }
    if irPath != "" {
        if emitIrDocument(irModule, irPath, verbose, useColorErr) == false {
            return false
        }
    }
    if native {
        if nativeBuild(irPath, emitIrPath == "", inputPath, outputPath, verbose, colorMode) == false {
            return false
        }
        if quiet == false {
            reportCompiled(inputPath, outputPath, startMs, colorMode)
        }
        return true
    }

    // Both optimization passes honor the same kill switch
    // (ORBIT_NO_CTE=1 skips them and emits pre-pass IR), and their
    // counters are reported instead of dropped.
    var optPatterns = 0
    var cteFolds = 0
    var optSpan = 0
    if cteEnabled() {
        val optStats = optimizeIRModule(irModule)
        optPatterns = optStats.patterns_applied
        optSpan = optStats.span_saved
        cteFolds = cteOptimize(irModule)
    }
    if verbose {
        print("opt: " + orbit_int_to_string_selfhost(optPatterns) + " patterns, " + orbit_int_to_string_selfhost(cteFolds) + " folds, span " + orbit_int_to_string_selfhost(optSpan))
    }

    // After the folder, which can leave a callee without a caller.
    val prunedFunctions = pruneUnreachable(irModule)
    if verbose {
        print("prune: " + orbit_int_to_string_selfhost(prunedFunctions) + " unreachable functions dropped")
    }

    val backend = initCBackend(irModule)
    val cCode = generateC(backend)
    val hCode = generateCHeader(backend)
    reportMemStage("codegen")
    val irErrs = verifyModuleTypes(backend)
    if irErrs.len() > 0 {
        var ie = 0
        while ie < irErrs.len() {
            orbit_os_write_stderr_selfhost(palettePaint(paletteError(), "orbit build:", useColorErr) + " type verification: " + irErrs.get(ie) + "\n")
            ie = ie + 1
        }
        return false
    }
    val hasDb = moduleUsesDatabase(irModule)

    // Use a constant intermediate-C filename: clang embeds the C file path in
    // anonymous-struct names and type diagnostics, so a path derived from the
    // output name (e.g. stage2.exe.c vs stage3.exe.c) would make the 3-stage
    // bootstrap fixed-point comparison fail even though the code is identical.
    var cPath = "orbit_selfhost_build.c"
    // Honour every platform's temp variable, not just the Windows one, so a
    // plain `orbit build` never littles a multi-megabyte C file into the
    // user's working directory and two concurrent builds in one directory do
    // not race on the same file.
    val tmpDir = buildTempDir()
    if tmpDir != "" {
        cPath = tmpDir + "/" + cPath
    }

    if orbit_file_write_selfhost(cPath, cCode) == false {
        orbit_os_write_stderr_selfhost("orbit build: couldn't write the intermediate C file '" + cPath + "'.\n")
        return false
    }
    // The shard header travels with the intermediate C: same directory, same
    // basename, `.h` for `.c`. Shard TUs include it; the single-TU build
    // ignores it.
    val hPath = orbit_string_slice(cPath, 0, orbit_string_len(cPath) - 1) + "h"
    if orbit_file_write_selfhost(hPath, hCode) == false {
        orbit_os_write_stderr_selfhost("orbit build: couldn't write the intermediate shard header '" + hPath + "'.\n")
        return false
    }

    var linkFlags = ""
    val osName = orbit_os_env_selfhost("OS")
    val winDir = orbit_os_env_selfhost("WINDIR")
    if osName == "Windows_NT" || winDir != "" {
        // The stack reserve is explicit: a recursive-descent compiler needs
        // more than the 2 MB default once `int` is 64 bits and an unoptimized
        // frame holds eight-byte registers. The reserve is address space, not
        // committed memory.
        // ws2_32 is imported only by a program that uses the network
        // (routes, the HTTP client, a database): docs/STARTUP.md.
        linkFlags = " -Wl,--stack,16777216"
        if moduleUsesNetwork(backend) {
            linkFlags = " -lws2_32" + linkFlags
        }
    }

    // Sovereignty: the compiler never assumes a specific toolchain vendor.
    // Resolution order: ORBIT_CC -> CC -> POSIX "cc" convention.
    var cCompiler = orbit_os_env_selfhost("ORBIT_CC")
    if cCompiler == "" {
        cCompiler = orbit_os_env_selfhost("CC")
    }
    if cCompiler == "" {
        cCompiler = "cc"
    }

    // ORBIT_SKIP_CC=1 emits the intermediate C and stops. The self-host
    // bootstrap uses this: it needs the C to compare fixed points, and it
    // compiles that C itself with known-good flags, so the compiler's own cc
    // invocation is a redundant ~20 s compile of the same multi-megabyte unit.
    // scripts/build_selfhost.py and scripts/verify_seed.py set it and tolerate
    // the non-zero exit this returns.
    if orbit_os_env_selfhost("ORBIT_SKIP_CC") != "" {
        orbit_os_write_stderr_selfhost("orbit build: ORBIT_SKIP_CC set, wrote '" + cPath + "' without invoking the C compiler\n")
        return true
    }

    val rtDir = compilerRuntimeDir()
    var dbFlags = ""
    val isWindowsHost = osName == "Windows_NT" || winDir != ""
    if hasDb {
        if isWindowsHost {
            dbFlags = " -DORBIT_WITH_DB -I\"" + rtDir + "/vendor\" \"" + rtDir + "/vendor/win-x64/sqlite3.lib\""
        } else {
            dbFlags = " -DORBIT_WITH_DB -I\"" + rtDir + "/vendor\" -lsqlite3"
        }
    }
    var netFlag = ""
    if moduleUsesNetwork(backend) {
        netFlag = " -DORBIT_WITH_NET"
    }
    val libPath = runtimeLibToLink(rtDir, hasDb, verbose)
    var separateFlags = ""
    var libRef = ""
    if libPath != "" {
        separateFlags = " -DORBIT_SEPARATE_COMPILATION"
        libRef = " \"" + libPath + "\""
    }

    // Warning policy. -Wall is on by default so a human build surfaces
    // diagnostics, but it is expensive on large outputs: measured on a
    // multi-megabyte generated unit it costs 5.7x the compile time and the
    // analysis it enables is superlinear in emitted size. ORBIT_WARNINGS=0
    // turns it off, which is what the bootstrap sets; the strict gate is
    // scripts/werror_gate.py (-Werror on generated C), run in CI.
    // The -Wno-error=int-conversion and -Wno-error=incompatible-pointer-types
    // downgrades that used to be here are gone. Both were needed on GCC 14+,
    // which compiles them as errors by default, so one surviving instance
    // would have broken a user build instead of warning. The emitted C is now
    // clean for both classes on every program in examples/, tests/suite/ and
    // tests/std/ and on the canonical unit, so a regression should fail loudly
    // rather than be papered over.
    var warnFlags = " -Wall"
    if orbit_os_env_selfhost("ORBIT_WARNINGS") == "0" {
        warnFlags = ""
    }
    // Instruction selection for the emitted unit. User builds shipped -O0
    // because the flag was never revisited after codegen worked; every user
    // program therefore ran unoptimized across the program and the runtime
    // alike. -O1 is the measured knee: on the scratch service's CPU-bound
    // routes gcc at -O1 takes /int p50 49.4 ms -> 15.7 ms and /list
    // 102.4 ms -> 13.8 ms (3.2x / 7.4x) for +1.77 s of build wall time, and
    // -O2 buys nothing measurable on either route (15.5 / 13.5 ms) while
    // adding a further +2.5 s. The trivial routes are unaffected at any level
    // (their cost is the log and Kynx admission, not the handler). `-s` still
    // strips the shipped binary. -O2 strict-aliasing on generated C is
    // pre-anticipated in the emitter, so it is opt-in, not the default:
    // `orbit build --release` selects it. ORBIT_CCFLAGS_EXTRA is appended
    // after this, so a caller can still override the level (last -O wins).
    var optFlag = " -O1"
    if release {
        optFlag = " -O2"
    }
    var compCmd = cCompiler + " -s" + optFlag + warnFlags + " " + cPath + " -o " + outputPath + " -I\"" + rtDir + "\"" + netFlag + separateFlags + dbFlags + libRef + linkFlags
    // Orbit branding: every binary linked on Windows carries the version
    // resource + mark. Fixed metadata, never user input (there is no syntax
    // for it), so services and plain programs alike are recognisably Orbit's.
    if isWindowsHost && tmpDir != "" {
        var appDesc = "Orbit program"
        if moduleHasRoute(backend) {
            appDesc = "Orbit service"
        }
        compCmd = compCmd + appResourceFragment(tmpDir, outputPath, appDesc, verbose)
    }

    val ccExtra = orbit_os_env_selfhost("ORBIT_CCFLAGS_EXTRA")
    if ccExtra != "" {
        compCmd = compCmd + " " + ccExtra
    }
    compCmd = compCmd + " 2>&1"
    if verbose {
        print("cc " + compCmd)
    }
    val compOutput = orbit_os_exec_selfhost(compCmd)
    if compOutput != "" {
        if compOutput.indexOf("[ERROR") != -1 || compOutput.indexOf("error:") != -1 || compOutput.indexOf("Error:") != -1 {
            if ccToolchainMissing(cCompiler, compOutput) {
                orbit_os_write_stderr_selfhost("C compiler '" + cCompiler + "' was not found. Set the ORBIT_CC environment variable to your C compiler (e.g. gcc, clang, cc).\n")
                return false
            }
            reportCStepFailure(inputPath, cPath, rtDir, tmpDir, compOutput, verbose)
            return false
        }
    }
    if quiet == false {
        reportCompiled(inputPath, outputPath, startMs, colorMode)
    }
    return true
}
