// External functions provided by the runtime for self-hosted compiler
extern fn orbit_int_to_string_selfhost(value: int) -> string
extern fn orbit_string_to_int(s: string) -> int
extern fn orbit_float_to_string_selfhost(value: float) -> string
extern fn orbit_string_char_at_selfhost(s: string, index: int) -> int
// Length-aware slice: same result as s.slice(start, end) without the strlen,
// for callers that already hold the length (the lexer slices every token out
// of a source whose length it tracks). Clamps like slice; see runtime.
extern fn orbit_string_slice_known_len(s: string, start: int, end: int, totalLen: int) -> string
extern fn orbit_string_from_char_selfhost(code: int) -> string
extern fn orbit_os_argc_selfhost() -> int
extern fn orbit_os_argv_selfhost(index: int) -> string
extern fn orbit_os_exec_selfhost(command: string) -> string
extern fn orbit_os_spawn_selfhost(command: string) -> int
extern fn orbit_os_run_timeout_selfhost(command: string, timeoutMs: int, capturePath: string) -> int
extern fn orbit_os_spawn_bg_selfhost(command: string, logfile: string) -> int
extern fn orbit_os_kill_selfhost(pid: int, mode: int) -> int
extern fn orbit_os_env_selfhost(var_name: string) -> string
extern fn orbit_os_cwd_selfhost() -> string
extern fn orbit_os_temp_dir_selfhost() -> string
extern fn orbit_os_mkdir_selfhost(path: string) -> bool
extern fn orbit_string_hash_selfhost(s: string) -> string
extern fn orbit_string_cmp_selfhost(a: string, b: string) -> int
extern fn orbit_file_write_selfhost(path: string, content: string) -> bool
extern fn orbit_file_read_selfhost(path: string) -> string
extern fn orbit_file_list_dir_selfhost(path: string) -> list
extern fn orbit_os_exit_selfhost(code: int)
extern fn orbit_os_write_stderr_selfhost(content: string)
extern fn orbit_os_isatty_selfhost(fd: int) -> bool
// Chunk buffer for codegen: the handle rides in a string-typed local
// (never inspected as text): a handle is a pointer, not a number.
extern fn orbit_cbuf_create_selfhost() -> string
extern fn orbit_cbuf_append_selfhost(buf: string, s: string)
extern fn orbit_cbuf_build_selfhost(buf: string) -> string
// Memory snapshot of the global arena (see ORBIT_MEM_REPORT).
extern fn orbit_mem_report_selfhost() -> string
// Monotonic clock, nanoseconds. Doctor times each of its layers with it so the
// scan budget in ENGINEERING.md is measured rather than asserted.
extern fn orbit_clock_ms() -> int
// Terminal UI (runtime/console.c). Caps: 1 console, 2 escapes enabled on the
// handle, 4 UTF-8 output. The animation repaints a block on stderr from its own
// thread; byte 0x01 in the block is the orbital frame, 0x02 the running ms.
extern fn orbit_ui_caps(fd: int) -> int
extern fn orbit_ui_width(fd: int) -> int
extern fn orbit_ui_text_size(path: string) -> int
extern fn orbit_ui_anim_start(block: string, flags: int) -> int
extern fn orbit_ui_anim_stage(block: string) -> int
extern fn orbit_ui_anim_stop(finalBlock: string) -> int
