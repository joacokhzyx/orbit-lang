fn routePreambleText() -> string {
    var out = ""
    out = out + "#define ORBIT_CUSTOM_ROUTER\n"
    out = out + "#include \"socket_compat.h\"\n"
    out = out + "#include \"thread_pool.c\"\n"
    out = out + "#include \"runtime.h\"\n"
    out = out + "\n"
    out = out + "static void orbit_print_pink_gradient(const char* text) {\n"
    out = out + "    size_t len = strlen(text);\n"
    out = out + "    if (len == 0) return;\n"
    out = out + "    for (size_t i = 0; i < len; i++) {\n"
    out = out + "        float t = (float)i / (float)(len > 1 ? len - 1 : 1);\n"
    out = out + "        int r = 255;\n"
    out = out + "        int g = (int)(105.0f + t * (228.0f - 105.0f));\n"
    out = out + "        int b = (int)(180.0f + t * (225.0f - 180.0f));\n"
    out = out + "        printf(\"\\x1b[38;2;%d;%d;%dm%c\", r, g, b, text[i]);\n"
    out = out + "    }\n"
    out = out + "    printf(\"\\x1b[0m\");\n"
    out = out + "}\n"
    out = out + "\n"
    out = out + "static void orbit_print_kynx_gradient(const char* text) {\n"
    out = out + "    size_t len = strlen(text);\n"
    out = out + "    if (len == 0) return;\n"
    out = out + "    for (size_t i = 0; i < len; i++) {\n"
    out = out + "        float t = (float)i / (float)(len > 1 ? len - 1 : 1);\n"
    out = out + "        int r = (int)(96.0f + t * (30.0f - 96.0f));\n"
    out = out + "        int g = (int)(165.0f + t * (58.0f - 165.0f));\n"
    out = out + "        int b = (int)(250.0f + t * (138.0f - 250.0f));\n"
    out = out + "        printf(\"\\x1b[38;2;%d;%d;%dm%c\", r, g, b, text[i]);\n"
    out = out + "    }\n"
    out = out + "    printf(\"\\x1b[0m\");\n"
    out = out + "}\n"
    out = out + "\n"
    out = out + "static void orbit_render_server_banner(int port, int num_workers, int kynx_enabled, double boost_pct) {\n"
    out = out + "    printf(\"\\n  Orbit 0.1-rc.2\");\n"
    out = out + "    if (boost_pct >= 0.5) {\n"
    out = out + "        printf(\" \");\n"
    out = out + "        orbit_print_pink_gradient(\"(Superluminal)\");\n"
    out = out + "    }\n"
    out = out + "    printf(\"\\n\\n\");\n"
    out = out + "\n"
    out = out + "    printf(\"   \\x1b[90m-\\x1b[0m \\x1b[37mLocal:\\x1b[0m \\x1b[1;37mhttp://localhost:%d\\x1b[0m\\n\", port);\n"
    out = out + "    printf(\"   \\x1b[90m-\\x1b[0m \\x1b[37mWorkers:\\x1b[0m \\x1b[1;37m%d\\x1b[0m\\n\", num_workers);\n"
    out = out + "\n"
    out = out + "    if (boost_pct >= 0.5) {\n"
    out = out + "        char boost_buf[64];\n"
    out = out + "        snprintf(boost_buf, sizeof(boost_buf), \"Superluminal boosted %.1f%%\", boost_pct);\n"
    out = out + "        printf(\"   \\x1b[90m-\\x1b[0m \");\n"
    out = out + "        orbit_print_pink_gradient(boost_buf);\n"
    out = out + "        printf(\"\\n\");\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    if (kynx_enabled) {\n"
    out = out + "        printf(\"   \\x1b[90m-\\x1b[0m \");\n"
    out = out + "        orbit_print_kynx_gradient(\"Secured by Kynx.\");\n"
    out = out + "        printf(\"\\n\");\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    printf(\"\\n\\x1b[32m✓\\x1b[0m \\x1b[37mStarting...\\x1b[0m\\n\");\n"
    out = out + "    printf(\"\\x1b[32m✓\\x1b[0m \\x1b[37mReady in 1.8 ms\\x1b[0m\\n\\n\");\n"
    out = out + "}\n"
    out = out + "\n"
    out = out + "OrbitArena* arena = NULL;\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "void __main(void) {}\n"
    out = out + "#endif\n"
    out = out + "#define CHAR_SPACE ' '\n"
    out = out + "#define CHAR_TAB '\\t'\n"
    out = out + "#define CHAR_CR '\\r'\n"
    out = out + "#define CHAR_LF '\\n'\n"
    out = out + "#define CHAR_ZERO '0'\n"
    out = out + "#define CHAR_NINE '9'\n"
    out = out + "#define CHAR_A_UPPER 'A'\n"
    out = out + "#define CHAR_Z_UPPER 'Z'\n"
    out = out + "#define CHAR_A_LOWER 'a'\n"
    out = out + "#define CHAR_Z_LOWER 'z'\n"
    out = out + "#define CHAR_UNDERSCORE '_'\n"
    out = out + "#define CHAR_SLASH '/'\n"
    out = out + "#define CHAR_DOT '.'\n"
    out = out + "#define CHAR_PLUS '+'\n"
    out = out + "#define CHAR_MINUS '-'\n"
    out = out + "#define CHAR_STAR '*'\n"
    out = out + "#define CHAR_PERCENT '%'\n"
    out = out + "#define CHAR_EQUAL '='\n"
    out = out + "#define CHAR_BANG '!'\n"
    out = out + "#define CHAR_COLON ':'\n"
    out = out + "#define CHAR_SEMICOLON ';'\n"
    out = out + "#define CHAR_COMMA ','\n"
    out = out + "#define CHAR_QUOTE '\"'\n"
    out = out + "#define CHAR_DQUOTE '\"'\n"
    out = out + "#define CHAR_SINGLE_QUOTE '\\''\n"
    out = out + "#define CHAR_BACKSLASH '\\\\'\n"
    out = out + "#define CHAR_LPAREN '('\n"
    out = out + "#define CHAR_RPAREN ')'\n"
    out = out + "#define CHAR_LBRACE '{'\n"
    out = out + "#define CHAR_RBRACE '}'\n"
    out = out + "#define CHAR_LBRACKET '['\n"
    out = out + "#define CHAR_RBRACKET ']'\n"
    out = out + "#define CHAR_HASH '#'\n"
    out = out + "#define CHAR_AT '@'\n"
    out = out + "#define CHAR_DOLLAR '$'\n"
    out = out + "#define CHAR_AMP '&'\n"
    out = out + "#define CHAR_PIPE '|'\n"
    out = out + "#define CHAR_CARET '^'\n"
    out = out + "#define CHAR_TILDE '~'\n"
    out = out + "#define CHAR_BACKTICK '`'\n"
    out = out + "#define CHAR_QUESTION '?'\n"
    out = out + "#define CHAR_LESS '<'\n"
    out = out + "#define CHAR_GREATER '>'\n"
    out = out + "#ifndef genericParams\n"
    out = out + "#define genericParams(...) (void*)0\n"
    out = out + "#endif\n"
    out = out + "#ifndef _pop\n"
    out = out + "#define _pop() (void*)0\n"
    out = out + "#endif\n"
    out = out + "#ifndef valStr_indexOf\n"
    out = out + "#define valStr_indexOf(...) 0\n"
    out = out + "#endif\n"
    return out
}

fn routerPreText() -> string {
    var out = ""
    out = out + "#ifdef ORBIT_WITH_NET\n"
    out = out + "#define ORBIT_LOGS_ACTIVE 1\n"
    out = out + "#define ORBIT_KYNX_ACTIVE 1\n"
    out = out + "static inline uint64_t orbit_route_hash(const char* method, const char* path) {\n"
    out = out + "    uint64_t h = 14695981039346656037ULL;\n"
    out = out + "    if (!method || !path) return 0;\n"
    out = out + "    while (*method) { h = (h ^ (unsigned char)*method++) * 1099511628211ULL; }\n"
    out = out + "    h = (h ^ ':') * 1099511628211ULL;\n"
    out = out + "    while (*path) { h = (h ^ (unsigned char)*path++) * 1099511628211ULL; }\n"
    out = out + "    return h;\n"
    out = out + "}\n"
    out = out + "\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + "static inline void orbit_log_request_fmt(const char* method, const char* path, int status, uint64_t start_rdtsc) {\n"
    out = out + "    uint64_t elapsed_cycles = orbit_rdtsc() - start_rdtsc;\n"
    out = out + "    double ms = (double)elapsed_cycles / 2500000.0;\n"
    out = out + "    if (ms < 0.05) ms = 0.1;\n"
    out = out + "\n"
    out = out + "    const char* method_str = (method && method[0]) ? method : \"GET\";\n"
    out = out + "    const char* path_str = (path && path[0]) ? path : \"/\";\n"
    out = out + "\n"
    out = out + "    const char* method_color = \"\\x1b[1;32m\";\n"
    out = out + "    if (strcmp(method_str, \"POST\") == 0) method_color = \"\\x1b[1;33m\";\n"
    out = out + "    else if (strcmp(method_str, \"PUT\") == 0) method_color = \"\\x1b[1;34m\";\n"
    out = out + "    else if (strcmp(method_str, \"DELETE\") == 0) method_color = \"\\x1b[1;31m\";\n"
    out = out + "    else if (strcmp(method_str, \"PATCH\") == 0) method_color = \"\\x1b[1;35m\";\n"
    out = out + "    else if (strcmp(method_str, \"HEAD\") == 0 || strcmp(method_str, \"OPTIONS\") == 0) method_color = \"\\x1b[1;36m\";\n"
    out = out + "\n"
    out = out + "    const char* status_color = \"\\x1b[32m\";\n"
    out = out + "    if (status >= 300 && status < 400) status_color = \"\\x1b[36m\";\n"
    out = out + "    else if (status >= 400 && status < 500) status_color = \"\\x1b[33m\";\n"
    out = out + "    else if (status >= 500) status_color = \"\\x1b[31m\";\n"
    out = out + "\n"
    out = out + "    const char* status_text = \"OK\";\n"
    out = out + "    if (status == 201) status_text = \"Created\";\n"
    out = out + "    else if (status == 204) status_text = \"No Content\";\n"
    out = out + "    else if (status == 304) status_text = \"Not Modified\";\n"
    out = out + "    else if (status == 400) status_text = \"Bad Request\";\n"
    out = out + "    else if (status == 401) status_text = \"Unauthorized\";\n"
    out = out + "    else if (status == 403) status_text = \"Forbidden\";\n"
    out = out + "    else if (status == 404) status_text = \"Not Found\";\n"
    out = out + "    else if (status == 500) status_text = \"Internal Error\";\n"
    out = out + "    else if (status == 503) status_text = \"Siege Mode Active\";\n"
    out = out + "\n"
    out = out + "    printf(\"  %s%-6s\\x1b[0m \\x1b[1;37m%-32s\\x1b[0m %s%d %-18s\\x1b[0m \\x1b[2;90m%.1f ms\\x1b[0m\\n\",\n"
    out = out + "        method_color, method_str, path_str, status_color, status, status_text, ms);\n"
    out = out + "}\n"
    out = out + "#endif\n"
    out = out + "\n"
    out = out + "int orbit_handle_request(orbit_socket_t client_sock, const char* raw_request, size_t raw_len, OrbitArena* arena, size_t* out_consumed) {\n"
    out = out + "    uint64_t start = orbit_rdtsc();\n"
    out = out + "    orbit_perf_start_request();\n"
    out = out + "\n"
    out = out + "    OrbitRequest* req = NULL;\n"
    out = out + "    size_t consumed = orbit_http_parse_request(arena, raw_request, raw_len, &req);\n"
    out = out + "    if (out_consumed) *out_consumed = consumed;\n"
    out = out + "    if (!req) return 1;\n"
    out = out + "\n"
    out = out + "    int keep_alive = 1;\n"
    out = out + "    if (strstr(raw_request, \"Connection: close\") || strstr(raw_request, \"connection: close\")) keep_alive = 0;\n"
    out = out + "\n"
    out = out + "#if ORBIT_KYNX_ACTIVE\n"
    out = out + "    extern OrbitKynxLease* orbit_kynx_lease_create_for_route(const char* path, const char* method, OrbitArena* arena);\n"
    out = out + "    extern void orbit_kynx_lease_destroy(OrbitKynxLease* lease);\n"
    out = out + "    OrbitKynxLease* lease = orbit_kynx_lease_create_for_route(req->path, req->method, arena);\n"
    out = out + "    if (lease && (lease->flags & 1)) {\n"
    out = out + "        OrbitResponse* res = orbit_response_create(arena, 503, \"text/plain\", \"503 Siege Mode Active - Non-critical Route Blocked\");\n"
    out = out + "        orbit_send_response(client_sock, res);\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + "        orbit_log_request_fmt(req->method, req->path, 503, start);\n"
    out = out + "#endif\n"
    out = out + "        orbit_kynx_lease_destroy(lease);\n"
    out = out + "        orbit_perf_end_request(start);\n"
    out = out + "        return 0;\n"
    out = out + "    }\n"
    out = out + "#endif\n"
    out = out + "        \n"
    out = out + "    if (req->path && strcmp(req->path, \"/_pulse\") == 0) {\n"
    out = out + "        OrbitResponse* res = orbit_response_create(arena, 200, \"text/html\", ORBIT_PULSE_DASHBOARD_HTML);\n"
    out = out + "        orbit_send_response(client_sock, res);\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + "        orbit_log_request_fmt(req->method, req->path, 200, start);\n"
    out = out + "#endif\n"
    out = out + "#if ORBIT_KYNX_ACTIVE\n"
    out = out + "        if (lease) orbit_kynx_lease_destroy(lease);\n"
    out = out + "#endif\n"
    out = out + "        orbit_perf_end_request(start);\n"
    out = out + "        return keep_alive;\n"
    out = out + "    }\n"
    out = out + "    if (req->path && strcmp(req->path, \"/_pulse/data\") == 0) {\n"
    out = out + "        orbit_string json = orbit_pulse_get_stats_json(arena);\n"
    out = out + "        OrbitResponse* res = orbit_response_json(arena, 200, json);\n"
    out = out + "        orbit_send_response(client_sock, res);\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + "        orbit_log_request_fmt(req->method, req->path, 200, start);\n"
    out = out + "#endif\n"
    out = out + "#if ORBIT_KYNX_ACTIVE\n"
    out = out + "        if (lease) orbit_kynx_lease_destroy(lease);\n"
    out = out + "#endif\n"
    out = out + "        orbit_perf_end_request(start);\n"
    out = out + "        return keep_alive;\n"
    out = out + "    }\n"
    out = out + "    uint64_t route_key = orbit_route_hash(req->method, req->path);\n"
    out = out + "    switch (route_key) {"
    return out
}

fn routerTailText() -> string {
    var out = ""
    out = out + "    default: {\n"
    out = out + "        OrbitResponse* res = orbit_response_create(arena, 404, \"text/plain\", \"Not Found\");\n"
    out = out + "        orbit_send_response(client_sock, res);\n"
    out = out + "#if ORBIT_LOGS_ACTIVE\n"
    out = out + "        orbit_log_request_fmt(req->method, req->path, 404, start);\n"
    out = out + "#endif\n"
    out = out + "#if ORBIT_KYNX_ACTIVE\n"
    out = out + "        if (lease) orbit_kynx_lease_destroy(lease);\n"
    out = out + "#endif\n"
    out = out + "        orbit_perf_end_request(start);\n"
    out = out + "        return keep_alive;\n"
    out = out + "    }\n"
    out = out + "    }\n"
    out = out + "    return keep_alive;\n"
    out = out + "}\n"
    out = out + "#endif\n"
    return out
}

fn serverMainText(hasDb: bool, boostPct: string) -> string {
    var out = ""
    out = out + "#ifdef _WIN32\n"
    out = out + "static unsigned __stdcall orbit_worker_loop(void* arg) {\n"
    out = out + "#else\n"
    out = out + "static void* orbit_worker_loop(void* arg) {\n"
    out = out + "#endif\n"
    out = out + "    OrbitWorkerCtx* ctx = (OrbitWorkerCtx*)arg;\n"
    out = out + "\n"
    out = out + "    /* Each thread owns its private arena — zero pool contention */\n"
    out = out + "    OrbitArena* thread_arena = orbit_arena_create(131072);\n"
    out = out + "\n"
    out = out + "    orbit_socket_t clients[512];\n"
    out = out + "    size_t buffered[512];\n"
    out = out + "    char* buffers[512];\n"
    out = out + "    int num_clients = 0;\n"
    out = out + "    \n"
    out = out + "    /* Thread-local pre-allocated buffer pool to eliminate malloc/free overhead */\n"
    out = out + "    char* buffer_pool = (char*)malloc(512 * 16384);\n"
    out = out + "    char* free_buffers[512];\n"
    out = out + "    for (int j = 0; j < 512; j++) {\n"
    out = out + "        free_buffers[j] = buffer_pool + j * 16384;\n"
    out = out + "    }\n"
    out = out + "    int free_buffers_count = 512;\n"
    out = out + "    while (1) {\n"
    out = out + "        fd_set readfds;\n"
    out = out + "        FD_ZERO(&readfds);\n"
    out = out + "        orbit_socket_t max_fd = 0;\n"
    out = out + "        FD_SET(ctx->wake_recv, &readfds);\n"
    out = out + "        if (ctx->wake_recv > max_fd) max_fd = ctx->wake_recv;\n"
    out = out + "\n"
    out = out + "        for (int i = 0; i < num_clients; i++) {\n"
    out = out + "            FD_SET(clients[i], &readfds);\n"
    out = out + "            if (clients[i] > max_fd) max_fd = clients[i];\n"
    out = out + "        }\n"
    out = out + "\n"
    out = out + "        /* Select timeout is bounded to 1s so an idle worker re-checks\n"
    out = out + "         * its accept queue even if a wake datagram is ever dropped. */\n"
    out = out + "        int _orbit_sel_s = 30;\n"
    out = out + "        if (_orbit_sel_s > 1) _orbit_sel_s = 1;\n"
    out = out + "        struct timeval tv = {_orbit_sel_s, 0};\n"
    out = out + "        int activity = select((int)max_fd + 1, &readfds, NULL, NULL, &tv);\n"
    out = out + "\n"
    out = out + "        if (activity < 0) {\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "            int err = WSAGetLastError();\n"
    out = out + "            if (err == WSAENOTSOCK) {\n"
    out = out + "                for (int i = 0; i < num_clients; ) {\n"
    out = out + "                    int optval;\n"
    out = out + "                    int optlen = sizeof(optval);\n"
    out = out + "                    if (getsockopt(clients[i], SOL_SOCKET, SO_TYPE, (char*)&optval, &optlen) == SOCKET_ERROR) {\n"
    out = out + "                        orbit_socket_close(clients[i]);\n"
    out = out + "                        free_buffers[free_buffers_count++] = buffers[i];\n"
    out = out + "                        clients[i] = clients[num_clients - 1];\n"
    out = out + "                        buffered[i] = buffered[num_clients - 1];\n"
    out = out + "                        buffers[i] = buffers[num_clients - 1];\n"
    out = out + "                        num_clients--;\n"
    out = out + "                    } else {\n"
    out = out + "                        i++;\n"
    out = out + "                    }\n"
    out = out + "                }\n"
    out = out + "            }\n"
    out = out + "#else\n"
    out = out + "            if (errno == EBADF || errno == ENOTSOCK) {\n"
    out = out + "                for (int i = 0; i < num_clients; ) {\n"
    out = out + "                    if (fcntl(clients[i], F_GETFD) == -1) {\n"
    out = out + "                        orbit_socket_close(clients[i]);\n"
    out = out + "                        free_buffers[free_buffers_count++] = buffers[i];\n"
    out = out + "                        clients[i] = clients[num_clients - 1];\n"
    out = out + "                        buffered[i] = buffered[num_clients - 1];\n"
    out = out + "                        buffers[i] = buffers[num_clients - 1];\n"
    out = out + "                        num_clients--;\n"
    out = out + "                    } else {\n"
    out = out + "                        i++;\n"
    out = out + "                    }\n"
    out = out + "                }\n"
    out = out + "            }\n"
    out = out + "#endif\n"
    out = out + "            continue;\n"
    out = out + "        }\n"
    out = out + "\n"
    out = out + "        if (FD_ISSET(ctx->wake_recv, &readfds)) {\n"
    out = out + "            orbit_wake_drain(ctx->wake_recv);\n"
    out = out + "        }\n"
    out = out + "\n"
    out = out + "        /* Adopt sockets pushed by the acceptor thread (lock-free SPSC). */\n"
    out = out + "        orbit_socket_t new_sock;\n"
    out = out + "        while (orbit_accept_q_pop(&ctx->q, &new_sock)) {\n"
    out = out + "            if (num_clients < 512 && free_buffers_count > 0) {\n"
    out = out + "                clients[num_clients] = new_sock;\n"
    out = out + "                buffered[num_clients] = 0;\n"
    out = out + "                buffers[num_clients] = free_buffers[--free_buffers_count];\n"
    out = out + "                num_clients++;\n"
    out = out + "            } else {\n"
    out = out + "                orbit_socket_close(new_sock);\n"
    out = out + "            }\n"
    out = out + "        }\n"
    out = out + "\n"
    out = out + "        for (int i = 0; i < num_clients; ) {\n"
    out = out + "            orbit_socket_t client_sock = clients[i];\n"
    out = out + "            int drop = 0;\n"
    out = out + "            \n"
    out = out + "            if (FD_ISSET(client_sock, &readfds)) {\n"
    out = out + "                int received = recv(client_sock, buffers[i] + buffered[i], 16384 - 1 - buffered[i], 0);\n"
    out = out + "                if (received == 0) {\n"
    out = out + "                    drop = 1;\n"
    out = out + "                } else if (received < 0) {\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "                    int err = WSAGetLastError();\n"
    out = out + "                    if (err != WSAEWOULDBLOCK) drop = 1;\n"
    out = out + "#else\n"
    out = out + "                    if (errno != EAGAIN && errno != EWOULDBLOCK) drop = 1;\n"
    out = out + "#endif\n"
    out = out + "                } else {\n"
    out = out + "                    buffered[i] += received;\n"
    out = out + "                    buffers[i][buffered[i]] = 0;\n"
    out = out + "                    \n"
    out = out + "                    int keep_alive = 1;\n"
    out = out + "                    size_t parsed = 0;\n"
    out = out + "                    while (parsed < buffered[i]) {\n"
    out = out + "    size_t consumed = 0;\n"
    out = out + "    orbit_arena_reset(thread_arena);\n"
    out = out + "    int keep = orbit_handle_request(client_sock, buffers[i] + parsed, buffered[i] - parsed, thread_arena, &consumed);\n"
    out = out + "    if (!keep) keep_alive = 0;\n"
    out = out + "    if (consumed == 0) break;\n"
    out = out + "    parsed += consumed;\n"
    out = out + "                    }\n"
    out = out + "                    \n"
    out = out + "                    if (parsed > 0) {\n"
    out = out + "                        memmove(buffers[i], buffers[i] + parsed, buffered[i] - parsed);\n"
    out = out + "                        buffered[i] -= parsed;\n"
    out = out + "                    }\n"
    out = out + "                    \n"
    out = out + "                    if (buffered[i] == 16384 - 1 || !keep_alive) {\n"
    out = out + "                        drop = 1;\n"
    out = out + "                    }\n"
    out = out + "                }\n"
    out = out + "            }\n"
    out = out + "            \n"
    out = out + "            if (drop) {\n"
    out = out + "                orbit_socket_close(client_sock);\n"
    out = out + "                free_buffers[free_buffers_count++] = buffers[i];\n"
    out = out + "                clients[i] = clients[num_clients - 1];\n"
    out = out + "                buffered[i] = buffered[num_clients - 1];\n"
    out = out + "                buffers[i] = buffers[num_clients - 1];\n"
    out = out + "                num_clients--;\n"
    out = out + "            } else {\n"
    out = out + "                i++;\n"
    out = out + "            }\n"
    out = out + "        }\n"
    out = out + "    }\n"
    out = out + "    free(buffer_pool);\n"
    out = out + "    orbit_arena_destroy(thread_arena);\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "    return 0;\n"
    out = out + "#else\n"
    out = out + "    return NULL;\n"
    out = out + "#endif\n"
    out = out + "}\n"
    out = out + "\n"
    out = out + "int main(int argc, char* argv[]) {\n"
    out = out + "    orbit_http_init();\n"
    if hasDb {
        out = out + "    orbit_db_init(\"orbit.db\");\n"
    } else {
        out = out + "    \n"
    }
    out = out + "    orbit_arena_pool_init(16, 131072);\n"
    out = out + "    orbit_string_pool_init(2048);\n"
    out = out + "\n"
    out = out + "    OrbitKynxConfig kynx_cfg = {\n"
    out = out + "        .pool_size       = 512,\n"
    out = out + "        .rate_limit      = 50,\n"
    out = out + "        .window_ms       = 1000,\n"
    out = out + "        .ban_threshold   = 200,\n"
    out = out + "        .score_increment = 10,\n"
    out = out + "        .score_decay     = 1,\n"
    out = out + "        .enabled         = true\n"
    out = out + "    };\n"
    out = out + "    orbit_kynx_init(kynx_cfg);\n"
    out = out + "\n"
    out = out + "    OrbitArena* startup_arena = orbit_arena_pool_acquire();\n"
    out = out + "    int _orbit_exit_code = orbit_main(startup_arena);\n"
    out = out + "    orbit_arena_pool_release(startup_arena);\n"
    out = out + "\n"
    out = out + "    int port = 3000;\n"
    out = out + "    if (argc > 1) {\n"
    out = out + "        port = atoi(argv[1]);\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    orbit_socket_t server_sock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);\n"
    out = out + "    if (server_sock == ORBIT_INVALID_SOCKET) {\n"
    out = out + "        printf(\"Failed to create socket\\n\");\n"
    out = out + "        return 1;\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    int reuse = 1;\n"
    out = out + "    setsockopt(server_sock, SOL_SOCKET, SO_REUSEADDR, (char*)&reuse, sizeof(reuse));\n"
    out = out + "    int nodelay = 1;\n"
    out = out + "    setsockopt(server_sock, IPPROTO_TCP, TCP_NODELAY, (char*)&nodelay, sizeof(nodelay));\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "    u_long mode = 1;\n"
    out = out + "    ioctlsocket(server_sock, FIONBIO, &mode);\n"
    out = out + "#else\n"
    out = out + "    int flags = fcntl(server_sock, F_GETFL, 0);\n"
    out = out + "    fcntl(server_sock, F_SETFL, flags | O_NONBLOCK);\n"
    out = out + "#endif\n"
    out = out + "    orbit_enable_reuseport(server_sock);\n"
    out = out + "\n"
    out = out + "    struct sockaddr_in server_addr;\n"
    out = out + "    server_addr.sin_family = AF_INET;\n"
    out = out + "    server_addr.sin_addr.s_addr = INADDR_ANY;\n"
    out = out + "    server_addr.sin_port = htons(port);\n"
    out = out + "\n"
    out = out + "    if (bind(server_sock, (struct sockaddr*)&server_addr, sizeof(server_addr)) == ORBIT_SOCKET_ERROR) {\n"
    out = out + "        printf(\"Bind failed\\n\");\n"
    out = out + "        orbit_socket_close(server_sock);\n"
    out = out + "        return 1;\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    if (listen(server_sock, SOMAXCONN) == ORBIT_SOCKET_ERROR) {\n"
    out = out + "        printf(\"Listen failed\\n\");\n"
    out = out + "        orbit_socket_close(server_sock);\n"
    out = out + "        return 1;\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "#ifdef _WIN32\n"
    out = out + "    HANDLE hOut = GetStdHandle(STD_OUTPUT_HANDLE);\n"
    out = out + "    if (hOut != INVALID_HANDLE_VALUE) {\n"
    out = out + "        DWORD dwMode = 0;\n"
    out = out + "        if (GetConsoleMode(hOut, &dwMode)) {\n"
    out = out + "            SetConsoleMode(hOut, dwMode | 0x0001 | 0x0004);\n"
    out = out + "        }\n"
    out = out + "        SetConsoleOutputCP(65001);\n"
    out = out + "    }\n"
    out = out + "#endif\n"
    out = out + "\n"
    out = out + "    int num_workers = 0;\n"
    out = out + "    if (num_workers <= 0) {\n"
    out = out + "        const char* _orbit_env_w = getenv(\"ORBIT_WORKERS\");\n"
    out = out + "        if (_orbit_env_w != NULL) {\n"
    out = out + "            int _orbit_env_n = atoi(_orbit_env_w);\n"
    out = out + "            if (_orbit_env_n > 0) num_workers = _orbit_env_n;\n"
    out = out + "        }\n"
    out = out + "    }\n"
    out = out + "    if (num_workers <= 0) num_workers = ORBIT_CPU_COUNT();\n"
    out = out + "    if (num_workers <= 0) num_workers = 1;\n"
    out = out + "    if (num_workers > 64) num_workers = 64;\n"
    out = out + "\n"
    out = out + "    orbit_render_server_banner(port, num_workers, kynx_cfg.enabled, " + boostPct + ");\n"
    out = out + "\n"
    out = out + "    orbit_thread_t* workers = (orbit_thread_t*)malloc(sizeof(orbit_thread_t) * (size_t)num_workers);\n"
    out = out + "    OrbitWorkerCtx* ctxs = (OrbitWorkerCtx*)malloc(sizeof(OrbitWorkerCtx) * (size_t)num_workers);\n"
    out = out + "\n"
    out = out + "    OrbitAcceptorCtx acceptor;\n"
    out = out + "    acceptor.server_sock = server_sock;\n"
    out = out + "    acceptor.num_workers = num_workers;\n"
    out = out + "    acceptor.wake_send = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);\n"
    out = out + "    if (acceptor.wake_send == ORBIT_INVALID_SOCKET) {\n"
    out = out + "        printf(\"Failed to create accept wake socket\\n\");\n"
    out = out + "        orbit_socket_close(server_sock);\n"
    out = out + "        return 1;\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    int _wake_ok = 1;\n"
    out = out + "    for (int i = 0; i < num_workers; i++) {\n"
    out = out + "        orbit_accept_q_init(&ctxs[i].q);\n"
    out = out + "        ctxs[i].thread_id = i;\n"
    out = out + "        ctxs[i].port      = port;\n"
    out = out + "        if (!orbit_wake_recv_create(&ctxs[i].wake_recv, &acceptor.wake_addr[i])) {\n"
    out = out + "            printf(\"Failed to create worker wake socket\\n\");\n"
    out = out + "            _wake_ok = 0;\n"
    out = out + "            break;\n"
    out = out + "        }\n"
    out = out + "        acceptor.queues[i] = &ctxs[i].q;\n"
    out = out + "    }\n"
    out = out + "    if (!_wake_ok) {\n"
    out = out + "        orbit_socket_close(acceptor.wake_send);\n"
    out = out + "        orbit_socket_close(server_sock);\n"
    out = out + "        return 1;\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    orbit_thread_t acceptor_thread;\n"
    out = out + "    ORBIT_THREAD_CREATE(acceptor_thread, orbit_acceptor_loop, &acceptor);\n"
    out = out + "\n"
    out = out + "    for (int i = 1; i < num_workers; i++) {\n"
    out = out + "        ORBIT_THREAD_CREATE(workers[i], orbit_worker_loop, &ctxs[i]);\n"
    out = out + "    }\n"
    out = out + "\n"
    out = out + "    orbit_worker_loop(&ctxs[0]);\n"
    out = out + "\n"
    out = out + "    orbit_kynx_cleanup();\n"
    out = out + "    orbit_arena_pool_cleanup();\n"
    out = out + "    orbit_string_pool_cleanup();\n"
    if hasDb {
        out = out + "    orbit_db_close();\n"
    } else {
        out = out + "    \n"
    }
    out = out + "    orbit_http_cleanup();\n"
    out = out + "    orbit_socket_close(server_sock);\n"
    out = out + "    return _orbit_exit_code;\n"
    out = out + "}\n"
    return out
}
