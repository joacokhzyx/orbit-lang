import "./token.orb"
// nextToken reports an invalid character through orbit_os_write_stderr_selfhost,
// which is declared in extern.orb. Nothing enforced that: an unresolved call is
// not a diagnostic, so a program importing the lexer without extern.orb -- the
// front end, which is how `orbit frontend` fixtures are built -- emitted C
// naming a function the C compiler had never heard of (F-0004).
import "./extern.orb"

val CHAR_SPACE = 32
val CHAR_TAB = 9
val CHAR_CR = 13
val CHAR_LF = 10
val CHAR_DQUOTE = 34
val CHAR_SLASH = 47
val CHAR_ASTERISK = 42
val CHAR_BACKSLASH = 92
val CHAR_DOT = 46
val CHAR_ZERO = 48
val CHAR_NINE = 57
val CHAR_A_UPPER = 65
val CHAR_Z_UPPER = 90
val CHAR_A_LOWER = 97
val CHAR_Z_LOWER = 122
val CHAR_UNDERSCORE = 95

model Lexer {
    source: string
    sourceLen: int
    pos: int
    line: int
    col: int
}

fn initLexer(source: string) -> Lexer {
    var startPos = 0
    if source.len() >= 3 {
        if orbit_string_char_at_selfhost(source, 0) == 239 && orbit_string_char_at_selfhost(source, 1) == 187 && orbit_string_char_at_selfhost(source, 2) == 191 {
            startPos = 3
        }
    }
    return Lexer(source, source.len(), startPos, 1, 1)
}

fn isWhitespace(c: int) -> bool {
    return c == 32 || c == 9 || c == 13 || c == 10
}

// A "${" anywhere in a string literal body turns it into an interpolation:
// "\${" is a backslash followed by an interpolation, not a literal "${".
// Deliberate, because the alternative is an escape nobody remembers and a
// second thing to explain. The scan below flags it while the token end is
// found, so no second pass over the literal is needed.

// Skip past a "${" hole while scanning an ordinary string. The hole can hold a
// string of its own, so the scan for the closing quote must not stop at the
// first quote it meets: without this, "${f("x")}" ended the literal at the
// quote before x and the rest of the line was reported as garbage.
fn isRadixDigit(c: int, radix: int) -> bool {
    if isDigit(c) {
        if radix == 2 { return c == 48 || c == 49 } // 0-1
        if radix == 8 { return c >= 48 && c <= 55 } // 0-7
        return true
    }
    if c >= 97 && c <= 102 { return radix == 16 } // 'a'-'f'
    if c >= 65 && c <= 70 { return radix == 16 } // 'A'-'F'
    return false
}

fn skipInterpHole(lexer: Lexer) {
    // Step past the "$" and the "{" so the first brace seen is a nested one.
    // Starting at the "$" instead would count the hole's own brace and never
    // match, running on through the rest of the file.
    advance(lexer)
    advance(lexer)
    var depth = 0
    while lexer.pos < lexer.sourceLen {
        val hc = peek(lexer)
        if hc == 34 || hc == 39 { // '"' '\''
            val quote = hc
            advance(lexer)
            var closed = false
            while lexer.pos < lexer.sourceLen && !closed {
                if peek(lexer) == 92 { // '\\'
                    advance(lexer)
                    advance(lexer)
                } else {
                    val q = peek(lexer)
                    advance(lexer)
                    if q == quote { closed = true }
                }
            }
        } else {
            if hc == 123 { depth = depth + 1 } // '{'
            if hc == 125 { // '}'
                if depth == 0 {
                    advance(lexer)
                    return
                }
                depth = depth - 1
            }
            advance(lexer)
        }
    }
}

fn isDigit(c: int) -> bool {
    return c >= 48 && c <= 57
}

fn isAlpha(c: int) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn isAlphaNumeric(c: int) -> bool {
    return isAlpha(c) || isDigit(c)
}

fn peek(lexer: Lexer) -> int {
    if lexer.pos >= lexer.sourceLen {
        return 0
    }
    return orbit_string_char_at_selfhost(lexer.source, lexer.pos)
}

fn peekNext(lexer: Lexer) -> int {
    if lexer.pos + 1 >= lexer.sourceLen {
        return 0
    }
    return orbit_string_char_at_selfhost(lexer.source, lexer.pos + 1)
}

fn advance(lexer: Lexer) -> int {
    if lexer.pos >= lexer.sourceLen {
        return 0
    }
    val c = orbit_string_char_at_selfhost(lexer.source, lexer.pos)
    lexer.pos = lexer.pos + 1
    if c == 10 {
        lexer.line = lexer.line + 1
        lexer.col = 1
    } else {
        lexer.col = lexer.col + 1
    }
    return c
}

fn skipWhitespaceAndComments(lexer: Lexer) {
    while lexer.pos < lexer.sourceLen {
        val c = peek(lexer)
        if isWhitespace(c) {
            advance(lexer)
        } else {
            if c == 47 { // '/'
                val next = peekNext(lexer)
                if next == 47 { // '//'
                    advance(lexer)
                    advance(lexer)
                    while lexer.pos < lexer.sourceLen && peek(lexer) != 10 {
                        advance(lexer)
                    }
                } else if next == 42 { // '/*'
                    advance(lexer)
                    advance(lexer)
                    var depth = 1
                    while lexer.pos < lexer.sourceLen && depth > 0 {
                        if peek(lexer) == 47 && peekNext(lexer) == 42 {
                            advance(lexer)
                            advance(lexer)
                            depth = depth + 1
                        } else if peek(lexer) == 42 && peekNext(lexer) == 47 {
                            advance(lexer)
                            advance(lexer)
                            depth = depth - 1
                        } else {
                            advance(lexer)
                        }
                    }
                } else {
                    break
                }
            } else {
                break
            }
        }
    }
}

// Keywords by (length, first character) dispatch: an identifier pays two
// integer compares plus the members of its own bucket, instead of walking
// all forty spellings through strcmp. Buckets hold one or two members and
// the compares are same-length strcmp, which is the fixed memcmp the length
// already paid for. Codes are plain ASCII ('A' is 65, 'a' is 97).
fn matchKeyword(text: string) -> TokType {
    val n = text.len()
    if n == 2 {
        val c0 = orbit_string_char_at_selfhost(text, 0)
        if c0 == 102 { // 'f'
            if text == "fn" { return TokType.KeywordFn }
        } else if c0 == 105 { // 'i'
            if text == "if" { return TokType.KeywordIf }
            if text == "in" { return TokType.KeywordIn }
        } else if c0 == 111 { // 'o'
            if text == "ok" { return TokType.KeywordOk }
        }
    } else if n == 3 {
        val c0 = orbit_string_char_at_selfhost(text, 0)
        if c0 == 71 { // 'G'
            if text == "GET" { return TokType.KeywordGet }
        } else if c0 == 80 { // 'P'
            if text == "PUT" { return TokType.KeywordPut }
        } else if c0 == 101 { // 'e'
            if text == "err" { return TokType.KeywordErr }
        } else if c0 == 118 { // 'v'
            if text == "val" { return TokType.KeywordVal }
            if text == "var" { return TokType.KeywordVar }
        } else if c0 == 109 { // 'm'
            if text == "mut" { return TokType.KeywordMut }
        } else if c0 == 117 { // 'u'
            if text == "use" { return TokType.KeywordUse }
        } else if c0 == 116 { // 't'
            if text == "try" { return TokType.KeywordTry }
        } else if c0 == 102 { // 'f'
            if text == "for" { return TokType.KeywordFor }
        }
    } else if n == 4 {
        val c0 = orbit_string_char_at_selfhost(text, 0)
        if c0 == 80 { // 'P'
            if text == "POST" { return TokType.KeywordPost }
        } else if c0 == 72 { // 'H'
            if text == "HEAD" { return TokType.KeywordHead }
        } else if c0 == 119 { // 'w'
            if text == "with" { return TokType.KeywordWith }
        } else if c0 == 108 { // 'l'
            if text == "loop" { return TokType.KeywordLoop }
        } else if c0 == 101 { // 'e'
            if text == "else" { return TokType.KeywordElse }
            if text == "enum" { return TokType.KeywordEnum }
        } else if c0 == 116 { // 't'
            if text == "type" { return TokType.KeywordType }
        } else if c0 == 105 { // 'i'
            if text == "impl" { return TokType.KeywordImpl }
        }
    } else if n == 5 {
        val c0 = orbit_string_char_at_selfhost(text, 0)
        if c0 == 109 { // 'm'
            if text == "model" { return TokType.KeywordModel }
            if text == "match" { return TokType.KeywordMatch }
        } else if c0 == 114 { // 'r'
            if text == "route" { return TokType.KeywordRoute }
        } else if c0 == 80 { // 'P'
            if text == "PATCH" { return TokType.KeywordPatch }
        } else if c0 == 97 { // 'a'
            if text == "async" { return TokType.KeywordAsync }
        } else if c0 == 119 { // 'w'
            if text == "while" { return TokType.KeywordWhile }
        } else if c0 == 98 { // 'b'
            if text == "break" { return TokType.KeywordBreak }
        } else if c0 == 117 { // 'u'
            if text == "union" { return TokType.KeywordUnion }
        } else if c0 == 116 { // 't'
            if text == "trait" { return TokType.KeywordTrait }
        } else if c0 == 101 { // 'e'
            if text == "every" { return TokType.KeywordEvery }
        } else if c0 == 99 { // 'c'
            if text == "const" { return TokType.KeywordConst }
            if text == "catch" { return TokType.KeywordCatch }
        }
    } else if n == 6 {
        val c0 = orbit_string_char_at_selfhost(text, 0)
        if c0 == 68 { // 'D'
            if text == "DELETE" { return TokType.KeywordDelete }
        } else if c0 == 114 { // 'r'
            if text == "return" { return TokType.KeywordReturn }
        } else if c0 == 105 { // 'i'
            if text == "import" { return TokType.KeywordImport }
        } else if c0 == 101 { // 'e'
            if text == "extern" { return TokType.KeywordExtern }
        }
    } else if n == 7 {
        val c0 = orbit_string_char_at_selfhost(text, 0)
        if c0 == 79 { // 'O'
            if text == "OPTIONS" { return TokType.KeywordOptions }
        } else if c0 == 112 { // 'p'
            if text == "private" { return TokType.KeywordPrivate }
        }
    } else if n == 8 {
        if text == "continue" { return TokType.KeywordContinue }
    }
    return TokType.Identifier
}

fn nextToken(lexer: Lexer) -> Token {
    skipWhitespaceAndComments(lexer)

    val start = lexer.pos
    val line = lexer.line
    val col = lexer.col

    val c = advance(lexer)
    if c == 0 {
        return Token(TokType.EOF, "", line, col, start, lexer.pos - start)
    }

    if isAlpha(c) {
        while isAlphaNumeric(peek(lexer)) {
            advance(lexer)
        }
        val textAlpha = orbit_string_slice_known_len(lexer.source, start, lexer.pos, lexer.sourceLen)
        val tagAlpha = matchKeyword(textAlpha)
        return Token(tagAlpha, textAlpha, line, col, start, lexer.pos - start)
    }

    if isDigit(c) {
        // 0x / 0X hexadecimal, so a mask or a colour is not written out in
        // decimal. Previously "0xFF" lexed as the integer 0 and left "xFF" to
        // be dropped, which compiled clean and then meant something else.
        if c == 48 {
            var radix = 0
            if peek(lexer) == 120 || peek(lexer) == 88 { radix = 16 } // 'x' 'X'
            if peek(lexer) == 98 || peek(lexer) == 66 { radix = 2 } // 'b' 'B'
            if peek(lexer) == 111 || peek(lexer) == 79 { radix = 8 } // 'o' 'O'
            if radix > 0 {
                // From the leading '0', not from the letter the cursor is on,
                // so the token keeps the prefix for the integer parser.
                val radixStart = start
                advance(lexer)
                // A '_' separator belongs to the literal, but only BETWEEN two
                // digits: `0xFF_FF` is one number and `0x_FF` is not. Decimal
                // literals already worked because their loop skipped any '_'
                // after a digit; a prefixed base needed the same rule, and
                // without it `0xFF_FF` was 0xFF followed by the name _FF.
                var radixDigits = 0
                var afterSeparator = false
                while lexer.pos < lexer.sourceLen {
                    val dc = peek(lexer)
                    if isRadixDigit(dc, radix) {
                        advance(lexer)
                        radixDigits = radixDigits + 1
                        afterSeparator = false
                    } else if dc == 95 && !afterSeparator && radixDigits > 0 {
                        advance(lexer)
                        afterSeparator = true
                    } else {
                        afterSeparator = false
                        break
                    }
                }
                if radixDigits > 0 {
                    return Token(TokType.IntegerLiteral, orbit_string_slice_known_len(lexer.source, radixStart, lexer.pos, lexer.sourceLen), line, col, start, lexer.pos - start)
                }
                // A bare "0" followed by something else is just the digit 0:
                // `0` then an identifier, which is a different program.
            }
        }
        var isFloat = false
        var lastWasDigit = true
        while isDigit(peek(lexer)) || (peek(lexer) == 95 && lastWasDigit) { // '_'
            lastWasDigit = isDigit(peek(lexer))
            advance(lexer)
        }
        if peek(lexer) == 46 { // '.'
            if isDigit(peekNext(lexer)) {
                isFloat = true
                advance(lexer) // '.'
                while isDigit(peek(lexer)) {
                    advance(lexer)
                }
            }
        }
        // An exponent belongs to the number: 2.5e3 was 2.5 followed by an
        // identifier, and 2.5E3 was 2.5 followed by what the type rules read as
        // a type name. Both were a parse error saying "Expected ')' after
        // arguments", which is no way to learn that the literal was the problem.
        // The token keeps the text and the C compiler evaluates the exponent,
        // which is the same path a plain 2.5 already takes.
        if peek(lexer) == 101 || peek(lexer) == 69 { // 'e' 'E'
            val mark = lexer.pos
            advance(lexer)
            if peek(lexer) == 43 || peek(lexer) == 45 { // '+' '-'
                advance(lexer)
            }
            var expDigits = 0
            while isDigit(peek(lexer)) {
                advance(lexer)
                expDigits = expDigits + 1
            }
            if expDigits == 0 {
                // Not an exponent after all: give the letters back so "2e" is
                // the number 2 followed by the name e, as it always was.
                lexer.pos = mark
            } else {
                isFloat = true
            }
        }
        val textDigit = orbit_string_slice_known_len(lexer.source, start, lexer.pos, lexer.sourceLen)
        var tagDigit = TokType.IntegerLiteral
        if isFloat {
            tagDigit = TokType.FloatLiteral
        }
        return Token(tagDigit, textDigit, line, col, start, lexer.pos - start)
    }

    // Raw string, triple-quoted like Python: """...""". Nothing inside is
    // escape-processed, which is what takes the escaping out of a JSON body:
    // every quote in {"status":"ok"} is just a quote, a Windows path needs no
    // doubling, and a newline inside the literal stays a newline in the value,
    // so a multi-line body can be written the way it is served.
    //
    // There are no escapes at all. The first """ after the opening one closes
    // the literal, exactly as Python does, so the only thing that cannot appear
    // inside is a literal """, which no JSON or prose needs. A single quote is
    // ordinary content: """a"b""" is a"b.
    if c == 34 { // '"'
        if peek(lexer) == 34 && peekNext(lexer) == 34 {
            advance(lexer)
            advance(lexer)
            val bodyStart = lexer.pos
            var scan = bodyStart
            var closed = false
            // Interpolation is flagged here, while the end of the literal is
            // searched, instead of rescanning the whole token afterwards.
            var sawInterpRaw = false
            while scan + 2 < lexer.sourceLen {
                if orbit_string_char_at_selfhost(lexer.source, scan) == 36 && orbit_string_char_at_selfhost(lexer.source, scan + 1) == 123 { // '$' '{'
                    sawInterpRaw = true
                }
                if orbit_string_char_at_selfhost(lexer.source, scan) == 34 {
                    if orbit_string_char_at_selfhost(lexer.source, scan + 1) == 34 {
                        if orbit_string_char_at_selfhost(lexer.source, scan + 2) == 34 {
                            lexer.pos = scan + 3
                            closed = true
                            break
                        }
                    }
                }
                scan = scan + 1
            }
            if !closed {
                // Unterminated: consume the rest and report it, rather than
                // silently treating the remainder of the file as a string.
                lexer.pos = lexer.sourceLen
            }
            // Newlines inside the literal still have to advance the counters or
            // every later token gets the wrong line.
            var nl = bodyStart
            while nl < lexer.pos {
                if orbit_string_char_at_selfhost(lexer.source, nl) == 10 { // '\n'
                    lexer.line = lexer.line + 1
                    lexer.col = 1
                } else {
                    lexer.col = lexer.col + 1
                }
                nl = nl + 1
            }
            val rawText = orbit_string_slice_known_len(lexer.source, start, lexer.pos, lexer.sourceLen)
            if closed {
                if sawInterpRaw {
                    return Token(TokType.InterpStringLiteral, rawText, line, col, start, lexer.pos - start)
                }
                return Token(TokType.RawStringLiteral, rawText, line, col, start, lexer.pos - start)
            }
            return Token(TokType.Invalid, rawText, line, col, start, lexer.pos - start)
        }

        // Interpolation is flagged where the hole is skipped, while the end
        // of the literal is found, instead of rescanning the token text.
        var sawInterp = false
        while lexer.pos < lexer.sourceLen && peek(lexer) != 34 {
            if peek(lexer) == 92 { // '\\'
                advance(lexer)
            }
            if peek(lexer) == 36 && peekNext(lexer) == 123 { // '$' '{'
                sawInterp = true
                // Already sitting on the closing brace; advancing again would
                // eat the quote that ends the literal.
                skipInterpHole(lexer)
                continue
            }
            advance(lexer)
        }
        if peek(lexer) == 34 {
            advance(lexer)
        }
        val textString = orbit_string_slice_known_len(lexer.source, start, lexer.pos, lexer.sourceLen)
        if sawInterp {
            return Token(TokType.InterpStringLiteral, textString, line, col, start, lexer.pos - start)
        }
        return Token(TokType.StringLiteral, textString, line, col, start, lexer.pos - start)
    }

    if c == 39 { // '\''
        if peek(lexer) == 92 { // '\''
            advance(lexer)
            if peek(lexer) == 110 || peek(lexer) == 116 || peek(lexer) == 114 || peek(lexer) == 48 || peek(lexer) == 92 || peek(lexer) == 39 || peek(lexer) == 34 {
                advance(lexer)
            }
        } else {
            if peek(lexer) != 39 && peek(lexer) != 0 {
                advance(lexer)
            }
        }
        if peek(lexer) == 39 {
            advance(lexer)
        }
        val textChar = orbit_string_slice_known_len(lexer.source, start, lexer.pos, lexer.sourceLen)
        return Token(TokType.CharLiteral, textChar, line, col, start, lexer.pos - start)
    }

    // Operators and delimiters
    if c == 123 { return Token(TokType.OpenBrace, "{", line, col, start, lexer.pos - start) }
    if c == 125 { return Token(TokType.CloseBrace, "}", line, col, start, lexer.pos - start) }
    if c == 40 { return Token(TokType.OpenParen, "(", line, col, start, lexer.pos - start) }
    if c == 41 { return Token(TokType.CloseParen, ")", line, col, start, lexer.pos - start) }
    if c == 91 { return Token(TokType.OpenBracket, "[", line, col, start, lexer.pos - start) }
    if c == 93 { return Token(TokType.CloseBracket, "]", line, col, start, lexer.pos - start) }
    if c == 44 { return Token(TokType.Comma, ",", line, col, start, lexer.pos - start) }
    if c == 58 { return Token(TokType.Colon, ":", line, col, start, lexer.pos - start) }
    if c == 46 {
        // `..` is one token, or `a..b` would lex as two member accesses and
        // parse as member-of-member with a confusing diagnostic. A `.`
        // followed by a digit never reaches here: the number branch above
        // already ate `1.5`, so `1..5` is `1`, `..`, `5`.
        if peek(lexer) == 46 {
            advance(lexer)
            return Token(TokType.DotDot, "..", line, col, start, lexer.pos - start)
        }
        return Token(TokType.Dot, ".", line, col, start, lexer.pos - start)
    }
    if c == 59 { return Token(TokType.SemiColon, ";", line, col, start, lexer.pos - start) }
    if c == 64 { return Token(TokType.At, "@", line, col, start, lexer.pos - start) }
    if c == 63 { return Token(TokType.Question, "?", line, col, start, lexer.pos - start) }

    if c == 43 { // '+'
        if peek(lexer) == 61 { // '+='
            advance(lexer)
            return Token(TokType.PlusEqual, "+=", line, col, start, lexer.pos - start)
        }
        return Token(TokType.Plus, "+", line, col, start, lexer.pos - start)
    }
    if c == 45 { // '-'
        if peek(lexer) == 62 { // '->'
            advance(lexer)
            return Token(TokType.Arrow, "->", line, col, start, lexer.pos - start)
        }
        if peek(lexer) == 61 { // '-='
            advance(lexer)
            return Token(TokType.MinusEqual, "-=", line, col, start, lexer.pos - start)
        }
        return Token(TokType.Minus, "-", line, col, start, lexer.pos - start)
    }
    if c == 42 { // '*'
        if peek(lexer) == 61 { // '*='
            advance(lexer)
            return Token(TokType.StarEqual, "*=", line, col, start, lexer.pos - start)
        }
        return Token(TokType.Asterisk, "*", line, col, start, lexer.pos - start)
    }
    if c == 47 { // '/'
        if peek(lexer) == 61 { // '/='
            advance(lexer)
            return Token(TokType.SlashEqual, "/=", line, col, start, lexer.pos - start)
        }
        return Token(TokType.Slash, "/", line, col, start, lexer.pos - start)
    }
    if c == 37 { // '%'
        if peek(lexer) == 61 { // '%='
            advance(lexer)
            return Token(TokType.PercentEqual, "%=", line, col, start, lexer.pos - start)
        }
        return Token(TokType.Percent, "%", line, col, start, lexer.pos - start)
    }

    if c == 61 { // '='
        if peek(lexer) == 61 { // '=='
            advance(lexer)
            return Token(TokType.DoubleEqual, "==", line, col, start, lexer.pos - start)
        }
        if peek(lexer) == 62 { // '=>'
            advance(lexer)
            return Token(TokType.FatArrow, "=>", line, col, start, lexer.pos - start)
        }
        return Token(TokType.Equal, "=", line, col, start, lexer.pos - start)
    }
    if c == 33 { // '!'
        if peek(lexer) == 61 { // '!='
            advance(lexer)
            return Token(TokType.NotEqual, "!=", line, col, start, lexer.pos - start)
        }
        return Token(TokType.Bang, "!", line, col, start, lexer.pos - start)
    }
    if c == 60 { // '<'
        if peek(lexer) == 61 { // '<='
            advance(lexer)
            return Token(TokType.LessEqual, "<=", line, col, start, lexer.pos - start)
        }
        if peek(lexer) == 60 { // '<<'
            advance(lexer)
            return Token(TokType.ShiftLeft, "<<", line, col, start, lexer.pos - start)
        }
        return Token(TokType.Less, "<", line, col, start, lexer.pos - start)
    }
    if c == 62 { // '>'
        if peek(lexer) == 61 { // '>='
            advance(lexer)
            return Token(TokType.GreaterEqual, ">=", line, col, start, lexer.pos - start)
        }
        if peek(lexer) == 62 { // '>>'
            advance(lexer)
            return Token(TokType.ShiftRight, ">>", line, col, start, lexer.pos - start)
        }
        return Token(TokType.Greater, ">", line, col, start, lexer.pos - start)
    }
    if c == 124 { // '|'
        if peek(lexer) == 124 { // '||'
            advance(lexer)
            return Token(TokType.DoublePipe, "||", line, col, start, lexer.pos - start)
        }
        return Token(TokType.Pipe, "|", line, col, start, lexer.pos - start)
    }
    if c == 38 { // '&'
        if peek(lexer) == 38 { // '&&'
            advance(lexer)
            return Token(TokType.DoubleAmpersand, "&&", line, col, start, lexer.pos - start)
        }
        return Token(TokType.Ampersand, "&", line, col, start, lexer.pos - start)
    }
    if c == 94 { // '^'
        return Token(TokType.Caret, "^", line, col, start, lexer.pos - start)
    }
    if c == 126 { // '~'
        return Token(TokType.Tilde, "~", line, col, start, lexer.pos - start)
    }

    // Default fallback
    val textFallback = orbit_string_slice_known_len(lexer.source, start, lexer.pos, lexer.sourceLen)
    orbit_os_write_stderr_selfhost("Lexer error: invalid character (code " + orbit_int_to_string_selfhost(c) + ")\n")
    return Token(TokType.Invalid, textFallback, line, col, start, lexer.pos - start)
}
