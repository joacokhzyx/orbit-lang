// Orbit self-hosting compiler entry point.
//
// Subcommands supported:
//   - `build <input.orb> [-o output.exe]`: Standard build driver.
//   - `run <input.orb>`: Build, then run it with inherited stdio.
//   - `check <input.orb>`: Parse and typecheck only, no code emitted.
//   - `frontend <input.orb> [-o output.tir]`: Executes self-hosted frontend pipeline and emits canonical TIR.
//   - `--help, -h` / `--version, -v`

import "./extern.orb"
import "./frontend/frontend.orb"
import "./pipeline.orb"

fn frontendOutputPath() -> string {
    var i = 2
    while true {
        val a = orbit_os_argv_selfhost(i)
        if a == "" { break }
        if a == "-o" {
            val next = orbit_os_argv_selfhost(i + 1)
            if next != "" { return next }
        }
        i = i + 1
    }
    return "orbit.tir"
}

fn runLexTrace() {
    val inputPath = orbit_os_argv_selfhost(2)
    val source = orbit_file_read_selfhost(inputPath)
    val lexer = initLexer(source)
    var i = 0
    while i < 2000 {
        val tok = nextToken(lexer)
        print(orbit_int_to_string_selfhost(i))
        print(orbit_int_to_string_selfhost(tok.line))
        print(orbit_int_to_string_selfhost(tok.col))
        print(orbit_int_to_string_selfhost(tok.tag))
        if tok.tag == TokType.EOF {
            break
        }
        i = i + 1
    }
}

fn runFrontend() {
    val inputPath = orbit_os_argv_selfhost(2)
    if inputPath == "" {
        print("Usage: orbit frontend <input.orb> [-o output.tir]")
        orbit_os_exit_selfhost(1)
        return
    }

    val source = orbit_file_read_selfhost(inputPath)
    if source == "" {
        print("Frontend failed: could not read input file: " + inputPath)
        orbit_os_exit_selfhost(1)
        return
    }

    val output = compileFrontendSource(inputPath, source)
    if output == "" {
        print("Frontend failed: no TIR emitted because diagnostics contain errors.")
        orbit_os_exit_selfhost(1)
        return
    }

    val outputPath = frontendOutputPath()
    if orbit_file_write_selfhost(outputPath, output) == false {
        print("Unable to write TIR output.")
        orbit_os_exit_selfhost(1)
        return
    }
}

fn printHelp() {
    print("Usage: orbit <command> [options]")
    print("")
    print("Commands:")
    print("  build <file.orb> [-o out]  Compile to a native executable")
    print("  run <file.orb>             Build and run it (shares your terminal)")
    print("  check <file.orb>           Parse and typecheck, no code emitted")
    print("  frontend <input.orb> [-o output.tir]")
    print("  lextrace <file.orb>")
    print("  --help, -h                 Show this help")
    print("  --version, -v              Show version")
}

fn runRun() {
    val inputPath = orbit_os_argv_selfhost(2)
    if inputPath == "" {
        print("Usage: orbit run <file.orb>")
        orbit_os_exit_selfhost(2)
        return
    }
    val source = orbit_file_read_selfhost(inputPath)
    if source == "" {
        print("Error: Could not read input file: " + inputPath)
        orbit_os_exit_selfhost(1)
        return
    }
    var outputPath = inputPath + ".run"
    val osName = orbit_os_env_selfhost("OS")
    val winDir = orbit_os_env_selfhost("WINDIR")
    if osName == "Windows_NT" || winDir != "" {
        outputPath = outputPath + ".exe"
    }
    if compileSourceWithFile(source, inputPath, outputPath) == false {
        orbit_os_exit_selfhost(1)
        return
    }
    val code = orbit_os_spawn_selfhost("\"" + outputPath + "\"")
    orbit_os_exit_selfhost(code)
}

fn runCheck() {
    val inputPath = orbit_os_argv_selfhost(2)
    if inputPath == "" {
        print("Usage: orbit check <file.orb>")
        orbit_os_exit_selfhost(2)
        return
    }
    val source = orbit_file_read_selfhost(inputPath)
    if source == "" {
        print("Error: Could not read input file: " + inputPath)
        orbit_os_exit_selfhost(1)
        return
    }
    if checkSourceWithFile(source, inputPath) == false {
        orbit_os_exit_selfhost(1)
        return
    }
    print("Checked " + inputPath + ": no errors.")
}

fn main() {
    val cmd = orbit_os_argv_selfhost(1)
    if cmd == "--help" || cmd == "-h" {
        printHelp()
        return
    }
    if cmd == "--version" || cmd == "-v" {
        print("orbit 0.1.0-rc.2")
        return
    }
    if cmd == "run" {
        runRun()
        return
    }
    if cmd == "check" {
        runCheck()
        return
    }
    var outputPath = ""
    var inputPath = ""
    var i = 1
    while true {
        val arg = orbit_os_argv_selfhost(i)
        if arg == "" { break }

        if arg == "frontend" {
            runFrontend()
            return
        }

        if arg == "lextrace" {
            runLexTrace()
            return
        }

        if arg == "-o" {
            val nextArg = orbit_os_argv_selfhost(i + 1)
            if nextArg != "" {
                outputPath = nextArg
                i = i + 1
            }
        } else {
            if arg != "build" && inputPath == "" {
                inputPath = arg
            }
        }
        i = i + 1
    }

    if inputPath == "" {
        print("Error: No input file specified.")
        orbit_os_exit_selfhost(1)
        return
    }

    if outputPath == "" {
        outputPath = inputPath + ".c"
    }

    val source = orbit_file_read_selfhost(inputPath)
    if source == "" {
        print("Error: Could not read input file: " + inputPath)
        orbit_os_exit_selfhost(1)
        return
    }

    if compileSourceWithFile(source, inputPath, outputPath) == false {
        orbit_os_exit_selfhost(1)
    }
}

