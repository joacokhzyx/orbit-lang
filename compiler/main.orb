// Orbit self-hosting compiler entry point.
//
// Subcommands supported:
//   - `frontend <input.orb> [-o output.tir]`: Executes self-hosted frontend pipeline and emits canonical TIR.
//   - `bootstrap [--stage=N]`: Orchestrates stage promotion (Stage 0 -> Stage 1 -> Stage 2 -> Stage 3).
//   - `build <input.orb> [-o output.exe]`: Standard build driver.

import "./extern.orb"
import "./frontend/frontend.orb"
import "./pipeline.orb"

fn frontendOutputPath() -> string {
    var i = 2
    while true {
        val a = orbit_os_argv_selfhost(i)
        if a == "" { break }
        if a == "-o" {
            val next = orbit_os_argv_selfhost(i + 1)
            if next != "" { return next }
        }
        i = i + 1
    }
    return "orbit.tir"
}

fn runLexTrace() {
    val inputPath = orbit_os_argv_selfhost(2)
    val source = orbit_file_read_selfhost(inputPath)
    val lexer = initLexer(source)
    var i = 0
    while i < 2000 {
        val tok = nextToken(lexer)
        print(orbit_int_to_string_selfhost(i))
        print(orbit_int_to_string_selfhost(tok.line))
        print(orbit_int_to_string_selfhost(tok.col))
        print(orbit_int_to_string_selfhost(tok.tag))
        if tok.tag == TokType.EOF {
            break
        }
        i = i + 1
    }
}

fn runFrontend() {
    val inputPath = orbit_os_argv_selfhost(2)
    if inputPath == "" {
        print("Usage: orbit frontend <input.orb> [-o output.tir]")
        orbit_os_exit_selfhost(1)
        return
    }

    val source = orbit_file_read_selfhost(inputPath)
    if source == "" {
        print("Frontend failed: could not read input file: " + inputPath)
        orbit_os_exit_selfhost(1)
        return
    }

    val output = compileFrontendSource(inputPath, source)
    if output == "" {
        print("Frontend failed: no TIR emitted because diagnostics contain errors.")
        orbit_os_exit_selfhost(1)
        return
    }

    val outputPath = frontendOutputPath()
    if orbit_file_write_selfhost(outputPath, output) == false {
        print("Unable to write TIR output.")
        orbit_os_exit_selfhost(1)
        return
    }
}

fn runBootstrap() {
    var hostCompiler = orbit_os_env_selfhost("ORBIT_HOST_COMPILER")
    if hostCompiler == "" {
        hostCompiler = "orbit.exe"
    }

    val stage1Cmd = "\"" + hostCompiler + "\" build \"compiler/main.orb\" -o \"zig-out/stage1_orbit.exe\" --backend=steel"
    val s1Out = orbit_os_exec_selfhost(stage1Cmd)
    print(s1Out)
    if s1Out.indexOf("FAILED") != -1 || s1Out.indexOf("error:") != -1 || s1Out.indexOf("Error:") != -1 {
        print("[bootstrap] Stage 1 build FAILED")
        orbit_os_exit_selfhost(1)
        return
    }

    val stage2Cmd = "\"zig-out/stage1_orbit.exe\" build \"compiler/main.orb\" -o \"zig-out/stage2_orbit.exe\" --backend=steel"
    val s2Out = orbit_os_exec_selfhost(stage2Cmd)
    print(s2Out)
    if s2Out.indexOf("FAILED") != -1 || s2Out.indexOf("error:") != -1 || s2Out.indexOf("Error:") != -1 {
        print("[bootstrap] Stage 2 build FAILED")
        orbit_os_exit_selfhost(1)
        return
    }

    val stage3Cmd = "\"zig-out/stage2_orbit.exe\" build \"compiler/main.orb\" -o \"zig-out/stage3_orbit.exe\" --backend=steel"
    val s3Out = orbit_os_exec_selfhost(stage3Cmd)
    print(s3Out)
    if s3Out.indexOf("FAILED") != -1 || s3Out.indexOf("error:") != -1 || s3Out.indexOf("Error:") != -1 {
        print("[bootstrap] Stage 3 build FAILED")
        orbit_os_exit_selfhost(1)
        return
    }
}

fn main() {
    var outputPath = ""
    var inputPath = ""
    var i = 1
    while true {
        val arg = orbit_os_argv_selfhost(i)
        if arg == "" { break }

        if arg == "frontend" {
            runFrontend()
            return
        }

        if arg == "lextrace" {
            runLexTrace()
            return
        }

        if arg == "bootstrap" {
            runBootstrap()
            return
        }

        if arg == "-o" {
            val nextArg = orbit_os_argv_selfhost(i + 1)
            if nextArg != "" {
                outputPath = nextArg
                i = i + 1
            }
        } else {
            if arg != "build" && inputPath == "" {
                inputPath = arg
            }
        }
        i = i + 1
    }

    if inputPath == "" {
        print("Error: No input file specified.")
        orbit_os_exit_selfhost(1)
        return
    }

    if outputPath == "" {
        outputPath = inputPath + ".c"
    }

    val source = orbit_file_read_selfhost(inputPath)
    if source == "" {
        print("Error: Could not read input file: " + inputPath)
        orbit_os_exit_selfhost(1)
        return
    }

    if compileSourceWithFile(source, inputPath, outputPath) == false {
        orbit_os_exit_selfhost(1)
    }
}

