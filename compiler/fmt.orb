// Orbit Self-Hosted Compiler - Code Formatter Engine
// compiler/fmt.orb

model FormatterOptions {
    indent_size: int
    check_only: bool
    show_diff: bool
}

fn trimString(s: string) -> string {
    var start = 0
    var end = s.len()
    while start < end {
        val c = s.slice(start, start + 1)
        if c == " " || c == "\t" || c == "\r" || c == "\n" {
            start = start + 1
        } else {
            break
        }
    }
    while end > start {
        val c = s.slice(end - 1, end)
        if c == " " || c == "\t" || c == "\r" || c == "\n" {
            end = end - 1
        } else {
            break
        }
    }
    return s.slice(start, end)
}

fn createDefaultOptions() -> FormatterOptions {
    return FormatterOptions(4, false, false)
}

fn formatLine(line_content: string, indent_level: int, indent_size: int) -> string {
    val trimmed = trimString(line_content)
    if (trimmed == "") {
        return ""
    }
    var prefix = ""
    val total_spaces = indent_level * indent_size
    var i = 0
    while (i < total_spaces) {
        prefix = prefix + " "
        i = i + 1
    }
    return prefix + trimmed
}

fn isFormatted(original_source: string, formatted_source: string) -> bool {
    return original_source == formatted_source
}

