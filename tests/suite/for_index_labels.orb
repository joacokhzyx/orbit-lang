// Indexed iteration and loop labels. `for x, i in xs` binds the position
// alongside the element, and `for outer: x in xs` names the loop so a
// `break outer` (or `continue outer`) inside any nesting hits it. A plain
// `continue` in a `for` used to jump to the loop top without incrementing
// and hang; the loop's continue target is now its increment.
fn index_binding() -> int {
    var sum = 0
    var seen = ""
    for x, i in [10, 20, 30] {
        sum = sum + i
        seen = seen + x
    }
    if sum != 3 { return 1 }
    if seen != "102030" { return 2 }
    return 0
}

fn break_outer() -> int {
    var hits = 0
    for outer: x in [1, 2, 3] {
        for y in [4, 5, 6] {
            hits = hits + 1
            if y == 5 { break outer }
        }
    }
    if hits != 2 { return 1 }
    return 0
}

fn continue_outer() -> int {
    var total = 0
    for outer: x in [1, 2, 3] {
        for y in [1, 2] {
            if y == 1 { continue outer }
            total = total + 1
        }
    }
    if total != 0 { return 1 }
    return 0
}

fn break_outer_through_while() -> int {
    var n = 0
    for outer: x in [1, 2, 3] {
        var k = 0
        while k < 5 {
            k = k + 1
            n = n + 1
            if k == 2 { break outer }
        }
    }
    if n != 2 { return 1 }
    return 0
}

fn plain_continue_terminates() -> int {
    var n = 0
    for x in [1, 2, 3] {
        n = n + 1
        if x == 2 { continue }
    }
    if n != 3 { return 1 }
    return 0
}

fn main() -> int {
    if index_binding() != 0 { return 1 }
    if break_outer() != 0 { return 2 }
    if continue_outer() != 0 { return 3 }
    if break_outer_through_while() != 0 { return 4 }
    if plain_continue_terminates() != 0 { return 5 }
    return 0
}
