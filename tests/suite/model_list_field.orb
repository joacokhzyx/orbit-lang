// A model with a list field: push through the field, read by index, iterate,
// and pass the model on to a function that sums the list.
model Bucket {
    name: string
    items: list < int >
}

fn fill(b: Bucket, n: int) {
    for i in 0..n {
        b.items.push(i * i)
    }
}

fn total(b: Bucket) -> int {
    var s = 0
    for v in b.items {
        s = s + v
    }
    return s
}

fn main() -> int {
    val b = Bucket { name: "squares", items: [] }
    fill(b, 5)
    if b.items.len() != 5 { return 1 }
    if b.items.get(3) != 9 { return 2 }
    if total(b) != 30 { return 3 }
    val c = Bucket { name: "seed", items: [100, 200] }
    fill(c, 3)
    if c.items.len() != 5 { return 4 }
    if total(c) != 305 { return 5 }
    if b.name != "squares" { return 6 }
    return 0
}
