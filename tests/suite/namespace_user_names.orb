// expect-exit 0
// The rejected names are exact: `strcat` and `FILE` collide with declarations
// the generated translation unit already has, and a user name that only
// contains one does not. This is the accepted half of the namespace cases.
model MyFile {
    path: string
    bytes: int
}

fn user_strcat(a: string, b: string) -> string {
    return a + b
}

fn main() -> int {
    val f = MyFile { path: user_strcat("/tmp/", "notes.txt"), bytes: 11 }
    if f.path != "/tmp/notes.txt" {
        return 1
    }
    if f.bytes != 11 {
        return 1
    }
    print(f.path)
    return 0
}
