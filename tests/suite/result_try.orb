// expect-exit 0
fn make_success() -> result {
    val value: result = ok(41)
    return value
}

fn read_success() -> result {
    val value: int = try make_success()
    return make_success()
}

fn main() -> int {
    val r: result = read_success()
    val value: int = try r catch {
        return 1
    }
    if value != 41 { return 2 }
    return 0
}
