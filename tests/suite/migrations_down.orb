// `migrations down` undoes its forward migration: ORBIT_MIGRATE_DOWN=<version>
// rolls back every applied version above it, newest first, and stops there, so
// the next run applies the forward set again. runtime/test_migrations.c owns
// the semantics; this pins the parse, the IR field and the emitted call.
migrations "CREATE TABLE IF NOT EXISTS md_down_probe (x INTEGER)"
migrations down "DROP TABLE IF EXISTS md_down_probe"

fn main() -> int {
    print("migrations down parsed")
    return 0
}
