// An int is 32 bits and wraps silently (docs/LANGUAGE_REFERENCE.md). The
// operands come through parameters so no constant folding hides the wrap.
fn add(a: int, b: int) -> int { return a + b }
fn sub(a: int, b: int) -> int { return a - b }
fn mul(a: int, b: int) -> int { return a * b }

fn main() -> int {
    if add(2147483647, 1) != -2147483648 { return 1 }
    if sub(-2147483648, 1) != 2147483647 { return 2 }
    if mul(46341, 46341) != -2147479015 { return 3 }
    if mul(65536, 65536) != 0 { return 4 }
    if add(2147483647, 2147483647) != -2 { return 5 }
    var h = 17
    for i in 0..40 {
        h = h * 31 + i
    }
    if h != 749851429 { return 6 }
    return 0
}
