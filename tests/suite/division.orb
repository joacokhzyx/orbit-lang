// Division and remainder that have an answer.
//
// Both `/` and `%` used to be emitted straight into the C, so a literal zero
// divisor reached the hardware and the process died: SIGFPE, exit 136, nothing
// on either stream. Not a wrong answer and not a message -- a crash, which is
// why the frontend fuzzer never saw it. A crash is an event, and that fuzzer
// only looks at programs that exit.

fn ordinary() -> int {
    if 7 / 2 != 3 { return 1 }
    if 7 % 2 != 1 { return 2 }
    if 7 / 1 != 7 { return 3 }
    if 0 - 7 / 2 != -3 { return 4 }
    return 0
}

// A divisor that is a variable is not decidable while compiling, and must keep
// working: the guard for that lives in the emitted C, not here.
fn through_a_variable() -> int {
    val d = 2
    if 7 / d != 3 { return 1 }
    val e = -1
    if 7 / e != -7 { return 2 }
    return 0
}

fn as_float() -> int {
    if 7.0 / 2.0 != 3.5 { return 1 }
    return 0
}

fn main() -> int {
    if ordinary() != 0 { return 1 }
    if through_a_variable() != 0 { return 2 }
    if as_float() != 0 { return 3 }
    return 0
}
