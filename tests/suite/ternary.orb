// `cond ? a: b` is sugar over an `if` used as a value, in the same IfNode
// with single-expression branches. It binds looser than every binary
// operator and nests to the right, and branch typing is the `if`-value rule.
fn picks_true_branch() -> int {
    val y = true ? 1: 2
    if y != 1 { return 1 }
    return 0
}

fn picks_false_branch() -> int {
    val y = false ? 1: 2
    if y != 2 { return 1 }
    return 0
}

fn condition_is_a_full_expression() -> int {
    val y = 1 + 1 == 2 ? 10: 20
    if y != 10 { return 1 }
    return 0
}

fn nests_to_the_right() -> int {
    val y = false ? 1: true ? 2: 3
    if y != 2 { return 1 }
    return 0
}

fn works_in_return_position() -> int {
    return true ? 7: 8
}

fn main() -> int {
    if picks_true_branch() != 0 { return 1 }
    if picks_false_branch() != 0 { return 2 }
    if condition_is_a_full_expression() != 0 { return 3 }
    if nests_to_the_right() != 0 { return 4 }
    if works_in_return_position() != 7 { return 5 }
    return 0
}
