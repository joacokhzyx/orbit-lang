// Member resolution: a closed member set is checked, and a member call is
// checked against the set the builder lowers.
//
// Every case in the first half is a member that cannot exist and is now a
// diagnostic instead of a C step that dies with "unknown type name". Every
// case in the second half is a member that does exist, and the point of the
// test is that none of them changed: a check that rejects valid code is worse
// than no check, because it teaches the reader that the compiler is guessing.
model Point {
    x: int
    y: int
}

enum Color { Red Green Blue }

union Shape { Circle(int) Square(int) }

fn area(s: Shape) -> int {
    match s {
        Shape.Circle(r) => { return r * r }
        Shape.Square(a) => { return a * a }
    }
}

// A member call that names a declared function is that function with the
// receiver as its first argument; the builder's default method path does the
// same. The check in the next function must not refuse it.
fn double(x: list < int >) -> int {
    var s = 0
    var i = 0
    while i < x.len() {
        s = s + x.get(i) * 2
        i = i + 1
    }
    return s
}

fn main() -> int {
    // A model: declared fields, and only those.
    val p = Point(3, 4)
    print(p.x)
    print(p.y)

    // An enum: declared variants, and only those.
    val c = Color.Green
    match c {
        Color.Red => { print(1) }
        Color.Green => { print(2) }
        Color.Blue => { print(3) }
    }

    // A union: a variant read by matching, which is how a payload is read.
    print(area(Shape.Circle(5)))
    print(area(Shape.Square(6)))

    // The member surfaces the checker enumerates: string, list and the system
    // builtins answer to the names the builder lowers, so these calls are the
    // positive half of that rule and n111 pins the negative.
    val xs = [1, 2, 3]
    print(xs.len())
    print(xs.get(0))
    // A member name that is a declared function is a call of it, with the
    // receiver first; the member set is silent on it.
    if xs.double() != 12 { return 1 }
    val s = "hi"
    print(s.length)
    print(system.uptime() >= 0)

    // Each receiver answers its own set. These are the names the sets accept,
    // and the program builds only if none of them is refused.
    val digits = "12"
    if digits.indexOf("2") != 1 { return 2 }
    if digits.slice(0, 1) != "1" { return 3 }
    if digits.at(0) != 49 { return 4 }
    val ys = [4, 5, 6]
    if ys.at(2) != 6 { return 5 }
    ys.set(0, 9)
    print(ys.pop())
    if ys.len() != 2 { return 6 }
    return 0
}
