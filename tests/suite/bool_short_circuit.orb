// `&&` and `||` evaluate the right operand only when the left one does not
// decide the result. Both operands were evaluated first, so a guard such as
// `j >= 0 && xs.get(j) > key` read the list at -1 and a call on the right
// side ran for its effect.
model Counter {
    n: int
}

fn bump(c: Counter) -> bool {
    c.n = c.n + 1
    return true
}

fn guarded(xs: list < int >, j: int, key: int) -> bool {
    return j >= 0 && xs.get(j) > key
}

fn main() -> int {
    val xs: list < int > = [5, 7]
    if guarded(xs, -1, 3) { return 1 }
    if guarded(xs, 0, 3) == false { return 2 }
    if guarded(xs, 1, 9) { return 3 }

    val c = Counter(0)
    val a = false && bump(c)
    if a { return 4 }
    if c.n != 0 { return 5 }
    val b = true || bump(c)
    if b == false { return 6 }
    if c.n != 0 { return 7 }
    val d = true && bump(c)
    if d == false { return 8 }
    if c.n != 1 { return 9 }
    val e = false || bump(c)
    if e == false { return 10 }
    if c.n != 2 { return 11 }

    var i = 0
    while i < xs.len() && xs.get(i) < 7 {
        i = i + 1
    }
    if i != 1 { return 12 }
    return 0
}
