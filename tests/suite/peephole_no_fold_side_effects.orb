// Wave 0 STAB: dead calls with effects must survive DCE, and folded
// constants must not cross control-flow barriers. hasSideEffects now
// covers db_*, http_response, alloc, fields, switch, result and union
// opcodes; propagation stops at label/jump/call/ret.
//
// Honest scope of exit-code testing: used reads assert exact values
// (a wrong fold or a wrongful deletion breaks them); dead reads
// (ghost, missing) pin that the shapes compile and run while the veto
// itself lives in hasSideEffects plus review. Barrier shapes pin that
// branched computation still lands on the right value.
model Item {
    id: string
}

fn idnum(x: int) -> int {
    return x
}

fn main() -> int {
    val ghost = Item.all()
    val missing = Item.where("id = ?", "nope")
    if ghost.len() != missing.len() { return 1 }
    val nums = [1, 2, 3]
    nums.push(4)
    if nums.len() != 4 { return 2 }
    var v = 0
    if 1 == 1 {
        v = idnum(41)
    } else {
        v = 99
    }
    if v != 41 { return 3 }
    return 0
}
