// M6 contract tests: full file round-trip in the working directory
// (unique name, removed at the end). Reads return results consumed
// with inline try on the call.
import "std/fs/file.orb"
import "std/test/assert.orb"

fn main() -> int {
    val path = "w2_fs_probe.txt"
    if exists(path) {
        removeFile(path)
    }
    if writeAll(path, "hello") == false { return 1 }
    if assertTrue(exists(path)) == false { return 2 }
    val first: string = try readAll(path) catch { return 3 }
    if assertEqStr(first, "hello") == false { return 4 }
    if append(path, " world") == false { return 5 }
    val second: string = try readAll(path) catch { return 6 }
    if assertEqStr(second, "hello world") == false { return 7 }
    val names = listDir(".")
    if assertTrue(names.len() >= 1) == false { return 8 }
    if removeFile(path) == false { return 9 }
    if exists(path) { return 10 }
    return 0
}
