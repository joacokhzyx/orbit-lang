// M6 contract tests: full file round-trip in the working directory
// (unique name, removed at the end), plus mkdir -p, isDir, walk, and
// empty-dir removal with bottom-up teardown. Reads return results
// consumed with inline try on the call. Directory order from listDir is
// unspecified, so walk asserts length plus membership, never order.
import "std/fs/file.orb"
import "std/collections/lists.orb"
import "std/test/assert.orb"

fn main() -> int {
    val path = "w2_fs_probe.txt"
    if exists(path) {
        removeFile(path)
    }
    if writeAll(path, "hello") == false { return 1 }
    if assertTrue(exists(path)) == false { return 2 }
    val first: string = try readAll(path) catch { return 3 }
    if assertEqStr(first, "hello") == false { return 4 }
    if append(path, " world") == false { return 5 }
    val second: string = try readAll(path) catch { return 6 }
    if assertEqStr(second, "hello world") == false { return 7 }
    val names = listDir(".")
    if assertTrue(names.len() >= 1) == false { return 8 }
    if removeFile(path) == false { return 9 }
    if exists(path) { return 10 }
    val root = "w3_fs_walk"
    if mkdirAll(root + "/a/b") == false { return 11 }
    if assertTrue(isDir(root + "/a/b")) == false { return 12 }
    if mkdirAll(root + "/a/b") == false { return 13 }
    if isDir(path) { return 14 }
    if writeAll(root + "/top.txt", "t") == false { return 15 }
    if writeAll(root + "/a/mid.txt", "m") == false { return 16 }
    if writeAll(root + "/a/b/deep.txt", "d") == false { return 17 }
    val found = walk(root)
    if assertEqInt(found.len(), 5) == false { return 18 }
    if assertTrue(listContains(found, root + "/a")) == false { return 19 }
    if assertTrue(listContains(found, root + "/a/b")) == false { return 20 }
    if assertTrue(listContains(found, root + "/top.txt")) == false { return 21 }
    if assertTrue(listContains(found, root + "/a/mid.txt")) == false { return 22 }
    if assertTrue(listContains(found, root + "/a/b/deep.txt")) == false { return 23 }
    val single = walk(root + "/top.txt")
    if assertEqInt(single.len(), 1) == false { return 24 }
    if assertEqStr(single.get(0), root + "/top.txt") == false { return 25 }
    val missing = walk("w3_fs_missing_xyz")
    if assertEqInt(missing.len(), 0) == false { return 26 }
    if removeDir(root + "/a") { return 27 }
    if removeDir("w3_fs_missing_xyz") { return 28 }
    if mkdirAll("") { return 29 }
    if removeFile(root + "/top.txt") == false { return 30 }
    if removeFile(root + "/a/mid.txt") == false { return 31 }
    if removeFile(root + "/a/b/deep.txt") == false { return 32 }
    if removeDir(root + "/a/b") == false { return 33 }
    if removeDir(root + "/a") == false { return 34 }
    if removeDir(root) == false { return 35 }
    if exists(root) { return 36 }
    return 0
}
