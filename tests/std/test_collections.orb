// M5 contract tests: string-list helpers plus int search. Maps are
// out of scope (method lowering targets lists today).
//
// KNOWN FALSE PASS -- checks 10 and 11 below (containsInt / indexOfInt
// on `nums`) do not test what they appear to. They pass only because
// orbit_list_push stores the raw integer, so `l.get(i) == v` really is
// `20 == 20`. Two verified demonstrations of what is not covered:
//
//   1. A list of boxed values answers wrong, silently. The element is
//      then a pointer, and the pointer is compared to the needle:
//        var inner = []  inner.push("x")
//        var outer = []  outer.push(inner)
//        indexOfStr(outer, "x")   ->  -1, and it should be 0
//
//   2. getOr is declared `-> string` and calls `l.get(i)`. On an int
//      list that hands an int back where a string is declared:
//        getOr(nums, 0, "d")      ->  Segmentation fault (core dumped)
//
// So the int coverage here is a property of push/get, not of this
// module, and the module has no element type to make the difference
// visible. Root cause is F-0002 extended by F-0009 (no element type at
// all) and it is the compiler's to fix, not this test's. The
// string-list checks 1-9 and 12-13 are sound and are the real coverage
// of lists.orb.
import "std/collections/lists.orb"
import "std/test/assert.orb"

fn main() -> int {
    val words = split_words()
    if assertEqStr(getOr(words, 0, "d"), "a") == false { return 1 }
    if assertEqStr(getOr(words, 9, "d"), "d") == false { return 2 }
    if assertEqStr(getOr(words, -1, "d"), "d") == false { return 3 }
    if assertEqStr(firstOr(words, "d"), "a") == false { return 4 }
    if assertEqStr(lastOr(words, "d"), "c") == false { return 5 }
    if assertTrue(containsStr(words, "b")) == false { return 6 }
    if assertTrue(containsStr(words, "z")) { return 7 }
    if assertEqInt(indexOfStr(words, "c"), 2) == false { return 8 }
    if assertEqInt(indexOfStr(words, "z"), -1) == false { return 9 }
    val nums = nums_list()
    if assertTrue(containsInt(nums, 20)) == false { return 10 }
    if assertEqInt(indexOfInt(nums, 30), 2) == false { return 11 }
    val rev = reverse(words)
    if assertEqStr(firstOr(rev, "d"), "c") == false { return 12 }
    if assertEqStr(lastOr(rev, "d"), "a") == false { return 13 }
    return 0
}

fn split_words() -> list {
    var words = []
    words.push("a")
    words.push("b")
    words.push("c")
    return words
}

fn nums_list() -> list {
    var nums = []
    nums.push(10)
    nums.push(20)
    nums.push(30)
    return nums
}
