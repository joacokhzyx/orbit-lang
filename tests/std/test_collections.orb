// M5 contract tests: string-list helpers plus int search. Maps are
// out of scope (method lowering targets lists today).
//
// A note on what these checks measure, because the machinery under them
// changed and an earlier header described the old one. Before lists had an
// element type (F-0002), a read lowered to one hardcoded pointer
// dereference -- `*(void**)_lr.value` -- and a write staged the value in a
// `uintptr_t` `_tmp` word, whatever the list held. The comparison behind
// `l.get(i) == v` was between two words, and which values survived it was
// a property of their representation: ints did, because the word is the
// int; pointer-carried values did not, which is F-0009's class and its
// `getOr(nums, 0, "d")` crash.
//
// F-0002's fix changed that in layers. Reads and writes lower to the
// accessor for the element kind now (`orbit_list_push_int`,
// `orbit_list_read_int`, ...), every helper declares its payload
// (`list<string>` / `list<int>`, and the family is generic per call site
// now), and the runtime checks the kind the list adopted at every typed
// read, refusing the wrong one instead of decoding it. Checks 10 and 11
// run the typed int accessors and compare decoded ints; the string checks
// compare with `strcmp` over `orbit_list_read_string`. They asserted the
// right expectation all along -- a list of ints must be searchable for an
// int -- and the machinery can carry the assertion now.
//
// What has no answer is a search whose element type is incoherent -- a
// string search over a list of lists. Where the call site can name the
// element type it is E1005 at compile time:
//
//     error[E1005]: Parameter 1 of indexOfStr is declared list<string> but
//     the argument is list<list<string>>.
//
// and where the list arrives behind a bare `-> list`, the first typed read
// refuses at runtime, exit 2:
//
//     orbit: list element type mismatch
//       list holds reference, this value is string
//       a list has one element type, so a read and a write must agree on it
//
// That runtime half is tests/std/test_collections_boxed.orb, ordinary
// `expect-exit 2` coverage now; the push-side half is
// tests/negative/list_mixed_element_kinds.orb, and n39 pins the E1005 for
// `getOr(nums, 0, "d")` over an int list.
import "std/collections/lists.orb"
import "std/test/assert.orb"

fn main() -> int {
    val words = split_words()
    if assertEqStr(getOr(words, 0, "d"), "a") == false { return 1 }
    if assertEqStr(getOr(words, 9, "d"), "d") == false { return 2 }
    if assertEqStr(getOr(words, -1, "d"), "d") == false { return 3 }
    if assertEqStr(firstOr(words, "d"), "a") == false { return 4 }
    if assertEqStr(lastOr(words, "d"), "c") == false { return 5 }
    if assertTrue(containsStr(words, "b")) == false { return 6 }
    if assertTrue(containsStr(words, "z")) { return 7 }
    if assertEqInt(indexOfStr(words, "c"), 2) == false { return 8 }
    if assertEqInt(indexOfStr(words, "z"), -1) == false { return 9 }
    val nums = nums_list()
    if assertTrue(containsInt(nums, 20)) == false { return 10 }
    if assertEqInt(indexOfInt(nums, 30), 2) == false { return 11 }
    val rev = reverse(words)
    if assertEqStr(firstOr(rev, "d"), "c") == false { return 12 }
    if assertEqStr(lastOr(rev, "d"), "a") == false { return 13 }
    return 0
}

fn split_words() -> list {
    var words = []
    words.push("a")
    words.push("b")
    words.push("c")
    return words
}

fn nums_list() -> list {
    var nums = []
    nums.push(10)
    nums.push(20)
    nums.push(30)
    return nums
}
