// M5 contract tests: string-list helpers plus int search. Maps are
// out of scope (method lowering targets lists today).
//
// KNOWN FALSE PASS -- checks 10 and 11 below (containsInt / indexOfInt
// on `nums`) do not test what they appear to, and the reason is exact.
//
// What they appear to test: that searching a list of ints for an int
// works. What they actually compare, in the emitted C, is:
//
//     push:  { uintptr_t _tmp = (uintptr_t)(20); orbit_list_push(l, &_tmp); }
//     get:   OrbitResult _lr = orbit_list_get(l, i);
//            r = _lr.ok ? *(void**)_lr.value : NULL;
//     test:  (uintptr_t)(r) == (uintptr_t)(20)
//
// So the assertion is that the BIT PATTERN stored in the list equals the bit
// pattern of the needle. There is no element type, so nothing unpacks a
// stored word before comparing it; for an int element the stored word is the
// int, so 20 really is 20 and the check passes. It is a comparison of
// addresses that happens to be true, not a search.
//
// WHAT WOULD BREAK IT: the first list whose elements are boxed values --
// strings behind a pointer, models, or any element a heap cell. Then the
// stored word is a pointer, `(uintptr_t)pointer` is an address like
// 0x55f3e2a1c040, and the equality is false for every element including the
// right one, so containsInt returns false and indexOfInt returns -1 for a
// list that plainly contains the value. That is not a degradation, it is a
// total inversion, and it lands the moment lists get an element type.
//
// The expectation is still RIGHT after that fix -- a list of ints must be
// searchable for an int -- so these two checks are left exactly as they are and
// will keep passing. They are simply not evidence until then, which is why the
// other half of this contract is a separate file:
// tests/std/test_collections_boxed.orb asserts the same search over a list
// that already holds boxed values, where it fails today and is declared
// `known-failing`. Two more verified demonstrations of what is not covered
// here:
//
//   1. indexOfStr over a list of lists answers wrong, silently. The element is
//      then a list pointer, and the pointer is compared to the needle:
//        var inner = []  inner.push("x")
//        var outer = []  outer.push(inner)
//        print(indexOfStr(outer, "x"))   ->  -1, and it should be 0
//
//   2. getOr is declared `-> string` and calls `l.get(i)`. On an int
//      list that hands an int back where a string is declared:
//        getOr(nums, 0, "d")      ->  Segmentation fault (core dumped)
//
// The element types are owned by the compiler now (`list<string>` /
// `list<int>` in every signature in lists.orb, F-0007 with enough type IR to
// check the payload). Reading back a list of the wrong kind is a REAL error
// when the caller can name it (E1005), and a runtime abort when it cannot.
// Checks 10 and 11 below still only assert bit-pattern equality today, but
// they at least run against a typed getter, which puts the remaining gap on
// boxing, not on the payload type.
import "std/collections/lists.orb"
import "std/test/assert.orb"

fn main() -> int {
    val words = split_words()
    if assertEqStr(getOr(words, 0, "d"), "a") == false { return 1 }
    if assertEqStr(getOr(words, 9, "d"), "d") == false { return 2 }
    if assertEqStr(getOr(words, -1, "d"), "d") == false { return 3 }
    if assertEqStr(firstOr(words, "d"), "a") == false { return 4 }
    if assertEqStr(lastOr(words, "d"), "c") == false { return 5 }
    if assertTrue(containsStr(words, "b")) == false { return 6 }
    if assertTrue(containsStr(words, "z")) { return 7 }
    if assertEqInt(indexOfStr(words, "c"), 2) == false { return 8 }
    if assertEqInt(indexOfStr(words, "z"), -1) == false { return 9 }
    val nums = nums_list()
    if assertTrue(containsInt(nums, 20)) == false { return 10 }
    if assertEqInt(indexOfInt(nums, 30), 2) == false { return 11 }
    val rev = reverse(words)
    if assertEqStr(firstOr(rev, "d"), "c") == false { return 12 }
    if assertEqStr(lastOr(rev, "d"), "a") == false { return 13 }
    return 0
}

fn split_words() -> list {
    var words = []
    words.push("a")
    words.push("b")
    words.push("c")
    return words
}

fn nums_list() -> list {
    var nums = []
    nums.push(10)
    nums.push(20)
    nums.push(30)
    return nums
}
