// M9 contract tests: pid, env access, defaults, CLI args. execStatus is
// exercised manually (shell exit codes differ per platform); exit()
// lives in test_process_exit.orb with expect-exit 3. Args run under the
// suite runner with no arguments, so argv is the program path alone;
// multi-arg shape is verified by hand (probe with explicit argv).
// capture() has no cases here: the runner builds without
// ORBIT_WITH_EXEC, so it would always see "" -- its contract is pinned
// by runtime/test_exec.c instead.
import "std/sys/proc/process.orb"
import "std/test/assert.orb"

fn main() -> int {
    if pid() <= 0 { return 1 }
    if getEnv("ORBIT_DEFINITELY_MISSING_VAR_XYZ") != "" { return 2 }
    if assertEqStr(getEnvOrDefault("ORBIT_DEFINITELY_MISSING_VAR_XYZ", "dflt"), "dflt") == false { return 3 }
    if argCount() < 1 { return 4 }
    if arg(0) == "" { return 5 }
    if arg(-1) != "" { return 6 }
    if arg(argCount()) != "" { return 7 }
    val argv = args()
    if assertEqInt(argv.len(), argCount()) == false { return 8 }
    if assertEqStr(argv.get(0), arg(0)) == false { return 9 }
    return 0
}
