// Wave 2 dispatch probe: static GET table with an overlapping param
// route. The param route always chains after the static one, so static
// wins over covering patterns.
route GET "/" {
    return ok 200 "root"
}

route GET "/health" {
    return ok 200 "up"
}

route GET "/metrics" {
    return ok 200 "met"
}

route GET "/notes/new" {
    return ok 200 "new-note"
}

route GET "/notes/:id" {
    val id = req.param("id")
    return ok 200 id
}
