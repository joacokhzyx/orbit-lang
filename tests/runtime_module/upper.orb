// Runtime module probe: functions that read and write string bytes, one that
// calls another export, and a private helper.
fn isLower(c: int) -> bool {
    return c >= 97 && c <= 122
}

export fn rtmod_probe_upper(s: string) -> string {
    val n = rt_len(s)
    val out = rt_alloc(n)
    var i = 0
    while i < n {
        val c = rt_byte(s, i)
        if isLower(c) {
            rt_set_byte(out, i, c - 32)
        } else {
            rt_set_byte(out, i, c)
        }
        i = i + 1
    }
    return out
}

export fn rtmod_probe_twice(s: string) -> string {
    return rtmod_probe_upper(rtmod_probe_upper(s))
}
