extern fn list_create(cap: int) -> list
fn make_ok(n: int) -> int { return n }
fn f(n: int) -> list {
    val out = list_create(n)
    var i = 0
    while i < n {
        val value: int = try make_ok(i) catch e {
            val each = list_create(n)
            i = i + 1
        }
        i = i + 1
    }
    return out
}
