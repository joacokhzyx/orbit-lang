union Shape { Circle(int), Square(int), Unit }
enum Color { Red, Green }
fn f(s: Shape, c: Color) -> int {
    match s {
        Shape.Circle(r) => {
            match c {
                Color.Red => { return r }
                Color.Green => { return r + 1 }
            }
            return 0
        }
        Shape.Square(a) => {
            match c {
                Color.Red => { return a }
                Color.Green => { return a + 1 }
                Color.Red => { return 999 }
            }
            return 0
        }
        Shape.Unit => { return 0 }
    }
}
