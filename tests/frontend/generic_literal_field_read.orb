// A literal writes the argument its model declares: `val b = Box { v: 3 }` is a
// `Box<int>`, and `b.v` answers `int`. This fixture used to hold the branch open
// the other way -- the literal kept the bare name the source wrote, `b.v` had no
// type to print, and the file's text was suppressed -- because the argument lives
// in the value and the pass reported the source. Reading the value's own type for
// the field that names the parameter is the same inference
// `compiler/ir/builder.orb` makes for the build, so the read is answered and the
// text prints.
//
// A literal that leaves an argument out still keeps the bare name: there is no
// value to infer from, and guessing one would print a type the source never
// wrote.
import "../../compiler/tir/entry.orb"

fn main() {
    val source = "model Box[T] { v: T }  fn useBox() -> int { val b = Box { v: 3 } return b.v }"
    print(compileFrontendSource("fixture", source))
}
