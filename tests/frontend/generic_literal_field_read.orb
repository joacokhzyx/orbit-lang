// The control for the rule `tests/frontend/generic_instance_field_read.orb`
// pins. A field declared as a type parameter answers the argument the instance
// writes, and a literal writes none: `val b = Box { v: 3 }` keeps the bare name
// the source wrote, so the field's declared text is still `T` and the read of
// `b.v` has no type to print.
//
// Answering it would mean inferring the element from the value -- the build does
// that for a generic call site, and this pass reports the source -- so the read
// keeps its E2004 and the file prints nothing. That is the branch this fixture
// holds open: a future rule that guesses the argument would make this print text
// and the gate would fail.
import "../../compiler/tir/entry.orb"

fn main() {
    val source = "model Box[T] { v: T }  fn useBox() -> int { val b = Box { v: 3 } return b.v }"
    val output = compileFrontendSource("fixture", source)
    if output == "" {
        print("a generic literal names no argument")
    }
}
