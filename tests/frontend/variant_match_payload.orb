// The control for the test chain. An arm that binds a payload needs the variant's
// data word read off the scrutinee, and this slice prints no such instruction: the
// pass says what is missing (E3001, "a match that binds a payload needs the data
// read this pass does not print") and prints no text.
//
// Lowering the arm anyway would bind `r` to nothing, and a name with no value behind
// it is the invention the `unknown` count exists to make visible. When the data read
// lands, this fixture has to be re-declared with the text it then prints.
import "../../compiler/tir/entry.orb"

fn main() {
    val source = "union Shape { Circle(int) }  fn area(s: Shape) -> int { match s { Shape.Circle(r) => { return r } } return 0 }"
    val output = compileFrontendSource("fixture", source)
    if output == "" {
        print("a payload arm waits for the data read")
    }
}
