// case: arena-read-is-silent-in-the-type-rules
// what: `val arena = 7` is refused because every function this compiler emits
//      already takes an OrbitArena* arena, and the refusal declares the name
//      with the poisoned spelling so the read stays silent. `n135` pinned the
//      plain read; the two rules that refuse an operand by its type did not
//      consult the sentinel, so the for loop reported `for loops iterate
//      lists, not <poisoned>` and the index reported `The value being indexed
//      is a <poisoned>`. Both are the consequence of the refusal, and both
//      leaked the spelling to the user. `one-diagnostic:` pins the count, so a
//      third line is a red build.
// expect-error: Cannot declare 'arena'
// one-diagnostic:

fn main() -> int {
    val arena = 7
    for x in arena {
        print(x)
    }
    return arena[0]
}
