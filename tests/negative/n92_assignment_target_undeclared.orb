// case: assignment-target-undeclared
// what: the target names nothing. The builder emits
//      `__attribute__((unused)) orbit_int missing;` for it, so the generated C
//      compiles, the store is dropped, and the program exits 0 with no output.
// known-defect: F-0025
fn main() -> int {
    missing = 1
    return 0
}
