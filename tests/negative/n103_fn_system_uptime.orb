// case: fn-name-collides-with-runtime-export
// what: `system_uptime` is declared by runtime/orbit_api.h, which every
//      generated translation unit includes. The libc list in sema.orb did not
//      hold it, because it is a runtime name and not a libc name. The runtime
//      half is generated from the runtime sources now, so a new export is
//      reserved without anyone editing the checker.
// expect-error: 'system_uptime' is a runtime C name and cannot be used as an Orbit function name
fn system_uptime() -> int {
    return 0
}

fn main() -> int {
    print(system_uptime())
    return 0
}
