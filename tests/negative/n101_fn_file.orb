// case: fn-name-collides-with-c-type
// what: `FILE` is a typedef from <stdio.h>, which every generated translation
//      unit includes, and a user function is emitted under its own name.
//      `fn FILE` therefore reached the C compiler as a second declaration and
//      failed there with `conflicting types`; it is refused at check time now.
// expect-error: 'FILE' is a C type name and cannot be used as an Orbit function name
fn FILE(value: int) -> int {
    return value
}

fn main() -> int {
    print(FILE(1))
    return 0
}
