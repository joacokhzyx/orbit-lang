// case: list-parameter-has-no-element-type
// what: a helper declared over a BARE `list` reads elements through the
//      untyped accessor, so an int came back out of a `-> string` function
//      and `print` dereferenced it:
//
//        $ orbit run <the old form>
//        Segmentation fault (core dumped)
//
//      Nothing was pinnable on the value: a crash moves per run and per
//      machine, and a pin that fires at random teaches people to ignore the
//      pin. Generic functions close the class instead: `getOr[T]` fixes `T`
//      per call site, so the old program's incoherent call (int list with a
//      string default) is refused below, naming the variable and both types.
//      The bare `list` spelling stays lenient for dynamic values, the way
//      `unknown` is -- it cannot be refused without breaking working dynamic
//      code -- but no typed signature can express the crash anymore.
// expect-error: Type parameter 'T' of 'getOr' is fixed to int by argument 1 but to string by argument 3
fn getOr[T](l: list<T>, i: int, dflt: T) -> T {
    if i < 0 { return dflt }
    if i >= l.len() { return dflt }
    return l.get(i)
}

fn main() -> int {
    var nums = []
    nums.push(10)
    nums.push(20)
    print(getOr(nums, 0, "d"))
    return 0
}
