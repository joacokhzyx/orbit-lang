// case: model-missing-field
// what: `Point` has fields x and y. Reading a field it does not declare must
//      not compile. It used to become a raw load of an offset that was never
//      allocated, so the program read whatever happened to be there.
// expect-error: Model 'Point' has no field 'nonexistent'.
model Point {
    x: int
    y: int
}

fn main() -> int {
    val m = Point(1, 2)
    return m.nonexistent
}
