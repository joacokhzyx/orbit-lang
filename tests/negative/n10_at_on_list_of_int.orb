// case: at-on-list-of-int
// what: `.at()` on a list of ints must not compile, and the program as written
//      does not return 20 either. `orbit check` is clean and the run returns 0,
//      because the backend calls orbit_string_at on a list pointer.
//      FINDINGS F-0002.
// known-defect: F-0002
fn main() -> int {
    val n = [10, 20, 30]
    return n.at(1)
}
