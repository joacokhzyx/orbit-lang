// case: c-function-name-rejected
// what: `strcat` is declared by <string.h>, which every generated translation unit
//      includes, and a user function is emitted under its own name. `fn strcat`
//      therefore reached the C compiler as a second declaration with a different
//      signature, and failed there with `conflicting types` after `orbit check`
//      had accepted the program. It is refused at check time now.
// expect-error: 'strcat' is a C library function name and cannot be used as an Orbit function name
fn strcat(a: string, b: string) -> string {
    return a + b
}

fn main() -> int {
    print(strcat("a", "b"))
    return 0
}
