// case: assignment-target-immutable
// what: a `val` is reassigned. The assignment arm checks the value and never
//      looks at the target, so the emitter stores into the slot the `val` was
//      declared in. Built today, the program prints `2`.
// known-defect: F-0025
// wrong-value: 2
fn main() -> int {
    val x = 1
    x = 2
    print(x)
    return 0
}
