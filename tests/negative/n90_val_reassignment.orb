// case: assignment-target-immutable
// what: a `val` is reassigned. A `val` is bound once; the store has to be
//      refused instead of writing the second value into the slot.
// expect-error: Cannot assign to 'x': it is a val
fn main() -> int {
    val x = 1
    x = 2
    print(x)
    return 0
}
