// case: object-literal-list-field
// what: a DYNAMIC object field cannot hold a list. A model field can: the
//      model declares `tags: list<string>` and the struct holds the pointer,
//      which is where a list has always lived. The dynamic object has no
//      declared field types at all, so the emitter has nothing to store a
//      list pointer in that will not read back as its digits in the JSON
//      body. Refuse it there instead of guessing.
// expect-error: an object field cannot hold a list yet
fn main() -> int {
    val config = { name: "x", tags: [] }
    print(config.get("name"))
    return 0
}