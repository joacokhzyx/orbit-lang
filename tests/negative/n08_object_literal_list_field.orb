// case: object-literal-list-field
// what: an object field cannot hold a list. The rejection has to happen here;
//      the alternative is a struct field initialised from a list pointer.
// expect-error: an object field cannot hold a list yet
model Config {
    name: string
    tags: list
}

fn main() -> int {
    val c = Config { name: "x", tags: [] }
    return 0
}
