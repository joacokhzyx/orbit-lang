// case: assignment-type-mismatch
// what: a `var` declared int is given a string. The store has to agree with
//      the declared type; the emitter would cast the pointer and the program
//      would print an address as a number.
// expect-error: Cannot store string in 'x': it is declared int
fn main() -> int {
    var x: int = 1
    x = "s"
    print(x)
    return 0
}
