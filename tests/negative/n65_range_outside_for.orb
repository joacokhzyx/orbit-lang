// case: range-outside-for
// what: `..` builds a RangeNode only in the `for` header. Anywhere else it
//      is an unexpected token, because a range is a way to iterate, not a
//      value: giving it a runtime shape would also give `for x in r` two
//      meanings (the pair, or the count).
// expect-error: unexpected token 'DotDot'
fn main() -> int {
    val r = 1..3
    return 0
}
