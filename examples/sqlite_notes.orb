model User{id: stringusername: stringemail: stringrole_name: string}model Note{id: stringtitle: stringbody: stringauthor_id: stringcreated_at: stringis_private: bool}route GET"/v1/notes"{val notes = Note.all()return ok200notes}route GET"/v1/notes/secured"{val token = req.bearer_token()if (token == ""){err401"Unauthorized: Bearer authentication token missing or invalid"}val secure_notes = Note.where("is_private = true")return ok200secure_notes}route POST"/v1/notes"{val saved = Note.create("{\"id\":\"note_103\",\"title\":\"New Orbit Note\",\"body\":\"Note dynamically inserted into SQLite database\",\"author_id\":\"usr_admin\",\"created_at\":\"2026-07-22T01:45:00Z\",\"is_private\":false}")if (saved){return ok201"{\"status\":\"created\",\"id\":\"note_103\",\"message\":\"Note saved to SQLite database\"}"}err400"Failed to save note to database"}route DELETE"/v1/notes/:id"{val id = req.param("id")if (!req.has_role("admin")){err403"Forbidden: Admin role required to delete notes"}val deleted = Note.delete(id)if (deleted){return ok200"{\"status\":\"deleted\",\"id\":\"" + id + "\"}"}err404"Note not found in database"}route GET"/health"{return ok200"{\"status\":\"UP\",\"engine\":\"sqlite3\",\"database\":\"orbit.db\",\"pool_active\":true}"}

