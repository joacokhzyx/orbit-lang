// Posts CRUD example in Orbit: custom models get their table created
// automatically at startup (CREATE TABLE IF NOT EXISTS from the model
// fields), then support create/all/find/delete over HTTP.
model Post {
    id: string
    title: string
    body: string
    views: int
    rating: float
    published: bool
}

route POST "/posts" {
    val payload = req.body()
    if payload == "" || payload == """{}""" {
        err 400 "post a JSON body with id and title"
    }
    val created = Post.create(payload)
    if created {
        return ok 201 payload
    }
    err 400 """{"stored":false}"""
}

route GET "/posts" {
    val posts = Post.all()
    return ok 200 posts
}

route GET "/posts/:id" {
    val id = req.param("id")
    val found = Post.find(id)
    return ok 200 found
}

route PUT "/posts/:id" {
    val id = req.param("id")
    val payload = req.body()
    val saved = Post.update(id, payload)
    if saved {
        return ok 200 payload
    }
    err 404 """{"updated":false}"""
}

route GET "/posts/count" {
    // Static wins: /posts/count matches here even though /posts/:id
    // is declared first; param patterns only catch the rest.
    val n = Post.count()
    return ok 200 """{"count":${n}}"""
}

route DELETE "/posts/:id" {
    val id = req.param("id")
    val gone = Post.delete(id)
    if gone {
        return ok 200 """{"deleted":"${id}"}"""
    }
    err 404 """{"deleted":false}"""
}
