model Product{id: stringname: stringdescription: stringprice: floatcategory: stringin_stock: boolrating: float}route GET"/v1/catalog"{val category = req.query("category")if (category != ""){val filtered = Product.where("category = ?", category)return ok200filtered}val all_products = Product.all()return ok200all_products}route GET"/v1/catalog/featured"{val featured = Product.where("rating >= 4.8")return ok200featured}route GET"/v1/catalog/categories"{return ok200"{\"categories\":[\"Developer Tools\",\"Security\",\"Databases\",\"Networking\"]}"}route POST"/v1/catalog/items"{val body = req.body()val created = Product.create(body)if (created){return ok201"{\"status\":\"created\",\"id\":\"" + body.id + "\",\"message\":\"Product saved to SQLite database\"}"}err400"Failed to insert product into database"}route GET"/v1/catalog/missing"{err404"Catalog item not found in database"}

