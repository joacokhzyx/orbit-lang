// Blog API tutorial service.
//
// Run: orbit build examples/blog_api.orb -o blog_api
//      ./blog_api 8080   (Windows: .\blog_api.exe 8080; copy
//      runtime/vendor/win-x64/sqlite3.dll next to the exe first)
//
// Reads come from the seeded notes table, so GET works on a fresh
// start with no setup. The POST route validates and echoes on
// purpose: this file keeps to one idea (key-checked publishing).
// A route that really stores the row is examples/posts_crud.orb.
//
// Auth here is a shared key in ?key=, so the file needs no
// sessions row. Bearer tokens and roles work too; see
// examples/sqlite_notes.orb.

model Note {
    id: string
    title: string
    body: string
    author_id: string
    created_at: string
    is_private: bool
}

route GET "/posts" {
    val posts = Note.all()
    return ok 200 posts
}

route GET "/posts/search" {
    val author = req.query("author")
    if (author == "") {
        return ok 200 Note.all()
    }
    val found = Note.where("author_id = ?", author)
    return ok 200 found
}

route POST "/posts" {
    val key = req.query("key")
    if (key != "dev-key-1") {
        err 401 "a valid ?key= value is required to publish"
    }
    val payload = req.body()
    if (payload == "" || payload == "{}") {
        err 400 "post a JSON body with id, title, and body"
    }
    return ok 201 payload
}

// C6 load gate: 20 rps sustained, burst 20 (see scripts/kynx_route_limit_gate.py).
route GET "/health" limit 20 / s burst 20 {
    return ok 200 "{\"status\":\"UP\"}"
}

// C6 load gate burst probe: tiny bucket (5/s, burst 5) so 25 rapid
// sequential requests always trip 429s, even on slow runners where
// TCP setup lets a 20-token bucket refill between requests.
route GET "/gate-burst" limit 5 / s burst 5 {
    return ok 200 "{\"status\":\"burst-ok\"}"
}
