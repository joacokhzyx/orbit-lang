{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Orbit",
  "scopeName": "source.orbit",
  "patterns": [
    { "include": "#comments" },
    { "include": "#annotations" },
    { "include": "#config-keys" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-result" },
    { "include": "#http-methods" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.orbit",
          "match": "//.*$"
        },
        {
          "name": "comment.block.documentation.orbit",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        },
        {
          "name": "comment.block.orbit",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": [{ "include": "#comments" }]
        }
      ]
    },
    "annotations": {
      "comment": "Decorators: @name before a declaration or a field. The parser accepts any identifier here, so this highlights whatever is written rather than a fixed list.",
      "patterns": [
        {
          "name": "entity.name.tag.annotation.orbit",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "config-keys": {
      "comment": "compiler/parser.orb matches exactly these four before it tries anything else. `database` is not one of them, and there is no `kynx`/`rate_limit` declaration: the config value is parsed and then dropped, so these are syntax, not settings.",
      "patterns": [
        {
          "name": "keyword.other.config.orbit",
          "match": "(?<=^|\\n)\\s*(port|cors|db|env)(?=\\s)"
        }
      ]
    },
    "http-methods": {
      "comment": "Route methods, lexed as keywords by compiler/lexer.orb matchKeyword.",
      "patterns": [
        {
          "name": "keyword.operator.http-method.orbit",
          "match": "\\b(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\\b"
        }
      ]
    },
    "keywords-control": {
      "comment": "compiler/lexer.orb matchKeyword, control half.",
      "patterns": [
        {
          "name": "keyword.control.orbit",
          "match": "\\b(if|else|for|in|while|loop|break|continue|return|match|try|catch)\\b"
        }
      ]
    },
    "keywords-declaration": {
      "comment": "compiler/lexer.orb matchKeyword, declaration half. `mut` is the mutable-binding modifier, not a type.",
      "patterns": [
        {
          "name": "keyword.declaration.orbit",
          "match": "\\b(fn|val|var|mut|const|private|extern|async|model|route|type|enum|union|trait|impl|every|import|use)\\b"
        }
      ]
    },
    "keywords-result": {
      "comment": "ok/err/with belong to the result type; without this they read as ordinary identifiers.",
      "patterns": [
        {
          "name": "keyword.operator.result.orbit",
          "match": "\\b(ok|err|with)\\b"
        }
      ]
    },
    "types": {
      "comment": "The names compiler/c_backend.orb mapTypeToC knows. `List`/`Map`/`Result`/`Response` really are types. A capitalised name it does NOT know - `Int`, `String`, `Any`, `DateTime` - becomes `Name*` in the emitted C, so it type-checks and then gcc says `unknown type name 'Int'`. The word is still a type-looking word here because that is how it reads, but see docs/LANGUAGE_REFERENCE.md.",
      "patterns": [
        {
          "name": "storage.type.orbit",
          "match": "\\b(int|float|string|bool|void|list|map|object|result|response|List|Map|Result|Response)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.orbit",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.orbit",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [{ "include": "#interpolation" }]
        },
        {
          "name": "string.quoted.double.orbit",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#interpolation" },
            {
              "name": "constant.character.escape.orbit",
              "match": "\\\\(x[0-9A-Fa-f]{2}|[nrt\\\\\"'])"
            }
          ]
        },
        {
          "name": "constant.character.escape.char.orbit",
          "match": "'(\\\\(x[0-9A-Fa-f]{2}|[nrt\\\\\"'])|[^\\\\'])'"
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.expression.orbit",
          "begin": "\\$\\{",
          "end": "\\}",
          "patterns": [{ "include": "source.orbit" }]
        }
      ]
    },
    "numbers": {
      "comment": "Decimal, digit separators, and one optional fractional part - which is all the lexer reads (compiler/lexer.orb isDigit branch: 0x hex, then digits with `_`, then `.` + a digit). There is NO exponent: `1.5e2` is the number 1 followed by junk and prints 1, and `2.5E3` declares a variable called E3 whose type is unknown to the C compiler. Highlighting the exponent here would teach a form the language cannot parse.",
      "patterns": [
        {
          "name": "constant.numeric.hex.orbit",
          "match": "\\b0[xX][0-9A-Fa-f](_?[0-9A-Fa-f])*\\b"
        },
        {
          "name": "constant.numeric.decimal.orbit",
          "match": "\\b[0-9](_?[0-9])*(\\.[0-9](_?[0-9])*)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.orbit",
          "match": "(==|!=|<=|>=|->|=>|\\+=|-=|\\*=|/=|&&|\\|\\||=|\\+|-|\\*|/|%|<|>|!|\\?)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.orbit",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        }
      ]
    }
  }
}
