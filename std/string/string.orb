// String utilities over builtin strings.
//
// Where the runtime already has the function, this module is a thin
// extern rather than a second implementation. The C versions reached
// here take no arena and need no compiler change:
//
//   orbit_string_starts_with  runtime/collections.c:621
//   orbit_string_ends_with    runtime/collections.c:629
//   orbit_string_contains     runtime/collections.c:637
//   orbit_string_indexOf      runtime/collections.c:642
//   orbit_string_replace      runtime/collections.c:578
//
// Three siblings are NOT used, and the reason is the same in all three
// cases: their C signature starts with an OrbitArena* that the backend
// does not prepend for them (compiler/c_backend.orb:3246
// functionNeedsArena), so the emitted call is one argument short and
// the C step fails. Filed as F-0014; the pure-Orbit bodies below stay
// until the table learns the names.
//
//   orbit_string_to_upper     runtime/collections.c:648
//   orbit_string_to_lower     runtime/collections.c:661
//   orbit_string_trim         runtime/collections.c:674
//
// orbit_string_split (runtime/collections.c:541) is reachable and is
// deliberately not used either: it builds its OrbitList inside the
// runtime, and `.len()` on a runtime-built list is emitted as
// orbit_string_len on a list pointer, which answers 1 for a 3-element
// split (F-0002). The Orbit-built list below measures correctly.
//
// parseIntChecked accepts only canonical decimal form (optional leading
// '-', no spaces, no plus, no leading zeros); anything else is an err.
//
// The numeric bindings come from std/convert/convert.orb, which owns
// them; redeclaring one here is a "Duplicate symbol" build error.
import "std/convert/convert.orb"

extern fn orbit_string_indexOf(s: string, sub: string) -> int
extern fn orbit_string_contains(s: string, sub: string) -> bool
extern fn orbit_string_starts_with(s: string, prefix: string) -> bool
extern fn orbit_string_ends_with(s: string, suffix: string) -> bool
extern fn orbit_string_replace(s: string, oldPart: string, newPart: string) -> string

fn startsWith(s: string, prefix: string) -> bool {
    return orbit_string_starts_with(s, prefix)
}

fn endsWith(s: string, suffix: string) -> bool {
    return orbit_string_ends_with(s, suffix)
}

fn contains(s: string, sub: string) -> bool {
    return orbit_string_contains(s, sub)
}

// Byte offset of the first occurrence of sub, or -1. Already backed by
// the runtime; this only gives it a name callers do not have to know.
fn indexOf(s: string, sub: string) -> int {
    return orbit_string_indexOf(s, sub)
}

// Replaces every non-overlapping occurrence of oldPart. An empty
// oldPart is not a wildcard: it matches nothing and s comes back
// unchanged, which is what the runtime does (collections.c:582) and
// what a caller replacing a variable needle wants.
fn replace(s: string, oldPart: string, newPart: string) -> string {
    return orbit_string_replace(s, oldPart, newPart)
}

fn isSpaceCode(c: int) -> bool {
    if c == 32 { return true }
    if c == 9 { return true }
    if c == 10 { return true }
    if c == 13 { return true }
    return false
}

// The three helpers below stay in Orbit only because the runtime
// versions cannot be called yet; see the header. The C trio is
// byte-wise over the same ASCII range, so the contract they already
// document (multibyte sequences pass through unchanged) holds either
// way.
//
// toUpper/toLower go through the UNRESTRICTED char binding from
// std/convert/convert.orb rather than its charFromCode wrapper, on
// purpose: charFromCode refuses codes outside 32..126, and a UTF-8
// continuation byte is above 126, so routing case mapping through it
// would silently delete every multibyte character. The wrapper is for
// callers who want the range check, not for code that has to preserve
// bytes.
fn trim(s: string) -> string {
    var start = 0
    while start < s.len() {
        if isSpaceCode(s.at(start)) == false { break }
        start = start + 1
    }
    var end = s.len()
    while end > start {
        if isSpaceCode(s.at(end - 1)) == false { break }
        end = end - 1
    }
    return s.slice(start, end)
}

fn toUpper(s: string) -> string {
    var out = ""
    var i = 0
    while i < s.len() {
        val c = s.at(i)
        if c >= 97 && c <= 122 {
            out = out + orbit_string_from_char_selfhost(c - 32)
        } else {
            out = out + orbit_string_from_char_selfhost(c)
        }
        i = i + 1
    }
    return out
}

fn toLower(s: string) -> string {
    var out = ""
    var i = 0
    while i < s.len() {
        val c = s.at(i)
        if c >= 65 && c <= 90 {
            out = out + orbit_string_from_char_selfhost(c + 32)
        } else {
            out = out + orbit_string_from_char_selfhost(c)
        }
        i = i + 1
    }
    return out
}

fn join(parts: list, sep: string) -> string {
    var out = ""
    var i = 0
    while i < parts.len() {
        if i != 0 {
            out = out + sep
        }
        out = out + parts.get(i)
        i = i + 1
    }
    return out
}

fn split(s: string, sep: string) -> list {
    val parts = []
    if sep == "" {
        parts.push(s)
        return parts
    }
    var rest = s
    while true {
        val idx = orbit_string_indexOf(rest, sep)
        if idx == -1 { break }
        parts.push(rest.slice(0, idx))
        rest = rest.slice(idx + sep.len(), rest.len())
    }
    parts.push(rest)
    return parts
}

fn padLeft(s: string, width: int, pad: string) -> string {
    if pad == "" { return s }
    var out = s
    while out.len() < width {
        out = pad + out
    }
    return out
}

fn padRight(s: string, width: int, pad: string) -> string {
    if pad == "" { return s }
    var out = s
    while out.len() < width {
        out = out + pad
    }
    return out
}

fn parseIntChecked(s: string) -> result {
    val t = trim(s)
    if t == "" {
        return err("empty input", 1)
    }
    var i = 0
    if t.at(0) == 45 {
        i = 1
    }
    if i >= t.len() {
        return err("not an integer", 2)
    }
    while i < t.len() {
        val c = t.at(i)
        if c < 48 || c > 57 {
            return err("not an integer", 2)
        }
        i = i + 1
    }
    val n = t.to_int()
    val back = orbit_int_to_string(n)
    if back != t {
        return err("not an integer", 2)
    }
    return ok(n)
}
