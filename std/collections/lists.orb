// Functional layer over builtin lists. String-typed helpers only:
// one typed family keeps the contract honest.
// Maps are out of scope here (method lowering targets lists today).
//
// THE STRING TYPE IS NOT ENFORCED WHEN THE LIST GETS IN UNTYPED. A function
// may now declare its payload: `fn getOr(l: list<string>, ...)` and the
// checker rejects a caller that hands it a list of another kind, while reads
// inside are typed. The exposure below is only for the bare `list` form, where
// the checker cannot see how the caller built the list and the runtime only
// enforces that pushes/reads see ONE kind (orbit_list_adopt_kind) -- a
// retyped parameter pointer was what made F-0009 segfault:
//
//   getOr as written below, called with a list of ints -> an int returned
//   where a string is declared, then printed
//   indexOfStr(listOfLists, "x")                      -> keeps? -> reads typed via elemAnnotation...
fn getOr(l: list<string>, i: int, dflt: string) -> string {
    if i < 0 { return dflt }
    if i >= l.len() { return dflt }
    return l.get(i)
}

fn firstOr(l: list<string>, dflt: string) -> string {
    return getOr(l, 0, dflt)
}

fn lastOr(l: list<string>, dflt: string) -> string {
    return getOr(l, l.len() - 1, dflt)
}

fn containsStr(l: list<string>, v: string) -> bool {
    var i = 0
    while i < l.len() {
        if l.get(i) == v { return true }
        i = i + 1
    }
    return false
}

fn containsInt(l: list<int>, v: int) -> bool {
    var i = 0
    while i < l.len() {
        if l.get(i) == v { return true }
        i = i + 1
    }
    return false
}

fn indexOfStr(l: list<string>, v: string) -> int {
    var i = 0
    while i < l.len() {
        if l.get(i) == v { return i }
        i = i + 1
    }
    return -1
}

fn indexOfInt(l: list<int>, v: int) -> int {
    var i = 0
    while i < l.len() {
        if l.get(i) == v { return i }
        i = i + 1
    }
    return -1
}

fn reverse(l: list) -> list {
    var out = []
    var i = l.len() - 1
    while i >= 0 {
        out.push(l.get(i))
        i = i - 1
    }
    return out
}
