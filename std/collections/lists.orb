// Functional layer over builtin lists, generic over the element type: one
// family per helper instead of one spelling per kind (`containsStr` plus
// `containsInt`). Each call site monomorphises its own instance, so a string
// caller and an int caller get checking and code for their own kind, and an
// incoherent call (int list with a string default) is refused instead of
// crashing. Maps are out of scope here (method lowering targets lists today).
fn getOr[T](l: list < T >, i: int, dflt: T) -> T {
    if i < 0 { return dflt }
    if i >= l.len() { return dflt }
    return l.get(i)
}

fn firstOr[T](l: list < T >, dflt: T) -> T {
    return getOr(l, 0, dflt)
}

fn lastOr[T](l: list < T >, dflt: T) -> T {
    return getOr(l, l.len() - 1, dflt)
}

fn listContains[T](l: list < T >, v: T) -> bool {
    var i = 0
    while i < l.len() {
        if l.get(i) == v { return true }
        i = i + 1
    }
    return false
}

fn listIndexOf[T](l: list < T >, v: T) -> int {
    var i = 0
    while i < l.len() {
        if l.get(i) == v { return i }
        i = i + 1
    }
    return -1
}

fn reverse[T](l: list < T >) -> list < T > {
    val out = []
    var i = l.len() - 1
    while i >= 0 {
        out.push(l.get(i))
        i = i - 1
    }
    return out
}

// The pre-generic spellings, kept as one-line shims: same signatures,
// delegating to the generic core, so existing callers keep compiling while
// new code writes the family name once.
fn containsStr(l: list < string >, v: string) -> bool {
    return listContains(l, v)
}

fn containsInt(l: list < int >, v: int) -> bool {
    return listContains(l, v)
}

fn indexOfStr(l: list < string >, v: string) -> int {
    return listIndexOf(l, v)
}

fn indexOfInt(l: list < int >, v: int) -> int {
    return listIndexOf(l, v)
}
