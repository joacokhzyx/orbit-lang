// QUARANTINED: not implemented, not loadable, on purpose.
// Was std/sys/bytes/bitwise.orb. See std/quarantine/README.md for why
// it is not a .orb file.
//
// WHAT QUARANTINED IT: bitwise operators. The probe that recorded that,
// measured when the file was quarantined:
//
//   $ for op in '&' '|' '^' '<<' '>>' '~' ; do
//       printf 'fn main() { val c = 12 %s 10  print(c) }\n' "$op" > /tmp/b.orb
//       orbit check /tmp/b.orb
//     done
//   &    -> error[E0301]: unexpected token 'Ampersand'
//   |    -> error[E0301]: unexpected token 'Pipe'
//   <<   -> error[E0301]: unexpected token 'Less'
//   >>   -> error[E0301]: unexpected token 'Greater'
//   ^    -> Lexer error: invalid character (code 94)
//   ~    -> Lexer error: invalid character (code 126)
//
// LANDED SINCE: the operators themselves. `&`, `|`, `^`, `<<` and `>>`
// take two ints and `~` takes one; the precedence is C's grouping and a
// shift count is masked to five bits. The language reference has the
// section ("Bitwise and shift operators") and
// tests/suite/bitwise_operators.orb is the behavior pin.
//
// STILL MISSING BEFORE THE LIFT: the `val` parameter names below (a
// keyword, so the file would not parse), and the module's own test.
// Rename the parameters, restore this file as std/sys/bytes/bitwise.orb,
// and give it a test under tests/std/ over the published vectors
// (12 & 10 == 8, 12 | 10 == 14, 12 ^ 10 == 6, 1 << 10 == 1024).
//
// This file is kept as the specification of the wanted module, NOT as a
// working module. Nothing imports it and tests/std/ does not cover it.
fn bitAnd(a: int, b: int) -> int {
    return a & b
}

fn bitOr(a: int, b: int) -> int {
    return a | b
}

fn bitXor(a: int, b: int) -> int {
    return a ^ b
}

fn shiftLeft(val: int, amount: int) -> int {
    return val << amount
}

fn shiftRight(val: int, amount: int) -> int {
    return val >> amount
}
