// Number <-> text, and the char constructor the case-mapping helpers
// are built on. These bindings used to be private externs inside
// std/string/string.orb, which meant the only way for a second module
// to reach them was to import all of std/string or to redeclare them
// and take a "Duplicate symbol" error. They are declared here so there
// is exactly one owner.
//
// THERE IS NO FLOAT CONVERSION, and the reason is narrow: printing and
// comparing floats works (literals, calls, arithmetic and model fields
// all round-trip; measured on this tree), but the transport has holes.
// A float argument that the backend cannot see as a float travels through
// uintptr_t, and orbit_string_to_float is also a bare atof: it answers
// 0.0 for "abc" and 1.5 for "1.5abc", with no way to tell a parse
// failure from a zero. Until the transport is total and the parser
// reports failures, this module refuses to ship a float parser.
// orbit_string_to_float (runtime/builtins.c:74) is reachable -- declare
// it extern and it links -- but nothing here can vouch for its result.
extern fn orbit_int_to_string(value: int) -> string
extern fn orbit_string_to_int(s: string) -> int
extern fn orbit_string_from_char_selfhost(code: int) -> string

fn intToString(value: int) -> string {
    return orbit_int_to_string(value)
}

// One character from its byte value. Codes outside 32..126 are
// rejected rather than substituted: a NUL or a lone continuation byte
// vanishes inside an Orbit string, so a silent answer here is data
// loss, not a value.
fn charFromCode(code: int) -> string {
    if code < 32 { return "" }
    if code > 126 { return "" }
    return orbit_string_from_char_selfhost(code)
}

// NOTE: no stringToInt. orbit_string_to_int is a bare atoi, so "12x"
// answers 12 and "abc" answers 0, and there is no way to tell a parse
// failure from a legitimate zero. std/string/string.orb's
// parseIntChecked is the checked spelling; use that.
