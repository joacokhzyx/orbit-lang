// Number <-> text and the char constructor (intToString, charFromCode); this module owns these bindings -- import it, one definition per program. No float conversion and no unchecked stringToInt; use parseIntChecked in std/string/string.orb.
extern fn orbit_int_to_string(value: int) -> string
extern fn orbit_string_to_int(s: string) -> int
extern fn orbit_string_from_char_selfhost(code: int) -> string

fn intToString(value: int) -> string {
    return orbit_int_to_string(value)
}

// One character from its byte value. Codes outside 32..126 are
// rejected rather than substituted: a NUL or a lone continuation byte
// vanishes inside an Orbit string, so a silent answer here is data
// loss, not a value.
fn charFromCode(code: int) -> string {
    if code < 32 { return "" }
    if code > 126 { return "" }
    return orbit_string_from_char_selfhost(code)
}

// NOTE: no stringToInt. orbit_string_to_int is a bare atoi, so "12x"
// answers 12 and "abc" answers 0, and there is no way to tell a parse
// failure from a legitimate zero. std/string/string.orb's
// parseIntChecked is the checked spelling; use that.
