// Orbit Sovereign Standard Library
// std/sys/term/color.orb
// High-performance 24-bit TrueColor and 256-color ANSI formatting engine.
//
// The `AnsiStyle` model is declared but not used by any function here:
// it is a placeholder for combined styles, and `createStyle` returns
// it while `wrapBold`/`wrapDim`/`wrapUnderline` take no style argument.
// Do not read `createStyle()` as configuring the wrap* helpers.
//
// This module owns TrueColor styling. std/io/io.orb's `gradient` calls
// `wrapRgbForeground` from here rather than keeping a private copy --
// it used to define `wrapRgb(text, r, g, b)`, the same escape sequence
// with the arguments reversed, which is exactly the kind of pair that
// makes a caller pass rgb in the wrong order. Colour arguments go
// (r, g, b, text) here, without exception.
model AnsiStyle {
    bold: bool
    italic: bool
    underline: bool
    dim: bool
}

fn createStyle() -> AnsiStyle {
    return AnsiStyle(false, false, false, false)
}

fn wrapBold(text: string) -> string {
    return "\x1b[1m" + text + "\x1b[22m"
}

fn wrapDim(text: string) -> string {
    return "\x1b[2m" + text + "\x1b[22m"
}

fn wrapUnderline(text: string) -> string {
    return "\x1b[4m" + text + "\x1b[24m"
}

fn wrapRgbForeground(r: int, g: int, b: int, text: string) -> string {
    return "\x1b[38;2;" + r + ";" + g + ";" + b + "m" + text + "\x1b[0m"
}

fn wrapRgbBackground(r: int, g: int, b: int, text: string) -> string {
    return "\x1b[48;2;" + r + ";" + g + ";" + b + "m" + text + "\x1b[0m"
}
