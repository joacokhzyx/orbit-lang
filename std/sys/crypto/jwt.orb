// Orbit Sovereign Cryptography - JWT Engine
// std/sys/crypto/Jwt.orb

extern fn orbit_base64url_encode_str(str: string) -> string
extern fn orbit_sha256_hex(str: string) -> string
extern fn orbit_hmac_sha256_base64url(key: string, data: string) -> string
extern fn orbit_string_indexOf(s: string, sub: string) -> int
extern fn orbit_string_len(s: string) -> int
extern fn orbit_string_slice(s: string, start: int, end: int) -> string
extern fn orbit_streq(a: string, b: string) -> bool

model JwtHeader {
    alg: string
    typ: string
}

model JwtToken {
    header: string
    payload: string
    signature: string
    raw: string
}

fn signToken(payloadJson: string, secret: string) -> string {
    val headerJson = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}"
    val headerB64 = orbit_base64url_encode_str(headerJson)
    val payloadB64 = orbit_base64url_encode_str(payloadJson)
    val unsignedToken = headerB64 + "." + payloadB64
    val signatureB64 = orbit_hmac_sha256_base64url(secret, unsignedToken)
    return unsignedToken + "." + signatureB64
}

fn verifyToken(tokenStr: string, secret: string) -> bool {
    val dot1 = orbit_string_indexOf(tokenStr, ".")
    if dot1 == -1 { return false }
    val totalLen = orbit_string_len(tokenStr)
    val sub = orbit_string_slice(tokenStr, dot1 + 1, totalLen)
    val dot2 = orbit_string_indexOf(sub, ".")
    if dot2 == -1 { return false }

    val actualDot2 = dot1 + 1 + dot2
    val unsignedToken = orbit_string_slice(tokenStr, 0, actualDot2)
    val signature = orbit_string_slice(tokenStr, actualDot2 + 1, totalLen)
    val expectedSig = orbit_hmac_sha256_base64url(secret, unsignedToken)

    return orbit_streq(signature, expectedSig)
}
