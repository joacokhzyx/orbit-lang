// Orbit Sovereign Standard Library
// std/sys/proc/Env.orb
// Cross-platform environment variable and process state manager.

model EnvConfig {
    os_name: string
    arch: string
    is_windows: bool
    is_posix: bool
}

fn detectEnv() -> EnvConfig {
    return EnvConfig {
        os_name: "Windows",
        arch: "x86_64",
        is_windows: true,
        is_posix: false
    }
}

fn getVarOrDefault(key: string, default_val: string) -> string {
    val res = system.env(key)
    if res == "" {
        return default_val
    }
    return res
}
