// lib/net.orb
// Colorless Async Network Engine (Event Loop)

import "arena.orb"
import "sys/linux.orb"
import "sys/windows.orb"

// FSM context for handlers
model RequestContext {
    arena: Arena
    fd: int
    state: int
    isDone: bool
}

fn initRequestContext(fd: int) -> RequestContext {
    val arena = initArena(65536) // 64KB per request
    return RequestContext(arena, fd, 0, false)
}

fn finishRequest(ctx: RequestContext) {
    reset(ctx.arena)
    ctx.isDone = true
}

// Global Event Loop
fn runEventLoop() {
    // In Linux: Initialize io_uring
    // In Windows: Initialize IOCP
    
    // Pseudocode for Event Loop
    var running = true
    while running {
        // Wait for events (epoll_wait / GetQueuedCompletionStatus)
        // val event = waitForEvent()
        
        // Dispatch to FSM generated by compiler's mir/fsm step
        // val req = getContext(event.fd)
        
        // Resume the handler FSM
        // MiHandler_step(req)
        
        // if req.isDone { cleanup(req) }
        
        running = false // Just to avoid infinite loop in tests
    }
}
