// lib/sys/linux.orb
// Linux Native Syscalls (No libc)

// Syscall Numbers (x86_64)
fn SYS_READ() -> int { return 0 }
fn SYS_WRITE() -> int { return 1 }
fn SYS_OPEN() -> int { return 2 }
fn SYS_CLOSE() -> int { return 3 }
fn SYS_IO_URING_SETUP() -> int { return 425 }
fn SYS_IO_URING_ENTER() -> int { return 426 }

