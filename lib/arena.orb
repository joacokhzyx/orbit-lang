// lib/arena.orb
// Request-Bound Arena Allocator
// Zero-GC memory management bound to the lifecycle of a Request.
//
// WHAT THIS IS NOT: a real allocator. There is no `pointer` arithmetic
// in Orbit and no mmap/VirtualAlloc binding, so `buffer` is a string
// that is never read and `alloc` returns an OFFSET into a logical
// region, not an address. Nothing you get back from `alloc` is
// dereferenceable. The region is a size counter: the point of the
// module today is the bound (`alloc` returns -1 rather than growing
// past `capacity`) and the O(1) reset, and that is all it claims.
// docs/ARENA.md and docs/KNOWN_LIMITATIONS.md should agree with
// this comment, not with the word "allocator".
model Arena {
    buffer: string // Representación temporal de la memoria bruta
    offset: int
    capacity: int
}

fn initArena(cap: int) -> Arena {
    // No OS allocator is called: the region is counted, not mapped.
    return Arena("", 0, cap)
}

// O(1) Allocation
fn alloc(arena: Arena, size: int) -> int {
    if arena.offset + size > arena.capacity {
        // Over the hard limit there is no OS to ask: refuse the request.
        return - 1
    }
    val ptr = arena.offset
    arena.offset = arena.offset + size
    return ptr
}

// O(1) Bulk deallocation (Done at the end of every request)
fn reset(arena: Arena) {
    arena.offset = 0
}
