# Package and installer outputs
node_modules/
package.json
package-lock.json
scratch/
dist/
scripts/dist/
repomix-output.xml
repomix-output*.xml
.repomixignore

# Local agent skills/configs
.agents/

# Python bytecode (scripts/)
__pycache__/
*.pyc

# Research / prototyping (git-ignored until stable)
research/

# Fuzzer crash corpus (local evidence)
fuzz_crashes/

# Single-host cluster orchestration state (orbit cluster v1)
.orbit/
