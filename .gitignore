# Native build artifacts
*.exe
*.exe.c
# The canonical self-hosted compiler C source is COMMITTED: it is the root of
# trust for bootstrapping with any C compiler.
!compiler/selfhost/stage3.exe.c
*.pdb
*.o
*.obj
output_orbit.c
last_generated.c

# C compile cache (scripts/orbit_ccache.py); ORBIT_CCACHE_DIR points here in CI
.ccache/

# The developer loop's scratch: the compile cache, TEMP/TMP and gate work
# directories, and the freshness stamp for the fixed-point compiler. The compiler
# itself lives in the system temp and is rebuilt when it goes missing; see
# fp_path() in scripts/dev.py for why it cannot live in the tree.
/.orbit/

# Prebuilt release binaries (regenerate with scripts/verify_seed.py --refresh)
bin/

# Local runtime data
orbit.db
/sqlite3.dll

# Local logs and diagnostic dumps
*.log
build_*.txt
error*.txt
output*.txt
test_output.txt
apply-fix-*.txt
.orbit-apply/

# Local bootstrap build outputs
bootstrap_server.exe
bootstrap_server.pdb
compiler/selfhost/*.exe
compiler/selfhost/*.exit
compiler/selfhost/*.pid
compiler/selfhost/*.out
compiler/selfhost/*-asan
compiler/selfhost/snippet-*.c

# Package and installer outputs
node_modules/
package.json
package-lock.json
scratch/
dist/
scripts/dist/
repomix-output.xml
repomix-output*.xml
.repomixignore

# Local agent skills/configs
.agents/

# Python bytecode (scripts/)
__pycache__/
*.pyc

# Research / prototyping (git-ignored until stable)
research/

# Fuzzer crash corpus (local evidence)
fuzz_crashes/

# Single-host cluster orchestration state (orbit cluster v1)
.orbit/

# Locally built compilers. Every ad-hoc path used while iterating has to be
# covered: /fp, /fp_* and /fpN, because a fixed-point binary that lands in the
# tree under any of those names is 2 MB of noise in a commit whose subject is a
# doctor check. fp4 was committed once before this pattern existed.
/fp
/fp_*
/fp[0-9]*
/fixed_point
/fixed_point[0-9]*
